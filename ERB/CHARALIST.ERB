;---------------------------------------------------------------------
;
;	Module		:CHARALIST.ERB
;	Facility	:角色クター一覧表示 & 入力
;
;	Licence		:フリー
;
;	Modification Data:角色クター一覧を提示して、選択する関数とその下位関数
;
;
;	Edit	Date			Ver			Author		Reason
;	001		2012/XX/XX		0.300		kap			新規作成		
;	002		2012/07/29		0.300		kap			@INPUT_CHARA_LISTに引数を追加し、1ページあたりの人数を指定できるように
;			2012/08/03		0.300		kap			公会任务に対応、CHARALISTを変数を作成し、それを使うように
;	003		2012/08/30		0.330		kap			デバッグモードでABL・TALENT・MARKを変更可能に
;	004		2012/10/04		0.400		kap			IS_EXISTを判定に組み込む
;	005		2012/10/28		0.420		kap			交友值を表示するように
;	006		2012/12/10		0.430		kap			技能值を表示するように
;---------------------------------------------------------------------
;@SHOW_CHARA_LIST		角色クターをリスト表示
;---------------------------------------------------------------------
;-------------------------------------------------
;ステータス表示(各角色ごと)
;@SHOW_CHARALIST
;ARGS 	能力確認
;ARG	表示する角色クター
;ARG:1	表示するPAGE内容
;ARG:2	その他フラグ(公会任务で依頼番号を示すなど)
;-------------------------------------------------
@SHOW_CHARALIST, ARGS, ARG = -1, ARG:1 = 1, ARG:2
#LOCALSIZE 4
#LOCALSSIZE 50
#DIM LINE, 3
#DIM TEMP, 2
#DIMS TEMPS
#DIM SHOW_PAGE
#DIM C_REDRAW
#DIM TAKE_OVER_NEED
CL_LISTNUM = 0
SHOW_PAGE = ARG:1
VARSET CHARALIST, -1
;-----------------------------------------------------------
;リスト作成
;-----------------------------------------------------------
LOCAL:1 = 0
SELECTCASE ARGS
	CASE "個人表示"
		CHARALIST:0 = ARG
	CASE "調教対象変更"
		FOR LOCAL, 0, CHARANUM
			SIF !IS_TARGETABLE(LOCAL)
				CONTINUE
			CHARALIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		NEXT
	CASE "查看能力", "更换装备"
		IF GET_NO("商店", "调教") == FLAG:商店指令
			FOR LOCAL, 0, 3
				SIF TRAINCHARA(LOCAL) == -1
					CONTINUE
				CHARALIST:(LOCAL:1) = TRAINCHARA(LOCAL)
				LOCAL:1++
			NEXT
		ELSE
			FOR LOCAL, 0, CHARANUM
				SIF !CFLAG:LOCAL:认识 && LOCAL != MASTER
					CONTINUE
				SIF !IS_EXIST_HERE(LOCAL)
					CONTINUE
				CHARALIST:(LOCAL:1) = LOCAL
				LOCAL:1++
			NEXT
		ENDIF
	CASE "パスコード出力"
		FOR LOCAL, 0, CHARANUM
			SIF CFLAG:LOCAL:独特
				CONTINUE
			CHARALIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		NEXT
	CASE "パスコード入力確認"
		CHARALIST:0 = ARG
	CASE "使用物品"
		FOR LOCAL, 0, CHARANUM
			SIF !IS_EXIST_HERE(LOCAL)
				CONTINUE
			SIF !IS_TARGETABLE(LOCAL) && LOCAL != MASTER
				CONTINUE
			TRYCCALLFORM ITEM_USEABLE_{GET_ITEMDATA(ARG:2, "ID")}
				SIF !RESULT
					CONTINUE
			CATCH
				CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG:2, "ID")}
				SELECTCASE RESULTS
					CASE "RESULTS"
						SIF !IS_EXIST_HERE(LOCAL)
							CONTINUE
				ENDSELECT
			ENDCATCH
			CHARALIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		NEXT
	CASE "倍率確認"
		FOR LOCAL, 0, CHARANUM
			CHARALIST:LOCAL = LOCAL
		NEXT
	CASE "继承霍姆克鲁斯"
		FOR LOCAL, 0, CHARANUM
			SIF LOCAL == MASTER
				CONTINUE
			SIF CFLAG:LOCAL:人类
				CONTINUE
			CHARALIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		NEXT
	CASE "继承友人"
		FOR LOCAL, 0, CHARANUM
			SIF LOCAL == MASTER
				CONTINUE
			SIF !CFLAG:LOCAL:人类
				CONTINUE
			CHARALIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		NEXT
ENDSELECT
CL_LISTNUM = ARG >= 0 ? FINDELEMENT(CHARALIST, ARG) # 0
CL_SHOW_NUM = MAXLINE() - 14
CL_MAXLIST = VARSIZE("CHARALIST") - MATCH(CHARALIST, -1) - 1
CL_MAXPAGE = (VARSIZE("CHARALIST") - MATCH(CHARALIST, -1)) / CL_SHOW_NUM
LINE = LINECOUNT
C_REDRAW = CURRENTREDRAW()
REDRAW 0
$START
CL_CHARA = CHARALIST:CL_LISTNUM
CL_PAGE = CL_LISTNUM / CL_SHOW_NUM
CLEARLINE LINECOUNT - LINE
DRAWLINE
SELECTCASE ARGS
	CASE "調教対象変更", "助手変更"
		PRINTFORM 　%ARGS, 12,LEFT%
		IF TARGET >= 0
			PRINT 　　　　　現調教対象:
			SETCOLOR COLOR("p-blue")
			PRINTFORM %CALLNAME:TARGET%
			RESETCOLOR
		ENDIF
		IF ASSI >= 0
			PRINT 　　　　　%現助手:
			SETCOLOR COLOR("p-red")
			PRINTFORM %CALLNAME:TARGET%
			RESETCOLOR
		ENDIF
		PRINTL 
	CASE "继承霍姆克鲁斯", "继承友人"
		TO_USE_POINT = 0
		FOR LOCAL, 0, VARSIZE("TO_CHOICE")
			SIF !TO_CHOICE:LOCAL
				CONTINUE
			CALLFORM TAKE_OVER_COST_{LOCAL}
			TO_USE_POINT += RESULT
		NEXT
		TAKE_OVER_NEED = ARGS == "继承霍姆克鲁斯" ? MIN((CMATCH(CFLAG:继承标识, 1) + 1) * 10, 50) # MIN((CMATCH(CFLAG:继承标识, 2) + 1) * 20, 100)
		PRINTFORML 　%"角色クター引き継ぎ設定", 70,LEFT%特典ポイント:{TO_USE_POINT, 4}/{TO_POINT, 4}　必要ポイント:{TAKE_OVER_NEED, 3}
	CASEELSE
		PRINTFORML 　%ARGS%
ENDSELECT
DRAWLINE
FOR LOCAL, 0, MAXLINE() - 7
	CALL SHOW_CHARALIST_LEFT, LOCAL, ARGS
	SELECTCASE SHOW_PAGE
		CASE 1
			CALL SHOW_CHARALIST_RIGHT_1, LOCAL, ARGS
		CASE 2
			CALL SHOW_CHARALIST_RIGHT_2, LOCAL, ARGS
		CASE 3
			CALL SHOW_CHARALIST_RIGHT_3, LOCAL, ARGS
	ENDSELECT
	PRINTL 
NEXT
DRAWLINE
LINE:1 = LINECOUNT
IF ARGS == "パスコード入力確認"
	PRINTL 以上の角色を追加しました。
	PRINTL
	PRINTW
	REDRAW C_REDRAW 
	RETURN 1
ENDIF
IF ARGS != "查看能力" && ARGS != "個人表示"
	PRINTBUTTON "　[En] 決定", ""
ELSE
	PRINTBUTTON "　[ 9] 戻る", "9"
ENDIF
PRINTFORM %"", 14%
CALL PRINTSBUTTON_C, "　[ +] PAGE.1", "+", SHOW_PAGE == 1, COLOR("p-green"),
PRINTFORM %"", 12%
CALL PRINTSBUTTON_C, "　[ -] PAGE.2", "-", SHOW_PAGE == 2, COLOR("p-green"),
PRINTL 
IF ARGS != "查看能力" && ARGS != "個人表示"
	PRINTBUTTON "　[ 9] 戻る", "9"
	PRINTFORM %"", 14%
ELSE
	PRINTFORM %"", 25%
	PRINTBUTTON "　[ ?] 角色解说", "?"
	SIF CL_CHARA != MASTER && CFLAG:CL_CHARA:人类
		PRINTBUTTON "　　[ !] アビリティ取得", "!"
ENDIF
PRINTL 
PRINTL 
LINE:2 = LINECOUNT
$INPUT_LOOP_2
CLEARLINE LINECOUNT - LINE:2
ONEINPUTS
ENCODETOUNI %RESULTS%
IF GET_KEYMARK_NUM(RESULTS) >= 0
	IF CL_MARKS_ABLE:GET_KEYMARK_NUM(RESULTS) >= 0
		IF CL_LISTNUM == (GET_KEYMARK_NUM(RESULTS) + CL_PAGE * CL_SHOW_NUM)
			GOTO ENTER
		ELSE
			CL_LISTNUM = GET_KEYMARK_NUM(RESULTS) + CL_PAGE * CL_SHOW_NUM
		ENDIF
	ENDIF
ELSE
	SELECTCASE RESULTS
		CASE ""
			$ENTER
			SELECTCASE ARGS
				CASE "查看能力"
				CASE "继承霍姆克鲁斯", "继承友人"
					TEMP = CHARALIST:CL_LISTNUM
					IF CFLAG:TEMP:继承标识
						CFLAG:TEMP:继承标识 = 0
					ELSE
						SIF TO_USE_POINT + TAKE_OVER_NEED <= TO_POINT
							CFLAG:TEMP:继承标识 = ARGS == "继承霍姆克鲁斯" ? 1 # 2
					ENDIF
				CASEELSE
					REDRAW C_REDRAW
					RETURN CHARALIST:CL_LISTNUM
			ENDSELECT
		CASE "8"
			CL_LISTNUM--
		CASE "2"
			CL_LISTNUM++
		CASE "4"
			CL_LISTNUM -= CL_SHOW_NUM
		CASE "6"
			CL_LISTNUM += CL_SHOW_NUM
		CASE "9"
			REDRAW C_REDRAW
			RETURN 1000
		CASE "+"
			SHOW_PAGE = 1
		CASE "-"
			SHOW_PAGE = 2
		CASE "!"
			SIF GROUPMATCH(ARGS, "查看能力", "個人表示") && CL_CHARA != MASTER && CFLAG:CL_CHARA:人类
				CALL CHANGE_FR_SKILL, CL_CHARA
		CASE "?"
			SHOW_PAGE = 3
		CASEELSE
			SELECTCASE RESULT:1
				CASE 12000 TO 12999
					IF SHOW_PAGE == 1
						CLEARLINE LINECOUNT - LINE:1
						CALLFORM TALENT_EXPLAIN_%TALENTNAME:(RESULT:1 - 12000)%
						SPLIT RESULTS, "/", LOCALS
						FOR LOCAL, 0, RESULT
							PRINTFORML %LOCALS:LOCAL%
						NEXT
						CALL EQUATE_LINE, LINE + MAXLINE()
						WAITANYKEY
					ELSEIF SHOW_PAGE == 2
						CLEARLINE LINECOUNT - LINE:1
						CALLFORM TRAIN_SKILL_EXPLAIN_%GET_NAME("调教技能", RESULT:1 - 12000)%
						SPLIT RESULTS, "/", LOCALS
						FOR LOCAL, 0, RESULT
							PRINTFORML %LOCALS:LOCAL%
						NEXT
						CALL EQUATE_LINE, LINE + MAXLINE()
						WAITANYKEY
					ENDIF
				CASE 13000 TO 13999
					IF SHOW_PAGE == 2
						CLEARLINE LINECOUNT - LINE:1
						CALLFORM TRAIN_STATE_EXPLAIN_%GET_NAME("调教状态", RESULT:1 - 13000)%
						SPLIT RESULTS, "/", LOCALS
						FOR LOCAL, 0, RESULT
							PRINTFORML %LOCALS:LOCAL%
						NEXT
						CALL EQUATE_LINE, LINE + MAXLINE()
						WAITANYKEY
					ENDIF
				CASE 20000 TO 29999
					TEMP = RESULT:1 - 20000
					CALL SET_MAX_ABL, TEMP / 100, CL_CHARA, MAX(ABL:CL_CHARA:(TEMP / 100), TEMP % 100)
					ABL:CL_CHARA:(TEMP / 100) = TEMP % 100
				CASE 30000
					CALL DEBUG_TALENT, CL_CHARA
				CASE 31000 TO 31099
					TEMP = RESULT:1 - 31000
					MARK:CL_CHARA:(TEMP / 10) = TEMP % 10
			ENDSELECT
	ENDSELECT
ENDIF
SIF CL_LISTNUM < 0
	CL_LISTNUM = CL_MAXLIST
SIF CL_LISTNUM > CL_MAXLIST
	CL_LISTNUM = 0
GOTO START

@SHOW_CHARALIST_LEFT, ARG, ARGS
#LOCALSIZE 1
SELECTCASE ARG
	CASE 0, MAXLINE() - 12
		PRINTFORM ┌%"─" * 11%┐
	CASE MAXLINE() - 13
		PRINTFORM └%"─" * 6%PAGE [{CL_PAGE}/{CL_MAXPAGE}]┘
	CASE MAXLINE() - 11
		PRINTFORM │%"",9%
		PRINTBUTTON "[ 8]", "8"
		PRINTFORM %"",9%│
	CASE MAXLINE() - 10
		PRINTFORM │%"",5%
		PRINTBUTTON "[ 4]", "4"
		PRINTFORM %"", 4%
		PRINTBUTTON "[ 6]", "6"
		PRINTFORM %"",5%│
	CASE MAXLINE() - 9
		PRINTFORM │%"",9%
		PRINTBUTTON "[ 2]", "2"
		PRINTFORM %"",9%│
	CASE MAXLINE() - 8
		PRINTFORM └%"─" * 11%┘
	CASEELSE
		PRINT │
		LOCAL = ARG + CL_PAGE * CL_SHOW_NUM - 1
		IF CHARALIST:LOCAL >= 0
			SIF (ARGS == "調教対象変更" || ARGS == "助手変更") && TARGET == CHARALIST:LOCAL
				SETCOLOR COLOR("p-blue")
			SIF (ARGS == "調教対象変更" || ARGS == "助手変更") && ASSI == CHARALIST:LOCAL
				SETCOLOR COLOR("p-red")

			IF ARGS == "继承霍姆克鲁斯" || ARGS == "继承友人"
				IF (ARGS == "继承霍姆克鲁斯" && CFLAG:(CHARALIST:LOCAL):继承标识 == 1) || (ARGS == "继承友人" && CFLAG:(CHARALIST:LOCAL):继承标识 == 2)
					SETCOLOR COLOR("p-red")
					PRINTBUTTON UNICODE(0x273F), GET_KEYMARK(ARG - 1)
					SETCOLOR COLOR("p-blue")
				ELSE
					RESETCOLOR
					PRINTBUTTON "　", GET_KEYMARK(ARG - 1)
				ENDIF
				PRINTBUTTON @"[%GET_KEYMARK(ARG-1)%] %FORMCELL(CALLNAME:(CHARALIST:LOCAL), 16, "LEFT")%", GET_KEYMARK(ARG - 1)
			ELSE
				PRINTBUTTON @"[%GET_KEYMARK(ARG-1)%] %FORMCELL(CALLNAME:(CHARALIST:LOCAL), 18, "LEFT")%", GET_KEYMARK(ARG - 1)
			ENDIF
			RESETCOLOR

			CL_MARKS_ABLE:(ARG - 1) = CHARALIST:LOCAL
		ELSE
			PRINTFORM %"",22%
			CL_MARKS_ABLE:(ARG - 1) = -1
		ENDIF
		PRINT │
ENDSELECT

@SHOW_CHARALIST_RIGHT_1, ARG, ARGS
#LOCALSIZE 2
#LOCALSSIZE 6
#DIM TEMP,2
#DIMS TEMPS, 20
SELECTCASE ARG
	CASE 0
		PRINTFORM ┌%"─" * 48%┐
	CASE 1
		IF CL_CHARA != MASTER && CFLAG:CL_CHARA:人类
			PRINTFORM │%CALLNAME:CL_CHARA, 48, LEFT%%@"交友值:{GET_FRIEND_POINT(CL_CHARA), 3}", 24, LEFT%%@"技能值:{CFLAG:CL_CHARA:技能值, 3}", 24, LEFT%│
		ELSE
			PRINTFORM │%CALLNAME:CL_CHARA, 96, LEFT%│
		ENDIF
	CASE 2
		PRINT │体力 
		CALL PRINT_COLORBAR, BASE:CL_CHARA:体力, GET_MAXBASE("体力", CL_CHARA), 64, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤"), RESULT:1
		PRINTFORM  ({BASE:CL_CHARA:体力, 5}/{GET_MAXBASE("体力", CL_CHARA), 5})%"",13%│
	CASE 3
		PRINT │气力 
		CALL PRINT_COLORBAR, BASE:CL_CHARA:气力, GET_MAXBASE("气力", CL_CHARA), 64, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
		PRINTFORM  ({BASE:CL_CHARA:气力, 5}/{GET_MAXBASE("气力", CL_CHARA), 5})%"",13%│
	CASE 5
		PRINTFORM ┌特征%"─"*46%┐
	CASE 6, 7
		PRINT │
		TEMP = (ARG - 6) * 4
		FOR LOCAL, TEMP, TEMP + 4
			IF TEMP < 特征要素数
				PRINTFORM %GET_NAME("特征", LOCAL),4,LEFT%:
				PRINTFORM %CSTR:CL_CHARA:GET_NAME("特征", LOCAL),19,LEFT%
			ELSE
				PRINTFORM %"",24%
			ENDIF
		NEXT
		PRINT │
	CASE 9
		PRINTFORM ┌
		IF FLAG:DEBUG
			PRINTBUTTON "特质", UNICODE(30000)
		ELSE
			PRINT 特质
		ENDIF
		PRINTFORM %"─"*46%┐
		VARSET LOCALS
		LOCAL = 0
		TEMP:1 = 0
		FOR LOCAL:1, 0, 200
			SIF !GET_TALENT(LOCAL:1, CL_CHARA)
				CONTINUE
			TEMPS = %TALENTNAME:(LOCAL:1)%
			RESULT = 0
			TRYCALLFORM TALENT_NOLV_%TEMPS%
			SIF !RESULT
				TEMPS += " Lv" + TOSTR(GET_TALENT(LOCAL:1, CL_CHARA))
			TEMPS = %TEMPS%
			IF TEMP:1 + STRLENS(TEMPS) + 4 > 96
				LOCAL++
				TEMP:1 = 0
			ENDIF
			LOCALS:(LOCAL) += "/" + TEMPS
			TEMP:1 += STRLENS(TEMPS) + 4
		NEXT
	CASE 10, 11, 12, 13, 14
		TEMP = ARG - 10
		TEMP:1 = 0
		SPLIT SUBSTRING(LOCALS:TEMP,1), "/", TEMPS
		PRINT │
		LOCAL:1 = 0
		FOR LOCAL, 0, RESULT
			SIF TEMPS:LOCAL == ""
				CONTINUE
			PRINTBUTTON "[" + TEMPS:LOCAL + "]", UNICODE(12000 + GETNUM(TALENT, AUTO_SPLIT(TEMPS:LOCAL, " Lv", 0)))
			PRINT 　
			LOCAL:1 += STRLENS(TEMPS:LOCAL) + 4
		NEXT
		SIF LOCAL:1 < 96
			PRINTFORM %" " *(96 - LOCAL:1)%
		PRINT │
	CASE 16 TO 26
		IF CL_CHARA == MASTER
			SELECTCASE ARG
				CASE 16
					PRINTFORM ┌技術%"─"*46%┐
				CASE 17
					PRINT │
					PRINTFORM %@"手活:{GET_TEQ_M("手活"),5}", 32, LEFT%
					PRINTFORM %@"口活:{GET_TEQ_M("口活"),5}", 32, LEFT%
					PRINTFORM %@"性交:{GET_TEQ_M("性交"),5}", 32, LEFT%
					PRINT │
				CASE 18
					PRINT │
					PRINTFORM %@"受虐:{GET_TEQ_M("受虐"),5}", 32, LEFT%
					PRINTFORM %@"施虐:{GET_TEQ_M("施虐"),5}", 32, LEFT%
					PRINTFORM %@"诱惑:{GET_TEQ_M("诱惑"),5}", 32, LEFT%
					PRINT │
				CASE 20
					PRINTFORM ┌感度%"─"*46%┐
				CASE 21
					PRINT │
					PRINTFORM %@"Ｃ感度:{GET_SENS_M("Ｃ感度"),5}", 24, LEFT%
					PRINTFORM %@"Ｖ感度:{GET_SENS_M("Ｖ感度"),5}", 24, LEFT%
					PRINTFORM %@"Ａ感度:{GET_SENS_M("Ａ感度"),5}", 24, LEFT%
					PRINTFORM %@"Ｂ感度:{GET_SENS_M("Ｂ感度"),5}", 24, LEFT%
					PRINT │
				CASE 23
					PRINTFORM ┌調教師評価%"─"*43%┐
				CASE 24
					PRINTFORM │%"Rank:", 96, LEFT%│
				CASE 25
					PRINTFORM │%@"EXP :{FLAG:调教师EXP}", 96, LEFT%│
				CASE 19, 22, 26
					PRINTFORM └%"─" * 48%┘
			ENDSELECT
		ELSE
			SELECTCASE ARG
				CASE 16
					PRINTFORM ┌能力%"─"*46%┐
					TEMP = -1
				CASE 17 TO 22
					PRINT │
					LOCAL = 0
					WHILE LOCAL < 3
						TEMP++
						IF TEMP < 100
							SIF ABLNAME:TEMP == ""
								CONTINUE
							PRINTFORM %ABLNAME:TEMP,10,LEFT%:
							FOR LOCAL:1, 0, 11
								IF LOCAL:1 == 0
									SETCOLOR GETBGCOLOR()
								ELSEIF GET_MAX_ABL(TEMP, CL_CHARA) < LOCAL:1
									SETCOLOR GETBGCOLOR()
								ELSEIF LOCAL:1 <= GET_NATURE_ABL(TEMP, CL_CHARA)
									SETCOLOR BARCOLORSET("蓝", 1)
								ELSEIF LOCAL:1 <= GET_ABL(TEMP, CL_CHARA)
									SETCOLOR BARCOLORSET("蓝")
								ELSE
									SETCOLOR COLOR("gray")
								ENDIF
								IF FLAG:DEBUG
									PRINTBUTTON UNICODE(0x25AE), UNICODE(20000 + TEMP * 100 + LOCAL:1)
								ELSE
									PRINTFORM %UNICODE(0x25AE)%
								ENDIF
							NEXT
							RESETCOLOR
							PRINTFORM %"",2%({GET_ABL(TEMP, CL_CHARA),2}/{GET_MAX_ABL(TEMP, CL_CHARA),2}) 
						ELSE
							PRINTFORM %"", 32%
						ENDIF
						LOCAL++
					WEND
					PRINT │
				CASE 24
					PRINTFORM ┌烙印%"─"*46%┐
				CASE 25
					PRINT │
					FOR LOCAL, 0, 4
						PRINTFORM %MARKNAME:(LOCAL),10,LEFT%:
						FOR LOCAL:1, 0, 4
							IF LOCAL:1 == 0
								SETCOLOR GETBGCOLOR()
							ELSEIF MARK:CL_CHARA:(LOCAL) >= LOCAL:1
								SETCOLOR BARCOLORSET("蓝", 1)
							ELSE
								SETCOLOR COLOR("gray")
							ENDIF
							IF FLAG:DEBUG
								PRINTBUTTON UNICODE(0x25AE), UNICODE(31000 + LOCAL * 10 + LOCAL:1)
							ELSE
								PRINTFORM %UNICODE(0x25AE)%
							ENDIF
						NEXT
						PRINTFORM %"",9%
						RESETCOLOR
					NEXT
					PRINT │
				CASE 23, 26
					PRINTFORM └%"─" * 48%┘
			ENDSELECT
		ENDIF
	CASE 27
		PRINTFORM ┌経験%"─"*46%┐
		TEMP = -1
	CASE 28 TO 32
		PRINT │
		LOCAL = 0
		WHILE LOCAL < 4
			TEMP++
			IF TEMP < 100
				SIF EXPNAME:TEMP == ""
					CONTINUE
				PRINTFORM %EXPNAME:TEMP,14,LEFT%:{EXP:CL_CHARA:TEMP,8} 
			ELSE
				PRINTFORM %"", 24%
			ENDIF
			LOCAL++
		WEND
		PRINT │
		
	CASE 4, 8, 15, 33
		PRINTFORM └%"─" * 48%┘
	CASEELSE
		PRINTFORM 
ENDSELECT


@SHOW_CHARALIST_RIGHT_2, ARG, ARGS
#LOCALSIZE 3
#LOCALSSIZE 4
#DIM TEMP,2
#DIMS TEMPS,3
SELECTCASE ARG
	CASE 0
		PRINTFORM ┌%"─" * 48%┐
		VARSET LOCALS
		FOR LOCAL, 0, 100
			SIF PALAMNAME:LOCAL != ""
				LOCALS += "/" + PALAMNAME:LOCAL
			SIF SOURCENAME:LOCAL != "" && LOCAL < 50
				LOCALS:1 += "/" + SOURCENAME:LOCAL
			TRYCCALLFORM TRAIN_SKILL_NAME_{LOCAL}
				TEMPS = %RESULTS%
				CALLFORMF TRAIN_SKILL_POWER_%TEMPS%, CL_CHARA, MASTER, 1
				SIF RESULT
					LOCALS:2 += "/" + TEMPS + "_" + TOSTR(RESULT) + "_" + TOSTR(LOCAL)
			CATCH
			ENDCATCH
			TRYCCALLFORM TRAIN_STATE_NAME_{LOCAL}
				TEMPS = %RESULTS%
				CALLFORMF TRAIN_STATE_POWER_%TEMPS%, CL_CHARA, MASTER, 1
				SIF RESULT
					LOCALS:3 += "/" + TEMPS + "_" + TOSTR(RESULT) + "_" + TOSTR(LOCAL)
			CATCH
			ENDCATCH
		NEXT
	CASE 1
		PRINTFORM │%CALLNAME:CL_CHARA, 96, LEFT%│
	CASE 2
		PRINT │体力 
		CALL PRINT_COLORBAR, BASE:CL_CHARA:体力, GET_MAXBASE("体力", CL_CHARA), 64, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤"), RESULT:1
		PRINTFORM  ({BASE:CL_CHARA:体力, 5}/{GET_MAXBASE("体力", CL_CHARA), 5})%"",13%│
	CASE 3
		PRINT │气力 
		CALL PRINT_COLORBAR, BASE:CL_CHARA:气力, GET_MAXBASE("气力", CL_CHARA), 64, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
		PRINTFORM  ({BASE:CL_CHARA:气力, 5}/{GET_MAXBASE("气力", CL_CHARA), 5})%"",13%│
	CASE 4
		PRINTFORM └%"─" * 48%┘
	CASE 5
		PRINTFORM ┌EQUIP %"─" * 45%┐
	CASE 6
		PRINT │
		FOR LOCAL, 0, 4
			IF LOCAL > 1 && CL_CHARA != MASTER
				PRINTFORM %" " * 26%
			ELSE
				SIF LOCAL
					PRINT 　　
				PRINT [
				IF GET_EQUIP(AUTO_SPLIT("装饰品0/装饰品1/武器/防具", "/", LOCAL), CL_CHARA, "ID") > 0
					PRINTFORM %FORMCELL(GET_EQUIPNAME(AUTO_SPLIT("装饰品0/装饰品1/武器/防具", "/", LOCAL), CL_CHARA), 18 + (LOCAL > 1) * 2, "CENTER")%
				ELSE
					SELECTCASE LOCAL
						CASE 0
							CALL COLORPRINT, FORMCELL("ACCESSORY", 18 , "CENTER"), "gray"
						CASE 1
							CALL COLORPRINT, FORMCELL("ACCESSORY", 18 , "CENTER"), "gray"
						CASE 2
							CALL COLORPRINT, FORMCELL("ROD", 20, "CENTER"), "gray"
						CASE 3
							CALL COLORPRINT, FORMCELL("CLOTHES", 20, "CENTER"), "gray"
					ENDSELECT
				ENDIF
				PRINT ]
			ENDIF
		NEXT
		PRINT │
	CASE 7
		PRINTFORM └%"─" * 48%┘
	CASE 8
		PRINTFORM ┌基礎PALAM倍率 %"─"* 3%┐┌基礎SOURCE倍率%"─"* 3%┐┌その他技能%"─"* 6%┐┌発揮中效果%"─"* 6%┐
	CASE 9 TO 32
		;-----------------------------------------
		;CUP
		;-----------------------------------------
		TEMPS = %AUTO_SPLIT(LOCALS, "/", ARG - 8)%
		PRINT │
		IF TEMPS == ""
			PRINTFORM %"", 20%
		ELSE
			CALL GET_TALENT_CUP, TEMPS, CL_CHARA
			IF RESULT < 0
				TEMP = 100 * 100 / (100 - RESULT)
			ELSE
				TEMP = 100 * (100 + RESULT) / 100
			ENDIF
			SIF TEMP > 100
				SETCOLOR COLOR("p-blue")
			SIF TEMP < 100
				SETCOLOR COLOR("p-red")
			PRINTFORM %TEMPS, 12, LEFT%
			PRINTFORM %TOSTR(TEMP), 7%\%
			RESETCOLOR
		ENDIF
		PRINT │
		;-----------------------------------------
		;SOURCE
		;-----------------------------------------
		TEMPS = %AUTO_SPLIT(LOCALS:1, "/", ARG - 8)%
		PRINT │
		IF TEMPS == ""
			PRINTFORM %"", 20%
		ELSE
			CALL GET_TALENT_SOURCE, TEMPS, CL_CHARA
			IF RESULT < 0
				TEMP = 100 * 100 / (100 - RESULT)
			ELSE
				TEMP = 100 * (100 + RESULT) / 100
			ENDIF
			SIF TEMP > 100
				SETCOLOR COLOR("p-blue")
			SIF TEMP < 100
				SETCOLOR COLOR("p-red")
			PRINTFORM %TEMPS, 12, LEFT%
			PRINTFORM %TOSTR(TEMP), 7%\%
			RESETCOLOR
		ENDIF
		PRINT │
		;-----------------------------------------
		;スキル
		;-----------------------------------------
		SPLIT AUTO_SPLIT(LOCALS:2, "/", ARG - 8), "_", TEMPS
		PRINT │
		IF TEMPS == ""
			PRINTFORM %"", 22%
		ELSE
			PRINTBUTTON @"%TEMPS, 14, LEFT%", UNICODE(12000 + TOINT(TEMPS:2))
			PRINTFORM %TEMPS:1, 8%
		ENDIF
		PRINT │
		;-----------------------------------------
		;调教状态
		;-----------------------------------------
		SPLIT AUTO_SPLIT(LOCALS:3, "/", ARG - 8), "_", TEMPS
		PRINT │
		IF TEMPS == ""
			PRINTFORM %"", 22%
		ELSE
			PRINTBUTTON @"%TEMPS, 14, LEFT%", UNICODE(13000 + TOINT(TEMPS:2))
			PRINTFORM %TEMPS:1, 8%
		ENDIF
		PRINT │
	CASE 12 TO 32
	CASE 33
		PRINTFORM └%"─" * 10%┘└%"─" * 10%┘└%"─" * 11%┘└%"─" * 11%┘
	CASEELSE
		PRINTFORM 
ENDSELECT
