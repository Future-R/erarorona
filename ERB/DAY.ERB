;日数経過処理
;ARG:1はMP回復停止フラグ
@ADD_DAY, ARG = 1, ARGS
#LOCALSIZE 3
#DIM CHARA
#DIM HEAL_POWER
FOR LOCAL, 0, ARG
	FOR CHARA, 0, CHARANUM
		HEAL_POWER = 0
		HEAL_POWER += GET_TALENT("健康的", CHARA) * 40
		HEAL_POWER -= GET_TALENT("梦幻泡影", CHARA) * 40
		; 处理恢复
		IF CHARA == MASTER || !CFLAG:CHARA:人类
			SIF GET_ITEMNAME_E(GET_NO_QEQUIP("睡眠用品"), 0) == "舒适睡眠"
				HEAL_POWER += 40
			SIF GET_ITEMNAME_E(GET_NO_QEQUIP("睡眠用品"), 0) == "超舒适睡眠"
				HEAL_POWER += 80
		ENDIF
		IF ARGS == "休息"
			SIF CHARA == MASTER
				HEAL_POWER += FR_SKILL_LV:GET_NO("友人技能", "午睡大师") * 80
			BASE:CHARA:体力 += CALCF(TIMESF(GET_MAXBASE("体力", CHARA), 10), HEAL_POWER)
			BASE:CHARA:气力 += CALCF(TIMESF(GET_MAXBASE("气力", CHARA), 20), HEAL_POWER)
			BASE:CHARA:魔力 += CALCF(TIMESF(GET_MAXBASE("魔力", CHARA), 15), HEAL_POWER)
		ELSE
			BASE:CHARA:体力 += CALCF(TIMESF(GET_MAXBASE("体力", CHARA), 2), HEAL_POWER)
			BASE:CHARA:气力 += CALCF(TIMESF(GET_MAXBASE("气力", CHARA), 5), HEAL_POWER)
			SIF !GROUPMATCH(GET_NAME("SHOP", FLAG:SHOP指令), "调合", "制造霍姆克鲁斯")
				BASE:CHARA:魔力 += CALCF(TIMESF(GET_MAXBASE("魔力", CHARA), 5), HEAL_POWER)
		ENDIF
		BASE:CHARA:体力 = MIN(BASE:CHARA:体力, GET_MAXBASE("体力", CHARA))
		IF CFLAG:CHARA:人类
			BASE:CHARA:气力 = MIN(BASE:CHARA:气力, GET_MAXBASE("气力", CHARA))
		ELSE
			BASE:CHARA:气力 = GET_MAXBASE("气力", CHARA)
		ENDIF
		BASE:CHARA:魔力 = MIN(BASE:CHARA:魔力, GET_MAXBASE("魔力", CHARA))

		; 异常状态
		IF TALENT:CHARA:噗尼噗尼苗床
			BASE:CHARA:魔力 -= MIN(BASE:CHARA:魔力, 4)
		ENDIF

		IF CFLAG:CHARA:采集地点 >= 0 && CFLAG:CHARA:采集完成日 >= DAY
			SIF GET_FRIEND_POINT(CHARA) < 60
				CALL GAIN_FRIEND_POINT, CHARA, 100 / 10
		ENDIF
	NEXT

	; NPC移动
	; 吉欧12月和1月会在村子，否则周末会在亚兰德
	IF MONTH(DAY) == 12 || MONTH(DAY) == 1
		CSTR:GET_CNUM("吉欧"):所在地 = 阿拉尼亚村
	ELSE
		CSTR:GET_CNUM("吉欧"):所在地 = 亚兰德
	ENDIF
	; 村子解锁后，师傅5/6/7月会在村子，否则在亚兰德
	IF GET_EVENT_ATTAIN("邀请练习") && (MONTH(DAY) == 5 || MONTH(DAY) == 6 || MONTH(DAY) == 7)
		CSTR:GET_CNUM("亚斯特丽德"):所在地 = 阿拉尼亚村
	ELSE
		CSTR:GET_CNUM("亚斯特丽德"):所在地 = 亚兰德
	ENDIF

	; 旅行的技艺充能
	IF FLAG:旅行充能计数器 < 15
		FLAG:旅行充能计数器++
	ENDIF
	
	; 每周日商店进货，这里是周六结束时触发所以要判断==6而不是7
	IF WEEK(DAY) == 6
		CALL RECHARGE_STORE
	ENDIF
	; 更新委托物品清单以及重置委托配额为5
	SELECTCASE DAYS(DAY)
		; 每月3日、13日、23日刷新
		CASE 2, 12, 22
			CALL MAKE_REQ_TABLE
	ENDSELECT
	; 生成和排序委托改为每日进行会不会很卡？测试一下
	CALL MAKE_REQ_MAIN
	; 霍姆调和日数更新
	FOR LOCAL:1, 0, 2
		FOR LOCAL:2, 0, 5
			SIF !GET_HOMU_MIX_PROPERTY("物品ID", LOCAL:1, LOCAL:2)
				BREAK
			SIF !GET_HOMU_MIX_PROPERTY("所需天数", LOCAL:1, LOCAL:2)
				CONTINUE
			CALL SET_HOMU_MIX_PROPERTY("所需天数", LOCAL:1, LOCAL:2, GET_HOMU_MIX_PROPERTY("所需天数", LOCAL:1, LOCAL:2) - 1)
			SIF GET_FRIEND_POINT(LOCAL:1 ? GET_CNUM("霍姆弟弟") # GET_CNUM("霍姆妹妹")) < 60
				CALL GAIN_FRIEND_POINT, LOCAL:1 ? GET_CNUM("霍姆弟弟") # GET_CNUM("霍姆妹妹"), 100 / 5
			BREAK
		NEXT
	NEXT
	DAY++
	; 更新TIPS
	CALL UPDATE_TIPS
NEXT
