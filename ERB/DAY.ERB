;日数経過処理
;ARG:1はMP回復停止フラグ
@ADD_DAY, ARG, ARGS
#LOCALSIZE 3
#DIM CHARA
#DIM HEAL_POWER
FOR LOCAL, 0, ARG
	FOR CHARA, 0, CHARANUM
		HEAL_POWER = 0
		HEAL_POWER += GET_TALENT("健康的", CHARA) * 40
		HEAL_POWER -= GET_TALENT("儚げ", CHARA) * 40
		;回復処理
		IF CHARA == MASTER || !CFLAG:CHARA:人間
			SIF GET_ITEMNAME_E(GET_NO_QEQUIP("寝具"), 0) == "快眠"
				HEAL_POWER += 40
			SIF GET_ITEMNAME_E(GET_NO_QEQUIP("寝具"), 0) == "超快眠"
				HEAL_POWER += 80
		ENDIF
		IF ARGS == "休憩"
			SIF CHARA == MASTER
				HEAL_POWER += FR_SKILL_LV:GET_NO("フレンドスキル", "お昼寝マイスター") * 80
			BASE:CHARA:体力 += CALCF(TIMESF(GET_MAXBASE("体力", CHARA), 10), HEAL_POWER)
			BASE:CHARA:気力 += CALCF(TIMESF(GET_MAXBASE("気力", CHARA), 20), HEAL_POWER)
			BASE:CHARA:MP += CALCF(TIMESF(GET_MAXBASE("MP", CHARA), 15), HEAL_POWER)
		ELSE
			BASE:CHARA:体力 += CALCF(TIMESF(GET_MAXBASE("体力", CHARA), 2), HEAL_POWER)
			BASE:CHARA:気力 += CALCF(TIMESF(GET_MAXBASE("気力", CHARA), 5), HEAL_POWER)
			SIF !GROUPMATCH(GET_NAME("ショップ", FLAG:ショップコマンド), "調合", "ホムンクルス作成")
				BASE:CHARA:MP += CALCF(TIMESF(GET_MAXBASE("MP", CHARA), 5), HEAL_POWER)
		ENDIF
		BASE:CHARA:体力 = MIN(BASE:CHARA:体力, GET_MAXBASE("体力", CHARA))
		IF CFLAG:CHARA:人間
			BASE:CHARA:気力 = MIN(BASE:CHARA:気力, GET_MAXBASE("気力", CHARA))
		ELSE
			BASE:CHARA:気力 = GET_MAXBASE("気力", CHARA)
		ENDIF
		BASE:CHARA:MP = MIN(BASE:CHARA:MP, GET_MAXBASE("MP", CHARA))

		IF CFLAG:CHARA:採集場所 >= 0 && CFLAG:CHARA:採集完了日 >= DAY
			SIF GET_FRIEND_POINT(CHARA) < 60
				CALL GAIN_FRIEND_POINT, CHARA, 100 / 10
		ENDIF
	NEXT
	;なるべく処理を分散させておく
	SELECTCASE DAY % 10
		;店の在庫補充日
		CASE 1, 2
			CALL RECHARGE_STORE
		CASE 3
			;依頼テーブル作成
			CALL MAKE_REQ_TABLE
		CASE 4, 7, 9
			;依頼の消失 & 配布チェック
			CALL MAKE_REQ_MAIN
	ENDSELECT
	;ホム調合の日数更新
	FOR LOCAL:1, 0, 2
		FOR LOCAL:2, 0, 5
			SIF !GET_HOMU_MIX_PROPERTY("アイテムID", LOCAL:1, LOCAL:2)
				BREAK
			SIF !GET_HOMU_MIX_PROPERTY("必要日数", LOCAL:1, LOCAL:2)
				CONTINUE
			CALL SET_HOMU_MIX_PROPERTY("必要日数", LOCAL:1, LOCAL:2, GET_HOMU_MIX_PROPERTY("必要日数", LOCAL:1, LOCAL:2) - 1)
			SIF GET_FRIEND_POINT(LOCAL:1 ? GET_CNUM("ホムくん") # GET_CNUM("ホムちゃん")) < 60
				CALL GAIN_FRIEND_POINT, LOCAL:1 ? GET_CNUM("ホムくん") # GET_CNUM("ホムちゃん"), 100 / 5
			BREAK
		NEXT
	NEXT
	DAY++
NEXT
