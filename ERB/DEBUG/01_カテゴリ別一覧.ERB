@DEBUG_NAME_1
RESULTS = 调和类别別一覧

@DEBUG_1
#DIMS 履歴
#DIM LIST, 1000
#DIM LIST_C, 1000
DRAWLINE
FOR LOCAL, 0, 调和类别要素数
	PRINTFORM [{LOCAL,2}] %GET_NAME("调和类别", LOCAL),20,LEFT%
	SIF LOCAL % 4 == 3
		PRINTL 
NEXT
SIF !LINEISEMPTY()
	PRINTL 
INPUT
DRAWLINE
LOCAL:2 = RESULT
DRAWLINE
PRINTFORML %GET_NAME("调和类别", LOCAL:2),20,LEFT%
DRAWLINE
VARSET LIST, -1
VARSET LIST_C
FOR LOCAL, 0, 2000
	TRYCCALLFORM ITEM_CATEGORY_{LOCAL}, LOCAL:2
		SIF RESULT < 0
			CONTINUE
		LIST:(LOCAL:1) = LOCAL
		LIST_C:(LOCAL:1) = RESULT
		LOCAL:1++
	CATCH
	ENDCATCH
NEXT

DO 
	LOCAL:1 = 0
	FOR LOCAL, 0, 999
		SIF LIST:(LOCAL+1) == -1
			BREAK
		IF LIST_C:LOCAL > LIST_C:(LOCAL+1)
			SWAP LIST_C:LOCAL, LIST_C:(LOCAL+1)
			SWAP LIST:LOCAL , LIST:(LOCAL+1)
			LOCAL:1 = 1
		ENDIF
	NEXT
LOOP LOCAL:1
LOCAL = 0
WHILE LIST:LOCAL >= 0
	PRINTFORML [{LIST:LOCAL, 4}] %GET_NAME("物品", LIST:LOCAL), 20, LEFT% [{LIST_C:LOCAL,3}]
	LOCAL++
WEND
WAITANYKEY
