@DEBUG_NAME_2
RESULTS = 未实装素材检查

@DEBUG_2
#DIMS 履历
DRAWLINE
PRINTL 未实装素材
DRAWLINE
履历 = 
FOR LOCAL, 0, 2000
	TRYCCALLFORM ITEM_RECIPE_{LOCAL}
		SPLIT RESULTS, "/", LOCALS
		FOR LOCAL:1, 1, RESULT
			SIF STRCOUNT(LOCALS:(LOCAL:1), "【")
				CONTINUE
			SIF GET_NO("物品", AUTO_SPLIT(LOCALS:(LOCAL:1), "*")) >= 0
				CONTINUE
			SIF STRCOUNT(履历, AUTO_SPLIT(LOCALS:(LOCAL:1), "*"))
				CONTINUE
			PRINTFORML %AUTO_SPLIT(LOCALS:(LOCAL:1), "*")%
			履历 += AUTO_SPLIT(LOCALS:(LOCAL:1), "*")
		NEXT
	CATCH
	ENDCATCH
NEXT
WAITANYKEY
