@DEBUG_NAME_2
RESULTS = 未実装素材チェック

@DEBUG_2
#DIMS 履歴
DRAWLINE
PRINTL 未実装素材
DRAWLINE
履歴 = 
FOR LOCAL, 0, 2000
	TRYCCALLFORM ITEM_RECIPE_{LOCAL}
		SPLIT RESULTS, "/", LOCALS
		FOR LOCAL:1, 1, RESULT
			SIF STRCOUNT(LOCALS:(LOCAL:1), "【")
				CONTINUE
			SIF GET_NO("アイテム", AUTO_SPLIT(LOCALS:(LOCAL:1), "*")) >= 0
				CONTINUE
			SIF STRCOUNT(履歴, AUTO_SPLIT(LOCALS:(LOCAL:1), "*"))
				CONTINUE
			PRINTFORML %AUTO_SPLIT(LOCALS:(LOCAL:1), "*")%
			履歴 += AUTO_SPLIT(LOCALS:(LOCAL:1), "*")
		NEXT
	CATCH
	ENDCATCH
NEXT
WAITANYKEY
