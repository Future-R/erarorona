@DEBUG_NAME_4
RESULTS = 素材配置チェック

@DEBUG_4
#DIM 品質, 500, 100
#LOCALSSIZE 500
DRAWLINE
PRINTL 素材配置チェック
DRAWLINE
VARSET LOCALS
FOR LOCAL, 0, 地点总数
	FOR LOCAL:1, 0, 10
		VARSET RESULT
		TRYCCALLFORM PLACE_MATERIAL_%TOSTR(LOCAL,"X2")%, LOCAL:1
			SIF !RESULT
				BREAK
			SIF RESULT > 500
				CONTINUE
			FOR LOCAL:2, RESULT:2, RESULT:3
				品質:RESULT:(LOCAL:2) = 1
			NEXT
			SIF LOCALS:RESULT != ""
				LOCALS:RESULT += "/"
			LOCALS:RESULT += GET_NAME("地点", LOCAL)
		CATCH
			BREAK
		ENDCATCH
	NEXT
NEXT
FOR LOCAL, 0, 500
	SIF STRCOUNT(GET_NAME("物品", LOCAL), "不在")
		CONTINUE
	PRINTFORM [{LOCAL,3}] %GET_NAME("物品", LOCAL), 20, LEFT%
	FOR LOCAL:1, 0, 100
		IF 品質:LOCAL:(LOCAL:1)
			SELECTCASE LOCAL:1
				CASE IS < 60
					CALL COLORPRINT, "▀", "p-red"
				CASE IS < 80
					CALL COLORPRINT, "▀", "p-green"
				CASEELSE
					CALL COLORPRINT, "▀", "p-blue"
			ENDSELECT
		ELSE
			CALL COLORPRINT, "▀", "gray"
		ENDIF
	NEXT
NEXT
WAITANYKEY
