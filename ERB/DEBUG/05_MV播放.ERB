SONG_END_MS = 260000

; ============================================================
; ===== 播放引擎 =====
; ============================================================

HIGHLIGHT = COLOR_FROMRGB(255, 215, 0)
LYRIC_PREVIEW_MS = 3000
TICK_MS = 33
LYRIC_FADE_MS = 1200

REDRAW 0
LINE_START = LINECOUNT
STOPBGM
SETBGMVOLUME BGM_VOLUME
PLAYBGM BGM_FILE
SIF START_DELAY > 0
    TWAIT START_DELAY, 1

REDRAW 2
START_TIME = GETMILLISECOND()
CUR_IMAGE = 0
CUR_LYRIC = 0
LAST_TOP = -1
PREV_TOP = -1
LAST_BOT = -1
PREV_BOT = -1

$MV_LOOP
    SIF MESSKIP()
        GOTO MV_CLEANUP
    CUR_TICK = GETMILLISECOND() - START_TIME
    
    ; 插图索引
    TOTAL_MS = 0
    CUR_IMAGE = 0
    LOCAL = 0
    WHILE LOCAL < ILLUST_COUNT
        TOTAL_MS += ILLUST_DURATION:LOCAL
        IF CUR_TICK < TOTAL_MS
            CUR_IMAGE = LOCAL
            BREAK
        ENDIF
        CUR_IMAGE = LOCAL
        LOCAL++
    WEND
    SIF CUR_TICK > TOTAL_MS + END_DELAY
        GOTO MV_CLEANUP
    
    ; 歌词行索引（结束 = 下一行开始，尾行 = SONG_END_MS）
    CUR_LYRIC = 0
    LOCAL = 0
    WHILE LOCAL < LYRIC_COUNT
        LOCAL:10 = LOCAL + 1
        IF LOCAL:10 >= LYRIC_COUNT
            LOCAL:11 = SONG_END_MS
        ELSE
            LOCAL:11 = LYRIC_MS:(LOCAL:10)
        ENDIF
        IF CUR_TICK < LOCAL:11
            CUR_LYRIC = LOCAL
            BREAK
        ENDIF
        CUR_LYRIC = LOCAL
        LOCAL++
    WEND
    
    ; 打字机进度（START=LYRIC_MS:n, END=下一行MS或SONG_END_MS）
    LOCAL:10 = CUR_LYRIC + 1
    IF LOCAL:10 >= LYRIC_COUNT
        LOCAL:11 = SONG_END_MS
    ELSE
        LOCAL:11 = LYRIC_MS:(LOCAL:10)
    ENDIF
    IF CUR_TICK < LYRIC_MS:CUR_LYRIC
        LYRIC_PROGRESS = 0
    ELSEIF CUR_TICK >= LOCAL:11
        LYRIC_PROGRESS = 100
    ELSE
        LYRIC_PROGRESS = 100 * (CUR_TICK - LYRIC_MS:CUR_LYRIC) / (LOCAL:11 - LYRIC_MS:CUR_LYRIC)
        LYRIC_PROGRESS = LIMIT(LYRIC_PROGRESS, 0, 100)
    ENDIF
    
    ; 固定位置：奇数行(0,2,4…)左上，偶数行(1,3,5…)右下
    PREVIEW = CUR_LYRIC + 1
    SIF PREVIEW >= LYRIC_COUNT
        PREVIEW = -1
    IF CUR_LYRIC % 2 == 0
        TOP_LYRIC = CUR_LYRIC
        BOT_LYRIC = PREVIEW
    ELSE
        TOP_LYRIC = PREVIEW
        BOT_LYRIC = CUR_LYRIC
    ENDIF
    
    ; 淡出追踪（PREV 保留旧值，渲染段淡出完成后再更新）
    IF TOP_LYRIC != LAST_TOP
        TOP_CHANGE_TICK = CUR_TICK
        LAST_TOP = TOP_LYRIC
    ENDIF
    IF BOT_LYRIC != LAST_BOT
        BOT_CHANGE_TICK = CUR_TICK
        LAST_BOT = BOT_LYRIC
    ENDIF
    
    ; ---- 清屏 ----
    CLEARLINE LINECOUNT - LINE_START
    ALIGNMENT RIGHT
    PRINTSL "[右键跳过动画]"
    PRINTL 
    ALIGNMENT LEFT
    
    CALL LAYER_INIT
    IF SPRITECREATED(ILLUST_LIST:CUR_IMAGE)
        CALL LAYER_SET, GET_SINGLE_IMAGE(ILLUST_LIST:CUR_IMAGE, IMAGE_HEIGHT, 225), 0
    ELSE
        LOCALS '= @"<p align='left'>[插图未找到: " + ILLUST_LIST:CUR_IMAGE + "]</p>"
        CALL LAYER_SET, LOCALS, 0
    ENDIF
    CALL LAYER_PRINT, 0, 1
    FOR LOCAL, 0, IMAGE_HEIGHT / 100
        PRINTL
    NEXT
    
    ; ===== 倒计时专行（在歌词上方）=====
    IF CUR_TICK < LYRIC_MS:CUR_LYRIC
        REMAIN_MS = LYRIC_MS:CUR_LYRIC - CUR_TICK
        IF REMAIN_MS > 0 && REMAIN_MS <= LYRIC_PREVIEW_MS
            DOT_COUNT = REMAIN_MS / 1000 + 1
            SIF DOT_COUNT > 3
                DOT_COUNT = 3
            ALIGNMENT CENTER
            SETCOLOR HIGHLIGHT
            LOCAL = 0
            WHILE LOCAL < DOT_COUNT
                PRINTS "● "
                LOCAL++
            WEND
            RESETCOLOR
            SETCOLOR COLOR_FROMRGB(80, 60, 20)
            WHILE LOCAL < 3
                PRINTS "● "
                LOCAL++
            WEND
            RESETCOLOR
            PRINTL
        ELSE
            PRINTL
        ENDIF
    ELSE
        PRINTL
    ENDIF
    ALIGNMENT LEFT
    
    ; ===== 左上（奇数行：0,2,4…）=====
    IF TOP_LYRIC >= 0
        LOCAL:10 = LIMIT(100 * (CUR_TICK - TOP_CHANGE_TICK) / LYRIC_FADE_MS, 0, 100)
        IF LOCAL:10 < 100 && PREV_TOP >= 0 && TOP_LYRIC != PREV_TOP
            LOCAL:11 = 255 * (100 - LOCAL:10) / 100
            SIF LOCAL:11 < 30
                LOCAL:11 = 30
            ALIGNMENT LEFT
            SETCOLOR COLOR_FROMRGB(LOCAL:11, LOCAL:11 * 215 / 255, 0)
            PRINTSL "        " + LYRIC_JP:PREV_TOP
            ALIGNMENT LEFT
            PRINTSL "        " + LYRIC_CN:PREV_TOP
            RESETCOLOR
        ELSE
            PREV_TOP = TOP_LYRIC
            IF TOP_LYRIC == CUR_LYRIC
                IF LYRIC_PROGRESS > 0
                    V_CHARS = STRLENSU(LYRIC_JP:TOP_LYRIC)
                    V_SHOW = MIN((V_CHARS + 1) * LYRIC_PROGRESS / 100, V_CHARS)
                    IF V_SHOW == 0
                        LOCAL:10 = 30 + 70 * LYRIC_PROGRESS / 10
                        SIF LOCAL:10 > 100
                            LOCAL:10 = 100
                        ALIGNMENT LEFT
                        SETCOLOR COLOR_FROMRGB(255 * LOCAL:10 / 100, 255 * LOCAL:10 / 100, 255 * LOCAL:10 / 100)
                        PRINTSL "        " + LYRIC_JP:TOP_LYRIC
                        RESETCOLOR
                        ALIGNMENT LEFT
                        PRINTSL "        " + LYRIC_CN:TOP_LYRIC
                    ELSE
                        V_REST = V_CHARS - V_SHOW
                        V_SHOWN '= SUBSTRINGU(LYRIC_JP:TOP_LYRIC, 0, V_SHOW)
                        V_REMAIN '= SUBSTRINGU(LYRIC_JP:TOP_LYRIC, V_SHOW, V_REST)
                        ALIGNMENT LEFT
                        PRINTS "        "
                        SETCOLOR HIGHLIGHT
                        PRINTS V_SHOWN
                        RESETCOLOR
                        PRINTSL V_REMAIN
                        ALIGNMENT LEFT
                        PRINTSL "        " + LYRIC_CN:TOP_LYRIC
                    ENDIF
                ELSE
                    ALIGNMENT LEFT
                    SETCOLOR COLOR_FROMRGB(76, 76, 76)
                    PRINTSL "        " + LYRIC_JP:TOP_LYRIC
                    RESETCOLOR
                    ALIGNMENT LEFT
                    PRINTSL "        " + LYRIC_CN:TOP_LYRIC
                ENDIF
            ELSE
                ALIGNMENT LEFT
                PRINTSL "        " + LYRIC_JP:TOP_LYRIC
                ALIGNMENT LEFT
                PRINTSL "        " + LYRIC_CN:TOP_LYRIC
            ENDIF
        ENDIF
    ELSE
        PRINTL
        PRINTL
    ENDIF
    PRINTL
    PRINTL
    
    ; ===== 右下（偶数行：1,3,5…）=====
    IF BOT_LYRIC >= 0
        LOCAL:10 = LIMIT(100 * (CUR_TICK - BOT_CHANGE_TICK) / LYRIC_FADE_MS, 0, 100)
        IF LOCAL:10 < 100 && PREV_BOT >= 0 && BOT_LYRIC != PREV_BOT
            LOCAL:11 = 255 * (100 - LOCAL:10) / 100
            SIF LOCAL:11 < 30
                LOCAL:11 = 30
            ALIGNMENT RIGHT
            SETCOLOR COLOR_FROMRGB(LOCAL:11, LOCAL:11 * 215 / 255, 0)
            PRINTSL LYRIC_JP:PREV_BOT + "        "
            ALIGNMENT RIGHT
            PRINTSL LYRIC_CN:PREV_BOT + "        "
            RESETCOLOR
        ELSE
            PREV_BOT = BOT_LYRIC
            IF BOT_LYRIC == CUR_LYRIC
                IF LYRIC_PROGRESS > 0
                    V_CHARS = STRLENSU(LYRIC_JP:BOT_LYRIC)
                    V_SHOW = MIN((V_CHARS + 1) * LYRIC_PROGRESS / 100, V_CHARS)
                    IF V_SHOW == 0
                        LOCAL:10 = 30 + 70 * LYRIC_PROGRESS / 10
                        SIF LOCAL:10 > 100
                            LOCAL:10 = 100
                        ALIGNMENT RIGHT
                        SETCOLOR COLOR_FROMRGB(255 * LOCAL:10 / 100, 255 * LOCAL:10 / 100, 255 * LOCAL:10 / 100)
                        PRINTSL LYRIC_JP:BOT_LYRIC + "        "
                        RESETCOLOR
                        ALIGNMENT RIGHT
                        PRINTSL LYRIC_CN:BOT_LYRIC + "        "
                    ELSE
                        V_REST = V_CHARS - V_SHOW
                        V_SHOWN '= SUBSTRINGU(LYRIC_JP:BOT_LYRIC, 0, V_SHOW)
                        V_REMAIN '= SUBSTRINGU(LYRIC_JP:BOT_LYRIC, V_SHOW, V_REST)
                        ALIGNMENT RIGHT
                        SETCOLOR HIGHLIGHT
                        PRINTS V_SHOWN
                        RESETCOLOR
                        PRINTS V_REMAIN
                        PRINTSL "        "
                        ALIGNMENT RIGHT
                        PRINTSL LYRIC_CN:BOT_LYRIC + "        "
                    ENDIF
                ELSE
                    ALIGNMENT RIGHT
                    SETCOLOR COLOR_FROMRGB(76, 76, 76)
                    PRINTSL LYRIC_JP:BOT_LYRIC + "        "
                    RESETCOLOR
                    ALIGNMENT RIGHT
                    PRINTSL LYRIC_CN:BOT_LYRIC + "        "
                ENDIF
            ELSE
                ALIGNMENT RIGHT
                PRINTSL LYRIC_JP:BOT_LYRIC + "        "
                ALIGNMENT RIGHT
                PRINTSL LYRIC_CN:BOT_LYRIC + "        "
            ENDIF
        ENDIF
    ELSE
        PRINTL
        PRINTL
    ENDIF
    
    ALIGNMENT LEFT
    
    TWAIT TICK_MS, 0
GOTO MV_LOOP

$MV_CLEANUP
REDRAW 1
STOPBGM
CLEARLINE LINECOUNT - LINE_START
RETURN
