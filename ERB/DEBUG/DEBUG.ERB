@DEBUG
#DIMS 履歴
CALL MAKE_NOLIST
LOCAL:1 = 0
FOR LOCAL, 0, 100
	TRYCCALLFORM DEBUG_NAME_{LOCAL}
		PRINTFORM [{LOCAL,2}] %RESULTS,20,LEFT%
		SIF LOCAL:1 % 4 == 3
			PRINTL 
		LOCAL:1++
	CATCH
	ENDCATCH
NEXT
SIF !LINEISEMPTY()
	PRINTL 
INPUT
TRYCALLFORM DEBUG_{RESULT}
RESTART

@MATCH_D, L_ARRAY, ARG = -1, VALUE, FIRST = 0, END = -1
#FUNCTION
#LOCALSIZE 3
#DIM REF L_ARRAY, 0, 0
#DIM VALUE
#DIM FIRST
#DIM END
SIF END == -1
	END = VARSIZE("L_ARRAY", 1)
LOCAL:1 = 0
IF ARG == -1
	FOR LOCAL:2, 0, VARSIZE("L_ARRAY", 0)
		FOR LOCAL, FIRST, END
			LOCAL:1 += (L_ARRAY:(LOCAL:2):LOCAL == VALUE)
		NEXT
	NEXT
ELSE
	FOR LOCAL, FIRST, END
		LOCAL:1 += (L_ARRAY:ARG:LOCAL == VALUE)
	NEXT
ENDIF
RETURNF LOCAL:1
