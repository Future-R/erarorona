@START_ENDING, ARGS
	IF ISNUMERIC(ARGS)
		FLAG:结局指定 = TOINT(ARGS)
	ELSE
		FLAG:结局指定 = GET_NO("结局", ARGS)
	ENDIF
	CALLFORM ENDING_ACT_{FLAG:结局指定}
	
	CALL BGM, "相遇是炼金术.mp3"
	; 结局自定义是否跳过询问、强制结束
	TRYCCALLFORM ENDING_FORCE_EXIT_{FLAG:结局指定}
	CATCH
		RESULT = 0
	ENDCATCH
	SIF RESULT == 1
		GOTO FORCE_TAKE_OVER
	
	CALL LAYER_INIT
	CALL LAYER_DRAWLINE, 0
	CALL LAYER_SET, @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", 1
	CALL LAYER_DRAWLINE, 2
	CALL LAYER_DRAWLINE, MAXLINE() - 7
	
	CALL LAYER_PRINT, , MAXLINE() - 6
	CALL MESSAGE_WINDOW, "", "恭喜通关游戏。/请选择/继续游戏还是结束游戏。"
	CALL MESSAGE_WINDOW, "", "结束游戏的话，将继承一部分状态，/另外也可以重头开始进行游戏。"
	CALL MESSAGE_WINDOW, "", "此外，继续游戏的话，也可以在任意时间点结束游戏，/并进行继承处理。"
	CALL INPUT_YN, "继续游戏", "结束游戏"
	IF RESULT
		FLAG:SHOP指令 = GET_NO("SHOP", "通关游戏")
		CALL TAKE_OVER
	ELSE
		FLAG:SHOP指令 = 0
		CALL MESSAGE_WINDOW, "", "那么，请继续享受游戏。"
	ENDIF
	
	RETURN

$FORCE_TAKE_OVER
	FLAG:SHOP指令 = GET_NO("SHOP", "通关游戏")
	CALL TAKE_OVER
