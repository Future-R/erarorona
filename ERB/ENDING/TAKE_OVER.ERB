@TAKE_OVER
CALL SHOW_CALC_TAKE_OVER
CALL CHOICE_TAKE_OVER
CALL SET_GAMESTART
CALL START_EVENT

;---------------------------------------------------------------------
;@SHOW_CALC_TAKE_OVER
;特典ポイント・引き継ぎ資金・继承公会点数の計算と表示を行う。
;---------------------------------------------------------------------
@SHOW_CALC_TAKE_OVER
#LOCALSIZE 3
#DIM LINE
REDRAW 0

FLAG:SHOP指令 = GET_NO("SHOP", "通关游戏")
		
TO_POINT = 0
VARSET TO_CHOICE
TO_CHOICE:GET_NO("特典", "继承霍姆克鲁斯") = 1
TO_CHOICE:GET_NO("特典", "继承友人") = 2


LINE = LINECOUNT
CALL LAYER_INIT
CALL LAYER_DRAWLINE, 0
CALL LAYER_SET, "多周目特典", 1
CALL LAYER_DRAWLINE, 2
CALL LAYER_PRINT, , MAXLINE() - 6
CALL MESSAGE_WINDOW, "", "通关游戏辛苦啦。/在这里可以消费根据游戏内容所得到的特典点数，/获得包括继承存档在内的多周目特典。"
CALL MESSAGE_WINDOW, "", "接下来首先计算通过本次游戏/所获得的特典点数。"
CALL LAYER_SET, "特典点数", 3
CALL LAYER_DRAWLINE, 4
FOR LOCAL, 5, 12
	CLEARLINE LINECOUNT - LINE
	SELECTCASE LOCAL
		CASE 5
			LOCAL:1 = POWER(FLAG:公会等阶 + 2, 2)
			CALL LAYER_SET, FORMCELL("公会等阶评价", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 6
			LOCAL:1 = POWER(GET_MIXLV() / 5, 2) / 2
			CALL LAYER_SET, FORMCELL("调合等级评价", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 7
			LOCAL:1 = 0
			FOR LOCAL:2, 0, CHARANUM
				SIF !CFLAG:(LOCAL:2):人类
					CONTINUE
				SELECTCASE GET_FRIEND_POINT((LOCAL:2))
					CASE 100
						LOCAL:1 += 10
					CASE IS >= 80
						LOCAL:1 += 5
					CASE IS >= 50
						LOCAL:1 += 2
					CASE IS >= 30
						LOCAL:1 += 1
				ENDSELECT
				SIF 陷落(LOCAL:2)
					LOCAL:1 += 10
			NEXT
			CALL LAYER_SET, FORMCELL("好友攻略评价", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 8
			LOCAL:1 = 0
			CALLFORM ENDING_BONUS_{FLAG:结局指定}
			LOCAL:1 = RESULT
			CALL LAYER_SET, FORMCELL("结局评价", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 9
			LOCAL:1 = FLAG:继承特典点数
			CALL LAYER_SET, FORMCELL("继承点数", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 10
			LOCAL:1 = 0
			CALL LAYER_DRAWLINE, LOCAL
		CASE 11
			LOCAL:1 = 0
			CALL LAYER_SET, FORMCELL("合计点数", 20, "LEFT") + ":" + @"{TO_POINT, 10}", LOCAL
	ENDSELECT
	TO_POINT += LOCAL:1 
	CALL LAYER_PRINT, , MAXLINE()
	TWAIT 500, 0
NEXT
CLEARLINE 6
CALL LAYER_DRAWLINE, 12
CALL LAYER_SET, "基本克尔", 13
CALL LAYER_DRAWLINE, 14
CALL MESSAGE_WINDOW, "", "接下来计算继承时可用的基本克尔。"
FOR LOCAL, 15, 20
	CLEARLINE LINECOUNT - LINE
	SELECTCASE LOCAL
		CASE 15
			LOCAL:1 = MONEY
			CALL LAYER_SET, FORMCELL("资金", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 16
			LOCAL:1 = 0
			FOR LOCAL:2, GET_ITEM_RANGE("持有"), GET_ITEM_RANGE("持有", 1)
				SIF GET_ITEMDATA(LOCAL:2, "ID")
					LOCAL:1 += GET_SELL_PRICE(LOCAL:2)
			NEXT
			CALL LAYER_SET, FORMCELL("持有物品总额", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 17
			LOCAL:1 = FLAG:累计报酬额 * 2
			CALL LAYER_SET, FORMCELL("委托达成奖励", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 18
			LOCAL:1 = 0
			CALL LAYER_DRAWLINE, LOCAL
		CASE 19
			LOCAL:1 = 0
			CALL LAYER_SET, FORMCELL("合计克尔", 20, "LEFT") + ":" + @"{TO_MONEY, 10}", LOCAL
	ENDSELECT
	TO_MONEY += LOCAL:1 
	CALL LAYER_PRINT, , MAXLINE()
	TWAIT 500, 0
NEXT
CLEARLINE 6
CALL LAYER_DRAWLINE, 20
CALL LAYER_SET, "基本公会点数", 21
CALL LAYER_DRAWLINE, 22
CALL MESSAGE_WINDOW, "", "接下来计算继承时可用的基本公会点数。"
FOR LOCAL, 23, 27
	CLEARLINE LINECOUNT - LINE
	SELECTCASE LOCAL
		CASE 23
			LOCAL:1 = FLAG:调教师EXP * 5
			CALL LAYER_SET, FORMCELL("调教经验", 20, "LEFT") + ":" + @"{LOCAL:1 / 5, 5} * 5 = {LOCAL:1, 5}", LOCAL
		CASE 24
			LOCAL:1 = FLAG:已缴费 * 1000000
			CALL LAYER_SET, FORMCELL("缴费奖励", 20, "LEFT") + ":" + @"{LOCAL:1, 10}", LOCAL
		CASE 25
			LOCAL:1 = 0
			CALL LAYER_DRAWLINE, LOCAL
		CASE 26
			LOCAL:1 = 0
			CALL LAYER_SET, FORMCELL("合计公会点数", 20, "LEFT") + ":" + @"{TO_GPOINT, 10}", LOCAL
	ENDSELECT
	TO_GPOINT += LOCAL:1 
	CALL LAYER_PRINT, , MAXLINE()
	TWAIT 500, 0
NEXT
CLEARLINE 6
CALL MESSAGE_WINDOW, "", "那么，请选择要获得的多周目特典。"

;----------------------------------------------------------------------
;@CHOICE_TAKE_OVER
;周回特典の選択関数
;----------------------------------------------------------------------
@CHOICE_TAKE_OVER
#LOCALSIZE 3
#DIM LINE
#DIM LAYER_X
#DIM LAYER_Y
#DIM PAGE
#DIM MAXPAGE
#DIM NUM
#DIM CHOICE
#DIM L_COLOR
#DIM LIST, 200
#DIM TEMP
VARSET LIST
LOCAL:1 = 0
FOR LOCAL, 0, 200
	TRYCCALLFORM TAKE_OVER_NAME_{LOCAL}
		LIST:(LOCAL:1) = LOCAL
		LOCAL:1++
	CATCH
	ENDCATCH
NEXT
MAXPAGE = (LOCAL:1 - 1) / 15


REDRAW 0
LINE = LINECOUNT
$START
TO_USE_POINT = 0
FOR LOCAL, 0, VARSIZE("TO_CHOICE")
	SIF !TO_CHOICE:LOCAL
		CONTINUE
	CALLFORM TAKE_OVER_COST_{LOCAL}
	TO_USE_POINT += RESULT
NEXT
CLEARLINE LINECOUNT - LINE
LINE = LINECOUNT
CALL LAYER_INIT
CALL LAYER_DRAWLINE, 0
CALL LAYER_SET, "多周目特典" + " " * 60 + @"　　　特典点数:{TO_USE_POINT,4}/{TO_POINT,4}", 1
CALL LAYER_DRAWLINE, 2
;42 * 6
FOR LOCAL, 0, 5
	LAYER_Y = 3 + LOCAL * 6
	FOR LOCAL:1, 0, 3
		NUM = LIST:(PAGE * 15 + LOCAL * 3 + LOCAL:1)
		LAYER_X = 42 * LOCAL:1
		L_COLOR = COLOR("DEF")
		IF NUM
			CALLFORM TAKE_OVER_COST_{NUM}
			TEMP = RESULT
			SIF !GROUPMATCH(NUM, GET_NO("特典", "继承霍姆克鲁斯"), GET_NO("特典", "继承友人")) && TEMP + TO_USE_POINT > TO_POINT
				L_COLOR = COLOR("gray")
			IF NUM == GET_NO("特典", "继承霍姆克鲁斯")
				SIF CMATCH(CFLAG:继承标识, 1)
					L_COLOR = COLOR("p-blue")
			ELSEIF NUM == GET_NO("特典", "继承友人")
				SIF CMATCH(CFLAG:继承标识, 2)
					L_COLOR = COLOR("p-blue")
			ELSE
				SIF TO_CHOICE:NUM
					L_COLOR = COLOR("p-blue")
			ENDIF
			CALLFORM TAKE_OVER_NAME_{NUM}
			CALL LAYER_SET, ADD_BTAG(ADD_FTAG("┌" + "[" + @"{NUM, 3}" +"] " + RESULTS+ " " * (STRLENS(RESULTS) % 2) + "─" * (16 - STRLENS(RESULTS) / 2 - (STRLENS(RESULTS) % 2))  + "┐", L_COLOR), NUM), LAYER_Y, LAYER_X
			CALL LAYER_SET, ADD_BTAG(ADD_FTAG("│" + FORMCELL(@"所需点数:{TEMP, 3}", 38, "LEFT") + "│", L_COLOR), NUM), LAYER_Y + 1, LAYER_X
			VARSET RESULTS
			CALLFORM TAKE_OVER_EXPLAIN_{NUM}
			CALL LAYER_SET, ADD_BTAG(ADD_FTAG("│" + FORMCELL(AUTO_SPLIT(RESULTS, "/", 0), 38, "LEFT") + "│", L_COLOR), NUM), LAYER_Y + 2, LAYER_X
			CALL LAYER_SET, ADD_BTAG(ADD_FTAG("│" + FORMCELL(AUTO_SPLIT(RESULTS, "/", 1), 38, "LEFT") + "│", L_COLOR), NUM), LAYER_Y + 3, LAYER_X
			CALL LAYER_SET, ADD_BTAG(ADD_FTAG("│" + FORMCELL(AUTO_SPLIT(RESULTS, "/", 2), 38, "LEFT") + "│", L_COLOR), NUM), LAYER_Y + 4, LAYER_X
			CALL LAYER_SET, ADD_BTAG(ADD_FTAG("└" + "─" * 19 + "┘", L_COLOR), NUM), LAYER_Y + 5, LAYER_X
		ENDIF
	NEXT
NEXT
LAYER_Y = MAXLINE() - 7
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, "　" + FORMCELL(@"页码.{PAGE}", 20, "LEFT") + ADD_BTAG(FORMCELL("[-] 上一页", 32, "LEFT"), "-") + " " * 32 + ADD_BTAG(FORMCELL("[+] 下一页", 32, "LEFT"), "+"), LAYER_Y + 1
CALL LAYER_SET, " " * 22 + ADD_BTAG("[*] 整理物品", "*"), LAYER_Y + 2
CALL LAYER_SET, " " * 22 + ADD_BTAG("[0] 结束", "0"), LAYER_Y + 3
CALL LAYER_PRINT, , MAXLINE()
INPUTS
SELECTCASE RESULTS
	CASE "0"
		RETURN 0
	CASE "1"
		CALL SHOW_CHARALIST, "继承霍姆克鲁斯"
	CASE "2"
		CALL SHOW_CHARALIST, "继承友人"
	CASE "-"
		SIF PAGE-- == 0
			PAGE = MAXPAGE
	CASE "+"
		SIF PAGE++ == MAXPAGE
			PAGE = 0
	CASE "*"
		CALL SHOW_ITEMLIST, "篮子", "篮子"
	CASEELSE
		IF ISNUMERIC(RESULTS)
			NUM = TOINT(RESULTS)
			IF TO_CHOICE:NUM
				TO_CHOICE:NUM = 0
			ELSE
				TRYCCALLFORM TAKE_OVER_COST_{NUM}
					IF TO_POINT >= TO_USE_POINT + RESULT
						TO_CHOICE:NUM = 1
						VARSET RESULT
						TRYCCALLFORM TAKE_OVER_OFFSET_{NUM}
							FOR LOCAL, 0 , 5
								TO_CHOICE:(RESULT:LOCAL) = 0
							NEXT
						CATCH
						ENDCATCH
					ENDIF
				CATCH
				ENDCATCH
			ENDIF
		ENDIF
ENDSELECT
GOTO START

@IS_TAKE_OVER, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF TO_CHOICE:TOINT(ARGS)
ELSE
	RETURNF TO_CHOICE:GET_NO("特典", ARGS)
ENDIF
