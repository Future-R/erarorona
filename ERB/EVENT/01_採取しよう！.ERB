@EVENT_NAME_1
RESULTS = 采集吧！

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_1
SIF !GET_EVENT_PLAY("采集吧！")
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:商店指令 == GET_NO("商店", "探索")
	RETURN 0
SIF !HAVE_ITEM("曼德拉草根茎")
	RETURN 0
RETURN 1

@EVENT_ACT_1
#DIM START
START = GET_ITEM_TOTAL("箱子") + GET_ITEM_RANGE("箱子")
;初期アイテム
FOR LOCAL, START, START + 30
	SELECTCASE LOCAL - START
		CASE 0 TO 2
			;							    		名前/ランク/品質/価格/                  特性
			RESULT = GET_NO("アイテム", "安らぎの花"),       2,   40,  10, GET_NO("特性", "淳朴Lv1"), 0
		CASE 3 TO 5
			RESULT = GET_NO("アイテム", "マジックグラス"),   2,   40,  10, 0, 0
		CASE 6 TO 10
			RESULT = GET_NO("アイテム", "水"),               3,   60,   1, 0, 0 
		CASE 11 TO 15
			RESULT = GET_NO("アイテム", "面粉"),           2,   40,  30, 0, 0
		CASE 16 TO 20
			RESULT = GET_NO("アイテム", "塩"),               2,   40,  20, 0, 0
		CASE 21 TO 23
			RESULT = GET_NO("アイテム", "アードラの尾羽"), 2,   40,  10, GET_NO("特性", "服从+"), GET_NO("特性", "好奇心Lv1")
		CASE 24 TO 26
			RESULT = GET_NO("アイテム", "弾む石"),           2,   40,  10, GET_NO("特性", "效果アップLv1"), 0
		CASE 27 TO 30
			RESULT = GET_NO("アイテム", "震える結晶"),       2,   40,  10, GET_NO("特性", "高品質Lv1"), 0
	ENDSELECT
	CALL SET_ITEMDATA, LOCAL, "ID", RESULT
	CALL SET_ITEMDATA, LOCAL, "クオリティ", RESULT:1
	CALL SET_ITEMDATA, LOCAL, "品質", RESULT:2
	CALL SET_ITEMDATA, LOCAL, "価格", RESULT:3
	CALL SET_ITEMDATA, LOCAL, "特性0", RESULT:4
	CALL SET_ITEMDATA, LOCAL, "特性1", RESULT:5
	;目录の設定
	CALL SET_CATEGORY, LOCAL
	;LVの設定
	CALLFORM ITEM_LV_{GET_ITEMDATA(LOCAL, "ID")}
	CALL SET_ITEMDATA, LOCAL, "等级", RESULT
NEXT

CALL SHOW_SITUATION, "萝乐娜的工房"

CALL MESSAGE_WINDOW, "萝乐娜", "ただいまー"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "おかえりなさいませ。マスター"
CALL MESSAGE_WINDOW, "萝乐娜", "えっと、マンドラゴラの根って、これで大丈夫だよね？"
CALL MESSAGE_WINDOW, "霍姆弟弟", "大丈夫です"
CALL MESSAGE_WINDOW, "霍姆妹妹", "箱子にアトリエにあった素材をいれておきました"
CALL MESSAGE_WINDOW, "霍姆弟弟", "中和剤とアードラの尾羽とマンドラゴラの根でホムンクルスを作れます"
CALL MESSAGE_WINDOW, "萝乐娜", "うん"
CALL MESSAGE_WINDOW, "霍姆妹妹", "まずは[20] 调合を選んで中和剤を作成してください"
CALL MESSAGE_WINDOW, "霍姆弟弟", "できたら[21] ホムンクルス作成を選んでください"
CALL MESSAGE_WINDOW, "萝乐娜", "うん、わかった"
CALL MESSAGE_WINDOW, "霍姆弟弟", "もし手持ちの素材が気に入らなければ、また探索にでてください"
CALL MESSAGE_WINDOW, "霍姆妹妹", "北の旅人の街道までいけば、【アードラの尾羽】を拾えます"
CALL MESSAGE_WINDOW, "霍姆弟弟", "近くの森の先のうに林にもいろいろな素材があります"
CALL MESSAGE_WINDOW, "萝乐娜", "わかったよ/ありがとう"
CALL MESSAGE_WINDOW, "", "うに林にいけるようになった/旅人の街道にいけるようになった"
CALL MESSAGE_WINDOW, "萝乐娜", "あとは…お店で買うってのもいいのかな？/あとで行ってみよう"
CALL SET_EVENTFLAG, "采集吧！", "达成"
CALL SET_EVENTFLAG, "ホムンクルスを作ろう！", "开始"
CALL SHOW_HELP, "调合"
CALL SHOW_HELP, "ホムンクルス作成"
RETURN 1
@EVENT_NOTE_1
IF GET_EVENT_ATTAIN(1)
	RESULTS = 師匠には色々言いたいことがあるけど/とにかくホムンクルスを作ってみるしかなさそうだったので/近くの森でマンドラゴラの根を採取してきた/理由はともかくとしてやっと錬金術士っぽいことができて嬉しかった
ELSE
	RESULTS = 師匠には色々言いたいことがあるけど/とにかく今はホムンクルスを作ってみるしかなさそう……/そのためには【エリキシル】の目录に含まれるアイテムが必要だとか/近くの森で採れるマンドラゴラの根が【エリキシル】に含まれるので/さっそく[10] 探索 を選んで採取しにいこう。
ENDIF

@EVENT_HEADER_1
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-ロロナのアトリエ-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE

