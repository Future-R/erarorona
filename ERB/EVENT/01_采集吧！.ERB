@EVENT_NAME_1
RESULTS = 采集吧！

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_1
SIF !GET_EVENT_PLAY("采集吧！")
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
SIF !HAVE_ITEM("风茄的根")
	RETURN 0
RETURN 1

@EVENT_REPLAY_1
SIF GET_EVENT_PLAY("采集吧！")
	RETURN 0
RETURN 1

@EVENT_ACT_1
#DIM START
SELECTCASE FLAG:回想分支
	CASE 1
		GOTO 第1节
	CASEELSE
		
ENDSELECT
START = GET_ITEM_TOTAL("箱子") + GET_ITEM_RANGE("箱子")
;初期アイテム
FOR LOCAL, START, START + 30
	SELECTCASE LOCAL - START
		CASE 0 TO 2
			;							    		名前/ランク/品质/価格/                  特性
			RESULT = GET_NO("物品", "宁静花"),       2,   40,  10, GET_NO("特性", "淳朴Lv1"), 0
		CASE 3 TO 5
			RESULT = GET_NO("物品", "魔法草"),   2,   40,  10, 0, 0
		CASE 6 TO 10
			RESULT = GET_NO("物品", "水"),               3,   60,   1, 0, 0 
		CASE 11 TO 15
			RESULT = GET_NO("物品", "面粉"),           2,   40,  30, 0, 0
		CASE 16 TO 20
			RESULT = GET_NO("物品", "盐"),               2,   40,  20, 0, 0
		CASE 21 TO 23
			RESULT = GET_NO("物品", "飞鹰的尾羽"), 2,   40,  10, GET_NO("特性", "服从+"), GET_NO("特性", "好奇心Lv1")
		CASE 24 TO 26
			RESULT = GET_NO("物品", "弹跳石"),           2,   40,  10, GET_NO("特性", "效果上升Lv1"), 0
		CASE 27 TO 30
			RESULT = GET_NO("物品", "震动结晶"),       2,   40,  10, GET_NO("特性", "高品质Lv1"), 0
	ENDSELECT
	CALL SET_ITEMDATA, LOCAL, "ID", RESULT
	CALL SET_ITEMDATA, LOCAL, "品阶", RESULT:1
	CALL SET_ITEMDATA, LOCAL, "品质", RESULT:2
	CALL SET_ITEMDATA, LOCAL, "价格", RESULT:3
	CALL SET_ITEMDATA, LOCAL, "特性0", RESULT:4
	CALL SET_ITEMDATA, LOCAL, "特性1", RESULT:5
	;调合类别の設定
	CALL SET_CATEGORY, LOCAL
	;LVの設定
	CALLFORM ITEM_LV_{GET_ITEMDATA(LOCAL, "ID")}
	CALL SET_ITEMDATA, LOCAL, "等级", RESULT
NEXT
$第1节
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL BGM, "萝乐娜的工房.mp3"

CALL MESSAGE_WINDOW, "萝乐娜", "我回来啦ーー"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "欢迎回来，主人。"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯，这个风茄的根，应该能用吧？"
CALL MESSAGE_WINDOW, "霍姆弟弟", "可以的。"
CALL MESSAGE_WINDOW, "霍姆妹妹", "我已经把工房里的素材放到箱子里了。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "用中和剂、飞鹰的尾羽和风茄的根就能做出霍姆克鲁斯了。"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯。"
CALL MESSAGE_WINDOW, "霍姆妹妹", "首先请选择【[20] 调合】来制作中和剂。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "制作完中和剂后，请选择【[21] 制作霍姆克鲁斯】。"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯，知道了。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "如果主人不满意现有的素材，可以再去探索。"
CALL MESSAGE_WINDOW, "霍姆妹妹", "去北方的旅人街道，可以捡到【飞鹰的尾羽】。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "附近的森林深处有海胆森林，那里也有各种素材。"
CALL MESSAGE_WINDOW, "萝乐娜", "我知道了。/谢谢！"
CALL SOLO, "试试看吧.mp3"
CALL MESSAGE_WINDOW, "", "可以前往海胆森林了/可以前往旅人街道了"
CALL MESSAGE_WINDOW, "萝乐娜", "对了，是不是也能去店里买呢？/之后再去看看吧。"
CALL SET_EVENTFLAG, "采集吧！", "达成"
CALL SET_EVENTFLAG, "制造霍姆克鲁斯吧！", "开始"

CALL SHOW_HELP, "调合"
RETURN 1
@EVENT_NOTE_1
IF GET_EVENT_ATTAIN(1)
	RESULTS = 虽然有很多话想对师傅说，/但总之现在只能先试着制作霍姆克鲁斯，/于是我就去附近的森林采集了风茄的根。/不管怎么说，终于能做些像炼金术士会做的事，我觉得很开心。
ELSE
	RESULTS = 虽然有很多话想对师傅说，/但现在看来，只能先试着制作霍姆克鲁斯了……/听说为此需要【万灵药】分类的素材，/而附近的森林里可以采集到属于【万灵药】的风茄的根。/所以马上选择【[10] 探索】，去采集吧！
	IF FLAG:采集提示
		RESULTS += @"//顺利采集到一些材料了。/但难得出来一趟，还是多采集一些比较好吧？/不过也不能超过篮子空间。/篮子的空间在探索界面右上角可以检查。"
	ENDIF
ENDIF

@EVENT_HEADER_1
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE

