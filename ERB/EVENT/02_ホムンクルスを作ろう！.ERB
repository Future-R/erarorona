;とりあえず暫定でおいておく
@EVENT_NAME_2
RESULTS = 制造霍姆克鲁斯吧！

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_2
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
SIF !GET_EVENT_PLAY("制造霍姆克鲁斯吧！")
	RETURN 0
SIF !CMATCH(CFLAG:0:人类, 0) 
	RETURN 0
RETURN 1

@EVENT_ACT_2
;CALL SHOW_SITUATION, "ロロナのアトリエ"
;DRAWLINE
;PRINTFORML 　{YEAR()}年目 {MONTH(),2}月 {DAYS(),2}日%"", 10%-ロロナのアトリエ-%"",20%所持金:{MONEY:0, 9}コール
;DRAWLINE
;CALL ADD_LINE, MAXLINE() - 3 - 6
CALL SET_EVENTFLAG, "制造霍姆克鲁斯吧！", "达成"
CALL SET_EVENTFLAG, "第一次调教", "开始"

@EVENT_NOTE_2
IF GET_EVENT_ATTAIN(2)
	RESULTS = 本来还觉得是天方夜谭的，/没想到调合很顺利，/霍姆克鲁斯也顺利做出来了，/说不定我真的很有天赋呢！
ELSE
	RESULTS = 霍姆克鲁斯所需的材料应该已经集齐了。/接下来选择【[20] 调合】并制作中和剂，/然后照着《基础霍姆克鲁斯制作法》，/选择霍姆克鲁斯的配方，/使用中和剂、飞鹰的尾羽还有风茄的根来制作就没问题了。//
	RESULTS += "但如果想要更好的材料的话，/又或者把材料搞丢了的话，/【神秘之力】要在附近的森林里获取风茄的根，/【万灵药】要在海胆森林里捡碎石才行。"
ENDIF

@EVENT_HEADER_2
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE