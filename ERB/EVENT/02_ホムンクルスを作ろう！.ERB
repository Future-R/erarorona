;とりあえず暫定でおいておく
@EVENT_NAME_2
RESULTS = ホムンクルスを作ろう！

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_2
SIF FLAG:現地点 != GET_NO("場所", "アーランド")
	RETURN 0
SIF FLAG:ショップコマンド == GET_NO("ショップ", "探索")
	RETURN 0
SIF !GET_EVENT_PLAY("ホムンクルスを作ろう！")
	RETURN 0
SIF !CMATCH(CFLAG:0:人間, 0) 
	RETURN 0
RETURN 1

@EVENT_ACT_2
;CALL SHOW_SITUATION, "ロロナのアトリエ"
;DRAWLINE
;PRINTFORML 　{YEAR()}年目 {MONTH(),2}月 {DAYS(),2}日%"", 10%-ロロナのアトリエ-%"",20%所持金:{MONEY:0, 9}コール
;DRAWLINE
;CALL ADD_LINE, MAXLINE() - 3 - 6
CALL SET_EVENTFLAG, "ホムンクルスを作ろう！", "達成"
CALL SET_EVENTFLAG, "初調教", "開始"

@EVENT_NOTE_2
IF GET_EVENT_ATTAIN(2)
	RESULTS = ぜったい無理だと思ってたけど/調合もうまくいったし/ホムンクルスも無事に作れたし/もしかしたらわたしってすごいのかも！
ELSE
	RESULTS = ホムンクルスを作る材料は揃ったはず/あとは[20] 調合を選んで中和剤を作ってから/[21] ホムンクルス作成で基礎ホムンクルス作成のレシピを選んで/中和剤とアードラの尾羽とマンドラゴラの根を使って作れば大丈夫//
	RESULTS += "でも、もっと良い材料が欲しかったり/万が一材料をなくしちゃった場合は/【神秘の力】は近くの森でマンドラゴラの根を/【エリキシル】はうに林で石ころを拾ってこなきゃだめそう"
ENDIF

@EVENT_HEADER_2
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-ロロナのアトリエ-%"",20%所持金:{MONEY:0, 9}コール", ""
