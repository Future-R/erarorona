;とりあえず暫定でおいておく
@EVENT_NAME_3
RESULTS = 第一次调教

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_3
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF GET_EVENT_STATE("第一次调教") != "第一次调教结束"
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
RETURN 1

@EVENT_ACT_3
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL MESSAGE_WINDOW, "亚斯特丽德", "萝乐娜哟，/感觉怎么样？"
CALL MESSAGE_WINDOW, "萝乐娜", "什么感觉怎么样……？/你是指什么？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "那当然是指你试着调教完之后，感觉怎么样。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶……！？/你，你在问什么啊！/这种东西怎么可能说得出口啊！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "嗯哼。是吗？/不过，不能说的话也没关系啦。/反正，我已经看到你们调教的过程了。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "果然，该说是在技术上还差得远了嘛。/总之，一团糟啊。/话虽如此，但青涩的第一次就有那样的破坏力，已经挺好了哦。"
CALL MESSAGE_WINDOW, "萝乐娜", "请您别说了！/光这样已经够羞耻的了！/话说，这难道不是犯罪吗！！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "不不，作为师傅，当然得好好见证弟子的成长呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "大可不必！！"
CALL MESSAGE_WINDOW, "霍姆弟弟", "主人，抱歉在您繁忙的时候打扰您。"
CALL MESSAGE_WINDOW, "霍姆妹妹", "能帮我烤一个馅饼吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "馅饼吗？/可以呀，是打算当作点心吗？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "霍姆克鲁斯的疲劳很难消除呢。/如果因为调教消耗了体力，就需要用食物恢复精力。"
CALL MESSAGE_WINDOW, "萝乐娜", "是吗？/那么，我马上就去烤馅饼啦。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "……等一下。"
CALL MESSAGE_WINDOW, "萝乐娜", "怎么？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "我常常觉得，你做馅饼的手艺实在是了不起啊。"
CALL MESSAGE_WINDOW, "萝乐娜", "嘿嘿，过奖啦。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "主人做的馅饼不仅种类繁多，/更难得的是每一种都有非常丰富的味道。"
CALL MESSAGE_WINDOW, "霍姆妹妹", "在做馅饼的手艺方面，我想应该没人能比得上主人。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "这些家伙们是这么说的。/虽然家务、学习、运动、体贴、待人出世和运势都马马虎虎，/但唯独做馅饼的手艺应该可以自豪吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "……其实……没有那么厉害啦……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "但是，果然说你有特长，/还是不太合适啊。/这可是关系到我，/作为废柴少女培育大师的尊严呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "废，废柴少女培育大师？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "好的，我决定了。/从现在开始禁止做馅饼！"
CALL MESSAGE_WINDOW, "萝乐娜", "咦？/……诶诶诶诶！？/为，为什么啊！？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "你也算是个炼金术士吧。/那么，在厨房做菜就是歪门邪道！/用炼金釜做出所有东西才叫做炼金术士！"
CALL MESSAGE_WINDOW, "萝乐娜", "怎么这样，简直太乱来了！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "这可不是乱来哦。/炼金术里其实也有正经的制作馅饼的配方呢。/因为一直没用上，所以忘得一干二净了。"
CALL MESSAGE_WINDOW, "萝乐娜", "馅饼这种料理，用正常的方法烤不是更快吗！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "如果想做馅饼就用炼金术做。/这是为师的命令！"
CALL MESSAGE_WINDOW, "萝乐娜", "怎么这样……/制作馅饼……明明是我唯一的兴趣……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "这也是，/为了让你成为一流炼金术士的试炼。/明白为师的苦心吧。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "好的，那么我马上去给你找和馅饼有关的参考书吧。"
CALL MESSAGE_WINDOW, "", "亚斯特丽德脸上浮现出笑意，向书架方向走去……"
CALL MESSAGE_WINDOW, "萝乐娜", "……骗人吧。/看她表情，绝对是觉得好玩……/呜呜呜——……"
CALL MESSAGE_WINDOW, "", "获得了【炼金术制作的馅饼】"
RECIPE:GET_NO("参考书", "炼金术制作的馅饼") = 1
CALL SET_EVENTFLAG, "第一次调教", "达成"
;CALL HELP_調教
RETURN 1

@EVENT_NOTE_3
IF GET_EVENT_ATTAIN(3)
	RESULTS = 等回过神来，已经结束了。/虽然感觉做得不好，/总之只能加油。//另外，师傅好像有在偷看……/果然师傅乐在其中啊！/之后会变成什么样呢，好担心……
ELSE
	RESULTS = 真的必须这样做吗……/总感觉有什么不对劲。/暂且不论师傅，既然霍姆弟弟和霍姆妹妹说没问题的话，那应该没事吧……？
ENDIF
@EVENT_HEADER_3
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE