@EVENT_HEADER_4
DRAWLINE
SELECTCASE FLAG:事件内的分歧
	CASE 0
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-工房前-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 1
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 2
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-广场-%"",20%资金:{MONEY:0, 9}克尔", ""
ENDSELECT
PRINTL 
DRAWLINE

