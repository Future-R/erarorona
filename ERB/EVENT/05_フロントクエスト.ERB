@EVENT_NAME_5
RESULTS = 前台任务

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_5
#LOCALSIZE 3
SIF GET_EVENT_ATTAIN("前台任务")
	RETURN 0
;1年目3月1日以降に発生
SIF CONVERT_DAY(1, 3, 1) > DAY
	RETURN 0
SIF FLAG:商店指令 == GET_NO("商店", "探索")
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
RETURN 1

