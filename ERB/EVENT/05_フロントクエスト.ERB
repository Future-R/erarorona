@EVENT_NAME_5
RESULTS = 柜台任务

@EVENT_ABLE_5
#LOCALSIZE 3
SIF GET_EVENT_ATTAIN("柜台任务")
	RETURN 0
SIF CONVERT_DAY(1, 3, 1) > DAY
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
RETURN 1

@EVENT_REPLAY_5
SIF GET_EVENT_ATTAIN("柜台任务")
	RETURN 1
RETURN 0

@EVENT_ACT_5
#LOCALSIZE 2
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL BGM, "萝乐娜的工房.mp3"
CALL MESSAGE_WINDOW, "萝乐娜", "师傅……又跑哪里去了？/不过，也好。/就算师傅不在，我应该一个人也可以……"
CALL MESSAGE_WINDOW, "萝乐娜", "话说，今天做什么好呢？"
CALL MESSAGE_WINDOW, "", "萝乐娜边说着边用手托着脸，/这时传来咚咚的敲门声。"
STOPBGM
CALL MESSAGE_WINDOW, "萝乐娜", "啊，说曹操曹操就到了吗？/咦？可师傅应该不会敲门才对…"
CALL MESSAGE_WINDOW, "", "打开门，一个面色恐怖的男人走了进来。"
CALL MESSAGE_WINDOW, "男人", "打扰了。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶？请问， 您是哪位……/啊！　又是可怕的表情！/难难，难道，又是收债人！？/"
CALL MESSAGE_WINDOW, "萝乐娜", "不是吧！ 怎怎怎，怎么办！/呃呃……话，话说！/我本来打算今天也要努力……"
CALL MESSAGE_WINDOW, "萝乐娜", "不对，不是打算，实际上已经在努力了，/也有点不太对！ 也就是说，总之……/只求您不要卖了我……！"
CALL MESSAGE_WINDOW, "收债人？", "……先冷静下来怎么样。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，对，对不起。/冷静下来，我得冷静下来！"
CALL MESSAGE_WINDOW, "萝乐娜", "对了，这种时候得深呼吸！/吸气—，呼气—，吸气—，呼哈啊……"
CALL MESSAGE_WINDOW, "收债人？", "你没事了吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，是的。/多亏您，我感觉好些了。"
CALL BGM, "王宫的入口.mp3"
CALL MESSAGE_WINDOW, "收债人？", "好的，那么首先，我并不是客人。/今天是作为城堡的使者而来的。"
CALL MESSAGE_WINDOW, "萝乐娜", "城堡的……使者？"
CALL MESSAGE_WINDOW, "使者", "是的。/我不是收债人。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，那真是失礼了。/我看你神色可怕，还以为是……"
CALL MESSAGE_WINDOW, "使者", "………………/算了。/话说，亚斯特丽德目前不在，对吧？"
CALL MESSAGE_WINDOW, "萝乐娜", "是的。/我也不知道她去哪儿了。"
CALL MESSAGE_WINDOW, "使者", "是吗……/另外，我听说店主换人了……"
CALL MESSAGE_WINDOW, "萝乐娜", "是的，不久之前，我才开始担任这家工房的店主。"
CALL MESSAGE_WINDOW, "使者", "是你吗……/那么，我找你有事，但果然还是没法忽略亚斯特丽德啊。/等她回来后，希望你们两个能来一趟城堡。"
CALL MESSAGE_WINDOW, "萝乐娜", "呃，我和师傅一起吗？"
CALL MESSAGE_WINDOW, "使者", "是的。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，难道最终还是要逮捕师傅，/顺便我也要被抓了是吗！？"
CALL MESSAGE_WINDOW, "使者", "……不是的，没有那回事儿。/总之，不会加害你们的，/请你放心……"
CALL MESSAGE_WINDOW, "萝乐娜", "呃呃……但是，被叫去城堡什么的……"
CALL MESSAGE_WINDOW, "使者", "话说，你之前说的，收债人啊，不希望被卖啊。/之类的，到底是怎么回事儿……？"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，那些事是因为师傅她……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "啊呀，到此为止。/史特尔克，从我可爱的弟子身边离开吧。"
CALL MESSAGE_WINDOW, "", "萝乐娜正要说缘由时，/亚斯特丽德从隔壁的房间走了进来。"
CALL MESSAGE_WINDOW, "萝乐娜", "师傅。/你竟然在啊！？/话说，请你赶紧出来嘛！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "因为总觉得有点麻烦呢。"
CALL MESSAGE_WINDOW, "史特尔克", "唉……你还真是没变呢……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "话说如此，但看到可爱的弟子被人欺负，/我怎么可能袖手旁观。/因此，我就出来帮忙了，/要感谢我哦。"
CALL MESSAGE_WINDOW, "史特尔克", "你说谁欺负人了！？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "萝乐娜可是从刚才开始就一副要哭的表情哦？"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，这是因为，/史特尔克……先生？神色太过恐怖了……"
CALL MESSAGE_WINDOW, "史特尔克", "………………"
CALL MESSAGE_WINDOW, "亚斯特丽德", "萝乐娜可是背负了100万克尔的债。/没空去王宫之类的地方，/而且我也不打算去。/综上，回去。"
CALL MESSAGE_WINDOW, "史特尔克", "100万克尔的债务…？"
CALL MESSAGE_WINDOW, "萝乐娜", "那个是师傅她……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "萝乐娜的父母身患重病呢……/为了治好父母的病，萝乐娜才不得不背上债务的哦。"
CALL MESSAGE_WINDOW, "史特尔克", "竟然……有这种事……"
CALL MESSAGE_WINDOW, "萝乐娜", "不，虽然没说错……但总觉得……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "好了。萝乐娜。/你什么都不许说。"
CALL MESSAGE_WINDOW, "史特尔克", "那么，你打算怎么还钱……？"
CALL MESSAGE_WINDOW, "萝乐娜", "那件事啊，暂时还不……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "啊呀，虽然不知道能做到什么程度，/总之既然工房已经交给我，/打算用炼金术好好努力。/是不是这样啊萝乐娜？"
CALL MESSAGE_WINDOW, "萝乐娜", "诶，咦咦？/嗯，或许吧？"
CALL MESSAGE_WINDOW, "史特尔克", "……虽然总觉得怪怪的，/总之，正合我意。"
CALL MESSAGE_WINDOW, "史特尔克", "就在几天前，决定加强冒险者的支援呢。/因此，这个国家的炼金术士也要支援冒险者，/而且自身也是作为冒险者希望得到协助。/为了传达这个才来的。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "是要我协助吗……？"
CALL MESSAGE_WINDOW, "史特尔克", "……坦率地说完全没有抱任何期待。/但是，你的话，好像并非完全不想做……？"
CALL MESSAGE_WINDOW, "萝乐娜", "诶，怎么会，我吗？/我怎么可能做冒险这种事啊！？"
CALL MESSAGE_WINDOW, "史特尔克", "炼金术士的话，应该能做药剂或者有用的道具吧？/即使是这样细小的事情，也没关系。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊那样的话……可能会做……？"
CALL MESSAGE_WINDOW, "史特尔克", "如果愿意做的话，国家也会发报酬。/不过，当然达不到100万克尔……/但是根据活跃程度，有可能成为大额的资金援助。"
CALL MESSAGE_WINDOW, "萝乐娜", "这么说，也就是说我能还债了……？/那么，我，想做！"
CALL MESSAGE_WINDOW, "史特尔克", "综，综上。/你不介意吧，亚斯特丽德？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "……萝乐娜，你觉得能做的话，就按自己的意思行事。"
CALL MESSAGE_WINDOW, "萝乐娜", "……那个，那么我想试试。"
CALL MESSAGE_WINDOW, "史特尔克", "是吗。/那么，虽然很冒昧，请和我一起去城堡。"
CALL MESSAGE_WINDOW, "萝乐娜", "好的！"
CALL MESSAGE_WINDOW, "", "史特尔克带着萝乐娜离开了工房……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "嗯……/那个萝乐娜竟然没说不行，/难道她在不知不觉中变得有自信了嘛……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "啊呀这下可真是有趣。/……但是，要是和史特尔克说起奴隶或者暗之公会的话，/会变得麻烦呢。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "毕竟还没那么吓人，/等她回来了，让她不要外传，/必须得好好叮嘱她呢。"
CALL SET_EVENTFLAG, "柜台任务", "开始"
CALL SHOW_SITUATION, "王宫柜台"
CALL MESSAGE_WINDOW, "史特尔克", "那么，我有一些必须得汇报的事情。/不好意思，在这里等我一下。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，好的。/我知道了。"
CALL MESSAGE_WINDOW, "史特尔克", "告辞……"
CALL MESSAGE_WINDOW, "", "史特尔克留下萝乐娜后，向王宫深处走去……"
CALL MESSAGE_WINDOW, "萝乐娜", "………………/虽然不知怎么干劲满满地跟来了，/但是仔细一想，这可能是我第一次来到城堡。"
CALL MESSAGE_WINDOW, "萝乐娜", "呃呃，突然紧张起来了。/到这里一直都保持着恐怖的脸色。"
CALL MESSAGE_WINDOW, "？？？", "神色恐怖，是指史特尔克吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "呜啊啊！/吓，吓死我了……"
CALL MESSAGE_WINDOW, "", "萝乐娜震惊地回头一看，/发现接待处柜台的对面站在一名短发的女性。"
CALL MESSAGE_WINDOW, "女人", "不好意思，好像吓到你了呢。/有什么事情吗？/你好像是和史特尔克一起来的。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，我，来自工房，/听闻有冒险者相关的工作，/师傅虽然不做，但是说即使是我也行。"
CALL MESSAGE_WINDOW, "女人", "工房……？/啊——，我大致明白了。/也就是说，你是我的客人呢。"
CALL MESSAGE_WINDOW, "女人", "我是艾丝缇。/在城堡里担任骑士。/请多关照。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，我叫萝乐莱娜。/大家都叫我萝乐娜。/呃然后，我是一名炼金术士。"
CALL MESSAGE_WINDOW, "艾丝缇", "萝乐娜是吗。/我知道啦。"
CALL MESSAGE_WINDOW, "萝乐娜", "话说，艾丝缇小姐，竟然是骑士真厉害呢。/该怎么说呢，很帅气啊。"
CALL MESSAGE_WINDOW, "艾丝缇", "听你这么说，我很高兴，/但虽说是骑士，实际上没什么了不起的。/你瞧，一言以蔽之，我只是接待处的大姐姐而已。"
CALL MESSAGE_WINDOW, "艾丝缇", "我反而觉得在这个年纪就是炼金术士的萝乐娜更厉害呢？"
CALL MESSAGE_WINDOW, "萝乐娜", "不，不，我才是没什么了不起的呢。/总是失败，还好霍姆妹妹一直帮忙，才勉强做成……"
CALL MESSAGE_WINDOW, "", "在萝乐娜和艾丝缇谈话的期间，/史特尔克回来了……"
CALL MESSAGE_WINDOW, "史特尔克", "不好意思。/久等了。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，完全，没有那回事呢。/请别介意。"
CALL MESSAGE_WINDOW, "艾丝缇", "等一下，史特尔克，都怪你神色恐怖，/萝乐娜可是害怕得发抖呢？"
CALL MESSAGE_WINDOW, "史特尔克", "所以说我到底哪里恐怖了……"
CALL MESSAGE_WINDOW, "艾丝缇", "就是这幅神色，哦。/对女孩子得温柔点才行哦。"
CALL MESSAGE_WINDOW, "史特尔克", "……。"
CALL MESSAGE_WINDOW, "萝乐娜", "(呃，总感觉有人在瞪我……/果，果然很恐怖……)"
CALL MESSAGE_WINDOW, "艾丝缇", "不过，史特尔克一直是这种表情，/但并非是生气之类的，/请别介意。"
CALL MESSAGE_WINDOW, "萝乐娜", "好，好的……"
CALL MESSAGE_WINDOW, "史特尔克", "神色可怕之类的，这副表情之类的……/虽然不会生气……"
CALL MESSAGE_WINDOW, "史特尔克", "不过算了。/暂且，你已经正式认证成为冒险者了。/详细的事情你可以询问艾丝缇前辈。"
CALL MESSAGE_WINDOW, "萝乐娜", "好的！/谢谢。/……那个，你是史特尔克……对吧？"
CALL MESSAGE_WINDOW, "史特尔克", "说起来，我还没报上姓名。/我的名字是史特尔肯布鲁克。/以骑士的身份在城堡里工作。"
CALL MESSAGE_WINDOW, "萝乐娜", "史特尔肯……布鲁克……？/史特尔……史特尔肯……"
CALL MESSAGE_WINDOW, "史特尔克", "太长了叫起来很困难吧。/所以可以叫我……"
CALL MESSAGE_WINDOW, "萝乐娜", "史克！/我决定叫你史克！"
CALL MESSAGE_WINDOW, "史特尔克", "……史特尔克，请这样叫我。拜托了。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶——，不可以吗？/史克，这个称呼明明挺可爱的……"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，我叫萝乐娜。/请多指教。"
CALL MESSAGE_WINDOW, "史特尔克", "我才是，请多指导。/那么赶快进入正题，艾丝缇前辈……"
CALL MESSAGE_WINDOW, "艾丝缇", "是呢。/那么拜托萝乐娜做采购和调合的工作吧。"
CALL MESSAGE_WINDOW, "艾丝缇", "会在下次来之前准备好的，/想接受委托的话，记得来我这啊。"
CALL MESSAGE_WINDOW, "萝乐娜", "好的，那么拜托你了！"
CALL MESSAGE_WINDOW, "艾丝缇", "呵呵，我才是请多关照呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "也谢谢史特尔克。"
CALL MESSAGE_WINDOW, "史特尔克", "不，我只是做了本职工作而已。/不值得你的道谢。"
CALL MESSAGE_WINDOW, "艾丝缇", "真是的，这个时候不是应该说小菜一碟之类的，/为了你我什么都能做之类的嘛。"
CALL MESSAGE_WINDOW, "史特尔克", "为什么要那么说呢……"
CALL MESSAGE_WINDOW, "艾丝缇", "对女孩子要温柔哦。/不然，又要被说神色恐怖了哦？"
CALL MESSAGE_WINDOW, "史特尔克", "……额嗯"
CALL MESSAGE_WINDOW, "萝乐娜", "没，没事的！/虽然确实神色恐怖，/但我也会努力习惯的！"
CALL MESSAGE_WINDOW, "史特尔克", "必须努力嘛……/算了……不管怎样，我也会在力所能及的范围内帮忙的。/如果有什么困难，随时可以找我商量。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶，这，不好吧。"
CALL MESSAGE_WINDOW, "史特尔克", "这也是骑士的工作。/不必介意。"
CALL MESSAGE_WINDOW, "萝乐娜", "明白了。/那么，如果有事的话，就拜托你了。"

SIF FLAG:回想模式
	RETURN 0

CALL MESSAGE_WINDOW, "", "从游戏的主菜单中可以选择[61] 王宫了。/可以接受和汇报柜台任务。"

CFLAG:GET_CNUM("艾丝缇"):认识 = 1
CFLAG:GET_CNUM("史特尔克"):认识 = 1

CALL SHOW_HELP, "柜台任务"
CALL SET_EVENTFLAG, "柜台任务", "达成"

CALL MAKE_REQ_TABLE
CALL MAKE_REQ_MAIN

@EVENT_NOTE_5
RESULTS = 史特尔克来到了工房。/他一副非常恐怖的表情，虽然让人害怕，/但是托他的福，可以在王宫接受任务了。/还认识了艾丝缇，/接下来会努力工作！/还有也想努力习惯史特尔克的可怕表情。
@EVENT_HEADER_5
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE