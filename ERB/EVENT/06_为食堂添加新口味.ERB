@EVENT_NAME_6
RESULTS = 为食堂添加新口味

; 原本这个事件链是绑定商店升级系统的，但这个系统因为我没时间做所以砍掉了。
@EVENT_ABLE_6
#LOCALSIZE 3
#DIM 大师蛋糕塔候选数
#DIM 幸福的饼干候选数
SIF FLAG:SHOP指令 != GET_NO("SHOP", "日出食堂")
	RETURN 0

SELECTCASE GET_EVENT_STATE("为食堂添加新口味")
	CASE ""
		RETURN 1
	CASE "1"
		SIF HAVE_ITEM("不知名的蛋") > 1
			RETURN 1
	CASE "2"
		SIF HAVE_ITEM("三色莓果") > 2
			RETURN 1
	CASE "3"
		CALL GET_FILTER_ITEM_COUNT, "EVENT_6_3_REQ", "持有"
		大师蛋糕塔候选数 = RESULT
		SIF 大师蛋糕塔候选数 > 0
			RETURN 1
	CASE "4"
		CALL GET_FILTER_ITEM_COUNT, "EVENT_6_4_REQ", "持有"
		幸福的饼干候选数 = RESULT
		SIF 幸福的饼干候选数 > 0
			RETURN 1
ENDSELECT

RETURN 0

@EVENT_REPLAY_6
SIF GET_EVENT_STATE("为食堂添加新口味") == ""
	RETURN 0
RETURN TOINT(GET_EVENT_STATE("为食堂添加新口味"))

@EVENT_ACT_6
