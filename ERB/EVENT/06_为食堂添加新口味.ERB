@EVENT_NAME_6
RESULTS = 为食堂添加新口味

@EVENT_ABLE_6
#LOCALSIZE 3
SIF FLAG:SHOP指令 != GET_NO("SHOP", "日出食堂")
	RETURN 0
RETURN 1

@EVENT_ACT_6
#LOCALSIZE 2
IF GET_EVENT_STATE("为食堂添加新口味") == ""
	FLAG:事件内的分歧 = 0
	CALL SHOW_SITUATION, "日出食堂"
	CALL BGM, "给你特别菜单.mp3"

	CALL MESSAGE_WINDOW, "萝乐娜", "伊克赛，你好……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "欢迎光临……什么嘛，是萝乐娜啊。/嗯？你怎么啦？一脸闷闷不乐的。"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯……发生了很多事……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "干嘛啊，别卖关子了……/总之就慢慢说给我听吧。/要喝香茶吗？"
	CALL MESSAGE_WINDOW, "萝乐娜", "啊，好……其实我……"
	CALL MESSAGE_WINDOW, "", "………………/…………/……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "什么！你成了炼金工房的老板！？"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯……好像就是这么一回事……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "可恶，我现在还被当成学徒看待呢……/萝乐娜居然先变成了老板！"
	CALL MESSAGE_WINDOW, "萝乐娜", "才没有呢，伊克赛明明就比较厉害。/虽说是学徒，/但店里大大小小的事你都有能力处理。"
	CALL MESSAGE_WINDOW, "萝乐娜", "不像我……真的什么也做不好啊……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "是，是吗？嘿嘿，我也没那么厉害啦！"
	CALL MESSAGE_WINDOW, "伊克赛尔", "不过呢，垂头丧气的也不会遇上什么好事。/你振作点啦。"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯，谢谢你。/总觉得看着伊克赛的样子，就有精神了。"
	CALL MESSAGE_WINDOW, "萝乐娜", "好！我也要好好加油！"
	CALL MESSAGE_WINDOW, "伊克赛尔", "就是这样就是这样。啊，回去之前，/记得付香茶的钱，150克尔。"
	CALL MESSAGE_WINDOW, "萝乐娜", "咦，咦咦咦？/这杯茶不是泡来招待我的吗？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "开玩笑的，别什么事都当真啦。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "反正啊，要是有烦恼，欢迎随时来找我。/只要能帮上忙，我都会协助你的。"
	CALL MESSAGE_WINDOW, "萝乐娜", "伊克赛……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "哎，对了。我听客人说，/你最近常在城镇外游荡是吗？"
	CALL MESSAGE_WINDOW, "萝乐娜", "说是游荡……也没错啦。/我只是去采集炼金术要用的一些材料。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "真好啊，所谓的好食材，/就得靠自己的眼睛和双脚去找才行。/可惜我分身乏术，没法去太远的地方采集。"
	CALL MESSAGE_WINDOW, "萝乐娜", "是采集炼金术材料，不是食材啦……"
	CALL MESSAGE_WINDOW, "萝乐娜", "这样好了，我下次去采集的时候也帮你带点食材回来吧。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "真的可以吗！哇！/这样一来食堂的菜色就会增加，/我和客人都会很高兴的！"
	CALL MESSAGE_WINDOW, "伊克赛尔", "可以先帮我采集2个不知名的蛋吗？/我一定会给你超丰厚的报酬的！"

	CALL SET_EVENTFLAG, "为食堂添加新口味", "开始"
	CALL SET_EVENTFLAG, "为食堂添加新口味", "状态", "1"

ELSEIF GET_EVENT_STATE("为食堂添加新口味") == "1" && HAVE_ITEM("不知名的蛋") > 1
	CALL MESSAGE_WINDOW, "萝乐娜", "对了，我还得把不知名的蛋交给伊克赛呢…/那个……"
	CALL MESSAGE_WINDOW, "", "请选择要提交的物品"
	LOCAL = LINECOUNT
	CALL SHOW_ITEMLIST, "选择物品", "持有", 2, "EVENT_6_1_REQ"
	CLEARLINE LINECOUNT - LOCAL
	IF !RESULT
		CALL MESSAGE_WINDOW, "萝乐娜", "嗯……这次还是算了吧。"
		RETURN 0
	ENDIF

	FLAG:事件内的分歧 = 1
	CALL SHOW_SITUATION, "日出食堂"
	CALL BGM, "给你特别菜单.mp3"
	CALL DEL_CHOICE_ITEM

	CALL MESSAGE_WINDOW, "萝乐娜", "伊克赛，来拿好，这是你要的蛋哦。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "我看看哦……好像才刚生出来呢。/好，我就收下了！"
	CALL MESSAGE_WINDOW, "萝乐娜", "这是什么蛋啊？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "嗯～是不知名的蛋吧。"
	CALL MESSAGE_WINDOW, "萝乐娜", "等等，我在问你这是什么蛋呢？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "都说了这是不知名的蛋了啊。"
	CALL MESSAGE_WINDOW, "萝乐娜", "不是啦，我是要问……/怎么说呢，这个能吃吗？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "应该能吃吧，毕竟是蛋。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "下次的午餐菜单就决定是特大蛋包饭了！/你要来吃吗？"
	CALL MESSAGE_WINDOW, "萝乐娜", "……算了，我就不吃了。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "哎，真的不吃吗，我可以请客哦？/算了，先给你报酬吧！"
	MONEY += 300
	CALL SOLO, "试试看吧.mp3"
	CALL MESSAGE_WINDOW, "", "获得了300克尔"
	CALL MESSAGE_WINDOW, "萝乐娜", "咦，这蛋真的值这么多钱吗？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "这种事不重要啦，/重要的是终于能做新菜色了，/客人一定都会很高兴的！"
	CALL MESSAGE_WINDOW, "伊克赛尔", "对啦，/下次能不能帮我采集3个三色莓果来呢？"
	CALL MESSAGE_WINDOW, "萝乐娜", "3个三色莓果吗？好，我记住了。"

	CALL 关系加深, "伊克赛尔", 200
	CALL SET_EVENTFLAG, "为食堂添加新口味", "状态", "2"
	CALL SET_STORE, GET_NO("商店", "日出食堂")
	CALL MESSAGE_WINDOW, "", "下周起可以在食堂购买不知名的蛋了。"

ELSEIF GET_EVENT_STATE("为食堂添加新口味") == "2" && HAVE_ITEM("三色莓果") > 2
	CALL MESSAGE_WINDOW, "萝乐娜", "对了，我还得把三色莓果交给伊克赛呢…/那个……"
	CALL MESSAGE_WINDOW, "", "请选择要提交的物品"
	LOCAL = LINECOUNT
	CALL SHOW_ITEMLIST, "选择物品", "持有", 3, "EVENT_6_2_REQ"
	CLEARLINE LINECOUNT - LOCAL
	IF !RESULT
		CALL MESSAGE_WINDOW, "萝乐娜", "嗯……这次还是算了吧。"
		RETURN 0
	ENDIF

	FLAG:事件内的分歧 = 2
	CALL SHOW_SITUATION, "日出食堂"
	CALL BGM, "给你特别菜单.mp3"
	CALL DEL_CHOICE_ITEM

	CALL MESSAGE_WINDOW, "萝乐娜", "伊克赛，来拿好，这是你要的三色莓果哦。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "啊，我看看。/分成了三种颜色，的确是三色莓果呢。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "这个很稀有呢，/虽说其他地方也能采集到类似的水果，/但只有在奥尔托加遗迹附近的森林才能采集到三色莓果。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "来，你尝尝看，啊——"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯？这个不是你要用来做菜的吗？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "吃一点又没什么，我们厨师本来也需要试菜的，快试试看吧！"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯，我开动了……哇，好甜～"
	CALL MESSAGE_WINDOW, "伊克赛尔", "颜色不同，味道也有所不同。/红色的比较酸，紫色的有点苦。"
	CALL MESSAGE_WINDOW, "萝乐娜", "这样啊～好棒哦。可是，/为什么只有那片森林才能采集到呢？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "我也是听说的。/那片森林离遗迹非常近对吧？"
	CALL MESSAGE_WINDOW, "萝乐娜", "和遗迹又什么关系吗？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "说到那座遗迹，/连我们这些住在附近的居民都不太清楚/那是什么样的遗迹嘛。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "不过根据传闻，/那座遗迹好像流出了很多未知的魔力。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "可能就是因为这样，/莓果才会变成这种颜色吧。"
	CALL MESSAGE_WINDOW, "萝乐娜", "唔咕！咳！咳！/这，这种东西吃了不会怎么样吗？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "放心，我还没听过有人/因为吃三色莓果而死掉的。"
	CALL MESSAGE_WINDOW, "萝乐娜", "……突然感觉头有点晕，/希望是我多心了……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "……该怎么说呢，/有时候觉得你太过单纯，/有时候又觉得你太过被害妄想……"
	CALL MESSAGE_WINDOW, "伊克赛尔", "总之，这是这次的报酬。"
	MONEY += 600
	CALL SOLO, "试试看吧.mp3"
	CALL MESSAGE_WINDOW, "", "获得了600克尔"
	CALL MESSAGE_WINDOW, "萝乐娜", "哇！这么多钱！/难道说，当厨师学徒其实很赚钱吗？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "…………"
	CALL MESSAGE_WINDOW, "萝乐娜", "咦？伊克赛你怎么了？"
	CALL MESSAGE_WINDOW, "伊克赛尔", "……没事，我只是在想要怎么料理这三色莓果。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "我一直想增加店里的甜品种类，但一直想不到好点子……。"
	CALL MESSAGE_WINDOW, "萝乐娜", "甜品吗……对了，/我之前看的书，好像有介绍几道甜品。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "真的吗？是什么样的甜品？/材料呢？/做法咧？"
	CALL MESSAGE_WINDOW, "萝乐娜", "你，你一次问这么多问题，我哪答得上来。/而且我之前也没有看得很仔细。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "是哦，那你下次做好带过来吧。我会给你更多报酬的！"
	CALL MESSAGE_WINDOW, "萝乐娜", "啊，嗯。这样的话……/在那之前我得先好好练习，学会怎么制作才行。"
	CALL MESSAGE_WINDOW, "伊克赛尔", "如果成品不错的话，我就直接放在店里卖。/那就交给你啦！"

	CALL 关系加深, "伊克赛尔", 300
	CALL SET_EVENTFLAG, "为食堂添加新口味", "状态", "3"
	CALL SET_STORE, GET_NO("商店", "日出食堂")
	CALL MESSAGE_WINDOW, "", "下周起可以在食堂购买三色莓果了。"

ELSEIF GET_EVENT_STATE("为食堂添加新口味") == "3" && HAVE_ITEM("大师蛋糕塔") > 0
	; TODO
ELSEIF GET_EVENT_STATE("为食堂添加新口味") == "4" && HAVE_ITEM("幸福的饼干") > 0
	; TODO
ENDIF

; CALL SET_EVENTFLAG, "为食堂添加新口味", "达成"

CALLFORM SHOPCOM_{FLAG:SHOP指令}

RETURN 1

@EVENT_NOTE_6
SELECTCASE GET_EVENT_STATE("为食堂添加新口味")
	CASE "1"
		RESULTS = 要帮伊克赛采集2个不知名的蛋……/不知名的蛋到底是什么蛋……
	CASE "2"
		RESULTS = 要帮伊克赛采集3个三色莓果，/我记得小时候和小库去遗迹玩的路上有看到过。
	CASE "3"
		RESULTS = 伊克赛想要给食堂添加更多新甜品。/我记得之前在书上看到过一种蛋糕塔……
	CASE "4"
		RESULTS = 伊克赛想要给食堂添加更多新甜品。/我记得之前在书上看到过一种幸运饼干……
	CASE "食堂升级"
		RESULTS = 食堂已升级
ENDSELECT


@EVENT_HEADER_6
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-日出食堂-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE

@EVENT_6_1_REQ, ARG
SIF GET_ITEMNAME(ARG) != "不知名的蛋"
	RETURN 0
RETURN 1

@EVENT_6_2_REQ, ARG
SIF GET_ITEMNAME(ARG) != "三色莓果"
	RETURN 0
RETURN 1

@EVENT_6_3_REQ, ARG
SIF GET_ITEMNAME(ARG) != "大师蛋糕塔"
	RETURN 0
RETURN 1

@EVENT_6_4_REQ, ARG
SIF GET_ITEMNAME(ARG) != "幸福的饼干"
	RETURN 0
RETURN 1