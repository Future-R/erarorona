;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_10
#LOCALSIZE 3
SIF GET_EVENT_ATTAIN("練習のお誘い")
	RETURN 0
SIF FLAG:ショップコマンド == GET_NO("ショップ", "探索")
	RETURN 0
SIF FLAG:現地点 != GET_NO("場所", "アーランド")
	RETURN 0
;ランク1以上か6月1日以降
IF FLAG:ギルドランク > 0
	RETURN 1
ELSE
	;1年目6月1日以降に発生
	SIF CONVERT_DAY(1, 6, 1) > DAY
		RETURN 0
	RETURN 1
ENDIF

