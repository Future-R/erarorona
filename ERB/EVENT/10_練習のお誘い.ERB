@EVENT_NAME_10
RESULTS = 邀请练习

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_10
#LOCALSIZE 3
SIF GET_EVENT_ATTAIN("邀请练习")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
;ランク1以上か6月1日以降
IF FLAG:公会等阶 > 0
	RETURN 1
ELSE
	;1年目6月1日以降に発生
	SIF CONVERT_DAY(1, 6, 1) > DAY
		RETURN 0
	RETURN 1
ENDIF

@EVENT_ACT_10
#LOCALSIZE 2
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL MESSAGE_WINDOW, "亚斯特丽德", "话说，萝乐娜哟。"
CALL MESSAGE_WINDOW, "萝乐娜", "有什么事吗，师傅？"
IF FLAG:公会等阶 > 0
	CALL MESSAGE_WINDOW, "亚斯特丽德", "看来你已经大致习惯调教了呢。/已经不能说在那方面的手法是外行了。"
	CALL MESSAGE_WINDOW, "萝乐娜", "你，你在说什么呀！/啊，话说难道你又在偷看了吗！？"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "这个嘛，看到可爱的弟子出糗，/既是作为师傅的最大的乐趣，也是最大的义务啊。"
	CALL MESSAGE_WINDOW, "萝乐娜", "真的请您别这样了啊……/光这样已经够羞耻的了……唔……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "嗯，即使到了这个地步你仍保留着害羞。/不愧是我看好的人。"
	CALL MESSAGE_WINDOW, "萝乐娜", "这……不是在夸我吧？"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "不不，这可是重要的事哦。/虽然看到最终完全堕落的样子也是乐趣，/但果然充满挑战的过程才是最精彩的部分呢……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "不过，先不提这个。/你可是犯了一个大错哦。/这样下去，作为调教师大概不会顺利吧。"
	CALL MESSAGE_WINDOW, "萝乐娜", "完全堕落……唔……"
ELSE
	CALL MESSAGE_WINDOW, "亚斯特丽德", "看来调教的进展不太顺利嘛。"
	CALL MESSAGE_WINDOW, "萝乐娜", "这不是没办法嘛……/怎么可能顺利……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "不过，毕竟没什么经验呢。/但正是这一点，看起来才有趣。"
	CALL MESSAGE_WINDOW, "萝乐娜", "你，你在说什么呀！/啊，话说难道你又在偷看了吗！？"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "这个嘛，看到可爱的弟子出糗，/既是作为师傅的最大的乐趣，也是最大的义务啊。"
	CALL MESSAGE_WINDOW, "萝乐娜", "真的请您别这样了啊……/光这样已经够羞耻的了……唔……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "不过，总之。/你犯了一个关键性的错误。/所以，才做不好。"
ENDIF
CALL MESSAGE_WINDOW, "萝乐娜", "诶诶！？/那，那是什么错误！？/到底哪里不行呢！？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "那就是……"
CALL MESSAGE_WINDOW, "萝乐娜", "那就是……？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "特意打开了通往性的世界的大门，/竟然没主动说想和我做，/这可是严重的错误。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "我为了让你踏上那眼花缭乱的极乐世界，/明明每天都在等着你来拜托我……/因此萝乐娜，我们赶快去床上吧……"
CALL MESSAGE_WINDOW, "萝乐娜", "我，我不要啊！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "你说什么……/萝乐娜，没想到你竟然那么讨厌我……"
CALL MESSAGE_WINDOW, "萝乐娜", "不不，并不是讨厌。/该说是和师傅发展成那种关系有点难以想象，/还是该说奇怪呢。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "是吗？/明明已经在做那种事了，/不应该事到如今才介意起来吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "对方说了没问题，/而且我也得好好工作，/或者说这本来就是工作……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "嗯，工作的话就可以吗？/那么没问题。/把和我一起的也当作工作就好了。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶……？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "性技术果然只能通过实战经验来提升呢。/确实霍姆克鲁斯的调教也很好，/但是能得到的经验是远远比不上真人的。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "以后进行调教，/必须也和人类建立关系，/好好地积累经验才行。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶诶诶诶！？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "没什么，把这当作工作我也没关系哦。/而且我很重视自由呢。/不仅仅和我，你要和各种各样的人练习，我也不会阻拦哦。"
CALL MESSAGE_WINDOW, "萝乐娜", "各种各样……？/什么是各种各样……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "只要和谁关系变好了，对方肯定会乐意奉陪。/不断积累经验的话，即使关系不好，/诱惑这种事不过小菜一碟。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "还有就是。/霍姆他们是我制造出来的东西，/最重要的是他们积累了各种各样的经验呢。/作为练习对象应该是十分合适的。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "那个，你们。/这是为了萝乐娜。/你们愿意做吗？"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "愿意，如果这是师傅和师祖所希望的。"
CALL MESSAGE_WINDOW, "萝乐娜", "……唔，总感觉事情好像变得奇怪起来。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "因此，这个就给你吧。"
CALL MESSAGE_WINDOW, "", "从亚斯特丽德那里得到了【性技巧大全】。"
CALL MESSAGE_WINDOW, "萝乐娜", "这是什么？/……等等，这到底是什么！？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "如你所见，是关于性技巧的解说书。/要成为出色的调教师，各种技巧是必不可少的呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "各种技巧……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "好好积累经验的话，就能理解这本书里的技巧。/这样的话，就能做出更厉害的调教了。/来吧，是不是已经想快点积累经验了呢？"
IF FLAG:公会等阶 > 0
	CALL MESSAGE_WINDOW, "亚斯特丽德", "算了，我不会强迫你。/你觉得需要的话，来找我就行。/应该说肯定需要，所以别介意，尽管来找我。"
ELSE
	CALL MESSAGE_WINDOW, "亚斯特丽德", "不过，我不会强迫你……/你明白这样下去会很危险吧？/还是老老实实把自己交给我这个大姐姐比较好哦。"
ENDIF
CALL MESSAGE_WINDOW, "萝乐娜", "……额。/总之，请让我考虑一下。"
CALL MESSAGE_WINDOW, "", "可以向亚斯特丽德和霍姆妹妹和霍姆弟弟求欢了。/通过主菜单发起邀约。"
CALL MESSAGE_WINDOW, "", "获得了《性技巧大全》，在调教结束后，满足一定条件时，/可以习得新的调教指令。/另外，可以在图鉴中查看调教指令的说明和习得条件。"

CALL SET_EVENTFLAG, "邀请练习", "达成"

@EVENT_NOTE_10
RESULTS = 师傅竟然提出了一个不得了的邀约。/虽说这是工作，但和师傅、霍姆妹妹他们发展成那种关系的话……/倒不如说，把这当成工作这件事本身就奇怪……/但是，要积累经验，必须得掌握各种性技巧……

