@EVENT_NAME_12
RESULTS = 友人任务

@EVENT_ABLE_12
#LOCALSIZE 3
SIF FLAG:公会等阶 < 1
	RETURN 0
SIF GET_NO("SHOP", "王宫") != FLAG:SHOP指令
	RETURN 0
SIF FLAG:累计报酬额 < 2500
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
RETURN 1

@EVENT_REPLAY_12
SIF GET_EVENT_ATTAIN("友人任务")
	RETURN 1
RETURN 0


@EVENT_ACT_12
#LOCALSIZE 2
CALL SHOW_SITUATION, "王宫柜台"
CALL BGM, "王宫的入口.mp3"
CALL MESSAGE_WINDOW, "萝乐娜", "哈啊……"
CALL MESSAGE_WINDOW, "艾丝缇", "啊呀，进入疲劳模式了？/怎么还叹气呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "没有，我不累，只是……"
CALL MESSAGE_WINDOW, "萝乐娜", "我这样工作，/真的能让大家满足吗？/有些不安。"
CALL MESSAGE_WINDOW, "艾丝缇", "嗯，确实。/你工作也有好好在完成，/当然，也许还不能说非常完美，但是……"
CALL MESSAGE_WINDOW, "艾丝缇", "不过，没问题的。/只要认真做事，会有人看到的。/别着急，一开始就必须做得完美什么的，没必要这么想哦。"
CALL MESSAGE_WINDOW, "史特尔克", "现在就这么沮丧，感觉前途一片暗淡啊。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，史特尔克……/呜呜，真是对不起……"
CALL MESSAGE_WINDOW, "艾丝缇", "史特尔克，你好像自己没意识到，/因此特别讲给你听，/你就是因为讲话姿态太高，周围的人才觉得你恐怖的哦？"
CALL MESSAGE_WINDOW, "史特尔克", "唔……我会好好反省。/对了，今天我有件事想请你帮忙。"
CALL MESSAGE_WINDOW, "萝乐娜", "是说我吗？/诶？诶？/请问……为什么是找我呢？"
CALL MESSAGE_WINDOW, "史特尔克", "我也是这个城镇的居民。/应该也有委托你办事的权利吧"
CALL MESSAGE_WINDOW, "史特尔克", "当然，你也有权拒绝。/你不愿意的话，我也不会强迫你……"
CALL MESSAGE_WINDOW, "萝乐娜", "不，我愿意！/请让我做这份委托！"
CALL MESSAGE_WINDOW, "史特尔克", "是吗。/那么，拜托你了前辈。"
CALL MESSAGE_WINDOW, "萝乐娜", "好的！/诶，前辈……？"
CALL MESSAGE_WINDOW, "艾丝缇", "我也负责登记任务哦。/那我就把史特尔克的委托登记成任务吧。"
CALL MESSAGE_WINDOW, "史特尔克", "因此，委托从艾丝缇前辈那里承接。/当然，如果手上还有其他委托，可以不用逞强……/从你的工作表现来看，应该没问题吧。/那么拜托了。"
CALL MESSAGE_WINDOW, "", "史特尔克离开了。"
CALL MESSAGE_WINDOW, "萝乐娜", "那个，史特尔克是不是……/其实人挺好的呢？"
CALL MESSAGE_WINDOW, "艾丝缇", "是啊－－。/因为性格的原因，/经常被误解呢。/只要习惯了，其实他还挺可爱的。"
CALL MESSAGE_WINDOW, "萝乐娜", "可爱，是吗。"
CALL MESSAGE_WINDOW, "艾丝缇", "不过，先不说这个……/像这样，萝乐娜的熟人发布委托的事还挺常见的呢。/下次遇到这种情况，我会提前帮你登记在委托信息上哦。"
CALL MESSAGE_WINDOW, "", "可以承接来自个人的委托，以及友人任务了。/完成委托后，可以提升和委托人之间的交友值。"
SIF FLAG:回想模式
	RETURN 0
CALL SET_EVENTFLAG, "友人任务", "达成"
;依頼作成
; CALL SET_REQ, 0, "ID", GET_NO("物品", "治愈软膏")
; CALL SET_REQ, 0, "数量", 2
; CALL SET_REQ, 0, "报酬", 600
; CALL SET_REQ, 0, "失效日", DAY + 10000
; CALL SET_REQ, 0, "委托方", GET_NO("角色", "史特尔克")
CALL ADD_REQ, "黑色香茶", 2, 700, DAY + 10000, "史特尔克"
RETURN 0
@EVENT_NOTE_12
RESULTS = 史特尔克委托了一件事。/不过，通过艾丝缇变成了任务的形式，/史特尔克虽然很吓人，但好像是个温柔的人。/而且，好像其实还挺可爱的？

