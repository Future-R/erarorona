	CALL MESSAGE_WINDOW, "萝乐娜", "唉……"
	CALL MESSAGE_WINDOW, "霍姆", "主人一直在叹气。"
	CALL MESSAGE_WINDOW, "萝乐娜", "咦？/我，我有吗？"
	CALL MESSAGE_WINDOW, "霍姆", "从早上开始算来，刚刚那是第29次了。"
	CALL MESSAGE_WINDOW, "萝乐娜", "不会吧，有那么多次！？/为什么你要数我叹了几次气呢？"
	CALL MESSAGE_WINDOW, "霍姆", "那是大主人的命令。"
	CALL MESSAGE_WINDOW, "萝乐娜", "师傅！/请别命令霍姆做些奇怪的事！"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "霍姆，你太早告诉她了。/照她那种步调，要达成一天叹气一百次也完全不是梦啊。"
	CALL MESSAGE_WINDOW, "萝乐娜", "真是的，我今天没心情陪师傅开玩笑！"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "听你那口气，好像你平常都会陪我开玩笑似的。"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "我是不知道你怎么了。/不过要是觉得寂寞的话，随时都可以扑向我怀里哦～"
	CALL MESSAGE_WINDOW, "萝乐娜", "都说没心情陪师傅开玩笑了……/请别管我！……唉。"
	CALL MESSAGE_WINDOW, "霍姆", "主人，这是第30次了。"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "看来病入膏肓啊。/虽然这样也挺有趣的啦，不过这下该怎么处理呢……"

	SIF FLAG:回想模式
		RETURN 1

	CALL SET_EVENTFLAG, "和小库吵架了", "状态追加", "听了师傅的话"
	RETURN 1
ENDIF

$第3节
	FLAG:事件内的分歧 = 0
	CALL SHOW_SITUATION, "王宫柜台"
	CALL BGM, "有困难就来找我吧.mp3"
	CALL MESSAGE_WINDOW, "艾丝缇", "萝乐娜，听说你跟库蝶莉娅吵架了是吗？"
	CALL MESSAGE_WINDOW, "萝乐娜", "啊……是的……"
	CALL MESSAGE_WINDOW, "艾丝缇", "呜，好阴沉哦……/对不起。/果然是我害的。"
	CALL MESSAGE_WINDOW, "萝乐娜", "没那回事。/是我说得太过分了，才会害小库生气……"
	CALL MESSAGE_WINDOW, "艾丝缇", "是吗……"
	CALL MESSAGE_WINDOW, "萝乐娜", "………………"
	CALL MESSAGE_WINDOW, "艾丝缇", "………………"
	CALL MESSAGE_WINDOW, "艾丝缇", "（呜……好沉重……/原本是出于好意才告诉她真相的，结果却搞砸了……）"
	CALL MESSAGE_WINDOW, "艾丝缇", "总，总之你先打起精神来。/我也会尽全力帮忙，让你们尽快和好的，好吗？"
	CALL MESSAGE_WINDOW, "萝乐娜", "好的……谢谢你。"
	CALL MESSAGE_WINDOW, "艾丝缇", "嗯～听到她道谢，罪恶感反而更重了……"
	CALL MESSAGE_WINDOW, "艾丝缇", "这下伤脑筋了。/要是随便插嘴，反而会让状况恶化……/该怎么处理呢……"

	SIF FLAG:回想模式
		RETURN 1

	CALL SET_EVENTFLAG, "和小库吵架了", "状态追加", "和艾丝缇谈过"
	RETURN 1

@EVENT_NOTE_18

