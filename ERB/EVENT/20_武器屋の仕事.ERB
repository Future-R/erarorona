@EVENT_NAME_20
RESULTS = 武器店的工作

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_20
#LOCALSIZE 3
SIF FLAG:公会等阶 < 2
	RETURN 0
IF GET_EVENT_PLAY("武器店的工作")
	SIF GET_NO("商店", "男子汉武器店") != FLAG:商店指令
		RETURN 0
ELSE
	SIF GET_MIXLV(MASTER) < 10
		RETURN 0
	SIF GET_NO("商店", "王宮") != FLAG:商店指令
		RETURN 0
	SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
		RETURN 0
	SIF FLAG:商店指令 == GET_NO("商店", "探索")
		RETURN 0
ENDIF
RETURN 1

@EVENT_ACT_20
#LOCALSIZE 2
IF GET_EVENT_PLAY("武器店的工作")
	FLAG:事件内的分歧 = 1
	IF !HAVE_ITEM("錬金炭")
		CALL MESSAGE_WINDOW, "萝乐娜", "そういえばおやじさんに錬金炭を頼まれてたんだった…/早く用意したほうがいいよね…たぶん…"
		RETURN 0
	ELSE
		CALL MESSAGE_WINDOW, "萝乐娜", "そういえばおやじさんに錬金炭を頼まれてたんだった/ええと……"
		CALL MESSAGE_WINDOW, "", "納品する錬金炭を選んでください"
		LOCAL = LINECOUNT
		CALL SHOW_ITEMLIST, "选择物品", "所持", 1, "EVENT_20_REQ"
		CLEARLINE LINECOUNT - LOCAL
		IF !RESULT
			CALL MESSAGE_WINDOW, "萝乐娜", "嗯……这次还是算了吧。"
			RETURN 0
		ENDIF
	ENDIF
	CALL DEL_CHOICE_ITEM
	FLAG:事件内的分歧 = 2
	CALL SHOW_SITUATION, "男子汉武器店"
	CALL MESSAGE_WINDOW, "萝乐娜", "おやじさーん。/錬金炭持って来ましたよー"
	CALL MESSAGE_WINDOW, "谢顶尔", "おう…どれどれ"
	CALL MESSAGE_WINDOW, "", "ハゲルに錬金炭を手渡した。"
	CALL MESSAGE_WINDOW, "谢顶尔", "これがか錬金炭か……"
	CALL MESSAGE_WINDOW, "萝乐娜", "あのう…。/うまくできているかはわかりませんが…"
	CALL MESSAGE_WINDOW, "谢顶尔", "いやいや、よくできてると思うぜ。/俺もこの道は長いからな/いいか悪いかは見れば大体わかる。"
	CALL MESSAGE_WINDOW, "萝乐娜", "そうですか？/よかったー。"
	CALL MESSAGE_WINDOW, "谢顶尔", "いやぁ、あの嬢ちゃんがアトリエの切り盛りをして/しかも最近じゃ冒険者として依頼を受けてるだなんて聞いて/びっくりしたがこれなら納得だな"
	CALL MESSAGE_WINDOW, "萝乐娜", "へへ、そうですか……/って、んん？/あの……？"
	CALL MESSAGE_WINDOW, "谢顶尔", "まぁまぁ、気にすんな。/それより报酬を渡すぜ"
	CALL MESSAGE_WINDOW, "", "1000コールと【鍛冶の基本】を渡された。"
	CALL MESSAGE_WINDOW, "萝乐娜", "ありがとうございます。/ってこの本は？"
	CALL MESSAGE_WINDOW, "谢顶尔", "ああ、最近ちょっと手に入れてな。/要するに錬金術と鍛冶について書かれた本だ。/要するに2つを組み合わせると/不思議な力を持った武器や防具を作れるってんだな"
	CALL MESSAGE_WINDOW, "萝乐娜", "へー……錬金術と鍛冶を……/なんだか面白そうですね"
	CALL MESSAGE_WINDOW, "谢顶尔", "嬢ちゃんも興味を持ってくれたんなら/話がはやいぜ"
	CALL MESSAGE_WINDOW, "萝乐娜", "話？"
	CALL MESSAGE_WINDOW, "谢顶尔", "あぁ、俺も嬢ちゃんを手助けしたいと思ってな。/聞いたぜ。/嬢ちゃんは今は借金で大変らしいじゃねえか"
	CALL MESSAGE_WINDOW, "萝乐娜", "ええ…師匠が……"
	CALL MESSAGE_WINDOW, "谢顶尔", "いや、皆まで言うな。/嬢ちゃんがその小さい体で頑張ってるのは聞いてるからよ"
	CALL MESSAGE_WINDOW, "谢顶尔", "男としてこれは助けなくちゃいけねぇ。/でも、俺はこのとおり鍛冶屋だからな/武器や防具を作ることしかできねぇ"
	CALL MESSAGE_WINDOW, "谢顶尔", "そこでさっきの本と出会ったわけだ。/その本に書かれている装備调合を利用すれば/嬢ちゃんを手助けすることもできるって話だからな"
	CALL MESSAGE_WINDOW, "萝乐娜", "そうなんですか"
	CALL MESSAGE_WINDOW, "谢顶尔", "もちろん錬金術士の手助けがなきゃ装備调合もできないんだがよ。/この炭をみる限りじゃ大强韧そうだ。/というわけでこれから嬢ちゃんのために装備を作るぜ。"
	CALL MESSAGE_WINDOW, "萝乐娜", "え、ほんとですか？"
	CALL MESSAGE_WINDOW, "谢顶尔", "とはいえ、材料は嬢ちゃんが持ってこなけりゃいけないし/嬢ちゃんの懐事情はわかっちゃいるが/手数料も少しはもらわなきゃやっていけそうになくてな"
	CALL MESSAGE_WINDOW, "萝乐娜", "いえ、そんな気を使わなくても"
	CALL MESSAGE_WINDOW, "谢顶尔", "まぁとにかく、必要そうならいつでも材料を持ってきてくれ。"
	CALL MESSAGE_WINDOW, "萝乐娜", "はい、わかりました！"
	
	MONEY += 1000
	RECIPE:GET_NO("参考书", "锻造的基础") = 1
	CALL SHOW_HELP, "装备调合"
	CALL SET_EVENTFLAG, "武器店的工作", "达成"
ELSE
	FLAG:事件内的分歧 = 0
	CALL SHOW_SITUATION, "王宮受付"
	CALL MESSAGE_WINDOW, "エスティ", "あ、ロロナちゃん。/ちょっといいかしら？"
	CALL MESSAGE_WINDOW, "萝乐娜", "はい/どうしたんですか？"
	CALL MESSAGE_WINDOW, "エスティ", "ちょっと珍しい仕事でロロナちゃんにしか頼めそうにないのよね"
	CALL MESSAGE_WINDOW, "萝乐娜", "え、どういうことですか？/わたしにしかできないってそんなこと言われても…"
	CALL MESSAGE_WINDOW, "エスティ", "あ、大强韧よ。/錬金術士じゃなきゃ駄目だってだけで/錬金術士ならそんなにむずかしくないはずだから"
	CALL MESSAGE_WINDOW, "萝乐娜", "あ、そういうことでしたか/なら…大强韧かな？"
	CALL MESSAGE_WINDOW, "エスティ", "そうそう。/最近の仕事ぶりを見ればわかるわよ/ロロナちゃんならこのくらい楽勝だって"
	CALL MESSAGE_WINDOW, "萝乐娜", "そ、そうですか？/えへへ"
	CALL MESSAGE_WINDOW, "エスティ", "それで、依頼だけど/錬金炭ってわかるかしら？/錬金術で作った、特別な炭なんだけど"
	IF RECIPE:GET_NO("参考书", "生活杂货百科")
		IF GET_KNOWN_ITEM("錬金炭", "获得")
			CALL MESSAGE_WINDOW, "萝乐娜", "あ、それなら作ったこともあるし/大强韧です。"
		ELSE
			CALL MESSAGE_WINDOW, "萝乐娜", "あ、それなら作り方は知ってるし/たぶん大强韧です。"
		ENDIF
		CALL MESSAGE_WINDOW, "エスティ", "それなら、お願いしても大强韧かしら？"
		CALL MESSAGE_WINDOW, "萝乐娜", "はい。任せておいてください。"
	ELSE
		CALL MESSAGE_WINDOW, "萝乐娜", "聞いた事ない…/やっぱり無理かも…"
		CALL MESSAGE_WINDOW, "エスティ", "これを見ても駄目かしら？"
		CALL MESSAGE_WINDOW, "", "エスティから【生活雑貨百科】を受け取った"
		CALL MESSAGE_WINDOW, "萝乐娜", "ええと……錬金炭は……っと……/…………/あ、これなら大强韧そう"
		CALL MESSAGE_WINDOW, "エスティ", "よかった。/それならその本はあげるわ。"
		CALL MESSAGE_WINDOW, "萝乐娜", "え、いいんですか？"
		CALL MESSAGE_WINDOW, "エスティ", "頑張ってるロロナちぇんへの私からのご褒美……/といいたいところだけど、ロロナちゃんがやってくれないと私も困るからね/気にしないでいいわよ"
		CALL MESSAGE_WINDOW, "萝乐娜", "えっと、じゃあ、そういうことならもらっておきます。"
		CALL MESSAGE_WINDOW, "エスティ", "それじゃあ、お願いしても大强韧よね？"
		CALL MESSAGE_WINDOW, "萝乐娜", "は、はい。がんばります！"
		RECIPE:GET_NO("参考书", "生活杂货百科") = 1
	ENDIF
	CALL MESSAGE_WINDOW, "エスティ", "それから、この依頼は男の武器屋のハゲルさんからでてるの/だから、できたらここじゃなくて/直接、男の武器屋まで持って行ってね/报酬も直接ロロナちゃんに渡すって聞いてるわ"
	CALL MESSAGE_WINDOW, "萝乐娜", "わかりました"
	CALL MESSAGE_WINDOW, "エスティ", "それじゃ、がんばってね"
	CALL MESSAGE_WINDOW, "", "依頼を引き受けた。/錬金炭を男の武器屋に持って行こう。"
	CALL SET_EVENTFLAG, "武器店的工作", "开始"
ENDIF
RETURN 1
@EVENT_NOTE_20
IF GET_EVENT_PLAY("武器店的工作")
	RESULTS = おやじさんに錬金炭の调合を依頼された。/早速つくって男の武器屋まで持って行こう。
ELSE
	RESULTS = おやじさんに頼まれた仕事をこなした。/そうしたら、これからわたしのために武器とか防具を作ってくれるらしい。/戦ってないのにいるのかな…？/とは思ったけど役に立つらしいし/おやじさんははりきってるし、とにかくつくってもらったほうがよさそう。
ENDIF
@EVENT_HEADER_20
DRAWLINE
SELECTCASE FLAG:事件内的分歧
	CASE 0
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-王宮受付-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 1
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-ロロナのアトリエ-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 2
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-男の武器屋-%"",20%资金:{MONEY:0, 9}克尔", ""
ENDSELECT
PRINTL 
DRAWLINE

@EVENT_20_REQ, ARG
SIF GET_ITEMNAME(ARG) != "錬金炭"
	RETURN 0
RETURN 1
