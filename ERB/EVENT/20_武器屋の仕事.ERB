@EVENT_NAME_20
RESULTS = 武器店的工作

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_20
#LOCALSIZE 3
SIF FLAG:公会等阶 < 2
	RETURN 0
IF GET_EVENT_PLAY("武器店的工作")
	SIF GET_NO("SHOP", "男子汉武器店") != FLAG:SHOP指令
		RETURN 0
ELSE
	SIF GET_MIXLV(MASTER) < 10
		RETURN 0
	SIF GET_NO("SHOP", "王宫") != FLAG:SHOP指令
		RETURN 0
	SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
		RETURN 0
	SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
		RETURN 0
ENDIF
RETURN 1

@EVENT_ACT_20
#LOCALSIZE 2
IF GET_EVENT_PLAY("武器店的工作")
	FLAG:事件内的分歧 = 1
	IF !HAVE_ITEM("炼金炭")
		CALL MESSAGE_WINDOW, "萝乐娜", "说起来，好像老爹拜托我要炼金炭来着……/快点准备比较好呢……大概……"
		RETURN 0
	ELSE
		CALL MESSAGE_WINDOW, "萝乐娜", "说起来，好像老爹拜托我要炼金炭来着，/那个……"
		CALL MESSAGE_WINDOW, "", "请选择要提交的炼金炭。"
		LOCAL = LINECOUNT
		CALL SHOW_ITEMLIST, "选择物品", "持有", 1, "EVENT_20_REQ"
		CLEARLINE LINECOUNT - LOCAL
		IF !RESULT
			CALL MESSAGE_WINDOW, "萝乐娜", "嗯……这次还是算了吧。"
			RETURN 0
		ENDIF
	ENDIF
	CALL DEL_CHOICE_ITEM
	FLAG:事件内的分歧 = 2
	CALL SHOW_SITUATION, "男子汉武器店"
	CALL BGM, "武器店老板.mp3"
	CALL MESSAGE_WINDOW, "萝乐娜", "老——爹。/我带来炼金炭啦——"
	CALL MESSAGE_WINDOW, "光格尔", "哦……让我瞧瞧。"
	CALL MESSAGE_WINDOW, "", "把炼金炭交给光格尔。"
	CALL MESSAGE_WINDOW, "光格尔", "这个就是炼金炭吗……"
	CALL MESSAGE_WINDOW, "萝乐娜", "不好意思……。/我也不知道有没有很好地炼成……"
	CALL MESSAGE_WINDOW, "光格尔", "不不，我觉得你做的很好哦。/我也从事这个工作很多年了，/只要看一眼就能大致知道好坏。"
	CALL MESSAGE_WINDOW, "萝乐娜", "是吗？/太好了——。"
	CALL MESSAGE_WINDOW, "光格尔", "哎呀，听说丫头你在打理工房，/而且最近甚至还作为冒险者在承接委托之类的。/很吃惊，但是看到这个成品我认可了。"
	CALL MESSAGE_WINDOW, "萝乐娜", "嘿嘿，是吗……/诶，嗯？/那个……？"
	CALL MESSAGE_WINDOW, "光格尔", "好了，别在意了。/话说，先把报酬给你。"
	CALL SOLO, "试试看吧.mp3"
	MONEY += 1000
	RECIPE:GET_NO("参考书", "锻造的基础") = 1
	CALL MESSAGE_WINDOW, "", "获得了1000克尔和【锻造的基础】。"
	CALL MESSAGE_WINDOW, "萝乐娜", "谢谢。/话说这本书是？"
	CALL MESSAGE_WINDOW, "光格尔", "啊啊，这是最近刚得到的。/总而言之，这本书写了有关炼金术和锻造的内容。/简单来说，把这两者结合起来，/能制作出拥有神奇力量的武器和防具。"
	CALL MESSAGE_WINDOW, "萝乐娜", "诶——……把炼金术和锻造……/感觉好像很有意思呢。"
	CALL MESSAGE_WINDOW, "光格尔", "丫头如果你也感兴趣的话，/那就好说了。"
	CALL MESSAGE_WINDOW, "萝乐娜", "好说？"
	CALL MESSAGE_WINDOW, "光格尔", "是啊，我也想帮助丫头你咧。/听说了啊。/丫头你现在因为借款很辛苦吧。"
	CALL MESSAGE_WINDOW, "萝乐娜", "呃呃……师傅她……"
	CALL MESSAGE_WINDOW, "光格尔", "不用，不用说那么多。/我听说了，你用你那小小的身躯一直在努力着呢。"
	CALL MESSAGE_WINDOW, "光格尔", "作为男人怎么能不帮。/但是，如你所见，我只是一个铁匠。/只能做些武器或者防具。"
	CALL MESSAGE_WINDOW, "光格尔", "就在那时，遇见了这本书。/如果能利用这本书中所写的装备调合，/就能帮上丫头你了。"
	CALL MESSAGE_WINDOW, "萝乐娜", "这样吗。"
	CALL MESSAGE_WINDOW, "光格尔", "当然如果没有炼金术士的帮助，就不能做装备调合。/但看了你炼制的炭，应该不成问题。/因此，以后为了你制作装备。"
	CALL MESSAGE_WINDOW, "萝乐娜", "诶，真的吗？"
	CALL MESSAGE_WINDOW, "光格尔", "话是如此，但材料得你自己带过来。/你的财务情况我也知道，/但如果一点手续费也不收的话，很难经营下去啊。"
	CALL MESSAGE_WINDOW, "萝乐娜", "不，不用那么费心。"
	CALL MESSAGE_WINDOW, "光格尔", "不过总之，如果觉得有必要，可以随时带材料过来。"
	CALL MESSAGE_WINDOW, "萝乐娜", "好的，我明白了！"
	
	CALL SHOW_HELP, "装备调合"
	CALL SET_EVENTFLAG, "武器店的工作", "达成"
ELSE
	FLAG:事件内的分歧 = 0
	CALL SHOW_SITUATION, "王宫柜台"
	CALL BGM, "王宫的入口.mp3"
	CALL MESSAGE_WINDOW, "艾丝缇", "啊，萝乐娜。/你现在方便吗？"
	CALL MESSAGE_WINDOW, "萝乐娜", "方便的。/怎么啦？"
	CALL MESSAGE_WINDOW, "艾丝缇", "因为是一个比较特别的工作，感觉只能拜托萝乐娜你呢。"
	CALL MESSAGE_WINDOW, "萝乐娜", "诶，怎么回事？/只有我能做？就算你这么说……"
	CALL MESSAGE_WINDOW, "艾丝缇", "啊，不是什么大事啦。/只是必须得是炼金术士才行，/不过如果是炼金术士的话，应该不会很难。"
	CALL MESSAGE_WINDOW, "萝乐娜", "啊，是这么一回事啊。/那么……应该没问题吧？"
	CALL MESSAGE_WINDOW, "艾丝缇", "是的。/只要看你最近的工作状态就知道。/如果是萝乐娜你的话，这种事小菜一碟。"
	CALL MESSAGE_WINDOW, "萝乐娜", "是，是吗？/嘿嘿。"
	CALL MESSAGE_WINDOW, "艾丝缇", "然后，说到委托，/你知道炼金炭吗？/用炼金术制成的特殊的炭。"
	IF RECIPE:GET_NO("参考书", "生活杂货百科")
		IF GET_KNOWN_ITEM("炼金炭", "获得")
			CALL MESSAGE_WINDOW, "萝乐娜", "啊，那个的话，我有做过。/没问题的。"
		ELSE
			CALL MESSAGE_WINDOW, "萝乐娜", "啊，那个的话，我知道制作方法。/应该没问题。"
		ENDIF
		CALL MESSAGE_WINDOW, "艾丝缇", "那么，拜托你没问题吧？"
		CALL MESSAGE_WINDOW, "萝乐娜", "是的。请交给我。"
	ELSE
		CALL MESSAGE_WINDOW, "萝乐娜", "没听说过……/果然还是做不到……"
		CALL MESSAGE_WINDOW, "艾丝缇", "看了这个也不行吗？"
		CALL SOLO, "试试看吧.mp3"
		RECIPE:GET_NO("参考书", "生活杂货百科") = 1
		CALL MESSAGE_WINDOW, "", "从艾丝缇那儿获得【生活杂货百科】。"
		CALL MESSAGE_WINDOW, "萝乐娜", "那个……炼金炭是……额……/…………/啊，这样的话应该没问题。"
		CALL MESSAGE_WINDOW, "艾丝缇", "太好了。/既然这样，这本书给你啦。"
		CALL MESSAGE_WINDOW, "萝乐娜", "诶，可以吗？"
		CALL MESSAGE_WINDOW, "艾丝缇", "这是我给努力工作的萝乐娜的奖励……/虽然很想这么说，但萝乐娜不帮我做的话，我也会很苦恼，/所以不用在意啦。"
		CALL MESSAGE_WINDOW, "萝乐娜", "那个，如果是那样的话我就收下啦。"
		CALL MESSAGE_WINDOW, "艾丝缇", "那么，拜托你没问题吧？"
		CALL MESSAGE_WINDOW, "萝乐娜", "是，是的。我会努力的！"
		
	ENDIF
	CALL MESSAGE_WINDOW, "艾丝缇", "然后，这个委托是男子汉武器店的光格尔发布的。/因此完成委托后，不要交到这里，/直接把物品带到男子汉武器店去吧。/听说报酬也是直接交给你哦。"
	CALL MESSAGE_WINDOW, "萝乐娜", "我明白了。"
	CALL MESSAGE_WINDOW, "艾丝缇", "那么，请加油完成哦。"
	CALL MESSAGE_WINDOW, "", "已承接委托。/把炼金炭带到男子汉武器店去吧。"
	CALL SET_EVENTFLAG, "武器店的工作", "开始"
ENDIF
RETURN 1
@EVENT_NOTE_20
IF GET_EVENT_PLAY("武器店的工作")
	RESULTS = 被老爹委托了炼金炭的调合。/赶快做好，带去男子汉的武器店吧。
ELSE
	RESULTS = 完成了老爹委托的工作。/然后，好像以后要为我制作武器和防具。/我觉得明明不战斗，真的需要这些嘛……？/但好像又很有用处，/而且老爹也干劲满满，总之感觉还是让老爹做比较好呢。
ENDIF
@EVENT_HEADER_20
DRAWLINE
SELECTCASE FLAG:事件内的分歧
	CASE 0
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-王宫柜台-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 1
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 2
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-男子汉武器店-%"",20%资金:{MONEY:0, 9}克尔", ""
ENDSELECT
PRINTL 
DRAWLINE

@EVENT_20_REQ, ARG
SIF GET_ITEMNAME(ARG) != "炼金炭"
	RETURN 0
RETURN 1
