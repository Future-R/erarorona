@EVENT_NAME_21
RESULTS = 霍姆们的工作

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_21
#LOCALSIZE 3
SIF FLAG:公会等阶 < 2
	RETURN 0
SIF GRANK_UP_DAY:2 + 15 > DAY
	RETURN 0
SIF GET_EVENT_ATTAIN("霍姆们的工作")
	RETURN 0
SIF GET_EVENT_ATTAIN("練習のお誘い") + 15 > DAY
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:商店指令 == GET_NO("商店", "探索")
	RETURN 0
;20種调合が必要
SIF GET_CREATED_MIX_NUM() < 20
	RETURN 0
RETURN 1

@EVENT_ACT_21
#LOCALSIZE 2
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL MESSAGE_WINDOW, "萝乐娜", "えーと…これはこうして…"
CALL MESSAGE_WINDOW, "霍姆妹妹", "マスター、掃除が終わりました。"
CALL MESSAGE_WINDOW, "萝乐娜", "あ、うん。ありがとう。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "他になにかやることはありますか？"
CALL MESSAGE_WINDOW, "萝乐娜", "えーっと…ちょっと待って、今调合で忙しくて…"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "………"
CALL MESSAGE_WINDOW, "萝乐娜", "………"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "………"
CALL MESSAGE_WINDOW, "萝乐娜", "えっと…どうしたの？"
CALL MESSAGE_WINDOW, "霍姆妹妹", "ホムはちょっと待ってます。"
CALL MESSAGE_WINDOW, "萝乐娜", "え……/あ、そうだ/じゃあちょっと師匠と遊んでて！"
CALL MESSAGE_WINDOW, "霍姆弟弟", "ホムは仕事がしたいです…"
CALL MESSAGE_WINDOW, "萝乐娜", "し、師匠と遊ぶのも大切な仕事じゃないかな…/だから…"
CALL MESSAGE_WINDOW, "亚斯特丽德", "ほう…いいことを聞いた。/それならロロナ、さっそくお前にその大切な仕事をやってもらおうか？"
CALL MESSAGE_WINDOW, "萝乐娜", "え？/そんな暇ないですよ。/色々やることがあって…"
CALL MESSAGE_WINDOW, "亚斯特丽德", "まったく、最近はいつもそれだ。/おかげでつまらんではないか。"
CALL MESSAGE_WINDOW, "萝乐娜", "誰のせいで忙しくなったと思ってるんですか！/師匠の借金のせいじゃないですか！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "まぁそれは置いとくとして"
CALL MESSAGE_WINDOW, "萝乐娜", "置いとかないでください！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "置いとくとしてだ。/お前も忙しいわけだし、ホム達も仕事をしたがってるわけだし/代わりに调合をやってもらえばいいじゃないか"
CALL MESSAGE_WINDOW, "萝乐娜", "え…？/できるんですか？"
CALL MESSAGE_WINDOW, "霍姆妹妹", "できます。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "錬金術の基礎はグランド・マスターに教えてもらっています。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "というわけだ。"
CALL MESSAGE_WINDOW, "萝乐娜", "そうだったんですか……/それならそうとはやく言ってくれれば……/って、あれわたしは何も教わってないのに……？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "とにかくだ。/ホム、ロロナの代わりに调合をやってやれ"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "わかりました、グランド・マスター。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "というわけでロロナ、お前はわたしにつきあってもらうぞ。"
CALL MESSAGE_WINDOW, "萝乐娜", "ちょっと待ってください。/调合やってもらえるんなら他にもすることが……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "なんだ。/まだわたしと遊べないというのか？"
CALL MESSAGE_WINDOW, "萝乐娜", "ええ、申し訳ないですけど……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "ふむ…‥じゃあ仕方ない。/今日はわたしがお前で遊ぶとしよう。"
CALL MESSAGE_WINDOW, "萝乐娜", "え…ちょっと待って下さい。/なにするんですか。/きゃー"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "", "ホムちゃんたちに调合を頼めるようになりました。"

CALL SHOW_HELP, "霍姆调合"

CALL SET_EVENTFLAG, "霍姆们的工作", "达成"

@EVENT_NOTE_21
RESULTS = ホムちゃんたちが錬金術をできることがわかった。/これから頼んでみよう。

@EVENT_HEADER_21
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-ロロナのアトリエ-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE
