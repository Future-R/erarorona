@EVENT_NAME_21
RESULTS = 霍姆们的工作

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_21
#LOCALSIZE 3
SIF FLAG:公会等阶 < 2
	RETURN 0
SIF GET_EVENT_ATTAIN("霍姆们的工作")
	RETURN 0
SIF GET_EVENT_ATTAIN("邀请练习") > DAY
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
; 需要调合20种物品
SIF GET_CREATED_MIX_NUM() < 20
	RETURN 0
RETURN 1

@EVENT_REPLAY_21
SIF GET_EVENT_ATTAIN("霍姆们的工作")
	RETURN 1
RETURN 0

@EVENT_ACT_21
#LOCALSIZE 2
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL BGM, "炼金少年少女.mp3"
CALL MESSAGE_WINDOW, "萝乐娜", "让我看看……这个是这样……"
CALL MESSAGE_WINDOW, "霍姆妹妹", "主人，打扫已完成。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，好的。谢谢。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "还有别的吩咐吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "我想想……稍等一下，我现在因为调合忙得不行……"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "………"
CALL MESSAGE_WINDOW, "萝乐娜", "………"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "………"
CALL MESSAGE_WINDOW, "萝乐娜", "那个……怎么了？"
CALL MESSAGE_WINDOW, "霍姆妹妹", "霍姆稍微等待了一会儿。"
CALL MESSAGE_WINDOW, "萝乐娜", "呃……/啊，对了。/那么，你们和师傅玩一会儿！"
CALL MESSAGE_WINDOW, "霍姆弟弟", "霍姆想工作……"
CALL MESSAGE_WINDOW, "萝乐娜", "和，和师傅玩也是重要的工作吧……/所以……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "哦……我听到了什么好玩的事。/那么萝乐娜，马上让你来做这个重要的工作吧？"
CALL MESSAGE_WINDOW, "萝乐娜", "哎？/才没那个空呢。/有很多事要做……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "真是的，最近总是那样。/托你的福，觉得无聊多了。"
CALL MESSAGE_WINDOW, "萝乐娜", "你以为我是因为谁才变得这么忙的吗！/还不是因为师傅你的债务吗！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "哎呀，这个先不说了。"
CALL MESSAGE_WINDOW, "萝乐娜", "请别跳过这个话题！"
CALL MESSAGE_WINDOW, "亚斯特丽德", "这件事就先放一边吧。/你也很忙，霍姆他们也想工作，/让他们替你调合不就好了嘛。"
CALL MESSAGE_WINDOW, "萝乐娜", "哎……？/他们会做吗？"
CALL MESSAGE_WINDOW, "霍姆妹妹", "会的。"
CALL MESSAGE_WINDOW, "霍姆弟弟", "大主人一直在教我们炼金术的基础。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "总之，就是这样。"
CALL MESSAGE_WINDOW, "萝乐娜", "原来是这样啊……/如果是这样的话，早点和我说不就好了……/诶，等等？可师傅你什么都没教我诶……？"
CALL MESSAGE_WINDOW, "亚斯特丽德", "不管怎样。/霍姆，代替萝乐娜去进行调合。"
CALL MESSAGE_WINDOW, "霍姆弟弟与妹妹", "明白，大主人。"
CALL MESSAGE_WINDOW, "亚斯特丽德", "那么萝乐娜，就由你来陪我吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "请等一下。/调合能帮忙做的话，其他的事情也……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "什么呀。/还不能和我玩吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "是的，不好意思……"
CALL MESSAGE_WINDOW, "亚斯特丽德", "嗯……那没办法了。/今天我决定就玩你了。"
CALL MESSAGE_WINDOW, "萝乐娜", "哎……请等一下。/你要干什么。/呀－－"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "", "能拜托霍姆他们进行调合了。"
SIF FLAG:回想模式
	RETURN 0
CALL SHOW_HELP, "霍姆调合"

CALL SET_EVENTFLAG, "霍姆们的工作", "达成"

@EVENT_NOTE_21
RESULTS = 知道霍姆他们会炼金术。/以后试着拜托他们。

@EVENT_HEADER_21
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE
