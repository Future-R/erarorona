@EVENT_NAME_22
RESULTS = 可靠的骑士

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_22
#LOCALSIZE 3
SIF FLAG:公会等阶 < 2
	RETURN 0
SIF !CFLAG:GET_CNUM("史特尔克"):认识
	RETURN 0
SIF GRANK_UP_DAY:2 + 30 > DAY
	RETURN 0
SIF GET_EVENT_ATTAIN("采集委托") + 15 > DAY
	RETURN 0
SIF FLAG:累计报酬额 < 15000
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
RETURN 1

@EVENT_ACT_22
#LOCALSIZE 2
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL MESSAGE_WINDOW, "萝乐娜", "呃……接下来做什么好呢……/有好多要做的事……/唔，能在这三年里坚持努力吗。我……"
CALL MESSAGE_WINDOW, "史特尔克", "看来，你不仅很忙还很沮丧啊。"
CALL MESSAGE_WINDOW, "萝乐娜", "诶？哇！？/史，史特尔克？/为，为什么在这里……"
CALL MESSAGE_WINDOW, "史特尔克", "喊了你好几次都没回应。/虽然很失礼，但还是擅自进来了。"
CALL MESSAGE_WINDOW, "萝乐娜", "对，对不起。/我走神了……/请问，你找我……"
CALL MESSAGE_WINDOW, "史特尔克", "啊啊。/关于王宫发布的委托，有些话想……"
CALL MESSAGE_WINDOW, "萝乐娜", "委托的事？/是，是哪里失败了嘛？/难道，收到很多投诉之类的？"
CALL MESSAGE_WINDOW, "史特尔克", "不，倒也不是那种事……"
CALL MESSAGE_WINDOW, "萝乐娜", "果然必须得赔偿吗？/呜哇啊啊啊啊！/怎么办怎么办——！？"
CALL MESSAGE_WINDOW, "史特尔克", "……安静！"
CALL MESSAGE_WINDOW, "萝乐娜", "好，好的！"
CALL MESSAGE_WINDOW, "史特尔克", "什么事都想得太坏可不好哦。/话说回来，你的情况，可能因为你的师傅，/才让你有很强的受害者意识。"
CALL MESSAGE_WINDOW, "萝乐娜", "唔……是这样吗……/史特尔克，你刚才一副恐怖的表情，我还以为……"
CALL MESSAGE_WINDOW, "史特尔克", "……我没打算摆出一副恐怖的脸色。/如果看起来是那样的话，我会努力改正的。/比起这个，我想差不多该进入正题吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，对不起。扯到别的话题上去了。"
CALL MESSAGE_WINDOW, "史特尔克", "那么……关于王宫的委托，/最近你的工作得到了很高的评价呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯，嗯。/是吗……/等等，诶～！？/真的吗！？"
CALL MESSAGE_WINDOW, "史特尔克", "嗯，是真的……/话说，没必要那么惊讶吧。/你应该更加挺起胸膛才对哦。"
CALL MESSAGE_WINDOW, "萝乐娜", "不，果然还是有点难以相信……"
CALL MESSAGE_WINDOW, "史特尔克", "于是呢。/如果能让我帮你干活的话，/我想这对亚兰德也有所帮助呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "帮忙是指？"
CALL MESSAGE_WINDOW, "史特尔克", "我听说你做委托时，/会到城镇外收集材料？"
CALL MESSAGE_WINDOW, "萝乐娜", "是，是的。/也有在店里买不到的材料之类的"
CALL MESSAGE_WINDOW, "史特尔克", "我虽然不会炼金术之类的，/但收集材料这种事还是会做的。/就让我用这种方式帮你吧。"
CALL MESSAGE_WINDOW, "史特尔克", "当然，你觉得麻烦的话，我不会强求……"
CALL MESSAGE_WINDOW, "萝乐娜", "没，没有！/完全不觉得麻烦什么的！"
CALL MESSAGE_WINDOW, "萝乐娜", "但是真的可以吗？/史特尔克，你还有城堡的工作吧。"
CALL MESSAGE_WINDOW, "史特尔克", "像我先前所说的，托你的福，城镇的人们得到了帮助，/而帮助你，也是为了城镇的大家。/这对于骑士来说，也是十分了不起的工作。"
CALL MESSAGE_WINDOW, "史特尔克", "……而且，/我也并非每天都那么忙呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "……骑士，难道意外地很闲吗？"
CALL MESSAGE_WINDOW, "史特尔克", "…………。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊！/对，对不起！/我不是那个意思！"
CALL MESSAGE_WINDOW, "史特尔克", "……不，不用介意。/我这边的事就说到这。/以后如果有什么想采集的东西，/尽管开口吧。那么，告辞。"
CALL MESSAGE_WINDOW, "萝乐娜", "……我惹他生气了嘛？/但是让史特尔克帮忙……/可以吗？/真的可以嘛……"

CALL SET_EVENTFLAG, "可靠的骑士", "达成"
CFLAG:GET_CNUM("史特尔克"):可能有采集委托 = 1

@EVENT_NOTE_22
RESULTS = 史特尔克能帮忙采集了。/虽然特别可靠，但是骑士的工作真的没事嘛？/虽然他本人说不是很忙。

@EVENT_HEADER_22
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE
