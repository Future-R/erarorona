@EVENT_NAME_22
RESULTS = 頼れる騎士さん

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_22
#LOCALSIZE 3
SIF FLAG:ギルドランク < 2
	RETURN 0
SIF !CFLAG:GET_CNUM("ステルク"):面識
	RETURN 0
SIF GRANK_UP_DAY:2 + 30 > DAY
	RETURN 0
SIF GET_EVENT_ATTAIN("採集依頼") + 15 > DAY
	RETURN 0
SIF FLAG:累計報酬額 < 15000
	RETURN 0
SIF FLAG:現地点 != GET_NO("場所", "アーランド")
	RETURN 0
SIF FLAG:ショップコマンド == GET_NO("ショップ", "探索")
	RETURN 0
RETURN 1

@EVENT_ACT_22
#LOCALSIZE 2
CALL SHOW_SITUATION, "ロロナのアトリエ"
CALL MESSAGE_WINDOW, "ロロナ", "うーん…次は何しようかな…/色々やることがあるし…/うう、三年間も頑張れるかな。わたし…"
CALL MESSAGE_WINDOW, "ステルク", "どうやら忙しそうな上に落ち込んでいるようだな"
CALL MESSAGE_WINDOW, "ロロナ", "え？わあ！？/ス、ステルクさん？/な、なんでここに…"
CALL MESSAGE_WINDOW, "ステルク", "何度か呼びかけたが返事がなかったのでな。/失礼かと思ったが、勝手にあがらせてもらった"
CALL MESSAGE_WINDOW, "ロロナ", "ご、ごめんなさい。/ぼーっとしてて…/あの、わたしに何か…"
CALL MESSAGE_WINDOW, "ステルク", "ああ。/王宮で出してる依頼のことで、少し話が…"
CALL MESSAGE_WINDOW, "ロロナ", "依頼のこと？/な、なんか失敗しちゃってました？/もしかして、苦情がいっぱいはいってるとか？"
CALL MESSAGE_WINDOW, "ステルク", "いや、そういう話では…"
CALL MESSAGE_WINDOW, "ロロナ", "やっぱり弁償とかしなきゃいけないんですか？/うわああああ！/どうしよどうしよー！？"
CALL MESSAGE_WINDOW, "ステルク", "……静まれ！"
CALL MESSAGE_WINDOW, "ロロナ", "は、はい！"
CALL MESSAGE_WINDOW, "ステルク", "何事も悪く考えすぎるのは良くないぞ。/もっとも君の場合、あの師匠のせいで/被害者意識が強いのかもしれないが"
CALL MESSAGE_WINDOW, "ロロナ", "う…そうなんでしょうか…/ステルクさん、怖い顔してたからてっきり…"
CALL MESSAGE_WINDOW, "ステルク", "…怖い顔をしているつもろはないのだが。/そう見えるなら、改める努力はしよう。/それより、そろそろ本題に入りたいのだが"
CALL MESSAGE_WINDOW, "ロロナ", "あ、ごめんなさい。関係話しちゃって"
CALL MESSAGE_WINDOW, "ステルク", "では…王宮の依頼のことだが/最近の君の仕事がとても評判がよくてな"
CALL MESSAGE_WINDOW, "ロロナ", "は、はい。/そうなんですか……/って、え～！？/ほんとですか！？"
CALL MESSAGE_WINDOW, "ステルク", "ああ本当だ…/というかそんなに驚くことじゃないだろう/もっと胸をはっていいはずだぞ"
CALL MESSAGE_WINDOW, "ロロナ", "いや、やっぱりちょっと信じられなくて…"
CALL MESSAGE_WINDOW, "ステルク", "それでだ。/君の仕事を手伝わせてもらえれば/アーランドのためになるのではと思ってな"
CALL MESSAGE_WINDOW, "ロロナ", "手伝うって？"
CALL MESSAGE_WINDOW, "ステルク", "君は依頼にあたって、/街の外に行って材料を集めていると聞いたが？"
CALL MESSAGE_WINDOW, "ロロナ", "は、はい。/お店じゃ売ってない材料とかもありますし"
CALL MESSAGE_WINDOW, "ステルク", "私は錬金術などはできないが/そういった材料を集めてくる事くらいはできるだろう。/そういう形で手伝わせてもらえればと"
CALL MESSAGE_WINDOW, "ステルク", "もちろん、迷惑であるならば無理強いはしないが…"
CALL MESSAGE_WINDOW, "ロロナ", "い、いえ！/全然迷惑なんかじゃないです！"
CALL MESSAGE_WINDOW, "ロロナ", "でもでもいいんですか？/ステルクさん、お城の仕事とかもあるし"
CALL MESSAGE_WINDOW, "ステルク", "先ほど言ったように君のおかげで街の人間が助かってるから/それを助けることで街の人間のためになるなら/それも騎士としての立派な勤めだ。"
CALL MESSAGE_WINDOW, "ステルク", "…それに、さほど多忙な毎日を/送っているわけでもないからな"
CALL MESSAGE_WINDOW, "ロロナ", "…騎士さんって、意外と暇なんですか？"
CALL MESSAGE_WINDOW, "ステルク", "…………。"
CALL MESSAGE_WINDOW, "ロロナ", "あ！/ご、ごめんなさい！/そんなつもりで言ったんじゃ！"
CALL MESSAGE_WINDOW, "ステルク", "…いや、気にしなくていい。/私からの用は以上だ。/今後何か採ってきて欲しいものがあったら/遠慮なく声をかけてほしい。では"
CALL MESSAGE_WINDOW, "ロロナ", "…怒らせちゃったかな？/でもステルクさんんが手伝ってくれるなんて…/いいのかな？/本当に…"

CALL SET_EVENTFLAG, "頼れる騎士さん", "達成"
CFLAG:GET_CNUM("ステルク"):採集依頼可能 = 1

@EVENT_NOTE_22
RESULTS = ステルクさんが採集を手伝ってくれるようになった。/すごく頼もしいけど騎士さんのお仕事は大丈夫なのかな？/忙しくないとはいってたけど

@EVENT_HEADER_22
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-ロロナのアトリエ-%"",20%所持金:{MONEY:0, 9}コール", ""
PRINTL 
DRAWLINE
