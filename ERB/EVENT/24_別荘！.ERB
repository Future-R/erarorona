@EVENT_NAME_24
RESULTS = 分店开业

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_24
#LOCALSIZE 3
SIF !GET_EVENT_ATTAIN("随波漂流")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
IF GET_EVENT_STATE("分店开业") == "准备开始"
	SIF !GROUPMATCH(GET_NAME("地点", FLAG:当前地点), "阿拉尼亚村")
		RETURN 0
ELSE
	SIF !GROUPMATCH(GET_NAME("地点", FLAG:当前地点), "亚兰德")
		RETURN 0
ENDIF
RETURN 1

@EVENT_ACT_24
#LOCALSIZE 2
IF GET_EVENT_STATE("分店开业") == "准备开始"
	FLAG:事件内的分歧 = 1
	CALL SHOW_SITUATION, "阿拉尼亚村"
	CALL BGM, "相遇是炼金术.mp3"
	CALL MESSAGE_WINDOW, "萝乐娜", "好，必须努力发挥作用来报恩！/不过，那难道是霍姆妹妹…？/为什么会在这种地方？"
	CALL MESSAGE_WINDOW, "", "萝乐娜来到阿拉尼亚村，/意外发现提着购物篮的霍姆妹妹站在那里……"
	CALL MESSAGE_WINDOW, "萝乐娜", "应该不可能……长得一模一样吧？/喂——"
	CALL MESSAGE_WINDOW, "霍姆妹妹", "主人，有什么事吗？"
	CALL MESSAGE_WINDOW, "萝乐娜", "果然是霍姆妹妹吧……？"
	CALL MESSAGE_WINDOW, "霍姆妹妹", "我就是霍姆哦。"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯……那，为什么会在这种地方？"
	CALL MESSAGE_WINDOW, "霍姆妹妹", "霍姆刚买完东西回来。/今晚的晚餐是烤鱼。"
	CALL MESSAGE_WINDOW, "萝乐娜", "这样啊，/能买到新鲜的鱼真好……/不过我想问的不是这个啦……"
	CALL MESSAGE_WINDOW, "霍姆妹妹", "对了。/大主人命令说，/如果见到主人就带路。/请跟霍姆来。"
	CALL MESSAGE_WINDOW, "萝乐娜", "难道师傅也在这里……？"
	CALL MESSAGE_WINDOW, "", "萝乐娜战战兢兢地跟着霍姆走了……"
	CALL MESSAGE_WINDOW, "", "………………/…………/……"
	FLAG:事件内的分歧 = 2
	CALL SHOW_SITUATION, "民宅"
	CALL MESSAGE_WINDOW, "霍姆妹妹", "霍姆回来了。/另外，主人在这里，已经带过来了。"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "哦，明白了。辛苦你了。"
	CALL MESSAGE_WINDOW, "萝乐娜", "师傅……为什么您会在这里？"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "听说这里是个好地方，/我觉得建个别墅休养也不错吧。"
	CALL MESSAGE_WINDOW, "萝乐娜", "休养……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "一直窝在亚兰德的话，/既不能去海水浴，/也没法穿泳衣，/这样可不够治愈啊。"
	CALL MESSAGE_WINDOW, "萝乐娜", "唉……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "再说了。/你要是在这里工作的话，/有个房子会更方便吧？"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯……可能确实是这样……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "而且你看那边。"
	CALL MESSAGE_WINDOW, "", "亚斯特丽德指向的地方有一口炼金釜。"
	CALL MESSAGE_WINDOW, "萝乐娜", "啊，是釜！"
	CALL MESSAGE_WINDOW, "霍姆弟弟", "主人，这边也有箱子，/与亚兰德工房的箱子相连，请随意使用。"
	CALL MESSAGE_WINDOW, "萝乐娜", "诶，真的连在一起了？"
	CALL MESSAGE_WINDOW, "霍姆弟弟", "是真的。/多亏这个，留在亚兰德的食材也能使用/帮了霍姆大忙。"
	CALL MESSAGE_WINDOW, "萝乐娜", "哇——……/好厉害……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "综上所述，我很期待你的泳衣哦。萝乐娜。"
	CALL MESSAGE_WINDOW, "萝乐娜", "诶——"
	CALL MESSAGE_WINDOW, "", "在阿拉尼亚村设立了工房。/今后在阿拉尼亚村不仅可以进行调合/还能通过箱子存取物品。"
	CALL SET_EVENTFLAG, "分店开业", "达成"
ELSE
	CALL SHOW_SITUATION, "萝乐娜的工房"
	CALL MESSAGE_WINDOW, "萝乐娜", "我回来啦ーー"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "终于回来了啊。/这次又跑到哪里去了？/好像花了挺长时间啊。"
	CALL MESSAGE_WINDOW, "萝乐娜", "去了阿拉尼亚村！"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "阿拉尼亚村？"
	CALL MESSAGE_WINDOW, "萝乐娜", "对啊/那里有大海！/还有很多鱼，/真的很棒哦！"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "霍姆知道吗？"
	CALL MESSAGE_WINDOW, "霍姆妹妹", "那里是亚兰德南部的渔村。/从黄金平原往西南方向走就能到达。"
	CALL MESSAGE_WINDOW, "霍姆弟弟", "原本只是个普通的渔村，/但由于诞生了一位极其优秀的冒险者，/近年来为了支援冒险者设立了据点，/也被用作附近冒险者的据点。"
	CALL MESSAGE_WINDOW, "萝乐娜", "对对，这次的工作就是支援那些冒险者！"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "嗯？/具体怎么回事？"
	CALL MESSAGE_WINDOW, "萝乐娜", "其实是这样的……"
	CALL MESSAGE_WINDOW, "", "萝乐娜简要说明了之前发生的事。"
	CALL MESSAGE_WINDOW, "萝乐娜", "总之就是这样，/我要赶紧去工作了，先走啦！"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "等等。"
	CALL MESSAGE_WINDOW, "萝乐娜", "嗯？/怎么了？"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "先确认一下/既然是渔村，应该有漂亮的大海和沙滩吧？"
	CALL MESSAGE_WINDOW, "萝乐娜", "那当然啦…/问这个干嘛？"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "最近总是很累，/偶尔去度个假也不错吧。"
	CALL MESSAGE_WINDOW, "萝乐娜", "总是很累……您不是一直在玩吗……/而且周围的人都很好，别打扰人家啊！"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "真没礼貌，/我可从没给别人添过麻烦。"
	CALL MESSAGE_WINDOW, "萝乐娜", "……唉，算了/总之我要去工作了。"
	CALL MESSAGE_WINDOW, "", "………………/…………/……"
	CALL MESSAGE_WINDOW, "亚斯特丽德", "好吧，萝乐娜也不陪我玩，/这边也赶紧搞定算了。"
	CALL SET_EVENTFLAG, "分店开业", "状态", "准备开始"
ENDIF
RETURN 1
@EVENT_NOTE_24
RESULTS = 在师傅的帮助下开设了新工房。/今后在阿拉尼亚村也能调合了。/如果想快速往返亚兰德和阿拉尼亚村的话，可以花钱坐马车。

@EVENT_HEADER_24
DRAWLINE
SELECTCASE FLAG:事件内的分歧
	CASE 0
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 1
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-阿拉尼亚村-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 2
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-民宅-%"",20%资金:{MONEY:0, 9}克尔", ""
ENDSELECT
PRINTL 
DRAWLINE
