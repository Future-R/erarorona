@EVENT_NAME_25
RESULTS = 捡到了钱包

; 触发条件
@EVENT_ABLE_25
#LOCALSIZE 3
; 第1年9月7日之前都不会触发
SIF CONVERT_DAY(1, 9, 7) > DAY
	RETURN 0
; 不在亚兰德就不会触发
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
; 如果当前在外探索，就不会触发
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
; 以上条件都不满足，则这个事件可以触发
RETURN 1


; 标记该事件有多少回想分支
@EVENT_REPLAY_25
; 已经完成了该任务，返回1分支
IF GET_EVENT_ATTAIN("捡到了钱包")
	RETURN 1
ENDIF
RETURN 0

@EVENT_ACT_25
#LOCALSIZE 2
CALL SHOW_SITUATION, "广场"
CALL BGM, "相遇是炼金术.mp3"
CALL MESSAGE_WINDOW, "萝乐娜", "哇，发生什么事了？/聚集了好多人……这是在做什么呢？"
CALL MESSAGE_WINDOW, "萝乐娜", "啊……是人偶剧……/哇，她是怎么操控人偶的呀？"
CALL MESSAGE_WINDOW, "萝乐娜", "那女孩年纪应该跟我差不多吧～/好厉害……"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯～好想靠近一点看哦……/哇，那个，别……别，别推我……"
CALL MESSAGE_WINDOW, "萝乐娜", "呃，哇，哇哇哇……/啊啊啊啊啊啊啊啊！"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "金发女孩", "表，表演到此结束！/谢，谢谢观赏！"
CALL MESSAGE_WINDOW, "路人A", "哇哦哦哦哦！小妹妹，真精彩啊！"
CALL MESSAGE_WINDOW, "路人B", "继续嘛！继续表演嘛！"
CALL MESSAGE_WINDOW, "路人C", "再来一场！再来一场！"
CALL MESSAGE_WINDOW, "金发女孩", "咦，啊，啊唔唔……/对，对不起！"
CALL MESSAGE_WINDOW, "路人A", "啊，跑走了。"
CALL MESSAGE_WINDOW, "路人B", "咦～没了哦？"
CALL MESSAGE_WINDOW, "路人C", "啧，真没办法……/我会期待下次表演的～！"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "萝乐娜", "呜，呜呜呜呜……/我，我都被踩扁了……"
CALL MESSAGE_WINDOW, "萝乐娜", "咦，咦咦？/人偶剧已经演完了？/我还想继续看呀……"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯？那是……"
CALL MESSAGE_WINDOW, "萝乐娜", "是钱包……？/会不会是那女孩的？该怎么办呢……"

; 用SET_EVENTFLAG改变事件完成情况
CALL SET_EVENTFLAG, "捡到了钱包", "达成"
RETURN 1

; 萝乐娜对于这个事件做的笔记
@EVENT_NOTE_25
RESULTS = 我捡到一个钱包，/好像是之前演人偶剧的女孩子掉的。/该怎么还回去呢……

; 事件发生时，顶端显示的内容
@EVENT_HEADER_25
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-广场-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE