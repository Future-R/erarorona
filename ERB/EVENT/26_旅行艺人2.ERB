@EVENT_NAME_26
RESULTS = 会说话的人偶！

; 触发条件
@EVENT_ABLE_26
#LOCALSIZE 3
; 如果没通过捡到了钱包的剧情则不会触发
SIF !GET_EVENT_ATTAIN("捡到了钱包")
	RETURN 0
; 捡到了钱包的剧情过了不到1天就不会触发
SIF GET_EVENT_ATTAIN("捡到了钱包") + 1 > DAY
	RETURN 0
; 不在亚兰德就不会触发
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
; 如果当前在外探索，就不会触发
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
; 以上条件都不满足，则这个事件可以触发
RETURN 1

; 标记该事件有多少回想分支
@EVENT_REPLAY_26
IF GET_EVENT_ATTAIN("会说话的人偶！")
	RETURN 1
ENDIF
RETURN 0

@EVENT_ACT_26
#LOCALSIZE 2
CALL SHOW_SITUATION, "工匠大道～工房前～"
CALL BGM, "杂技少女.mp3"
CALL MESSAGE_WINDOW, "金发女孩", "呼，呼……不，不行了……"
CALL MESSAGE_WINDOW, "橙猫人偶", "振作点。呆呆坐在这种地方，/也不会有人来帮你的。"
CALL MESSAGE_WINDOW, "金发女孩", "是没错啦……/可是都被旅馆赶出来了……/而且还好几天没吃东西……"
CALL MESSAGE_WINDOW, "黑猫人偶", "是你自作自受。/紧张到逃跑，还掉了钱包，/连表演的小费都没收到……"
CALL MESSAGE_WINDOW, "金发女孩", "呜呜……可是，/我又不是故意弄丢钱包的……"
CALL MESSAGE_WINDOW, "黑猫人偶", "废话。/这世界上哪有笨蛋会故意弄丢钱包啊。"
CALL MESSAGE_WINDOW, "金发女孩", "呜……呜呜……呜呜……"
CALL MESSAGE_WINDOW, "橙猫人偶", "够了！别再欺负她了！/里欧涅菈也别因为这样就哭啦！"
CALL MESSAGE_WINDOW, "金发女孩", "对不起……可，可是……"
CALL MESSAGE_WINDOW, "萝乐娜", "啊～！找到你了！！"
CALL MESSAGE_WINDOW, "金发女孩", "呀啊啊啊啊！？"
CALL MESSAGE_WINDOW, "萝乐娜", "请问，/你前阵子是不是在这边表演过人偶剧？"
CALL MESSAGE_WINDOW, "金发女孩", "啊，啊唔唔唔……是，那个……"
CALL MESSAGE_WINDOW, "萝乐娜", "在那之后我一直在找你呢。/这是你的钱包没错吧？"
CALL MESSAGE_WINDOW, "橙猫人偶", "哎呀～是里欧涅菈的钱包。"
CALL MESSAGE_WINDOW, "黑猫人偶", "你特地送过来啊。/真是乖巧的女孩。"
CALL MESSAGE_WINDOW, "萝乐娜", "没有啦……/咦？刚刚人偶……说话了吗？"
CALL MESSAGE_WINDOW, "金发女孩", "啊……"
CALL MESSAGE_WINDOW, "橙猫人偶", "哎呀，糟糕。我真是的。"
CALL MESSAGE_WINDOW, "黑猫人偶", "喂喂，/别把本大爷跟那些普通人偶混为一谈。/别看本大爷这副模样，但其实啊……"
CALL MESSAGE_WINDOW, "橙猫人偶", "嘘！禁止在陌生人面前说话啦！"
CALL MESSAGE_WINDOW, "黑猫人偶", "啊，对哦。/不过现在好像太迟了吧？"
CALL MESSAGE_WINDOW, "萝乐娜", "………………"
CALL MESSAGE_WINDOW, "金发女孩", "啊……不，不是……/那个，刚刚，他们没有……所以……"
CALL MESSAGE_WINDOW, "萝乐娜", "好……好棒哦！/我第一次看到会说话的人偶呢！"
CALL MESSAGE_WINDOW, "金发女孩", "咦……？"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，我的名字是萝乐娜。/你们叫什么名字？"
CALL MESSAGE_WINDOW, "阿蓝妮亚", "啊，你真有礼貌。/我是阿蓝妮亚，请多指教。"
CALL MESSAGE_WINDOW, "赫勒赫鲁", "本大爷叫赫勒赫鲁。/这名字好听又好记吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯……那我就叫你们赫鲁跟……/蓝妮吧。请多指教！"
CALL MESSAGE_WINDOW, "金发女孩", "………………"
CALL MESSAGE_WINDOW, "阿蓝妮亚", "好了，你也别在那发呆，/赶快一起打个招呼。"
CALL MESSAGE_WINDOW, "里欧涅菈", "好，好！我是，里欧涅菈……"
CALL MESSAGE_WINDOW, "阿蓝妮亚", "我们一边演出人偶剧，/一边游历许多国家。"
CALL MESSAGE_WINDOW, "赫勒赫鲁", "也就是所谓的旅行艺人。/我们还不确定会在这国家待到什么时候，/不过这段时间请多多指教啦！"
CALL MESSAGE_WINDOW, "萝乐娜", "哦，原来是这样呀……/我在这个国家当炼金术士。我才要请你们多多指教！"
CALL MESSAGE_WINDOW, "萝乐娜", "是说，糟了！/我正在帮师傅跑腿呢。/那个，我之后会再来看人偶剧的～！"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "赫勒赫鲁", "怎么回事啊～这小女孩还真忙。"
CALL MESSAGE_WINDOW, "阿蓝妮亚", "但还真是个好女孩呢。/而里欧涅菈却什么话都不讲……"
CALL MESSAGE_WINDOW, "里欧涅菈", "对不起……"
CALL MESSAGE_WINDOW, "赫勒赫鲁", "好了好了，晚点再训话吧。/总之钱也拿回来了，先回旅馆吧。"
CALL MESSAGE_WINDOW, "阿蓝妮亚", "是呀。/这下里欧涅菈终于能吃饭了。"
CALL MESSAGE_WINDOW, "里欧涅菈", "嗯，嗯……"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "阿蓝妮亚", "话说那女孩，/完全不怕我们呢……"
CALL MESSAGE_WINDOW, "赫勒赫鲁", "对啊，那女孩还挺有胆识的。/虽然也有可能是天生少根筋。"
CALL MESSAGE_WINDOW, "阿蓝妮亚", "不过，这该不会就是……"
CALL MESSAGE_WINDOW, "赫勒赫鲁", "有可能。/但还是别过度期待比较好吧。"

CALL SET_EVENTFLAG, "会说话的人偶！", "达成"
RETURN 1

@EVENT_NOTE_26
RESULTS = 原来那个演人偶剧的女孩叫里欧涅菈，/她还有两个会说话的人偶！/下次再去看人偶剧吧！

@EVENT_HEADER_26
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-工匠大道～工房前～-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE