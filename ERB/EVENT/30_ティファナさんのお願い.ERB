@EVENT_NAME_30
RESULTS = ティファナさんのお願い

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_30
#LOCALSIZE 3
SIF GET_EVENT_ATTAIN("ティファナさんのお願い")
	RETURN 0
SIF FLAG:現地点 != GET_NO("場所", "アーランド")
	RETURN 0
SIF FLAG:ショップコマンド == GET_NO("ショップ", "探索")
	RETURN 0
SIF FLAG:ギルドランク < 3
	RETURN 0
;調合レベル15が必要
SIF GET_MIXLV() < 15
	RETURN 0
;ティファナとの面識が必要
SIF !CFLAG:GET_CNUM("ティファナ"):面識 
	RETURN 0
RETURN 1

@EVENT_ACT_30
#LOCALSIZE 2
CALL SHOW_SITUATION, "ロロナのアトリエ"
CALL MESSAGE_WINDOW, "声", "ごめんなさい。ロロナちゃんはいるかしら？"
CALL MESSAGE_WINDOW, "ロロナ", "はーい。どうぞはいってくださいー"
CALL MESSAGE_WINDOW, "", "ロロナがそう言うと、扉をあけ、ティファナが入ってきた…"
CALL MESSAGE_WINDOW, "ロロナ", "こんにちは、ティファナさん"
CALL MESSAGE_WINDOW, "ティファナ", "こんにちは、ロロナちゃん。/今日は一つお願いがあってきたんだけどいいかしら？"
CALL MESSAGE_WINDOW, "ロロナ", "お願い？ なんですか？"
CALL MESSAGE_WINDOW, "ティファナ", "あのね、ロロナちゃんが作ったものを、/私のお店でも売らせてほしいの。/お薬とか、道具とか"
CALL MESSAGE_WINDOW, "ロロナ", "わたしの作ったものを？"
CALL MESSAGE_WINDOW, "ティファナ", "私のお店、あんまり品物が/代わり映えしないから、/以前からなんとかしなきゃって思ってて…"
CALL MESSAGE_WINDOW, "ティファナ", "それに、街の人達がロロナちゃんの作った/道具を手にする機会が増えれば、/ロロナちゃんにも宣伝になると思うし"
CALL MESSAGE_WINDOW, "ロロナ", "なるほど…って、/もしかしてティファナさん、わたしの為に？"
CALL MESSAGE_WINDOW, "ティファナ", "ううん、そんなことないわ。/私だって商売だもの。ちゃーんと、/自分の得になるように考えてるわよ"
CALL MESSAGE_WINDOW, "ロロナ", "…分かりました。そういうことならぜひ！"

CALL SHOW_HELP, "量販店"

CALL SET_EVENTFLAG, "ティファナさんのお願い", "達成"

@EVENT_NOTE_30
RESULTS = ティファナさんに作ったものを置いてもらうようお願いされた。/なにか売れるものをもっていってあげよう。

@EVENT_HEADER_30
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-ロロナのアトリエ-%"",20%所持金:{MONEY:0, 9}コール", ""
PRINTL 
DRAWLINE
