@EVENT_NAME_30
RESULTS = 蒂华娜的请求

;EVEMTSHOP冒頭での呼び出し条件
@EVENT_ABLE_30
#LOCALSIZE 3
SIF GET_EVENT_ATTAIN("蒂华娜的请求")
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
SIF FLAG:SHOP指令 == GET_NO("SHOP", "探索")
	RETURN 0
SIF FLAG:公会等阶 < 3
	RETURN 0
;调合等级15が必要
SIF GET_MIXLV() < 15
	RETURN 0
;ティファナとの认识が必要
SIF !CFLAG:GET_CNUM("蒂华娜"):认识 
	RETURN 0
RETURN 1

@EVENT_ACT_30
#LOCALSIZE 2
CALL SHOW_SITUATION, "萝乐娜的工房"
CALL MESSAGE_WINDOW, "声音", "打扰了。萝乐娜在吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "来啦。请进吧——"
CALL MESSAGE_WINDOW, "", "萝乐娜说完后打开门，蒂华娜走了进来……"
CALL MESSAGE_WINDOW, "萝乐娜", "你好，蒂华娜夫人。"
CALL MESSAGE_WINDOW, "蒂华娜", "你好，萝乐娜。/今天有件事想拜托你，可以吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "拜托？是什么事呢？"
CALL MESSAGE_WINDOW, "蒂华娜", "那个呀，我希望你能让我在店里，/出售你制作的东西。/比如药水呀、道具之类的。"
CALL MESSAGE_WINDOW, "萝乐娜", "我做的那些东西？"
CALL MESSAGE_WINDOW, "蒂华娜", "我店里的商品种类/一直没什么变化，/之前就在想要怎么改进……"
CALL MESSAGE_WINDOW, "蒂华娜", "而且，如果镇上的人有更多机会/用到萝乐娜制作的道具，/对你来说也是一种宣传吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "原来如此……不过，/难道蒂华娜小姐是在为我着想？"
CALL MESSAGE_WINDOW, "蒂华娜", "没那回事哦。/我也是在做生意呀。/当然要优先考虑自己的利益啦。"
CALL MESSAGE_WINDOW, "萝乐娜", "……明白了。这样的话，请务必合作！"

CALL SHOW_HELP, "量贩店"

CALL SET_EVENTFLAG, "蒂华娜的请求", "达成"

@EVENT_NOTE_30
RESULTS = 蒂华娜请求将制作的东西放在她的店里售卖。/带些能卖的东西去给她吧。

@EVENT_HEADER_30
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE
