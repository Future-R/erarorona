@EVENT_NAME_34
RESULTS = 演奏的男子

@EVENT_ABLE_34
#LOCALSIZE 3
; 只能在这三个地点触发
SIF !GROUPMATCH(GET_NAME("地点", FLAG:当前地点), "海胆森林", "附近的森林", "遗迹附近的森林")
	RETURN 0
; 第2年1月1日后才能触发
SIF CONVERT_DAY(2, 1, 1) > DAY
	RETURN 0
RETURN 1

@EVENT_REPLAY_34
SIF GET_EVENT_ATTAIN("演奏的男子")
	RETURN 1
RETURN 0

@EVENT_ACT_34
#LOCALSIZE 2
CALL SHOW_SITUATION, "野外"
; 这里通过控制音量为30%来营造声音较远的效果
SETBGMVOLUME GLOBAL:音量 * 30 / 100
CALL BGM, "亚兰德的舞娘～Solo～.mp3"
CALL 淡入横向移动, "萝乐娜_讶异", 1, "", "………………", 900, 1800
CALL MESSAGE_WINDOW, "萝乐娜", "……嗯？怎么有人在演奏曲子呀？"
CALL MESSAGE_WINDOW, "萝乐娜", "还是在这种森林中……/是从另一边传来的吗？"
; 音量60%，表示靠近了一些
SETBGMVOLUME GLOBAL:音量 * 60 / 100
CALL 清除肖像, 1
CALL MESSAGE_WINDOW, "", "………………/…………/……"
; 恢复了音量
SETBGMVOLUME GLOBAL:音量
CALL 更新背景, "坦特里斯初登场"
CALL MESSAGE_WINDOW, "萝乐娜", "就是那个人在弹奏曲子吗……/音色好美……"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯，哼哼哼～"
CALL MESSAGE_WINDOW, "萝乐娜", "啦啦啦～"
CALL MESSAGE_WINDOW, "萝乐娜", "啊！"
CALL MESSAGE_WINDOW, "", "萝乐娜踩到树枝，发出了声音……"
CALL 更新背景, "野外"
; 注意这里连续设置两次肖像，所以建议在镜像之后再补充一个立即刷新=0，对性能不好的电脑友好一些
CALL 设置肖像, "坦特里斯_特殊1", 2, 3600, 0, 0, 0
CALL 设置肖像, "萝乐娜_惊", 1
; 停止音乐，令人尴尬的沉默
STOPBGM
CALL PLAY_SE, "SE_鸟飞.mp3"
CALL MESSAGE_WINDOW, "动物们", "（惊吓！！四处逃窜……）"
CALL 设置肖像, "坦特里斯_认真", 2, 3100, 0, 1
CALL MESSAGE_WINDOW, "演奏的男子", "嗯？"
CALL 设置肖像, "坦特里斯_无语", 2, 3600
CALL MESSAGE_WINDOW, "演奏的男子", "听众都跑掉了呢。"
CALL 设置肖像, "萝乐娜_泣", 1
CALL MESSAGE_WINDOW, "萝乐娜", "那，那那那那个，真对不起！/我不是有意要打扰的！"
; 恢复了音量，响起一阵骚包的音乐
CALL BGM, "吟游诗人如是说.mp3"
SETBGMVOLUME GLOBAL:音量
CALL 设置肖像, "坦特里斯_通常", 2, 3000, 0, 1
CALL MESSAGE_WINDOW, "演奏的男子", "哦？瞧我遇见了谁……"
; 这里用了【重复使用】的指令，可以让同一个对话框中间插入一些别的行为
CALL MESSAGE_WINDOW, "演奏的男子", "你别在意。/我演奏音乐不是为了动物。"
CALL 设置肖像, "坦特里斯_笑", 2, 3000, 0, 1
CALL MESSAGE_WINDOW, "演奏的男子", "而是献给像你一样，/可爱又楚楚可怜的少女听的……", "/", "重复使用/使用按钮"
CALL 设置肖像, "萝乐娜_苦恼", 1
CALL MESSAGE_WINDOW, "萝乐娜", "诶……咦？可，可爱！？/是，是在说我吗！？"
; 目前我实现了InQuad、InOutQuad、InOutBack三种曲线，网上可以搜到这些曲线的效果
; era的性能还是有点糟糕，间隔毫秒在20以下几乎就不生效了，导致无法做快速移动的演出
CALL 横向移动, "坦特里斯_笑", 2, "演奏的男子", "当然。", 3000, 2400, 1, "InOutQuad", 16, 10
CALL MESSAGE_WINDOW, "演奏的男子", "难道你没发现吗？/你自己是多有魅力……", "/", "重复使用/使用按钮"
CALL MESSAGE_WINDOW, "萝乐娜", "啊！没那回事！/我只不过是个小不点而已！"
CALL 横向移动, "坦特里斯_笑", 2, "演奏的男子", "啊啊，别低下头。", 2400, 1800, 1, "InOutQuad", 16, 10
CALL MESSAGE_WINDOW, "演奏的男子", "我还想多看看你的脸。", "/", "重复使用/使用按钮"
CALL 设置肖像, "萝乐娜_悲", 1
CALL MESSAGE_WINDOW, "萝乐娜", "唔，唔……唔～～～～～～！！！"
CALL MESSAGE_WINDOW, "演奏的男子", "（这女孩的反应真有趣……）"
CALL 设置肖像, "萝乐娜_苦恼", 1
CALL 横向移动, "坦特里斯_笑", 2, "萝乐娜", "我，我我我，我！", 1800, 3000, 1, "InOutBack", 16, 1
CALL MESSAGE_WINDOW, "萝乐娜", "我还有工作要忙，先失陪了！！"
CALL 设置肖像, "坦特里斯_惊", 2, 3000, 0, 1
CALL MESSAGE_WINDOW, "演奏的男子", "啊，等等，我有事想问。"
CALL 设置肖像, "坦特里斯_认真", 2, 3000, 0, 1
CALL MESSAGE_WINDOW, "演奏的男子", "你一个女孩子出现在这种地方，/代表这里离亚兰德的城镇很近咯？"
CALL 设置肖像, "萝乐娜_讶异", 1
CALL MESSAGE_WINDOW, "萝乐娜", "咦？是，是的。/只要往那个方向一直走，很快就到了……"
CALL 设置肖像, "坦特里斯_笑", 2, 3000, 0, 1
CALL MESSAGE_WINDOW, "演奏的男子", "这样啊，谢谢你。我小时候住在亚兰德，/但太久没回来，都忘了路怎么走。"
CALL MESSAGE_WINDOW, "演奏的男子", "你就住在亚兰德吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "是的。/我在城镇内经营炼金工房。/然后，呃……"
CALL 设置肖像, "坦特里斯_通常", 2, 3000, 0, 1
CALL MESSAGE_WINDOW, "演奏的男子", "希望还能再见到你。/由衷期待命运会引导我们重逢，/可爱的小姐。"
CALL 设置肖像, "萝乐娜_悲", 1
CALL MESSAGE_WINDOW, "萝乐娜", "哇！？/又，又说我可爱了！！"
; 萝乐娜跑掉了，这里先加一个淡出位移表示退场，然后再清除
CALL 淡出横向移动, "萝乐娜_悲", 1, "", "……", 100, -500
CALL 清除肖像, 1
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL 清除肖像, 2
CALL 设置肖像, "萝乐娜_悲", 1, 1700, 0, 1
CALL MESSAGE_WINDOW, "萝乐娜", "……呜～真，真是害羞……/那人好怪哦。/居然说我很，很可爱……"
CALL 设置肖像, "萝乐娜_害羞", 1, 1700, 0, 1
CALL MESSAGE_WINDOW, "萝乐娜", "……诶嘿嘿。/不过感觉也是有点开心啦……"
CALL 设置肖像, "萝乐娜_认真", 1, 1800
CALL MESSAGE_WINDOW, "萝乐娜", "啊，不行不行！/我也得回去工作了！"

CALL SET_EVENTFLAG, "演奏的男子", "达成"
RETURN 1

@EVENT_NOTE_34
RESULTS = 在森林里遇到了个怪人，居然说我可爱什么的……/也不知道那个人有没有顺利抵达城镇……

@EVENT_HEADER_34
DRAWLINE
PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-%GET_NAME("地点", FLAG:当前地点)%-%"",20%资金:{MONEY:0, 9}克尔", ""
PRINTL 
DRAWLINE