@EVENT_NAME_40
RESULTS = 吉欧的委托

; 这个事件只在离开暗之公会时手动触发，不参与通常的自动检索
@EVENT_ABLE_40
RETURN 0

@EVENT_REPLAY_40
SIF GET_EVENT_ATTAIN("吉欧的委托")
	RETURN 1
RETURN 0

@EVENT_ACT_40
#DIM 吉欧编号

吉欧编号 = GET_CNUM("吉欧")
CALL SHOW_SITUATION, "暗之公会"
CALL BGM, "恶魔的探戈.mp3"
FLAG:事件内的分歧 = 0
CALL MESSAGE_WINDOW, "公会成员", "哎呀，稍等一下，差点忘了。/这里有一份指定委托给你的工作。"
CALL MESSAGE_WINDOW, "萝乐娜", "咦？指定委托给我？"
CALL MESSAGE_WINDOW, "公会成员", "没错。据说是希望你能帮忙取得猛禽之石。"
CALL MESSAGE_WINDOW, "萝乐娜", "猛禽之石？/我没听过呢……那是什么东西啊？"
CALL MESSAGE_WINDOW, "公会成员", "其实我也不知道那是什么……/如果连身为炼金术士的你都没听过，那或许是相当特别的东西。"
CALL MESSAGE_WINDOW, "萝乐娜", "嗯……总之我先调查看看。/说不定师傅会知道些什么。"
CALL MESSAGE_WINDOW, "公会成员", "委托没有特别设定期限，但希望能尽早达成。/虽然可能有点突然，但还是期待你的表现。"

CALL SHOW_SITUATION, "萝乐娜的工房"
CALL BGM, "相遇是炼金术.mp3"
FLAG:事件内的分歧 = 1
CALL MESSAGE_WINDOW, "萝乐娜", "嗯～书上都没写……伤脑筋。/偏偏师傅现在又不在……"
CALL PLAY_SE, "SE_敲门.mp3"
CALL MESSAGE_WINDOW, "", "传来了敲门声……"
CALL PLAY_SE, "SE_开门.mp3"
CALL MESSAGE_WINDOW, "吉欧", "打扰了……哎呀，我来得不巧吗？"
CALLF STOP_BGM()
CALL MESSAGE_WINDOW, "萝乐娜", "啊，欢迎光临。有工作要委托吗？"
CALL BGM, "亚兰德之王.mp3"
CALL MESSAGE_WINDOW, "吉欧", "我的确是有事要委托……/但你好像在忙。"
CALL MESSAGE_WINDOW, "萝乐娜", "是的。那个，其实……"
CALL MESSAGE_WINDOW, "吉欧", "怎么了吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "呃……其实这次有人提出委托……/希望我去采集一样东西回来，但那东西我既没看过也没听过……"
CALL MESSAGE_WINDOW, "吉欧", "连炼金术士都不知道，想必是相当罕见的材料。"
CALL MESSAGE_WINDOW, "萝乐娜", "其实我不认识的材料本来就挺多的啦……"
CALL MESSAGE_WINDOW, "萝乐娜", "对了，那个东西叫猛禽之石。/吉欧听说过吗？"
CALL MESSAGE_WINDOW, "吉欧", "猛禽之石？/……原来如此，的确很像“那个人”的作风。"
CALL MESSAGE_WINDOW, "萝乐娜", "吉欧？"
CALL MESSAGE_WINDOW, "吉欧", "啊～没什么，我在想自己的事。嗯……"
CALL MESSAGE_WINDOW, "吉欧", "来谈谈别的好了，我还是很想委托你工作呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "好的，没问题，这样正好能转换心情。"
CALL MESSAGE_WINDOW, "吉欧", "好，那我们出发吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "咦？你说出发，是要去哪里？/不是要委托我制作东西吗？"
CALL MESSAGE_WINDOW, "吉欧", "不是。这次我是想委托你保护我。"
CALL MESSAGE_WINDOW, "萝乐娜", "保护？可，可是我又不擅长战斗……"
CALL MESSAGE_WINDOW, "吉欧", "时间不等人。好了，快出发吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "哎哎哎！别那么用力拉我呀……"

CALL SHOW_SITUATION, "城门前"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL SHOW_SITUATION, "野外"
FLAG:事件内的分歧 = 2
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "萝乐娜", "等，等，等一下……/到，到底要去哪里呀～！？"
CALL MESSAGE_WINDOW, "吉欧", "别在那边哀嚎了。就快到了。"
CALL MESSAGE_WINDOW, "萝乐娜", "呼，哈……真是太过分了。/什么都不说，就把人家带来这……"
CALL MESSAGE_WINDOW, "吉欧", "别抱怨。/就把这当成工作的一环，放弃挣扎吧。"
CALL MESSAGE_WINDOW, "萝乐娜", "……因为你一开始没说工作内容是保护你啊。"
CALL MESSAGE_WINDOW, "吉欧", "那你要自己一个人从这边回去吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "呜……我知道了……"
CALL MESSAGE_WINDOW, "吉欧", "别露出那种表情。/这做法是有点强硬，我道歉，还请见谅。"
CALL MESSAGE_WINDOW, "吉欧", "但比起从头说明，我想亲自带你过来比较快。"
CALL MESSAGE_WINDOW, "萝乐娜", "那请你再说明一下我该做些什么……"
CALL MESSAGE_WINDOW, "吉欧", "嘘，闲聊就到此为止。/也尽量别制造任何声响，如果不小心让对方起戒心就麻烦了。"
CALL MESSAGE_WINDOW, "萝乐娜", "……我到底会遇上什么事呢……"
CALL MESSAGE_WINDOW, "", "………………/…………/……"
CALL MESSAGE_WINDOW, "吉欧", "有了，就是那个。"
CALL MESSAGE_WINDOW, "萝乐娜", "咦？哪里呀……/哇啊！？那，那是什么呀！"
CALL BGM, "急转直下.mp3"
CALL MESSAGE_WINDOW, "", "萝乐娜看见了一头体型巨大、/有着鹰的前半身和狮子后半身的怪鸟。"
CALL MESSAGE_WINDOW, "吉欧", "应该算是这一带怪鸟的首领，而且心情似乎非常好。/那么，拜托你了。"
CALL MESSAGE_WINDOW, "萝乐娜", "拜托我？难不成！？"
CALL MESSAGE_WINDOW, "吉欧", "就是那么一回事。好了，快上吧！"
CALL MESSAGE_WINDOW, "萝乐娜", "不，不行不行！绝对不行啦……/呀啊啊！别，别推我啊啊啊！！"
CALL MESSAGE_WINDOW, "怪鸟", "咕吼吼吼吼～！！"
CALL MESSAGE_WINDOW, "萝乐娜", "呀啊啊啊啊啊……"
CALL MESSAGE_WINDOW, "怪鸟", "咕吼吼吼吼～！！"
CALL MESSAGE_WINDOW, "吉欧", "你完全被压着打呢。/能被打得这么惨，反而让人觉得神清气爽。"
CALL MESSAGE_WINDOW, "萝乐娜", "就，就算你这样称赞，我也不会开心啦……"
CALL MESSAGE_WINDOW, "怪鸟", "咕吼？咕吼吼吼吼吼！！"
CALL MESSAGE_WINDOW, "吉欧", "对方好像还想打，你站得起来吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "对不起……我好像不行了……"
CALL MESSAGE_WINDOW, "吉欧", "那就没办法了。/虽然失礼，但就由我代劳吧……"

CALL 更新背景, "吉欧斩狮鹫"
FLAG:事件内的分歧 = 3
CALL MESSAGE_WINDOW, "吉欧", "哼！"
CALL PLAY_SE, "SE_剑击.mp3"
CALL MESSAGE_WINDOW, "萝乐娜", "咦……？"
CALL MESSAGE_WINDOW, "怪鸟", "咕啊？"
CALL MESSAGE_WINDOW, "吉欧", "我与你无怨无仇，原谅我吧。"
CALL MESSAGE_WINDOW, "怪鸟", "咕……咕……咕啊啊啊啊啊！"
CALL MESSAGE_WINDOW, "萝乐娜", "咦？咦……？刚刚那是……？/根本没看清楚……"
CALL MESSAGE_WINDOW, "吉欧", "怎么了？为何在发呆？"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，对，对不起。/我实在不清楚刚刚发生了什么事……"
CALL MESSAGE_WINDOW, "萝乐娜", "刚刚吉欧只不过哼了一声，/怪鸟就惨叫倒地了……"
CALL MESSAGE_WINDOW, "吉欧", "嗯，差不多就是这样。"
CALL MESSAGE_WINDOW, "萝乐娜", "可，可是刚刚那只怪鸟非常厉害呀！"
CALL MESSAGE_WINDOW, "萝乐娜", "……不过也可能是因为我太弱啦。"
CALL MESSAGE_WINDOW, "吉欧", "没什么了不起的。/只要从出生就开始挥剑，那点把戏谁都能办到。"
CALL MESSAGE_WINDOW, "吉欧", "好了，你在找的东西是这个吗？"
CALL MESSAGE_WINDOW, "萝乐娜", "咦？这是什么？"
CALL MESSAGE_WINDOW, "吉欧", "这就是猛禽之石。/作为打败那头怪鸟的证明，在习武之人中相当有名。"
CALL MESSAGE_WINDOW, "吉欧", "虽然对炼金术来说可能毫无价值就是了。"
CALL MESSAGE_WINDOW, "萝乐娜", "请问，这个东西……/我真的可以收下吗？"
CALL MESSAGE_WINDOW, "吉欧", "不必客气。/就当作是你今天陪我出来的报酬。"
CALL MESSAGE_WINDOW, "萝乐娜", "你说报酬，可是我根本……"
CALL MESSAGE_WINDOW, "吉欧", "那我们回去吧。/长时间带着年轻女孩在外头跑来跑去，可不是件好事呢。"
CALL MESSAGE_WINDOW, "萝乐娜", "啊，请等一下！"
CALL MESSAGE_WINDOW, "", "收下了猛禽之石。"

CALL SHOW_SITUATION, "城门前"
FLAG:事件内的分歧 = 4
CALL BGM, "亚兰德之王.mp3"
CALL MESSAGE_WINDOW, "吉欧", "今天真是多谢了。容我再次向你道谢。"
CALL MESSAGE_WINDOW, "萝乐娜", "………………"
CALL MESSAGE_WINDOW, "吉欧", "……你还在生气吗？/对于硬把你带出去的事，我方才已经道过歉了……"
CALL MESSAGE_WINDOW, "萝乐娜", "不是！我不是在生气啦！"
CALL MESSAGE_WINDOW, "萝乐娜", "……我明明什么也没做，却还收到报酬……"
CALL MESSAGE_WINDOW, "吉欧", "我委托你工作，支付报酬是理所当然的。"
CALL MESSAGE_WINDOW, "萝乐娜", "可是，我一点忙都没帮上呀……"
CALL MESSAGE_WINDOW, "吉欧", "唔……就是为了不让你有负担，才用了委托的形式，没想到居然造成反效果。/那么，你换个想法如何？"
CALL MESSAGE_WINDOW, "吉欧", "虽然打输了，但你的确勇敢地挺身战斗。/为了嘉奖你的勇气，所以给你这份奖品。"
CALL MESSAGE_WINDOW, "萝乐娜", "……感觉还是不太能接受。"
CALL MESSAGE_WINDOW, "吉欧", "没想到你的脾气跟外表不同，还挺顽固的。/真伤脑筋，那该如何是好……"
CALL MESSAGE_WINDOW, "吉欧", "对了，那下次你雇用我就行了。"
CALL MESSAGE_WINDOW, "萝乐娜", "雇用吉欧？"
CALL MESSAGE_WINDOW, "吉欧", "没错，想必你刚刚也看到了，/我的功夫应该能帮上一定程度的忙。/还是说那点功夫不足以让你满意？"
CALL MESSAGE_WINDOW, "萝乐娜", "怎么会呢！/吉欧这么厉害的人愿意帮忙，我也觉得非常感谢……"
CALL MESSAGE_WINDOW, "吉欧", "那么，我俩就互不相欠了。/如果某一方觉得有所亏欠的话，就无法建立起友好的人际关系。"
CALL MESSAGE_WINDOW, "萝乐娜", "……好的，非常谢谢。"
CALL MESSAGE_WINDOW, "吉欧", "呵呵，你总算笑了。/那么，我会期待你的邀请的。"
CALL MESSAGE_WINDOW, "", "………………/…………/……"

SIF FLAG:回想模式
	RETURN 1
CALL SOLO, "是朋友.mp3"

CALL MESSAGE_WINDOW, "", "可以委托吉欧采集了。"
CALL MESSAGE_WINDOW, "", "交付了猛禽之石，获得600公会点数。"

FLAG:公会点数 += 600

CFLAG:吉欧编号:可以委托采集 = 1
IF !STRCOUNT("/" + CSTR:吉欧编号:拥有技能 + "/", "/王之剑/")
	IF CSTR:吉欧编号:拥有技能 == ""
		CSTR:吉欧编号:拥有技能 = 王之剑
	ELSE
		CSTR:吉欧编号:拥有技能 '= CSTR:吉欧编号:拥有技能 + "/王之剑"
	ENDIF
ENDIF
CALL SET_EVENTFLAG, "吉欧的委托", "达成"
RETURN 1

@EVENT_NOTE_40
RESULTS = 吉欧用近乎胡来的方式把我带到野外，/最后却帮我拿到了猛禽之石。/而且今后还可以委托吉欧帮忙采集材料了。

@EVENT_HEADER_40
DRAWLINE
SELECTCASE FLAG:事件内的分歧
	CASE 0
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-暗之公会-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 1
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 2, 3
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-野外-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASE 4
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-城门前-%"",20%资金:{MONEY:0, 9}克尔", ""
	CASEELSE
		PRINTBUTTON @"　%SHOW_DAY()%%"", 10%-%GET_NAME("地点", FLAG:当前地点)%-%"",20%资金:{MONEY:0, 9}克尔", ""
ENDSELECT
PRINTL
DRAWLINE
