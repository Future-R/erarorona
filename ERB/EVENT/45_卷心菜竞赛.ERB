	CASE 4
		CALLF STOP_BGM()
		CALL MESSAGE_WINDOW, "里欧涅菈", "啊……萝乐娜？"
		CALL BGM,"杂技少女.mp3"
		CALL MESSAGE_WINDOW, "萝乐娜", "啊，里欧。"
		CALL MESSAGE_WINDOW, "里欧涅菈", "你好啊……奇怪？/你看起来好像很累呀，还好吗？"
