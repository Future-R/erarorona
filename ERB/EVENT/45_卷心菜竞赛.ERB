@发放守护神之瞳
#DIM 奖励物品编号
#DIM 奖励物品槽位

奖励物品编号 = GET_NO("物品", "守护神之瞳")
CALL CLEAR_TEMPITEM
奖励物品槽位 = GET_TEMP_ITEM_SLOT()
CALL SET_KNOWN_ITEM, "守护神之瞳", "获得"
CALL SET_KNOWN_ITEM, "守护神之瞳", "主效果00"
CALL SET_KNOWN_ITEM, "守护神之瞳", "主效果01"
CALL SET_KNOWN_ITEM, "守护神之瞳", "主效果02"
CALL SET_ITEMDATA, 奖励物品槽位, "ID", 奖励物品编号
CALL SET_ITEMDATA, 奖励物品槽位, "品质", 100
CALL SET_ITEMDATA, 奖励物品槽位, "主效果0", GET_NO("主效果", "观察力")
CALL SET_ITEMDATA, 奖励物品槽位, "主效果1", GET_NO("主效果", "不起眼")
CALL SET_ITEMDATA, 奖励物品槽位, "主效果2", GET_NO("主效果", "暴击：中")
CALL SET_CATEGORY, 奖励物品槽位
CALL SET_QUALITY, 奖励物品槽位
CALL SET_PRICE, 奖励物品槽位
CALLFORM ITEM_LV_{奖励物品编号}
CALL SET_ITEMDATA, 奖励物品槽位, "等级", RESULT
CALL SET_REVICE, 奖励物品槽位
CALL MESSAGE_WINDOW, "", "获得了【守护神之瞳】。"
CALL SHOW_ITEMLIST, "获得物品", "临时"
RETURN 0

