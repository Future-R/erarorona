;イベント開始関数
@START_EVENT
#LOCALSIZE 1
FOR LOCAL, 0, イベント数
	;達成済みイベント
	SIF GET_EVENT_ATTAIN(LOCAL)
		CONTINUE
	;一日に開始するイベントは1個のみ
	SIF !GET_EVENT_PLAY(LOCAL) && FLAG:イベント発生済み == DAY
		CONTINUE
	TRYCCALLFORM EVENT_ABLE_{LOCAL}
		IF RESULT
			FLAG:イベント発生済み = DAY
			CALL EVENT_ACT, LOCAL
			RETURN RESULT
		ENDIF
	CATCH
	ENDCATCH
NEXT
RETURN 0

;イベントが達成済みかどうか
@GET_EVENT_ATTAIN, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF EVENT:TOINT(ARGS) > 1 ? EVENT:TOINT(ARGS) # 0
ELSE
	RETURNF EVENT:GET_NO("イベント", ARGS) > 1 ? EVENT:GET_NO("イベント", ARGS) # 0
ENDIF
;イベントが進行中かどうか
@GET_EVENT_PLAY, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF EVENT:TOINT(ARGS) == 1
ELSE
	RETURNF EVENT:GET_NO("イベント", ARGS) == 1
ENDIF

@GET_EVENT_STATE, ARGS
#FUNCTIONS
IF ISNUMERIC(ARGS)
	RETURNF EVENTS:TOINT(ARGS)
ELSE
	RETURNF EVENTS:GET_NO("イベント", ARGS)
ENDIF

@SET_EVENTFLAG, ARGS, ARGS:1, ARGS:2
#LOCALSIZE 1
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("イベント", ARGS)
ENDIF
SELECTCASE ARGS:1
	CASE "達成"
		EVENT:LOCAL = DAY
	CASE "開始"
		EVENT:LOCAL = 1
	CASE "状態"
		EVENTS:LOCAL = %ARGS:2%
	CASE "状態追加"
		SIF EVENTS:LOCAL != ""
			EVENTS:LOCAL += "/"
		EVENTS:LOCAL += ARGS:2
	CASEELSE
		THROW ARGS(%ARGS%)が異常です
ENDSELECT

;イベントの呼び出し
@EVENT_ACT, ARGS
#LOCALSIZE 1
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_NO("イベント", ARGS)
FLAG:進行中イベント = LOCAL
FLAG:イベント内分岐 = 0
CALLFORM EVENT_ACT_{LOCAL}
FLAG:進行中イベント = -1
RETURN RESULT

;イベントの呼び出し
@EVENT_HEADER, ARGS
#LOCALSIZE 1
LOCAL = LINECOUNT
CALLFORM EVENT_HEADER_{FLAG:進行中イベント}
WHILE LINECOUNT < LOCAL + MAXLINE() - 6
	PRINTBUTTON " " * 120, ""
	PRINTL  
WEND
