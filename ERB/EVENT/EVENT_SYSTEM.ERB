;事件開始関数
@START_EVENT
#LOCALSIZE 1
FOR LOCAL, 0, 事件数
	;达成済み事件
	SIF GET_EVENT_ATTAIN(LOCAL)
		CONTINUE
	;一日に開始する事件は1個のみ
	SIF !GET_EVENT_PLAY(LOCAL) && FLAG:事件已发生 == DAY
		CONTINUE
	TRYCCALLFORM EVENT_ABLE_{LOCAL}
		IF RESULT
			FLAG:事件已发生 = DAY
			CALL EVENT_ACT, LOCAL
			RETURN RESULT
		ENDIF
	CATCH
	ENDCATCH
NEXT
RETURN 0

;事件が达成済みかどうか
@GET_EVENT_ATTAIN, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF EVENT:TOINT(ARGS) > 1 ? EVENT:TOINT(ARGS) # 0
ELSE
	RETURNF EVENT:GET_NO("事件", ARGS) > 1 ? EVENT:GET_NO("事件", ARGS) # 0
ENDIF
;事件が進行中かどうか
@GET_EVENT_PLAY, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF EVENT:TOINT(ARGS) == 1
ELSE
	RETURNF EVENT:GET_NO("事件", ARGS) == 1
ENDIF

@GET_EVENT_STATE, ARGS
#FUNCTIONS
IF ISNUMERIC(ARGS)
	RETURNF EVENTS:TOINT(ARGS)
ELSE
	RETURNF EVENTS:GET_NO("事件", ARGS)
ENDIF

@SET_EVENTFLAG, ARGS, ARGS:1, ARGS:2
#LOCALSIZE 1
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("事件", ARGS)
ENDIF
SELECTCASE ARGS:1
	CASE "达成"
		EVENT:LOCAL = DAY
	CASE "开始"
		EVENT:LOCAL = 1
	CASE "状态"
		EVENTS:LOCAL = %ARGS:2%
	CASE "状态追加"
		SIF EVENTS:LOCAL != ""
			EVENTS:LOCAL += "/"
		EVENTS:LOCAL += ARGS:2
	CASEELSE
		THROW ARGS(%ARGS%)异常
ENDSELECT

;事件の呼び出し
@EVENT_ACT, ARGS
#LOCALSIZE 1
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_NO("事件", ARGS)
FLAG:进行中的事件 = LOCAL
FLAG:事件内的分歧 = 0
CALLFORM EVENT_ACT_{LOCAL}
FLAG:进行中的事件 = -1
RETURN RESULT

;事件の呼び出し
@EVENT_HEADER, ARGS
#LOCALSIZE 1
LOCAL = LINECOUNT
CALLFORM EVENT_HEADER_{FLAG:进行中的事件}
WHILE LINECOUNT < LOCAL + MAXLINE() - 6
	PRINTBUTTON " " * 120, ""
	PRINTL  
WEND
