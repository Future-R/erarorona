; 检查事件触发
; ARG 是否是炼金事件，不是的话就是0
@START_EVENT, ARG = 0
#LOCALSIZE 1
#DIM 原REDRAW
原REDRAW = CURRENTREDRAW()
REDRAW 0
; 因为炼金事件必须立即有反馈，所以炼金事件的触发和其他事件不走同一套流程，也不会占用每天的事件触发
IF ARG
	FOR LOCAL, 通常事件数, 通常事件数 + 炼金事件数
		; 跳过已经完成的事件
		SIF GET_EVENT_ATTAIN(LOCAL)
			CONTINUE
		TRYCCALLFORM MIXEVENT_ABLE_{LOCAL}
			IF RESULT
				CALL EVENT_ACT, LOCAL
				RETURN RESULT
			ENDIF
		CATCH
		ENDCATCH
	NEXT
ELSE ; 非炼金事件
	FOR LOCAL, 0, 通常事件数
		; 跳过已经完成的事件
		SIF GET_EVENT_ATTAIN(LOCAL)
			CONTINUE
		; 每天只能触发一个新事件，但不包括炼金事件
		SIF !GET_EVENT_PLAY(LOCAL) && FLAG:事件已发生 == DAY
			CONTINUE
		TRYCCALLFORM EVENT_ABLE_{LOCAL}
			IF RESULT
				FLAG:事件已发生 = DAY
				CALL EVENT_ACT, LOCAL
				RETURN RESULT
			ENDIF
		CATCH
		ENDCATCH
	NEXT
ENDIF


REDRAW 原REDRAW
RETURN 0

; 事件完成的日期
@GET_EVENT_ATTAIN, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF EVENT:TOINT(ARGS) > 1 ? EVENT:TOINT(ARGS) # 0
ELSE
	RETURNF EVENT:GET_NO("事件", ARGS) > 1 ? EVENT:GET_NO("事件", ARGS) # 0
ENDIF
; 事件是否在进行中
@GET_EVENT_PLAY, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF EVENT:TOINT(ARGS) == 1
ELSE
	RETURNF EVENT:GET_NO("事件", ARGS) == 1
ENDIF

; 事件最后更新日期
@GET_EVENT_UPDATE, ARGS
#FUNCTION
IF GET_EVENT_ATTAIN(ARGS)
	RETURNF GET_EVENT_ATTAIN(ARGS)
ELSE
	IF ISNUMERIC(ARGS)
		RETURNF EVENT_START:TOINT(ARGS) > 1 ? EVENT_START:TOINT(ARGS) # 0
	ELSE
		RETURNF EVENT_START:GET_NO("事件", ARGS) > 1 ? EVENT_START:GET_NO("事件", ARGS) # 0
	ENDIF
ENDIF

; 获取事件状态
@GET_EVENT_STATE, ARGS
#FUNCTIONS
IF ISNUMERIC(ARGS)
	RETURNF EVENTS:TOINT(ARGS)
ELSE
	RETURNF EVENTS:GET_NO("事件", ARGS)
ENDIF
;----------------------------------------------------------------
; 设置事件状态
; CALL SET_EVENTFLAG, "事件名", "开始"
; CALL SET_EVENTFLAG, "事件名", "达成"
; CALL SET_EVENTFLAG, "事件名", "状态", "状态字符串"
; CALL SET_EVENTFLAG, "事件名", "状态追加", "状态字符串"
;----------------------------------------------------------------
@SET_EVENTFLAG, ARGS, ARGS:1, ARGS:2
#LOCALSIZE 1
SIF FLAG:回想模式
	RETURN 0
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("事件", ARGS)
ENDIF
SELECTCASE ARGS:1
	CASE "达成"
		EVENT:LOCAL = DAY
	CASE "开始"
		EVENT:LOCAL = 1
		EVENT_START:LOCAL = DAY
	CASE "状态"
		EVENTS:LOCAL = %ARGS:2%
	CASE "状态追加"
		SIF EVENTS:LOCAL != ""
			EVENTS:LOCAL += "/"
		EVENTS:LOCAL += ARGS:2
	CASEELSE
		THROW ARGS(%ARGS%)异常
ENDSELECT

; 触发事件ARGS
@EVENT_ACT, ARGS
#LOCALSIZE 1
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_NO("事件", ARGS)
FLAG:进行中的事件 = LOCAL
FLAG:事件内的分歧 = 0
CALL 清除全部肖像
CALLFORM EVENT_ACT_{LOCAL}
FLAG:进行中的事件 = -1
RETURN RESULT

; 显示标题栏
@EVENT_HEADER, ARGS
#LOCALSIZE 1
LOCAL = LINECOUNT
CALLFORM EVENT_HEADER_{FLAG:进行中的事件}
WHILE LINECOUNT < LOCAL + MAXLINE() - 6
	PRINTBUTTON " " * 120, ""
	PRINTL  
WEND

; 检查是否触发探索事件
@EXPLORE_EVENT
#LOCALSIZE 1
#DIM 当前ID
当前ID = 0
FLAG:中断后续探索事件 = 0
FOR LOCAL, 0, 探索事件数
	; 有些事件结束后会强制屏蔽后续事件
	SIF FLAG:中断后续探索事件
		RETURN 1
	; 通过优先级来确定当前事件ID
	CALL EXPLORERID_BY_ORDER, LOCAL
	IF RESULT
		当前ID = RESULT
	ELSE
		CONTINUE
	ENDIF

	; 检查事件类型是否已屏蔽
	TRYCCALLFORM EXPLORER_TAG_{当前ID}
		IF GLOBAL:非自愿色情事件 && STRCOUNT(RESULTS, "非自愿色情事件")
			CONTINUE
		ELSEIF GLOBAL:异性色情事件 && STRCOUNT(RESULTS, "异性色情事件")
			CONTINUE
		ELSEIF GLOBAL:同性色情事件 && STRCOUNT(RESULTS, "同性色情事件")
			CONTINUE
		ELSEIF GLOBAL:非人类色情事件 && STRCOUNT(RESULTS, "非人类色情事件")
			CONTINUE
		ELSEIF GLOBAL:血腥猎奇事件 && STRCOUNT(RESULTS, "血腥猎奇事件")
			CONTINUE
		ELSEIF GLOBAL:屎尿猎奇事件 && STRCOUNT(RESULTS, "屎尿猎奇事件")
			CONTINUE
		ELSEIF GLOBAL:AI生成内容 && STRCOUNT(RESULTS, "AI生成内容")
			CONTINUE
		ENDIF
	CATCH
	ENDCATCH
	; 检查触发上限
	TRYCCALLFORM EXPLORER_MAX_{当前ID}
		IF RESULT == EXPLORE_EVENT:当前ID
			CONTINUE
		ENDIF
	CATCH
	ENDCATCH

	; 检查触发条件
	TRYCCALLFORM EXPLORER_CHECK_{当前ID}
		IF RESULT
			EXPLORE_EVENT:当前ID++
			CALL 清除全部肖像
			CALLFORM EXPLORER_ACT_{当前ID}
		ENDIF
	CATCH
	ENDCATCH
NEXT
RETURN 0

; 检查是否在野外
@IS_OUTDOOR, ARG
#FUNCTION
IF GROUPMATCH(GET_NAME("地点", ARG), "亚兰德") || GROUPMATCH(GET_NAME("地点", ARG), "阿拉尼亚村")
	RETURNF 0
ELSE
	RETURNF 1
ENDIF

; 检查是否在岔路口
@IS_ROADFORK
#FUNCTION
IF FLAG:当前地点 < 100
	RETURNF 0
ELSE
	RETURNF 1
ENDIF

; 遍历所有事件，找到指定优先级的事件ID，0为空
; 这样嵌套可能效率不行，但先跑起来之后有空再优化
@EXPLORERID_BY_ORDER, ARG
VARSET LOCAL
FOR LOCAL, 1, 探索事件数
	TRYCCALLFORM EXPLORER_ORDER_{LOCAL}
		SIF RESULT == ARG
			RETURN LOCAL
	CATCH
	ENDCATCH
NEXT
RETURN 0

; 检查当前地点是否产出指定素材
; ARGS 素材名  LOCAL:1 素材ID
; 返回0不产出，返回1产出
@HAVE_MATERIAL, ARGS
LOCAL:1 = GET_NO("物品", ARGS)
FOR LOCAL, 0, 10
	TRYCCALLFORM PLACE_MATERIAL_%TOSTR(FLAG:当前地点,"X2")%, LOCAL
		IF RESULT == LOCAL:1
			RETURN 1
		ENDIF
	CATCH
	ENDCATCH
NEXT
RETURN 0

; 清理临时物品
@CLEAR_TEMPITEM
#DIM 起始序号
#DIM 结束序号
起始序号 = GET_ITEM_RANGE("临时")
结束序号 = RESULT:1
FOR LOCAL, 起始序号, 结束序号
	CALL DEL_ITEMDATA, LOCAL
NEXT
CALL DISPOSE_OF_ITEM

; 计算调合类别总分 ARGS:类别名
@GET_CATEGORYSCORE, ARGS
LOCAL = 0
FOR COUNT, 调合品起始编号, 调合品结束编号
	TRYCCALLFORM ITEM_CATEGORY_{COUNT}, GET_NO("调合类别", ARGS)
		IF RESULT >= 0
		LOCAL += ITEM_HIGHESTSCORE:COUNT
		ENDIF
	CATCH
	ENDCATCH
NEXT
RETURN LOCAL