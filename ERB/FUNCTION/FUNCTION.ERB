;--------------------------------------------------
;@ADD FRIEND
;--------------------------------------------------
@ADD_FRIEND, ARGS
#LOCALSIZE 2
#DIM CHARA
IF ISNUMERIC(ARGS)
	LOCAL:1 = TOINT(ARGS)
ELSE
	LOCAL:1 = GET_NO("角色", ARGS)
ENDIF
SIF GETCHARA(LOCAL:1, 0) >= 0
	THROW %ARGS%已存在。
ADDCHARA LOCAL:1
CHARA = (CHARANUM - 1)
FOR LOCAL, 100, 200
	ABL:CHARA:LOCAL = 5
NEXT
FOR LOCAL, 0, VARSIZE("TALENT")
	SIF !TALENT:CHARA:LOCAL
		CONTINUE
	TRYCCALLFORM TALENT_NOLV_%TALENTNAME:LOCAL%
		SIF RESULT
			CONTINUE
	CATCH
	ENDCATCH
	IF GET_TALENT_COST(LOCAL, 1) >= 0
		TALENT:CHARA:LOCAL = 1
	ELSE
		TALENT:CHARA:LOCAL = 3
	ENDIF
NEXT

CFLAG:CHARA:采集地点 = -1
CFLAG:CHARA:交友值 *= 100

BASE:CHARA:体力 = GET_MAXBASE("体力", CHARA)
BASE:CHARA:气力 = GET_MAXBASE("气力", CHARA)
SORTCHARA CFLAG:0:人类, FORWARD


;--------------------------------------------------
; 增加交友值，返回原交友值和原技能值
;--------------------------------------------------
@GAIN_FRIEND_POINT, ARGS, ARG
#LOCALSIZE 4
VARSET LOCAL

LOCAL:1 = 100
SIF GET_ITEMNAME_E(GET_NO_QEQUIP("雕像"), 0) == "给人印象不好"
	LOCAL:1 -= 50
SIF GET_ITEMNAME_E(GET_NO_QEQUIP("雕像"), 0) == "给人印象很好"
	LOCAL:1 += 25
SIF GET_ITEMNAME_E(GET_NO_QEQUIP("雕像"), 0) == "给人美好的印象"
	LOCAL:1 += 50
ARG = TIMESF(ARG, LOCAL:1)
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_CNUM(ARGS)

LOCAL:2 = CFLAG:LOCAL:交友值
LOCAL:3 = CFLAG:LOCAL:技能值

CFLAG:LOCAL:交友值 = LIMIT(CFLAG:LOCAL:交友值 + ARG, 0, 10000)
CFLAG:LOCAL:技能值端数 += ARG * 2
WHILE CFLAG:LOCAL:技能值端数 >= 100
	CFLAG:LOCAL:技能值 = LIMIT(CFLAG:LOCAL:技能值 + 1, 0, 999)
	CFLAG:LOCAL:技能值端数 -= 100
WEND
RETURN LOCAL:2, LOCAL:3

@关系加深, ARGS, ARG
CALL SOLO, "是朋友.mp3", 5000
CALL MESSAGE_WINDOW, "", @"感觉和%ARGS%关系加深了……"
CALL GAIN_FRIEND_POINT, GET_CNUM(ARGS), ARG
CALL MESSAGE_WINDOW, "", @"交友值:{RESULT/100, 3}->{GET_FRIEND_POINT(GET_CNUM(ARGS)), 3}/技能值:{RESULT:1,3}->{CFLAG:GET_CNUM(ARGS):技能值,3}"


