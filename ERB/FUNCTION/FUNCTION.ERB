;-------------------------------------------------
;表示
;ボタン内容
;条件
;条件(ARG)が真の時の色
;条件(ARG:1)が否の時の色
;-------------------------------------------------
@PRINTSBUTTON_C, ARGS, ARGS:1, ARG, ARG:1 = -1, ARG:2 = -1
#LOCALSIZE 1
LOCAL = GETCOLOR()
ARG:1 = ARG:1 == -1 ? GETDEFCOLOR() # ARG:1
ARG:2 = ARG:2 == -1 ? GETDEFCOLOR() # ARG:2
SETCOLOR ARG ? ARG:1 # ARG:2
IF IS_WINDOW
	PRINTBUTTON ARGS, ""
ELSE
	PRINTBUTTON ARGS, ARGS:1
ENDIF
SETCOLOR LOCAL

;-------------------------------------------------
;加成関数@CALCF
;ARG	加成元の数值
;ARG:1	加成係数
;-------------------------------------------------
@CALCF, ARG, ARG:1
#FUNCTION
RETURNF ARG:1 >= 0 ? ARG * (100 + ARG:1) / 100 # ARG *  100 / (100 - ARG:1)
;-------------------------------------------------
;等值チェック関数@EQUALCHECK_TURN
;	引数0：チェックされる対象
;	引数1～20：チェックに用いられる数值
;@EQUALCHECKと同様ですが、一致した場合に返す值は1ではなく、最初に一致した引数の番号になります。
;-------------------------------------------------
@EQUALCHECK_TURN(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5, ARG:6, ARG:7, ARG:8, ARG:9, ARG:10, ARG:11, ARG:12, ARG:13, ARG:14, ARG:15, ARG:16, ARG:17, ARG:18, ARG:19, ARG:20)
#FUNCTION
#LOCALSIZE 2
IF ARG
	FOR LOCAL:1, 1, 20
		SIF ARG == ARG:(LOCAL:1)
			RETURNF LOCAL:1
	NEXT
ELSE
	;指定の変数が0の場合のみ別挙動
	LOCAL = 0
	FOR LOCAL:1, 0, 20
		SIF ARG:(20-(LOCAL:1)) && !LOCAL
			LOCAL = (LOCAL:1)
	NEXT
	FOR LOCAL:1, 1, 20-LOCAL
		SIF ARG == ARG:(LOCAL:1)
			RETURNF LOCAL:1
	NEXT
ENDIF
RETURNF 0

