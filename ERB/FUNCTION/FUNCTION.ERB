@DELETE_CHARA, ARG
IF TARGET == ARG
	TARGET = -1
ELSEIF TARGET > ARG
	TARGET -= 1
ENDIF
IF ASSI == ARG
	ASSI = -1
ELSEIF ASSI > ARG
	ASSI -= 1
ENDIF
DELCHARA ARG

;----------------------------------------------------------
;ARGの数だけラインを追加
;----------------------------------------------------------
@ADD_LINE, ARG
FOR LOCAL, 0, ARG
	PRINTL 
NEXT

;----------------------------------------------------------
;ARG行になるまでラインを追加
;----------------------------------------------------------
@EQUATE_LINE, ARG
WHILE LINECOUNT < ARG
	PRINTL 
WEND
;-------------------------------------------------
;画面を暗転させる
;ARG		暗転している時間(ms)
;-------------------------------------------------
@SHOW_BLANK, ARG = 100
#LOCALSIZE 2
LOCAL = CURRENTREDRAW()
LOCAL:1 = LINECOUNT
REDRAW 0
CALL ADD_LINE(50)
TWAIT ARG, 0
REDRAW LOCAL
CLEARLINE LINECOUNT - LOCAL:1

