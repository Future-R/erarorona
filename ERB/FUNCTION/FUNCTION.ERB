;-------------------------------------------------
;@SET_STR
;STRセット関数
;ARGSのSTRにARGS:1を代入する
;ARGSは"CSTR:TARGET:一人称", "STR:TOSTR(LOCAL)", "TSTR:1"いったような記述で指定する
;要素名は対応・変数はCSTRの第一引数に限り、MASTER/TARGET/ASSI/PLAYERのみ対応
;-------------------------------------------------
@SET_STR, ARGS, ARGS:1
CALLF SET_STRF(ARGS, ARGS:1)


;-------------------------------------------------
;@SET_STRF
;STRセット関数の式中関数版
;処理の都合上、こちらで呼ぶのが基本
;本体はGET_STRだけど名前を変えてわかりやすくしておく
;-------------------------------------------------
@SET_STRF, ARGS, ARGS:1
#FUNCTIONS
CALLF GET_STR, ARGS, ARGS:1, 1

;-------------------------------------------------
;@GET_STR
;STR取得関数
;ARGSのSTRの中身を返す
;要するに引数として、変数名を渡すのに使う
;-------------------------------------------------
@GET_STR, ARGS, ARGS:1, ARG
#FUNCTIONS
SELECTCASE AUTO_SPLIT(ARGS, ":", 0)
	CASE "STR"
		SIF ARG
			STR:AUTO_SPLIT_INT(ARGS, ":", 1) = %ARGS%
		RETURNF STR:AUTO_SPLIT_INT(ARGS, ":", 1)
	CASE "RESULTS"
		SIF ARG
			RESULTS:AUTO_SPLIT_INT(ARGS, ":", 1) = %ARGS%
		RETURNF RESULTS:AUTO_SPLIT_INT(ARGS, ":", 1)
	CASE "CSTR"
		SELECTCASE AUTO_SPLIT(ARGS, ":", 2)
			CASE "TARGET"
				LOCAL = TARGET
			CASE "MASTER"
				LOCAL = MASTER
			CASE "ASSI"
				LOCAL = ASSI
			CASE "PLAYER"
				LOCAL = PLAYER
			CASEELSE
				LOCAL = ISNUMERIC(AUTO_SPLIT(ARGS, ":", 2)) ? AUTO_SPLIT_INT(ARGS, ":", 2) # GETNUM(CSTR, AUTO_SPLIT(ARGS, ":", 2))
		ENDSELECT
		SIF ARG
			CSTR:AUTO_SPLIT_INT(ARGS, ":", 1):LOCAL = %ARGS:1%
		RETURNF CSTR:AUTO_SPLIT_INT(ARGS, ":", 1):LOCAL
	CASE "TSTR"
		LOCAL = ISNUMERIC(AUTO_SPLIT(ARGS, ":", 1)) ? AUTO_SPLIT_INT(ARGS, ":", 1) # GETNUM(TSTR, AUTO_SPLIT(ARGS, ":", 1))
		SIF ARG
			TSTR:LOCAL = %ARGS:1%
		RETURNF TSTR:LOCAL
	CASE "SAVESTR"
		LOCAL = ISNUMERIC(AUTO_SPLIT(ARGS, ":", 1)) ? AUTO_SPLIT_INT(ARGS, ":", 1) # GETNUM(SAVESTR, AUTO_SPLIT(ARGS, ":", 1))
		SIF ARG
			SAVESTR:LOCAL = %ARGS:1%
		RETURNF SAVESTR:LOCAL
	CASE "GLOBALS"
		LOCAL = ISNUMERIC(AUTO_SPLIT(ARGS, ":", 1)) ? AUTO_SPLIT_INT(ARGS, ":", 1) # GETNUM(GLOBALS, AUTO_SPLIT(ARGS, ":", 1))
		SIF ARG
			GLOBALS:LOCAL = %ARGS%
		RETURNF GLOBALS:LOCAL
	CASEELSE
		THROW @GET_STRF的参数ARGS(%ARGS%)异常！
ENDSELECT
;-------------------------------------------------
;@IS_EXIST_HERE
;ARGの角色が同じ場所にいるかを判定する
;-------------------------------------------------
@IS_EXIST_HERE, ARG
#FUNCTION
SIF ARG == MASTER
	RETURNF 1
SIF CSTR:ARG:状态 == "同行"
	RETURNF 1
SELECTCASE CSTR:ARG:所在地
	CASE "亚兰德"
		SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
			RETURNF 0
	CASE "阿拉尼亚村"
		SIF FLAG:当前地点 != GET_NO("地点", "阿拉尼亚村")
			RETURNF 0
	CASE "工房"
		SIF !IS_USEABLE_ATELIER()
			RETURNF 0
	CASEELSE
		RETURNF 0
ENDSELECT
RETURNF 1

