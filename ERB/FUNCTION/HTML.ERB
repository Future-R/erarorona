;----------------------------------------------------------------
; 获取指定行高的图像HTML（单位是百分之）
;----------------------------------------------------------------
@GET_IMAGE(res_Name, height = 1000, yPos = 0, addLines = "False")
#FUNCTIONS
#DIMS res_Name
#DIM height
#DIM yPos
#DIMS addLines
#DIM iEnter_Con
#DIM iFont_Hei_mag
#DIM iFont_Ypos_mag
#DIMS html_String

html_String =
iEnter_Con = 0
iFont_Hei_mag = GETCONFIG("一行の高さ") * height*10 / GETCONFIG("フォントサイズ")
iFont_Ypos_mag = GETCONFIG("一行の高さ") * yPos*10 / GETCONFIG("フォントサイズ")
iFont_Hei_mag = (iFont_Hei_mag/10) + (iFont_Hei_mag%10 >= 5?1#0)
iFont_Ypos_mag = (iFont_Ypos_mag/10) + (iFont_Ypos_mag%10 >= 5?1#0)
IF SPRITECREATED(res_Name)
	html_String += @"<img src='%res_Name%' ypos='{iFont_Ypos_mag}' height='{iFont_Hei_mag}'>"
ELSE
    html_String += "<br>"
ENDIF
iEnter_Con++

IF addLines == "True"
	FOR LOCAL,iEnter_Con-1,(Height/100)-1
		html_String += "<br>"
	NEXT
ENDIF
RETURNF html_String

@GET_SINGLE_IMAGE(res_Name, height = 1000, xPos = 0, yPos = 0, addLines = "False")
#FUNCTIONS
#DIMS res_Name
#DIM height
#DIM xPos
#DIM yPos
#DIMS sAlign
#DIMS addLines
LOCAL = GETCONFIG("一行の高さ") * xPos*10 / GETCONFIG("フォントサイズ")
LOCAL = (LOCAL/10) + (LOCAL%10 >= 5?1#0)
RETURNF HTML_ADDALIGNTAG(HTML_ADDNOBRTAG(ADD_NONBUTTON_TEXT(" " + GET_IMAGE(res_Name, height, yPos, addLines),"", LOCAL - 49)), "left")

;----------------------------------------------------------------
; 打印指定行高的图像HTML（单位是百分之）
;----------------------------------------------------------------
@PRINT_IMAGE(res_Name, height = 1000, xPos = 0, yPos = 0, addLines = "True")
#DIMS res_Name
#DIM height
#DIM xPos
#DIM yPos
#DIMS sAlign
#DIMS addLines
HTML_PRINT GET_SINGLE_IMAGE(res_Name,height,xPos,yPos,addLines)

;----------------------------------------------------------------
; 生成空白占位符 HTML
;----------------------------------------------------------------
@GET_SPACE(width = 1)
#FUNCTIONS
    #DIM width
    width = width > CLIENTWIDTH() / GETCONFIG("フォントサイズ") ? width # width * 100
    RETURNF @"<shape type='space' param='{width}'>"

;----------------------------------------------------------------
; 生成文本 / 按钮 HTML
;----------------------------------------------------------------
@GET_TEXT(text, style = 0, color = "", tooltip = "", button = "", bcolor = "", font = "")
#FUNCTIONS
    #DIMS text
    #DIM style
    #DIMS color
    #DIMS tooltip
    #DIMS button
    #DIMS bcolor
    #DIMS font
    #DIMS html
    SIF GETBIT(style, 0)
        text '= @"<b>%text%</b>"
    SIF GETBIT(style, 1)
        text '= @"<i>%text%</i>"
    SIF GETBIT(style, 2)
        text '= @"<s>%text%</s>"
    SIF GETBIT(style, 3)
        text '= @"<u>%text%</u>"
    SIF STRFINDU(color, "#") != 0 && COLOR_FROMNAME(color) == -1
        color '= @"#%TOSTR(GETCOLOR(), "X6")%"
    SIF STRFINDU(bcolor, "#") != 0 && COLOR_FROMNAME(bcolor) == -1
        bcolor '= @"#%TOSTR(GETFOCUSCOLOR(), "X6")%"
    SIF !CHKFONT(font)
        font '= GETFONT()
    SIF button == "" && tooltip == ""
        RETURNF @"<font face='%font%' color='%color%' bcolor='%bcolor%'>%text%</font>"
    html '= button == "" ? "<nonbutton" # @"<button value='%button%'"
    html += @" title='%tooltip%'>"
    html += @"<font face='%font%' color='%color%' bcolor='%bcolor%'>%text%</font>"
    html += button == "" ? "</nonbutton>" # "</button>"
    RETURNF html

;----------------------------------------------------------------
; 生成按钮 HTML
;----------------------------------------------------------------
@GET_BUTTON(text, button = "", tooltip = "")
#DIMS text
#DIMS button
#DIMS tooltip

#FUNCTIONS
    RETURNF GET_TEXT(text,,,tooltip,button)


@ADD_NONBUTTON_TEXT(ARGS, TOOLTIP = "", POS = 0)
#FUNCTIONS
#DIMS TOOLTIP
#DIM POS

    LOCALS '= "<nonbutton"

    SIF TOOLTIP != ""
    LOCALS += @" title='%TOOLTIP%'"

    SIF POS != 0
    LOCALS += @" pos='{POS}'"

    LOCALS += ">"
    LOCALS += ARGS
    LOCALS += "</nonbutton>"

RETURNF LOCALS