;	
;---------------------------------------------------------------------
;	memo
;		物品番号はITEMの定義番号でERB上で設定されている番号(XXX_YYY.ERBのXXXに当たる部分)
;		物品登録番号は生成された物品がデータとして保存されている番号(DA:X:YのXにあたる部分)
;---------------------------------------------------------------------
;@GET_ITEMDATA				物品変数の中身を取得する関数
;@SET_ITEMDATA				物品データ代入関数
;@GET_ITEMNAME				登録されている物品の名称を獲得する関数
;@GET_ITEMNAME_P			登録されている物品の特性の名称を獲得する関数
;@GET_ITEMNAME_E			登録されている物品の主效果の名称を獲得する関数
;@GET_ITEMRANK				ARGの物品のランクをE~Sまでの文字列で返す
;@GET_ITEMNAME_C			物品登録番号 ARGの调和类别ARG:1の名称を取得する
;@SET_CATEGORY				物品登録時の调和类别セット関数
;@GET_CATEGORY				登録物品に指定の调和类别が含まれているか確認するための関数
;@DEL_ITEMDATA				物品削除関数
;@SWAP_ITEMDATA				2つの登録物品の中身をすべて入れ替える
;@COPY_ITEMDATA				登録物品の中身を別の登録物品にコピーする
;@BASKET_SIZE				篮子のサイズ関数
;@GET_ITEM_TOTAL			物品の数量
;@ADD_ARTIFACT				アーティファクト入手処理
;---------------------------------------------------------------------

;---------------------------------------------------------------------
;@GET_ITEMDATA
;物品データ取得関数
;ARG 	対象となる物品登録番号
;ARGS	データの名称(詳しくはNAME_LIST.ERBを参照すること)
;---------------------------------------------------------------------
@GET_ITEMDATA, ARG, ARGS
#FUNCTION
#LOCALSIZE 1
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_NO("物品要素", ARGS)
RETURNF DA:ARG:LOCAL

;---------------------------------------------------------------------
;@SET_ITEMDATA
;物品データ代入関数
;ARG 	対象となる物品登録番号
;ARGS	データの名称(詳しくはNAME_LIST.ERBを参照すること)
;ARG:1	代入する数值
;---------------------------------------------------------------------
@SET_ITEMDATA, ARG, ARGS, ARG:1
#LOCALSIZE 1
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_NO("物品要素", ARGS)
DA:ARG:LOCAL = ARG:1

;---------------------------------------------------------------------
;@GET_ITEMNAME
;登録されている物品の名称を獲得する関数
;ARG	対象となる物品登録番号
;ARGS	KNOWNONLYのとき、既知でないものは????となる
;---------------------------------------------------------------------
@GET_ITEMNAME, ARG, ARGS
#FUNCTIONS
RETURNF GET_NAME("物品", DA:ARG:GET_NO("物品要素", "ID"), ARGS)

;---------------------------------------------------------------------
;@GET_ITEMNAME_P
;登録されている物品の特性の名称を獲得する関数
;ARG	対象となる物品登録番号
;ARG:1	特性の番号(0-4)
;---------------------------------------------------------------------
@GET_ITEMNAME_P, ARG, ARG:1, ARGS
#FUNCTIONS
RETURNF GET_NAME("特性", GET_ITEMDATA(ARG, @"特性{ARG:1}"), ARGS)

;---------------------------------------------------------------------
;@GET_ITEMNAME_E
;登録されている物品の主效果の名称を獲得する関数
;ARG	対象となる物品登録番号
;ARG:1	主效果の番号(0-3)
;ARGS	KNOWNONLYのとき、既知でないものは????となる
;---------------------------------------------------------------------
@GET_ITEMNAME_E, ARG, ARG:1, ARGS
#FUNCTIONS
RETURNF GET_NAME("主效果", GET_ITEMDATA(ARG, @"主效果{ARG:1}"), ARGS)

;---------------------------------------------------------------------
;@GET_ITEMRANK
;ARGの物品のランクをE~Sまでの文字列で返す
;ARG	対象となる物品登録番号
;---------------------------------------------------------------------
@GET_ITEMRANK, ARG
#FUNCTIONS
SIF !INRANGE(GET_ITEMDATA(ARG, "质量"), 0, 5)
	THROW @"[{ARG}] %GET_ITEMNAME(ARG)% の 物品ランクが異常です"
RETURNF AUTO_SPLIT("E/D/C/B/A/S", "/", GET_ITEMDATA(ARG, "质量"))

;---------------------------------------------------------------------
;@GET_ITEMNAME_C
;物品登録番号 ARGの调和类别ARG:1の名称を取得する(ARG:1が省略された場合、すべてをつなげて返す)
;ARG	対象となる物品登録番号
;ARG:1	ARGが所持している幾つ目の调和类别ーか。省略することで、全ての名称を"/"でつないで返す
;---------------------------------------------------------------------
@GET_ITEMNAME_C, ARG, ARG:1 = -1
#FUNCTIONS
#LOCALSSIZE 1
#LOCALSIZE 1
LOCALS = 
FOR LOCAL, 0, 调和类别要素数
	SIF GETBIT(GET_ITEMDATA(ARG, "调和类别"), LOCAL)
		LOCALS += "/" + GET_NAME("调和类别", LOCAL)
NEXT
;一文字目を削る
LOCALS = %SUBSTRING(LOCALS, 1)%
IF ARG:1 < 0
	RETURNF LOCALS
ELSE
	RETURNF AUTO_SPLIT(LOCALS, "/", ARG:1)
ENDIF

;---------------------------------------------------------------------
;@SET_CATEGORY
;物品登録時の调和类别セット関数
;ビット演算を利用し、1フラグに全て入れてしまう
;基本的には调合時などにおける処理簡略化用
;ARG	対象となる物品登録番号
;---------------------------------------------------------------------
@SET_CATEGORY, ARG
DA:ARG:GET_NO("物品要素", "调和类别") = 0
FOR LOCAL, 0, 调和类别要素数
	CALLFORM ITEM_CATEGORY_{GET_ITEMDATA(ARG, "ID")}, LOCAL
	SIF RESULT >= 0
		SETBIT DA:ARG:GET_NO("物品要素", "调和类别"), LOCAL
NEXT

;---------------------------------------------------------------------
;@GET_CATEGORY
;登録物品に指定の调和类别が含まれているか確認するための関数
;
;ARG	対象となる物品登録番号
;ARGS	チェックする调和类别の名称
;---------------------------------------------------------------------
@GET_CATEGORY, ARG, ARGS
#FUNCTION
RETURNF GETBIT(DA:ARG:GET_NO("物品要素", "调和类别"), GET_NO("调和类别", ARGS))

;---------------------------------------------------------------------
;@DEL_ITEMDATA
;物品削除関数。なお、この関数で作られた空白物品の前詰め処理は行わないので注意
;ARG	対象となる物品登録番号
;---------------------------------------------------------------------
@DEL_ITEMDATA, ARG
#LOCALSIZE 1
FOR LOCAL, 0, 物品要素数
	DA:ARG:LOCAL = 0
NEXT

;---------------------------------------------------------------------
;@SWAP_ITEMDATA
;2つの登録物品の中身をすべて入れ替える
;ARG	対象となる物品登録番号
;ARG:1	対象となる物品登録番号
;---------------------------------------------------------------------
@SWAP_ITEMDATA, ARG, ARG:1
#LOCALSIZE 1
FOR LOCAL, 0, 物品要素数
	SWAP DA:ARG:LOCAL, DA:(ARG:1):LOCAL
NEXT


;---------------------------------------------------------------------
;@COPY_ITEMDATA
;登録物品の中身をすべて別の登録物品にコピーする
;ARG	コピー元ととなる物品登録番号
;ARG:1	コピー対象となる物品登録番号
;---------------------------------------------------------------------
@COPY_ITEMDATA, ARG, ARG:1
#LOCALSIZE 1
FOR LOCAL, 0, 物品要素数
	DA:(ARG:1):LOCAL = DA:ARG:LOCAL
NEXT
;---------------------------------------------------------------------
;@BASKET_SIZE
;篮子のサイズ関数
;---------------------------------------------------------------------
@BASKET_SIZE
#FUNCTION
SIF GET_ITEMNAME_E(GET_NO_QEQUIP("篮子"), 0) == "大きなサイズ"
	RETURNF 80
SIF GET_ITEMNAME_E(GET_NO_QEQUIP("篮子"), 0) == "ジャンボサイズ"
	RETURNF 100
RETURNF 60

;---------------------------------------------------------------------
;@GET_ITEM_TOTAL
;物品の所持数
;ARGS	物品の所属
;----------------------------------------------------------------------
@GET_ITEM_TOTAL, ARGS
#FUNCTION
#LOCALSIZE 3
;一応RESULT:1退避
LOCAL:2 = RESULT:1
LOCAL:1 = 0
FOR LOCAL, GET_ITEM_RANGE(ARGS), GET_ITEM_RANGE(ARGS, 1)
	SIF GET_ITEMDATA(LOCAL, "ID") > 0
		LOCAL:1++
NEXT
RESULT:1 = LOCAL:2
RETURNF LOCAL:1

;---------------------------------------------------------------------
;@ADD_ARTIFACT
;アーティファクト入手処理
;ARGS	取得するアーティファクトの名称
;ARG	アーティファクトを登録する番号
;---------------------------------------------------------------------
@ADD_ARTIFACT, ARGS, ARG
CALL SET_KNOWN_ITEM, ARGS, "获得"
CALL SET_ITEMDATA, ARG, "ID", GET_NO("物品", ARGS)
CALL SET_ITEMDATA, ARG, "品质", 100
CALL SET_ITEMDATA, ARG, "质量", 5
CALL SET_ITEMDATA, ARG, "调和类别", POWER(2, GET_NO("调和类别", "神器"))




