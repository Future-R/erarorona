;---------------------------------------------------------------------
;	memo
;		アイテム番号はITEMの定義番号でERB上で設定されている番号(XXX_YYY.ERBのXXXに当たる部分)
;		アイテム登録番号は生成されたアイテムがデータとして保存されている番号(DA:X:YのXにあたる部分)
;---------------------------------------------------------------------
;@GET_ITEMDATA				アイテム変数の中身を取得する関数
;@SET_ITEMDATA				アイテムデータ代入関数
;@GET_ITEMNAME				登録されているアイテムの名称を獲得する関数
;@GET_ITEMNAME_P			登録されているアイテムの特性の名称を獲得する関数
;@GET_ITEMNAME_E			登録されているアイテムの主効果の名称を獲得する関数
;@GET_ITEMRANK				ARGのアイテムのランクをE~Sまでの文字列で返す
;@GET_ITEMNAME_C			アイテム登録番号 ARGのカテゴリARG:1の名称を取得する
;@SET_CATEGORY				アイテム登録時のカテゴリセット関数
;@GET_CATEGORY				登録アイテムに指定のカテゴリが含まれているか確認するための関数
;@DEL_ITEMDATA				アイテム削除関数
;@SWAP_ITEMDATA				2つの登録アイテムの中身をすべて入れ替える
;@COPY_ITEMDATA				登録アイテムの中身を別の登録アイテムにコピーする
;@BASKET_SIZE				カゴのサイズ関数
;@GET_ITEM_TOTAL			アイテムの個数
;@ADD_ARTIFACT				アーティファクト入手処理
;---------------------------------------------------------------------

;---------------------------------------------------------------------
;@GET_ITEMDATA
;アイテムデータ取得関数
;ARG 	対象となるアイテム登録番号
;ARGS	データの名称(詳しくはNAME_LIST.ERBを参照すること)
;---------------------------------------------------------------------
@GET_ITEMDATA, ARG, ARGS
#FUNCTION
#LOCALSIZE 1
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_NO("アイテム要素", ARGS)
RETURNF DA:ARG:LOCAL

;---------------------------------------------------------------------
;@SET_ITEMDATA
;アイテムデータ代入関数
;ARG 	対象となるアイテム登録番号
;ARGS	データの名称(詳しくはNAME_LIST.ERBを参照すること)
;ARG:1	代入する数値
;---------------------------------------------------------------------
@SET_ITEMDATA, ARG, ARGS, ARG:1
#LOCALSIZE 1
LOCAL = ISNUMERIC(ARGS) ? TOINT(ARGS) # GET_NO("アイテム要素", ARGS)
DA:ARG:LOCAL = ARG:1

;---------------------------------------------------------------------
;@GET_ITEMNAME
;登録されているアイテムの名称を獲得する関数
;ARG	対象となるアイテム登録番号
;ARGS	KNOWNONLYのとき、既知でないものは????となる
;---------------------------------------------------------------------
@GET_ITEMNAME, ARG, ARGS
#FUNCTIONS
RETURNF GET_NAME("アイテム", DA:ARG:GET_NO("アイテム要素", "ID"), ARGS)

;---------------------------------------------------------------------
;@GET_ITEMNAME_P
;登録されているアイテムの特性の名称を獲得する関数
;ARG	対象となるアイテム登録番号
;ARG:1	特性の番号(0-4)
;---------------------------------------------------------------------
@GET_ITEMNAME_P, ARG, ARG:1, ARGS
#FUNCTIONS
RETURNF GET_NAME("特性", GET_ITEMDATA(ARG, @"特性{ARG:1}"), ARGS)

;---------------------------------------------------------------------
;@GET_ITEMNAME_E
;登録されているアイテムの主効果の名称を獲得する関数
;ARG	対象となるアイテム登録番号
;ARG:1	主効果の番号(0-3)
;ARGS	KNOWNONLYのとき、既知でないものは????となる
;---------------------------------------------------------------------
@GET_ITEMNAME_E, ARG, ARG:1, ARGS
#FUNCTIONS
RETURNF GET_NAME("主効果", GET_ITEMDATA(ARG, @"主効果{ARG:1}"), ARGS)

;---------------------------------------------------------------------
;@GET_ITEMRANK
;ARGのアイテムのランクをE~Sまでの文字列で返す
;ARG	対象となるアイテム登録番号
;---------------------------------------------------------------------
@GET_ITEMRANK, ARG
#FUNCTIONS
SIF !INRANGE(GET_ITEMDATA(ARG, "クオリティ"), 0, 5)
	THROW @"[{ARG}] %GET_ITEMNAME(ARG)% の アイテムランクが異常です"
RETURNF AUTO_SPLIT("E/D/C/B/A/S", "/", GET_ITEMDATA(ARG, "クオリティ"))

;---------------------------------------------------------------------
;@GET_ITEMNAME_C
;アイテム登録番号 ARGのカテゴリARG:1の名称を取得する(ARG:1が省略された場合、すべてをつなげて返す)
;ARG	対象となるアイテム登録番号
;ARG:1	ARGが所持している幾つ目のカテゴリーか。省略することで、全ての名称を"/"でつないで返す
;---------------------------------------------------------------------
@GET_ITEMNAME_C, ARG, ARG:1 = -1
#FUNCTIONS
#LOCALSSIZE 1
#LOCALSIZE 1
LOCALS = 
FOR LOCAL, 0, カテゴリ要素数
	SIF GETBIT(GET_ITEMDATA(ARG, "カテゴリ"), LOCAL)
		LOCALS += "/" + GET_NAME("カテゴリ", LOCAL)
NEXT
;一文字目を削る
LOCALS = %SUBSTRING(LOCALS, 1)%
IF ARG:1 < 0
	RETURNF LOCALS
ELSE
	RETURNF AUTO_SPLIT(LOCALS, "/", ARG:1)
ENDIF

;---------------------------------------------------------------------
;@SET_CATEGORY
;アイテム登録時のカテゴリセット関数
;ビット演算を利用し、1フラグに全て入れてしまう
;基本的には調合時などにおける処理簡略化用
;ARG	対象となるアイテム登録番号
;---------------------------------------------------------------------
@SET_CATEGORY, ARG
DA:ARG:GET_NO("アイテム要素", "カテゴリ") = 0
FOR LOCAL, 0, カテゴリ要素数
	CALLFORM ITEM_CATEGORY_{GET_ITEMDATA(ARG, "ID")}, LOCAL
	SIF RESULT >= 0
		SETBIT DA:ARG:GET_NO("アイテム要素", "カテゴリ"), LOCAL
NEXT

;---------------------------------------------------------------------
;@GET_CATEGORY
;登録アイテムに指定のカテゴリが含まれているか確認するための関数
;
;ARG	対象となるアイテム登録番号
;ARGS	チェックするカテゴリの名称
;---------------------------------------------------------------------
@GET_CATEGORY, ARG, ARGS
#FUNCTION
RETURNF GETBIT(DA:ARG:GET_NO("アイテム要素", "カテゴリ"), GET_NO("カテゴリ", ARGS))

;---------------------------------------------------------------------
;@DEL_ITEMDATA
;アイテム削除関数。なお、この関数で作られた空白アイテムの前詰め処理は行わないので注意
;ARG	対象となるアイテム登録番号
;---------------------------------------------------------------------
@DEL_ITEMDATA, ARG
#LOCALSIZE 1
FOR LOCAL, 0, アイテム要素数
	DA:ARG:LOCAL = 0
NEXT

;---------------------------------------------------------------------
;@SWAP_ITEMDATA
;2つの登録アイテムの中身をすべて入れ替える
;ARG	対象となるアイテム登録番号
;ARG:1	対象となるアイテム登録番号
;---------------------------------------------------------------------
@SWAP_ITEMDATA, ARG, ARG:1
#LOCALSIZE 1
FOR LOCAL, 0, アイテム要素数
	SWAP DA:ARG:LOCAL, DA:(ARG:1):LOCAL
NEXT


;---------------------------------------------------------------------
;@COPY_ITEMDATA
;登録アイテムの中身をすべて別の登録アイテムにコピーする
;ARG	コピー元ととなるアイテム登録番号
;ARG:1	コピー対象となるアイテム登録番号
;---------------------------------------------------------------------
@COPY_ITEMDATA, ARG, ARG:1
#LOCALSIZE 1
FOR LOCAL, 0, アイテム要素数
	DA:(ARG:1):LOCAL = DA:ARG:LOCAL
NEXT
;---------------------------------------------------------------------
;@BASKET_SIZE
;カゴのサイズ関数
;---------------------------------------------------------------------
@BASKET_SIZE
#FUNCTION
SIF GET_ITEMNAME_E(GET_NO_QEQUIP("カゴ"), 0) == "大きなサイズ"
	RETURNF 80
SIF GET_ITEMNAME_E(GET_NO_QEQUIP("カゴ"), 0) == "ジャンボサイズ"
	RETURNF 100
RETURNF 60

;---------------------------------------------------------------------
;@GET_ITEM_TOTAL
;アイテムの所持数
;ARGS	アイテムの所属
;----------------------------------------------------------------------
@GET_ITEM_TOTAL, ARGS
#FUNCTION
#LOCALSIZE 3
;一応RESULT:1退避
LOCAL:2 = RESULT:1
LOCAL:1 = 0
FOR LOCAL, GET_ITEM_RANGE(ARGS), GET_ITEM_RANGE(ARGS, 1)
	SIF GET_ITEMDATA(LOCAL, "ID") > 0
		LOCAL:1++
NEXT
RESULT:1 = LOCAL:2
RETURNF LOCAL:1

;---------------------------------------------------------------------
;@ADD_ARTIFACT
;アーティファクト入手処理
;ARGS	取得するアーティファクトの名称
;ARG	アーティファクトを登録する番号
;---------------------------------------------------------------------
@ADD_ARTIFACT, ARGS, ARG
CALL SET_KNOWN_ITEM, ARGS, "入手"
CALL SET_ITEMDATA, ARG, "ID", GET_NO("アイテム", ARGS)
CALL SET_ITEMDATA, ARG, "品質", 100
CALL SET_ITEMDATA, ARG, "クオリティ", 5
CALL SET_ITEMDATA, ARG, "カテゴリ", POWER(2, GET_NO("カテゴリ", "アーティファクト"))




