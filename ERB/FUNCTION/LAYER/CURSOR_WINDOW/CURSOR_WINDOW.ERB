@CURSOR_WINDOW_INIT, ARG = 1
VARSET CW_ID			; 現在選択中窓ID
CW_ID:1 = ARG			; 有効最大窓数 
KEYINPUT_ONE = 1		; 最初からONEINPUTS  詳しくは KEYINPUT.ERB 参照
; VARSETで初期化  要素数はID10個まで  CURSOR_WINDOW.ERH 参照
VARSET CWBUTTON:0:0		; ボタンの文字列 ID * 10 * 1000の1万項目
VARSET CW_Y_ABLE		; 縦列で一度に描写するボタン行
VARSET CW_X_ABLE		; 横列で一度に描写するボタン数
VARSET CW_UPPER			; 上スクロール可能フラグ
VARSET CW_LOWER			; 下スクロール可能フラグ
VARSET CW_BTNCNT		; ボタン最大数
VARSET CW_OPENED		; 描画領域広げたよフラグ

VARSET CW_NOWVIEW		; ボタン描画開始ID(視界上端)
VARSET CW_CURSOR		; 現在選択中ボタンID


;-------------------------------------------------------------------------------
;	CURSOR_WINDOW_SET
;-------------------------------------------------------------------------------
;	CWBUTTON:Y:X に格納された文字列を展開してリスト化
;	CWBUTTON:窓ID:ボタン番号 = 文字列はHTML_PRINTの仕様
;	ただし使えるのはFONTタグとBUTTONタグのみ
;-------------------------------------------------------------------------------
;	・特殊なボタン
;	  CW_{窓ID}		システムが窓IDを切り替えるボタン
;	  CWUPPER_{窓ID}		指定窓IDを上にスクロールするボタン
;	  CWLOWER_{窓ID}		指定窓IDを下にスクロールするボタン
;	  CWQUIT			CW_IDがどこであれ一撃必殺で終了するボタン
;===============================================================================
;	ID = 窓ID,  ARG:0 = 置くY座標,  ARG:1 = 置くX座標,
;	ARG:2 = 縦表示する行数,  ARG:3 = 横表示する項目数,  LENGTH = ボタンの文字列(省略可)
;	FRAMELABEL = "NOFRAME"で枠なし、その他任意の文字列で枠の題名
;	BUTTONABLE = BUTTONABLE的な関数名をここに
;				 FUNCNAME,窓ID,ボタン番号 のような式中ではない通常関数、返り値は0/1のみ

@CURSOR_WINDOW_SET, ID, ARG, ARG:1, ARG:2 = 4, ARG:3 = 1, LENGTH = -1, FRAMELABEL, BUTTONABLE
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM ID,1			; 窓ID
#DIM LENGTH,1		; ボタンラベル文字列数
#DIM YPOINT,1		; Y座標仮置き場
#DIM XPOINT,1		; X座標仮置き場
#DIM LCOUNT,1		; いつもの
#DIM LCOUNTX,1		; いつもの
#DIM ISFRAME,1		; 枠なし
#DIMS FRAMELABEL,1
#DIMS BUTTONABLE,1
VARSET LOCAL

; 初期設定 -------------------------------------------------
IF CW_BTNCNT:ID == 0
	CW_Y_ABLE:ID = ARG:2
	CW_X_ABLE:ID = ARG:3
	LENGTH = LENGTH == -1 ? PRINTCLENGTH() # LENGTH
	; ボタンの最後尾の検索・代入
	FOR LCOUNT, 0, 1000
