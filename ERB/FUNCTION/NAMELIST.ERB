;@MAKE_NOLIST　リスト作成関数
;---------------------------------------------------------------------
;@MAKE_NOLIST
;リスト作成関数。ロード時・ゲーム開始時に呼び出してリストを作成する
;---------------------------------------------------------------------
@MAKE_NOLIST
#LOCALSIZE 2
VARSET NAMELIST
VARSET 値域リスト
VARSET 値域番号定義
値域リスト:0 = 0
値域番号定義:0 = キャラ
値域リスト:1 = 値域リスト:0 + キャラ総数

LOCAL:1 = 0
FOR LOCAL, 0, キャラ総数
	SIF EXISTCSV(LOCAL, 0)
		NAMELIST:(LOCAL:1) = %CSVCALLNAME(LOCAL, 0)%
	LOCAL:1++
NEXT

値域番号定義:1 = アイテム
値域リスト:2 = 値域リスト:1 + アイテム総数
FOR LOCAL, 0, アイテム総数
	TRYCCALLFORM ITEM_NAME_{LOCAL}
		NAMELIST:(LOCAL:1) = %RESULTS%
	CATCH
	ENDCATCH
	LOCAL:1++
NEXT

値域番号定義:2 = 特性
値域リスト:3 = 値域リスト:2 + 特性総数
FOR LOCAL, 0, 特性総数
	CALL PROPERTY_NAME, LOCAL
	SIF RESULTS != ""
		NAMELIST:(LOCAL:1) = %RESULTS%
	LOCAL:1++
NEXT

値域番号定義:3 = 主効果
値域リスト:4 = 値域リスト:3 + 主効果総数
FOR LOCAL, 0, 主効果総数
	TRYCCALLFORM EFFECT_NAME_{LOCAL}
