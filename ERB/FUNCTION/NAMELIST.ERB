;---------------------------------------------------------------------
;@GET_EXIST
;名称から存在を取得する関数
;ARGS	対象となる種別
;ARGS:1	調べる要素名
;---------------------------------------------------------------------
@GET_EXIST, ARGS, ARGS:1
#FUNCTION
#LOCALSIZE 1
#DIM スタート値
#DIM エンド値
LOCAL = FINDELEMENT(値域番号定義, ARGS, , , 1)
スタート値 = 値域リスト:LOCAL
エンド値 = 値域リスト:(LOCAL + 1)
LOCAL = FINDELEMENT(NAMELIST, ESCAPE(ARGS:1), スタート値, エンド値, 1) - スタート値
RETURNF LOCAL >= 0
;---------------------------------------------------------------------
;@GET_NO
;名称から番号を取得する関数
;ARGS	対象となる種別
;ARGS:1	調べる要素名
;---------------------------------------------------------------------
@GET_NO, ARGS, ARGS:1
#FUNCTION
#LOCALSIZE 1
#DIM スタート値
#DIM エンド値
LOCAL = FINDELEMENT(値域番号定義, ARGS, , , 1)
スタート値 = 値域リスト:LOCAL
エンド値 = 値域リスト:(LOCAL + 1)
LOCAL = FINDELEMENT(NAMELIST, ESCAPE(ARGS:1), スタート値, エンド値, 1) - スタート値
SIF LOCAL < 0
	THROW %ARGS%において存在しない名称%ARGS:1%の番号が取得されようとしました。
RETURNF LOCAL

;---------------------------------------------------------------------
;@GET_NAME
;番号から名称を取得する関数
;ARGS	対象となる種別
;ARG	調べる番号
;ARGS:1	登録用で動作内容を指定する
;---------------------------------------------------------------------
@GET_NAME, ARGS, ARG, ARGS:1
#FUNCTIONS
#DIM スタート値
#DIM エンド値
#DIM NUM
LOCAL = FINDELEMENT(値域番号定義, ARGS, , , 1)
スタート値 = 値域リスト:LOCAL
エンド値 = 値域リスト:(LOCAL + 1)
NUM = ARG + スタート値
SIF !INRANGE(NUM, スタート値, エンド値 - 1)
	RETURNF @"登録範囲外({ARG})"
SIF NAMELIST:NUM == ""
	RETURNF @"名称不在({ARG})"
SIF NAMELIST:NUM == "空白"
	RETURNF ""
	
IF ARGS:1 == "KNOWNONLY"
	SIF (ARGS == "アイテム" || ARGS == "ITEM") && !GET_KNOWN_ITEM(ARG, "入手")
		RETURNF "????"
ENDIF
RETURNF NAMELIST:NUM

