;@MAKE_NOLIST
;リスト作成関数。ロード時・ゲーム開始時に呼び出してリストを作成する
;---------------------------------------------------------------------
@MAKE_NOLIST
#LOCALSIZE 2
VARSET NAMELIST
VARSET 值域列表
VARSET 值域编号定义
值域列表:0 = 0
值域编号定义:0 = 角色
值域列表:1 = 值域列表:0 + 角色总数

LOCAL:1 = 0
FOR LOCAL, 0, 角色总数
	SIF EXISTCSV(LOCAL, 0)
		NAMELIST:(LOCAL:1) = %CSVCALLNAME(LOCAL, 0)%
	LOCAL:1++
NEXT

值域编号定义:1 = アイテム
值域列表:2 = 值域列表:1 + アイテム総数
FOR LOCAL, 0, アイテム総数
	TRYCCALLFORM ITEM_NAME_{LOCAL}
		NAMELIST:(LOCAL:1) = %RESULTS%
	CATCH
	ENDCATCH
	LOCAL:1++
NEXT

值域编号定义:2 = 特性
值域列表:3 = 值域列表:2 + 特性総数
FOR LOCAL, 0, 特性総数
	CALL PROPERTY_NAME, LOCAL
	SIF RESULTS != ""
		NAMELIST:(LOCAL:1) = %RESULTS%
	LOCAL:1++
NEXT

值域编号定义:3 = 主效果
值域列表:4 = 值域列表:3 + 主效果総数
