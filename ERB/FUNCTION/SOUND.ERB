;----------------------------------------------------------------
; 切换BGM
;----------------------------------------------------------------
@BGM(Res_Name)
#DIMS Res_Name

SIF 正在跳过()
    RETURN 0
; PRINTVW "当前背景音乐: " + 当前背景音乐
; PRINTVW "切换BGM: " + Res_Name
IF 当前背景音乐 != Res_Name
    PLAYBGM Res_Name
    当前背景音乐 = %Res_Name%
ENDIF
SETBGMVOLUME GLOBAL:音量

@STOP_BGM
#FUNCTION
STOPBGM
当前背景音乐 = ""

@PLAY_SE, ARGS
SIF 正在跳过()
    RETURN 0
PLAYSOUND ARGS

;----------------------------------------------------------------
; 暂停BGM一段时间(不是真正的暂停，只是声音调成了0)
;----------------------------------------------------------------
@PAUSE_BGM, ms
#DIM ms

SIF 正在跳过()
    RETURN 0

发起暂停的毫秒 = GETMILLISECOND()
需要暂停的毫秒 = ms
SETBGMVOLUME 0

;----------------------------------------------------------------
; 取消暂停BGM(如果在对话中则不需要手动调用恢复BGM，对话会自己处理)
;----------------------------------------------------------------
@RESUME_BGM
#DIM 剩余时间

SIF 正在跳过()
    RETURN 0

剩余时间 = GETMILLISECOND() - 发起暂停的毫秒
; 50毫秒的延迟可以忽略不计
IF 剩余时间 > 50
    TWAIT 剩余时间, 1
ENDIF

;----------------------------------------------------------------
; 单独播放一个音效，会暂停音乐一段时间
;----------------------------------------------------------------
@SOLO, 音效名, 持续毫秒 = 4000
#DIMS 音效名
#DIM 持续毫秒

SIF 正在跳过()
    RETURN 0

CALL PAUSE_BGM, 持续毫秒
SETSOUNDVOLUME GLOBAL:音量
PLAYSOUND 音效名