;
;@AUTO_SPLIT
;ARGS   操作する文字列
;ARGS:1 ARGSを区切る文字列
;ARG 　 ARGSを区切った後で、操作する箇所。ARGS:2が指定されている場合、発見したARGS:2の場所+ARG番目の文字列を返す。
;ARGS:2 検索する文字列
;================================================
@AUTO_SPLIT(ARGS , ARGS:1 = "/" , ARG = 0 , ARGS:2 = "")
#FUNCTIONS
#LOCALSSIZE 200
#LOCALSIZE 1
LOCAL = RESULT
VARSET LOCALS
SPLIT ARGS , ARGS:1 , LOCALS
RESULT = LOCAL
IF ARGS:2 != ""
	LOCAL = FINDELEMENT(LOCALS , ESCAPE(ARGS:2), , , 1)
	IF LOCAL != -1
		SIF ARG + LOCAL < 0
			THROW @"错误：在函数@AUTO_SPLIT的第{LOCAL}个字符串发现%ARGS:2%，但是指定第三参数{ARG}是不正确的。"
		RETURNF LOCALS:(LOCAL + ARG)
	ELSE
		RETURNF
	ENDIF
ELSE
	SIF ARG < 0
		THROW @"错误：传递了{ARG}作为函数@AUTO_SPLIT的第三参数"
	RETURNF LOCALS:ARG
ENDIF

