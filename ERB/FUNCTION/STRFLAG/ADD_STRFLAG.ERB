;-------------------------------------------------
;@ADD_STRFLAGF
;ARGSにARGS:1を加える関数
;-------------------------------------------------
@ADD_STRFLAGF(ARGS, ARGS:1, ARGS:2 = "1")
#FUNCTIONS
#DIMS TEMPS, 2
#LOCALSIZE 2
#LOCALSSIZE 200
LOCAL:1 = RESULT
TEMPS = %GET_STR(ARGS)%
TEMPS:1 = %"" + ESCAPE(ARGS:1) + ""%
;すでにある場合は数值置き換え
IF STRCOUNT(TEMPS, TEMPS:1)
	SPLIT TEMPS, "", LOCALS
	STR = %ESCAPE(ARGS:1) + ""%
	LOCAL = FINDELEMENT(LOCALS, ESCAPE(ARGS:1) + "", 0, RESULT, 0)
	RESULT = LOCAL:1
	TEMPS:1 = %AUTO_SPLIT(LOCALS:LOCAL, "", 0) + "" + ARGS:2%
	CALLF SET_STRF(ARGS, REPLACE(TEMPS, ESCAPE(LOCALS:LOCAL), ESCAPE(TEMPS:1)))
ELSE
	SIF TEMPS == ""
		TEMPS = %""%
	TEMPS += ARGS:1 + "" + ARGS:2+ ""
	CALLF SET_STRF(ARGS, TEMPS)
ENDIF
;-------------------------------------------------
;@ADD_STRFLAG
;ARGSにARGS:1を加えたものを返す関数
;/を代入するのでおもいっきりSTRFLAG用
;-------------------------------------------------
@ADD_STRFLAG, ARGS, ARGS:1, ARGS:2
CALLF ADD_STRFLAGF(ARGS, ARGS:1, ARGS:2)

