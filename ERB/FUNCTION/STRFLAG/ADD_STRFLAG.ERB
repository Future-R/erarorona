@ADD_STRFLAGF(ARGS, ARGS:1, ARGS:2 = "1")
#FUNCTIONS
#DIMS TEMPS, 2
#LOCALSIZE 2
#LOCALSSIZE 200
LOCAL:1 = RESULT
TEMPS = %GET_STR(ARGS)%
TEMPS:1 = %UNICODE(0x07) + ESCAPE(ARGS:1) + UNICODE(0x06)%
;Ç∑Ç≈Ç…Ç†ÇÈèÍçáÇÕêîílíuÇ´ä∑Ç¶
IF STRCOUNT(TEMPS, TEMPS:1)
	SPLIT TEMPS, UNICODE(0x07), LOCALS
	STR = %ESCAPE(ARGS:1) + UNICODE(0x06)%
	LOCAL = FINDELEMENT(LOCALS, ESCAPE(ARGS:1) + UNICODE(0x06), 0, RESULT, 0)
	RESULT = LOCAL:1
	TEMPS:1 = %AUTO_SPLIT(LOCALS:LOCAL, UNICODE(0x06), 0) + UNICODE(0x06) + ARGS:2%
	CALLF SET_STRF(ARGS, REPLACE(TEMPS, ESCAPE(LOCALS:LOCAL), ESCAPE(TEMPS:1)))
ELSE
	SIF TEMPS == ""
		TEMPS = %UNICODE(0x07)%
	TEMPS += ARGS:1 + UNICODE(0x06) + ARGS:2+ UNICODE(0x07)
	CALLF SET_STRF(ARGS, TEMPS)
ENDIF
