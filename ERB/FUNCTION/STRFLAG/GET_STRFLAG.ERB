;-------------------------------------------------
;@GET_STRFLAG
;ARGS	調査対象の文字列
;ARGS:1	含まれてるかどうかみる文字列
;ARG	1の時はARGS:1にARGS:2を追加、-1の時はARGS:1を削除
;ARG:2 内容取り出し
;-------------------------------------------------
@GET_STRFLAG(ARGS, ARGS:1, ARG, ARGS:2 = "1", ARGS:3)
#FUNCTION
#LOCALSIZE 2
#LOCALSSIZE 200
#DIMS TEMPS, 2
LOCAL:1 = RESULT
TEMPS = %GET_STR(ARGS)%
TEMPS:1 = %"" + ESCAPE(ARGS:1) + ""%
IF STRCOUNT(TEMPS, TEMPS:1)
	SIF ARG < 0
		CALLF DEL_STRFLAGF(ARGS, ARGS:1)
	IF ARGS:3 == ""
		RETURNF 1
	ELSE
		SPLIT TEMPS, "", LOCALS
		LOCAL = FINDELEMENT(LOCALS, ESCAPE(ARGS:1) + "", 0, RESULT, 0)
		RESULT = LOCAL:1
		IF ARGS:3 == "NUM"
			RETURNF TOINT(AUTO_SPLIT(LOCALS:LOCAL, "", 1))
		ELSEIF ARGS:3 == "STR"
			RESULTS = %AUTO_SPLIT(LOCALS:LOCAL, "", 1)%
			RETURNF 1
		ELSE
			THROW @GET_STRFLAGにおいてARGS:3[%ARGS:3%]の指定が異常です。
		ENDIF
	ENDIF
ELSE
	SIF ARG > 0
		CALLF ADD_STRFLAGF(ARGS, ARGS:1, ARGS:2)
	RETURNF 0
ENDIF

@GET_STRFLAG_NUM, ARGS, ARGS:1
#FUNCTION
RETURNF GET_STRFLAG(ARGS, ARGS:1, , , "NUM")

@GET_STRFLAG_STR, ARGS, ARGS:1
#FUNCTIONS
#LOCALSSIZE 1
LOCALS = %RESULTS%
CALLF GET_STRFLAG(ARGS, ARGS:1, , , "STR")
SWAP LOCALS, RESULTS
RETURNF LOCALS
