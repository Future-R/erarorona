@DAYS, ARG = -1
#FUNCTION
ARG = ARG == -1 ? DAY # ARG
RETURNF ARG % 30 + 1

@MONTH, ARG = -1
#FUNCTION
ARG = ARG == -1 ? DAY # ARG
RETURNF (ARG % 360) / 30 + 1

@YEAR, ARG = -1
#FUNCTION
ARG = ARG == -1 ? DAY # ARG
RETURNF ARG / 360 + 1

@SHOW_DAY, ARG = -1
#FUNCTIONS
ARG = ARG == -1 ? DAY # ARG
RETURNF @"第{YEAR(ARG)}年 {MONTH(ARG),2}月 {DAYS(ARG),2}日"

@CONVERT_DAY, ARG, ARG:1, ARG:2
#FUNCTION
RETURNF (ARG - 1) * 360 + (ARG:1 - 1) * 30 + (ARG:2 - 1)
