;-------------------------------------------------
;カスタムバー用色セット関数@BARCOLORSET
;PRINT_COLORBARのARG:3に利用し、ARG;4にRESULTを使う
;ARGが真の場合、逆のがかえってくる
;-------------------------------------------------
@BARCOLORSET, ARGS, ARG
#FUNCTION
 ;LOCALに色を代入
SELECTCASE ARGS
	CASE "红"
		IF ARG
			RESULT:1 = 0xC07070
			RETURNF 0x502020
		ELSE
			RESULT:1 = 0x502020
			RETURNF 0xC07070
		ENDIF
	CASE "蓝"
		IF ARG
			RESULT:1 = 0x7070C0
			RETURNF 0x202050
		ELSE
			RESULT:1 = 0x202050
			RETURNF 0x7070C0
		ENDIF
	CASE "绿"
		IF ARG
			RESULT:1 = 0x70C070
			RETURNF 0x205020
		ELSE
			RESULT:1 = 0x205020
			RETURNF 0x70C070
		ENDIF
	CASE "紫"
		IF ARG
			RESULT:1 = 0xC070C0
			RETURNF 0x502050
		ELSE
			RESULT:1 = 0x502050
			RETURNF 0xC070C0
		ENDIF
	CASE "黄色"
		IF ARG
			RESULT:1 = 0xC0C070
			RETURNF 0x505020
		ELSE
			RESULT:1 = 0x505020
			RETURNF 0xC0C070
		ENDIF
	CASE "蓝绿"
		IF ARG
			RESULT:1 = 0x70C0C0
			RETURNF 0x205050
		ELSE
			RESULT:1 = 0x205050
			RETURNF 0x70C0C0
		ENDIF
	 ;白
	 CASEELSE
		IF ARG
			RESULT:1 = 0xC0C0C0
			RETURNF 0x202020
		ELSE
			RESULT:1 = 0x202020
			RETURNF 0xC0C0C0
		ENDIF
ENDSELECT