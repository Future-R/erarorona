@COLORPRINT, ARGS, ARGS:1, ARG = -1
CALL SET_COLOR, ARGS:1, ARG
IF IS_WINDOW
	PRINTBUTTON ARGS, ""
ELSE
	PRINTPLAINFORM %ARGS%
ENDIF
CALL SET_COLOR, "PREV"

@COLORPRINTL, ARGS, ARGS:1, ARG = -1
CALL COLORPRINT, ARGS, ARGS:1, ARG
PRINTL 

@SET_COLOR, ARGS, ARG = -1
SETCOLOR COLOR(ARGS, ARG)
;----------------------------------------------------------
;@COLOR
;ARGS 色名称
;ARG  明度をARGパーセントに変更
;----------------------------------------------------------
@COLOR, ARGS, ARG = -1
#FUNCTION
#LOCALSIZE 1
#DIM PREV
IF ARGS == "PREV"
	RETURNF PREV
ELSE
	PREV = GETCOLOR()
ENDIF
SELECTCASE TOUPPER(ARGS)
	CASE "RESET", "DEFAULT", "DEF"
		LOCAL = GETDEFCOLOR()
	CASE "BG"
		LOCAL = GETBGCOLOR()
	CASE "DEFBG"
		LOCAL = GETDEFBGCOLOR()
	CASE "RED", "红"
		LOCAL =  0x990000
	CASE "P-RED", "PASTEL-RED", "浅红"
		LOCAL =  0xC07070
	CASE "P-BLUE", "PASTEL-BLUE", "浅蓝"
		LOCAL =  0x7070C0
	CASE "P-GREEN", "PASTEL-GREEN", "浅绿"
		LOCAL =  0x70C070
	CASE "P-PURPLE", "PASTEL-PURPLE", "浅紫"
		LOCAL =  0xC070C0
	CASE "P-YELLOW", "PASTEL-YELLOW", "暗黄"
		LOCAL =  0x505020
	CASE "P-BGREEN", "P-BLUEGREEN", "PASTELDARK-BLUEGREEN", "浅蓝绿"
		LOCAL =  0x205050
	CASE "WHITE", "白"
		LOCAL =  0xC0C0C0
	CASE "BLACK", "黑"
		LOCAL =  0x000000
	CASE "AQUA", "水色"
		LOCAL =  0x66FFFF
	CASE "GRAY", "灰色"
		LOCAL =  0x404040
	CASE "LIGHT-GRAY", "明灰色"
		LOCAL =  0x777777
	CASE "PINK", "粉"
		LOCAL =  0xFF33FF
	CASE "DARK-PINK", "暗粉"
		LOCAL =  0x990099
	CASE "YELLOW", "黄"
		LOCAL =  0xFFFF00
	CASE "FOCUS"
		LOCAL =  GETFOCUSCOLOR()
	CASEELSE
		IF ISNUMERIC(ARGS)
			LOCAL = TOINT(ARGS)
		ELSE
			THROW 指定了@COLOR中未注册的名称[%ARGS%]。
		ENDIF
ENDSELECT
SIF ARG >= 0
	LOCAL = BRIGHTCOLORF(ARG, LOCAL)
RETURNF LOCAL


