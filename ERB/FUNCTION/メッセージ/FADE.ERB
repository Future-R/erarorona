@SHOW_SITUATION, ARGS, ARG = -1, ARG:1
#LOCALSSIZE 1
ARG = ARG == -1 ? DAY # ARG
ALIGNMENT CENTER
LOCALS = %TEXTTAG("L") * 18%
LOCALS += SHOW_DAY(ARG) + TEXTTAG("L") + TEXTTAG("L") + ARGS
CALL FADE_ALL, LOCALS
ALIGNMENT LEFT
IF !ARG:1
	DRAWLINE
	PRINTFORML 　%SHOW_DAY(ARG)%%"", 10%-%ARGS%-%"",20%资金:{MONEY:0, 9}克尔
	DRAWLINE
ENDIF

IF ARGS == ""
	CALL ADD_LINE, MAXLINE() - 3 - 6
ELSE
	CALL PRINT_IMAGE(ARGS, 3000, "left")
	PRINTL
ENDIF