@FADE, ARGS, ARG = 16, ARGS:1 = "DEF", ARGS:2 = "IN", ARG:2
#DIM LINE
#DIM P_COLOR
P_COLOR = GETCOLOR()
LINE = LINECOUNT
FOR LOCAL, ARGS:2 == "IN" ? 0 # ARG, ARGS:2 == "IN" ? ARG # -1, ARGS:2 == "IN" ? 1 # -1
	CLEARLINE LINECOUNT - LINE
	CALL SET_FADECOLOR, ARGS:1, LOCAL, ARG
	FOR LOCAL:1, 0, STRLENSU(ARGS)
		LOCALS = %SUBSTRINGU(ARGS, LOCAL:1,1)%
		SELECTCASE LOCALS
			CASE TEXTTAG("L")
				PRINTL 
			CASE TEXTTAG("W")
			CASE TEXTTAG("FW")
			CASE TEXTTAG("COLOR")
				ENCODETOUNI %SUBSTRINGU(ARGS, LOCAL:1 + 1, 1)%
				LOCAL:2 = RESULT:1 * 16 * 16 * 16
				ENCODETOUNI %SUBSTRINGU(ARGS, LOCAL:1 + 2, 1)%
				LOCAL:2 += RESULT:1
				CALL SET_FADECOLOR, LOCAL:2, LOCAL, ARG
				LOCAL:1 += 2
			CASEELSE
				PRINTS LOCALS
		ENDSELECT
	NEXT
	CALL EQUATE_LINE, LINE + ARG:2
	TWAIT 100, 0
NEXT

@FADE_ALL, ARGS, ARG = 32, ARGS:1 = "DEF", ARGS:2 = "IN"
#LOCALSSIZE 50
#LOCALSIZE 4
#DIMS TEMPS
#DIM LINE
#DIM LOCALSNUM
#DIM P_COLOR
P_COLOR = GETCOLOR()
SPLIT ARGS, "/", LOCALS
LOCALSNUM = RESULT
LINE = LINECOUNT
FOR LOCAL, 0, LOCALSNUM
	SIF MESSKIP()
		LOCAL = LOCALSNUM - 1
	CLEARLINE LINECOUNT - LINE
	FOR LOCAL:1, 0, LOCAL
		CALL SET_COLOR, ARGS:1
		FOR LOCAL:2, 0, STRLENSU(LOCALS:(LOCAL:1))
			TEMPS = %SUBSTRINGU(LOCALS:(LOCAL:1), LOCAL:2,1)%
			SELECTCASE TEMPS
				CASE TEXTTAG("L")
					PRINTL 
				CASE TEXTTAG("W")
				CASE TEXTTAG("FW")
				CASE TEXTTAG("COLOR")
					ENCODETOUNI %SUBSTRINGU(LOCALS:(LOCAL:1), LOCAL:2 + 1, 1)%
					LOCAL:3 = RESULT:1 * 16 * 16 * 16
					ENCODETOUNI %SUBSTRINGU(LOCALS:(LOCAL:1), LOCAL:2 + 2, 1)%
					LOCAL:3 += RESULT:1
					CALL SET_COLOR, LOCAL:3
					LOCAL:2 += 2
				CASEELSE
					PRINTS TEMPS
			ENDSELECT
		NEXT
		PRINTL 
	NEXT
	CALL FADE, LOCALS:LOCAL, ARG, ARGS:1, ARGS:2, MAXLINE() - (LINECOUNT - LINE)
NEXT
SIF MESSKIP()
	FORCEWAIT
SETCOLOR P_COLOR
@FADECOLOR, ARGS, ARG, ARG:1
#FUNCTION
#LOCALSIZE 2
LOCAL = COLOR(ARGS)
LOCAL:1 = LOCAL / (256 * 256) * ARG / ARG:1 * 256 * 256
LOCAL:1 += (LOCAL / 256 % 256) * ARG / ARG:1 * 256
LOCAL:1 += (LOCAL % 256) * ARG / ARG:1
RETURNF LOCAL:1

@SET_FADECOLOR, ARGS, ARG, ARG:1
SETCOLOR FADECOLOR(ARGS, ARG, ARG:1)

