@PRINT_TAG, ARGS, ARG, ARGS:1, ARGS:2, ARGS:3
#LOCALSIZE 3
#LOCALSSIZE 2
#DIMS L_RESULTS
#DIM GROUP
#DIM BUTTON
#DIMS BUTTONS
#DIM L_COLOR
#DIM EMPTY
L_COLOR = GETCOLOR()
BUTTON = 0
GROUP = 0
L_RESULTS =
IF ARG
	EMPTY = ARG - TEXTTAG_STRLENS(ARGS)
	IF ARGS:1 == "RIGHT"
		FOR LOCAL, 0, EMPTY
			IF ARGS:2 == "牡丹"
				PRINTBUTTON " ", ARGS:3
			ELSE
				PRINTPLAIN  
			ENDIF
		NEXT
		EMPTY = 0
	ELSEIF ARGS:1 == "CENTER"
		FOR LOCAL, 0, EMPTY / 2
			IF ARGS:2 == "牡丹"
				PRINTBUTTON " ", ARGS:3
			ELSE
				PRINTPLAIN  
			ENDIF
		NEXT
		EMPTY = EMPTY / 2 + EMPTY % 2
	ENDIF
ELSE
	EMPTY = 0
ENDIF
FOR LOCAL:1, 0, STRLENSU(ARGS)
	LOCALS = %SUBSTRINGU(ARGS, LOCAL:1,1)%
	SELECTCASE LOCALS
		CASE TEXTTAG("L")
			PRINTL 
		CASE TEXTTAG("W")
			WAIT
		CASE TEXTTAG("FW")
			FORCEWAIT
		CASE TEXTTAG("COLOR")
			ENCODETOUNI %SUBSTRINGU(ARGS, LOCAL:1 + 1, 1)%
			LOCAL:2 = RESULT:1 * 16 * 16 * 16
			ENCODETOUNI %SUBSTRINGU(ARGS, LOCAL:1 + 2, 1)%
			LOCAL:2 += RESULT:1
			SETCOLOR LOCAL:2
			LOCAL:1 += 2
		CASEELSE
			IF ARGS:2 == "牡丹"
				PRINTBUTTON LOCALS, ARGS:3
			ELSE
				IF BUTTON || GROUP
					LOCALS:1 += LOCALS
				ELSE
					PRINTPLAINFORM %LOCALS%
				ENDIF
			ENDIF
			L_RESULTS += LOCALS
	ENDSELECT
NEXT
FOR LOCAL, 0, EMPTY
	IF !BUTTON
		IF ARGS:2 == "牡丹"
			PRINTBUTTON " ", ARGS:3
		ELSE
			PRINTPLAIN  
		ENDIF
	ELSE
		PRINTBUTTON " ", BUTTONS
	ENDIF
NEXT
SETCOLOR L_COLOR

@PRINT_TAGL, ARGS, ARG, ARGS:1
CALL PRINT_TAG, ARGS + TEXTTAG("L"), ARG, ARGS:1

@PRINT_TAGW, ARGS, ARG, ARGS:1
CALL PRINT_TAG, ARGS + TEXTTAG("W"), ARG, ARGS:1

@PRINT_TAGBUTTON, ARGS, ARGS:1, ARG, ARGS:2
CALL PRINT_TAG, ARGS, ARG, ARGS, "牡丹", ARGS:1

@PRINT_TAGBUTTONL, ARGS, ARGS:1, ARG, ARGS:2
CALL PRINT_TAGBUTTON, ARGS + TEXTTAG("L"), ARGS:1, ARG, ARGS:2

@PRINT_TAGBUTTONW, ARGS, ARGS:1, ARG, ARGS:2
CALL PRINT_TAGBUTTON , ARGS + TEXTTAG("W"), ARGS:1, ARG, ARGS:2

@TEXTTAG, ARGS, ARGS:1, ARGS:2
#FUNCTIONS
#LOCALSIZE 1
SELECTCASE TOUPPER(ARGS)
	CASE "NULL"
		RETURNF UNICODE(0x0000)
	CASE "L", "BR"
		RETURNF UNICODE(0x000A)
	CASE "W"
		RETURNF UNICODE(50001)
	CASE "FW"
		RETURNF UNICODE(50002)
	CASE "PAGE"
		RETURNF UNICODE(50010)
	CASE "COLOR"
		IF ARGS:1 == ""
			RETURNF UNICODE(50003)
		ELSE
			IF COLOR(ARGS:1) >= 0
				LOCAL = COLOR(ARGS:1)
			ELSE
				LOCAL = TOINT(ARGS:1)
			ENDIF
			IF ARGS:2 == ""
				RETURNF UNICODE(50003) + UNICODE(LOCAL / 16 / 16 / 16) + UNICODE(LOCAL % (16 * 16 * 16))
			ELSE
				RETURNF UNICODE(50003) + UNICODE(LOCAL / 16 / 16 / 16) + UNICODE(LOCAL % (16 * 16 * 16)) + ARGS:2 + UNICODE(50003) + UNICODE(GETCOLOR() / 16 / 16 / 16) + UNICODE(GETCOLOR() % (16 * 16 * 16))
			ENDIF
		ENDIF
	CASEELSE
		THROW 指定了未注册的Tag<%ARGS%>
ENDSELECT

@TEXTTAGS, ARGS
#FUNCTIONS
SELECTCASE ARGS
	CASE UNICODE(50000)
		RETURNF "L"
	CASE UNICODE(50001)
		RETURNF "W"
	CASE UNICODE(50002)
		RETURNF "FW"
	CASE UNICODE(50003)
		RETURNF "COLOR"
	CASE UNICODE(50004)
		RETURNF "BUTTON"
	CASE UNICODE(50005)
		RETURNF "BUTTONEND"
	CASE UNICODE(50006)
		RETURNF "DRAWLINE"
	CASE UNICODE(50007)
		RETURNF "GROUP"
	CASE UNICODE(50008)
		RETURNF "GROUPEND"
	CASEELSE
		RETURNF "NONE"
ENDSELECT

@TEXTTAG_STRLENS(ARGS)
#LOCALSIZE 2
#FUNCTION
LOCAL:1 = 0
FOR LOCAL, 0, STRLENSU(ARGS)
	SELECTCASE TEXTTAGS(SUBSTRINGU(ARGS,LOCAL,1))
		CASE "L", "W", "FW"
		CASE "BUTTON"
			LOCAL++
		CASE "COLOR"
			LOCAL += 2
		CASEELSE
			LOCAL:1 += EX_STRLENS_SUB(SUBSTRINGU(ARGS,LOCAL,1))
	ENDSELECT
NEXT
RETURNF LOCAL:1

@EX_STRLENS(ARGS)
#LOCALSIZE 2
#FUNCTION
LOCAL:1 = 0
FOR LOCAL, 0, STRLENSU(ARGS)
	LOCAL:1 += EX_STRLENS_SUB(SUBSTRINGU(ARGS,LOCAL,1))
NEXT
RETURNF LOCAL:1

@EX_STRLENS_SUB(ARGS)
#FUNCTION
#LOCALSIZE 2
LOCAL = RESULT, RESULT:1
ENCODETOUNI %ARGS%
SWAP RESULT, LOCAL
SWAP RESULT:1, LOCAL:1
SELECTCASE LOCAL:1
	CASE 0x0020 TO 0x007E + 1
	CASE 0xFF61 TO 0xFFDC + 1
	CASE 0xFFE8 TO 0xFFEE + 1
	CASEELSE
		SELECTCASE ARGS
			CASE " ", "◀", "▶"
			CASEELSE
				RETURNF 2
		ENDSELECT
ENDSELECT
RETURNF 1
