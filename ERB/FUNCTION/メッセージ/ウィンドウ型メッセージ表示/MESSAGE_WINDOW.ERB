;------------------------------------------------------------------------------------------------------------
; ARGS：显示在窗口上边框的名字。
; ARGS:1：要显示的文本。
; 分隔符：用于将 ARGS:1 中的长文本分割成多行的字符，默认为 /。
; 选项：核心参数，一个用 / 分隔的字符串，用于开关各种功能。
; 	保留日志/不保留日志: 决定显示完毕后是否清除窗口。
; 	使用按钮/不使用按钮: 是否在窗口下方显示 [日志] [自动] [跳过] [设置] 等功能按钮。
; 	重复使用/禁止复用: 是否在前一个消息框的基础上继续显示，实现无缝衔接。
; 	不再等待: 显示完毕后不等待玩家输入，直接继续执行后续代码。
; 	没有动画: 立即显示所有文本，跳过动画效果。
; 	不进日志: 本次消息不保存到历史记录中。
; 	无需点击: 文本区域本身不作为可点击的按钮。
; 位置: 整个窗口在屏幕上的对齐方式 (LEFT, CENTER, RIGHT)。
; 宽度, 行数: 手动指定窗口的宽度和行数。
; 显示类型: 动画类型，TYPE (打字机) 或 FADE (淡入)。
; 淡入间隔, 终色: FADE 动画的专属参数，控制每行淡入的速度和最终颜色。
; 文字列体裁: 文本内容在窗口内部的对齐方式 (LEFT, CENTER, RIGHT)。
; 调用函数：暂未使用
;------------------------------------------------------------------------------------------------------------
@MESSAGE_WINDOW, ARGS, ARGS:1, 分隔符 = "/" , 选项 = "不留日志/使用按钮/禁止复用" , 位置 , 宽度 = 122, 行数 = 4 , 显示类型 = "TYPE" , 淡入间隔 = 10 , 终色 = -1 , 文字列体裁 = "LEFT", 调用函数
#LOCALSIZE 10
#LOCALSSIZE 50
#DIMS 保存文字列 , 50
#DIM 颜色 , 3

#DIM TEMP

#DIMS 选项
#DIMS 分隔符
#DIMS 位置
#DIM 宽度
#DIM 行数
#DIMS 显示类型
#DIM 淡入间隔
#DIM 终色
#DIMS 文字列体裁
#DIMS 调用函数

#DIMS 表示文字列
#DIMS 上次ARGS
#DIMS 上次发言者
#DIM 上次宽度
#DIM 上次行数
#DIMS 上次位置
#DIM LINE
#DIM 元速度
#DIM 速度
#DIM 已获取日志
#DIMS L_RESULTS
#DIM L_SECOND, 2
#DIMS 扩展按钮日志, 50

#DIMS TEMPS
#DIM 原REDRAW
#DIM 时间差
#DIM 动画进度
#DIM 正文分隔数
#DIM 总动画字数
#DIM 已完整显示行数
#DIM 已完整显示字数
#DIM 居中左空白
#DIM 本帧仍在动画

; 记录当前屏幕行数，用于后续的清屏和重绘
LINE = LINECOUNT
; 保存当前的重绘状态，以便在函数结束时恢复
原REDRAW = CURRENTREDRAW()
已获取日志 = 0
; 自动加速系数只应在当前消息窗口内生效，避免连续文本越播越快
FLAG:消息加速系数 = 1

; 点击区域扩张：如果启用了此功能且有动画，则将消息窗口上方的所有已显示内容也变成可点击的跳过按钮
IF !STRCOUNT(选项, "没有动画") && GLOBAL:点击区域扩张
	FOR LOCAL, 0, MAXLINE() - (行数 + 1)
		扩展按钮日志:LOCAL = 
		HTML_TAGSPLIT HTML_GETPRINTEDSTR(MAXLINE() - (行数 + 2) - LOCAL)
		;TAGからボタンを剥がす
		FOR LOCAL:1, 0, RESULT
			SIF STRCOUNT(RESULTS:(LOCAL:1), "<p align")
				CONTINUE
			SIF RESULTS:(LOCAL:1) == "</p>"
				CONTINUE
			SIF STRCOUNT(RESULTS:(LOCAL:1), "<button")
				CONTINUE
			SIF RESULTS:(LOCAL:1) == "</button>"
				CONTINUE
			SIF STRCOUNT(RESULTS:(LOCAL:1), "<nonbutton")
				CONTINUE
			SIF RESULTS:(LOCAL:1) == "</nonbutton>"
				CONTINUE
			扩展按钮日志:LOCAL += RESULTS:(LOCAL:1)
		NEXT
		扩展按钮日志:LOCAL '= REPLACE(扩展按钮日志:LOCAL, "shpae", "shape")
		扩展按钮日志:LOCAL '= ADD_BTAG(扩展按钮日志:LOCAL, "扩展按钮")
		; 补全空格整行
		扩展按钮日志:LOCAL += ADD_BTAG(" " * MAX((MAXWIDTH() - STRLENS(HTML_TOPLAINTEXT(扩展按钮日志:LOCAL))),0), "扩展按钮")
	NEXT
ENDIF
; --- 动画速度设置 ---
IF 显示类型 == "FADE"
	速度 = 1
ELSE
	元速度 = MAX(1, GLOBAL:消息速度)
	速度 = 元速度 * MAX(FLAG:消息加速系数, 1)
ENDIF
; -- FADE效果的颜色初始化 ---
SIF 显示类型 == "FADE"
	颜色:0 = GETCOLOR()
SIF 显示类型 == "FADE" && 终色 == -1
	颜色:1 = 颜色:0

; 确保姓名字节数为偶数，防止边框错位
SIF STRLENS(ARGS) % 2
	ARGS += " "
; 如果发言者姓名不为空，则添加装饰性边框
SIF ARGS != ""
	ARGS = ┤%ARGS%├

; 如果全局设置了禁用消息动画，则自动为本次调用添加“没有动画”选项
SIF GLOBAL:消息动画停止
	选项 += "/没有动画"

; --- 重复使用模式的逻辑处理 ---
IF STRCOUNT(选项, "重复使用/使用按钮")
	SIF ARGS == ""
		ARGS = %上次发言者%
	SIF !行数
		行数 = 上次行数
	SIF 位置 == ""
		位置 = %上次位置%
	ARGS:1 = %上次ARGS%\@ARGS:1 != "" ? %分隔符%%ARGS:1% # \@
	宽度 = MAX(宽度 , 上次宽度)
	IF 显示类型 == "TYPE"
		动画进度 = 总动画字数 - 速度
	ELSEIF 显示类型 == "FADE"
		动画进度 = 已完整显示行数 * 淡入间隔 - 1
	ENDIF
	; 删除上一条日志记录，因为之后会把合并后的新消息作为一个整体重新记入日志
	CALL MESSAGE_WINDOW_LOG(, , , , , -1)
ELSE
	; --- 非“重复使用”模式的初始化 ---
	SIF 位置 == ""
		位置 = LEFT
	VARSET LOCALS , ""
	动画进度 = -1
	; 已完整显示的行数
	已完整显示行数 = 0
	; 已完整显示的字符总数
	已完整显示字数 = 0
ENDIF
VARSET 保存文字列
SPLIT ARGS:1 , 分隔符, 保存文字列


; 计算宽度：遍历所有行，取最长一行的长度作为基准，确保所有内容都能容纳
FOR LOCAL:1 , 0 , 50
	宽度 = MAX(宽度 , (STRLENS(保存文字列:(LOCAL:1))+1) / 2 * 2)
NEXT

; 计算行数：如果未手动指定行数，则根据分隔符数量自动计算
正文分隔数 = STRCOUNT(ARGS:1, 分隔符)
;引数として渡されている場合は変更なし
SIF 行数 == -1
	行数 = 正文分隔数 + 1

; 计算需要动画显示的总字符数
总动画字数 = STRLENSU(ARGS:1) - STRLENSU(分隔符) * 正文分隔数

;===============================================================
; 动画主循环开始
;===============================================================
$START
REDRAW 0
CALL SET_ALIGNMENT, 位置
; 如果选项中包含“没有动画”，则L_RESULTS不为"A"，动画循环将只执行一次
L_RESULTS = \@STRCOUNT(选项, "没有动画") ? 没有动画 # A\@
; 动画主循环。动画进度只要未显示完所有字符，就一直循环
WHILE 总动画字数 + 速度 > 动画进度
	L_SECOND:1 = GETMILLISECOND()
	动画进度 += 速度
	本帧仍在动画 = (总动画字数 + 速度 > 动画进度)
	; --- 根据动画进度，更新已显示的完整行数和字符数 ---
	IF 显示类型 == "TYPE"
		WHILE 动画进度 - 已完整显示字数 >= STRLENSU(保存文字列:已完整显示行数) && 已完整显示行数 < 正文分隔数 + 1
			LOCALS:已完整显示行数 = %保存文字列:已完整显示行数%
			已完整显示字数 += STRLENSU(保存文字列:已完整显示行数)
			已完整显示行数 ++
		WEND
	ELSEIF 显示类型 == "FADE"
		WHILE 动画进度 >= (已完整显示行数 + 1) * 淡入间隔
			已完整显示字数 += STRLENSU(保存文字列:已完整显示行数)
			已完整显示行数 ++
		WEND
	ENDIF
	CLEARLINE LINECOUNT - LINE
	; 如果启用了“点击区域扩张”，则重绘上方的扩展按钮
	IF GLOBAL:点击区域扩张 && !STRCOUNT(选项, "没有动画")
		IF !(MESSKIP() || FLAG:跳过消息窗口) || GLOBAL:点击右键时等待时间
			FOR TEMP, 0, MAXLINE() - (行数 + 1)
				HTML_PRINT 扩展按钮日志:TEMP
			NEXT
		ENDIF
	ENDIF
	IS_WINDOW = 0
	; 如果玩家右键/点击跳过(MESSKIP)、开启了跳过模式、或动画被中断
	IF MESSKIP() || FLAG:跳过消息窗口 || L_RESULTS != "A" || (GLOBAL:消息速度 == 0 && 显示类型 != "TYPE" )
		; 直接将动画进度设置为终点
		动画进度 = (显示类型 != "FADE" ? 总动画字数 # (正文分隔数 + 1) * 淡入间隔 )
		本帧仍在动画 = 0
		已完整显示字数 = 总动画字数
		已完整显示行数 = 正文分隔数 + 1
		; 将所有行的内容一次性填充完毕
		FOR LOCAL:1 , 0 , 行数
			LOCALS:(LOCAL:1) = %保存文字列:(LOCAL:1)%
		NEXT
	ENDIF
	; --- 绘制窗口上边框及发言者 ---
	PRINTFORM %"┌" + ARGS + "─" * ((宽度 - STRLENS(ARGS)+1) / 2) + "┐"%
	PRINTL
	
	; --- 更新当前正在播放动画的行 ---
	IF 已完整显示行数 <= 正文分隔数
		IF 显示类型 == "TYPE"
			LOCALS:已完整显示行数 = %SUBSTRINGU(保存文字列:已完整显示行数 , 0 , 动画进度 - 已完整显示字数)%
		ELSE
			LOCALS:已完整显示行数 = %保存文字列:已完整显示行数%
		ENDIF
	ENDIF
	
	; --- 逐行绘制窗口内容 ---
	FOR LOCAL:1, 0, 行数
		PRINT │
		IF 显示类型 == "FADE" && LOCAL:1 == 已完整显示行数
			颜色:2 = 动画进度 - 已完整显示行数 * MAX(淡入间隔 , 1)
			SETCOLOR 颜色:1 / POWER(256 , 2) * 颜色:2 / MAX(淡入间隔 , 1) , 颜色:1 / 256 % 256 * 颜色:2 / MAX(淡入间隔 , 1) , 颜色:1 % 256 * 颜色:2 / MAX(淡入间隔 , 1)
		ELSEIF 显示类型 == "FADE"
			SETCOLOR 颜色:1
		ENDIF
		SELECTCASE 文字列体裁
			CASE "RIGHT"
				LOCALS:(LOCAL:1) '= @"%LOCALS:(LOCAL:1),宽度,RIGHT%"
			CASE "CENTER"
				IF LOCAL:1 <= 已完整显示行数
					居中左空白 = (宽度 - STRLENS(保存文字列:(LOCAL:1)))/2
					LOCALS:(LOCAL:1) '= " " * 居中左空白 + LOCALS:(LOCAL:1) + " " * (宽度 - STRLENS(LOCALS:(LOCAL:1)) - 居中左空白)
				ELSE
					LOCALS:(LOCAL:1) '= " " * 宽度 , "0"
				ENDIF
			CASEELSE
				LOCALS:(LOCAL:1) '= @"%LOCALS:(LOCAL:1),宽度,LEFT%"
		ENDSELECT
		; 虽然不知道为什么，使用无需点击会将同屏的图片变小……
		IF STRCOUNT(选项, "无需点击") && !本帧仍在动画
			PRINTPLAINFORM %LOCALS:(LOCAL:1)%
		ELSE
			PRINTBUTTON LOCALS:(LOCAL:1), "0"
		ENDIF
		
		SIF 显示类型 == "FADE"
			SETCOLOR 颜色:0
		PRINTL │
	NEXT
	; --- 绘制窗口下边框和功能按钮 ---
	PRINTFORM └%"─"*(宽度/2-23)%
	IF STRCOUNT(选项, "使用按钮")
		; 动画播放过程中，按钮不可点击
		IF 本帧仍在动画
			PRINTPLAINFORM [+] 日志 
			PRINTBUTTON @" [-] 自动<\@FLAG:自动播放 ?%"开"%#关\@>", "-"
			PRINTBUTTON @" [*] 跳过<\@FLAG:跳过消息窗口 ?%"开"%#关\@>", "*"
			PRINTPLAINFORM  [/] 设置─
		ELSE
			; 动画播放完毕，按钮变为可点击
			PRINTBUTTON "[+] 日志 ", "+"
			PRINTBUTTON @" [-] 自动<\@FLAG:自动播放 ?%"开"%#关\@>", "-"
			PRINTBUTTON @" [*] 跳过<\@FLAG:跳过消息窗口 ?%"开"%#关\@>", "*"
			PRINTBUTTON " [/] 设置─", "/"
		ENDIF
	ELSE
		PRINTFORM %"─"*23%
	ENDIF
	PRINTL ┘
	; 如果检测到跳过指令，则跳出动画循环
	SIF MESSKIP() || FLAG:跳过消息窗口 || L_RESULTS != "A"
		BREAK
	; --- 动画帧之间的输入处理 ---
	IF 总动画字数 > 动画进度 + 速度
		TONEINPUTS 100, "A" , 0, ""
		IF (GLOBAL:消息速度 == 0 && 显示类型 == "TYPE" )
			L_RESULTS '= ""
		ELSE
			L_RESULTS = %RESULTS%
		ENDIF
		IF L_RESULTS == ""
			L_SECOND = GETMILLISECOND()
		ELSE
			CLEARLINE 1
		ENDIF
	ENDIF
	; 在动画播放中途，允许切换自动和跳过状态
	IF L_RESULTS == "-" && STRCOUNT(选项, "使用按钮")
		INVERTBIT FLAG:自动播放, 0
		L_RESULTS = A
	ELSEIF  L_RESULTS == "*" && STRCOUNT(选项, "使用按钮")
		INVERTBIT FLAG:跳过消息窗口, 0
		L_RESULTS = A
	ENDIF
	; 自动加速器：根据渲染耗时动态调整打字速度，防止因卡顿导致动画变慢
	IF GLOBAL:自动加速器
		FLAG:消息加速系数 = MAX((GETMILLISECOND() - L_SECOND:1 + 30) / 100, FLAG:消息加速系数)
		SIF 显示类型 != "FADE"
			速度 = 元速度 * FLAG:消息加速系数
	ENDIF
WEND
;===============================================================
; 动画主循环结束
;===============================================================
; 恢复之前的对齐设置
CALL SET_ALIGNMENT, "PREV"
; --- 日志与状态保存 ---
; 动画结束后，并且没有设置“不进日志”，则将本次消息内容写入日志
SIF 已获取日志++ == 0 && !STRCOUNT(选项, "不进日志")
	CALL MESSAGE_WINDOW_LOG(ARGS, ARGS:1, 分隔符, 行数, 宽度)
; 保存本次窗口的状态，供下一次“重复使用”模式调用
上次ARGS = %ARGS:1%
上次发言者 = %ARGS%
上次宽度 = 宽度
上次行数 = 行数
上次位置 = %位置%
; 处理“无需点击”选项的后续剥离按钮标签的逻辑
IF STRCOUNT(选项, "无需点击")
	FOR LOCAL, 0, MAXLINE() + 1
		LOCALS:LOCAL = 
		HTML_TAGSPLIT HTML_GETPRINTEDSTR(MAXLINE() - LOCAL)
		;TAGからボタンを剥がす
		FOR LOCAL:1, 0, RESULT
			SIF STRCOUNT(RESULTS:(LOCAL:1), "<p align")
				CONTINUE
			SIF RESULTS:(LOCAL:1) == "</p>"
				CONTINUE
			SIF STRCOUNT(RESULTS:(LOCAL:1), "<button")
				CONTINUE
			SIF RESULTS:(LOCAL:1) == "</button>"
				CONTINUE
			LOCALS:LOCAL += RESULTS:(LOCAL:1)
		NEXT
	NEXT
	CLEARLINE LINECOUNT - LINE
	FOR LOCAL, 0, MAXLINE() + 1
		LOCALS:LOCAL '= REPLACE(LOCALS:LOCAL, "shpae", "shape")
		HTML_PRINT LOCALS:LOCAL
	NEXT
ENDIF

; 强制等待时间
; 演出需要用，比如获得物品时暂停音乐一段时间同时播放音效，音效播完了才能继续下一步并恢复音乐
IF 需要暂停的毫秒 > 0
	时间差 = GETMILLISECOND() - 发起暂停的毫秒
	IF 时间差 < 需要暂停的毫秒
		TWAIT 需要暂停的毫秒 - 时间差, 1
		SETBGMVOLUME GLOBAL:音量
	ENDIF
	需要暂停的毫秒 = 0
	发起暂停的毫秒 = 0
ENDIF

; --- 消息显示完毕后的等待与输入处理 ---
IF !STRCOUNT(选项, "不再等待")
	; 如果是跳过状态
	IF MESSKIP() || FLAG:跳过消息窗口
		; 根据全局设置，在跳过时短暂等待
		IF GLOBAL:点击右键时等待时间 && !STRCOUNT(选项, "没有动画")
			REDRAW 2
			TWAIT GLOBAL:点击右键时等待时间, 1
			SIF !STRCOUNT(选项, "保留日志")
				CLEARLINE LINECOUNT - LINE
		ENDIF
	ELSE
		; 如果是正常播放完毕
		IF STRCOUNT(选项, "使用按钮")
			; 自动播放模式
			IF FLAG:自动播放
				; 自动等待一段时间
				SIF GLOBAL:自动时等待
					TONEINPUTS GLOBAL:自动时等待, "A" , 0, ""
			ELSE
				ONEINPUTS
			ENDIF
			L_RESULTS = %RESULTS%
			IF L_RESULTS == ""
				SIF GETMILLISECOND() - L_SECOND < GLOBAL:双击响应时间
					INVERTBIT FLAG:跳过消息窗口, 0
			ELSE
				CLEARLINE 1
			ENDIF
			; 处理功能按钮的点击事件
			IF (GROUPMATCH(L_RESULTS, "+", "-", "/" , "*"))
				IF L_RESULTS == "+"
					CALL MESSAGE_WINDOW_LOG(, , , , , 1)
				ELSEIF L_RESULTS == "-"
					INVERTBIT FLAG:自动播放, 0
				ELSEIF L_RESULTS == "*"
					INVERTBIT FLAG:跳过消息窗口, 0
				ELSEIF L_RESULTS == "/"
					CALL MESSAGE_WINDOW_CONFIG
				ENDIF
				; 如果点击了功能按钮，则需要重绘窗口以更新按钮状态
				动画进度 = 总动画字数 + 速度 - 1
				CLEARLINE LINECOUNT - LINE
				GOTO START
			ENDIF
		ELSE
			; 不使用按钮的情况
			IF FLAG:自动播放 && !STRCOUNT(选项, "没有动画")
				SIF GLOBAL:自动时等待
					TWAIT GLOBAL:自动时等待, 0
			ELSE
				WAITANYKEY
			ENDIF
		ENDIF
		; 如果不是“保留日志”模式，则在玩家继续后清除窗口
		SIF !STRCOUNT(选项, "保留日志")
			CLEARLINE LINECOUNT - LINE
	ENDIF
ENDIF
REDRAW 原REDRAW
RETURN 1
