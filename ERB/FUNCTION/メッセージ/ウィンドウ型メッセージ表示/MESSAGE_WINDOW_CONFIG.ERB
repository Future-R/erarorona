;----------------------------------------------------
;メッセージアニメ用コンフィグ設定関数
;メッセージアニメ自体から呼べるので注意してください
;
;GLOBAL:消息速度		一回の描画における追加字数
;GLOBAL:自动时等待		オートモード時に、全ての文字表示後にウェイトをかける時間
;GLOBAL:点击右键时等待时间	右点击時に文字表示後にウェイトをかける時間
;----------------------------------------------------
@MESSAGE_WINDOW_CONFIG
#DIM LINE
LINE = LINECOUNT
$START
REDRAW 0
FOR LOCAL, 0, 50
	PRINTL 
NEXT
PRINTFORML ┌%"─"*36%┐
PRINT │
PRINTBUTTON @"%"[0] 消息速度", 48, LEFT%{GLOBAL:消息速度,22,RIGHT}字", 0
PRINTL │
PRINT │
PRINTBUTTON @"%"[1] 自动时等待",48, LEFT%{GLOBAL:自动时等待, 22}ms", 1
PRINTL │
PRINT │
PRINTBUTTON @"%"[2] 点击右键时等待时间", 48, LEFT%{GLOBAL:点击右键时等待时间, 22}ms",2
PRINTL │
PRINT │
PRINTBUTTON @"%"[3] 启用消息动画" , 48 , LEFT%\@GLOBAL:消息动画停止 ? %"禁用" , 24% # %"启用",24%\@", 3
PRINTL │
PRINT │
PRINTBUTTON @"%"[4] 点击区域扩张" , 48 , LEFT%\@GLOBAL:点击区域扩张 ? %"使用中" , 24% # %"停止中",24%\@", 4
PRINTL │
PRINT │
PRINTBUTTON @"%"[5] 双击响应时间" , 48 , LEFT%{GLOBAL:双击响应时间, 22}ms",5
PRINTL │
PRINT │
PRINTBUTTON @"%"[6] 自动加速器" , 48 , LEFT%\@GLOBAL:自动加速器 ? %"使用中" , 24% # %"停止中",24%\@", 6
PRINTL │
PRINT │
PRINTBUTTON @"%"[9] 设置完毕",72, LEFT%", 9
PRINTL │
PRINTFORML └%"─"*36%┘
CALL INPUTINT, 0, 1, 2, 3, 4, 5, 6, 9
CLEARLINE 11
SELECTCASE RESULT
	CASE 0
		PRINTFORML ┌%"─"*36%┐
		PRINTFORML │%"设置打字机方式的消息速度", 72, LEFT%│
		PRINTFORML │%"每0.1秒显示输入数值的字数", 72, LEFT%│
		PRINTFORML │%"若输入0，则停止打字机方式的动画", 72, LEFT%│
		PRINTFORML │%"请输入0-9之间的数值", 72, LEFT%│
		PRINTFORML └%"─"*36%┘
		CALL INPUT_MANY(0, 9)
		GLOBAL:消息速度 = RESULT
	CASE 1
		PRINTFORML ┌%"─"*36%┐
		PRINTFORML │%"设置启用AUTO时的等待时间", 72, LEFT%│
		PRINTFORML │%"AUTO功能开启时，当文字全部显示后", 72, LEFT%│
		PRINTFORML │%"经过设置的时间将自动进入下一页面", 72, LEFT%│
		PRINTFORML │%"单位为1ms，若设置的数值小于100则进入无等待模式", 72, LEFT%│
		PRINTFORML └%"─"*36%┘
		CALL INPUT_MANY(0, 10000)
		SIF RESULT < 100
			RESULT = 0
		GLOBAL:自动时等待 = RESULT
	CASE 2
		PRINTFORML ┌%"─"*36%┐
		PRINTFORML │%"设置点击右键时等待时间", 72, LEFT%│
		PRINTFORML │%"点击右键时，将根据设置的时间", 72, LEFT%│
		PRINTFORML │%"为显示消息添加等待时间", 72, LEFT%│
		PRINTFORML │%"单位为1ms，若设置的数值小于100则进入无等待模式", 72, LEFT%│
		PRINTFORML └%"─"*36%┘
		CALL INPUT_MANY(0, 10000)
		SIF RESULT < 100
			RESULT = 0
		GLOBAL:点击右键时等待时间 = RESULT
	CASE 3
		PRINTFORML ┌%"─"*36%┐
		PRINTFORML │%"设置是否要使用消息动画", 72, LEFT%│
		PRINTFORML │%"如果设置为禁用", 72, LEFT%│
		PRINTFORML │%"则会停止淡入、打字机两种方式的动画", 72, LEFT%│
		PRINTFORML └%"─"*36%┘
		CALL INPUT_YN, "启用" , "禁用"
		GLOBAL:消息动画停止 = RESULT
	CASE 4
		PRINTFORML ┌%"─"*36%┐
		PRINTFORML │%"设置是否要将消息动画中的按钮全屏化", 72, LEFT%│
		PRINTFORML │%"如果设置为全屏化，点击消息栏以外的区域时", 72, LEFT%│
		PRINTFORML │%"将视为点击消息栏并跳过显示", 72, LEFT%│
		PRINTFORML │%"但启用后，每帧处理时间会增加", 72, LEFT%│
		PRINTFORML └%"─"*36%┘
		CALL INPUT_YN, "启用" , "禁用"
		GLOBAL:点击区域扩张 = !RESULT
	CASE 5
		PRINTFORML ┌%"─"*36%┐
		PRINTFORML │%"设置双击响应时间", 72, LEFT%│
		PRINTFORML │%"双击消息可进入跳过模式", 72, LEFT%│
		PRINTFORML │%"单位为1ms，通常的双击响应时间约为250ms",72,LEFT%│
		PRINTFORML │%"若设置的数值小于100，则不再处理双击操作", 72, LEFT%│
		PRINTFORML └%"─"*36%┘
		CALL INPUT_MANY(0, 2000)
		SIF RESULT < 100
			RESULT = 0
		GLOBAL:双击响应时间 = RESULT
	CASE 6
		PRINTFORML ┌%"─"*36%┐
		PRINTFORML │%"设置是否启用文字速度的自动加速", 72, LEFT%│
		PRINTFORML │%"如果１帧时间（默认100ms）超过一定时长", 72, LEFT%│
		PRINTFORML │%"将通过增加显示字数来模拟加速效果",72,LEFT%│
		PRINTFORML └%"─"*36%┘
		CALL INPUT_YN, "启用" , "禁用"
		GLOBAL:自动加速器 = !RESULT
	CASE 9
		CLEARLINE LINECOUNT - LINE
		REDRAW 1
		RETURN 1
ENDSELECT
SAVEGLOBAL
CLEARLINE LINECOUNT - LINE
GOTO START
