;-------------------------------------
;メッセージアニメ用日志取得&表示関数
;ARGS 		内容ですがメッセージアニメと違って名前部分も含み、0行目が名前にあたります
;			
;-------------------------------------
@MESSAGE_WINDOW_LOG, ARGS, ARGS:1, ARGS:2, ARG, ARG:1, ARG:2
#DIMS 日志, 200
#DIMS 分隔符, 200
#DIM 宽度, 200
#LOCALSIZE 3
#LOCALSSIZE 3
IF ARG:2 > 0
	LOCAL:2 = LINECOUNT
 	FOR LOCAL, 0, 50
 		PRINTL 
 	NEXT
	FOR LOCAL, 199, -1, -1
		SIF 日志:LOCAL == ""
			CONTINUE
		SPLIT 日志:LOCAL, 分隔符:LOCAL, RESULTS
		PRINTFORML ┌%RESULTS%%"─"*((宽度:LOCAL-STRLENS(RESULTS))/2)%┐
		FOR LOCAL:1, 1, RESULT
			PRINTFORML │%RESULTS:(LOCAL:1),宽度:LOCAL,LEFT%│
		NEXT
		PRINTFORML └%"─"*(宽度:LOCAL/2)%┘
	NEXT
	WAITANYKEY
	CLEARLINE LINECOUNT - LOCAL:2
ELSEIF ARG:2 < 0
	ARRAYREMOVE 日志, 0, 1
	ARRAYREMOVE 分隔符, 0, 1
	ARRAYREMOVE 宽度,  0, 1
ELSE
	;名前と内容をまとめる
	ARGS += ARGS:2 + ARGS:1
	;行数にあわせて分隔符を追加する
	ARGS += ARGS:2 * MAX(ARG - STRCOUNT(ARGS, ARGS:2),0)
	ARRAYSHIFT 日志, 1, ARGS, 0, 200
	ARRAYSHIFT 分隔符, 1, ARGS:2, 0, 200
	ARRAYSHIFT 宽度, 1, ARG:1, 0, 200
ENDIF
