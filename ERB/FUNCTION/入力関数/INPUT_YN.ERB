;-------------------------------------------------
;2択提示関数　@INPUT_YN
;いちいち、INPUT_LOOP書くのめんどいよ！
;っていうか、2択提示はめちゃめちゃ多いんだから、関数化しちゃえばいいじゃないかときづく
;INPUTINTでもまぁほとんど同じだけど、これほんとよく使う定形だから、別関数として独立させる
;0、1しかこないのでONEINPUTに変更
;-------------------------------------------------
@INPUT_YN,ARGS = "确定",ARGS:1 = "取消",ARG = 1
#LOCALSIZE 1
LOCAL = CURRENTREDRAW()
REDRAW 0
SELECTCASE ARG
	CASE 1
		PRINTFORML [0] %ARGS%
		PRINTFORML [1] %ARGS:1%
	CASE 2
		PRINTFORM [0] %ARGS% 
		PRINTFORML [1] %ARGS:1%
ENDSELECT
$INPUT_LOOP

ONEINPUTS
IF RESULTS == "0" || RESULTS == " "
	REDRAW LOCAL
	RETURN 0
ELSEIF RESULTS == "1"
	REDRAW LOCAL
	RETURN 1
ELSE
	SIF RESULTS != ""
		CLEARLINE 1
	REUSELASTLINE 
	GOTO INPUT_LOOP
ENDIF