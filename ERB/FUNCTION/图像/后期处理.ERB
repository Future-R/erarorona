@重置颜色矩阵
#FUNCTION
VARSET Matrix, 0
Matrix:0:0 = 256
Matrix:1:1 = 256
Matrix:2:2 = 256
Matrix:3:3 = 256
Matrix:4:4 = 256

; 负数则为降低，取值范围-256~256
@改变明度, ARG
#FUNCTION
Matrix:4:0 = ARG
Matrix:4:1 = ARG
Matrix:4:2 = ARG

; 取值范围0~256
@改变透明度, ARG
#FUNCTION
Matrix:3:3 = ARG

; 取值范围大于0
@改变RGB, ARG:0, ARG:1, ARG:2
#FUNCTION
Matrix:0:0 = ARG:0
Matrix:1:1 = ARG:1
Matrix:2:2 = ARG:2

@测试打印图像
LOCAL:0 = SPRITEWIDTH("野外")
LOCAL:1 = SPRITEHEIGHT("野外")
GCREATE 0, LOCAL:0, LOCAL:1
CALLF 重置颜色矩阵()
CALLF 改变RGB(1024, 256, 256)
GDRAWSPRITE 0, "野外", 0, 0, LOCAL:0, LOCAL:1, Matrix:0:0
SPRITECREATE "新野外", 0

; 剧情演出所需，调用后会创建一个 原图像 + "_暗" 的图像
@压暗肖像, 原图像, 槽位 = 1 
#FUNCTION
#DIM 槽位
#DIMS 原图像

LOCAL:0 = SPRITEWIDTH(原图像)
LOCAL:1 = SPRITEHEIGHT(原图像)
GCREATE 槽位, LOCAL:0, LOCAL:1
CALLF 重置颜色矩阵()
CALLF 改变明度(-128)
GDRAWSPRITE 槽位, 原图像, 0, 0, LOCAL:0, LOCAL:1, Matrix:0:0
SPRITECREATE 原图像 + "_暗", 槽位

; 剧情演出所需，调用后会创建帧数-1张图像
@淡入动画帧, 原图像, 帧数 = 24, 起始槽位 = 1000
#FUNCTION
#DIM 帧数
#DIM 起始槽位
#DIMS 原图像

LOCAL:0 = SPRITEWIDTH(原图像)
LOCAL:1 = SPRITEHEIGHT(原图像)

CALLF 重置颜色矩阵()

; 透明度步进值
LOCAL:2 = 256 / 帧数
; 从1开始数，所以起始槽位先减1
起始槽位 -= 1
FOR COUNT, 1, 帧数
    CALLF 改变透明度(COUNT * LOCAL:2)
    GCREATE 起始槽位 + COUNT, LOCAL:0, LOCAL:1
    GDRAWSPRITE 起始槽位 + COUNT, 原图像, 0, 0, LOCAL:0, LOCAL:1, Matrix:0:0
    SPRITECREATE 原图像 + TOSTR(COUNT), 起始槽位 + COUNT
NEXT

@淡出动画帧, 原图像, 帧数 = 24, 起始槽位 = 1000
#FUNCTION
#DIM 帧数
#DIM 起始槽位
#DIMS 原图像

LOCAL:0 = SPRITEWIDTH(原图像)
LOCAL:1 = SPRITEHEIGHT(原图像)

CALLF 重置颜色矩阵()
CALLF InOutQuad(0, 256)

; 从1开始数，所以起始槽位先减1
起始槽位 -= 1
FOR COUNT, 1, 帧数
    CALLF 改变透明度(TEMP_DTWEEN_ARRAY:(帧数-COUNT))
    GCREATE 起始槽位 + COUNT, LOCAL:0, LOCAL:1
    GDRAWSPRITE 起始槽位 + COUNT, 原图像, 0, 0, LOCAL:0, LOCAL:1, Matrix:0:0
    SPRITECREATE 原图像 + TOSTR(COUNT), 起始槽位 + COUNT
NEXT

; 实际帧间隔会比设置的略大
@淡入横向移动, 图像名, 槽位, 说话人, 文本, 初始X值, 最终X值, 镜像 = 0, 曲线 = "InOutQuad", 帧数 = 24, 帧间隔 = 20
#DIMS 图像名
#DIM 槽位
#DIM 初始X值
#DIM 最终X值
#DIMS 曲线
#DIM 帧数
#DIM 帧间隔
#DIM 镜像
#DIMS 说话人
#DIMS 文本

CALLF 淡入动画帧(图像名)
CALLFORMF %曲线%(初始X值, 最终X值)
LOCAL = 0
$TEST
	LOCAL++
	CALL 设置肖像, @"%图像名%{LOCAL}", 1, TEMP_DTWEEN_ARRAY:LOCAL, 0, 镜像
	CALL MESSAGE_WINDOW, 说话人, 文本, "/", "不再等待/没有动画"
	TWAIT 帧间隔, 0
    CLEARLINE 6
	IF LOCAL >= 帧数-1
        CALL 设置肖像, 图像名, 1, TEMP_DTWEEN_ARRAY:LOCAL, 0, 镜像
	    CALL MESSAGE_WINDOW, 说话人, 文本, "/", "没有动画"
        ; 清理淡入动画帧
        FOR COUNT, 0, 帧数
            GDISPOSE 1000+COUNT
            SPRITEDISPOSE 图像名+TOSTR(COUNT)
        NEXT
		RETURN 1
    ENDIF
GOTO TEST


@横向移动, 图像名, 槽位, 说话人, 文本, 初始X值, 最终X值, 镜像 = 0, 曲线 = "InOutQuad", 帧数 = 24, 帧间隔 = 20
#DIMS 图像名
#DIM 槽位
#DIM 初始X值
