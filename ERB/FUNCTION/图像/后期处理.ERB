@重置颜色矩阵
#FUNCTION
VARSET Matrix, 0
Matrix:0:0 = 256
Matrix:1:1 = 256
Matrix:2:2 = 256
Matrix:3:3 = 256
Matrix:4:4 = 256

; 负数则为降低，取值范围-256~256
@改变明度, ARG
#FUNCTION
Matrix:4:0 = ARG
Matrix:4:1 = ARG
Matrix:4:2 = ARG

; 取值范围0~256
@改变透明度, ARG
#FUNCTION
Matrix:3:3 = ARG

; 取值范围大于0
@改变RGB, ARG:0, ARG:1, ARG:2
#FUNCTION
Matrix:0:0 = ARG:0
Matrix:1:1 = ARG:1
Matrix:2:2 = ARG:2

@测试打印图像
GCREATE 0, 1280, 640
CALLF 重置颜色矩阵()
CALLF 改变RGB(1024, 256, 256)
GDRAWSPRITE 0, "野外", 0, 0, 1280, 640, Matrix:0:0
SPRITECREATE "新野外", 0