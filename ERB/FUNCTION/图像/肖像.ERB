;----------------------------------------------------------------
; 设置立绘HTML（单位是百分之）
;----------------------------------------------------------------
@获取肖像, 肖像, 横坐标右移 = 100, 纵坐标上移 = 0, 镜像 = 0, 尺寸 = 3000
#FUNCTIONS
#DIMS 肖像
#DIM 镜像
#DIM 尺寸
#DIM 纵坐标上移
#DIM 横坐标右移
#DIM iEnter_Con
#DIM iFont_Hei_mag
#DIM iFont_纵坐标上移_mag
#DIM iFont_横坐标右移_mag
#DIMS html_String
#DIM width

html_String =
iEnter_Con = 0
iFont_Hei_mag = GETCONFIG("一行の高さ") * 尺寸*10 / GETCONFIG("フォントサイズ")
iFont_纵坐标上移_mag = GETCONFIG("一行の高さ") * 纵坐标上移*10 / GETCONFIG("フォントサイズ")
iFont_横坐标右移_mag = GETCONFIG("一行の高さ") * 横坐标右移*10 / GETCONFIG("フォントサイズ")
iFont_Hei_mag = (iFont_Hei_mag/10) + (iFont_Hei_mag%10 >= 5?1#0)
iFont_纵坐标上移_mag = (iFont_纵坐标上移_mag/10) + (iFont_纵坐标上移_mag%10 >= 5?1#0)
iFont_横坐标右移_mag = (iFont_横坐标右移_mag/10) + (iFont_横坐标右移_mag%10 >= 5?1#0)
IF 镜像
    width = -iFont_Hei_mag
ELSE
    width = iFont_Hei_mag
ENDIF
IF SPRITECREATED(肖像)
	html_String += @"<img src='%肖像%' ypos='{-iFont_纵坐标上移_mag - iFont_Hei_mag}' width='{width*1022/1150}' height='{iFont_Hei_mag}'>"
ENDIF
iEnter_Con++

RETURNF html_String

; 出于性能考虑，连续设置肖像时请将立即刷新设为0
@设置肖像, 肖像, 槽位, 横坐标右移 = 100, 纵坐标上移 = 0, 镜像 = 0, 立即刷新 = 1, 尺寸 = 3000
#DIM 槽位
#DIMS 肖像
#DIM 镜像
#DIM 尺寸
#DIM 纵坐标上移
#DIM 横坐标右移
#DIM 立即刷新

LOCAL = GETCONFIG("一行の高さ") * 横坐标右移*10 / GETCONFIG("フォントサイズ")
LOCAL = (LOCAL/10) + (LOCAL%10 >= 5?1#0)
SELECTCASE 槽位
    CASE 1
        SAVESTR:角色肖像1 '= ADD_NONBUTTON_TEXT(" " + 获取肖像(肖像,横坐标右移,纵坐标上移,镜像,尺寸),"", LOCAL - 99)
    CASE 2
        SAVESTR:角色肖像2 '= ADD_NONBUTTON_TEXT(" " + 获取肖像(肖像,横坐标右移,纵坐标上移,镜像,尺寸),"", LOCAL - 99)
    CASE 3
        SAVESTR:角色肖像3 '= ADD_NONBUTTON_TEXT(" " + 获取肖像(肖像,横坐标右移,纵坐标上移,镜像,尺寸),"", LOCAL - 99)
    CASE 4
        SAVESTR:角色肖像4 '= ADD_NONBUTTON_TEXT(" " + 获取肖像(肖像,横坐标右移,纵坐标上移,镜像,尺寸),"", LOCAL - 99)
    CASE 5
        SAVESTR:角色肖像5 '= ADD_NONBUTTON_TEXT(" " + 获取肖像(肖像,横坐标右移,纵坐标上移,镜像,尺寸),"", LOCAL - 99)
ENDSELECT

SIF 立即刷新
    CALL 刷新肖像

@刷新肖像
#DIMS HTMLS
HTMLS =
FOR COUNT, 1, 6
    SELECTCASE COUNT
        CASE 1
            SIF SAVESTR:角色肖像1 != ""
                HTMLS += SAVESTR:角色肖像1
        CASE 2
            SIF SAVESTR:角色肖像2 != ""
                HTMLS += SAVESTR:角色肖像2
        CASE 3
            SIF SAVESTR:角色肖像3 != ""
                HTMLS += SAVESTR:角色肖像3
        CASE 4
            SIF SAVESTR:角色肖像4 != ""
                HTMLS += SAVESTR:角色肖像4
        CASE 5
            SIF SAVESTR:角色肖像5 != ""
                HTMLS += SAVESTR:角色肖像5
    ENDSELECT

NEXT

CLEARLINE 1
IF HTMLS != ""
    HTML_PRINT "<p align='left'><nobr> " + HTMLS + "</nobr></p>"
ELSE
    PRINTL
ENDIF



@清除肖像, ARG, 立即刷新 = 1
#DIM 立即刷新
SELECTCASE ARG
    CASE 1
        SAVESTR:角色肖像1=
    CASE 2
        SAVESTR:角色肖像2=
    CASE 3
        SAVESTR:角色肖像3=
    CASE 4
        SAVESTR:角色肖像4=
    CASE 5
        SAVESTR:角色肖像5=
ENDSELECT

SIF 立即刷新
    CALL 刷新肖像

@清除全部肖像
SAVESTR:角色肖像1=
SAVESTR:角色肖像2=
SAVESTR:角色肖像3=
SAVESTR:角色肖像4=
SAVESTR:角色肖像5=

