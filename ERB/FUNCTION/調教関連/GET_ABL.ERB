;---------------------------------------------------------------------
;---------------------------------------------------------------------
;@GET_ABL
;装備やアイテムによる加成を込にしたABLの数值を返す
;ARG		取得するABLの番号
;ARG:1		取得する対象となる角色の登録番号
;---------------------------------------------------------------------
@GET_ABL, ARGS, ARG:1 = -1
#FUNCTION
#LOCALSIZE 1
LOCAL = GET_NATURE_ABL(ARGS, ARG:1)
RETURNF LOCAL

;---------------------------------------------------------------------
;@GET_NATURE_ABL
;装備やアイテムによる加成をかける前のABLの数值を返す
;ARGS		取得するABLの番号
;ARG:1		取得する対象となる角色の登録番号
;---------------------------------------------------------------------
@GET_NATURE_ABL, ARGS, ARG:1 = -1
#FUNCTION
#LOCALSIZE 2
IF ARGS == "SUM"
	LOCAL:1 = 0
	FOR LOCAL, 0, 100
		LOCAL:1 += ABL:(ARG:1):LOCAL
	NEXT
	RETURNF LOCAL:1
ELSE
	IF ISNUMERIC(ARGS)
		RETURNF ABL:(ARG:1):TOINT(ARGS)
	ELSE
		RETURNF ABL:(ARG:1):ARGS
	ENDIF
ENDIF

;---------------------------------------------------------------------
;@GET_MAX_ABL
;ABL上限值を返す
;ARGS		取得するABLの番号
;ARG:1		取得する対象となる角色の登録番号
;---------------------------------------------------------------------
@GET_MAX_ABL, ARGS, ARG
#FUNCTION
#LOCALSIZE 2
LOCAL = (ISNUMERIC(ARGS) ? TOINT(ARGS) # GETNUM(ABL, ARGS)) + 100
LOCAL:1 = ABL:ARG:LOCAL
IF CFLAG:ARG:人类
	;IF 陥落(ARG)
	;ELSE
		LOCAL:1 = MAX(LOCAL:1 , 5)
	;ENDIF
ENDIF
RETURNF LOCAL:1


;---------------------------------------------------------------------
;@SET_MAX_ABL
;ABL上限值を設定する
;ARGS		取得するABLの名称
;ARG		取得する対象となる角色の登録番号
;ARG:1		代入する数值
;---------------------------------------------------------------------
@SET_MAX_ABL, ARGS, ARG = -1, ARG:1
LOCAL = (ISNUMERIC(ARGS) ? TOINT(ARGS) # GETNUM(ABL, ARGS)) + 100
ABL:ARG:LOCAL = ARG:1


