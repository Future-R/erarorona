;========================================
;経験値入手関数
;========================================
@GET_ADD_EXP, ARG, ARG:1
#FUNCTION
#LOCALSIZE 1
LOCAL = ARG:1 == -99 ? TARGET # ARG:1
SIF LOCAL < 0
	THROW @ADD_EXPにおいて指定されたキャラクターが不正です
SIF ARG < 0 || STRLENS(EXPNAME:ARG) == 0
	THROW @ADD_EXPにおいて指定されたEXPが不正です
;膣射経験加算時は同時に膣内精液量を加算する
;SIF ARG == GETNUM(EXP, "膣射経験")
;	TCVAR:LOCAL:膣内射精量 += ARG:1
RETURNF TCVAR:LOCAL:(ARG + GETNUM(TCVAR, "獲得EXP"))

