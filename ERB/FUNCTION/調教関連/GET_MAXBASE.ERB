;---------------------------------------------------------------------
;---------------------------------------------------------------------
;@GET_ABL
;装備やアイテムによる加成を込にしたABLの数值を返す
;ARGS		取得するABLの名称
;ARG:1		取得する対象となる角色の登録番号
;---------------------------------------------------------------------
@GET_MAXBASE, ARGS, ARG = -1
#FUNCTION
#LOCALSIZE 2
#LOCALSSIZE 1
LOCALS = \@ISNUMERIC(ARGS) ? %BASENAME:TOINT(ARGS)% # %ARGS%\@
IF EQUIP:ARG:体力气力互换 && !TRAIN_SKILL_POWER_幽灵之躯(ARG)
	IF LOCALS == "体力"
		LOCALS '= "气力"
	ELSEIF LOCALS == "气力"
		LOCALS '= "体力"
	ENDIF
ENDIF

LOCAL = MAXBASE:ARG:LOCALS
SELECTCASE LOCALS
	CASE "体力"
		LOCAL += TRAIN_STATE_POWER_体力增加(ARG)
		LOCAL += GET_TALENT("强韧", ARG) * 200
		LOCAL -= GET_TALENT("虚弱", ARG) * 200
		;50から10刻みで140まで増加量が増えていって合計950、それに50の下駄をはかせて最大1000の追加
		SIF GET_ABL("受虐倾向", ARG) > 0
			LOCAL += 50 + (40 * 2 + GET_ABL("受虐倾向", ARG) * 10) * GET_ABL("受虐倾向", ARG) / 2
		LOCAL += EQUIP:ARG:体力加成
		SIF TRAIN_SKILL_POWER_幽灵之躯(ARG)
			LOCAL = 100
		LOCAL = MAX(LOCAL, 100)
	CASE "气力"
		LOCAL += GET_TALENT("聪明", ARG) * 200
		LOCAL -= GET_TALENT("愚钝", ARG) * 200
		LOCAL += EQUIP:ARG:气力加成
		LOCAL = CALCF(LOCAL, TRAIN_SKILL_POWER_幽灵之躯(ARG))
		LOCAL = MAX(LOCAL, 100)
	CASE "MP"
		IF ARG == MASTER
			FOR LOCAL:1, 1, GET_MIXLV(MASTER)
				LOCAL += 1 + (LOCAL:1 * (LOCAL:1 + 1) + (LOCAL:1 + 2)) % 4
			NEXT
		ENDIF
	CASEELSE
		SIF LOCALS == "" || !MATCH(BASENAME, LOCALS)
			THROW ARGS[%ARGS%]异常。
ENDSELECT
RETURNF LOCAL
