;														GETSとGETを統合し、TALENTによる変動も追加
;	002		2012/10/26			kap			0.420		幽霊のからだの処理を追加
;	003		2014/01/02			kap			0.520		MPの計算処理を追加
;---------------------------------------------------------------------
;---------------------------------------------------------------------
;@GET_ABL
;装備やアイテムによる補正を込にしたABLの数値を返す
;ARGS		取得するABLの名称
;ARG:1		取得する対象となるキャラの登録番号
;---------------------------------------------------------------------
@GET_MAXBASE, ARGS, ARG = -1
#FUNCTION
#LOCALSIZE 2
#LOCALSSIZE 1
LOCALS = \@ISNUMERIC(ARGS) ? %BASENAME:TOINT(ARGS)% # %ARGS%\@
IF EQUIP:ARG:体力気力入替 && !TRAIN_SKILL_POWER_幽霊のからだ(ARG)
	IF LOCALS == "体力"
		LOCALS '= "気力"
	ELSEIF LOCALS == "気力"
		LOCALS '= "体力"
	ENDIF
ENDIF

LOCAL = MAXBASE:ARG:LOCALS
SELECTCASE LOCALS
	CASE "体力"
		LOCAL += TRAIN_STATE_POWER_体力増加(ARG)
		LOCAL += GET_TALENT("丈夫", ARG) * 200
		LOCAL -= GET_TALENT("虚弱", ARG) * 200
		;50から10刻みで140まで増加量が増えていって合計950、それに50の下駄をはかせて最大1000の追加
		SIF GET_ABL("マゾっ気", ARG) > 0
			LOCAL += 50 + (40 * 2 + GET_ABL("マゾっ気", ARG) * 10) * GET_ABL("マゾっ気", ARG) / 2
		LOCAL += EQUIP:ARG:体力補正
		SIF TRAIN_SKILL_POWER_幽霊のからだ(ARG)
			LOCAL = 100
		LOCAL = MAX(LOCAL, 100)
	CASE "気力"
		LOCAL += GET_TALENT("聡明", ARG) * 200
		LOCAL -= GET_TALENT("愚鈍", ARG) * 200
		LOCAL += EQUIP:ARG:気力補正
		LOCAL = CALCF(LOCAL, TRAIN_SKILL_POWER_幽霊のからだ(ARG))
		LOCAL = MAX(LOCAL, 100)
	CASE "MP"
		IF ARG == MASTER
			FOR LOCAL:1, 1, GET_MIXLV(MASTER)
				LOCAL += 1 + (LOCAL:1 * (LOCAL:1 + 1) + (LOCAL:1 + 2)) % 4
			NEXT
		ENDIF
	CASEELSE
		SIF LOCALS == "" || !MATCH(BASENAME, LOCALS)
			THROW ARGS[%ARGS%]が異常です。
ENDSELECT
RETURNF LOCAL
