@GET_NATURE_PREASURE_CUP, ARGS, ARG = -1
#FUNCTION
#LOCALSSIZE 1
IF ISNUMERIC(ARGS)
	LOCALS = %PALAMNAME:TOINT(ARGS)%
ELSE
	LOCALS = %ARGS%
ENDIF
SIF !SOURCE:ARG:ARGS
	RETURNF 0
RETURNF CUP:ARG:ARGS * (SOURCE:ARG:ARGS - SOURCE:ARG:("道具" + ARGS)) / SOURCE:ARG:ARGS

