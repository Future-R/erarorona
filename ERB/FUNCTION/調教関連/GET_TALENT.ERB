@GET_TALENT, ARGS, ARG = -1
#FUNCTION
#LOCALSSIZE 1
IF ISNUMERIC(ARGS)
	LOCALS '= TALENTNAME:TOINT(ARGS)
ELSE
	LOCALS '= ARGS
ENDIF
SIF LOCALS == ""
	RETURNF 0
IF ARG == MASTER
	IF GROUPMATCH(LOCALS, "Ｃ敏感", "Ｖ敏感", "Ａ敏感", "Ｂ敏感", "擅长手活", "擅长口活", "擅长性交", "擅长受虐", "擅长施虐")
		FOR LOCAL, 3, 0, -1
			SIF TALENT:ARG:LOCALS == LOCAL
				RETURNF LOCAL
			SIF TO_CHOICE:GET_NO("特典", LOCALS + @" Lv{LOCAL}")
				RETURNF LOCAL
		NEXT
	ENDIF
ENDIF
RETURNF TALENT:ARG:LOCALS
