;---------------------------
;マスター用の技巧補正値の取得
;ARGS		COMのタイプ
;ARG		普通はマスター
;ARG:1		普通はターゲット
;---------------------------
@GET_TEQ_M, ARGS, ARG = -1, ARG:1 = -1
#FUNCTION
#LOCALSIZE 2
SIF ARG == -1
	ARG = MASTER
LOCAL = 0
;装備品の補正値
IF ARGS == "その他性技"
	LOCAL += (EQUIP:ARG:口技補正 + EQUIP:ARG:手技補正 + EQUIP:ARG:性交補正) / 3
ELSE
	FOR LOCAL:1, 0, STRCOUNT(ARGS, "/") + 1
		LOCALS '= AUTO_SPLIT(ARGS, "/", LOCAL:1)
		SELECTCASE LOCALS
			CASE "その他性技"
			CASEELSE
				LOCAL += EQUIP:ARG:(LOCALS + "補正")
				LOCAL /= STRCOUNT(LOCALS, "/") + 1
		ENDSELECT
		;TALENTなどの補正値
		;IF GROUPMATCH(ARGS, "その他", "誘惑")
		;	CALLFORMF TRAIN_SKILL_POWER_%ARGS%補正(ARG, ARG:1, 1)
		;	LOCAL += RESULT
		;ENDIF

		;実績などによる補正値
		SELECTCASE LOCALS
		ENDSELECT
	NEXT
ENDIF
RETURNF MAX(LOCAL, 0)

;---------------------------
;マスター用の感度補正値の取得
;ARGS		部位
;ARG		普通はマスター
;ARG:1		普通はターゲット
;---------------------------
@GET_SENS_M, ARGS, ARG = -1, ARG:1 = -1
#FUNCTION
#LOCALSIZE 1
SIF ARG == -1
	ARG = MASTER
LOCAL = 0
;装備品の補正値
LOCAL += EQUIP:ARG:(ARGS + "補正")
LOCAL += RESULT

;実績などによる補正値
SELECTCASE ARGS
ENDSELECT
RETURNF MAX(LOCAL, 0)
