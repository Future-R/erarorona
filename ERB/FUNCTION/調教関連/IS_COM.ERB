;---------------------------------------------------------------------
;	002		2012/12/01			Ris			0.420		@SPLITに指定された格納変数をLOCALからLOCALSへ修正
;---------------------------------------------------------------------
;-----------------------------------------------------------
;@IS_COM
;COM：ARGSがARGであるかどうかを判定
;ARGSは数值・名称両対応,"/"で区切ることで、複数のOR一致を見れるように
;-----------------------------------------------------------
@IS_COM, ARGS, ARG
#FUNCTION
#LOCALSIZE 2
#LOCALSSIZE 50
LOCAL:1 = RESULT
SPLIT ARGS, "/", LOCALS
RESULT = LOCAL:1
FOR LOCAL, 0, LOCAL:1
	IF ISNUMERIC(ARGS)
		RETURNF ARG == TOINT(LOCALS:LOCAL)
	ELSE
		SIF LOCALS:LOCAL == GET_COMNAME(ARG)
			RETURNF 1
	ENDIF
NEXT
RETURNF 0
;-----------------------------------------------------------
;@IS_SELECTCOM
;COM：ARGSがSELECTCOMであるかどうかを判定
;ARGSは数值・名称両対応
;-----------------------------------------------------------
@IS_SELECTCOM, ARGS
#FUNCTION
RETURNF IS_COM(ARGS, SELECTCOM)

;-----------------------------------------------------------
;@IS_SELECTCOM
;COM：ARGSがARGターン前のCOMであるかどうかを判定
;ARGSは数值・名称両対応
;-----------------------------------------------------------
@IS_PREVCOM, ARGS, ARG = 1
#FUNCTION
RETURNF IS_COM(ARGS, SELECTCOM:ARG)

@GET_SELECTCOMNAME
#FUNCTIONS
RETURNF GET_COMNAME(SELECTCOM)

@GET_PREVCOMNAME, ARG = 1
#FUNCTIONS
RETURNF GET_COMNAME(SELECTCOM:ARG)

@GET_COMNAME, ARG
#FUNCTIONS
IF IS_TRAINITEM(ARG)
	RETURNF GET_NAME("物品", ARG)
ELSE
	RETURNF GET_NAME("指令", ARG)
ENDIF

