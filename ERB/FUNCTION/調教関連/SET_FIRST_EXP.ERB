;---------------------------------------------------------------------
;
;	Module		:SET_FIRST_EXP.ERB
;	Facility	:角色クターの初体験のセット関数
;
;	Licence		:フリー
;
;	Modification Data:
;
;	Edit	Date				Author		ver			Reason
;	001		2012/09/13			kap			0.360		新規作成
;---------------------------------------------------------------------
;ARGS	セット内容
;ARG	セット対象
;ARGS:1	セットするもの
;ARGS:2	追記 "_"で区切っていれる
;---------------------------------------------------------------------
@SET_FIRST_EXP, ARGS, ARG, ARGS:1, ARGS:2
#LOCALSSIZE 10
SIF GET_STRFLAG(@"CSTR:{ARG}:%ARGS%", "DAY")
	RETURN 0
SIF TSTR:回合内初体验成就 != ""
	TSTR:回合内初体验成就 += UNICODE(0x07)
TSTR:回合内初体验成就 += @"CSTR:{ARG}:%ARGS%" + "/" + "DAY_" + TOSTR(DAY) + "/" + "相手_" + \@ISNUMERIC(ARGS:1) ? %CALLNAME:TOINT(ARGS:1)% # %ARGS:1%\@
SIF ARGS:2 != ""
	TSTR:回合内初体验成就 += "/" + ARGS:2
TCVAR:ARG:ARGS = 1
TCVAR:ARG:(ARGS + "_本次") = 1

@SET_FIRST_EXP_MAIN
#LOCALSIZE 2
#LOCALSSIZE 20
#DIMS LOCALS_1, 20
#DIMS LOCALS_2, 20
SPLIT TSTR:回合内初体验成就, UNICODE(0x07), LOCALS
FOR LOCAL, 0, RESULT
	SPLIT LOCALS:LOCAL, "/", LOCALS_1
	FOR LOCAL:1, 1, RESULT
		SPLIT LOCALS_1:(LOCAL:1), "_", LOCALS_2
		CALL ADD_STRFLAG, LOCALS_1, LOCALS_2, LOCALS_2:1
	NEXT
NEXT
