;	Edit	Date			Author					Reason
;	002		2012/12/01		RIS						@IS_INSERTの「ISNUMRIC」 を 「ISNUMERIC」 に修正
;													@GET_TO_INSERTのARGをTOINT(ARGS)へ変更
;--------------------------------
;@SET_INSERT		挿入設定関数
;ARG		挿入のセット対象
;ARGS		挿入対象となる部位　VA口
;ARGS:1		挿入者("MASTER/ASSI/TARGET/リセット/バイブなど")
;--------------------------------
@SET_INSERT, ARG, ARGS, ARGS:1
#LOCALSIZE 3
#LOCALSSIZE 1
LOCAL = TRAINCHARANUM(ARG)

IF ISNUMERIC(ARGS:1)
	LOCALS = %GET_NAME_ROLE(TOINT(ARGS:1))%
ELSE
	LOCALS = %ARGS:1%
ENDIF

;挿し替えチェック
;挿入予定者がTARGET
FOR LOCAL:2, 0, 3
	;自分自身はスルー
	SIF LOCAL == LOCAL:2
		CONTINUE
	LOCAL:1 = GET_TO_INSERT(TRAINCHARAS(LOCAL:2))
	;TARGETが現在自分に挿入しようとしている
	IF LOCAL:1 == ARG
		;違う地点ならそれまでの地点を解放する
		IF RESULTS != LOCALS
			CALL SET_INSERT_SUB, LOCAL, RESULTS, "NONE"
			TCVAR:ARG:插入继续 = 0
		ENDIF
	ELSE
		;誰かに挿入している
		IF RESULTS != "NONE"
			;一旦挿入解除
			CALL SET_INSERT_SUB, LOCAL:1, RESULTS, "NONE"
			TCVAR:(LOCAL:1):插入继续 = 0
		ENDIF
	ENDIF
NEXT
CALL SET_INSERT_SUB, LOCAL, ARGS, LOCALS
@SET_INSERT_SUB, ARG, ARGS, ARGS:1
SELECTCASE ARGS
	CASE "Ｖ", "v"
		Ｖ挿入者:ARG = %ARGS:1%
	CASE "Ａ", "A"
		Ａ挿入者:ARG = %ARGS:1%
	CASE "口", "口"
		口挿入者:ARG = %ARGS:1%
	CASEELSE
		THROW [%ARGS:1%]は挿入可能な部位ではありません
ENDSELECT

;--------------------------------
;@GET_INSERT		挿入内容取得関数
;ARG		挿入している人
;ARGS		挿入対象となる部位　VA口
;--------------------------------
@GET_INSERT, ARG, ARGS
#FUNCTIONS
#LOCALSIZE 1
LOCAL = TRAINCHARANUM(ARG)
SELECTCASE ARGS
	CASE "Ｖ", "v"
		RETURNF Ｖ挿入者:LOCAL
	CASE "Ａ", "A"
		RETURNF Ａ挿入者:LOCAL
	CASE "口", "口"
		RETURNF 口挿入者:LOCAL
	CASEELSE
		THROW [%ARGS%]は挿入可能な部位ではありません
ENDSELECT

;--------------------------------
;@SET_INSERT		挿入者判定関数
;ARG		挿入されているひと
;ARGS		挿入対象となる部位　VA口
;ARGS:1		挿入しているひと、TARGET/ASSIなどのほかバイブなど、さらにNICKNAMEまで対応
;--------------------------------
@IS_INSERT, ARG, ARGS, ARGS:1
#FUNCTION
IF GET_NAME_ROLE(ARGS:1) == "NONE"
	LOCALS = %ARGS:1%
ELSE
	LOCALS = %GET_NAME_ROLE(ISNUMERIC(ARGS:1))%
ENDIF
IF LOCALS == "阴茎"
	RETURNF GROUPMATCH(GET_INSERT(ARG, ARGS), "MASTER", "ASSI", "TARGET")
ELSE
	RETURNF GET_INSERT(ARG, ARGS) == LOCALS
ENDIF

;--------------------------------
;@SET_INSERT		挿入対象判定関数
;ARG				挿入しているひと("PLAYER"や"MASTER"にも対応)
;-------------------------------
@GET_TO_INSERT, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	LOCALS = %GET_NAME_ROLE(TOINT(ARGS))%
ELSE
	LOCALS = %ARGS%
ENDIF
FOR LOCAL, 0, 3
	IF Ｖ挿入者:LOCAL == LOCALS
		RESULTS = Ｖ
		RETURNF TRAINCHARA(LOCAL)
	ENDIF
	IF Ａ挿入者:LOCAL == LOCALS
		RESULTS = Ａ
		RETURNF TRAINCHARA(LOCAL)
	ENDIF
	IF 口挿入者:LOCAL == LOCALS
		RESULTS = 口
		RETURNF TRAINCHARA(LOCAL)
	ENDIF
NEXT
RESULTS = NONE
RETURNF -1
