;ARG   キャラ
;ARGS  名称
;ARG:1 ターン
;ARG:2 各要素の番号
;BASE/PALAM/SOURCE/EXP
;3(キャラ) * 要素(最大10) * 100(ターン限度) * 100(各要素の数)
@GET_TRAINRECORD_C, ARGS, ARGS:1, ARG, ARG:1
#FUNCTION
#DIM NUM, 3
#DIM CHARA
#DIM L_COUNT, 4
#LOCALSIZE 300000
#LOCALSSIZE 1
LOCALS = BASE/PALAM/SOURCE/獲得EXP/CUP
SELECTCASE ARGS
	CASE "RESET"
		VARSET LOCAL, 0
	CASE "SET"
		FOR L_COUNT:2, 0, 2
			SIF TRAINCHARA(L_COUNT:1) < 0
				CONTINUE
			;この時点で確定している部分(ターンと実行者)
			NUM:1 = L_COUNT:2 * 10 * 100 * 100 + ARG * 100
			FOR L_COUNT:1, 0, STRCOUNT(LOCALS, "/")
				NUM = NUM:1 + L_COUNT:1 * 100 * 100
				SELECTCASE AUTO_SPLIT(LOCALS, "/", L_COUNT:1)
					CASE "BASE"
						FOR L_COUNT, 0, 100
							LOCAL:(NUM + L_COUNT) = BASE:TRAINCHARA(L_COUNT:2):L_COUNT
						NEXT
					CASE "PALAM"
						FOR L_COUNT, 0, 100
							LOCAL:(NUM + L_COUNT) = PALAM:TRAINCHARA(L_COUNT:2):L_COUNT
						NEXT
					CASE "SOURCE"
						FOR L_COUNT, 0, 100
							LOCAL:(NUM + L_COUNT) = SOURCE:TRAINCHARA(L_COUNT:2):L_COUNT
						NEXT
					CASE "獲得EXP"
						FOR L_COUNT, 0, 100
							LOCAL:(NUM + L_COUNT) = EXP:TRAINCHARA(L_COUNT:2):L_COUNT
						NEXT
					CASE "CUP"
						FOR L_COUNT, 0, 100
							LOCAL:(NUM + L_COUNT) = CUP:TRAINCHARA(L_COUNT:2):L_COUNT
						NEXT
				ENDSELECT
			NEXT
		NEXT
	CASEELSE
		NUM = 0
		NUM += TRAINCHARANUM(ARGS) * 10 * 100 * 100
		NUM += AUTO_SPLIT_NUM("BASE/PALAM/SOURCE/EXP", "/", ARGS:1) *  100 * 100
		NUM += ARG * 100
		NUM += ARG:1
		RETURNF LOCAL:NUM
ENDSELECT
;ARGS  名称
;ARG   ターン
@GET_TRAINRECORD, ARGS, ARG
#FUNCTION
#LOCALSIZE 1
RETURNF DE:ARG:TRAINRECORD(ARGS) - TRAINRECORD_KEY(ARGS)

;ARGS  名称
;ARG ターン
;ARG:1 代入する数値
@SET_TRAINRECORD, ARGS, ARG, ARG:1
DE:ARG:TRAINRECORD(ARGS) = ARG:1 + TRAINRECORD_KEY(ARGS)

@TRAINRECORD, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "残り時間"
		RETURNF 0
	CASE "調教者"
		RETURNF 1
	CASEELSE
		THROW @TRAINRECORDおいて不正なARGS[%ARGS%]が送られました
ENDSELECT

;MASTERを保存する場合のように0が使えない場合ずらすためのキー
@TRAINRECORD_KEY, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "調教者"
		RETURNF 1000
	CASEELSE
		RETURNF 0
ENDSELECT
