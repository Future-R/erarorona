;MASTER/TARGET/ASSIをFOR文なんかでまとめて扱うための関数
@TRAINCHARA, ARG
#FUNCTION
SELECTCASE ARG
	CASE 0
		RETURNF MASTER
	CASE 1
		RETURNF TARGET
	CASE 2
		RETURNF ASSI
ENDSELECT

@TRAINCHARANUM, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	SELECTCASE TOINT(ARGS)
		CASE MASTER
			RETURNF 0
		CASE TARGET
			RETURNF 1
		CASE ASSI
			RETURNF 2
	ENDSELECT
ELSE
	SELECTCASE ARGS
		CASE "MASTER"
			RETURNF 0
		CASE "TARGET"
			RETURNF 1
		CASE "ASSI"
			RETURNF 2
	ENDSELECT
ENDIF
@TRAINCHARANUMS, ARGS
#FUNCTION


;MASTER/TARGET/ASSIをFOR文なんかでまとめて扱うための関数
@TRAINCHARAS, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "MASTER"
	CASE 1
		RETURNF "TARGET"
	CASE 2
		RETURNF "ASSI"
ENDSELECT
