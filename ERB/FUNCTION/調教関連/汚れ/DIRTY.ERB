;-------------------------------------------------
;污秽判定関数
;ARGのARGSについている污秽を判定する
;愛液と母乳と元々その部位についていた污秽は対象外
;污秽の数量と、污秽の合計(つまり、愛液と母乳を除いた污秽情報を返す)
;-------------------------------------------------
@DIRTY, ARGS, ARG = -99
#FUNCTION
RESULT = 0
RESULT:1 = 0
SIF ARG == -99
	ARG = TARGET
;IF ARGS != ヴァギナ" && GET_STAIN(ARGS, "爱液", ARG)
;	RESULT++
;	RESULT:1 |= 1
;ENDIF
IF ARGS != "阴茎" && GET_STAIN(ARGS, "阴茎", ARG)
	RESULT++
	RESULT:1 |= 2
ENDIF
IF GET_STAIN(ARGS, "精液", ARG)
	RESULT++
	RESULT:1 |= 4
ENDIF
IF ARGS != "肛" && GET_STAIN(ARGS, "肛", ARG)
	RESULT++
	RESULT:1 |= 8
ENDIF
;IF GET_STAIN(ARGS, "母乳", ARG)
;	RESULT++ 
;	RESULT:1 |= 16
;ENDIF
IF GET_STAIN(ARGS, "粘液", ARG)
	RESULT++
	RESULT:1 |= 32
ENDIF
IF GET_STAIN(ARGS, "破处之血", ARG)
	RESULT++
	RESULT:1 |= 64
ENDIF
RETURNF RESULT 