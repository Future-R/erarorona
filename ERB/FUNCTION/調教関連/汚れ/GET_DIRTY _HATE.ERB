;-------------------------------------------------
;汚れへの抵抗判定関数
;ARGS   汚れを受ける部位
;ARG    汚れを受ける角色
;ARGS:1 与えられる汚れの種類/あるいは汚れを与える部位
;ARG;1	汚れを与える角色
;汚れてもいい部位に関しては抵抗が少ない
;-------------------------------------------------
@GET_DIRTY_HATE, ARGS, ARG = -1, ARGS:1, ARG:1 = -1
#FUNCTION
#LOCALSIZE 2
SIF GET_TALENT("无视污秽", ARG)
	RETURNF 0
VARSET LOCAL
SELECTCASE ARGS
	CASE "口"
		LOCAL =  100
	CASE "手"
		LOCAL =  50
	CASE "阴茎"
		LOCAL =  30
	CASE "阴道"
		LOCAL =  30
	CASE "肛"
		LOCAL =  10
	CASE "胸"
		LOCAL =  50
	CASE "阴道内"
		LOCAL =  30
	CASE "发"
		LOCAL =  100
ENDSELECT
IF ARG:1 >= 0
	;ペニスとアナルの接触は移動しない汚れによって抵抗を受ける
	SIF ARGS:1 == "阴茎"
		LOCAL:1 += 3
	SIF ARGS:1 == "肛"
		LOCAL:1 += 5
	SIF GET_STAIN(ARGS:1, "爱液", ARG:1) && ARGS != "阴道"  && ARGS != "阴道内"
		LOCAL:1 += 2
	SIF GET_STAIN(ARGS:1, "阴茎", ARG:1) && ARGS != "阴茎"
		LOCAL:1 += 2
	SIF GET_STAIN(ARGS:1, "精液", ARG:1)
		LOCAL:1 += 5
	SIF GET_STAIN(ARGS:1, "肛", ARG:1) && ARGS != "肛" 
		LOCAL:1 += 3
	SIF GET_STAIN(ARGS:1, "母乳", ARG:1) 
		LOCAL:1 += 1
	SIF GET_STAIN(ARGS:1, "粘液", ARG:1)
		LOCAL:1 += 10
	SIF GET_STAIN(ARGS:1, "破处之血", ARG:1)
		LOCAL:1 += 1
	LOCAL *= LOCAL:1
ELSE
	SELECTCASE ARGS:1
		CASE "爱液"
			LOCAL *= 2
		CASE "阴茎"
			LOCAL *= 1
		CASE "精液"
			LOCAL *= 4
		CASE "肛"
			LOCAL *= 1
		CASE "粘液"
			LOCAL *= 8
		CASE "破处之血"
			LOCAL *= 1
	ENDSELECT
ENDIF
LOCAL = LOCAL * (100 + GET_TALENT("洁癖", ARG) * 50 - GET_TALENT("迟钝", ARG) * 25) / 100
RETURNF LOCAL

