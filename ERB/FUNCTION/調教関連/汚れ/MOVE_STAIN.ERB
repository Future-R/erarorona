;========================================
;汚れ移動関数
;ARGのARGS:1とARG:1のARG:1のARGSの間の汚れを相互に移動する
;========================================
@MOVE_STAIN(ARGS, ARG, ARGS:1, ARG:1)
STAIN:ARG:GET_NO("身体", ARGS) |= STAIN:(ARG:1):GET_NO("身体", ARGS:1)
STAIN:(ARG:1):GET_NO("身体", ARGS:1) |= STAIN:ARG:GET_NO("身体", ARGS)
