;----------------------------------------------------------------
; 默认背景音乐相关辅助函数
; 这里的显示名和实际字符串都是占位配置，后续可直接手动修改
;----------------------------------------------------------------

;----------------------------------------------------------------
; 默认背景音乐候选数量
;----------------------------------------------------------------
@获取默认背景音乐候选数量()
#FUNCTION
RETURNF 9

;----------------------------------------------------------------
; 获取默认背景音乐候选显示名
;----------------------------------------------------------------
@获取默认背景音乐候选显示名(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "萝乐娜的工房"
	CASE 1
		RETURNF "忽然就有了灵感"
	CASE 2
		RETURNF "翠绿之径"
	CASE 3
		RETURNF "亚兰德在下雪"
	CASE 4
		RETURNF "父母"
	CASE 5
		RETURNF "唔唔午觉"
	CASE 6
		RETURNF "紫电青霜"
	CASE 7
		RETURNF "水边的诗"
	CASE 8
		RETURNF "萝乐娜的工房(经典)"
	CASEELSE
		RETURNF "未命名曲目"
ENDSELECT

;----------------------------------------------------------------
; 获取默认背景音乐候选实际字符串
;----------------------------------------------------------------
@获取默认背景音乐候选字符串(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "萝乐娜的工房-新.mp3"
	CASE 1
		RETURNF "忽然就有了灵感.mp3"
	CASE 2
		RETURNF "翠绿之径.mp3"
	CASE 3
		RETURNF "亚兰德在下雪.mp3"
	CASE 4
		RETURNF "父母.mp3"
	CASE 5
		RETURNF "唔唔午觉.mp3"
	CASE 6
		RETURNF "紫电青霜.mp3"
	CASE 7
		RETURNF "水边的诗.mp3"
	CASE 8
		RETURNF "萝乐娜的工房.mp3"
	CASEELSE
		RETURNF "萝乐娜的工房-新.mp3"
ENDSELECT

;----------------------------------------------------------------
; 获取当前默认背景音乐实际字符串
;----------------------------------------------------------------
@获取默认背景音乐()
#FUNCTIONS
SIF GLOBALS:"默认背景音乐" == ""
	GLOBALS:"默认背景音乐" = %获取默认背景音乐候选字符串(0)%
RETURNF GLOBALS:"默认背景音乐"

;----------------------------------------------------------------
; 获取当前默认背景音乐显示名
;----------------------------------------------------------------
@获取默认背景音乐显示名()
#FUNCTIONS
#DIM 选项编号
SIF GLOBALS:"默认背景音乐" == ""
	GLOBALS:"默认背景音乐" = %获取默认背景音乐候选字符串(0)%
FOR 选项编号, 0, 获取默认背景音乐候选数量()
	SIF 获取默认背景音乐候选字符串(选项编号) != GLOBALS:"默认背景音乐"
		CONTINUE
	RETURNF 获取默认背景音乐候选显示名(选项编号)
NEXT
RETURNF GLOBALS:"默认背景音乐"

;----------------------------------------------------------------
; 在设置中选择默认背景音乐
;----------------------------------------------------------------
@选择默认背景音乐
#DIM 选项编号
#DIMS 选项文本, 2

PRINTFORML ┏%"━"*36%┓
PRINTFORML ｜%"请选择默认背景音乐。", 72, LEFT%｜
PRINTFORML ｜%"", 72, LEFT%｜
PRINTFORML ｜%"当前设置: " + 获取默认背景音乐显示名(), 72, LEFT%｜
FOR 选项编号, 0, 获取默认背景音乐候选数量()
	选项文本 '= @"[{选项编号}] " + 获取默认背景音乐候选显示名(选项编号)
	SIF 获取默认背景音乐() == 获取默认背景音乐候选字符串(选项编号)
		选项文本 += " ◁◁◁◁◁◁◁◁◁【当前】"
	PRINTFORML ｜%选项文本, 72, LEFT%｜
NEXT
PRINTFORML ｜%"", 72, LEFT%｜
PRINTFORML ｜%"[9] 取消", 72, LEFT%｜
PRINTFORML ┗%"━"*36%┛
INPUTS
SIF RESULTS == "9"
	RETURN 0
IF ISNUMERIC(RESULTS) && INRANGE(TOINT(RESULTS), 0, 获取默认背景音乐候选数量())
	GLOBALS:"默认背景音乐" = %获取默认背景音乐候选字符串(TOINT(RESULTS))%
ENDIF
RETURN 0
