;----------------------------------------------------------------
; 默认背景音乐相关辅助函数
; 每条配置统一写在同一个函数里，格式为：
; 显示名/文件名
; 这样修改时更直观，也方便通过文件名反查显示名
;----------------------------------------------------------------

;----------------------------------------------------------------
; 背景音乐配置数量
;----------------------------------------------------------------
@获取背景音乐配置数量()
#FUNCTION
RETURNF 10

;----------------------------------------------------------------
; 获取背景音乐配置文本
; 格式：显示名/文件名
;----------------------------------------------------------------
@获取背景音乐配置文本(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "萝乐娜的工房/萝乐娜的工房-新.mp3"
	CASE 1
		RETURNF "忽然就有了灵感/忽然就有了灵感.mp3"
	CASE 2
		RETURNF "翠绿之径/翠绿之径.mp3"
	CASE 3
		RETURNF "亚兰德在下雪/亚兰德在下雪.mp3"
	CASE 4
		RETURNF "父母/父母.mp3"
	CASE 5
		RETURNF "唔唔午觉/唔唔午觉.mp3"
	CASE 6
		RETURNF "紫电青霜/紫电青霜.mp3"
	CASE 7
		RETURNF "水边的诗/水边的诗.mp3"
	CASE 8
		RETURNF "萝乐娜的工房(经典)/萝乐娜的工房.mp3"
	CASE 9
		RETURNF "海风温和/海风温和.mp3"
	CASEELSE
		RETURNF "未命名曲目/萝乐娜的工房-新.mp3"
ENDSELECT

;----------------------------------------------------------------
; 获取背景音乐配置显示名
;----------------------------------------------------------------
@获取背景音乐配置显示名(ARG)
#FUNCTIONS
RETURNF AUTO_SPLIT(获取背景音乐配置文本(ARG), "/", 0)

;----------------------------------------------------------------
; 获取背景音乐配置文件名
;----------------------------------------------------------------
@获取背景音乐配置文件名(ARG)
#FUNCTIONS
RETURNF AUTO_SPLIT(获取背景音乐配置文本(ARG), "/", 1)

;----------------------------------------------------------------
; 根据文件名获取背景音乐显示名
;----------------------------------------------------------------
@通过文件名获取背景音乐显示名(ARGS)
#FUNCTIONS
#DIM 配置编号
FOR 配置编号, 0, 获取背景音乐配置数量()
	SIF 获取背景音乐配置文件名(配置编号) != ARGS
		CONTINUE
	RETURNF 获取背景音乐配置显示名(配置编号)
NEXT
RETURNF ARGS

;----------------------------------------------------------------
; 获取当前默认背景音乐实际字符串
;----------------------------------------------------------------
@获取默认背景音乐()
#FUNCTIONS
SIF GLOBALS:"默认背景音乐" == ""
	GLOBALS:"默认背景音乐" = %获取背景音乐配置文件名(0)%
RETURNF GLOBALS:"默认背景音乐"

;----------------------------------------------------------------
; 获取当前默认背景音乐显示名
;----------------------------------------------------------------
@获取默认背景音乐显示名()
#FUNCTIONS
RETURNF 通过文件名获取背景音乐显示名(获取默认背景音乐())

;----------------------------------------------------------------
; 获取SHOP主界面应播放的背景音乐文件名
; 阿拉尼亚村固定使用海风温和，其余地点使用玩家设置的默认BGM
;----------------------------------------------------------------
@获取SHOP背景音乐文件名()
#FUNCTIONS
IF FLAG:当前地点 == GET_NO("地点", "阿拉尼亚村")
	RETURNF 获取背景音乐配置文件名(9)
ELSE
	RETURNF 获取默认背景音乐()
ENDIF

;----------------------------------------------------------------
; 获取SHOP主界面应显示的背景音乐名称
; 优先显示当前已经记录的实际播放曲目；如果为空，再回退到理论应播放曲目
;----------------------------------------------------------------
@获取SHOP背景音乐显示名()
#FUNCTIONS
IF 当前背景音乐 != ""
	RETURNF 通过文件名获取背景音乐显示名(当前背景音乐)
ENDIF
RETURNF 通过文件名获取背景音乐显示名(获取SHOP背景音乐文件名())

;----------------------------------------------------------------
; 在设置中选择默认背景音乐
;----------------------------------------------------------------
@选择默认背景音乐
#DIM 配置编号
#DIMS 配置行文本, 2

PRINTFORML ┏%"━"*36%┓
PRINTFORML ｜%"当前设置: 《" + 获取默认背景音乐显示名() + "》", 72, LEFT%｜
PRINTFORML ｜%"请选择默认背景音乐：", 72, LEFT%｜
PRINTFORML ｜%"", 72, LEFT%｜
FOR 配置编号, 0, 获取背景音乐配置数量()
	IF 获取背景音乐配置显示名(配置编号) == "海风温和" && MAP:GET_NO("地图", "阿拉尼亚村周边地图") == 0
		CONTINUE
	ENDIF
	配置行文本 '= @"[{配置编号}] " + 获取背景音乐配置显示名(配置编号)
	IF 获取默认背景音乐() == 获取背景音乐配置文件名(配置编号)
		配置行文本 += " ◁◁◁◁◁◁◁◁◁【当前】"
	ELSEIF 获取背景音乐配置显示名(配置编号) == "海风温和" && FLAG:当前地点 == GET_NO("地点", "阿拉尼亚村")
		配置行文本 += " ◀◀◀◀◀◀◀◀◀【锁定】"
	ENDIF
	PRINTFORML ｜%配置行文本, 72, LEFT%｜
NEXT
PRINTFORML ｜%"", 72, LEFT%｜
PRINTFORML ｜%"[998] 随机", 72, LEFT%｜
PRINTFORML ｜%"[999] 取消", 72, LEFT%｜
PRINTFORML ┗%"━"*36%┛
INPUTS
SIF RESULTS == "999"
	RETURN 0
IF RESULTS == "998"
	GLOBALS:"默认背景音乐" = %获取背景音乐配置文件名(RAND(0, 获取背景音乐配置数量() - 1))%
ELSEIF ISNUMERIC(RESULTS) && INRANGE(TOINT(RESULTS), 0, 获取背景音乐配置数量())
	GLOBALS:"默认背景音乐" = %获取背景音乐配置文件名(TOINT(RESULTS))%
ENDIF
RETURN 0
