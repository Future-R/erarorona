@BUY_MAP
#DIM TEMP
GUILD_CHOICE = 0
VARSET GUILD_LIST, -1
LOCAL:1 = 0
FOR LOCAL, 0, 地图数
	TRYCCALLFORM MAP_SELL_ABLE_{LOCAL}
		IF RESULT
			GUILD_LIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		ENDIF
	CATCH
	ENDCATCH
NEXT
GUILD_MAXLIST = LOCAL:1 - 1
BUY_MAP_LINE = LINECOUNT
GUILD_LINE_NUM = MAXLINE() - 10 - 3 - 3
$START
CALL SHOW_BUY_MAP
ONEINPUTS
SELECTCASE RESULTS
	CASE "0", ""
		$BUY
		CALLFORM MAP_PRICE_{GUILD_LIST:GUILD_CHOICE}
		LOCAL = RESULT
		CLEARLINE LINECOUNT - BUY_MAP_LINE:1
		IF MAP:(GUILD_LIST:GUILD_CHOICE)
			CALL MESSAGE_WINDOW, "公会成员", "你不是已经有那张地图了吗。"
		ELSE
			IF FLAG:公会点数 >= LOCAL
				CALL MESSAGE_WINDOW, "公会成员", @"%GET_NAME("地图", GUILD_LIST:GUILD_CHOICE)%是吗？/那么，{LOCAL}Pt可以吗？"
				CALL INPUT_YN_M
				IF !RESULT
					CALL MESSAGE_WINDOW, "", "获得了" + GET_NAME("地图", GUILD_LIST:GUILD_CHOICE) + "！"
					MAP:(GUILD_LIST:GUILD_CHOICE) = 1
					FLAG:公会点数 -= LOCAL
					CLEARLINE LINECOUNT - BUY_MAP_LINE
					RESTART
				ENDIF
			ELSE
				CALL MESSAGE_WINDOW, "公会成员", "贡献度还不够/所以不能把地图给你。"
			ENDIF
		ENDIF
	CASE "8"
		SIF --GUILD_CHOICE < 0
			GUILD_CHOICE = GUILD_MAXLIST
	CASE "2"
		SIF ++GUILD_CHOICE > GUILD_MAXLIST
			GUILD_CHOICE = 0
	CASE "4"
		IF !GUILD_CHOICE
			GUILD_CHOICE = GUILD_MAXLIST
		ELSE
			GUILD_CHOICE = MAX(GUILD_CHOICE - GUILD_LINE_NUM, 0)
		ENDIF
	CASE "6" 
		IF GUILD_CHOICE == GUILD_MAXLIST
			GUILD_CHOICE = 0
		ELSE
			GUILD_CHOICE = MIN(GUILD_CHOICE + GUILD_LINE_NUM, GUILD_MAXLIST)
		ENDIF
	CASE "9"
		RETURN 0
	CASEELSE
		ENCODETOUNI %RESULTS%
		SELECTCASE RESULT:1
			CASE 20000 TO 20999
				LOCAL = RESULT:1 - 20000
				IF LOCAL == GUILD_CHOICE
					GOTO BUY
				ELSE
					GUILD_CHOICE = LOCAL
				ENDIF
		ENDSELECT
ENDSELECT
GOTO START

@SHOW_BUY_MAP
#LOCALSIZE 1
#LOCALSSIZE 2
#DIM TEMP
#DIM LAYER_X
#DIM LAYER_Y
#DIM L_COLOR
CALL LAYER_INIT
LAYER_X = 0
LAYER_Y = 0
VARSET GUILD_CHOICES
CALL GET_MAP, GUILD_LIST:GUILD_CHOICE
SPLIT RESULTS, "/", GUILD_CHOICES
VARSET GUILD_EXPLAINS
CALLFORM MAP_EXPLAIN_{GUILD_LIST:GUILD_CHOICE}
SPLIT RESULTS, "/", GUILD_EXPLAINS
CLEARLINE LINECOUNT - BUY_MAP_LINE
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　%SHOW_DAY()%%"", 8%%"-" + "购买地图" + "-", 40, LEFT%篮子空间 [{GET_ITEM_TOTAL("篮子"), 3} / {BASKET_SIZE()}] 箱子空间 [{GET_ITEM_TOTAL("箱子"), 4} / 1000]", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2
CALL LAYER_SET, @"┌%"─"*15%┬%"─"*5%┐┌%"─"*35%┐", LAYER_Y + 3
CALL LAYER_SET, @"│%"名称",30,LEFT%│价格　　　││\@GUILD_LIST:GUILD_CHOICE < 0 ?%"", 70% # %GET_NAME("地图", GUILD_LIST:GUILD_CHOICE),70,LEFT%\@│", LAYER_Y + 4
CALL LAYER_SET, @"├%"─"*15%┼%"─"*5%┤├%"─"*35%┤", LAYER_Y + 5
GUILD_PAGE = GUILD_CHOICE / GUILD_LINE_NUM
FOR LOCAL, 0, GUILD_LINE_NUM
	TEMP = LOCAL + GUILD_PAGE * GUILD_LINE_NUM
	IF GUILD_LIST:TEMP >= 0
		LOCALS '= "│"
		L_COLOR = COLOR("DEF")
		SIF MAP:(GUILD_LIST:TEMP)
			L_COLOR = COLOR("gray")
		SIF GUILD_CHOICE == TEMP
			L_COLOR = COLOR("p-blue")
		IF MAP:(GUILD_LIST:TEMP)
			LOCALS += ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))
		ELSE
			LOCALS += "　"
		ENDIF
		LOCALS += ADD_FTAG(ADD_BTAG(@"%GET_NAME("地图", GUILD_LIST:TEMP),28,LEFT%",  UNICODE(TEMP + 20000)), L_COLOR)
		CALLFORM MAP_PRICE_{GUILD_LIST:TEMP}
		LOCALS += ADD_FTAG(@"│%TOSTR(RESULT), 8%Pt", L_COLOR) + "│"
	ELSE
		LOCALS '= @"│%" "*30%│%" "*10%│"
	ENDIF
	SELECTCASE LOCAL
		CASE IS < 10
			LOCALS +=  @"│%GUILD_CHOICES:LOCAL, 70, LEFT%│"
		CASE GUILD_LINE_NUM - 11
			LOCALS +=  @"├%"─"*35%┤"
		CASE GUILD_LINE_NUM - 10 TO GUILD_LINE_NUM - 1
			LOCALS +=  @"│%GUILD_EXPLAINS:(LOCAL - (GUILD_LINE_NUM - 10)), 70, LEFT%│"
		CASEELSE
			LOCALS +=  @"│%"",70%│"
	ENDSELECT
	CALL LAYER_SET, LOCALS, LAYER_Y + 6 + LOCAL
NEXT
CALL LAYER_SET, "└" + "─" * 6 + ADD_BTAG("[4]" + UNICODE(0x25C0), "4") + " PAGE." + @"{GUILD_PAGE, 2}" + ADD_BTAG(" " + UNICODE(0x25B6) + " [6]", "6") + "┴" + "─" * 5 + "┘" + "└"  + "─" * 35 + "┘", LAYER_Y + 6 + LOCAL
LAYER_Y = LAYER_Y + 7 + LOCAL
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　%@"资金: %TOSTR(MONEY, "#,##0"),12%克尔",44,LEFT%%@"公会点数: %TOSTR(FLAG:公会点数),12%Pt",36,LEFT%%@"调教师EXP: %TOSTR(FLAG:调教师EXP),12%pt"%", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2
BUY_MAP_LINE:1 = LINECOUNT + LAYER_Y + 3
CALL LAYER_SET, "┌" + "─" * 6 + "┐" + " " * 8 + ADD_BTAG("[0] 购买", "0"), LAYER_Y + 3
CALL LAYER_SET, "│" + " " * 4 + ADD_BTAG("[8] " , 8) + " " * 4 + "│", LAYER_Y + 4
CALL LAYER_SET, "│" + ADD_BTAG("[4] " , 4) + " " * 4 + ADD_BTAG("[6] " , 6) + "│", LAYER_Y + 5
CALL LAYER_SET, "│" + " " * 4 + ADD_BTAG("[2] " , 2) + " " * 4 + "│" + " " * 8 + ADD_BTAG("[9] 返回", "9"), LAYER_Y + 6
CALL LAYER_SET, "└" + "─" * 6 + "┘", LAYER_Y + 7
CALL LAYER_PRINT, , MAXLINE()
