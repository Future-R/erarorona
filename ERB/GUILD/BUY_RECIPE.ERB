@BUY_RECIPE
#DIM TEMP, 2
#LOCALSIZE 2
#DIM LAYER_Y
#DIM LAYER_X
#DIM L_COLOR
GUILD_CHOICE = 0
VARSET GUILD_LIST, -1
LOCAL:1 = 0
FOR LOCAL, 0, 参考书数
	TRYCCALLFORM RECIPE_SELL_ABLE_{LOCAL}
		IF RESULT
			GUILD_LIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		ENDIF
	CATCH
	ENDCATCH
NEXT
GUILD_MAXLIST = LOCAL:1 - 1
BUY_RECIPE_LINE = LINECOUNT
GUILD_LINE_NUM = MAXLINE() - 10 - 6
$START
CALL LAYER_INIT
LAYER_Y = 0
LAYER_X = 0
VARSET GUILD_CHOICES
CALL GET_RECIPE, GUILD_LIST:GUILD_CHOICE
SPLIT RESULTS, "/", GUILD_CHOICES
VARSET GUILD_EXPLAINS
CALLFORM RECIPE_EXPLAIN_{GUILD_LIST:GUILD_CHOICE}
SPLIT RESULTS, "/", GUILD_EXPLAINS
CLEARLINE LINECOUNT - BUY_RECIPE_LINE
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　%SHOW_DAY()%%"", 8%%"-" + "参考书購入" + "-", 40, LEFT%篮子空间 [{GET_ITEM_TOTAL("篮子"), 3} / {BASKET_SIZE()}] 箱子空间 [{GET_ITEM_TOTAL("箱子"), 4} / 1000]", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2

;-----------------------------------------------------------------------
;左欄
;-----------------------------------------------------------------------
CALL LAYER_SET, @"┌%"─"*15%┬%"─"*5%┐", LAYER_Y + 3
CALL LAYER_SET, @"│%"名前",30,LEFT%│価格　　　│", LAYER_Y + 4
CALL LAYER_SET, @"├%"─"*15%┼%"─"*5%┤", LAYER_Y + 5
FOR LOCAL, 0, GUILD_LINE_NUM
	TEMP = LOCAL + GUILD_PAGE * GUILD_LINE_NUM
	IF GUILD_LIST:TEMP >= 0
		L_COLOR = COLOR("DEF")
		SIF RECIPE:(GUILD_LIST:TEMP)
			L_COLOR = COLOR("gray")
		SIF GUILD_CHOICE == TEMP
			L_COLOR = COLOR("p-blue")
		CALLFORM RECIPE_PRICE_{GUILD_LIST:TEMP}
		{
		CALL LAYER_SET, "│" + 
						ADD_FTAG(\@RECIPE:(GUILD_LIST:TEMP) ? %UNICODE(0x273F)% # %"　"%\@, COLOR("p-red")) + 
						ADD_FTAG(
							ADD_BTAG(@"%GET_NAME("参考书", GUILD_LIST:TEMP),28,LEFT%", "食谱" + "_" + TOSTR(TEMP)) + 
							@"│%TOSTR(RESULT), 8%Pt│"
						, L_COLOR)
			, LAYER_Y + 6 + LOCAL
		}
	ELSE
		CALL LAYER_SET, @"│%" "*30%│%" "*10%│", LAYER_Y + 6 + LOCAL
	ENDIF
NEXT
CALL LAYER_SET, @"└%"─"*15%┴%"─"*5%┘", LAYER_Y + LOCAL + 6
;--------------------------------------------------------
;右欄
;--------------------------------------------------------
CALL LAYER_SET, @"┌%"─"*35%┐", LAYER_Y + 3
CALL LAYER_SET, @"│\@GUILD_LIST:GUILD_CHOICE < 0 ?%"", 70% # %GET_NAME("参考书", GUILD_LIST:GUILD_CHOICE),70,LEFT%\@│", LAYER_Y + 4
CALL LAYER_SET, "├" + "─" * 15  + "┬" + "─" * 19 +"┤", LAYER_Y + 5
FOR LOCAL, 0, 10
	IF GUILD_CHOICES:LOCAL == ""
		CALL LAYER_SET, "│" + " " * 30 + "│" + " " * 38 + "│", LAYER_Y + 6 + LOCAL
	ELSE
		TEMP = GET_NO("アイテム", GUILD_CHOICES:LOCAL)
		CALLFORM ITEM_LV_{TEMP}
		TEMP:1 = RESULT
		CALL LAYER_SET, "│" + ADD_BTAG(@"%GUILD_CHOICES:LOCAL, 30, LEFT%", "アイテム" + "_" + TOSTR(TEMP)) + "│" + @"%"目標Lv:" + @"{TEMP:1, 2}", 38, LEFT%" + "│", LAYER_Y + 6 + LOCAL
	ENDIF
NEXT
CALL LAYER_SET, "├" + "─" * 15 + "┴" + "─" * 19 +"┤", LAYER_Y + 16
FOR LOCAL, 0, 10
	CALL LAYER_SET, @"│%GUILD_EXPLAINS:LOCAL, 70, LEFT%│", LAYER_Y + 17 + LOCAL
NEXT
FOR LOCAL, LAYER_Y + 17 + LOCAL, LAYER_Y + GUILD_LINE_NUM + 6
	CALL LAYER_SET, "│" + " " * 70 + "│", LOCAL
NEXT
CALL LAYER_SET, @"└%"─"*35%┘", LOCAL
LAYER_Y = LOCAL + 1
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　%@"所持金: %TOSTR(MONEY, "#,##0"),12%克尔",44,LEFT%%@"公会点数: %TOSTR(FLAG:公会点数),12%Pt",36,LEFT%%@"TrainEXP: %TOSTR(FLAG:调教师EXP),12%pt"%", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2
BUY_RECIPE_LINE:1 = LINECOUNT + LAYER_Y + 3
CALL LAYER_SET, @"┌%"─"*6%┐", LAYER_Y + 3
CALL LAYER_SET, "│" + " " * 4 + ADD_BTAG("[8] ", "8") + " " * 4 + "│", LAYER_Y + 4
CALL LAYER_SET, "│" + ADD_BTAG("[4] ", "4") + " " * 4 + ADD_BTAG("[6] ", "6") + "│", LAYER_Y + 5
CALL LAYER_SET, "│" + " " * 4 + ADD_BTAG("[2] ", "2") + " " * 4 + "│", LAYER_Y + 6
CALL LAYER_SET, "└" + "─" * 6 + "┘", LAYER_Y + 7

CALL LAYER_SET, @"%"", 8%", LAYER_Y + 3
CALL LAYER_SET, @"%"", 8%", LAYER_Y + 4
CALL LAYER_SET, @"%"", 8%", LAYER_Y + 5
CALL LAYER_SET, @"%"", 8%", LAYER_Y + 6
CALL LAYER_SET, @"%"", 8%", LAYER_Y + 7

CALL LAYER_SET, ADD_BTAG("[0] 購入", "0"), LAYER_Y + 3
CALL LAYER_SET, ADD_BTAG("[9] 戻る", "9"), LAYER_Y + 7
CALL LAYER_PRINT, , MAXLINE()

ONEINPUTS
SELECTCASE AUTO_SPLIT(RESULTS, "_", 0)
	CASE "0", ""
		$BUY
		CALLFORM RECIPE_PRICE_{GUILD_LIST:GUILD_CHOICE}
		LOCAL = RESULT
		CLEARLINE LINECOUNT - BUY_RECIPE_LINE:1
		IF RECIPE:(GUILD_LIST:GUILD_CHOICE)
			CALL MESSAGE_WINDOW, "公会成员", "その参考书はもう持ってるじゃないか"
		ELSE
			IF FLAG:公会点数 >= LOCAL
				CALL MESSAGE_WINDOW, "公会成员", @"%GET_NAME("参考书", GUILD_LIST:GUILD_CHOICE)%だな？/それなら、{LOCAL}Ptになるがいいか？"
				CALL INPUT_YN
				IF !RESULT
					CALL MESSAGE_WINDOW, "", GET_NAME("参考书", GUILD_LIST:GUILD_CHOICE) + "を手に入れた！"
					RECIPE:(GUILD_LIST:GUILD_CHOICE) = 1
					FLAG:公会点数 -= LOCAL
					CLEARLINE LINECOUNT - BUY_RECIPE_LINE
					RESTART
				ENDIF
			ELSE
				CALL MESSAGE_WINDOW, "公会成员", "貢献度が足りてないぞ/それじゃあ参考书は渡してやれねーな"
			ENDIF
		ENDIF
	CASE "8"
		SIF --GUILD_CHOICE < 0
			GUILD_CHOICE = GUILD_MAXLIST
	CASE "2"
		SIF ++GUILD_CHOICE > GUILD_MAXLIST
			GUILD_CHOICE = 0
	CASE "4"
		IF !GUILD_CHOICE
			GUILD_CHOICE = GUILD_MAXLIST
		ELSE
			GUILD_CHOICE = MAX(GUILD_CHOICE - GUILD_LINE_NUM, 0)
		ENDIF
	CASE "6" 
		IF GUILD_CHOICE == GUILD_MAXLIST
			GUILD_CHOICE = 0
		ELSE
			GUILD_CHOICE = MIN(GUILD_CHOICE + GUILD_LINE_NUM, GUILD_MAXLIST)
		ENDIF
	CASE "9"
		RETURN 0
	CASE "アイテム"
		CLEARLINE LINECOUNT - BUY_RECIPE_LINE:1
		TRYCCALLFORM ITEM_EXPLAIN_{AUTO_SPLIT_INT(RESULTS, "_", 1)}
			FOR LOCAL, 0, 6
				PRINTFORML %AUTO_SPLIT(RESULTS , "/", LOCAL)%
			NEXT
			WAITANYKEY
		CATCH
		ENDCATCH
	CASE "食谱"
		IF AUTO_SPLIT_INT(RESULTS, "_", 1) == GUILD_CHOICE
			GOTO BUY
		ELSE
			GUILD_CHOICE = AUTO_SPLIT_INT(RESULTS, "_", 1)
		ENDIF
ENDSELECT
GOTO START
