;@MAIN_GUILD	ギルドの冒頭
;---------------------------------------------------------------------
;---------------------------------------------------------------------
;@MAIN_GUILD
;ギルドの冒頭。ここから子関数にわりふっていく
;---------------------------------------------------------------------
@MAIN_GUILD
#LOCALSIZE 5
#DIM LAYER_Y
#DIM LINE,2
#DIM START
#DIMS MESSAGE
MESSAGE = 你来了啊。/今天有什么事吗？
LINE = LINECOUNT
LOCAL:1 = 0
REDRAW 0
$START
LAYER_Y = 0
CALL LAYER_INIT
CLEARLINE LINECOUNT - LINE
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　%SHOW_DAY()%天%"", 8%%"-" + "暗之公会" + "-", 40, LEFT%篮子空间 [{GET_ITEM_TOTAL("篮子"), 3} / {BASKET_SIZE()}] 箱子空间 [{GET_ITEM_TOTAL("箱子"), 4} / 1000]", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2

LAYER_Y = MAXLINE() - 6 -3
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　%@"公会点数: %TOSTR(FLAG:公会点数),12%Pt",36,LEFT%%@"TRAINEXP: %TOSTR(FLAG:调教师EXP),12%pt", 36, LEFT%", LAYER_Y + 1
IF GET_TABLE_GRANK(FLAG:公会等阶 + 1)
	CALL LAYER_SET, "NEXTLv:" + @"{GET_TABLE_GRANK(FLAG:公会等阶 + 1), 12}" + "pt", LAYER_Y + 1
ELSE
	CALL LAYER_SET, "NEXTLv:" + " " * 9 + "---pt", LAYER_Y + 1
ENDIF
CALL LAYER_DRAWLINE, LAYER_Y + 2
CALL LAYER_PRINT, , MAXLINE() - 6
LINE:1 = LINECOUNT
CALL MESSAGE_WINDOW, "公会成员", MESSAGE
MESSAGE = 还有什么别的事吗？
PRINTFORML %"[0] 公会委托", 32, LEFT%[7] 评估成就
PRINTFORML %"[1] 购买物品", 32, LEFT%\@!FLAG:已缴费 ?[8] 偿还债务 # \@
PRINTFORML [2] 购买地图
PRINTFORML [3] 购买参考书
PRINTFORML [9] 返回
PRINTL 
CALL INPUT_SPLIT, "0/1/2/3/7/9" + @"\@!FLAG:已缴费 ? /8 # \@"
CLEARLINE LINECOUNT - LINE:1
SELECTCASE RESULT
	CASE 0
		CALL MESSAGE_WINDOW, "公会成员", "目前发布的委托大概是这样的。"
		CALL GUILD_G_REQ_LIST
	CASE 1
		CALL SET_STORE_DATA, 9
		CALL BUY_STORE, 9
		GOTO START
	CASE 2
		CALL BUY_MAP
		GOTO START
	CASE 3
		CALL BUY_RECIPE
		GOTO START
	CASE 7
		CALL ASSESSMENT_RECORD
	CASE 8
		CALL PAY_BACK
	CASE 9
		REDRAW 1
		RETURN 0
ENDSELECT
;-----------------------------------
;ランクアップ処理
;-----------------------------------
LOCAL = 0
WHILE FLAG:调教师EXP >= GET_TABLE_GRANK(FLAG:公会等阶 + 1) && GET_TABLE_GRANK(FLAG:公会等阶 + 1)
	FLAG:公会等阶++
	GRANK_UP_DAY:(FLAG:公会等阶) = DAY
	LOCAL = 1
WEND
IF LOCAL
	CLEARLINE LINECOUNT - LINE:1
	CALL MESSAGE_WINDOW, "公会成员", "哎呀，稍等一下。/既然你已经做出了足够的成就，我就给你提升调教师等阶吧。"
	SELECTCASE FLAG:公会等阶
		CASE 1
			CALL MESSAGE_WINDOW, "公会成员", "好，现在是等阶IRON了。/虽然你还只是个初出茅庐的菜鸟，/但至少明白该怎么做基础工作了吧？"
		CASE 2
			CALL MESSAGE_WINDOW, "公会成员", "嚯，升到BRONZE了啊。/差不多该掌握调教的手感了吧？/要是这样的话最好，如果还没的话，/或许该在炼金术方面加把劲啊。"
			CALL MESSAGE_WINDOW, "公会成员", "公会对小姑娘你的炼金术也抱有期待，/那边方向的努力同样可以被评估。/要是调教有困难就专注那边吧。"
		CASE 3
			CALL MESSAGE_WINDOW, "公会成员", "从今天起小姑娘就是等阶SILVER了。/已经称得上是个像样的调教师了。/不过，这个水平的调教师也是一抓一大把。"
			CALL MESSAGE_WINDOW, "公会成员", "如果小姑娘你不想被卖掉的话，/还得继续努力，不能松懈哦。"
		CASE 4
			CALL MESSAGE_WINDOW, "公会成员", "没想到居然能升到等阶GOLD啊。/说实话没想到小姑娘你能走到这步……/该说不愧是炼金术的功劳吗？"
			CALL MESSAGE_WINDOW, "公会成员", "但要成为一流调教师还差最后一步。/既然都走到这里了，就继续加油吧。"
		CASE 5
			CALL MESSAGE_WINDOW, "公会成员", "好，现在升为等阶PLATINUM了。/说你是一流调教师也不为过了吧。/公会应该也不会再说要把小姑娘你卖掉这种话了。"
			CALL MESSAGE_WINDOW, "公会成员", "安心等待还款期限那天就好。/恭喜啊。"
	ENDSELECT
ENDIF
GOTO START
@GUILD_G_REQ_LIST
#LOCALSIZE 5
#LOCALSSIZE 50
#DIM MAXLIST, 1
#DIM LIST, 100
#DIM LISTNUM
#DIMS MODE
#DIM G_REQ, 1
#DIM LINE, 3
#DIM TEMP, 3
#DIMS TEMPS
#DIM PAGE
#DIM MAXPAGE
#DIM SHOW_PAGE
#DIM SHOW_NUM
#DIM C_REDRAW
#DIM MARKS_ABLE, 52
#DIM VALUE, 4
VARSET LIST, -1
CL_CHARA = -1
LISTNUM = 0
SHOW_PAGE = 1
MODE = 委托选择
;-----------------------------------------------------------
;リスト作成
;-----------------------------------------------------------
LOCAL:1 = 0
FOR LOCAL, 0, 公会委托数
	TRYCCALLFORM G_REQ_ABLE_{LOCAL}
		SIF !RESULT
			CONTINUE
		LIST:(LOCAL:1) = LOCAL
		LOCAL:1++
	CATCH
	ENDCATCH
NEXT
SHOW_PAGE = 0
SHOW_NUM = MAXLINE() - 14

CL_SHOW_NUM = MAXLINE() - 14

MAXLIST = VARSIZE("LIST") - MATCH(LIST, -1) - 1
MAXPAGE = (VARSIZE("LIST") - MATCH(LIST, -1)) / SHOW_NUM

LINE = LINECOUNT
C_REDRAW = CURRENTREDRAW()
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
CL_CHARA = CHARALIST:(CL_LISTNUM)
CL_PAGE = CL_LISTNUM / CL_SHOW_NUM
G_REQ = LIST:LISTNUM
PAGE = LISTNUM / SHOW_NUM
CL_LISTNUM = FINDELEMENT(CHARALIST, CL_CHARA)
DRAWLINE
PRINTL 　暗之公会委托
DRAWLINE
FOR LOCAL, 0, MAXLINE() - 7
	IF MODE == "角色选择"
		CALL SHOW_CHARALIST_LEFT, LOCAL, "公会委托"
	ELSE
		SELECTCASE LOCAL
			CASE 0, MAXLINE() - 12
				PRINTFORM ┌%"─" * 11%┐
			CASE MAXLINE() - 13
				PRINTFORM └%"─" * 6%PAGE [{PAGE}/{MAXPAGE}]┘
			CASE MAXLINE() - 11
				PRINTFORM │%"",9%
				PRINTBUTTON "[ 8]", "8"
				PRINTFORM %"",9%│
			CASE MAXLINE() - 10
				PRINTFORM │%"",5%
				PRINTBUTTON "[ 4]", "4"
				PRINTFORM %"", 4%
				PRINTBUTTON "[ 6]", "6"
				PRINTFORM %"",5%│
			CASE MAXLINE() - 9
				PRINTFORM │%"",9%
				PRINTBUTTON "[ 2]", "2"
				PRINTFORM %"",9%│
			CASE MAXLINE() - 8
				PRINTFORM └%"─" * 11%┘
			CASEELSE
				PRINT │
				TEMP = LOCAL + PAGE * SHOW_NUM - 1
				IF LIST:TEMP >= 0
					SIF G_REQ == LIST:TEMP
						SETCOLOR COLOR("p-green")
					PRINTBUTTON @"[%GET_KEYMARK(LOCAL-1)%] %GET_NAME("公会委托", LIST:TEMP), 18, LEFT%", GET_KEYMARK(LOCAL-1)
					RESETCOLOR
					MARKS_ABLE:(LOCAL - 1) = LIST:TEMP
				ELSE
					PRINTFORM %"",22%
					MARKS_ABLE:(LOCAL - 1) = -1
				ENDIF
				PRINT │
		ENDSELECT
	ENDIF
	IF MODE == "角色选择" && SHOW_PAGE == 1
		CALL SHOW_CHARALIST_RIGHT_1, LOCAL, "公会委托"
	ELSE
		SELECTCASE LOCAL
			CASE 0
				PRINTFORM ┌委托%TOSTR(G_REQ, "00") + "─" * 45%┐
			CASE 1
				PRINTFORM │%GET_NAME("公会委托", G_REQ),96,LEFT%│
			CASE 3
				PRINTFORM ┌条件%"─" * 46%┐
				CALLFORM G_REQ_ABLE_CHARA_{G_REQ}
				VARSET LOCALS
				SPLIT RESULTS, "/", LOCALS
			CASE 4 TO 8
				PRINTFORM │%LOCALS:(LOCAL-4), 96,LEFT%│
			CASE 10, 14, 18
				PRINTFORM ┌评价%"─" * 46%┐
				CALLFORM G_REQ_VALUE_{(LOCAL - 10) / 4}_{G_REQ}, MODE == "角色选择" ? CL_CHARA # -1
				IF MODE == "角色选择"
					VALUE:((LOCAL - 10)/4 + 1) = RESULT
					TEMP:1 = RESULT / 10
				ELSE
					SELECTCASE LOCAL
						CASE 10
							TEMP:1 = G_REQ_VALUE_0:G_REQ / 10
						CASE 14
							TEMP:1 = G_REQ_VALUE_1:G_REQ / 10
						CASE 18
							TEMP:1 = G_REQ_VALUE_2:G_REQ / 10
					ENDSELECT
				ENDIF
			CASE 11, 15, 19
				PRINTFORM │%RESULTS, 96,LEFT%│
			CASE 12, 16, 20, 23
				PRINT │
				FOR LOCAL:1, 1, 11
					SETCOLOR TEMP:1 >= LOCAL:1 ? COLOR("p-red") # COLOR("gray")
					PRINT ★
				NEXT
				RESETCOLOR
				PRINTFORM %"", 76%│
			CASE 22
				PRINTFORM ┌综合评价%"─" * 44%┐
				IF MODE == "角色选择"
					VALUE = (VALUE:1 + VALUE:2 + VALUE:3) / 3
					TEMP:1 = VALUE / 10
				ELSE
					TEMP:1 = G_REQ_VALUE:G_REQ / 10
				ENDIF
			CASE 25
				PRINTFORM ┌说明%"─" * 46%┐
				CALLFORM G_REQ_EXPLAIN_{G_REQ}
				VARSET LOCALS
				SPLIT RESULTS, "/", LOCALS
			CASE 26 TO 32
				PRINTFORM │%LOCALS:(LOCAL-26), 96,LEFT%│
			CASE 2, 9, 13, 17, 21, 24, 33
				PRINTFORM └%"─" * 48%┘
			CASEELSE
				PRINTFORM │%"", 96,LEFT%│
		ENDSELECT
	ENDIF
	PRINTL 
NEXT
DRAWLINE
LINE:1 = LINECOUNT
PRINTBUTTON "　[En] 确定", ""
IF MODE == "角色选择"
	PRINTFORM %"", 14%
	CALL PRINTSBUTTON_C, "　[ +] PAGE.1", "+", SHOW_PAGE == 1, COLOR("p-green"),
	PRINTFORM %"", 12%
	CALL PRINTSBUTTON_C, "　[ -] PAGE.2", "-", SHOW_PAGE == 2, COLOR("p-green"),
ENDIF
PRINTL 
PRINTBUTTON "　[ 9] 返回", "9"
PRINTFORM %"", 14%
PRINTL 
PRINTL 
LINE:2 = LINECOUNT
$INPUT_LOOP_2
CLEARLINE LINECOUNT - LINE:2
ONEINPUTS
IF GET_KEYMARK_NUM(RESULTS) >= 0
	IF MODE == "角色选择"
		IF CL_MARKS_ABLE:GET_KEYMARK_NUM(RESULTS) >= 0
			IF CL_LISTNUM == (GET_KEYMARK_NUM(RESULTS) + CL_PAGE * CL_SHOW_NUM)
				GOTO SELL_CHARA
			ELSE
				CL_LISTNUM = GET_KEYMARK_NUM(RESULTS) + CL_PAGE * CL_SHOW_NUM
			ENDIF
		ENDIF
	ELSE
		IF MARKS_ABLE:GET_KEYMARK_NUM(RESULTS) >= 0
			IF LISTNUM == (GET_KEYMARK_NUM(RESULTS) + PAGE * SHOW_NUM)
				GOTO CHOICE_CHARA
			ELSE
				LISTNUM = GET_KEYMARK_NUM(RESULTS) + PAGE * SHOW_NUM
			ENDIF
		ENDIF
	ENDIF
ELSE
	SELECTCASE RESULTS
		CASE ""
			IF MODE == "角色选择"
				$SELL_CHARA
				CALLFORM G_REQ_REWARD_{G_REQ}
				;---------------------------
				;価格計算
				;すでに得ている評価は価格が1/5になる
				;---------------------------
				;一点あたりの価格
				TEMP = RESULT / 100
				LOCAL = 0
				;フルに入る価格
				LOCAL += MAX(VALUE - G_REQ_VALUE:G_REQ, 0) * TEMP
				LOCAL:1 = MAX(VALUE - G_REQ_VALUE:G_REQ, 0) * TEMP / 10
				;軽減がかかる価格
				LOCAL += MIN(G_REQ_VALUE:G_REQ, VALUE) * TEMP / 5
				;つけている装飾品の数
				LOCAL:2 = (GET_EQUIP("装饰品0", CL_CHARA, "ID") > 0) + (GET_EQUIP("装饰品1", CL_CHARA, "ID") > 0)
				CLEARLINE LINECOUNT - LINE
				CALL MESSAGE_WINDOW, "公会成员", @"………嗯~/如果把%CALLNAME:CL_CHARA%交给我的话，/你可以获得{LOCAL}公会点数呢。"
				CALL INPUT_YN_M, @"要交出%CALLNAME:CL_CHARA%吗？"
				IF RESULT == 0
					IF LOCAL:2 > 0 && GET_ITEM_TOTAL("持有") + LOCAL:2 > BASKET_SIZE() + 1000
						CALL INPUT_YN, @"物品已满，无法卸下%CALLNAME:CL_CHARA%佩戴的装饰品。/要就这样交出去吗？"
						IF RESULT
							CALL MESSAGE_WINDOW, "公会成员", "这样啊……"
							RETURN 1
						ENDIF
						LOCAL:2 = 0
					ENDIF
					CALL MESSAGE_WINDOW, "公会成员", @"好，明白了。/那么我就收下%CALLNAME:CL_CHARA%了。"
					CALL MESSAGE_WINDOW, "", @"获得了{LOCAL}公会点数。\@LOCAL:1 > 0 ? /获得了{LOCAL:1}调教师EXP。 # \@"
					FOR LOCAL:4, 0, 2
						IF LOCAL:2
							SIF !LOCAL:2
								BREAK
							FOR LOCAL:3, GET_ITEM_RANGE(\@LOCAL:2 ? 篮子 # 箱子 \@), GET_ITEM_RANGE(\@LOCAL:2 ? 篮子 # 箱子 \@, 1)
								SIF GET_ITEMDATA(LOCAL:3, "ID")
									CONTINUE
								IF GET_EQUIP("装饰品0", CL_CHARA, "ID") > 0
									CALL CONVERT_EQUIP, "装饰品0", CL_CHARA, LOCAL:3
									LOCALS = %GET_NAME("物品", GET_EQUIP("装饰品0", CL_CHARA, "ID"))%
									CSTR:CL_CHARA:装饰品0 = 
									LOCAL:2--
									CONTINUE
								ENDIF
								IF GET_EQUIP("装饰品1", CL_CHARA, "ID") > 0
									CALL CONVERT_EQUIP, "装饰品1", CL_CHARA, LOCAL:3
									IF LOCALS != ""
										LOCALS += "と" + GET_NAME("物品", GET_EQUIP("装饰品1", CL_CHARA, "ID"))
									ELSE
										LOCALS = %GET_NAME("物品", GET_EQUIP("装饰品1", CL_CHARA, "ID"))%
									ENDIF
									CSTR:CL_CHARA:装饰品1 = 
									LOCAL:2--
									CONTINUE
								ENDIF
							NEXT
							CALL MESSAGE_WINDOW, "", @"%CALLNAME:CL_CHARA%身上佩戴的/%LOCALS%被卸下来了。/"
						ENDIF
					NEXT
					FLAG:调教师EXP += LOCAL:1
					FLAG:公会点数 += LOCAL
					G_REQ_VALUE:G_REQ = MAX(VALUE, G_REQ_VALUE:G_REQ)
					G_REQ_VALUE_0:G_REQ = MAX(VALUE:1, G_REQ_VALUE_0:G_REQ)
					G_REQ_VALUE_1:G_REQ = MAX(VALUE:2, G_REQ_VALUE_1:G_REQ)
					G_REQ_VALUE_2:G_REQ = MAX(VALUE:3, G_REQ_VALUE_2:G_REQ)
					CALL DELETE_CHARA, CL_CHARA
					RETURN 1
				ELSE
					CALL MESSAGE_WINDOW, "公会成员", "这样啊……"
				ENDIF
			ELSE
				$CHOICE_CHARA
				VARSET CHARALIST, -1
				LOCAL:1 = 0
				FOR LOCAL, 0, CHARANUM
					SIF LOCAL == MASTER
						CONTINUE
					SIF CFLAG:LOCAL:人类
						CONTINUE
					SIF !IS_EXIST_HERE(LOCAL)
						CONTINUE
					CALLFORM G_REQ_ABLE_CHARA_{G_REQ}, LOCAL
					SIF !RESULT
						CONTINUE
					CHARALIST:(LOCAL:1) = LOCAL
					LOCAL:1++
				NEXT
				IF LOCAL:1
					CL_SHOW_NUM = SHOW_NUM
					CL_MAXPAGE = (VARSIZE("CHARALIST") - MATCH(CHARALIST, -1)) / CL_SHOW_NUM
					CL_MAXLIST = VARSIZE("CHARALIST") - MATCH(CHARALIST, -1) - 1
					CL_CHARA = 0
					MODE = 角色选择
					SHOW_PAGE = 2
					CLEARLINE LINECOUNT - LINE:1
					PRINTL 请选择要出售的奴隶。
					PRINTL 
					PRINTW 
					CLEARLINE LINECOUNT - LINE:1
					CALL SHOW_BLANK
				ELSE
					CLEARLINE LINECOUNT - LINE:1
					PRINTL 没有满足条件的奴隶！
					PRINTL 
					PRINTW 
					CLEARLINE LINECOUNT - LINE:1
				ENDIF
			ENDIF
		CASE "+"
			SIF MODE == "角色选择"
				SHOW_PAGE = 1
		CASE "-"
			SIF MODE == "角色选择"
				SHOW_PAGE = 2
		CASE "8"
			IF MODE == "角色选择"
				CL_LISTNUM--
			ELSE
				LISTNUM--
			ENDIF
		CASE "2"
			IF MODE == "角色选择"
				CL_LISTNUM++
			ELSE
				LISTNUM++
			ENDIF
		CASE "4"
			IF MODE == "角色选择"
				CL_LISTNUM -= CL_SHOW_NUM
			ELSE
				LISTNUM -= SHOW_NUM
			ENDIF
		CASE "6"
			IF MODE == "角色选择"
				CL_LISTNUM += CL_SHOW_NUM
			ELSE
				LISTNUM += SHOW_NUM
			ENDIF
		CASE "9"
			IF MODE == "角色选择"
				MODE = 委托选择
			ELSE
				REDRAW C_REDRAW
				RETURN 1000
			ENDIF
	ENDSELECT
ENDIF
SIF LISTNUM < 0
	LISTNUM = MAXLIST
SIF LISTNUM > MAXLIST
	LISTNUM = 0
SIF CL_LISTNUM < 0
	CL_LISTNUM = CL_MAXLIST
SIF CL_LISTNUM > CL_MAXLIST
	CL_LISTNUM = 0
GOTO START
