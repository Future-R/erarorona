;その等级のになるのに必要な総经验值のテーブル
@GET_TABLE_GRANK, ARG
#FUNCTION
SELECTCASE ARG == -1 ? FLAG:公会等阶 + 1 # ARG
	CASE 0
		RETURNF 0
	CASE 1
		RETURNF 50
	CASE 2
		RETURNF 500
	CASE 3
		RETURNF 1500
	CASE 4
		RETURNF 3000
	CASE 5
		RETURNF 6000
	CASE 6
		RETURNF 12000
	CASE 7
		RETURNF 25000
	CASE 8
		RETURNF 50000
ENDSELECT
RETURNF 0
