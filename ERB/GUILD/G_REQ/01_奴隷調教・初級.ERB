@G_REQ_NAME_1
RESULTS = 奴隶调教：初级

@G_REQ_ABLE_1
RETURN 1

@G_REQ_ABLE_CHARA_1, ARG
RESULTS = ABL[服从]が1以上/ABL[技巧]が1以上/ABL[欲望]が1以上
SIF !GET_NATURE_ABL("服从", ARG)
	RETURN 0
SIF !GET_NATURE_ABL("技巧", ARG)
	RETURN 0
SIF !GET_NATURE_ABL("欲望", ARG)
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_1, ARG = -1
RESULTS = ABL[服从]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("服从", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_1_1, ARG = -1
RESULTS = ABL[技巧]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("技巧", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_1, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 33
