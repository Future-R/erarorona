@G_REQ_NAME_2
RESULTS = 性感开发：初级

@G_REQ_ABLE_2
RETURN 1

@G_REQ_ABLE_CHARA_2, ARG
RESULTS = ABL[欲望]为1或以上/感度系ABL合计5或以上/MARK[快乐烙印]比MARK[抗拒烙印]高出1或以上
SIF !GET_NATURE_ABL("欲望", ARG)
	RETURN 0
SIF GET_NATURE_ABL("Ｃ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) + GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｂ感觉", ARG) < 5
	RETURN 0
SIF (MARK:ARG:快乐烙印 - MARK:ARG:抗拒烙印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_2, ARG = -1
RESULTS = ABL[欲望]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 25
		CASE 2
			RETURN 50
		CASE 3
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_2, ARG = -1
RESULTS = 感度系ABL合计值较高
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("Ｃ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) + GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｂ感觉", ARG) - 4) * 100 / 6, 0, 100)
@G_REQ_VALUE_2_2, ARG = -1
RESULTS = MARK[快乐烙印]较高，MARK[抗拒烙印]较低
IF ARG >= 0
	SELECTCASE MARK:ARG:快乐烙印 - MARK:ARG:抗拒烙印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
