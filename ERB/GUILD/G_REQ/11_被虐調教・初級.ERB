@G_REQ_NAME_11
RESULTS = 受虐调教：初级

@G_REQ_ABLE_11
SIF FLAG:公会等阶 < 1
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_11, ARG
RESULTS = ABL[暴露癖]为1或以上/ABL[受虐倾向]为1或以上/MARK[苦痛烙印]比MARK[抗拒烙印]高
SIF !GET_NATURE_ABL("暴露癖", ARG)
	RETURN 0
SIF !GET_NATURE_ABL("受虐倾向", ARG)
	RETURN 0
SIF (MARK:ARG:苦痛烙印 - MARK:ARG:抗拒烙印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_11, ARG = -1
RESULTS = ABL[暴露癖]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("暴露癖", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 25
		CASE 2
			RETURN 50
		CASE 3
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_11, ARG = -1
RESULTS = ABL[受虐倾向]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("受虐倾向", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_11, ARG = -1
RESULTS = MARK[苦痛烙印]较高，MARK[抗拒烙印]较低
IF ARG >= 0
	SELECTCASE MARK:ARG:苦痛烙印 - MARK:ARG:抗拒烙印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_11
RESULTS = 很多人会对折磨对方或看见对方痛苦的姿态感到兴奋。/请调教出能满足此类需求的奴隶。

@G_REQ_REWARD_11
RETURN 3500
