@G_REQ_NAME_12
RESULTS = 性交指导：初级

@G_REQ_ABLE_12
SIF FLAG:公会等阶 < 1
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_12, ARG
RESULTS = ABL[Ｖ感觉]和ABL[Ａ感觉]合计4或以上/ABL[性交成瘾]为1或以上/ABL[欲望]为3或以上
SIF GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) < 4
	RETURN 0
SIF !GET_NATURE_ABL("性交成瘾", ARG)
	RETURN 0
SIF GET_NATURE_ABL("欲望", ARG) < 3
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_12, ARG = -1
RESULTS = ABL[Ｖ感觉]和ABL[Ａ感觉]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG)
		CASE IS < 4
			RETURN 0
		CASE 4
			RETURN 20
		CASE 5
			RETURN 40
		CASE 6
			RETURN 60
		CASE 7
			RETURN 80
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_12, ARG = -1
RESULTS = ABL[性交成瘾]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("性交成瘾", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF

@G_REQ_VALUE_2_12, ARG = -1
RESULTS = ABL[欲望]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 33
		CASE 4
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF

@G_REQ_EXPLAIN_12
RESULTS = 希望调教擅长性交的奴隶。/顾客表示无论是前面还是后面都无所谓。

@G_REQ_REWARD_12
RETURN 3000
