@G_REQ_NAME_12
RESULTS = 性交指導・初級

@G_REQ_ABLE_12
SIF FLAG:ギルドランク < 1
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_12, ARG
RESULTS = ABL[Ｖ感覚]とABL[Ａ感覚]の合計が4以上/ABL[性交中毒]が1以上/ABL[欲望]が3以上
SIF GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) < 4
	RETURN 0
SIF !GET_NATURE_ABL("性交中毒", ARG)
	RETURN 0
SIF GET_NATURE_ABL("欲望", ARG) < 3
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_12, ARG = -1
RESULTS = ABL[Ｖ感覚]とABL[Ａ感覚]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG)
		CASE IS < 4
			RETURN 0
		CASE 4
			RETURN 20
		CASE 5
			RETURN 40
		CASE 6
			RETURN 60
		CASE 7
			RETURN 80
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_12, ARG = -1
RESULTS = ABL[性交中毒]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("性交中毒", ARG)
		CASE 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF

@G_REQ_VALUE_2_12, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 33
		CASE 4
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF

@G_REQ_EXPLAIN_12
RESULTS = 性交に長けた奴隷の調教が希望されている。/なお、顧客は前でも後ろでも構わないそうだ。

@G_REQ_REWARD_12
RETURN 3000
