@G_REQ_NAME_21
RESULTS = 奴隶调教：中级

@G_REQ_ABLE_21
SIF FLAG:公会等阶 < 2
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_21, ARG
RESULTS = ABL[服从]が3以上/ABL[技巧]が3以上/ABL[欲望]が3以上
SIF GET_NATURE_ABL("服从", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("技巧", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("欲望", ARG) < 3
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_21, ARG = -1
RESULTS = ABL[服从]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("服从", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 33
		CASE 4
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_1_21, ARG = -1
RESULTS = ABL[技巧]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("技巧", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 33
		CASE 4
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_21, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 33
		CASE 4
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_21
RESULTS = 奴隶的基本ABL包括服从、技巧和欲望。/另外，服从可以通过给予快感或恐惧来实现，/欲望可以通过给予快感来实现，/技巧可以通过让其侍奉来提升。

@G_REQ_REWARD_21
RETURN 5000
