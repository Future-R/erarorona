@G_REQ_NAME_22
RESULTS = 性感開発・中級

@G_REQ_ABLE_22
SIF FLAG:ギルドランク < 2
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_22, ARG
RESULTS = ABL[欲望]が3以上/感度系ABLの合計値が10以上/MARK[快楽刻印]がMARK[反発刻印]より1以上高い
SIF GET_NATURE_ABL("欲望", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("Ｃ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) + GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｂ感覚", ARG) < 10
	RETURN 0
SIF (MARK:ARG:快楽刻印 - MARK:ARG:反発刻印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_22, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_22, ARG = -1
RESULTS = 感度系ABLの合計値が高い
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("Ｃ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) + GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｂ感覚", ARG) - 10) * 10, 0, 100)
@G_REQ_VALUE_2_22, ARG = -1
RESULTS = MARK[快楽刻印]が高く、MARK[反発刻印]が低い
IF ARG >= 0
	SELECTCASE MARK:ARG:快楽刻印 - MARK:ARG:反発刻印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_22
RESULTS = 感度が高く反応が良好な奴隷は多くの顧客にとって好まれる。/様々な部位を開発し、主人を楽しむのに適した奴隷を作ること。

@G_REQ_REWARD_22
RETURN 5000
