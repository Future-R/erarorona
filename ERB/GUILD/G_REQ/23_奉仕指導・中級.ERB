@G_REQ_NAME_23
RESULTS = 侍奉指导：中级

@G_REQ_ABLE_23
SIF FLAG:公会等阶 < 2
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_23, ARG
RESULTS = ABL[技巧]为3或以上/ABL[侍奉精神]为3或以上/MARK[屈服烙印]比MARK[抗拒烙印]高出1或以上
SIF GET_NATURE_ABL("技巧", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("侍奉精神", ARG) < 3
	RETURN 0
SIF (MARK:ARG:屈服烙印 - MARK:ARG:抗拒烙印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_23, ARG = -1
RESULTS = ABL[技巧]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("技巧", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_23, ARG = -1
RESULTS = ABL[侍奉精神]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("侍奉精神", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 33
		CASE 4
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_23, ARG = -1
RESULTS = MARK[屈服烙印]较高，MARK[抗拒烙印]较低
IF ARG >= 0
	SELECTCASE MARK:ARG:屈服烙印 - MARK:ARG:抗拒烙印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_23
RESULTS = 奴隶的本分自然是侍奉。/不仅需要高超的技巧，/更要以侍奉为喜悦与生存意义。/这样的奴隶才称得上是理想的奴隶。/需注意，提升侍奉精神的关键，侍奉快乐经验/需要让奴隶在获得快感的同时进行侍奉才能提升。

@G_REQ_REWARD_23
RETURN 5000
