@G_REQ_NAME_31
RESULTS = 受虐调教：中级

@G_REQ_ABLE_31
SIF FLAG:公会等阶 < 3
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_31, ARG
RESULTS = ABL[暴露癖]为3或以上/ABL[受虐倾向]为3或以上/MARK[苦痛烙印]比MARK[抗拒烙印]高
SIF GET_NATURE_ABL("暴露癖", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("受虐倾向", ARG) < 3
	RETURN 0
SIF (MARK:ARG:苦痛烙印 - MARK:ARG:抗拒烙印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_31, ARG = -1
RESULTS = ABL[暴露癖]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("暴露癖", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_31, ARG = -1
RESULTS = ABL[受虐倾向]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("受虐倾向", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_31, ARG = -1
RESULTS = MARK[苦痛烙印]较高，MARK[抗拒烙印]较低
IF ARG >= 0
	SELECTCASE MARK:ARG:苦痛烙印 - MARK:ARG:抗拒烙印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_31
RESULTS = 很多人会对折磨对方或看见对方痛苦的姿态感到兴奋。/请调教出能满足此类需求的奴隶。

@G_REQ_REWARD_31
RETURN 10000
