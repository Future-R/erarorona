@G_REQ_NAME_31
RESULTS = 被虐調教・中級

@G_REQ_ABLE_31
SIF FLAG:ギルドランク < 3
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_31, ARG
RESULTS = ABL[露出癖]が3以上/ABL[マゾっ気]が3以上/MARK[苦痛刻印]がMARK[反発刻印]より高い
SIF GET_NATURE_ABL("露出癖", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("マゾっ気", ARG) < 3
	RETURN 0
SIF (MARK:ARG:苦痛刻印 - MARK:ARG:反発刻印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_31, ARG = -1
RESULTS = ABL[露出癖]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("露出癖", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_31, ARG = -1
RESULTS = ABL[マゾっ気]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("マゾっ気", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_31, ARG = -1
RESULTS = MARK[苦痛刻印]が高く、MARK[反発刻印]が低い
IF ARG >= 0
	SELECTCASE MARK:ARG:苦痛刻印 - MARK:ARG:反発刻印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_31
RESULTS = 相手を苦しめることや苦しみ姿を見ることに興奮を覚える人間は多い。/そうした需要にこたえられる奴隷の調教をせよ。

@G_REQ_REWARD_31
RETURN 10000
