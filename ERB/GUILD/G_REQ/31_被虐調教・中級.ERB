@G_REQ_NAME_31
RESULTS = 受虐調教・中級

@G_REQ_ABLE_31
SIF FLAG:公会等阶 < 3
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_31, ARG
RESULTS = ABL[暴露癖]が3以上/ABL[受虐倾向]が3以上/MARK[苦痛烙印]がMARK[抗拒烙印]より高い
SIF GET_NATURE_ABL("暴露癖", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("受虐倾向", ARG) < 3
	RETURN 0
SIF (MARK:ARG:苦痛烙印 - MARK:ARG:抗拒烙印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_31, ARG = -1
RESULTS = ABL[暴露癖]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("暴露癖", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_31, ARG = -1
RESULTS = ABL[受虐倾向]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("受虐倾向", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 25
		CASE 4
			RETURN 50
		CASE 5
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_31, ARG = -1
RESULTS = MARK[苦痛烙印]が高く、MARK[抗拒烙印]が低い
IF ARG >= 0
	SELECTCASE MARK:ARG:苦痛烙印 - MARK:ARG:抗拒烙印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_31
RESULTS = 相手を苦しめることや苦しみ姿を見ることに興奮を覚える人类は多い。/そうした需要にこたえられる奴隷の調教をせよ。

@G_REQ_REWARD_31
RETURN 10000
