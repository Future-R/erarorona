@G_REQ_NAME_32
RESULTS = 性交指导：中級

@G_REQ_ABLE_32
SIF FLAG:公会等阶 < 3
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_32, ARG
RESULTS = ABL[Ｖ感觉]とABL[Ａ感觉]の合計が8以上/ABL[性交成瘾]が3以上/ABL[欲望]が5以上
SIF GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) < 8
	RETURN 0
SIF GET_NATURE_ABL("性交成瘾", ARG) < 3
	RETURN 0
SIF GET_NATURE_ABL("欲望", ARG) < 5
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_32, ARG = -1
RESULTS = ABL[Ｖ感觉]とABL[Ａ感觉]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG)
		CASE IS < 8
			RETURN 0
		CASE 8
			RETURN 20
		CASE 9
			RETURN 40
		CASE 10
			RETURN 60
		CASE 11
			RETURN 80
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_32, ARG = -1
RESULTS = ABL[性交成瘾]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("性交成瘾", ARG)
		CASE IS < 3
			RETURN 0
		CASE 3
			RETURN 33
		CASE 4
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_32, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 33
		CASE 6
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF

@G_REQ_EXPLAIN_32
RESULTS = 性交に長けた奴隷の調教が希望されている。/なお、顧客は前でも後ろでも構わないそうだ。

@G_REQ_REWARD_32
RETURN 10000
