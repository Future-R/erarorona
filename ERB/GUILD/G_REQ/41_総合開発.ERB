@G_REQ_NAME_41
RESULTS = 総合開発

@G_REQ_ABLE_41
SIF FLAG:ギルドランク < 4
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_41, ARG
RESULTS = ABL[従順]とABL[欲望]とABL[技巧]の合計が10以上/感度系ABLの合計値が15以上/全ABLの合計が35以上
SIF GET_NATURE_ABL("従順", ARG) + GET_NATURE_ABL("技巧", ARG) + GET_NATURE_ABL("欲望", ARG) < 10
	RETURN 0
SIF GET_NATURE_ABL("Ｃ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) + GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｂ感覚", ARG) < 15
	RETURN 0
SIF GET_NATURE_ABL("SUM", ARG) < 35
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_41, ARG = -1
RESULTS = 基本系ABLの合計値が高い
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("従順", ARG) + GET_NATURE_ABL("技巧", ARG) + GET_NATURE_ABL("欲望", ARG) - 9) * 100 / 9, 0, 100)

@G_REQ_VALUE_1_41, ARG = -1
RESULTS = 感度系ABLの合計値が高い
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("Ｃ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) + GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｂ感覚", ARG) - 14) * 100 / 10, 0, 100)

@G_REQ_VALUE_2_41, ARG = -1
RESULTS = 全ABLの合計値が高い
SIF ARG >= 0
	RETURN (GET_NATURE_ABL("SUM", ARG) - 34) * 100 / 16

@G_REQ_EXPLAIN_41
RESULTS = 全方面において優れた奴隷を用意すること。/この依頼は調教師としての腕前を示すいい機会となるので/そのことを念頭に置いてしっかりと励んで欲しい。

@G_REQ_REWARD_41
RETURN 50000
