@G_REQ_NAME_51
RESULTS = 奴隷調教・上級

@G_REQ_ABLE_51
SIF FLAG:ギルドランク < 5
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_51, ARG
RESULTS = ABL[従順]が5以上/ABL[技巧]が5以上/ABL[欲望]が5以上
SIF GET_NATURE_ABL("従順", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("技巧", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("欲望", ARG) < 5
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_51, ARG = -1
RESULTS = ABL[従順]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("従順", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 25
		CASE 6
			RETURN 50
		CASE 7
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_1_51, ARG = -1
RESULTS = ABL[技巧]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("技巧", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 25
		CASE 6
			RETURN 50
		CASE 7
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_51, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
