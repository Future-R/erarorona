@G_REQ_NAME_51
RESULTS = 奴隶调教：高级

@G_REQ_ABLE_51
SIF FLAG:公会等阶 < 5
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_51, ARG
RESULTS = ABL[服从]为5或以上/ABL[技巧]为5或以上/ABL[欲望]为5或以上
SIF GET_NATURE_ABL("服从", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("技巧", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("欲望", ARG) < 5
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_51, ARG = -1
RESULTS = ABL[服从]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("服从", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 25
		CASE 6
			RETURN 50
		CASE 7
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_1_51, ARG = -1
RESULTS = ABL[技巧]较高
