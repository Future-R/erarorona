@G_REQ_NAME_52
RESULTS = 性感開発・上級

@G_REQ_ABLE_52
SIF FLAG:ギルドランク < 5
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_52, ARG
RESULTS = ABL[欲望]が5以上/感度系ABLの合計値が20以上/MARK[快楽刻印]がMARK[反発刻印]より1以上高い
SIF GET_NATURE_ABL("欲望", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("Ｃ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) + GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｂ感覚", ARG) < 20
	RETURN 0
SIF (MARK:ARG:快楽刻印 - MARK:ARG:反発刻印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_52, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 20
		CASE 6
			RETURN 40
		CASE 7
			RETURN 60
		CASE 8
			RETURN 80
		CASE 9
			RETURN 90
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_52, ARG = -1
RESULTS = 感度系ABLの合計値が高い
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("Ｃ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) + GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｂ感覚", ARG) - 19) * 5, 0, 100)
@G_REQ_VALUE_2_52, ARG = -1
RESULTS = MARK[快楽刻印]が高く、MARK[反発刻印]が低い
IF ARG >= 0
	SELECTCASE MARK:ARG:快楽刻印 - MARK:ARG:反発刻印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_52
RESULTS = 感度が高く反応が良好な奴隷は多くの顧客にとって好まれる。/様々な部位を開発し、主人を楽しむのに適した奴隷を作ること。

@G_REQ_REWARD_52
