@G_REQ_NAME_52
RESULTS = 性感开发：高级

@G_REQ_ABLE_52
SIF FLAG:公会等阶 < 5
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_52, ARG
RESULTS = ABL[欲望]为5或以上/感度系ABL合计20或以上/MARK[快乐烙印]比MARK[抗拒烙印]高出1或以上
SIF GET_NATURE_ABL("欲望", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("Ｃ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) + GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｂ感觉", ARG) < 20
	RETURN 0
SIF (MARK:ARG:快乐烙印 - MARK:ARG:抗拒烙印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_52, ARG = -1
RESULTS = ABL[欲望]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("欲望", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 20
		CASE 6
			RETURN 40
		CASE 7
			RETURN 60
		CASE 8
			RETURN 80
		CASE 9
			RETURN 90
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_52, ARG = -1
RESULTS = 感度系ABL合计值较高
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("Ｃ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) + GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｂ感觉", ARG) - 19) * 5, 0, 100)
@G_REQ_VALUE_2_52, ARG = -1
RESULTS = MARK[快乐烙印]较高，MARK[抗拒烙印]较低
IF ARG >= 0
	SELECTCASE MARK:ARG:快乐烙印 - MARK:ARG:抗拒烙印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_52
RESULTS = 感度较高、反应良好的奴隶受到多数顾客的喜爱。/开发各种部位，培养适合取悦主人的奴隶。

