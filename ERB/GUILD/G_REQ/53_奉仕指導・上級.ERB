@G_REQ_NAME_53
RESULTS = 侍奉指导：高级

@G_REQ_ABLE_53
SIF FLAG:公会等阶 < 5
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_53, ARG
RESULTS = ABL[技巧]为6或以上/ABL[侍奉精神]为4或以上/MARK[屈服烙印]比MARK[抗拒烙印]高出1或以上
SIF GET_NATURE_ABL("技巧", ARG) < 6
	RETURN 0
SIF GET_NATURE_ABL("侍奉精神", ARG) < 4
	RETURN 0
SIF (MARK:ARG:屈服烙印 - MARK:ARG:抗拒烙印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_53, ARG = -1
RESULTS = ABL[技巧]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("技巧", ARG)
		CASE IS < 6
			RETURN 0
		CASE 6
			RETURN 20
		CASE 7
			RETURN 40
		CASE 8
			RETURN 60
		CASE 9
			RETURN 80
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_53, ARG = -1
RESULTS = ABL[侍奉精神]较高
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("侍奉精神", ARG)
		CASE IS < 4
			RETURN 0
		CASE 4
			RETURN 25
		CASE 5
			RETURN 50
		CASE 6
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_53, ARG = -1
RESULTS = MARK[屈服烙印]较高，MARK[抗拒烙印]较低
IF ARG >= 0
	SELECTCASE MARK:ARG:屈服烙印 - MARK:ARG:抗拒烙印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 53
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_53
RESULTS = 奴隶的本分自然是侍奉。/不仅需要高超的技巧，/更要以侍奉为喜悦与生存意义。/这样的奴隶才称得上是理想的奴隶。/需注意，提升侍奉精神的关键，侍奉快乐经验/需要让奴隶在获得快感的同时进行侍奉才能提升。

@G_REQ_REWARD_53
RETURN 30000
