@G_REQ_NAME_61
RESULTS = 被虐調教・上級

@G_REQ_ABLE_61
SIF FLAG:ギルドランク < 6
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_61, ARG
RESULTS = ABL[露出癖]が5以上/ABL[マゾっ気]が5以上/MARK[苦痛刻印]がMARK[反発刻印]より高い
SIF GET_NATURE_ABL("露出癖", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("マゾっ気", ARG) < 5
	RETURN 0
SIF (MARK:ARG:苦痛刻印 - MARK:ARG:反発刻印) < 1
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_61, ARG = -1
RESULTS = ABL[露出癖]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("露出癖", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 20
		CASE 6
			RETURN 40
		CASE 7
			RETURN 60
		CASE 8
			RETURN 80
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_61, ARG = -1
RESULTS = ABL[マゾっ気]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("マゾっ気", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 20
		CASE 6
			RETURN 40
		CASE 7
			RETURN 60
		CASE 8
			RETURN 80
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_VALUE_2_61, ARG = -1
RESULTS = MARK[苦痛刻印]が高く、MARK[反発刻印]が低い
IF ARG >= 0
	SELECTCASE MARK:ARG:苦痛刻印 - MARK:ARG:反発刻印
		CASE IS <= 0
			RETURN 0
		CASE 1
			RETURN 33
		CASE 2
			RETURN 66
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
@G_REQ_EXPLAIN_61
RESULTS = 相手を苦しめることや苦しみ姿を見ることに興奮を覚える人間は多い。/そうした需要にこたえられる奴隷の調教をせよ。

@G_REQ_REWARD_61
RETURN 50000
