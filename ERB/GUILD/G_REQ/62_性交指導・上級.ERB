@G_REQ_NAME_62
RESULTS = 性交指導・上級

@G_REQ_ABLE_62
SIF FLAG:ギルドランク < 6
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_62, ARG
RESULTS = ABL[Ｖ感覚]とABL[Ａ感覚]の合計が12以上/ABL[性交中毒]が5以上/ABL[欲望]が5以上
SIF GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG) < 12
	RETURN 0
SIF GET_NATURE_ABL("性交中毒", ARG) < 5
	RETURN 0
SIF GET_NATURE_ABL("欲望", ARG) < 5
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_62, ARG = -1
RESULTS = ABL[Ｖ感覚]とABL[Ａ感覚]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("Ａ感覚", ARG) + GET_NATURE_ABL("Ｖ感覚", ARG)
		CASE IS < 12
			RETURN 0
		CASE 13
			RETURN 20
		CASE 14
			RETURN 40
		CASE 15
			RETURN 60
		CASE 16
			RETURN 80
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF
;
@G_REQ_VALUE_1_62, ARG = -1
RESULTS = ABL[性交中毒]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("性交中毒", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 25
		CASE 6
			RETURN 50
		CASE 7
			RETURN 75
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF

@G_REQ_VALUE_2_62, ARG = -1
RESULTS = ABL[欲望]が高い
IF ARG >= 0
	SELECTCASE GET_NATURE_ABL("性交中毒", ARG)
		CASE IS < 5
			RETURN 0
		CASE 5
			RETURN 20
		CASE 6
			RETURN 35
		CASE 7
			RETURN 55
		CASE 8
			RETURN 70
		CASE 9
			RETURN 85
		CASEELSE
			RETURN 100
	ENDSELECT
ENDIF

