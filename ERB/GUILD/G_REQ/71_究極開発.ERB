@G_REQ_NAME_71
RESULTS = 究极开发

@G_REQ_ABLE_71
SIF FLAG:公会等阶 < 7
	RETURN 0
RETURN 1

@G_REQ_ABLE_CHARA_71, ARG
RESULTS = ABL[服从]、ABL[欲望]和ABL[技巧]合计20或以上/感度系ABL合计25或以上/全ABL合计60或以上
SIF GET_NATURE_ABL("服从", ARG) + GET_NATURE_ABL("技巧", ARG) + GET_NATURE_ABL("欲望", ARG) < 10
	RETURN 0
SIF GET_NATURE_ABL("Ｃ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) + GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｂ感觉", ARG) < 15
	RETURN 0
SIF GET_NATURE_ABL("SUM", ARG) < 35
	RETURN 0
RETURN 1

@G_REQ_VALUE_0_71, ARG = -1
RESULTS = 基本系ABL合计值较高
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("服从", ARG) + GET_NATURE_ABL("技巧", ARG) + GET_NATURE_ABL("欲望", ARG) - 19) * 100 / 8, 0, 100)

@G_REQ_VALUE_1_71, ARG = -1
RESULTS = 感度系ABL合计值较高
SIF ARG >= 0
	RETURN LIMIT((GET_NATURE_ABL("Ｃ感觉", ARG) + GET_NATURE_ABL("Ｖ感觉", ARG) + GET_NATURE_ABL("Ａ感觉", ARG) + GET_NATURE_ABL("Ｂ感觉", ARG) - 24) * 100 / 16, 0, 100)

@G_REQ_VALUE_2_71, ARG = -1
RESULTS = 全ABL合计值较高
SIF ARG >= 0
	RETURN (GET_NATURE_ABL("SUM", ARG) - 59) * 100 / 41

@G_REQ_EXPLAIN_71
RESULTS = 希望能准备究极的奴隶。/目前还无法想象有其他人能完成这个委托，/请务必用您的本领创造传说。

@G_REQ_REWARD_71
RETURN 100000
