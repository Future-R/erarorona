@PAY_BACK
IF MONEY >= 1000000
	;初期期限前
	IF DAY < CONVERT_DAY(4, 1, 1)
		CALL MESSAGE_WINDOW, "ギルド員", "ふむ、確かに100万コールあるようだな。/まだ、返済期限までには余裕があるが/もう払っても本当に大丈夫なんだな？"
	ELSE
		CALL MESSAGE_WINDOW, "ギルド員", "ふむ、確かに100万コールあるようだな。/しかし、ここでギルド員を続けるなら払う必要はないわけだが/もう払っても本当に大丈夫なんだな？"
	ENDIF
	CALL INPUT_YN_M
	IF !RESULT
		CALL MESSAGE_WINDOW, "ギルド員", "それじゃあ確かに受け取ったぞ。"
		CALL MESSAGE_WINDOW, "", "………………/…………/……"
		CALL MESSAGE_WINDOW, "ギルド員", "よし、これでお前は自由の身だ。/しかし、本当に100万コールも用意できるとは/さすがは錬金術士ということか…"
		CALL MESSAGE_WINDOW, "ギルド員", "なお、いちおうギルドにお前の籍は残しておくということだ。/だから、もしお前の気が向けばまたここで仕事を引き受けられるぞ。/まぁもちろん気が向いたらの話だが…"
		FLAG:納金済み = 1
		MONEY -= 1000000
	ELSE
		CALL MESSAGE_WINDOW, "ギルド員", "そうか/じゃあ考えがまとまったらまた来るがいい"
	ENDIF
ELSE
	CALL MESSAGE_WINDOW, "ギルド員", "金が足りないようだが…/お前の借金は100万コールだぞ？"
ENDIF
