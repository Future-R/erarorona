@PAY_BACK
IF MONEY >= 1000000
	;初期期限前
	IF DAY < CONVERT_DAY(4, 1, 1)
		CALL MESSAGE_WINDOW, "公会成员", "嗯，确实有100万克尔呢。/虽然离还款期限还有些时间/即便如此你还是要付清吗？"
	ELSE
		CALL MESSAGE_WINDOW, "公会成员", "嗯，确实有100万克尔呢。/不过如果继续当公会成员的话其实不用支付/即便如此你还是要付清吗？"
	ENDIF
	CALL INPUT_YN_M
	IF !RESULT
		CALL MESSAGE_WINDOW, "公会成员", "那么我就确认收下了。"
		CALL MESSAGE_WINDOW, "", "………………/…………/……"
		CALL MESSAGE_WINDOW, "公会成员", "好，你现在自由了。/不过真能凑齐100万克尔/不愧是炼金术士啊……"
		CALL MESSAGE_WINDOW, "公会成员", "另外，公会将暂时保留你的会籍。/所以如果改变心意，随时可以回来接取工作。/当然，全看你自己的意愿……"
		FLAG:已缴费 = 1
		MONEY -= 1000000
	ELSE
		CALL MESSAGE_WINDOW, "公会成员", "好吧/等你考虑清楚再来找我也行。"
	ENDIF
ELSE
	CALL MESSAGE_WINDOW, "公会成员", "钱似乎不够啊……/你的债务可是100万克尔哦？"
ENDIF
