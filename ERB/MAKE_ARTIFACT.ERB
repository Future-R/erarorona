@MAKE_ARTIFACT
#DIM CHARA
#LOCALSSIZE 100
#DIM TEMP, 2
#DIMS TEMPS, 2
#DIM LINE, 2
#DIMS L_MODE
#DIMS L_EXPLAIN, 4
#DIMS 角色解说, 30
#DIMS L_NAME
#DIMS L_TALENT
#DIMS L_ABL
#DIMS L_KEY
MASTER = -1
L_EXPLAIN:0 = ここを点击して説明文を入力してください。
角色解说:0 = ここを点击して解説文を入力してください。
L_MODE = 名称
CALL GAMESTART
ADDVOIDCHARA
CHARA = CHARANUM - 1
LINE = LINECOUNT
L_KEY = 名称/特质/ABL加成/EXP/特征/查看能力1/查看能力2
REDRAW 0
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTFORML 　アーティファクト作成
DRAWLINE
FOR LOCAL, 0, MAXLINE() - 7
	SELECTCASE LOCAL
		CASE 0, MAXLINE() - 12
			PRINTFORM ┌%"─" * 11%┐
		CASE MAXLINE() - 13
			PRINTFORM └%"─" * 11%┘
		CASE MAXLINE() - 11
			PRINTFORM │%"",9%
			PRINTBUTTON "[ 8]", "8"
			PRINTFORM %"",9%│
		CASE MAXLINE() - 10
			PRINTFORM │%"",5%
			PRINTBUTTON "[ 4]", "4"
			PRINTFORM %"", 4%
			PRINTBUTTON "[ 6]", "6"
			PRINTFORM %"",5%│
		CASE MAXLINE() - 9
			PRINTFORM │%"",9%
			PRINTBUTTON "[ 2]", "2"
			PRINTFORM %"",9%│
		CASE MAXLINE() - 8
			PRINTFORM └%"─" * 11%┘
		CASEELSE
			LOCALS = %AUTO_SPLIT(L_KEY, "/", LOCAL - 1)%
			IF LOCALS == ""
				PRINTFORM │%"",22%│
			ELSE
				PRINT │
				CALL PRINTSBUTTON_C, @"%"[" + GET_KEYMARK(LOCAL - 1) + "] " + LOCALS, 22, LEFT%", LOCALS, L_MODE == LOCALS, COLOR("p-green"),
				PRINT │
			ENDIF
	ENDSELECT
	SELECTCASE L_MODE
		CASE "名称"
			SELECTCASE LOCAL
				CASE 0
					PRINTFORM ┌名称%"─" * 46%┐
				CASE 1
					PRINTFORM │
					PRINTBUTTON @"%"物品名　:" + L_NAME, 96, LEFT%", "名称_物品名"
					PRINTFORM │
				CASE 2
					PRINTFORM │
					PRINTBUTTON @"%"呼称　　　　:" + CALLNAME:CHARA, 96, LEFT%", "名称_呼称"
					PRINTFORM │
				CASE 3
					PRINTFORM │
					PRINTBUTTON @"%"本名　　　　:" + NAME:CHARA, 96, LEFT%", "名称_本名"
					PRINTFORM │
				CASE 4
					PRINTFORM │
					PRINTBUTTON @"%"識別名　　　:" + NICKNAME:CHARA, 96, LEFT%", "名称_識別名"
					PRINTFORM │
				CASE 5, 11, 33
					PRINTFORM └%"─" * 48%┘
				CASE 6
					PRINTFORM ┌説明文%"─" * 45%┐
				CASE 7 TO 10
					PRINT │
					IF L_EXPLAIN:(LOCAL - 7) == ""
						CALL PRINTSBUTTON_C, " " * 96, @"名称_説明文_{LOCAL - 7}", 1, COLOR("BG")
					ELSE
						PRINTBUTTON @"%L_EXPLAIN:(LOCAL - 7), 96, LEFT%", @"名称_説明文_{LOCAL - 7}"
					ENDIF
					PRINT │
					;84次
				CASE 12
					PRINTFORM ┌TIPS%"─" * 46%┐
				CASE 13
					PRINTFORM │%"物品名・呼称・名称・識別名を点击して名称を入力してください。", 96, LEFT%│
				CASE 14
					PRINTFORM │%"物品名はアーティファクトの名称です。角色を連想できるものを設定してください。", 96, LEFT%│
				CASE 15
					PRINTFORM │%"呼称は通常のゲーム中での呼び名で、ロロナなら「ロロナ」となります。", 96, LEFT%│
				CASE 16
					PRINTFORM │%"本名はそのまま本名で、ロロナなら「ロロライナ・フリクセル」となります。", 96, LEFT%│
				CASE 17
					PRINTFORM │%"識別名はゲーム中にはでてきませんが角色クターの認識に使う名称です。", 96, LEFT%│
				CASE 18
					PRINTFORM │%"基本的には呼称とおなじで問題ありませんが", 96, LEFT%│
				CASE 19
					PRINTFORM │%"「ロロナ_メルル版」「ロリナ」「ロロナ_7歳?」といったように", 96, LEFT%│
				CASE 20
					PRINTFORM │%"通常角色のバージョン違いなどの事情がある場合に呼称と違う名前をつけてください。", 96, LEFT%│
				CASE 21
					PRINTFORM │%"ただし、この際、ファイル記述上の問題があるので「()」を利用することは避けてください。", 96, LEFT%│
				CASE 23
					PRINTFORM │%"また、物品説明文もここで設定します。",96,LEFT%│
				CASE 23
					PRINTFORM │%"説明文の欄内を点击して内容を入力してください。",96,LEFT%│
				CASE 23
					PRINTFORM │%"内容は最大4行ですが、一行目は物品の簡易説明として使う関係で",96,LEFT%│
				CASE 24
					PRINTFORM │%"84字の制限と、一行で完結している必要があります。",96,LEFT%│
				CASE 25
					PRINTFORM │%"「叩くと中のものが増える鞄。」、このような形で物品を大雑把に説明して",96,LEFT%│
				CASE 26
					PRINTFORM │%"体言止めすれば大体問題無いと思います。",96,LEFT%│
				CASEELSE
					PRINTFORM │%"",96%│
			ENDSELECT
		CASE "特质"
			SELECTCASE LOCAL
				CASE 0
					PRINTFORM ┌特质%"─" * 46%┐
					TEMP = -1
				CASE 23 TO 26
					PRINTFORM │%AUTO_SPLIT(TEMPS, "/", LOCAL - 23), 96, LEFT%│
				CASE 22
					PRINTFORM ┌%L_TALENT%%"─" * (48 - STRLENSU(L_TALENT))%┐
				CASE 28
					PRINTFORM ┌TIPS%"─" * 46%┐
				CASE 29
					PRINTFORM │%"特质名の右のゲージを点击して特质を設定してください。",96,LEFT%│
				CASE 30
					PRINTFORM │%"特质を外すときはゲージと「:」の間の空欄を点击します。",96,LEFT%│
				CASE 31
					PRINTFORM │%"また、特质名を点击することで特质を変更せずに説明を変更できます。",96,LEFT%│
				CASE 32
					PRINTFORM │%"なお、赤字は選択されているものとピンクはすでに所持しているものと相殺される特质です。",96,LEFT%│
				CASE 21, 27, 33
					PRINTFORM └%"─" * 48%┘
				CASEELSE
					PRINT │
					FOR LOCAL:1, 0, 5
						WHILE 1
							TEMP++
							IF TEMP < VARSIZE("TALENT")
								SIF TALENTNAME:TEMP == ""
									CONTINUE
								SIF GROUPMATCH(TALENTNAME:TEMP, "爱慕", "亲密", "淫乱", "娼妇", "服从", "奴役", "崩坏")
									CONTINUE
								IF TALENTNAME:TEMP == L_TALENT
									CALL COLORPRINT, @"%TALENTNAME:TEMP, 12, LEFT%:", COLOR("p-green")
								ELSE
									IF STRFIND(TEMPS:1, "_" + TALENTNAME:TEMP + "_") >= 0
										CALL PRINTSBUTTON_C, @"%TALENTNAME:TEMP, 12, LEFT%:", "特质_" + TALENTNAME:TEMP ,  1, COLOR("p-red"), TALENT:CHARA:TEMP ? COLOR("p-blue") # COLOR("DEF")
									ELSE
										VARSET RESULT, -1
										TRYCALLFORM TALENT_OFFSET_%TALENTNAME:TEMP%
										TEMP:1 = 0
										LOCAL:2 = 0
										WHILE RESULT:(LOCAL:2) >= 0 && TEMP:1 == 0
											SIF TALENT:CHARA:(RESULT:(LOCAL:2))
												TEMP:1 = 1
											LOCAL:2++
										WEND
										CALL PRINTSBUTTON_C, @"%TALENTNAME:TEMP, 12, LEFT%:", "特质_" + TALENTNAME:TEMP , TEMP:1, COLOR("p-red", 150), TALENT:CHARA:TEMP ? COLOR("p-blue") # COLOR("DEF")
									ENDIF
								ENDIF
								RESULT = 0
								TRYCALLFORM TALENT_NOLV_%TALENTNAME:TEMP%
								TEMP:1 = RESULT
								FOR LOCAL:2, 0, 4
									IF TEMP:1 && LOCAL:2 > 1
										PRINT  
									ELSE
										SELECTCASE LOCAL:2
											CASE 0
												SETCOLOR COLOR("BG")
											CASE IS <= TALENT:CHARA:TEMP
												SETCOLOR BARCOLORSET("蓝", 1)
											CASE IS <= GET_TALENT(TEMP, CHARA)
												SETCOLOR BARCOLORSET("蓝")
											CASEELSE
												SETCOLOR COLOR("GRAY")
										ENDSELECT
										PRINTBUTTON UNICODE(0x25AE), @"特质_%TALENTNAME:TEMP%_{LOCAL:2}"
									ENDIF
									RESETCOLOR
								NEXT
								PRINTFORM %"", 2%
							ELSE
								PRINTFORM %"", 19%
							ENDIF
							BREAK
						WEND
					NEXT
					PRINT  │
			ENDSELECT
		CASE "ABL加成"
			SELECTCASE LOCAL
				CASE 0
					PRINTFORM ┌ABL %"─" * 46%┐
					TEMP = -1
				CASE 29
					PRINTFORM ┌TIPS%"─" * 46%┐
				CASE 30
					PRINTFORM │%"ABL名の右のゲージを点击してABLの加成值を設定することができます。",96,LEFT%│
				CASE 31
					PRINTFORM │%"加成值は-3~+3まで設定することが出来、。",96,LEFT%│
				CASE 32
					PRINTFORM │%"ホムンクルス作成時にその数值が追加されます。",96,LEFT%│
					
				CASE 28, 33
					PRINTFORM └%"─" * 48%┘
				CASEELSE
					PRINT │
					WHILE 1
						TEMP++
						IF TEMP < 100
							SIF ABLNAME:TEMP == ""
								CONTINUE
							CALL PRINTSBUTTON_C, @"%ABLNAME:TEMP, 12, LEFT%:", "ABL_" + ABLNAME:TEMP , ABLNAME:TEMP == L_ABL , COLOR("p-green"), COLOR("DEF")
							FOR LOCAL:1, -3, 4
								SELECTCASE ABL:CHARA:TEMP
									CASE 0
										SETCOLOR COLOR("GRAY")
									CASE IS < 0
										IF INRANGE(LOCAL:1, ABL:CHARA:TEMP, -1)
											SETCOLOR COLOR("p-red")
										ELSE
											SETCOLOR COLOR("GRAY")
										ENDIF
									CASEELSE
										IF INRANGE(LOCAL:1, 1, ABL:CHARA:TEMP)
											SETCOLOR COLOR("p-blue")
										ELSE
											SETCOLOR COLOR("GRAY")
										ENDIF
								ENDSELECT
								PRINTBUTTON UNICODE(0x25AE), @"ABL_%ABLNAME:TEMP%_{LOCAL:1}"
								RESETCOLOR
							NEXT
							PRINTFORM %@"  (Lv{ABL:CHARA:TEMP,2})", 76, LEFT%
						ELSE
							PRINTFORM %"", 96%
						ENDIF
						BREAK
					WEND
					PRINT │
			ENDSELECT
		CASE "EXP"
			SELECTCASE LOCAL
				CASE 0
					PRINTFORM ┌EXP %"─" * 46%┐
					TEMP = -1
				CASE 29
					PRINTFORM ┌TIPS%"─" * 46%┐
				CASE 30
					PRINTFORM │%"EXPの右のゲージを点击してEXPの加成值を設定することができます。",96,LEFT%│
				CASE 31
					PRINTFORM │%"1目盛りあたり5で0~350までの加成值を設定できます。",96,LEFT%│
				CASE 32
					PRINTFORM │%"そして、ホムンクルス作成時にその数值がEXPに追加されます。",96,LEFT%│
					
				CASE 28, 33
					PRINTFORM └%"─" * 48%┘
				CASEELSE
					PRINT │
					WHILE 1
						TEMP++
						IF TEMP < VARSIZE("EXP")
							SIF GROUPMATCH(EXPNAME:TEMP, "", "异常经验")
								CONTINUE
							PRINTFORM %EXPNAME:TEMP, 12, LEFT%:
							FOR LOCAL:1, 0, 71
								IF LOCAL:1 == 0
									SETCOLOR COLOR("BG")
								ELSEIF EXP:CHARA:TEMP / 5 >= LOCAL:1
									SETCOLOR COLOR("p-blue")
								ELSE
									SETCOLOR COLOR("GRAY")
								ENDIF
								PRINTBUTTON UNICODE(0x25AE), @"EXP_%EXPNAME:TEMP%_{LOCAL:1 * 5}"
								RESETCOLOR
							NEXT
							PRINTFORM %@" :{EXP:CHARA:TEMP, 5}", 12, LEFT%
						ELSE
							PRINTFORM %"", 96%
						ENDIF
						BREAK
					WEND
					PRINT │
			ENDSELECT
		CASE "特征"
			SELECTCASE LOCAL
				CASE 0
					PRINTFORM ┌特征%"─"*46%┐
				CASE 1, 2
					PRINT │
					TEMP = (LOCAL - 1) * 4
					FOR LOCAL:1, TEMP, TEMP + 4
						IF TEMP < 特征要素数
							PRINTBUTTON @"%GET_NAME("特征", LOCAL:1),4,LEFT%:", "特征_" + GET_NAME("特征", LOCAL:1)
							PRINTBUTTON @"%CSTR:CL_CHARA:GET_NAME("特征", LOCAL:1),19,LEFT%", "特征_" + GET_NAME("特征", LOCAL:1)
						ELSE
							PRINTFORM %"",24%
						ENDIF
					NEXT
					PRINT │
				CASE 3, 33
					PRINTFORM └%"─" * 48%┘
				CASE 4
					PRINTFORM ┌角色解说%"─"*40%┐
				CASE 5 To 26
					PRINT │
					IF 角色解说:(LOCAL - 5) == ""
						CALL PRINTSBUTTON_C, " " * 96, @"特征_解説_{LOCAL - 5}", 1, COLOR("BG")
					ELSE
						PRINTBUTTON @"%角色解说:(LOCAL - 5), 96, LEFT%", @"特征_解说_{LOCAL - 5}"
					ENDIF
					PRINT │
				CASE 28
					PRINTFORM ┌TIPS%"─" * 46%┐
				CASE 29
					PRINTFORM │%"角色クターの身体的な特征と解説文を設定してください。",96,LEFT%│
				CASE 30
					PRINTFORM │%"この特征は完全なフレーバー要素であり、実際の動作には影響しません。",96,LEFT%│
				CASE 31
					PRINTFORM │%"なので好きな文字列を設定できますが、その反面胸を「小さい」などと設定しても",96,LEFT%│
				CASE 32
					PRINTFORM │%"「贫乳」の特质が設定されていなければ小さいものと扱われないので注意してください。",96,LEFT%│
				CASE 27, 33
					PRINTFORM └%"─" * 48%┘
				CASEELSE
					PRINTFORM │
					PRINTFORM %"", 96, LEFT%
					PRINTFORM │
			ENDSELECT
		CASE "查看能力1"
			CL_CHARA = CHARA
			CALL SHOW_CHARALIST_RIGHT_1, LOCAL, "個人表示"
		CASE "查看能力2"
			CL_CHARA = CHARA
			CALL SHOW_CHARALIST_RIGHT_2, LOCAL, "個人表示"
	ENDSELECT
	PRINTL 
NEXT
DRAWLINE
LINE:1 = LINECOUNT
PRINTBUTTON "[*] INPUT", "*"
PRINTL 
PRINTBUTTON "[/] OUTPUT", "/"
PRINTL 
PRINTBUTTON "[9] End", "9"
PRINTL 
INPUTS
CLEARLINE 1
LOCALS = %RESULTS%
IF AUTO_SPLIT(LOCALS, "_", 1) == ""
	SELECTCASE RESULTS
		CASE "*"
			$INPUT_START
			CLEARLINE LINECOUNT - LINE
			DRAWLINE
			PRINTL アーティファクト入力
			DRAWLINE
			LOCAL:1 = 0
			FOR LOCAL, 1801, 2000
				TRYCCALLFORM ITEM_NAME_{LOCAL}
					LOCALS = [%RESULTS%/
					CALLFORM ITEM_HOMU_NAME_{LOCAL}
					LOCALS += RESULTS:2 + "]"
					PRINTBUTTON @"%LOCALS,30,LEFT%", LOCAL
					LOCAL:1++
					SIF LOCAL:1 % 4 == 3
						PRINTL 
				CATCH
					CONTINUE
				ENDCATCH
			NEXT
			SIF !LINEISEMPTY()
				PRINTL 
			CALL EQUATE_LINE, LINE + MAXLINE()-2
			DRAWLINE
			PRINTBUTTON "[取消]", 0
			INPUT
			TEMP = RESULT
			SELECTCASE TEMP
				CASE 0
					GOTO START
				CASE 1801 TO 2000
					TRYCCALLFORM ITEM_NAME_{TEMP}
						L_NAME = %RESULTS%
						DELCHARA CHARA
						ADDVOIDCHARA
						CHARA = CHARANUM - 1
						
						CALLFORM ITEM_HOMU_NAME_{TEMP}
						CALLNAME:CHARA = %RESULTS%
						NAME:CHARA = %RESULTS:1%
						NICKNAME:CHARA = %RESULTS:2%
						
						CALLFORM ITEM_EXPLAIN_{TEMP}
						FOR LOCAL, 0, 4
							L_EXPLAIN:LOCAL = %AUTO_SPLIT(RESULTS, "/", LOCAL)%
						NEXT
						VARSET RESULTS
						CALLFORM ARTIFACT_EXPLAIN_{TEMP}
						FOR LOCAL, 0, 30
							角色解说:LOCAL = %RESULTS:LOCAL%
						NEXT
						CALLFORM ARTIFACT_TALENT_{TEMP}
						IF RESULTS != ""
							SPLIT RESULTS, "/", LOCALS
							FOR LOCAL, 0, RESULT
								TALENT:CHARA:AUTO_SPLIT(LOCALS:LOCAL, "_", 0) = AUTO_SPLIT_INT(LOCALS:LOCAL, "_", 1)
							NEXT
						ENDIF
						CALLFORM ARTIFACT_ABL_{TEMP}
						IF RESULTS != ""
							SPLIT RESULTS, "/", LOCALS
							FOR LOCAL, 0, RESULT
								ABL:CHARA:AUTO_SPLIT(LOCALS:LOCAL, "_", 0) = AUTO_SPLIT_INT(LOCALS:LOCAL, "_", 1)
							NEXT
						ENDIF
						CALLFORM ARTIFACT_EXP_{TEMP}
						IF RESULTS != ""
							SPLIT RESULTS, "/", LOCALS
							FOR LOCAL, 0, RESULT
								EXP:CHARA:AUTO_SPLIT(LOCALS:LOCAL, "_", 0) = AUTO_SPLIT_INT(LOCALS:LOCAL, "_", 1)
							NEXT
						ENDIF
						CALLFORM ARTIFACT_FEATURE_{TEMP}
						IF RESULTS != ""
							SPLIT RESULTS, "/", LOCALS
							FOR LOCAL, 0, RESULT
								CSTR:CHARA:GET_NAME("特征", LOCAL) = %LOCALS:LOCAL%
							NEXT
						ENDIF
					CATCH
						GOTO INPUT_START
					ENDCATCH
				CASEELSE
					GOTO INPUT_START
			ENDSELECT
		CASE "/"
			CLEARLINE 5000
			PRINTFORML @ITEM_NAME_XXX
			PRINTFORML RESULTS = %L_NAME%
			PRINTL 
			PRINTFORML @ITEM_CATEGORY_XXX, ARG
			PRINTFORML SELECTCASE GET_NAME("分类", ARG)
			PRINTFORML 	CASE "神器"
			PRINTFORML 		RETURN 100
			PRINTFORML 	CASEELSE
			PRINTFORML 		RETURN -1
			PRINTFORML ENDSELECT
			PRINTFORML 
			PRINTFORML @ITEM_LV_XXX
			PRINTFORML RETURN 0
			PRINTFORML 
			PRINTFORML @ITEM_HOMU_NAME_XXX
			PRINTFORML RESULTS = %CALLNAME:CHARA%
			PRINTFORML RESULTS:1 = %NAME:CHARA%
			PRINTFORML RESULTS:2 = %NICKNAME:CHARA%
			PRINTFORML 
			PRINTFORML @ITEM_EXPLAIN_XXX, ARG
			PRINTFORM RESULTS = 
			FOR LOCAL, 0, 4
				PRINTFORM %L_EXPLAIN:LOCAL%
				SIF LOCAL < 3
					PRINT /
			NEXT
			PRINTL 
			PRINTFORML 
			PRINTFORML ;固有特性
			PRINTFORML @PROPERTY_OF_CHARACTERISTIC_XXX, ARG
			PRINTFORML RETURN 0
			PRINTFORML 
			PRINTFORML @ITEM_PRICE_XXX
			PRINTFORML RETURN 
			PRINTFORML 
			PRINTFORML @ARTIFACT_TALENT_XXX
			PRINTFORM RESULTS = 
			LOCAL:1 = 0
			FOR LOCAL, 0, VARSIZE("TALENT")
				SIF !TALENT:CHARA:LOCAL
					CONTINUE
				SIF LOCAL:1++
					PRINT /
				PRINTFORM %TALENTNAME:LOCAL%_{TALENT:CHARA:LOCAL}
			NEXT
			PRINTL 
			PRINTFORML 
			PRINTFORML @ARTIFACT_FEATURE_XXX
			PRINT RESULTS = 
			FOR LOCAL, 0, 特征要素数
				SIF LOCAL
					PRINT /
				PRINTFORM %CSTR:CHARA:GET_NAME("特征", LOCAL)%
			NEXT
			PRINTL 
			PRINTFORML 
			PRINTFORML @ARTIFACT_EXP_XXX
			PRINTFORM RESULTS = 
			LOCAL:1 = 0
			FOR LOCAL, 0, VARSIZE("EXP")
				SIF !EXP:CHARA:LOCAL
					CONTINUE
				SIF LOCAL:1++
					PRINT /
				PRINTFORM %EXPNAME:LOCAL%_{EXP:CHARA:LOCAL}
			NEXT
			PRINTL 
			PRINTL 
			PRINTFORML @ARTIFACT_ABL_XXX
			PRINTFORM RESULTS = 
			LOCAL:1 = 0
			FOR LOCAL, 0, VARSIZE("ABL")
				SIF !ABL:CHARA:LOCAL
					CONTINUE
				SIF LOCAL:1++
					PRINT /
				PRINTFORM %ABLNAME:LOCAL%_{ABL:CHARA:LOCAL}
			NEXT
			PRINTL 
			PRINTFORML 
			PRINTFORML @ARTIFACT_EXPLAIN_XXX
			FOR LOCAL, 0, 30
				PRINTFORML RESULTS:{LOCAL} = %角色解说:LOCAL%
			NEXT
			PRINTL 
			OUTPUTLOG
			CLEARLINE LINECOUNT
			DRAWLINE
			PRINTL emuera.logにファイルを出力しました。
			PRINTL 以下の作業を実行してファイルを完成させてください。
			PRINTL 
			DRAWLINE
			PRINTL 1.1801~2000の間で物品番号を決める。
			PRINTL 2.ファイル名を物品番号_物品名.ERBにリネームする。
			PRINTL 3.ファイルを開いて、XXXを物品番号に置換する。
			PRINTL 4.物品説明に改行が入ってしまっている可能性が高いので一行になるように改行を削除
			DRAWLINE
			WAITANYKEY
			CLEARLINE LINECOUNT
		CASE "8", "2"
			LOCAL = AUTO_SPLIT_NUM(L_KEY, "/", L_MODE)
			IF RESULTS == "2"
				LOCAL++
				SIF AUTO_SPLIT(L_KEY, "/", LOCAL) == ""
					LOCAL = 0
			ELSE
				LOCAL--
				SIF LOCAL < 0
					LOCAL = STRCOUNT(L_KEY, "/")
			ENDIF
			L_MODE = %AUTO_SPLIT(L_KEY, "/", LOCAL)%
		CASE "9"
			RETURN 0
		CASEELSE
			SIF STRFIND(L_KEY, LOCALS) >= 0
				L_MODE = %AUTO_SPLIT(LOCALS, "_", 0)%
	ENDSELECT
ELSE
	SELECTCASE AUTO_SPLIT(LOCALS, "_", 0)
		CASE "名称"
			CLEARLINE LINECOUNT - LINE:1
			PRINTFORML %AUTO_SPLIT(LOCALS, "_", 1)%を入力してください。
			PRINTFORML 
			PRINTFORML 
			INPUTS
			SELECTCASE AUTO_SPLIT(LOCALS, "_", 1)
				CASE "物品名"
					L_NAME = %RESULTS%
				CASE "呼称"
					CALLNAME:CHARA = %RESULTS%
					SIF NICKNAME:CHARA == ""
						NICKNAME:CHARA = %RESULTS%
				CASE "本名"
					NAME:CHARA = %RESULTS%
				CASE "識別名"
					NICKNAME:CHARA = %RESULTS%
				CASE "説明文"
					IF AUTO_SPLIT_INT(LOCALS, "_", 2) == 0 && STRLENS(RESULTS) >= 84
						CLEARLINE LINECOUNT - LINE:1
						PRINTFORML 字数が多すぎます！
						PRINTFORML 
						PRINTFORMW 
					ELSE
						L_EXPLAIN:AUTO_SPLIT_INT(LOCALS, "_", 2) = %RESULTS%
					ENDIF
			ENDSELECT
		CASE "特质"
			L_TALENT = %AUTO_SPLIT(LOCALS, "_", 1)%
			TRYCCALLFORM TALENT_EXPLAIN_%L_TALENT%
				TEMPS = %RESULTS%
			CATCH
				TEMPS = 
			ENDCATCH
			TEMPS:1 = _
			VARSET RESULT, -1, 0, 5
			TRYCCALLFORM TALENT_OFFSET_%L_TALENT%
				FOR LOCAL, 0, 5
					SIF RESULT:LOCAL <= 0
						CONTINUE
					TEMPS:1 += TALENTNAME:(RESULT:LOCAL) + "_"
				NEXT
			CATCH
			ENDCATCH
			IF AUTO_SPLIT(LOCALS, "_", 2) != ""
				TALENT:CHARA:AUTO_SPLIT(LOCALS, "_", 1) = AUTO_SPLIT_INT(LOCALS, "_", 2)
				LOCALS = 
				FOR LOCAL, 1, 6
					IF AUTO_SPLIT(TEMPS:1, "_", LOCAL) != "" && TALENT:CHARA:AUTO_SPLIT(TEMPS:1, "_", LOCAL)
						TALENT:CHARA:AUTO_SPLIT(TEMPS:1, "_", LOCAL) = 0
						LOCALS += "[" + AUTO_SPLIT(TEMPS:1, "_", LOCAL) + "]"
					ENDIF
				NEXT
				IF LOCALS != ""
					CLEARLINE LINECOUNT - LINE:1
					PRINTFORML %LOCALS%は削除されました。
					PRINTFORML 
					PRINTFORMW 
				ENDIF
			ENDIF
		CASE "ABL"
			SIF AUTO_SPLIT(LOCALS, "_", 2) != ""
				ABL:CHARA:AUTO_SPLIT(LOCALS, "_", 1) = AUTO_SPLIT_INT(LOCALS, "_", 2)
		CASE "EXP"
			SIF AUTO_SPLIT(LOCALS, "_", 2) != ""
				EXP:CHARA:AUTO_SPLIT(LOCALS, "_", 1) = AUTO_SPLIT_INT(LOCALS, "_", 2)
		CASE "特征"
			CLEARLINE LINECOUNT - LINE:1
			PRINTFORML %AUTO_SPLIT(LOCALS, "_", 1)%を入力してください。
			PRINTFORML 
			PRINTFORML 
			INPUTS
			IF AUTO_SPLIT(LOCALS, "_", 1) == "解説"
				角色解说:AUTO_SPLIT_INT(LOCALS, "_", 2) = %RESULTS%
			ELSE
				CSTR:CHARA:AUTO_SPLIT(LOCALS, "_", 1) = %RESULTS%
			ENDIF
	ENDSELECT
ENDIF
GOTO START
