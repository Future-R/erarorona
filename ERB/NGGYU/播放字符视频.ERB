;===========================================================================
; 播放彩色字符视频
;===========================================================================
@播放视频, 视频名
#DIMS 视频名
ALIGNMENT RIGHT
; 播放延迟（毫秒/帧）
播放延迟 = 8
; 底部空行（调大则画面更靠上方）
底部空行数 = 2
; 重置帧计数器
帧计数器 = 0
; 调用数据生成函数（内部通过 @存放帧 流式渲染）
CALLFORM %视频名%
; 清理
REDRAW 0
CLEARLINE 100