@HELP_NAME_0
RESULTS = 暗之公会

@HELP_ABLE_暗之公会
RETURN 1

@HELP_暗之公会, ARG
#DIM LINE
LINE = LINECOUNT
SELECTCASE ARG
	CASE 0
		RESULTS = □公会委托
		RESULTS += @"%TEXTTAG("L")%　暗之公会正在收集满足特定条件的奴隶。"
		RESULTS += @"%TEXTTAG("L")%　制作霍姆克鲁斯、进行调教、将满足条件的奴隶提交给公会。"
		RESULTS += @"%TEXTTAG("L")%　这样就可以获得调教师经验值和公会点数。"
		RESULTS += @"%TEXTTAG("L")%　此外，提交的奴隶评分越高，获得的奖励也会越好。"
		RESULTS += @"%TEXTTAG("L")%　所以请不断地调教，尽可能地提高奴隶的评价。"
		RESULTS += @"%TEXTTAG("L")%　即使委托达成，这项委托也不会消失，你仍然可以重复进行同样的委托。"
		RESULTS += @"%TEXTTAG("L")%　但是，如果已经完成的委托没有再获得更高的评价的话是不会得到调教师点数的。"
		RESULTS += @"%TEXTTAG("L")%　公会点数也会减少，请留意。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□调教师经验值和调教师等级"
		RESULTS += @"%TEXTTAG("L")%　调教师经验值这项数据是表示作为调教师的经验。"
		RESULTS += @"%TEXTTAG("L")%　这个经验超过一定值后调教师的等级就会上升。"
		RESULTS += @"%TEXTTAG("L")%　当调教师等级上升时，"
		RESULTS += @"%TEXTTAG("L")%　也会随之解锁难度更高的公会委托，"
		RESULTS += @"%TEXTTAG("L")%　并获得更多公会的支持。"
		RESULTS += @"%TEXTTAG("L")%　另外，三年后如果调教师等级不足的情况下你将会被卖为奴隶。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□公会点数"
		RESULTS += @"%TEXTTAG("L")%　公会点数表示您对公会的贡献程度。"
		RESULTS += @"%TEXTTAG("L")%　这个点数可以用来向公会购买地图，参考书等等。"
		RESULTS += @"%TEXTTAG("L")%　地图将会增加探索地点，参考书则会增加可以调合的物品。"
		RESULTS += @"%TEXTTAG("L")%　虽然这些物品有时可能会在公会购买以外的地方获得"
		RESULTS += @"%TEXTTAG("L")%　但是基本上来说在公会购入是最为简单可靠的入手方式，请好好利用"
		RESULTS += @"%TEXTTAG("L")%　此外，你可以购买的物品将会随着调教师等级的提升而增加，升级后请留意下商店。"
	CASE 1
		RESULTS = □成就的评估
		RESULTS += @"%TEXTTAG("L")%　暗之公会将会评估公会各位会员的成就"
		RESULTS += @"%TEXTTAG("L")%　再通过结果来分发调教师经验和公会点数。"
		RESULTS += @"%TEXTTAG("L")%　因此，将奴隶的服从和技巧等ABL提升到一定值以上，并且调教拥有各种特质的奴隶。"
		RESULTS += @"%TEXTTAG("L")%　这样才能更多的达成成就稳步提升自己的调教师等级。"
		RESULTS += @"%TEXTTAG("L")%　另外，萝乐娜作为炼金术士兼调教师，我们也将同样期待你作为炼金术士的成果。"
		RESULTS += @"%TEXTTAG("L")%　如果你能拿出炼金术方面的成果我们也会同样对你的成就进行评估。"
		RESULTS += @"%TEXTTAG("L")%　所以提升调合等级、获取更多的素材或调合知识，也可以提高你的调教师等级。"
		RESULTS += @"%TEXTTAG("L")%　以上成就的达成条件都可以通过查看NOTE来确认。"
		RESULTS += @"%TEXTTAG("L")%　不过有一点请注意，达成成就获得的经验值和点数如果不前来公会汇报的话是不会发放的，请积极前来兑换。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□成就和奖励"
		RESULTS += @"%TEXTTAG("L")%有些成就可以带来额外的好处，给你的调教和调合带来方便。"
		RESULTS += @"%TEXTTAG("L")%有些会方便你训练某些特质，有些则会减少训练ABL所需的珠子数量"
		RESULTS += @"%TEXTTAG("L")%还有部分可以提升调合的成功率，或者增加调合时赋予的特性上限，以及其他多种多样的奖励等着你获取。"
		RESULTS += @"%TEXTTAG("L")%收集这些奖励同时也可以让你更方便的达成更多成就，"
		RESULTS += @"%TEXTTAG("L")%所以请务必积极的去尝试达成各项成就。"
		RESULTS += @"%TEXTTAG("L")%"
ENDSELECT
