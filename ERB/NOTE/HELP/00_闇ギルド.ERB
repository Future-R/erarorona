@HELP_NAME_0
RESULTS = 闇ギルド

@HELP_ABLE_闇ギルド
RETURN 1

@HELP_闇ギルド, ARG
#DIM LINE
LINE = LINECOUNT
SELECTCASE ARG
	CASE 0
		RESULTS = □ギルド依頼
		RESULTS += @"%TEXTTAG("L")%　闇ギルドでは特定の条件を満たした奴隷を募集しています。"
		RESULTS += @"%TEXTTAG("L")%　ホムンクルスを作成し、調教することで、条件を満たしてギルドに奴隷を納めてください。"
		RESULTS += @"%TEXTTAG("L")%　そうすることで調教師経験値とギルドポイントを得ることができます。"
		RESULTS += @"%TEXTTAG("L")%　また、これらのポイントは依頼ごとの評価点にあった奴隷ほど高くなるので"
		RESULTS += @"%TEXTTAG("L")%　できるだけ評価が高くなるように奴隷を調教したほうがいいです。"
		RESULTS += @"%TEXTTAG("L")%　依頼は達成しても、消えることはなく、なんどでも同じ依頼をうけることができます。"
		RESULTS += @"%TEXTTAG("L")%　しかし、すでに達成した依頼ではより高い評価を得なければ調教師ポイントはもらえず"
		RESULTS += @"%TEXTTAG("L")%　ギルドポイントも減少するので注意してください。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□調教師経験値と調教師ランク"
		RESULTS += @"%TEXTTAG("L")%　調教師経験値(TrainEXP)は調教師としての経験を示します。"
		RESULTS += @"%TEXTTAG("L")%　この経験が一定値を超えることで調教師ランクが上昇します。"
		RESULTS += @"%TEXTTAG("L")%　そして調教師ランクが上昇すると、"
		RESULTS += @"%TEXTTAG("L")%　さらに難度の高い依頼にチャレンジすることが可能になるほか、"
		RESULTS += @"%TEXTTAG("L")%　より多くのギルドによる支援をうけることができます。"
		RESULTS += @"%TEXTTAG("L")%　また、3年経過した時点でこのランクが低い場合、奴隷として売られることになります。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□ギルドポイント"
		RESULTS += @"%TEXTTAG("L")%　ギルドポイントはギルドに貢献している度合いを示します。"
		RESULTS += @"%TEXTTAG("L")%　このポイントを消費することで、ギルドから地図や参考書などを購入することができます。"
		RESULTS += @"%TEXTTAG("L")%　地図は探索地点を増やし、参考書は調合できるアイテムを増やします。"
		RESULTS += @"%TEXTTAG("L")%　これらのアイテムはギルドで購入する以外でも入手することができる場合もありますが"
		RESULTS += @"%TEXTTAG("L")%　基本的にはギルドで購入するのがいちばん楽な入手法となるのでうまく利用してください。"
		RESULTS += @"%TEXTTAG("L")%　また、購入できるアイテムの種類は調教師ランクが高ければ高いほど多くなります。"
	CASE 1
		RESULTS = □実績の評価
		RESULTS += @"%TEXTTAG("L")%　闇ギルドではギルドメンバーが出した実績に応じて"
		RESULTS += @"%TEXTTAG("L")%　ギルドポイントと調教師経験値を配布しています。"
		RESULTS += @"%TEXTTAG("L")%　なので、奴隷の従順や技巧といったABLを一定値以上にまであげることや様々な素質をもった奴隷を調教する。"
		RESULTS += @"%TEXTTAG("L")%　と言った調教師としての実績を出すことによっても調教師ランクをあげることができます。"
		RESULTS += @"%TEXTTAG("L")%　また、ロロナは錬金術士ができる調教師として期待されているので、"
		RESULTS += @"%TEXTTAG("L")%　錬金術士として成果を出すことによっても同様に評価してもらえます。"
		RESULTS += @"%TEXTTAG("L")%　したがって、調合レベルをあげたり、多くの素材や調合の知識を得ることでも調教師ランクをあげられます。"
		RESULTS += @"%TEXTTAG("L")%　これらの実績の条件はNOTEを見ることで確認できます。"
		RESULTS += @"%TEXTTAG("L")%　ただし、実績による経験値とポイントは闇ギルドに来て報告するまではてにはいらないので注意してください。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□実績と特典"
		RESULTS += @"%TEXTTAG("L")%実績の中には達成することで調教や調合が有利になる特典を得られるものがあります。"
		RESULTS += @"%TEXTTAG("L")%特定の素質を調教する際に有利になるものや、特定のABLをあげる際に必要な珠が減るもの、"
		RESULTS += @"%TEXTTAG("L")%調合の成功率が上昇するもの、調合時に特性をつけやすくするものなど、様々な特典があります。"
		RESULTS += @"%TEXTTAG("L")%これらの特典をあつめることによって、さらに実績を積みやすくなるので、"
		RESULTS += @"%TEXTTAG("L")%是非ともいろいろな実績を達成してみてください。"
		RESULTS += @"%TEXTTAG("L")%"
ENDSELECT
