@HELP_探索と採取, ARG = 2
SELECTCASE ARG
	CASE 0
		RESULTS =  □探索と移動方法
		RESULTS += @"%TEXTTAG("L")%　" + "┏" + "━" * 30 + "┓"
		RESULTS += (@"%TEXTTAG("L")%　" + "┃" + "　" * 30 + "┃") * 3
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　□　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　%ADD_FTAG("☆", COLOR("red"))%%ADD_FTAG("─", COLOR("p-green"))%%ADD_FTAG("□─", COLOR("p-green"))%%ADD_FTAG("□", COLOR("FOCUS"))%　　　　　　　　　　┃"
		RESULTS += (@"%TEXTTAG("L")%　" + "┃" + "　" * 30 + "┃") * 3
		RESULTS += @"%TEXTTAG("L")%　" + "┗" + "━" * 30 + "┛"
		RESULTS += @"%TEXTTAG("L")%　ショップ画面で[10] 探索を選ぶことでワールドマップ画面になります。"
		RESULTS += @"%TEXTTAG("L")%　ゲーム中、違う場所へ移動する際は、"
		RESULTS += @"%TEXTTAG("L")%　基本的にワールドマップ上で移動します。"
		RESULTS += @"%TEXTTAG("L")%　マウス操作では上のような地図上の記号を直接クリックすることで移動経路が表示され、"
		RESULTS += @"%TEXTTAG("L")%　さらにもう一度クリックすることで移動します。"
		RESULTS += @"%TEXTTAG("L")%　キーボードでは4・8・2・6キーを押すことで移動経路を決めて"
		RESULTS += @"%TEXTTAG("L")%　5を押すことで移動します。"
		RESULTS += @"%TEXTTAG("L")%　移動することで日数が経過するので注意してください。"
		RESULTS += @"%TEXTTAG("L")%　経過日数は画面上部で確認できます"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%　☆　　　　アーランドです"
		RESULTS += @"%TEXTTAG("L")%　□　　　　採取地です。様々なアイテムを採取できます"
		RESULTS += @"%TEXTTAG("L")%　△　　　　分岐点です。通過することしかできません"
		RESULTS += @"%TEXTTAG("L")%　─ or │　道です。"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("赤", COLOR("red"))%　　　　現在いる場所を示します。"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("緑", COLOR("p-green"))%　　　　移動経路を示します。"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("選択色", GETFOCUSCOLOR())%　　移動予定地を示します。"
	CASE 1
		RESULTS = □採取について
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
		RESULTS += @"%TEXTTAG("L")%　┃[+] 採取               [-] カゴ               [/] コンテナ                        ┃"
		RESULTS += @"%TEXTTAG("L")%　┃[0] セーブ             [9] ロード                                                 ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                                                                                  ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　現在地が採取地(MAP上で□)でさらに、現在地を指定している場合、"
		RESULTS += @"%TEXTTAG("L")%　上のように下部のコマンド欄に[+] 採取が現れます"
		RESULTS += @"%TEXTTAG("L")%　このボタンを選択することで、採取を実行できます"
		RESULTS += @"%TEXTTAG("L")%　採取を実行すると、１日かけて素材を集めます"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━┓　採れる素材は採取地ごとに異なりますが、"
		RESULTS += @"%TEXTTAG("L")%　┃近くの森            ┃　左のようなMAP右の場所情報欄に"
		RESULTS += @"%TEXTTAG("L")%　┣━━━━━━━━━━┫　採取できる素材が表示されるので参考にしてください"
		RESULTS += @"%TEXTTAG("L")%　┃森キャベツ          ┃　ただし、採取したことがない素材は????と表示されてしまいます"
		RESULTS += @"%TEXTTAG("L")%　┃アイヒェロア        ┃"
		RESULTS += @"%TEXTTAG("L")%　┃アイヒェ            ┃"
		RESULTS += @"%TEXTTAG("L")%　┃????                ┃"
		RESULTS += @"%TEXTTAG("L")%　┃マンドラゴラの根    ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                    ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　また、素材はカゴに入れて持ち運びします"
		RESULTS += @"%TEXTTAG("L")%　なので、カゴの容量を超えてしまった場合、"
		RESULTS += @"%TEXTTAG("L")%　カゴの中身を捨てるか、採取した素材を諦めるかしなければならないので注意してください"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
	CASE 2
		RESULTS = □探索画面でのコマンドについて
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
		RESULTS += @"%TEXTTAG("L")%　┃[+] 帰還               [-] カゴ               [/] コンテナ                        ┃"
		RESULTS += @"%TEXTTAG("L")%　┃[0] セーブ             [9] ロード                                                 ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                                                                                  ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　探索画面では画面下部に上のようにコマンド欄が表示されます"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[+] は現在いる場所と指定している場所により内容が変化します"
		RESULTS += @"%TEXTTAG("L")%　現在地以外の場所を指定してる場合、[+] 移動となり"
		RESULTS += @"%TEXTTAG("L")%　その場所に向かって移動を開始します"
		RESULTS += @"%TEXTTAG("L")%　アーランドでは[+] 帰還となり、アトリエに戻ることができます"
		RESULTS += @"%TEXTTAG("L")%　採取地では[+] 採取となり、素材の採取を開始します"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[-] カゴはカゴの中見を確認し"
		RESULTS += @"%TEXTTAG("L")%　中身を捨てることができます"
		RESULTS += @"%TEXTTAG("L")%　アトリエに持ち帰れるのはカゴの中見だけなので注意してください"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[/] コンテナはコンテナの中身を確認できます"
		RESULTS += @"%TEXTTAG("L")%　探索中は確認しかできず、中身を捨てることも"
		RESULTS += @"%TEXTTAG("L")%　移すことも出来ません"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[0] セーブはセーブすることができます"
		RESULTS += @"%TEXTTAG("L")%　ただし、ショップ画面に比べて、探索画面のほうが"
		RESULTS += @"%TEXTTAG("L")%　仕様変更によってバグが出やすいと思われるので"
		RESULTS += @"%TEXTTAG("L")%　重要なアイテムを入手した場合などはなるべく"
		RESULTS += @"%TEXTTAG("L")%　ショップ画面に戻ってからもセーブをつけることをおすすめします"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[9] ロードはロードすることができます"
		RESULTS += @"%TEXTTAG("L")%　こちらはショップ画面のものと全く違いがないので"
		RESULTS += @"%TEXTTAG("L")%　セーブのような危険性はないです"
