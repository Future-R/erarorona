@HELP_NAME_1
RESULTS = 探索与采集

@HELP_ABLE_探索与采集
RETURN 1

@HELP_PAGENUM_探索与采集
RETURN 2

@HELP_探索与采集, ARG = 2
SELECTCASE ARG
	CASE 0
		RESULTS =  □探索与移动方法
		RESULTS += @"%TEXTTAG("L")% "
		RESULTS += @"%TEXTTAG("L")%　　第1年  1月  9日 周二 → 第1年  1月 10日 周三 %ADD_FTAG("← 预计经过时间", COLOR("浅紫"))%"
		RESULTS += @"%TEXTTAG("L")%　" + "┏" + "━" * 30 + "┓"
		RESULTS += (@"%TEXTTAG("L")%　" + "┃" + "　" * 30 + "┃") * 2
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　□───△───□　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　%ADD_FTAG("绿色：途经地点", COLOR("p-green"))%　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　%ADD_FTAG("↓", COLOR("p-green"))%　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　%ADD_FTAG("红色：你在这里→", COLOR("red"))%%ADD_FTAG("☆", COLOR("red"))%%ADD_FTAG("─", COLOR("p-green"))%%ADD_FTAG("□─", COLOR("p-green"))%%ADD_FTAG("□", COLOR("FOCUS"))%　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　　　　　%ADD_FTAG("↑", COLOR("FOCUS"))%　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　　　　　%ADD_FTAG("高亮：选中地点", COLOR("FOCUS"))%　　　　┃"
		RESULTS += (@"%TEXTTAG("L")%　" + "┃" + "　" * 30 + "┃") * 2
		RESULTS += @"%TEXTTAG("L")%　" + "┗" + "━" * 30 + "┛"
		RESULTS += @"%TEXTTAG("L")%　在游戏的主菜单中选择【[10] 探索】，就会进入世界地图。"
		RESULTS += @"%TEXTTAG("L")% "
		RESULTS += @"%TEXTTAG("L")%　使用%ADD_FTAG("鼠标", COLOR("浅蓝"))%操作时，%ADD_FTAG("直接点击", COLOR("浅蓝"))%上述地图上的符号，就会显示出移动路径。"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("再次点击", COLOR("浅蓝"))%就可以移动了。"
		RESULTS += @"%TEXTTAG("L")% "
		RESULTS += @"%TEXTTAG("L")%　使用%ADD_FTAG("键盘", COLOR("浅绿"))%时，按下 %ADD_FTAG("8/2/4/6", COLOR("浅绿"))% 或 %ADD_FTAG("大写W/A/S/D", COLOR("浅绿"))% 键可以确定移动路径。"
		RESULTS += @"%TEXTTAG("L")%　然后再按 %ADD_FTAG("5", COLOR("浅绿"))% 或 %ADD_FTAG("空格", COLOR("浅绿"))% 就能移动了。"
		RESULTS += @"%TEXTTAG("L")% "
		RESULTS += @"%TEXTTAG("L")%　需要注意，移动的时候%ADD_FTAG("日期会流逝", COLOR("浅紫"))%。"
		RESULTS += @"%TEXTTAG("L")%　可以在界面顶部查看预计经过的天数。"
		RESULTS += @"%TEXTTAG("L")% "
		RESULTS += @"%TEXTTAG("L")%　☆　　　　这里是亚兰德"
		RESULTS += @"%TEXTTAG("L")%　□　　　　这里是采集地，可以采集各种物品"
		RESULTS += @"%TEXTTAG("L")%　△　　　　这里是分岔路，只能经过"
		RESULTS += @"%TEXTTAG("L")%　─ 或 │　就是道路。"
	CASE 1
		RESULTS = □关于采集
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
		RESULTS += @"%TEXTTAG("L")%　┃[+] 采集               [-] 篮子               [/] 箱子                            ┃"
		RESULTS += @"%TEXTTAG("L")%　┃[0] 保存               [9] 读取                                                   ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                                                                                  ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　地图上显示为□的是采集地，"
		RESULTS += @"%TEXTTAG("L")%　萝乐娜在采集地时，下方的指令栏中会出现【[+] 采集】。"
		RESULTS += @"%TEXTTAG("L")%　选择这条指令，就可以采集了。"
		RESULTS += @"%TEXTTAG("L")%　执行采集后，会花费１天时间来收集素材。当然也可以花费更多时间一次性采集到篮子满。"
		RESULTS += @"%TEXTTAG("L")% "
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━┓　可采集的素材因采集地点而异，"
		RESULTS += @"%TEXTTAG("L")%　┃附近的森林          ┃　不过如左侧这样的地图，在右侧的地点信息栏中"
		RESULTS += @"%TEXTTAG("L")%　┣━━━━━━━━━━┫　会显示可采集的素材，可作为参考。"
		RESULTS += @"%TEXTTAG("L")%　┃森林卷心菜          ┃　但是，从未采集过的素材会显示为【????】。"
		RESULTS += @"%TEXTTAG("L")%　┃橡树菇              ┃"
		RESULTS += @"%TEXTTAG("L")%　┃橡木                ┃"
		RESULTS += @"%TEXTTAG("L")%　┃????                ┃"
		RESULTS += @"%TEXTTAG("L")%　┃风茄的根            ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                    ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　此外，素材是纳入篮子中携带的。"
		RESULTS += @"%TEXTTAG("L")%　所以请注意，如果超出篮子空间的话，"
		RESULTS += @"%TEXTTAG("L")%　就必须扔掉篮子里的东西或者放弃采集到的素材。"
		RESULTS += @"%TEXTTAG("L")%　选中物品后按下菜单键就能看到丢弃选项了。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
	CASE 2
		RESULTS = □关于探索界面中的指令
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
		RESULTS += @"%TEXTTAG("L")%　┃[+] 归返               [-] 篮子               [/] 箱子                            ┃"
		RESULTS += @"%TEXTTAG("L")%　┃[0] 保存               [9] 读取                                                   ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                                                                                  ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　在探索界面中，界面下方会如上文所示显示指令栏。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[+] 的内容会根据当前所在位置和指定位置而变化。"
		RESULTS += @"%TEXTTAG("L")%　如果指定了当前位置以外的地点，则 [+] 变为移动，"
		RESULTS += @"%TEXTTAG("L")%　执行后开始向那个地方移动。"
		RESULTS += @"%TEXTTAG("L")%　在亚兰德时会变为【[+] 归返】，可以返回工房。"
		RESULTS += @"%TEXTTAG("L")%　在采集地会显示【[+] 采集】，并开始采集素材。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　要查看篮子内容就选择【[-] 篮子】，"
		RESULTS += @"%TEXTTAG("L")%　可以丢弃里面的东西。"
		RESULTS += @"%TEXTTAG("L")%　请注意，能带回工房的只有篮子里的东西。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　要查看箱子内容就选择【[/] 箱子】，"
		RESULTS += @"%TEXTTAG("L")%　探索的时候只能检查或者丢弃其中的物品，"
		RESULTS += @"%TEXTTAG("L")%　而无法将其取出。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　【[0] 保存】可以进行保存。"
		RESULTS += @"%TEXTTAG("L")%　不过，探索界面相比于主菜单来说，"
		RESULTS += @"%TEXTTAG("L")%　界面变化更多，因此更容易出现BUG。"
		RESULTS += @"%TEXTTAG("L")%　所以如果获得了重要的物品的话，"
		RESULTS += @"%TEXTTAG("L")%　更推荐前往主菜单进行保存，这样比较稳妥。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　【[9] 读取】可以用来读取游戏存档。"
		RESULTS += @"%TEXTTAG("L")%　这条指令与主菜单上的没有任何区别。"
		RESULTS += @"%TEXTTAG("L")%　和这里的存档指令一样，有一定的不稳定性。"
ENDSELECT
