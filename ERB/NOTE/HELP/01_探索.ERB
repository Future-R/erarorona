@HELP_NAME_1
RESULTS = 探索与采集

@HELP_ABLE_探索与采集
RETURN 1

@HELP_PAGENUM_探索与采集
RETURN 2

@HELP_探索与采集, ARG = 2
SELECTCASE ARG
	CASE 0
		RESULTS =  □探索与移动方法
		RESULTS += @"%TEXTTAG("L")%　" + "┏" + "━" * 30 + "┓"
		RESULTS += (@"%TEXTTAG("L")%　" + "┃" + "　" * 30 + "┃") * 3
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　□　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　│　　　　　　　　　　　　　　┃"
		RESULTS += @"%TEXTTAG("L")%　┃　　　　　　　　　　　　　　　%ADD_FTAG("☆", COLOR("red"))%%ADD_FTAG("─", COLOR("p-green"))%%ADD_FTAG("□─", COLOR("p-green"))%%ADD_FTAG("□", COLOR("FOCUS"))%　　　　　　　　　　┃"
		RESULTS += (@"%TEXTTAG("L")%　" + "┃" + "　" * 30 + "┃") * 3
		RESULTS += @"%TEXTTAG("L")%　" + "┗" + "━" * 30 + "┛"
		RESULTS += @"%TEXTTAG("L")%　在游戏的商店画面中选择【[10] 探索】，就会进入世界地图画面。"
		RESULTS += @"%TEXTTAG("L")%　在游戏过程中，当要移动到不同的地方时，"
		RESULTS += @"%TEXTTAG("L")%　基本上是在世界地图上进行移动。"
		RESULTS += @"%TEXTTAG("L")%　使用鼠标操作时，直接点击上述地图上的符号，就会显示出移动路径。"
		RESULTS += @"%TEXTTAG("L")%　再次点击就可以移动了。"
		RESULTS += @"%TEXTTAG("L")%　使用键盘时，按下 4・8・2・6 键可以确定移动路径。"
		RESULTS += @"%TEXTTAG("L")%　然后再按5就能移动了。"
		RESULTS += @"%TEXTTAG("L")%　需要注意，移动的时候会度过一些天数。"
		RESULTS += @"%TEXTTAG("L")%　经过的天数可以在画面顶部查看。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%　☆　　　　这里是亚兰德"
		RESULTS += @"%TEXTTAG("L")%　□　　　　这里是采集地，可以采集各种物品"
		RESULTS += @"%TEXTTAG("L")%　△　　　　这里是分岔路，只能通过"
		RESULTS += @"%TEXTTAG("L")%　─ 或 │　就是道路。"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("赤", COLOR("red"))%　　　　显示你所在的位置。"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("緑", COLOR("p-green"))%　　　　显示移动路径。"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("選択色", GETFOCUSCOLOR())%　　显示预定的移动地点。"
	CASE 1
		RESULTS = □关于采集
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
		RESULTS += @"%TEXTTAG("L")%　┃[+] 采集               [-] 篮子               [/] 箱子                            ┃"
		RESULTS += @"%TEXTTAG("L")%　┃[0] 保存               [9] 读取                                                   ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                                                                                  ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　当前位置为采集地(在地图上为□)，且指定了当前位置的情况下，"
		RESULTS += @"%TEXTTAG("L")%　在下方的指令栏中会出现【[+] 采集】。"
		RESULTS += @"%TEXTTAG("L")%　选择这条指令，就可以采集了。"
		RESULTS += @"%TEXTTAG("L")%　执行采集操作后，需要花费１天时间来收集素材。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━┓　可采集的素材因采集地点而异，"
		RESULTS += @"%TEXTTAG("L")%　┃附近的森林          ┃　不过如左侧这样的地图，在右侧的地点信息栏中"
		RESULTS += @"%TEXTTAG("L")%　┣━━━━━━━━━━┫　会显示可采集的素材，可作为参考。"
		RESULTS += @"%TEXTTAG("L")%　┃森林卷心菜          ┃　但是，从未采集过的素材会显示为【????】。"
		RESULTS += @"%TEXTTAG("L")%　┃アイヒェロア        ┃"
		RESULTS += @"%TEXTTAG("L")%　┃アイヒェ            ┃"
		RESULTS += @"%TEXTTAG("L")%　┃????                ┃"
		RESULTS += @"%TEXTTAG("L")%　┃曼德拉草根茎        ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                    ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　此外，素材是纳入篮子中携带的。"
		RESULTS += @"%TEXTTAG("L")%　所以请注意，如果超出篮子容量的话，"
		RESULTS += @"%TEXTTAG("L")%　就必须扔掉篮子里的东西或者放弃采集到的素材。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
	CASE 2
		RESULTS = □关于探索画面中的命令
		RESULTS += @"%TEXTTAG("L")%　┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
		RESULTS += @"%TEXTTAG("L")%　┃[+] 回归               [-] 篮子               [/] 箱子                            ┃"
		RESULTS += @"%TEXTTAG("L")%　┃[0] 保存               [9] 读取                                                   ┃"
		RESULTS += @"%TEXTTAG("L")%　┃                                                                                  ┃"
		RESULTS += @"%TEXTTAG("L")%　┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
		RESULTS += @"%TEXTTAG("L")%　在探索画面中，画面下方会如上文所示显示指令栏。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[+] 的内容会根据当前所在位置和指定位置而变化。"
		RESULTS += @"%TEXTTAG("L")%　如果指定了当前位置以外的地点，则 [+] 变为移动，"
		RESULTS += @"%TEXTTAG("L")%　执行后开始向那个地方移动。"
		RESULTS += @"%TEXTTAG("L")%　在阿兰德时会变为【[+] 归返】，可以返回工房。"
		RESULTS += @"%TEXTTAG("L")%　在采集地会显示【[+] 采集】，并开始采集素材。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　要查看篮子内容就选择【[-] 篮子】，"
		RESULTS += @"%TEXTTAG("L")%　可以丢弃里面的东西。"
		RESULTS += @"%TEXTTAG("L")%　请注意，能带回工房的只有篮子里的东西。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　要查看箱子内容就选择【[/] 箱子】，"
		RESULTS += @"%TEXTTAG("L")%　探索的时候只能检查或者丢弃其中的物品，"
		RESULTS += @"%TEXTTAG("L")%　而无法将其取出。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　【[0] 保存】可以进行保存。"
		RESULTS += @"%TEXTTAG("L")%　ただし、商店画面に比べて、探索画面のほうが"
		RESULTS += @"%TEXTTAG("L")%　仕様変更によってバグが出やすいと思われるので"
		RESULTS += @"%TEXTTAG("L")%　重要な物品を入手した場合などはなるべく"
		RESULTS += @"%TEXTTAG("L")%　商店画面に戻ってからもセーブをつけることをおすすめします"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　[9] ロードはロードすることができます"
		RESULTS += @"%TEXTTAG("L")%　こちらは商店画面のものと全く違いがないので"
		RESULTS += @"%TEXTTAG("L")%　セーブのような危険性はないです"
ENDSELECT

