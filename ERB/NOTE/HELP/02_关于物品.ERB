		RESULTS += @"%TEXTTAG("L")%　└─────┴────────────┴────┴─────┴────┴──────┘"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("－物品名           ", COLOR("p-green"))%"
