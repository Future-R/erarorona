		RESULTS += @"%TEXTTAG("L")%　在物品可以被重复利用的场合，右侧会显示可使用次数与最大使用次数"
		RESULTS += @"%TEXTTAG("L")%　此时，点击这个物品的名称或者按下[q]键"
