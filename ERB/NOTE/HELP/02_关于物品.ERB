		RESULTS += @"%TEXTTAG("L")%　物品的品阶划分为E/D/C/B/A/S六个等阶。"
		RESULTS += @"%TEXTTAG("L")%　物品的品质越高，拥有的优秀特性越多，同时品阶也越高。"
		RESULTS += @"%TEXTTAG("L")%　随着等阶越来越高，物品也会获得「物品的销售价格提升」、"
		RESULTS += @"%TEXTTAG("L")%　「作为消耗品时的效果更强」、"
		RESULTS += @"%TEXTTAG("L")%　「作为委托物品提交时获得的评价提高」等效果"
