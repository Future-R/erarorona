		RESULTS += @"%TEXTTAG("L")%　┌───────────┬─┬──┬─┬──────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│ 治愈软膏[4/4]        │ D│  49│%ADD_FTAG(" 1", COLOR("p-green"))%│对伤口和伤痛有效的著名外用药。              │"
		RESULTS += @"%TEXTTAG("L")%　├─────┬─────┴─┴──┴─┼────┬─────┬────┬──────┤"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG("调合类别", COLOR("p-red"))%  │%ADD_FTAG("药品", COLOR("p-red"))%                    │特性　　│春药的原料│效果　  │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │高价Lv1   │        │体力恢复：小│"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　└─────┴────────────┴────┴─────┴────┴──────┘"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("－级(消耗额等级)", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　这里的级主要表示物品在调合时能提供多少消耗额。"
		RESULTS += @"%TEXTTAG("L")%　它会影响可继承特性的数量与档次，"
		RESULTS += @"%TEXTTAG("L")%　但并不等同于品质，也不直接代表成品强弱。"
		RESULTS += @"%TEXTTAG("L")%　一般来说，作为材料使用时等级越高，"
		RESULTS += @"%TEXTTAG("L")%　调合时就越容易继承更多、更高消耗额的特性。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("－调合类别", COLOR("p-red"))%"
		RESULTS += @"%TEXTTAG("L")%　这里显示的是物品具有的调合类别"
