		RESULTS += @"%TEXTTAG("L")%　可以被使用在需要【药品】分类作为素材的调合中。"
		RESULTS += @"%TEXTTAG("L")%　同一件物品可能会具有多个调合类别。"
	CASE 3
		RESULTS = □特性的基础
		RESULTS += @"%TEXTTAG("L")%　┌───────────┬─┬──┬─┬──────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│ 治愈软膏[4/4]        │ D│  49│ 1│对伤口和伤痛有效的著名外用药。              │"
		RESULTS += @"%TEXTTAG("L")%　├─────┬─────┴─┴──┴─┼────┬─────┬────┬──────┤"
		RESULTS += @"%TEXTTAG("L")%　│调合类别  │药品                    │%ADD_FTAG("特性", COLOR("p-red"))%　　│%ADD_FTAG("春药的原料", COLOR("p-red"))%│%ADD_FTAG("效果", COLOR("p-green"))%　  │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │%ADD_FTAG("高价Lv1", COLOR("p-red"))%   │        │%ADD_FTAG("体力恢复：小", COLOR("p-green"))%│"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　└─────┴────────────┴────┴─────┴────┴──────┘"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("－特性", COLOR("p-red"))%"
		RESULTS += @"%TEXTTAG("L")%　特性是附着在物品上的特殊规则。每件物品最多持有5个特性。"
		RESULTS += @"%TEXTTAG("L")%　它们可以提升品质、售价和使用效果，"
		RESULTS += @"%TEXTTAG("L")%　也可能让物品在霍姆克鲁斯相关系统中附带特质、能力或外观影响。"
		RESULTS += @"%TEXTTAG("L")%　同名物品只要特性不同，实际价值和用途也会不同。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　特性的主要来源有以下几种："
		RESULTS += @"%TEXTTAG("L")%　1. 固有特性：部分素材天生自带，会比较稳定地出现。"
		RESULTS += @"%TEXTTAG("L")%　2. 采集获得：采集素材时，会按物品等级随机附上特性。"
		RESULTS += @"%TEXTTAG("L")%　3. 调合继承：调合完成前，可从候选特性中挑选要带走的部分。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　另外，并非所有特性都能继承到所有成品。"
		RESULTS += @"%TEXTTAG("L")%　每个特性都有自己的继承类型，"
		RESULTS += @"%TEXTTAG("L")%　只有与完成品类型相符时，才会出现在继承候补中。"
	CASE 4
		RESULTS = □主效果与特性的区别
		RESULTS += @"%TEXTTAG("L")%　┌───────────┬─┬──┬─┬──────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│ 治愈软膏[4/4]        │ D│  49│ 1│对伤口和伤痛有效的著名外用药。              │"
		RESULTS += @"%TEXTTAG("L")%　├─────┬─────┴─┴──┴─┼────┬─────┬────┬──────┤"
		RESULTS += @"%TEXTTAG("L")%　│调合类别  │药品                    │特性　　│春药的原料│%ADD_FTAG("效果", COLOR("p-green"))%　  │%ADD_FTAG("体力恢复：小", COLOR("p-green"))%│"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │高价Lv1   │        │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　│          │                        │        │          │        │            │"
		RESULTS += @"%TEXTTAG("L")%　└─────┴────────────┴────┴─────┴────┴──────┘"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("－主效果", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　主效果是物品被使用时会直接发动的主要效果。"
		RESULTS += @"%TEXTTAG("L")%　消耗品通常拥有一个或数个主效果，"
		RESULTS += @"%TEXTTAG("L")%　调合时使用的素材会影响哪些主效果被激发出来。"
		RESULTS += @"%TEXTTAG("L")%　而特性更像是附加规则，负责强化、修饰或追加性质。"
		RESULTS += @"%TEXTTAG("L")%　换句话说，主效果决定这个道具做什么，"
		RESULTS += @"%TEXTTAG("L")%　特性决定这个道具做得多好，或带有什么附加性质。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　例："
		RESULTS += @"%TEXTTAG("L")%　体力恢复：小　　　　使用时恢复目标的ＨＰ(体力)"
		RESULTS += @"%TEXTTAG("L")%　美味恢复：小　　　　恢复对象的ＨＰ(体力)，仅限主菜单使用"
		RESULTS += @"%TEXTTAG("L")%　对Ｃ快感(中)　　　　给对象追加快Ｃ的来源"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　这些效果的实际强弱，还会继续受到特性、品质和品阶影响。"
