@HELP_NAME_3
RESULTS = 调合

@HELP_ABLE_调合
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN 0
RETURN 1

@HELP_PAGENUM_调合
RETURN 2

@HELP_调合, ARG
SELECTCASE ARG
	CASE 0
		RESULTS =　□什么是调和？
		RESULTS += @"%TEXTTAG("L")%　使用炼金术将两个道具进行合成，创造出新的道具的行为就被称为调合。"
		RESULTS += @"%TEXTTAG("L")%　通过调合制作而成的道具或许可以成为进一步调和成其他道具的素材，也或许可以成为制作装备的原料，"
		RESULTS += @"%TEXTTAG("L")%　还有些可以为对象回复体力，又或是可以在调教中获得一些便利。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□调合的流程 1"
		RESULTS += @"%TEXTTAG("L")%　┌──────────┬──┬──────┬──────┬──────┬─────┐"
		RESULTS += @"%TEXTTAG("L")%　│名前             　 │所持│素材1       │素材2       │素材3       │素材4     │"
		RESULTS += @"%TEXTTAG("L")%　├──────────┼──┼──────┼──────┼──────┼─────┤"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))%中和剤          　│   3│【中和剤】  │            │            │          │"
		RESULTS += @"%TEXTTAG("L")%　│　ヒーリングサルヴ　│   1│%ADD_FTAG("【植物類】", COLOR("gray"))%  │ マンドラ...│ 水         │          │"
		RESULTS += @"%TEXTTAG("L")%　│　プレーンパイ    　│   0│【調味料】  │ 面粉     │ 水         │          │"
		RESULTS += @"%TEXTTAG("L")%　└──────────┴──┴──────┴──────┴──────┴─────┘"
		RESULTS += @"%TEXTTAG("L")%　选择[20] 调和指令之后，就可以开始调和了。"
		RESULTS += @"%TEXTTAG("L")%　首先会出现一个列表"
		RESULTS += @"%TEXTTAG("L")%　如果没有持有的道具就会像%ADD_FTAG("灰色", COLOR("gray"))%这样显示"
		RESULTS += @"%TEXTTAG("L")%　素材方面、会在【】中展示其调和类别"
		RESULTS += @"%TEXTTAG("L")%　可以自由的使用含有【】内分类下的任意材料"
		RESULTS += @"%TEXTTAG("L")%　曾经调合过的配方将会以%ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))%的样式被展现"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　此外，画面的右上角会展示当前的MP和调和等级，"
		RESULTS += @"%TEXTTAG("L")%　画面的下部则会展示调合必要的MP以及目标所需的调合等级"
		RESULTS += @"%TEXTTAG("L")%　如果MP不足或者当前调合等级未达到目标调合等级的情况下，成功率将会下降，请多加注意"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　选择想要进行制作的道具、"
		RESULTS += @"%TEXTTAG("L")%　再选择现在所持有的素材，选择对应的个数，就可以转移到下一个画面了"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　※由于关于调合数量方面的算法存在一些问题"
		RESULTS += @"%TEXTTAG("L")%　　所以可能会出现就算持有全部所需素材，也无法完成制作的情况"
		RESULTS += @"%TEXTTAG("L")%　　如果发生素材数量相较目标素材数量有一定余裕确无法成功通过的情况"
		RESULTS += @"%TEXTTAG("L")%　　只能向您表示歉意，请尝试着再增加一些手中持有的素材数量"
	CASE 1
		RESULTS = □调和菜单
		RESULTS += @"%TEXTTAG("L")%　┌────────────┐　调合メニューに移ると画面の3段目に"
		RESULTS += @"%TEXTTAG("L")%　│ [0]【面粉】          │　右のようなボタンが４つ表示されます"
		RESULTS += @"%TEXTTAG("L")%　├────────────┤　このうち、%ADD_FTAG("灰色", COLOR("gray"))%でなく"
		RESULTS += @"%TEXTTAG("L")%　│必要数　[  2]           │　必要数が表示されているものを点击してください"
		RESULTS += @"%TEXTTAG("L")%　│選択数　[  0]           │　"
		RESULTS += @"%TEXTTAG("L")%　└────────────┘　"
		RESULTS += @"%TEXTTAG("L")%　すると、物品リストが現れるので调合に使う物品を選んでください"
		RESULTS += @"%TEXTTAG("L")%　物品を選んでから[9]で戻ることで選択完了となり、"
		RESULTS += @"%TEXTTAG("L")%　再决定您要选择的材料"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□主效果の発現"
		RESULTS += @"%TEXTTAG("L")%　调合した物品には主效果がつく場合があります"
		RESULTS += @"%TEXTTAG("L")%　その場合は画面下の情報欄に效果名と下のようなバーが現れます"
		RESULTS += @"%TEXTTAG("L")%　┌──────┬───────┬──────────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│ 效果       │ＨＰ回復・小  │%ADD_FTAG(UNICODE(0x2580)*13, COLOR("p-blue"))%%ADD_FTAG(UNICODE(0x2580)*9, COLOR("p-green"))%%ADD_FTAG(UNICODE(0x2580), COLOR("yellow"))%%ADD_FTAG(UNICODE(0x2580) * 29, COLOR("p-green"))%│"
		RESULTS += @"%TEXTTAG("L")%　├──────┴───────┴──────────────────────────┤"
		RESULTS += @"%TEXTTAG("L")%　これは物品の完成品の调和类别值がバーの%ADD_FTAG("黄色", COLOR("yellow"))%の位置であることを示しています"
		RESULTS += @"%TEXTTAG("L")%　この物品の場合、调和类别值が%ADD_FTAG("緑色", COLOR("p-green"))%か%ADD_FTAG("青色", COLOR("p-blue"))%であるかで発現する主效果が変わります"
		RESULTS += @"%TEXTTAG("L")%　なので调和类别值が低くなるように物品を選ぶと下のようになります"
		RESULTS += @"%TEXTTAG("L")%　┌──────┬───────┬──────────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│ 效果       │ＨＰ回復・微  │%ADD_FTAG(UNICODE(0x2580)*6, COLOR("p-blue"))%%ADD_FTAG(UNICODE(0x2580), COLOR("yellow"))%%ADD_FTAG(UNICODE(0x2580)*6, COLOR("p-blue"))%%ADD_FTAG(UNICODE(0x2580)*39, COLOR("p-green"))%│"
		RESULTS += @"%TEXTTAG("L")%　├──────┴───────┴──────────────────────────┤"
		RESULTS += @"%TEXTTAG("L")%　调和类别值は選んだ物品の品質の合計值や選んだ物品の種類によって変わります"
		RESULTS += @"%TEXTTAG("L")%　色々な物品を試すことで、様々な主效果を発現させてください"
		RESULTS += @"%TEXTTAG("L")%　"
	CASE 2
		RESULTS = □素質候補
		RESULTS += @"%TEXTTAG("L")%　├──────┴───────────┴──────────────────────┤"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG("冷淡Lv1(-3)", COLOR("p-red"))%           　 多情Lv1(5)          　 侍奉精神+(2)           　       │"
		RESULTS += @"%TEXTTAG("L")%　│                      　                       　                       　        │"
		RESULTS += @"%TEXTTAG("L")%　└───────────────────────────────[q] %UNICODE(0x25C0)% PAGE. 0 %UNICODE(0x25B6)% [w] ┘"
		RESULTS += @"%TEXTTAG("L")%　選択した素材に継承可能な特性がついていた場合、"
		RESULTS += @"%TEXTTAG("L")%　下の欄にそれらの特性が表示されます"
		RESULTS += @"%TEXTTAG("L")%　この時、()内の数值が実際に継承されるのに必要なコストです"
		RESULTS += @"%TEXTTAG("L")%　使用可能なコストは素材のコスト等级によって決まり、"
		RESULTS += @"%TEXTTAG("L")%　等级の高い物品を多く使うほど増えます"
		RESULTS += @"%TEXTTAG("L")%　また、一部の素質を付与する特性はコストがマイナスになっています"
		RESULTS += @"%TEXTTAG("L")%　この場合、コストを払って外さない限り、強制的に调合品に特性が継承されます"
		RESULTS += @"%TEXTTAG("L")%　継承可能な特性は完成品によってそれぞれ違います"
		RESULTS += @"%TEXTTAG("L")%　基本的には调合品はすべて引き継ぎ、その他のものは效果があるものだけ引き継ぎます"
		RESULTS += @"%TEXTTAG("L")%　また、淳朴と倔强のように相容れない素質の"
		RESULTS += @"%TEXTTAG("L")%　組み合わせの特性はそれぞれで相殺され、消えることがあります"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　継承素質は合成後に選択してつけます"
		RESULTS += @"%TEXTTAG("L")%　右の欄の上から5つが実際に継承されるので"
		RESULTS += @"%TEXTTAG("L")%　必要な特性あるいは不必要な特性を選んで"
		RESULTS += @"%TEXTTAG("L")%　特性を調整してください"
ENDSELECT
