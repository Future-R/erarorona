@HELP_NAME_3
RESULTS = 调合

@HELP_ABLE_调合
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN 0
RETURN 1

@HELP_PAGENUM_调合
RETURN 2

@HELP_调合, ARG
SELECTCASE ARG
	CASE 0
		RESULTS =　□什么是调合？
		RESULTS += @"%TEXTTAG("L")%　使用炼金术合成多个物品，然后创造出新的物品，这个行为就被称为调合。"
		RESULTS += @"%TEXTTAG("L")%　通过调合制作的物品，有可能是其他物品的素材，或者制作装备的原料，"
		RESULTS += @"%TEXTTAG("L")%　还有些可以为对象恢复体力，又或是可以在调教中获得一些便利。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□调合的流程 1"
		RESULTS += @"%TEXTTAG("L")%　┌──────────┬──┬──────┬──────┬──────┬─────┐"
		RESULTS += @"%TEXTTAG("L")%　│名称             　 │所持│素材1       │素材2       │素材3       │素材4     │"
		RESULTS += @"%TEXTTAG("L")%　├──────────┼──┼──────┼──────┼──────┼─────┤"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))%中和剂          　│   3│【中和剂】  │            │            │          │"
		RESULTS += @"%TEXTTAG("L")%　│　治愈软膏        　│   1│%ADD_FTAG("【植物类】", COLOR("gray"))%  │风茄的根    │ 水         │          │"
		RESULTS += @"%TEXTTAG("L")%　│　原味馅饼        　│   0│【调味料】  │ 面粉       │ 水         │          │"
		RESULTS += @"%TEXTTAG("L")%　└──────────┴──┴──────┴──────┴──────┴─────┘"
		RESULTS += @"%TEXTTAG("L")%　选择[20] 调合指令之后，就可以开始调合了。"
		RESULTS += @"%TEXTTAG("L")%　首先会出现一个配方列表"
		RESULTS += @"%TEXTTAG("L")%　如果没有持有的物品就会像%ADD_FTAG("灰色", COLOR("gray"))%这样显示"
		RESULTS += @"%TEXTTAG("L")%　素材方面，会在【】中展示其调合类别"
		RESULTS += @"%TEXTTAG("L")%　可以自由使用具有【】内调合类别的任意材料"
		RESULTS += @"%TEXTTAG("L")%　曾经调合过的配方将会以%ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))%的样式被展现"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　此外，画面的右上角会展示当前的MP和调合等级，"
		RESULTS += @"%TEXTTAG("L")%　画面的下部则会展示配方所需的MP以及目标所需的调合等级"
		RESULTS += @"%TEXTTAG("L")%　如果MP不足或者当前调合等级未达到目标调合等级的情况下，成功率将会下降，请多加注意"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　选择想要制作物品的配方，"
		RESULTS += @"%TEXTTAG("L")%　再选择现在所持有的素材，选择对应的数量，就可以转移到下一个画面了"
		RESULTS += @"%TEXTTAG("L")%　"
		; RESULTS += @"%TEXTTAG("L")%　※由于关于调合数量方面的算法存在一些问题"
		; RESULTS += @"%TEXTTAG("L")%　　所以可能会出现就算持有全部所需素材，也无法完成制作的情况"
		; RESULTS += @"%TEXTTAG("L")%　　如果发生素材数量相较目标素材数量有一定余裕却无法成功通过的情况"
		; RESULTS += @"%TEXTTAG("L")%　　只能向您表示歉意，请尝试着再增加一些手中持有的素材数量"
	CASE 1
		RESULTS = □调合菜单
		RESULTS += @"%TEXTTAG("L")%　┌────────────┐　进入调合界面后，画面上的第三栏的"
		RESULTS += @"%TEXTTAG("L")%　│ [0]【面粉】            │　右侧会出现四个按钮"
		RESULTS += @"%TEXTTAG("L")%　├────────────┤　在这之中，请不要点击%ADD_FTAG("灰色", COLOR("gray"))%"
		RESULTS += @"%TEXTTAG("L")%　│所需数　[  2]           │　而是应该点击显示所需数的按钮。"
		RESULTS += @"%TEXTTAG("L")%　│选择数　[  0]           │　"
		RESULTS += @"%TEXTTAG("L")%　└────────────┘　"
		RESULTS += @"%TEXTTAG("L")%　随后将显示物品列表，请选择用于合成的物品"
		RESULTS += @"%TEXTTAG("L")%　选择物品后，按[9]返回即可完成选择，"
		RESULTS += @"%TEXTTAG("L")%　并确定使用所选材料"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□主效果的发现"
		RESULTS += @"%TEXTTAG("L")%　调合出来的物品有时会附带主效果"
		RESULTS += @"%TEXTTAG("L")%　这种情况下，屏幕下方的信息栏会出现效果名称和下面的进度条。"
		RESULTS += @"%TEXTTAG("L")%　┌──────┬───────┬──────────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│ 效果       │体力恢复：小  │%ADD_FTAG(UNICODE(0x2580)*13, COLOR("p-blue"))%%ADD_FTAG(UNICODE(0x2580)*9, COLOR("p-green"))%%ADD_FTAG(UNICODE(0x2580), COLOR("yellow"))%%ADD_FTAG(UNICODE(0x2580) * 29, COLOR("p-green"))%│"
		RESULTS += @"%TEXTTAG("L")%　├──────┴───────┴──────────────────────────┤"
		RESULTS += @"%TEXTTAG("L")%　这表示物品完成后的调合类别值将处于进度条%ADD_FTAG("黄色", COLOR("yellow"))%的位置"
		RESULTS += @"%TEXTTAG("L")%　这个物品将根据调合类别值达到%ADD_FTAG("绿色", COLOR("p-green"))%或%ADD_FTAG("蓝色", COLOR("p-blue"))%，发现不同的主效果"
		RESULTS += @"%TEXTTAG("L")%　若选择调合类别值较低的素材进行合成，则可能出现以下情况"
		RESULTS += @"%TEXTTAG("L")%　┌──────┬───────┬──────────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│ 效果       │体力恢复：微  │%ADD_FTAG(UNICODE(0x2580)*6, COLOR("p-blue"))%%ADD_FTAG(UNICODE(0x2580), COLOR("yellow"))%%ADD_FTAG(UNICODE(0x2580)*6, COLOR("p-blue"))%%ADD_FTAG(UNICODE(0x2580)*39, COLOR("p-green"))%│"
		RESULTS += @"%TEXTTAG("L")%　├──────┴───────┴──────────────────────────┤"
		RESULTS += @"%TEXTTAG("L")%　调合类别值受到所选物品品质总和与种类的共同影响"
		RESULTS += @"%TEXTTAG("L")%　请尝试各种物品的组合，发现各式各样的主效果吧"
		RESULTS += @"%TEXTTAG("L")%　"
	CASE 2
		RESULTS = □特质候补
		RESULTS += @"%TEXTTAG("L")%　├──────┴───────────┴──────────────────────┤"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG("冷淡Lv1(-3)", COLOR("p-red"))%           　   多情Lv1(5)          　 侍奉精神+(2)           　       │"
		RESULTS += @"%TEXTTAG("L")%　│                      　                       　                       　        │"
		RESULTS += @"%TEXTTAG("L")%　└───────────────────────────────[q] %UNICODE(0x25C0)% 页码. 0 %UNICODE(0x25B6)% [w] ┘"
		RESULTS += @"%TEXTTAG("L")%　当所选素材带有可继承的特性时，"
		RESULTS += @"%TEXTTAG("L")%　下方的栏中将显示对应的特性"
		RESULTS += @"%TEXTTAG("L")%　此时，()内的数值即为实际上继承所需的消耗额"
		RESULTS += @"%TEXTTAG("L")%　可用的消耗额由素材的消耗额等级决定，"
		RESULTS += @"%TEXTTAG("L")%　使用的高等级物品越多，消耗额等级越高"
		RESULTS += @"%TEXTTAG("L")%　此外，一部分赋予特质的特性拥有负数的消耗额"
		RESULTS += @"%TEXTTAG("L")%　此时如果不为其支付消耗额，调合制品将强制继承那些特性"
		RESULTS += @"%TEXTTAG("L")%　可继承的特性种类随产物不同而变化"
		RESULTS += @"%TEXTTAG("L")%　一般来说调合制品会全部继承，其他的产物仅继承有效部分"
		RESULTS += @"%TEXTTAG("L")%　此外，像淳朴和倔强这样互斥的特质组合时"
		RESULTS += @"%TEXTTAG("L")%　可能会相互抵消，导致特性消失"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　继承特质需在合成后选择"
		RESULTS += @"%TEXTTAG("L")%　右侧栏内的前5位将实际继承"
		RESULTS += @"%TEXTTAG("L")%　请选择需要或不需要的特性"
		RESULTS += @"%TEXTTAG("L")%　以此来完成特性的调整"
ENDSELECT
