@HELP_NAME_4
RESULTS = 制造霍姆克鲁斯

@HELP_ABLE_制造霍姆克鲁斯
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN 0
RETURN 1

@HELP_制造霍姆克鲁斯, ARG
SELECTCASE ARG
	CASE 0
		RESULTS = □霍姆克鲁斯的制作流程
		RESULTS += @"%TEXTTAG("L")%　和调合一样，制作霍姆克鲁斯的时候会显示一个配方列表"
		RESULTS += @"%TEXTTAG("L")%　每款霍姆克鲁斯的ABL上限的基础值都各不相同"
		RESULTS += @"%TEXTTAG("L")%　【】中则显示着调合所需的素材"
		RESULTS += @"%TEXTTAG("L")%　和所需调合类别的材料"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　┌────────────┐　配方的选择和调合相同"
		RESULTS += @"%TEXTTAG("L")%　│ [0]中和剂　　          │　右侧会出现四个按钮"
		RESULTS += @"%TEXTTAG("L")%　├────────────┤　其中的神器按钮"
		RESULTS += @"%TEXTTAG("L")%　│所需数　[  2]           │　无需填充，也可以完成霍姆克鲁斯的制造"
		RESULTS += @"%TEXTTAG("L")%　│选择数　[  0]           │　"
		RESULTS += @"%TEXTTAG("L")%　└────────────┘　"
		RESULTS += @"%TEXTTAG("L")%　□关于特性继承"
		RESULTS += @"%TEXTTAG("L")%　和调合相同，能继承素材的特性"
		RESULTS += @"%TEXTTAG("L")%　和调合不一样的是，无法选择继承的特性"
		RESULTS += @"%TEXTTAG("L")%　但也没有5个的继承上限。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□继承规则"
		RESULTS += @"%TEXTTAG("L")%　与调合类似，会发生抵消，但稍微复杂一些"
		RESULTS += @"%TEXTTAG("L")%　特质相同，等级不同时"
		RESULTS += @"%TEXTTAG("L")%　以最高等级优先，无视较低等级"
		RESULTS += @"%TEXTTAG("L")%　像淳朴和倔强这样互斥的特质组合且相同等级时，会相互抵消"
		RESULTS += @"%TEXTTAG("L")%　特质和ABL相同，但等级不同时，"
		RESULTS += @"%TEXTTAG("L")%　以高的一方优先，无视较低一方"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　另外，请注意制作霍姆克鲁斯时会度过一天的时间"
ENDSELECT
