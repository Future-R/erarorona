@HELP_NAME_4
RESULTS = 制造霍姆克鲁斯

@HELP_ABLE_制造霍姆克鲁斯
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN 0
RETURN 1

@HELP_制造霍姆克鲁斯, ARG
SELECTCASE ARG
	CASE 0
		RESULTS = □霍姆克鲁斯的制作流程
		RESULTS += @"%TEXTTAG("L")%　和调合一样，制作霍姆克鲁斯的时候会显示一个列表"
		RESULTS += @"%TEXTTAG("L")%　每款霍姆克鲁斯的ABL上限值都各不相同"
		RESULTS += @"%TEXTTAG("L")%　【】中则显示着制作所需的材料"
		RESULTS += @"%TEXTTAG("L")%　和所需调合类别的材料"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　┌────────────┐　レシピを選ぶと调合とおなじく"
		RESULTS += @"%TEXTTAG("L")%　│ [0]中和剤　　          │　右のようなボタンが４つ表示されます"
		RESULTS += @"%TEXTTAG("L")%　├────────────┤　これらのうちアーティファクトボタンは"
		RESULTS += @"%TEXTTAG("L")%　│必要数　[  2]           │　埋めなくてもホムンクルスを作成することができます"
		RESULTS += @"%TEXTTAG("L")%　│选择数　[  0]           │　"
		RESULTS += @"%TEXTTAG("L")%　└────────────┘　"
		RESULTS += @"%TEXTTAG("L")%　□特性の継承について"
		RESULTS += @"%TEXTTAG("L")%　调合と同様に素材の特性を引き継ぎますが"
		RESULTS += @"%TEXTTAG("L")%　调合と違い、引き継ぐ特性をを選ぶことができません"
		RESULTS += @"%TEXTTAG("L")%　また、5つの引き継ぎ上限もありません。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□継承ルール"
		RESULTS += @"%TEXTTAG("L")%　调合とおなじく相殺しますが调合よりやや複雑になっています"
		RESULTS += @"%TEXTTAG("L")%　同じ素質で等级が違うものがある場合は"
		RESULTS += @"%TEXTTAG("L")%　最高等级のものが優先され、下位のものは無視されます"
		RESULTS += @"%TEXTTAG("L")%　淳朴と倔强のような反発する素質がある場合は同等级の場合は相殺されます"
		RESULTS += @"%TEXTTAG("L")%　また素質とABLでは、同じもので等级が違う場合、"
		RESULTS += @"%TEXTTAG("L")%　高いほうが優先され、低い方は無視されます"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　なお、制造霍姆克鲁斯時に一日が経過するので注意してください"
ENDSELECT
