@HELP_NAME_5
RESULTS = フロントクエスト

@HELP_ABLE_フロントクエスト
SIF !GET_EVENT_ATTAIN("フロントクエスト")
	RETURN 0
RETURN 1

@HELP_PAGENUM_フロントクエスト
RETURN 2

@HELP_フロントクエスト, ARG
SELECTCASE ARG
	CASE 0
		RESULTS = □フロントクエストとは？
		RESULTS += @"%TEXTTAG("L")%　アーランド王国が国民達の要望をうけたり、国の必要に応じて冒険者達に対してだす依頼です。"
		RESULTS += @"%TEXTTAG("L")%　ロロナには素材を集めてくる【調達】と錬金術で物品を作る【调合】の依頼が出されます。"
		RESULTS += @"%TEXTTAG("L")%　依頼を达成することで王国から报酬が支払われる他、アトリエの評判が良くなります"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%□フロントクエストの受注 1"
		RESULTS += @"%TEXTTAG("L")%　┌[ 0]──────────┐┌[ 1]──────────┐%ADD_FTAG("┌[ 2]──────────┐", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　│调合　:ブランクシチュー ││調達　:フェスト         │%ADD_FTAG("│调合　:魔女の秘薬       │", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　│数量　:2                ││数量　:3                │%ADD_FTAG("│数量　:2                │", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　│所持数:0                ││所持数:1                │%ADD_FTAG("│所持数:2                │", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　│报酬　:281              ││报酬　:168              │%ADD_FTAG("│报酬　:809              │", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　│委托方:アーランド王国   ││委托方:アーランド王国   │%ADD_FTAG("│委托方:アーランド王国   │", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　└────────────┘└────────────┘%ADD_FTAG("└────────────┘", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　商店画面で[61] 王宮を選び、王宮に行き、"
		RESULTS += @"%TEXTTAG("L")%　[0] 依頼を受ける　を選ぶことで上記のような依頼の一覧が表示されます。"
		RESULTS += @"%TEXTTAG("L")%　要求内容のほかに現在要求されている物品の所持数なども表示されているので"
		RESULTS += @"%TEXTTAG("L")%　依頼を受ける際の目安にしてください。"
		RESULTS += @"%TEXTTAG("L")%　また、この際、篮子と箱子に入ってる物品で达成できる依頼は"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("緑字", COLOR("p-green"))%で表示されます。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　依頼を点击あるいは対応する番号を入力することで依頼を引き受けられます。"
		RESULTS += @"%TEXTTAG("L")%　依頼を受けた場合、依頼は受注済み依頼となり、依頼の一覧から消えます。"
		RESULTS += @"%TEXTTAG("L")%　依頼は通常、何日か経過すると消えてしまいますが、受注している場合"
		RESULTS += @"%TEXTTAG("L")%　消えずに残り続けるので、落ち着いてゆっくりと达成することができます。"
		RESULTS += @"%TEXTTAG("L")%　ただし、依頼を一度に引き受けられる上限が決まっており、"
		RESULTS += @"%TEXTTAG("L")%　その上限を超えて、依頼を引き受けておくことはできません。"
		RESULTS += @"%TEXTTAG("L")%　上限数は最初は5つですが、依頼をこなして、信用を得ることで"
		RESULTS += @"%TEXTTAG("L")%　徐々に数が増えていきます。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
	CASE 1
		RESULTS = □フロントクエストの受注 2
		RESULTS += @"%TEXTTAG("L")%　また、依頼を引き受ける際に依頼を达成出来るだけの物品がある場合、"
		RESULTS += @"%TEXTTAG("L")%　[2] すぐに報告する　のボタンが現れます。"
		RESULTS += @"%TEXTTAG("L")%　このボタンを押すことで、その場で渡す物品を選んで、依頼を达成できます。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　依頼を达成できない場合は、[2] 思いふけるのボタンが現れます。"
		RESULTS += @"%TEXTTAG("L")%　要求された物品を拾ったことがあるかどうか、"
		RESULTS += @"%TEXTTAG("L")%　调合したことがあるかどうか、また材料を持っているかどうか"
		RESULTS += @"%TEXTTAG("L")%　といった情報をロロナが教えてくれます"
		RESULTS += @"%TEXTTAG("L")%　選んだ素材を使用することが決まります"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□フロントクエストの報告"
		RESULTS += @"%TEXTTAG("L")%　依頼を報告することで报酬を受け取ることができます。"
		RESULTS += @"%TEXTTAG("L")%　報告するには[61] 王宮を選んだとあとに[1] 依頼を確認するを選んで"
		RESULTS += @"%TEXTTAG("L")%　現在引き受けている依頼の一覧を呼び出してください。"
		RESULTS += @"%TEXTTAG("L")%　基本的には受注時と同じ表示と同じ操作になりますが、"
		RESULTS += @"%TEXTTAG("L")%　確認画面ではすでに引き受けた依頼をキャンセルすることができます。"
		RESULTS += @"%TEXTTAG("L")%　依頼をキャンセルすることでまた別の依頼を引き受けられるようになりますが"
		RESULTS += @"%TEXTTAG("L")%　キャンセルした依頼は消えてしまい、"
		RESULTS += @"%TEXTTAG("L")%　選ぶことができなくなりますので注意してください。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
	CASE 2
		RESULTS = □任务检查窗口
		RESULTS += @"%TEXTTAG("L")%　┌[/] 奴隶  [*] 友人  [.] 请求  ──────┐"
		RESULTS += @"%TEXTTAG("L")%　│受注可能依頼                            │"
		RESULTS += @"%TEXTTAG("L")%　├────────────────────┤"
		RESULTS += @"%TEXTTAG("L")%　│　【调合】ブランクシチュー    [  0 /  2]│"
		RESULTS += @"%TEXTTAG("L")%　│　【调合】ミートパイ          [  0 /  4]│"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("│✿【调合】魔女の秘薬          [  2 /  2]│", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("│✿【調達】臭い石              [ 15 /  5]│", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("│✿【調達】ハチの巣            [ 20 /  5]│", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　│　【調達】フェスト            [  1 /  3]│"
		RESULTS += @"%TEXTTAG("L")%　%ADD_FTAG("│✿【調達】土かぶり            [ 22 /  3]│", COLOR("p-green"))%"
		RESULTS += @"%TEXTTAG("L")%　│                                        │"
		RESULTS += @"%TEXTTAG("L")%　└──────────[-] ◀ PAGE. 0 ▶ [+] ┘"
		RESULTS += @"%TEXTTAG("L")%　SHOP画面では右の情報確認ウィンドウで"
		RESULTS += @"%TEXTTAG("L")%　[.] REQ のボタンをおすことで"
		RESULTS += @"%TEXTTAG("L")%　上記のような依頼の確認ウィンドウを利用できます。"
		RESULTS += @"%TEXTTAG("L")%　確認ウィンドウで必要な物品と所持数と必要数が表示され、"
		RESULTS += @"%TEXTTAG("L")%　达成できる場合は%ADD_FTAG("✿", COLOR("p-green"))%と%ADD_FTAG("緑字", COLOR("p-green"))%で表示されます。"
		RESULTS += @"%TEXTTAG("L")%　また、[-]と[+]のボタンですでに受注している依頼の表示と切り替えることができます。"
		RESULTS += @"%TEXTTAG("L")%　ただし確認ウィンドウでは確認しかできず、"
		RESULTS += @"%TEXTTAG("L")%　実際の報告と受注は王宮にいかなければできませんので注意してください。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
ENDSELECT
