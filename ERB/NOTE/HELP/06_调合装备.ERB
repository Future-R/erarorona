@HELP_NAME_6
RESULTS = 调合装备

@HELP_ABLE_调合装备
SIF !GET_EVENT_ATTAIN("武器店的工作")
	RETURN 0
RETURN 1

@HELP_PAGENUM_调合装备
RETURN 0

@HELP_调合装备, ARG
SELECTCASE ARG
	CASE 0
		RESULTS = □关于装备
		RESULTS += @"%TEXTTAG("L")%　通常的角色可以通过提升ABL，影响调教行为中PALAM的获得量。"
		RESULTS += @"%TEXTTAG("L")%　但是，调教者萝乐娜无法提升ABL。"
		RESULTS += @"%TEXTTAG("L")%　作为补偿，萝乐娜可以通过装备武器和防具提升能力"
		RESULTS += @"%TEXTTAG("L")%　并且能获得装备主效果和特性的益处。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%□调合装备的流程"
		RESULTS += @"%TEXTTAG("L")%　┌──────────┬──┬───────────┬───────────┐"
		RESULTS += @"%TEXTTAG("L")%　│名称                │等级│素材A                 │素材B                 │"
		RESULTS += @"%TEXTTAG("L")%　├──────────┼──┼───────────┼───────────┤"
		RESULTS += @"%TEXTTAG("L")%　│学徒之杖            │   1│金属块                │                      │"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG("炼金术士之杖        ", COLOR("gray"))%│   2│%ADD_FTAG("亚铅矿                ", COLOR("gray"))%│%ADD_FTAG("干燥金属              ", COLOR("gray"))%│"
		RESULTS += @"%TEXTTAG("L")%　└──────────┴──┴───────────┴───────────┘"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　在主菜单选择[ 72] 男子汉武器店，"
		RESULTS += @"%TEXTTAG("L")%　通过选择[3] 订制装备 即可显示可制作装备的列表。"
		RESULTS += @"%TEXTTAG("L")%　其中，持有一个及以上素材A或素材B的装备可进行调合。"
		RESULTS += @"%TEXTTAG("L")%　另外，没有素材的话会以%ADD_FTAG("灰色", COLOR("gray"))%的形式显示。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　此时选择[3] 防具 可以切换至防具列表"
		RESULTS += @"%TEXTTAG("L")%　如果想要制作防具请按下按钮。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　选择想要制作的装备后将进入素材选择画面。"
		RESULTS += @"%TEXTTAG("L")%　制作完成的装备将继承素材的特性和品质。"
		RESULTS += @"%TEXTTAG("L")%　当然，具有有利特性且高品质的素材能制作出更好的装备。"
		RESULTS += @"%TEXTTAG("L")%　武器的材料是金属块，防具的材料是布"
		RESULTS += @"%TEXTTAG("L")%　建议在调合前先考虑好这些材料制作成装备后的效果"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　选择完素材后，将提示手续费的金额。"
		RESULTS += @"%TEXTTAG("L")%　素材价格和成品等级越高，手续费越高。"
		RESULTS += @"%TEXTTAG("L")%　支付完手续费后，调合装备完成，获得新的装备。"
ENDSELECT
