@HELP_NAME_7
RESULTS = 霍姆调合

@HELP_ABLE_霍姆调合
SIF !GET_EVENT_ATTAIN("霍姆们的工作")
	RETURN 0
RETURN 1

@HELP_PAGENUM_霍姆调合
RETURN 1

@HELP_霍姆调合, ARG
SELECTCASE ARG
	CASE 0
		RESULTS = □关于霍姆调合
		RESULTS += @"%TEXTTAG("L")%　可以拜托霍姆们进行调合。"
		RESULTS += @"%TEXTTAG("L")%　以这种方式获得调合制品需要时间，但不必使用素材。"
		RESULTS += @"%TEXTTAG("L")%　另外，在此期间也可以进行其他物品的调合或探索等行动。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%□霍姆调合的流程"
		RESULTS += @"%TEXTTAG("L")%　┌[10]─────────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│菌菇馅饼                                              │"
		RESULTS += @"%TEXTTAG("L")%　│数量　　:  9个             剩余天数:15 日             │"
		RESULTS += @"%TEXTTAG("L")%　│速度　　:%ADD_FTAG("★★★★　", COLOR("p-red"))%        品质　　:　　　　　        │"
		RESULTS += @"%TEXTTAG("L")%　│特性Lv　:　　　　　        特性数　:　　　　　        │"
		RESULTS += @"%TEXTTAG("L")%　└───────────────────────────┘"
		RESULTS += @"%TEXTTAG("L")%　┌[11]─────────────────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│EMPTY                                                 │"
		RESULTS += @"%TEXTTAG("L")%　│                                                      │"
		RESULTS += @"%TEXTTAG("L")%　│                                                      │"
		RESULTS += @"%TEXTTAG("L")%　│                                                      │"
		RESULTS += @"%TEXTTAG("L")%　└───────────────────────────┘"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　在主菜单选择[ 40] 给小霍姆指示 ，"
		RESULTS += @"%TEXTTAG("L")%　就会显示交给小霍姆的调合委托列表。"
		RESULTS += @"%TEXTTAG("L")%　选择其中处于EMPTY状态的按钮，就能进行新的委托。"
		RESULTS += @"%TEXTTAG("L")%　此时会显示萝乐娜至今调合过物品的列表"
		RESULTS += @"%TEXTTAG("L")%　请从中选择要调合的物品及其数量。"
		RESULTS += @"%TEXTTAG("L")%　此外，在霍姆调合中不需要拥有材料，也不会消耗材料。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　霍姆妹妹和霍姆弟弟各自最多可承接5项工作。"
		RESULTS += @"%TEXTTAG("L")%　霍姆们会按照从上到下的顺序执行这些工作。"
		RESULTS += @"%TEXTTAG("L")%　当剩余天数变为0时即可接收物品"
		RESULTS += @"%TEXTTAG("L")%　选择[8] 接受物品 来获得已经完成的物品。"
	CASE 1
		RESULTS = □特别订制
		RESULTS += @"%TEXTTAG("L")%　决定了要调合的物品之后"
		RESULTS += @"%TEXTTAG("L")%　可以通过消耗宝珠，在以下４种选择中进行特别订制。"
		RESULTS += @"%TEXTTAG("L")%　操作速度强化　:减少完成所需的天数。"
		RESULTS += @"%TEXTTAG("L")%　品质强化　　　:提升完成品的品质。"
		RESULTS += @"%TEXTTAG("L")%　特性等级强化  :提升完成品获得特性的等级。"
		RESULTS += @"%TEXTTAG("L")%　特性数增加　　:增加完成品的特性。"
		RESULTS += @"%TEXTTAG("L")%　┌───────────%"─" * 25%┐"
		RESULTS += @"%TEXTTAG("L")%　│所需天数　　　:15日   %" " * 50%│"
		RESULTS += @"%TEXTTAG("L")%　│操作速度强化　: %ADD_FTAG("★★★", COLOR("p-red"))%%" " * 50%│"
		RESULTS += @"%TEXTTAG("L")%　│[ 0] 快Ｃ之珠 :     0 %UNICODE(0x25AE) * 50%│"
		RESULTS += @"%TEXTTAG("L")%　│[ 1] 快Ｖ之珠 :     0 %UNICODE(0x25AE) * 35 + " " * 15%│"
		RESULTS += @"%TEXTTAG("L")%　│[ 2] 快Ａ之珠 :  7200 %ADD_FTAG(UNICODE(0x25AE) * 10, COLOR("p-green")) + UNICODE(0x25AE) * 20 + " " * 20%│"
		RESULTS += @"%TEXTTAG("L")%　│[ 3] 快Ｂ之珠 :  4200 %ADD_FTAG(UNICODE(0x25AE) * 5, COLOR("p-green")) + " " * 45%│"
		RESULTS += @"%TEXTTAG("L")%　└───────────%"─" * 25%┘"
		RESULTS += @"%TEXTTAG("L")%　每项订制只能使用规定的宝珠。"
		RESULTS += @"%TEXTTAG("L")%　效果由各宝珠的消耗量总和决定，并通过★的数量来显示大致的效果。"
		RESULTS += @"%TEXTTAG("L")%　通过选择[ 0] 快Ｃ之珠 等按钮可输入消耗量"
		RESULTS += @"%TEXTTAG("L")%　也可以点击按钮右侧的进度条来指定消耗量。"
		RESULTS += @"%TEXTTAG("L")%　此外这个进度条还会显示可使用的数量。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%□霍姆调合的取消"
		RESULTS += @"%TEXTTAG("L")%　在委托正在进行的时候，选择已经接受的委托的按钮"
		RESULTS += @"%TEXTTAG("L")%　即可取消对应的委托。"
		RESULTS += @"%TEXTTAG("L")%　取消的话，无论已经经过多少天，都无法接收物品"
		RESULTS += @"%TEXTTAG("L")%　但会返还特别订制时支付的宝珠。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%□交友值带来的强化"
		RESULTS += @"%TEXTTAG("L")%　无论有没有特别订制，只要和霍姆们的交友值足够高"
		RESULTS += @"%TEXTTAG("L")%　就能加快操作速度、提升物品的品质和特性。"
		RESULTS += @"%TEXTTAG("L")%　和霍姆们的交友值，可以通过调教，或者持续委托霍姆调合来进行提升。"
		RESULTS += @"%TEXTTAG("L")%　"
ENDSELECT
