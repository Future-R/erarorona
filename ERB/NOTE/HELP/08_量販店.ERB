@HELP_NAME_8
RESULTS = 量販店

@HELP_ABLE_量販店
SIF !GET_EVENT_ATTAIN("ティファナさんのお願い")
	RETURN 0
RETURN 1

@HELP_PAGENUM_量販店
RETURN 1

@HELP_量販店, ARG
SELECTCASE ARG
	CASE 0
		RESULTS = □量販店について
		RESULTS += @"%TEXTTAG("L")%　量販店とは、ロロナが调合したアイテムを。"
		RESULTS += @"%TEXTTAG("L")%　お店の人が量産して販売してくれるシステムです。"
		RESULTS += @"%TEXTTAG("L")%　□量販店の使い方"
		RESULTS += @"%TEXTTAG("L")%　量販店を利用するにはお店に入り、[2] アイテム登録を選びます。"
		RESULTS += @"%TEXTTAG("L")%　その後登録するアイテムを選択すれば完了です。"
		RESULTS += @"%TEXTTAG("L")%　選んだアイテムはなくなりますが、少し時間が経てば。"
		RESULTS += @"%TEXTTAG("L")%　登録したアイテムが販売されます。"
		RESULTS += @"%TEXTTAG("L")%　しかし、中には登録したくても、選択する際のリストに出てこないアイテムもあります。"
		RESULTS += @"%TEXTTAG("L")%　そういう時は他のお店を見てみましょう。"
		RESULTS += @"%TEXTTAG("L")%　登録できるアイテムはお店によって違うので、"
		RESULTS += @"%TEXTTAG("L")%　他のお店では取り扱ってもらえるかもしれません。"
		RESULTS += @"%TEXTTAG("L")%　ちなみにティファナさんのお店では薬品や雑貨などを取り扱ってもらえます。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　□取り扱い数について"
		RESULTS += @"%TEXTTAG("L")%　量販店に登録できるアイテム数には限りがあります。"
		RESULTS += @"%TEXTTAG("L")%　既に最大まで登録している場合、新しいアイテムを登録するには"
		RESULTS += @"%TEXTTAG("L")%　以前に登録したアイテムと入れ替えなくてはいけません。"
		RESULTS += @"%TEXTTAG("L")%　登録数はお店の人との交友值が高いほど増えるので"
		RESULTS += @"%TEXTTAG("L")%　交友值をあげておくと便利です。"
ENDSELECT
