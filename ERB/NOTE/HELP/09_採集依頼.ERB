@HELP_NAME_9
RESULTS = 采集委托

@HELP_ABLE_采集委托
SIF !GET_EVENT_ATTAIN("采集委托")
	RETURN 0
RETURN 1

@HELP_PAGENUM_采集委托
RETURN 1

@HELP_采集委托, ARG
SELECTCASE ARG
	CASE 0
		RESULTS = □关于采集委托
		RESULTS += @"%TEXTTAG("L")%　可以通过支付钱让一部分角色帮忙采集素材。"
		RESULTS += @"%TEXTTAG("L")%　虽然采集过程需要花费一定时间，"
		RESULTS += @"%TEXTTAG("L")%　但你可以在处理其他事务的同时收集素材。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%□采集委托的流程"
		RESULTS += @"%TEXTTAG("L")%　┌───────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG("亚兰德周边", COLOR("p-green"))%                    │"
		RESULTS += @"%TEXTTAG("L")%　│奥尔托加遗迹                  │"
		RESULTS += @"%TEXTTAG("L")%　│旧街道                        │"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　选择[80] 与库蝶莉娅会面 ，与同伴会合后"
		RESULTS += @"%TEXTTAG("L")%　选择[ 1] 请求采集 ，即可进行委托。"
		RESULTS += @"%TEXTTAG("L")%　采集地点与萝乐娜持有的地图相同"
		RESULTS += @"%TEXTTAG("L")%　上述地点的列表将会显示，请从中选择采集地点。"
		RESULTS += @"%TEXTTAG("L")%　┌───────────────┐"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG("风茄的根", COLOR("gray"))%                      │"
		RESULTS += @"%TEXTTAG("L")%　│蒸馏石                      │"
		RESULTS += @"%TEXTTAG("L")%　│%ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))%飞鹰的尾羽                  │"
		RESULTS += @"%TEXTTAG("L")%　另外，右侧栏位会显示地图包含的区域及可拾取的物品。"
		RESULTS += @"%TEXTTAG("L")%　其中以%ADD_FTAG("灰色", COLOR("gray"))%标注的物品无法采集。"
		RESULTS += @"%TEXTTAG("L")%　这些物品因等级较高、难度较大"
		RESULTS += @"%TEXTTAG("L")%　可能需要通过提升交友值才能获取。"
		RESULTS += @"%TEXTTAG("L")%　此外，每个角色都有擅长与不擅长的物品类型，"
		RESULTS += @"%TEXTTAG("L")%　交友值不变的情况下，如果是擅长的物品，即使难度较高也能采集，"
		RESULTS += @"%TEXTTAG("L")%　且采集到更多数量的概率更高。"
		RESULTS += @"%TEXTTAG("L")%　擅长的素材会以%ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))%的形式显示。"
		RESULTS += @"%TEXTTAG("L")%　选择完地点且足够支付委托费用的话，角色将出发采集。"
		RESULTS += @"%TEXTTAG("L")%　请注意，一旦出发采集，在返回前无法会面，"
		RESULTS += @"%TEXTTAG("L")%　也无法进行调教。"
	CASE 1
		RESULTS = □关于所需天数与委托费用
		RESULTS += @"%TEXTTAG("L")%地点距离越远，需要的天数越长，委托费用也越高。"
		RESULTS += @"%TEXTTAG("L")%此外，各个角色的委托费用是不同的，"
		RESULTS += @"%TEXTTAG("L")%即使天数相同，也有报价高的角色和低的角色。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□关于特殊素材"
		RESULTS += @"%TEXTTAG("L")%采集地点有时会埋藏着萝乐娜无法发现的素材。"
		RESULTS += @"%TEXTTAG("L")%若非擅长该素材的角色便无法采集这些素材"
		RESULTS += @"%TEXTTAG("L")%但若能成功采集将会非常有用，因此请向各位角色发出委托"
		RESULTS += @"%TEXTTAG("L")%务必尝试去发现它们吧。"
		RESULTS += @"%TEXTTAG("L")%"
		RESULTS += @"%TEXTTAG("L")%□特别订制"
		RESULTS += @"%TEXTTAG("L")%　在满足特定条件的情况下"
		RESULTS += @"%TEXTTAG("L")%　可以通过消耗JUEL，在以下５种选择中进行特别订制。"
		RESULTS += @"%TEXTTAG("L")%　采集数量增加　:增加采集到物品的数量。"
		RESULTS += @"%TEXTTAG("L")%　采集Lv强化　　　:根据拥有的交友值，增加可采集的物品。"
		RESULTS += @"%TEXTTAG("L")%　品质强化　　　:提升完成品的品质。"
		RESULTS += @"%TEXTTAG("L")%　特性等级强化  :提升完成品获得特性的等级。"
		RESULTS += @"%TEXTTAG("L")%　特性数增加　　:增加完成品的特性。"
		RESULTS += @"%TEXTTAG("L")%　┌───────────%"─" * 25%┐"
		RESULTS += @"%TEXTTAG("L")%　│采集数量增加　: %ADD_FTAG("★★★", COLOR("p-red"))%%" " * 50%│"
		RESULTS += @"%TEXTTAG("L")%　│[ 0] 快Ｃ之珠 :     0 %UNICODE(0x25AE) * 50%│"
		RESULTS += @"%TEXTTAG("L")%　│[ 1] 快Ｂ之珠 :     0 %UNICODE(0x25AE) * 35 + " " * 15%│"
		RESULTS += @"%TEXTTAG("L")%　└───────────%"─" * 25%┘"
		RESULTS += @"%TEXTTAG("L")%　每项订制只能使用规定的JUEL。"
		RESULTS += @"%TEXTTAG("L")%　效果由各JUEL的消耗量总和决定，并通过★的数量来显示大致的效果。"
		RESULTS += @"%TEXTTAG("L")%　通过选择[ 0] 快Ｃ之珠 等按钮可输入消耗量"
		RESULTS += @"%TEXTTAG("L")%　也可以点击按钮右侧的进度条来指定消耗量。"
		RESULTS += @"%TEXTTAG("L")%　此外这个进度条还会显示可使用的数量。"
		RESULTS += @"%TEXTTAG("L")%　"
		RESULTS += @"%TEXTTAG("L")%　"
ENDSELECT
