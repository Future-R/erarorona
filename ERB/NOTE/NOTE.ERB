@NOTE_MAIN
#DIM LINE
#LOCALSIZE 2
#LOCALSSIZE 2

#DIM TEMP
#DIMS TEMPS, 50
#DIM LAYER_Y
#DIM LAYER_X

#DIMS PAGE

#DIM SHOWNUM
#DIM L_SHOWNUM

#DIM L_PAGE
#DIM R_PAGE

#DIM L_MAXPAGE
#DIM R_MAXPAGE

#DIM L_LIST, 500
#DIM L_LISTNUM
#DIM L_MAXLISTNUM
#DIM L_PREVLISTNUM

LOCALS = 事件_成就_回想_帮助
LOCALS:1 = +_-_*_/

LINE = LINECOUNT
SHOWNUM = MAXLINE() - 3 - 2 - 4
L_SHOWNUM = SHOWNUM - 5

PAGE = 事件

L_PAGE = 0
L_LISTNUM = 0
L_PREVLISTNUM = 0

R_PAGE = 0
REDRAW 0
$START
CLEARLINE LINECOUNT - LINE

CALL INIT_LAYER

LAYER_Y = 0
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, "　笔　记", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2

;----------------------------------------------------
; 左侧列表
;----------------------------------------------------
VARSET L_LIST, -1
LOCAL:1 = 0

; 生成列表
SELECTCASE PAGE
	CASE "事件"
		FOR LOCAL, 1, 事件数
			SIF !GET_EVENT_PLAY(LOCAL)
				CONTINUE
			; 这里+事件更新日*10000用于排序，排序完之后会对10000取余，下面同理
			L_LIST:(LOCAL:1) = LOCAL + GET_EVENT_UPDATE(LOCAL) * 10000
			LOCAL:1++
		NEXT
		FOR LOCAL, 事件数 - 1, 0, -1
			SIF !GET_EVENT_ATTAIN(LOCAL)
				CONTINUE
			L_LIST:(LOCAL:1) = LOCAL + GET_EVENT_UPDATE(LOCAL) * 10000
			LOCAL:1++
		NEXT
		; 按事件更新日从新到旧排序
		; 排序结束后把辅助用的位数删掉
		ARRAYSORT L_LIST, BACK, 0, LOCAL:1
		LOCAL = 0
		FOR LOCAL, 0, LOCAL:1
			L_LIST:LOCAL %= 10000
		NEXT
	CASE "成就"
		FOR LOCAL, 0, 成就数
			SIF !GET_RECORD_ATTAIN(LOCAL) && !GET_RECORD_ABLE(LOCAL)
				CONTINUE
			L_LIST:(LOCAL:1) = LOCAL
			LOCAL:1++
		NEXT
	CASE "帮助"
		FOR LOCAL, 0, 帮助数
			TRYCCALLFORM HELP_ABLE_%GET_NAME("帮助", LOCAL)%
				SIF !RESULT
					CONTINUE
				L_LIST:(LOCAL:1) = LOCAL
				LOCAL:1++
			CATCH
			ENDCATCH
		NEXT
	CASE "回想"
		FOR LOCAL, 0, 事件数
			TRYCCALLFORM EVENT_REPLAY_{LOCAL}
				SIF !RESULT
					CONTINUE
				SIF !GET_EVENT_UPDATE(LOCAL)
					CONTINUE
				L_LIST:(LOCAL:1) = LOCAL
				LOCAL:1++
			CATCH
			ENDCATCH
		NEXT
ENDSELECT

L_MAXLISTNUM = LOCAL:1 - 1
L_PAGE = L_LISTNUM / L_SHOWNUM
L_MAXPAGE = L_MAXLISTNUM / L_SHOWNUM

CALL LAYER_SET, ADD_BTAG(@"┌%"─" * 15%┐", "点击_8"), LAYER_Y + 3
LAYER_Y = LAYER_Y + 4
FOR LOCAL, 0, L_SHOWNUM
	TEMP = L_LIST:(LOCAL + L_PAGE * L_SHOWNUM)
	TEMPS '= ADD_BTAG("│", "点击_4")
	IF TEMP == -1
		TEMPS += " " * 30
	ELSE
		SELECTCASE PAGE
			CASE "事件"
				TEMPS += \@ GET_EVENT_ATTAIN(TEMP) ? %ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))% # 　\@
			CASE "成就"
				TEMPS += \@ GET_RECORD_ATTAIN(TEMP) ? %ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))% # 　\@
			CASEELSE
				TEMPS += "　"
		ENDSELECT
		TEMPS += ADD_FTAG(ADD_BTAG(FORMCELL(GET_NAME(PAGE, TEMP), 28, "LEFT"), @"页码_{LOCAL + L_PAGE * L_SHOWNUM}"), TEMP == L_LIST:L_LISTNUM ? COLOR("p-green") # COLOR("DEF"))
	ENDIF
	TEMPS += ADD_BTAG("│", "点击_6")
	CALL LAYER_SET, TEMPS, LAYER_Y + LOCAL
NEXT
CALL LAYER_SET, ADD_BTAG(@"└%"─" * 10%页码 [{L_PAGE}/{L_MAXPAGE}]┘", "点击_2"), LAYER_Y + LOCAL
CALL LAYER_SET, @"┌%"─" * 15%┐", LAYER_Y + LOCAL + 1
CALL LAYER_SET, "│" + " " * 13 + ADD_BTAG("[ 8]", "点击_8") + " " * 13 + "│", LAYER_Y + LOCAL + 2
CALL LAYER_SET, "│" + " " * 9 + ADD_BTAG("[ 4]", "点击_4") + " " * 4 + ADD_BTAG("[ 6]", "点击_6") + " " * 9 + "│", LAYER_Y + LOCAL + 3
CALL LAYER_SET, "│" + " " * 13 + ADD_BTAG("[ 2]", "点击_2") + " " * 13 + "│", LAYER_Y + LOCAL + 4
CALL LAYER_SET, @"└%"─" * 15%┘", LAYER_Y + LOCAL + 5

;--------------------------------------------------
; 右侧页面
;--------------------------------------------------
VARSET TEMPS
SELECTCASE PAGE
	CASE "事件"
		CALLFORM EVENT_NOTE_{L_LIST:L_LISTNUM}
		SPLIT RESULTS, "/", TEMPS
		ARRAYSHIFT TEMPS, 1, "", 0
		SIF GET_EVENT_UPDATE(L_LIST:L_LISTNUM)
			ARRAYSHIFT TEMPS, 1, SHOW_DAY(GET_EVENT_UPDATE(L_LIST:L_LISTNUM)), 0
		ARRAYSHIFT TEMPS, 1, GET_NAME("事件", L_LIST:L_LISTNUM), 0
	CASE "成就"
		TEMPS = %GET_NAME("成就", L_LIST:L_LISTNUM)%
		LOCAL = 0
		TEMP = 1
		WHILE AUTO_SPLIT(GET_RECORD_ATTAIN_EXPLAIN(L_LIST:L_LISTNUM), "_", LOCAL) != ""
			TEMPS:TEMP = \@LOCAL == 0 ? 条件: # %"　　"% \@%AUTO_SPLIT(GET_RECORD_ATTAIN_EXPLAIN(L_LIST:L_LISTNUM), "_", LOCAL)%
			TEMP++
			LOCAL++
		WEND
		LOCAL = 0
		TEMPS:TEMP = 报酬:{GET_RECORD_PRICE(L_LIST:L_LISTNUM)}公会点数
		TEMP++
		WHILE AUTO_SPLIT(GET_RECORD_BENEFIT_EXPLAIN(L_LIST:L_LISTNUM), "_", LOCAL) != ""
			TEMPS:TEMP =\@LOCAL == 0 ? 特典: # %"　　"%\@%AUTO_SPLIT(GET_RECORD_BENEFIT_EXPLAIN(L_LIST:L_LISTNUM), "_", LOCAL)%
			TEMP++
			LOCAL++
		WEND
	CASE "帮助"
		TEMPS = %GET_NAME("帮助", L_LIST:L_LISTNUM)%
		TRYCCALLFORM HELP_PAGENUM_%TEMPS%
			R_MAXPAGE = RESULT
		CATCH
			R_MAXPAGE = 0
		ENDCATCH
		CALLFORM HELP_%TEMPS%, R_PAGE
		SPLIT RESULTS, TEXTTAG("L"), TEMPS
		ARRAYSHIFT TEMPS, 1, GET_NAME("帮助", L_LIST:L_LISTNUM), 0
	CASE "回想"
		TEMPS = 点击序号观看回想（开发中）：
		CALLFORM EVENT_REPLAY_{L_LIST:L_LISTNUM}
		FOR COUNT, 1, RESULT+1
			TEMPS:COUNT '= @"=={COUNT}=="
		NEXT
ENDSELECT
CALL LAYER_SET, ADD_BTAG("┌" + TEMPS + " " * (STRLENS(TEMPS) % 2) + "─" * (44 - STRLENS(TEMPS) / 2) + "┐", "点击_3"), LAYER_Y - 1
IF PAGE == "回想"
	FOR LOCAL, 0, SHOWNUM
		CALL LAYER_SET, "│" + ADD_BTAG(HTML_TAGADDFORM(TEMPS:(LOCAL + 1), 88 - STRCOUNT(TEMPS:(LOCAL + 1), UNICODE(0x273F)), "LEFT"), @"回想_{LOCAL+1}") + "│", LAYER_Y + LOCAL
	NEXT
ELSE
	FOR LOCAL, 0, SHOWNUM
		CALL LAYER_SET, "│" + ADD_BTAG(HTML_TAGADDFORM(TEMPS:(LOCAL + 1), 88 - STRCOUNT(TEMPS:(LOCAL + 1), UNICODE(0x273F)), "LEFT"), "点击_3") + "│", LAYER_Y + LOCAL
	NEXT
ENDIF

IF R_MAXPAGE
	CALL LAYER_SET, "└" + "─" * 33 + ADD_BTAG(" [1] " + UNICODE(0x25C0), "点击_1") + @" 页码[{R_PAGE}/{R_MAXPAGE}] " + ADD_BTAG(UNICODE(0x25B6) + " [3]", "点击_3") + "┘", LAYER_Y + LOCAL
ELSE
	CALL LAYER_SET, ADD_BTAG("└" + "─" * 44 + "┘", "点击_3"), LAYER_Y + LOCAL
ENDIF
;--------------------------------------------------
; 页面下方
;--------------------------------------------------;
LAYER_Y = LAYER_Y + LOCAL + 1
CALL LAYER_DRAWLINE, LAYER_Y
TEMPS = 
FOR LOCAL, 0, 4
	IF LOCAL
		TEMPS += " " * 12
	ELSE
		TEMPS += "　"
	ENDIF
	TEMPS += ADD_FTAG(ADD_BTAG(@"[ %AUTO_SPLIT(LOCALS:1, "_", LOCAL)%] %AUTO_SPLIT(LOCALS, "_", LOCAL), 8, LEFT%", "点击_" + AUTO_SPLIT(LOCALS:1, "_", LOCAL)), PAGE == AUTO_SPLIT(LOCALS, "_", LOCAL) ? COLOR("p-green") # COLOR("DEF"))
NEXT
CALL LAYER_SET, TEMPS, LAYER_Y + 1
CALL LAYER_SET, ADD_BTAG("　[ 9] 返回", "点击_9"), LAYER_Y + 2
CALL LAYER_PRINT, , MAXLINE()
ONEINPUTS
SIF AUTO_SPLIT(RESULTS, "_", 0) == "点击"
	RESULTS '= AUTO_SPLIT(RESULTS, "_", 1)
SIF AUTO_SPLIT(RESULTS, "_", 0) == "回想"
	RESULTS '= @"1%AUTO_SPLIT(RESULTS, "_", 1)%"
SELECTCASE AUTO_SPLIT(RESULTS, "_", 0)
	CASE "8"
		SIF --L_LISTNUM < 0
			L_LISTNUM = L_MAXLISTNUM
	CASE "2"
		SIF ++L_LISTNUM > L_MAXLISTNUM
			L_LISTNUM = 0
	CASE "4"
		IF L_PAGE == 0
			L_LISTNUM = L_MAXLISTNUM
		ELSE
			L_LISTNUM  = MAX(L_LISTNUM - L_SHOWNUM, 0)
		ENDIF
	CASE "6"
		IF L_PAGE == L_MAXPAGE
			L_LISTNUM = 0
		ELSE
			L_LISTNUM  = MIN(L_LISTNUM + L_SHOWNUM, L_MAXLISTNUM)
		ENDIF
	CASE "1"
		SIF --R_PAGE < 0
			R_PAGE = R_MAXPAGE
	CASE "3"
		SIF ++R_PAGE > R_MAXPAGE
			R_PAGE = 0
	CASE "9"
		REDRAW 1
		RETURN 0
	CASE "+", "-", "*", "/"
		PAGE = %AUTO_SPLIT(LOCALS, "_", AUTO_SPLIT_NUM(LOCALS:1, "_", AUTO_SPLIT(RESULTS, "_", 0)))%
		L_PAGE = 0
		L_LISTNUM = 0
		R_PAGE = 0
	CASE "页码"
		L_LISTNUM = AUTO_SPLIT_INT(RESULTS, "_", 1)
	CASE "11","12","13","14","15","16","17","18","19"
		CALL 播放回想, L_LIST:L_LISTNUM, TOINT(RESULTS) - 10
		GOTO START
ENDSELECT
SIF L_PREVLISTNUM != L_LISTNUM
	R_PAGE = 0
L_PREVLISTNUM = L_LISTNUM
GOTO START

; ARG为ID ARG:1为分支
@播放回想, ARG, ARG:1
#DIM 原REDRAW
TFLAG:回想模式 = 1
原REDRAW = CURRENTREDRAW()
REDRAW 0
TFLAG:回想分支 = ARG:1
TFLAG:原本DAY = DAY
TFLAG:原本MONEY = MONEY

DAY = 1
CALL EVENT_ACT, ARG

; 恢复
REDRAW 原REDRAW
TFLAG:回想分支 = 0
DAY = TFLAG:原本DAY
MONEY = TFLAG:原本MONEY
TFLAG:回想模式 = 0
CALL BGM, "萝乐娜的工房.mp3"