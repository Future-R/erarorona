;-------------------------------------------------------------------------------
;	10進数エンコード		: 複数投げた数值をまとめて巨大な数值に変える
;-------------------------------------------------------------------------------
;		XXX XXX XXX XXX XXX XXX
;		ARG = XXXの数(この場合6)	ARG:1 = XXXの桁(この場合3)
;		注：ARGとARG:1を適切に指定しないとすぐオーバーフローします
;
;	例	ENC_DECIMAL(8,2, 11,22,33,44,55,66,77,88) == 8877665544332211
;		ENC_DECIMAL(6,3, 444,555,666,777,888,999) == 999888777666555444
;		ENC_DECIMAL(4,1, 5,6,7,8)				  == 8765
;===============================================================================
;	ARG, ARG:1 = 上記	ARG:2～ARG:9 = まとめる值
@ENC_DECIMAL(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5, ARG:6, ARG:7, ARG:8, ARG:9)
#FUNCTION
#DIM LCOUNT,1
#LOCALSIZE 3
VARSET LOCAL
LOCAL = POWER(10,ARG:1)
FOR LCOUNT, 0, ARG
	LOCAL:1 = LCOUNT == 0 ? ARG:2 # ARG:(2 + LCOUNT) * POWER(LOCAL,LCOUNT)
	LOCAL:2 += LOCAL:1
NEXT
RETURNF LOCAL:2


;-------------------------------------------------------------------------------
;	10進数デコード			: 巨大な数值から指定通りの值を拾い上げる
;-------------------------------------------------------------------------------
;		XX XX XX XX
;		ARG = 元值	ARG:1 =右からいくつ目(BITのように一番下の桁=0)
;		ARG:2 = XXの桁(この場合2)
;	例	LOCAL = 88664422
;		DEC_DECIMAL(LOCAL,1,2) == 44
;===============================================================================
;	ARG = 元值	ARG:1 = いくつ目	ARG:2 = 10進数で何桁か
@DEC_DECIMAL(ARG, ARG:1, ARG:2 = 2)
#FUNCTION
#DIM LCOUNT,1
#LOCALSIZE 5
VARSET LOCAL
LOCAL = POWER(10,ARG:2)
RETURNF ARG:1 == 0 ? ( ARG % LOCAL ) # ( ARG % POWER(LOCAL, ARG:1 + 1) / POWER(LOCAL, ARG:1) )


;-------------------------------------------------------------------------------
;	128進数エンコード		: 投げた数值に対してキーに文字列を返す
;-------------------------------------------------------------------------------
;	例	%ENC_PASSCODE(21785)% == いろは	
;		※16384(128^2 * 1:"い") + 5376(128 * 42:"ろ") + 25:"は" == 21785
;
;	ARG:1で桁数を指定、3ならああいのように頭に0を補う。字数は位置特定につかうので
;	二文字以上をまとめてつかうんなら桁数を指定したほうがいいです
;===============================================================================
@ENC_PASSCODE(ARG, ARG:1)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
VARSET LOCALS
; 大きすぎる場合はストップ
SIF ARG > 0xFFFFFFFFFFFFFF
	RETURNF "ERROR!"
; 何文字(128進数で何桁)必要なのか算出
FOR LOCAL, 0, 9
	SIF ARG < POWER(128,LOCAL)
		BREAK
NEXT
LOCAL -= 1
DO
	; 0の場合の挙動だけ特殊 基本一つ上の桁で余り算して一つ下の桁で割る
	LOCALS += ENC_PASSCODE_MAIN( LOCAL == 0 ? 0 # ( ARG % POWER(128, LOCAL) / POWER(128, LOCAL - 1) ) )
	LOCAL -= 1
LOOP LOCAL > 0
SIF STRLENSU(LOCALS) < ARG:1
	LOCALS = %ENC_PASSCODE_MAIN(0) * (ARG:1 - STRLENSU(LOCALS))%%LOCALS%
RETURNF LOCALS

;-------------------------------------------------------------------------------
;	128進数複数エンコード		: 複数の変数をまとめてから文字列にして返す
;-------------------------------------------------------------------------------
;	例	%ENC_PLURAL(1_4/3_5/1_2)% == む
;		 これは0~3までで4つの值がある変数と、5つの值がある変数と、2つのの值がある変数の3つが
;		　それぞれ1と3と1であるという事を示している
;		※1 * 1 + 3 * 4 + 1 * 4 * 5 = 1 + 12 + 20 = 33
;        ENC_PASSCODE(33) = む
;
;	ARG:1は桁数
;===============================================================================
@ENC_PLURAL, ARGS, ARG:1
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 20
#DIMS TEMPS, 2
#DIM TEMP, 2
#DIM 结果
TEMP = 0
TEMP:1 = 1
SPLIT ARGS, "/", LOCALS
FOR LOCAL, 0, RESULT
	SPLIT LOCALS:LOCAL, "_", TEMPS
	TEMP += TOINT(TEMPS) * TEMP:1
	TEMP:1 *= TOINT(TEMPS:1)
NEXT
RETURNF ENC_PASSCODE(TEMP, ARG:1)
;-------------------------------------------------------------------------------
;	128進数デコード			: 投げた文字列に対する数值をキーから返す
;-------------------------------------------------------------------------------
;	例	DEC_PASSCODE("にほへ") == 347804
;===============================================================================
@DEC_PASSCODE(ARGS)
#FUNCTION
#LOCALSIZE 3
VARSET LOCAL
; 文字列何文字？
LOCAL:1 = STRLENSU(ARGS)
FOR LOCAL:2, 0, LOCAL:1
	; DEC_PASSCODE_MAINで拾ってきた数 * (128 ^ 文字列数) を 積み上げる
	LOCAL += DEC_PASSCODE_MAIN(SUBSTRINGU(ARGS, LOCAL:2, 1)) * POWER(128,(LOCAL:1 - LOCAL:2 - 1))
NEXT
RETURNF LOCAL

;-------------------------------------------------------------------------------
;	128進数複数デコード		: 文字列を複数の変数にして返す
;-------------------------------------------------------------------------------
;	例	CALL DEC_PLURAL("む", "4/5/2")
;		RESULT = 1 RESULT:1 = 3 RESULT:2 = 1
;		要するに同デコードの要素数を文字列で指定すれば同じようにして返してくれる
;===============================================================================

@DEC_PLURAL, ARGS, ARGS:1
#LOCALSSIZE 20
VARSET RESULT, 0, 1, 21
LOCAL = DEC_PASSCODE(ARGS)
SPLIT ARGS:1, "/", LOCALS
FOR LOCAL:1, 0, RESULT
	RESULT:(LOCAL:1 + 1) = LOCAL % TOINT(LOCALS:(LOCAL:1))
	LOCAL /= TOINT(LOCALS:(LOCAL:1))
NEXT
ARRAYREMOVE RESULT, 0, 1
RETURN RESULT 
;-------------------------------------------------------------------------------
;	エンコードのメイン処理	: 投げた数值はどのキーか？ (FORで回すのでシンプルに)
;===============================================================================
@ENC_PASSCODE_MAIN(ARG)
#FUNCTIONS
RETURNF SUBSTRINGU(KEY_PASSCODE(), ARG, 1)

;-------------------------------------------------------------------------------
;	デコードのメイン処理	: 投げた文字はキーの何番目か？ (FORで回すのでシンプルに)
;===============================================================================
@DEC_PASSCODE_MAIN(ARGS)
#FUNCTION
RETURNF STRFINDU(KEY_PASSCODE(), ARGS)

;-------------------------------------------------------------------------------
;	128進数のキー
;引数省略		 	キーコードを返す
;引数が0以上		引数でRANDOMIZEしてキーコードをシャッフルする
;引数が-2			キーコードを初期化する
;
;暗号化が必要ないなら下記のコメントアウトされているものを使うと良い
;これで角色の名前をENCODETOUNIなどして暗号化した場合、これで角色クターごとに
;全く見た目が別の文字列が吐き出されるようになる
;暗号が複雑である必要性はないが、出来上がるパスコードが角色ごとに同じ文字列が目立ってしまう
;といった事が起きる場合は利用することで、ごまかすことができる
;===============================================================================
@KEY_PASSCODE, ARG = -1
#FUNCTIONS
IF ARG == -1
	RETURNF LOCALS
ELSE
	LOCALS = オロＫａｆムくこｘｖひす６ウｄｙえｃむキはチヌケＥＣＭホサネＱナふハりＦフヤも５ｔらＬＤｗノうヲメ４しやヘれソ７つにほおＨそへ８ｎ９ｋをヒなｊｅヨＶｏｂセさよＺ１とアコ０トＮカあＲＴＡｑたテＳスいるＵｓニかリシきめミＧｐイｕラＩワけルｚＪんねクゆレわ３Ｘみ
	IF ARG >= 0
		;RAND固定
		RANDOMIZE ARG
		;100回シャッフル
		FOR LOCAL, 0, 100
			LOCAL:1 = RAND(1, 128)
			LOCALS = %SUBSTRING(LOCALS, LOCAL:1)%%SUBSTRING(LOCALS, 0, LOCAL:1)%
		NEXT
		;RAND復帰
		RANDOMIZE GETMILLISECOND()
	ENDIF
	RETURNF LOCALS
ENDIF
;@KEY_PASSCODE
;#FUNCTIONS
;RETURNF "オロＫａｆムくこｘｖひす６ウｄｙえｃむキはチヌケＥＣＭホサネＱナふハりＦフヤも５ｔらＬＤｗノうヲメ４しやヘれソ７つにほおＨそへ８ｎ９ｋをヒなｊｅヨＶｏｂセさよＺ１とアコ０トＮカあＲＴＡｑたテＳスいるＵｓニかリシきめミＧｐイｕラＩワけルｚＪんねクゆレわ３Ｘみ"
;-------------------------------------------------------------------------------
;	境界指定用のキー
;	モちＹろの　ツぬエｍン　てまＰＢｌ　マせｉユｒ
;	Ｗ２Ｏｇタ　ｈ
;	上記26文字は通常のキーとして使用されていないのでこれを使う
;===============================================================================
@SEPARATOR_PASSCODE, ARGS
#FUNCTIONS
LOCALS = モちＹろのツぬエｍンてまＰＢｌマせｉユｒＷ２Ｏｇタｈ
SELECTCASE ARGS
	CASE "VERSION"
		LOCAL = 0
	CASE "NAME"
		LOCAL = 1
	CASE "BASE"
		LOCAL = 2
	CASE "ABL"
		LOCAL = 3
	CASE "TALENT"
		LOCAL = 4
	CASE "MARK"
		LOCAL = 5
	CASE "EXP"
		LOCAL = 6
	CASE "CFLAG"
		LOCAL = 7
	CASE "FEATURE"
		LOCAL = 8
	CASE "异常经验"
		LOCAL = 9
	CASE "KEY"
		LOCAL = 10
ENDSELECT
RETURNF SUBSTRINGU(LOCALS, LOCAL ,1)

