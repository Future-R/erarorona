#LOCALSIZE 1
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("特性", ARGS)
ENDIF
RETURNF PROPERTY_KNOWN:LOCAL

