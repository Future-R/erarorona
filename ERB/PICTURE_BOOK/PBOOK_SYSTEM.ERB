;@GET_EFFECT_ITEM			主效果の既知情報の取得関数
;---------------------------------------------------------------------
;@SET_KNOWN_ITEM
;アイテムの既知情報の設定関数
;ARGS:1	対象となるアイテム番号
;ARGS:1	設定する既知情報の名前
;---------------------------------------------------------------------
@SET_KNOWN_ITEM, ARGS, ARGS:1
#LOCALSIZE 1
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("物品", ARGS)
ENDIF
SETBIT ITEM_KNOWN:LOCAL, AUTO_SPLIT_NUM("获得/主效果00/主效果01/主效果02/主效果10/主效果11/主效果12/主效果20/主效果21/主效果22/主效果30/主效果31/主效果32", "/", ARGS:1)

;---------------------------------------------------------------------
;@GET_KNOWN_ITEM
;アイテムの既知情報の取得関数
;ARGS	対象となるアイテム番号
;ARGS:1	取得する既知情報の名前
;---------------------------------------------------------------------
@GET_KNOWN_ITEM, ARGS, ARGS:1
#FUNCTION
#LOCALSIZE 1
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("物品", ARGS)
ENDIF
RETURNF GETBIT(ITEM_KNOWN:LOCAL, AUTO_SPLIT_NUM("获得/主效果00/主效果01/主效果02/主效果10/主效果11/主效果12/主效果20/主效果21/主效果22/主效果30/主效果31/主效果32", "/", ARGS:1))

; 更新物品最高分
; ARGS 物品编号
; ARG 分数
@SET_HIGHEST_SCORE_ITEM, ARGS, ARG
#LOCALSIZE 1
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("物品", ARGS)
ENDIF
ITEM_HIGHESTSCORE:LOCAL = ITEM_HIGHESTSCORE:LOCAL < ARG ? ARG # ITEM_HIGHESTSCORE:LOCAL

;---------------------------------------------------------------------
;GET_CREATED_MIX_NUM
;调合済みアイテムの数量取得関数
;---------------------------------------------------------------------
@GET_CREATED_MIX_NUM
#FUNCTION
RETURNF (1600 - 501) - MATCH(ITEM_KNOWN, 0, 501, 1600)

;---------------------------------------------------------------------
; 统计认识的角色数量(不含奴隶)
;---------------------------------------------------------------------
@GET_FRIEND_NUM
#FUNCTION
#DIM character_num
VARSET character_num
FOR LOCAL, 0, CHARANUM
	SIF CFLAG:LOCAL:认识
		character_num++
NEXT
RETURNF character_num

;---------------------------------------------------------------------
; 统计亲密的角色数量(不含奴隶)
;---------------------------------------------------------------------
@GET_INTIMATE_NUM
#FUNCTION
#DIM character_num
VARSET character_num
FOR LOCAL, 0, CHARANUM
	IF CFLAG:LOCAL:可以调教
		character_num++
	ENDIF
NEXT
RETURNF character_num

;---------------------------------------------------------------------
;@SET_PROPERTY_ITEM
;特性の既知情報の設定関数
;ARGS:1	対象となるアイテム番号
;ARGS:1	設定する既知情報の名前
;---------------------------------------------------------------------
@SET_KNOWN_PROPERTY, ARGS, ARGS:1 = "SET"
#LOCALSIZE 1
SIF ARGS == ""
	RETURN 0
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
ELSE
	LOCAL = GET_NO("特性", ARGS)
ENDIF
PROPERTY_KNOWN:LOCAL = ARGS:1 == "SET" ? 1 # 0
