@RECORD_NAME_TALENT, ARG
#DIMS CONST NAMES = "攻略", "猎人", "杀手"
#DIM L_LV
#DIM L_TALENT
L_TALENT = ((ARG - RECORD_TALENT_START) - (ARG - RECORD_TALENT_START) % 3) / 3
L_LV = (ARG - RECORD_TALENT_START) % 3
SIF TALENTNAME:L_TALENT == ""
	RETURN 0
RESULTS = %TALENTNAME:L_TALENT + NAMES:L_LV%
RETURN 1

@RECORD_ABLE_TALENT, ARG
#FUNCTION
SELECTCASE (ARG - RECORD_TALENT_START) % 3
	CASE 0
		RECORD_ABLE = 1
	CASE 1, 2
		RECORD_ABLE = GET_RECORD_ATTAIN(ARG - 1) > 0
ENDSELECT


@RECORD_PRICE_TALENT, ARG
#FUNCTION
#DIM L_LV
#DIM L_TALENT
#DIM CONST L_PLUS = 0, 5, 10, 20
#DIM CONST L_MINUS = 0, -10, -30, -50
L_TALENT = ((ARG - RECORD_TALENT_START) - (ARG - RECORD_TALENT_START) % 3) / 3
L_LV = (ARG - RECORD_TALENT_START) % 3 + 1
RECORD_PRICE = GET_TALENT_COST(L_TALENT, L_LV)
IF RECORD_PRICE >= 0
	RECORD_PRICE *= L_PLUS:L_LV
ELSE
	RECORD_PRICE *= L_MINUS:L_LV
ENDIF
RETURNF RECORD_PRICE

@RECORD_ATTAIN_EXPLAIN_TALENT, ARG
#FUNCTIONS
RECORD_ATTAIN_EXPLAIN = [%TALENTNAME:(((ARG - RECORD_TALENT_START) - (ARG - RECORD_TALENT_START) % 3) / 3)% Lv{(ARG - RECORD_TALENT_START) % 3 + 1}]を持った角色クターの能力を十分に育てる。

@RECORD_BENEFIT_EXPLAIN_TALENT, ARG
#FUNCTIONS
RECORD_BENEFIT_EXPLAIN = [%TALENTNAME:(((ARG - RECORD_TALENT_START) - (ARG - RECORD_TALENT_START) % 3) / 3)%]を持った角色クターとの相性が良くなる。
