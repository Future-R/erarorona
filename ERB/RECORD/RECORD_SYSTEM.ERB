@RECORD_NAME, ARG
RESULTS = 
SELECTCASE ARG
	CASE RECORD_TALENT_START TO RECORD_TALENT_END
		CALLFORM RECORD_NAME_TALENT, ARG
	CASEELSE
		TRYCCALLFORM RECORD_NAME_{ARG}
		CATCH
		ENDCATCH
ENDSELECT

@GET_RECORD_ATTAIN, ARGS
#FUNCTION
IF ISNUMERIC(ARGS)
	RETURNF RECORD_ATTAIN:TOINT(ARGS)
ELSE
	RETURNF RECORD_ATTAIN:GET_NO("记录", ARGS)
ENDIF

@SET_RECORD_ATTAIN, ARGS, ARG
IF ISNUMERIC(ARGS)
	RECORD_ATTAIN:TOINT(ARGS) = ARG
ELSE
	RECORD_ATTAIN:GET_NO("记录", ARGS) = ARG
ENDIF

@GET_RECORD_ABLE, ARGS
#FUNCTION
#LOCALSIZE 1
RECORD_ABLE = 0
IF ISNUMERIC(ARGS)
	LOCAL = TOINT(ARGS)
	SIF STRCOUNT(GET_NAME("记录", LOCAL), "名称不在")
		RETURNF 0
ELSE
	LOCAL = GET_NO("记录", ARGS)
ENDIF
SELECTCASE LOCAL
	CASE RECORD_TALENT_START TO RECORD_TALENT_END
		SIF LOCAL >= RECORD_TALENT_START + 180 * 3
			RETURNF 0
		SIF !GET_RECORD_PRICE(LOCAL)
			RETURNF 0
		CALLFORMF RECORD_ABLE_TALENT, LOCAL
	CASEELSE
		CALLFORMF RECORD_ABLE_{LOCAL}
ENDSELECT
RETURNF RECORD_ABLE

