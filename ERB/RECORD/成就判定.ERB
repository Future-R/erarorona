@确保成就名称已刷新
SIF STRCOUNT(GET_NAME("成就", 176), "名称不在") || STRCOUNT(GET_NAME("成就", 184), "名称不在")
	CALL MAKE_NOLIST
RETURN

@检查馅饼成就
#LOCALSIZE 2
#DIM TEMP
CALL 确保成就名称已刷新
SIF FLAG:回想模式
	RETURN 0
FOR LOCAL, 0, 3
	TEMP = LOCAL + 176
	SIF GET_RECORD_ATTAIN(TEMP)
		CONTINUE
	SIF FLAG:调教中使用馅饼次数 < AUTO_SPLIT_INT("1_10_100", "_", LOCAL)
		BREAK
	CALL SET_RECORD_ATTAIN, TEMP, 1
	CALL MESSAGE_WINDOW, "", @"在调教中使用了{AUTO_SPLIT_INT("1_10_100", "_", LOCAL)}次馅饼，/达成了【%GET_NAME("成就", TEMP)%】！"
NEXT

@检查连锁成就
#LOCALSIZE 2
#DIM TEMP
CALL 确保成就名称已刷新
SIF FLAG:回想模式
	RETURN 0
VARSET LOCAL
LOCAL:1 = GET_STRFLAG_ELEMENTNUM("TSTR:连锁判定")
PRINTW DEBUG
FOR LOCAL, 0, 3
	TEMP = LOCAL + 179
	SIF GET_RECORD_ATTAIN(TEMP)
		CONTINUE
	SIF LOCAL:1 < AUTO_SPLIT_INT("5_10_20", "_", LOCAL)
		BREAK
	CALL SET_RECORD_ATTAIN, TEMP, 1
	CALL MESSAGE_WINDOW, "", @"在调教中达成了{AUTO_SPLIT_INT("5_10_20", "_", LOCAL)}连锁，/达成了【%GET_NAME("成就", TEMP)%】！"
NEXT

@检查委托报酬成就
#LOCALSIZE 2
#DIM TEMP
CALL 确保成就名称已刷新
SIF FLAG:回想模式
	RETURN 0
FOR LOCAL, 0, 3
	TEMP = LOCAL + 182
	SIF GET_RECORD_ATTAIN(TEMP)
		CONTINUE
	SIF FLAG:累计报酬额 < AUTO_SPLIT_INT("1000_5000_20000", "_", LOCAL)
		BREAK
	CALL SET_RECORD_ATTAIN, TEMP, 1
	CALL MESSAGE_WINDOW, "", @"从柜台委托中获得了累计{AUTO_SPLIT_INT("1000_5000_20000", "_", LOCAL)}克尔，/达成了【%GET_NAME("成就", TEMP)%】！"
NEXT
