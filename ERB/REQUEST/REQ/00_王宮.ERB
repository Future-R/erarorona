@REQ_NAME_0
RESULTS = 王宮

@REQ_OWNER_0
RESULTS = エスティ

@REQ_MESSAGE_0, ARGS
SELECTCASE ARGS
	CASE "挨拶"
		RESULTS = こんにちは。/今日はどんなご用かしら？
	CASE "受注開始"
		RESULTS = 今出ている仕事はこんな感じね/ぱぱっと終わらせてくれると助かるわ/それじゃあどの仕事をしてくれるのかしら？
	CASE "確認開始"
		RESULTS = お仕事、順調に進んでるかしら？/焦らないでいいから、よろしくお願いね
	CASE "受注"
		RESULTS = それじゃお願いするわね。/しっかり頼んだわよ。
	CASE "达成_悪"
		RESULTS = うーん…これじゃあちょっとね…/申し訳ないけど少し报酬は減らさせてもらうわね/でもこれに懲りずに頑張って/
		IF NICKNAME:MASTER == "萝乐娜"
			RESULTS += "ロロナちゃんなら"
		ELSE
			RESULTS += "あなたなら"
		ENDIF
		RESULTS += "頑張れば、きっといい仕事ができると思うから"
	CASE "达成_並"
		RESULTS = お疲れ様。/はい、これが报酬よ
	CASE "达成_良"
		RESULTS = 素晴らしい仕事ね。/がんばったから、ご褒美に报酬を増やしておくわ/次もこの調子でがんばってね
	CASE "达成_最高"
		RESULTS = 完璧な仕事ね。/これだけがんばったなら、ご褒美を出さないとね/报酬を大幅に増やしておくわ/次もこの調子でよろしく頼むわね
	CASE "依頼切れ"
		RESULTS = ごめんなさい。/今は
		IF NICKNAME:MASTER == "萝乐娜"
			RESULTS += "ロロナちゃんに"
		ELSE
			RESULTS += "あなたに"
		ENDIF
		RESULTS += "頼めそうなお仕事がないのよ"
	CASE "依頼数オーバー"
		RESULTS = ちょっと欲張りすぎじゃないかしら？/無理しないで、今受けている依頼を/終わらせてからにした方がいいわよ
	CASE "放弃确认"
		RESULTS = あら、残念ね。/このお仕事をキャンセルでいいの？
	CASE "依頼放棄"
		RESULTS = 分かったわ。/でも後で断るくらいなら、/最初から引き受けない方がいいわよ。/次からは気をつけてね。
	CASE "時間切れ"
		RESULTS = この前お願いしたお仕事なんだけど/期限が大分過ぎちゃったから/キャンセルさせてもらったわ/今さら言っても仕方ないけど、/引き受けた以上はきちんとやらなきゃダメよ
	CASE "更换"
		RESULTS = 他にも何かあるかしら？
	;お仕事、順調に進んでるかしら？/焦らないでいいから、よろしくお願いね
ENDSELECT

