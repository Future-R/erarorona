@REQ_NAME_0
RESULTS = 王宫

@REQ_OWNER_0
RESULTS = 艾丝缇

@REQ_MESSAGE_0, ARGS
SELECTCASE ARGS
	CASE "问候"
		RESULTS = 你好。/今天有什么事吗？
	CASE "开始接受"
		RESULTS = 这些是现在可以做的工作/你能尽快完成就太好了/你想要做哪一份工作？
	CASE "确认开始"
		RESULTS = 工作进展得顺利吗？/别太着急，慢慢来吧。
	CASE "接受"
		RESULTS = 那就拜托你了。/全靠你啦。
	CASE "达成_差"
		RESULTS = 嗯……这样的话就有点……/不好意思，报酬得稍微减少一些了呢。/但不要因此气馁，继续努力吧。/
		IF NICKNAME:MASTER == "萝乐娜"
			RESULTS += "如果是萝乐娜的话，"
		ELSE
			RESULTS += "如果是你的话，"
		ENDIF
		RESULTS += "只要努力就一定能做好工作的，我相信你。"
	CASE "达成_中"
		RESULTS = 辛苦了。/好的，这是任务报酬。
	CASE "达成_良"
		RESULTS = 工作完成的很棒呢。/因为你完成的很努力呢，所以作为奖励，给你更多的报酬。/下次也要像这样努力哦！
	CASE "达成_最佳"
		RESULTS = 工作完美地完成了呢。/既然你这么努力，不奖励可不行。/这次的报酬会大幅增加，/下次也请保持这样的状态，继续加油吧。
	CASE "委托清空"
		RESULTS = 抱歉。/目前没有可以委托给
		IF NICKNAME:MASTER == "萝乐娜"
			RESULTS += "萝乐娜"
		ELSE
			RESULTS += "你"
		ENDIF
		RESULTS += "的工作哦。"
	CASE "委托数溢出"
		RESULTS = 是不是有点太贪心了呢？/别勉强自己，/先完成手头的委托，再考虑新的吧。
	CASE "放弃确认"
		RESULTS = 哎呀，真遗憾。/你打算要取消这份工作吗？
	CASE "放弃委托"
		RESULTS = 明白了。/但是与其之后再拒绝，/还是一开始就不接受比较好。/下次要注意哦。
	CASE "时间用尽"
		RESULTS = 之前委托给你的工作，/因为超过期限太长时间，/现在已经取消了，请你理解。/现在再说这些也没用了，/既然接下了工作，不好好完成可不行哦。
	CASE "更换"
		RESULTS = 还有其他什么事吗？
	;工作进展得顺利吗？/别太着急，慢慢来吧。
ENDSELECT

