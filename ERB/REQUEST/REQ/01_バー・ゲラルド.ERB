@REQ_NAME_1
RESULTS = 酒場

@REQ_OWNER_1
RESULTS = ゲラルド

@REQ_MESSAGE_1, ARGS
SELECTCASE ARGS
	CASE "挨拶"
		RESULTS = いらっしゃい。/仕事を受けに来たのか？
	CASE "受注開始"
		RESULTS = 今出ている仕事はこんな感じだ。
	CASE "確認開始"
		RESULTS = どの依頼についての確認だ？
	CASE "受注"
		RESULTS = それじゃ、頼んだぞ。
	CASE "達成_悪"
		RESULTS = …少し仕事が雑なんじゃないか？/これじゃ報酬を全額やるわけにはいかんな
	CASE "達成_並"
		RESULTS = ご苦労だったな。/これが今回の報酬だ。
	CASE "達成_良"
		RESULTS = 見事な仕事だな。/これなら依頼人も満足するだろう。/報酬も多めに出しておくぞ
	CASE "達成_最高"
		RESULTS = すごいな、完璧な仕事じゃないか。/これは報酬も大幅に増やさないと/釣り合わないな
	CASE "依頼切れ"
		RESULTS = すまない。/今は
		RESULTS += "頼めそうな仕事がなくてな"
	CASE "依頼数オーバー"
		RESULTS = さすがに、それ以上引き受けるのは無理だろう。/今の依頼を終わらせてからにした方がいい
	CASE "放棄確認"
		RESULTS = ふむ…この依頼をキャンセルでいいんだな？
	CASE "依頼放棄"
		RESULTS = …何か事情があるのかもしれんが、/一度引き受けたものを途中で投げ出すのは感心しないな
	CASE "時間切れ"
		RESULTS = …この間頼んだ依頼だがな、/期限が大分過ぎてしまったんで、/キャンセル扱いにさせてもらったぞ
		RESULTS:1 = 引き受けた仕事は、/責任をもって終わらせてもらえんと困るんだがな…
	CASE "変更"
		RESULTS = 他にも何かあるか？
	;お仕事、順調に進んでるかしら？/焦らないでいいから、よろしくお願いね
ENDSELECT

