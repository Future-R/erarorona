@REQ_NAME_1
RESULTS = 酒馆

@REQ_OWNER_1
RESULTS = 葛哈

@REQ_MESSAGE_1, ARGS
SELECTCASE ARGS
	CASE "问候"
		RESULTS = 欢迎光临。/是来接工作的吗？
	CASE "开始接受"
		RESULTS = 目前发布的工作大概是这样的。
	CASE "确认开始"
		RESULTS = 想要查看哪份委托呢？
	CASE "接受"
		RESULTS = 那就拜托你了。
	CASE "达成_差"
		RESULTS = ……你的工作是不是有点马虎了？/这样可没法全额支付报酬啊。
	CASE "达成_中"
		RESULTS = 辛苦了。/这是这次的报酬。
	CASE "达成_良"
		RESULTS = 干得真不错。/这样一来，委托人应该会很满意。/报酬也多给你一些吧。
	CASE "达成_最佳"
		RESULTS = 厉害呀，完美地完成了工作。/不给你大幅提升报酬的话，/可配不上那份成果啊。
	CASE "委托清空"
		RESULTS = 抱歉啊。/现在
		RESULTS += "没有可以安排的工作了。"
	CASE "委托数溢出"
		RESULTS = 再怎么说，继续承接工作未免太勉强了。/还是先完成现有的委托比较好。
	CASE "放弃确认"
		RESULTS = 嗯……你确定要取消这项委托吗？
	CASE "放弃委托"
		RESULTS = ……虽然你可能有苦衷，/但中途放弃已经接下的委托，实在让人难以认同啊。
	CASE "时间用尽"
		RESULTS = ……之前安排给你的委托，/因为已经严重超出期限，/就按取消处理了。
		RESULTS:1 = 既然已经接下了工作，/就得负起责任完成，别让人失望啊……
	CASE "更换"
		RESULTS = 还有其他事吗？
	;お仕事、順調に進んでるかしら？/焦らないでいいから、よろしくお願いね
ENDSELECT

