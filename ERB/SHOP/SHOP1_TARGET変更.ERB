@SHOPCOMNAME_1
RESULTS = 更换调教对象

@SHOPCOMABLE_1
#LOCALSIZE 1
RESULTS = 更换调教对象
IF IS_USEABLE_ATELIER()
	FOR LOCAL, 0, CHARANUM
		SIF IS_TARGETABLE(LOCAL)
			RETURN 1
	NEXT
	RETURN -1
ELSE
	RETURN 0
ENDIF

@SHOPCOM_1, ARG
CALL SHOW_CHARALIST, "更换调教对象"
SIF RESULT == 1000
	RETURN 0
CALL SET_TARGET, RESULT

@SET_TARGET, ARG
TARGET = ARG
SIF TARGET == ASSI
	ASSI = -1

@IS_TARGETABLE, ARG
#FUNCTION
SIF ARG == -1
	RETURNF 0
SIF ARG == MASTER && HAVE_ITEM("化身魔镜")
	RETURNF 1
SIF CFLAG:ARG:人类 && !CFLAG:ARG:可以调教 && !FLAG:DEBUG
	RETURNF 0
SIF CFLAG:ARG:采集地点 >= 0
	RETURNF 0
SIF !IS_EXIST_HERE(ARG)
	RETURNF 0
RETURNF 1

