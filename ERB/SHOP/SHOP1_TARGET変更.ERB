@SHOPCOMNAME_1
RESULTS = 更换调教对象

@SHOPCOMABLE_1
#LOCALSIZE 1
RESULTS = 更换调教对象
IF IS_USEABLE_ATELIER()
	FOR LOCAL, 0, CHARANUM
		SIF IS_TARGETABLE(LOCAL)
			RETURN 1
	NEXT
	RETURN -1
ELSE
	RETURN 0
ENDIF

@SHOPCOM_1, ARG
CALL SHOW_CHARALIST, "更换调教对象"
SIF RESULT == 1000
	RETURN 0
CALL SET_TARGET, RESULT

@SET_TARGET, ARG
IF 习惯特质是否禁用男性交互(ARG)
	CALL MESSAGE_WINDOW, "", @"因为【厌男症】，萝乐娜抗拒与%CALLNAME:ARG%的亲密接触。"
	RETURN 0
ENDIF
TARGET = ARG
SIF TARGET == ASSI
	ASSI = -1
RETURN 1

@IS_TARGETABLE, ARG
#FUNCTION
SIF ARG == -1
	RETURNF 0
SIF ARG == MASTER && HAVE_ITEM("化身魔镜")
	RETURNF 1
SIF 习惯特质是否禁用男性交互(ARG)
	RETURNF 0
SIF CFLAG:ARG:人类 && !CFLAG:ARG:可以调教 && !FLAG:DEBUG
	RETURNF 0
SIF CFLAG:ARG:采集地点 >= 0
	RETURNF 0
SIF !IS_EXIST_HERE(ARG)
	RETURNF 0
RETURNF 1

