@SHOPCOMNAME_1
RESULTS = 調教対象変更

@SHOPCOMABLE_1
#LOCALSIZE 1
RESULTS = 調教対象変更
IF IS_USEABLE_ATELIER()
	FOR LOCAL, 0, CHARANUM
		SIF IS_TARGETABLE(LOCAL)
			RETURN 1
	NEXT
	RETURN -1
ELSE
	RETURN 0
ENDIF

@SHOPCOM_1, ARG
CALL SHOW_CHARALIST, "調教対象変更"
SIF RESULT == 1000
	RETURN 0
CALL SET_TARGET, RESULT

@SET_TARGET, ARG
TARGET = ARG
SIF TARGET == ASSI
	ASSI = -1

@IS_TARGETABLE, ARG
#FUNCTION
SIF ARG == MASTER
	RETURNF 0
SIF CFLAG:ARG:人間 && !CFLAG:ARG:調教可能 && !FLAG:DEBUG
	RETURNF 0
SIF CFLAG:ARG:採集場所 >= 0
	RETURNF 0
SIF !IS_EXIST_HERE(ARG)
	RETURNF 0
RETURNF 1

