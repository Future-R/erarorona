@SHOPCOMNAME_40
RESULTS = 给小霍姆指示

@SHOPCOMABLE_40
#LOCALSIZE 3
SIF !IS_USEABLE_ATELIER()
	RETURN 0
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN -1
;受け取れる時は表示色を変える
FOR LOCAL:1, 0, 2
	FOR LOCAL, 0, 5
		SIF !GET_HOMU_MIX_PROPERTY("物品ID", LOCAL:1, LOCAL)
			CONTINUE
		SIF GET_HOMU_MIX_PROPERTY("所需天数", LOCAL:1, LOCAL) > 0
			CONTINUE
		RETURN 3
	NEXT
NEXT
RETURN 1

@SHOPCOM_40, ARG
#LOCALSIZE 4
#DIM LAYER_X
#DIM LAYER_Y
#DIM LINE
#DIM L_ITEM
#DIM L_WORKING, 2
#DIM TEMP, 2
#DIMS TEMPS, 4
#DIMS SELECT_ABLE = "0_1_9"
#DIMS CONST 加成名称 = "速度加成", "品质加成", "特性等级加成", "特性数加成"
REDRAW 0
CALL BGM, "炼金少年少女.mp3"
$START
VARSET L_WORKING
SELECT_ABLE '= "0_1_9"
CALL LAYER_INIT
LAYER_X = 0
LAYER_Y = 0
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　%SHOW_DAY()%%"", 8%%"-" + "给小霍姆指示" + "-", 54, LEFT%" + GET_ITEM_STORAGE_TEXT(), LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2

IF GET_EVENT_ATTAIN("霍姆们的工作")
	CALL LAYER_SET, FORMCELL("　  给霍姆妹妹的委托", MAXWIDTH() / 2 - 4, "LEFT") + "　给霍姆弟弟的委托" , LAYER_Y + 3
	FOR LOCAL, 0, 2
		FOR LOCAL:1, 0, 5
			TEMP = LOCAL * 10 + LOCAL:1 + 10
			L_ITEM = LOCAL * 10 + LOCAL:1
			SELECT_ABLE += "_" + TOSTR(TEMP)
			LAYER_Y = 4 + LOCAL:1 * 6
			LAYER_X = (MAXWIDTH() / 2 - 3) * LOCAL
			IF GET_HOMU_MIX_PROPERTY("物品ID", LOCAL, LOCAL:1) > 0
				L_WORKING:LOCAL = 1
				VARSET TEMPS
				FOR LOCAL:3, 0, 4
					FOR LOCAL:2, 0, 5
						IF GET_HOMU_MIX_PROPERTY(加成名称:(LOCAL:3), LOCAL, LOCAL:1) >= LOCAL:2 * 200 + 100
							TEMPS:(LOCAL:3) += ADD_FTAG("★", GET_HOMU_MIX_PROPERTY(加成名称:(LOCAL:3), LOCAL, LOCAL:1) >= (LOCAL:2 + 1) * 200 ? COLOR("p-red") # COLOR("DEF"))
						ELSE
							TEMPS:(LOCAL:3) += "　"
						ENDIF
					NEXT
				NEXT
				CALL LAYER_SET, ADD_BTAG("┌" + @"[{TEMP, 2}]" + "─" * 25 + "┐", TEMP, TEMP), LAYER_Y, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + FORMCELL(GET_NAME("物品", GET_HOMU_MIX_PROPERTY("物品ID", LOCAL, LOCAL:1)) , 54, "LEFT") + "│", TEMP), LAYER_Y + 1, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + FORMCELL("数量　　:" + @"{GET_HOMU_MIX_PROPERTY("调合数量", LOCAL, LOCAL:1), 3}个", 27, "LEFT") + FORMCELL("剩余天数:" + @"{GET_HOMU_MIX_PROPERTY("所需天数", LOCAL, LOCAL:1), 3}天", 27, "LEFT") + "│", TEMP), LAYER_Y + 2, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + HTML_TAGADDFORM("速度　　:" + TEMPS:0, 27, "LEFT") + HTML_TAGADDFORM("品质　　:" + TEMPS:1, 27, "LEFT")  + "│", TEMP), LAYER_Y + 3, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + HTML_TAGADDFORM("特性Lv　:" + TEMPS:2, 27, "LEFT") + HTML_TAGADDFORM("特性数　:" + TEMPS:3, 27, "LEFT")  + "│", TEMP), LAYER_Y + 4, LAYER_X
				CALL LAYER_SET, ADD_BTAG("└" + "─" * 27 + "┘", TEMP), LAYER_Y + 5, LAYER_X
			ELSE
				CALL LAYER_SET, ADD_BTAG("┌" + @"[{TEMP, 2}]" + "─" * 25 + "┐", TEMP, TEMP), LAYER_Y, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + FORMCELL("EMPTY", 54, "LEFT") + "│", TEMP) , LAYER_Y + 1, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + FORMCELL("", 54, "LEFT") + "│", TEMP), LAYER_Y + 2, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + FORMCELL("", 54, "LEFT") + "│", TEMP), LAYER_Y + 3, LAYER_X
				CALL LAYER_SET, ADD_BTAG("│" + FORMCELL("", 54, "LEFT") + "│", TEMP), LAYER_Y + 4, LAYER_X
				CALL LAYER_SET, ADD_BTAG("└" + "─" * 27 + "┘", TEMP), LAYER_Y + 5, LAYER_X
			ENDIF
		NEXT
	NEXT
ENDIF
LAYER_Y = MAXLINE() - 7
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, "┌" + "─" * 57 + "┐", LAYER_Y + 1
CALL LAYER_SET, "│" + ADD_BTAG(FORMCELL("[0] 与霍姆妹妹交谈", 57, "LEFT"), 0) + ADD_BTAG(FORMCELL("[1] 与霍姆弟弟交谈", 57, "LEFT"), 1) + "│", LAYER_Y + 2
IF GET_EVENT_ATTAIN("邀请练习")
	CALL LAYER_SET, "│" + ADD_BTAG(FORMCELL("[2] 向霍姆妹妹求欢", 57, "LEFT"), 2) + ADD_BTAG(FORMCELL("[3] 向霍姆弟弟求欢", 57, "LEFT"), 3) + "│", LAYER_Y + 3
	SELECT_ABLE += "_2_3"
ELSE
	CALL LAYER_SET, "│" + FORMCELL("", 114, "LEFT") + "│", LAYER_Y + 3
ENDIF

IF GET_EVENT_ATTAIN("霍姆们的工作")
	TEMP = 0
	FOR LOCAL:1, 0, 2
		FOR LOCAL, 0, 5
			SIF !GET_HOMU_MIX_PROPERTY("物品ID", LOCAL:1, LOCAL)
				CONTINUE
			SIF GET_HOMU_MIX_PROPERTY("所需天数", LOCAL:1, LOCAL) > 0
				CONTINUE
			TEMP = 1
			SELECT_ABLE += "_8"
			BREAK
		NEXT
		SIF TEMP
			BREAK
	NEXT
	CALL LAYER_SET, "│" + ADD_FTAG(ADD_BTAG(FORMCELL("[8] 接收物品", 114, "LEFT"), 8), TEMP ? COLOR("YELLOW") # COLOR("gray")) + "│", LAYER_Y + 4
ELSE
	CALL LAYER_SET, "│" + " " * 114 + "│", LAYER_Y + 4
ENDIF
CALL LAYER_SET, "│" + ADD_BTAG(FORMCELL("[9] 返回", 114, "LEFT"), 9) + "│", LAYER_Y + 5
CALL LAYER_SET, "└" + "─" * 57 + "┘", LAYER_Y + 6
CALL LAYER_PRINT, , MAXLINE()
CALL INPUT_SPLIT, SELECT_ABLE, "_"
CLEARLINE 6 + 1
SELECTCASE RESULT
	CASE 0
		IF L_WORKING
			CALL MESSAGE_WINDOW, "霍姆妹妹", "霍姆很高兴能够工作。"
		ELSE
			CALL MESSAGE_WINDOW, "霍姆妹妹", "主人，霍姆想工作。"

			CALL MESSAGE_WINDOW, "萝乐娜", "（就算这么说，我也并不清楚该如何指示……/"
			IF GET_CREATED_MIX_NUM() < 20
				CALL MESSAGE_WINDOW, "萝乐娜", "　或许调合了足够多的物品，/　就知道该如何给霍姆下指令了吧。）", "/", "重复使用/使用按钮"
			ELSEIF FLAG:公会等阶 < 2
				CALL MESSAGE_WINDOW, "萝乐娜", "　或许努力提升公会等级，/　就能学到差遣霍姆的方法？）", "/", "重复使用/使用按钮"
			ELSE
				CALL MESSAGE_WINDOW, "萝乐娜", "　或许还需要等待时机……）", "/", "重复使用/使用按钮"
			ENDIF
		ENDIF
		GOTO START
	CASE 1
		IF L_WORKING
			CALL MESSAGE_WINDOW, "霍姆弟弟", "正在进行委托中的调合。"
		ELSE
			CALL MESSAGE_WINDOW, "霍姆弟弟", "主人，霍姆想工作。"

			CALL MESSAGE_WINDOW, "萝乐娜", "（就算这么说，我也并不清楚该如何指示……/"
			IF GET_CREATED_MIX_NUM() < 20
				CALL MESSAGE_WINDOW, "萝乐娜", "　或许调合了足够多的物品，/　就知道该如何给霍姆下指令了吧。）", "/", "重复使用/使用按钮"
			ELSEIF FLAG:公会等阶 < 2
				CALL MESSAGE_WINDOW, "萝乐娜", "　或许努力提升公会等级，/　就能学到差遣霍姆的方法？）", "/", "重复使用/使用按钮"
			ELSE
				CALL MESSAGE_WINDOW, "萝乐娜", "　或许还需要等待时机……）", "/", "重复使用/使用按钮"
			ENDIF
		ENDIF
		GOTO START
	CASE 2
		CALL MESSAGE_WINDOW, "霍姆妹妹", "明白了。/请按照您的想法给出指示。主人。"
		CFLAG:GET_CNUM("霍姆妹妹"):可以调教 = 1
		CALL SET_TARGET, GET_CNUM("霍姆妹妹")
		FLAG:SHOP指令 = GET_NO("SHOP", "调教")
		CALLFORM SHOPCOM_{FLAG:SHOP指令}
		RETURN 1
	CASE 3
		CALL MESSAGE_WINDOW, "霍姆弟弟", "明白了。/请按照您的想法给出指示。主人。"
		CFLAG:GET_CNUM("霍姆弟弟"):可以调教 = 1
		CALL SET_TARGET, GET_CNUM("霍姆弟弟")
		FLAG:SHOP指令 = GET_NO("SHOP", "调教")
		CALLFORM SHOPCOM_{FLAG:SHOP指令}
		RETURN 1
	CASE 8
		CALL GET_HOMU_MIX
	CASE 9
		RETURN 0
	CASEELSE
		TEMP = (RESULT - 10) / 10
		TEMP:1 = (RESULT - 10) % 10
		IF GET_HOMU_MIX_PROPERTY("物品ID", TEMP, TEMP:1)
			CALL INPUT_YN_M, @"%GET_NAME("物品", GET_HOMU_MIX_PROPERTY("物品ID", TEMP, TEMP:1))%的调合要取消吗？"
			IF !RESULT
				FOR LOCAL, 0, 100
					JUEL:(TEMP ? GET_CNUM("霍姆弟弟") # GET_CNUM("霍姆妹妹")):LOCAL += USE_JUEL:TEMP:(TEMP:1):LOCAL
				NEXT
				FOR LOCAL:1, TEMP:1, 4
					SIF !HOMU_MIX_PROPERTY:TEMP:(LOCAL:1):0
						BREAK
					FOR LOCAL, 0, 8
						HOMU_MIX_PROPERTY:TEMP:(LOCAL:1):LOCAL = HOMU_MIX_PROPERTY:TEMP:(LOCAL:1 + 1):LOCAL
					NEXT
					FOR LOCAL, 0, 100
						USE_JUEL:TEMP:(LOCAL:1):LOCAL = USE_JUEL:TEMP:(LOCAL:1 + 1):LOCAL
					NEXT
				NEXT
				FOR LOCAL, 0, 8
					HOMU_MIX_PROPERTY:TEMP:4:LOCAL = 0
				NEXT
				FOR LOCAL, 0, 100
					USE_JUEL:TEMP:4:LOCAL = 0
				NEXT
			ENDIF
		ELSE
			CALL INPUT_YN_M, @"要委托霍姆\@ !TEMP ? 妹妹 # 弟弟\@调合吗？"
			;前詰めを省くためにここでやっておく
			FOR LOCAL, 0, 5
				SIF GET_HOMU_MIX_PROPERTY("物品ID", TEMP, LOCAL)
					CONTINUE
				TEMP:1 = LOCAL
				BREAK
			NEXT
			SIF !RESULT
				CALL HOMU_MIX_SELECT, TEMP, TEMP:1
		ENDIF
ENDSELECT
GOTO START
