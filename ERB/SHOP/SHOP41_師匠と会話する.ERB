@SHOPCOMNAME_41
RESULTS = 与师傅交谈

@SHOPCOMABLE_41
SIF FLAG:当前地点 == GET_NO("地点", "亚兰德") || IS_TARGETABLE(GET_CNUM("亚斯特丽德"))
	RETURN 1
RETURN 0

@SHOPCOM_41, ARG
REDRAW 0
$START
CALL LAYER_INIT
CALL LAYER_DRAWLINE, 0
CALL LAYER_SET, @"　%SHOW_DAY()%%"", 8%%"-" + "与亚斯特丽德交谈" + "-", 54, LEFT%篮子空间 [{GET_ITEM_TOTAL("篮子"), 3} / {BASKET_SIZE()}] 箱子空间 [{GET_ITEM_TOTAL("箱子"), 4} / 1000]", 1
CALL LAYER_DRAWLINE, 2

SELECTCASE FLAG:当前地点
	CASE GET_NO("地点", "亚兰德")
		CALL LAYER_SET, GET_IMAGE("萝乐娜的工房", 3100, 1), 3
	CASE GET_NO("地点", "阿拉尼亚村")
		CALL LAYER_SET, GET_IMAGE("阿拉尼亚村的工房", 3100, 1), 3
ENDSELECT

CALL LAYER_DRAWLINE, MAXLINE() - 7
CALL LAYER_SET, "┌" + "─" * (MAXWIDTH() / 2 - 2) + "┐",  MAXLINE() - 6
CALL LAYER_SET, "│" + ADD_BTAG(FORMCELL("[0] 交谈", MAXWIDTH() - 4, "LEFT"), 0) + "│",  MAXLINE() - 5
IF GET_EVENT_ATTAIN("邀请练习")
	CALL LAYER_SET, "│" + ADD_BTAG(FORMCELL("[1] 寻求肉体关系", MAXWIDTH() - 4, "LEFT"), 1) + "│",  MAXLINE() - 4
ELSE
	CALL LAYER_SET, "│" + FORMCELL("", MAXWIDTH() - 4, "LEFT") + "│",  MAXLINE() - 4
ENDIF
CALL LAYER_SET, "│" + FORMCELL("", MAXWIDTH() - 4, "LEFT") + "│",  MAXLINE() - 3
CALL LAYER_SET, "│" + ADD_BTAG(FORMCELL("[9] 返回", MAXWIDTH() - 4, "LEFT"), 9) + "│",  MAXLINE() - 2
CALL LAYER_SET, "└" + "─" * (MAXWIDTH() / 2 - 2) + "┘",  MAXLINE() - 1
CALL LAYER_PRINT, , MAXLINE()
ONEINPUT
CLEARLINE 7
SELECTCASE RESULT
	CASE 0
		SELECTCASE RAND:3
				CASE 0
					CALL MESSAGE_WINDOW, "亚斯特丽德", "哈啊～…好困啊……/要不要睡个午觉呢……"
				CASE 1
					CALL MESSAGE_WINDOW, "亚斯特丽德", "是你啊，萝乐娜，/你没事做的话帮我泡杯茶吧，/顺便再拿点心过来。"
				CASE 2
					CALL MESSAGE_WINDOW, "亚斯特丽德", "唔唔……做什么啊，萝乐娜？/你想陪我睡觉吗？"
			ENDSELECT
		IF TALENT:MASTER:噗尼噗尼苗床
			CALL MESSAGE_WINDOW, "亚斯特丽德", "咦？没想到我不在的时候你玩得这么大啊？"
			CALL MESSAGE_WINDOW, "萝乐娜", "别开玩笑了师傅，您神通广大能不能帮我取出来啊～"
			CALL MESSAGE_WINDOW, "亚斯特丽德", "既然爱徒都快哭出来了，我也不好不出手了呢～"
			CALL MESSAGE_WINDOW, "", "………/……/…"
			CALL MESSAGE_WINDOW, "", "获得了富含魔力的噗尼噗尼珠！"
			; 清理临时物品
    		CALL CLEAR_TEMPITEM
    		; 获取临时物品0号位为LOCAL
			LOCAL = GET_ITEM_RANGE("临时")
			; 将噗尼噗尼珠实例化到LOCAL
			CALL PREFAB_噗尼噗尼珠01, LOCAL
			; 确认获得物品界面
			CALL SHOW_ITEMLIST, "获得物品", "临时"
			TALENT:MASTER:噗尼噗尼苗床 = 0
		ENDIF
		GOTO START
	CASE 1
		IF CFLAG:GET_CNUM("亚斯特丽德"):可以调教
			CALL MESSAGE_WINDOW, "亚斯特丽德", "原来如此……/好，我懂了……/那么就事不宜迟……"
		ELSE
			CALL MESSAGE_WINDOW, "亚斯特丽德", "这样啊，终于决定要委身于我了吗。/没什么好怕的，/就让姐姐大人我，手把手地好好指导你吧。"
		ENDIF
		CFLAG:GET_CNUM("亚斯特丽德"):可以调教 = 1
		CALL SET_TARGET, GET_CNUM("亚斯特丽德")
		FLAG:SHOP指令 = GET_NO("SHOP", "调教")
		CALLFORM SHOPCOM_{FLAG:SHOP指令}
		REDRAW 1
		RETURN 1
	CASE 9
		REDRAW 1
		RETURN 0
ENDSELECT
