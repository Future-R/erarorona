;==================================================
;角色クターステータスの表示関連
;==================================================
@SHOPCOMNAME_51
RESULTS = 结局

@SHOPCOMABLE_51
SIF !FLAG:已缴费 && CONVERT_DAY(4, 1, 1) > DAY
	RETURN 0
SIF FLAG:结局指定
	RETURN 0
SIF GET_NAME("地点", FLAG:当前地点) != "亚兰德"
	RETURN 0
RETURN 1

@SHOPCOM_51, ARG
#DIM NUM
#DIMS CHOICES
REDRAW 0
CHOICES '= ""
CALL LAYER_INIT
CALL LAYER_DRAWLINE, 0
CALL LAYER_SET, @"　%SHOW_DAY()%%"", 10%-萝乐娜的工房-%"",20%资金:{MONEY:0, 9}克尔", 1
CALL LAYER_DRAWLINE, 2
CALL LAYER_DRAWLINE, MAXLINE() - 7
CALL LAYER_PRINT, , MAXLINE() - 6
CALL MESSAGE_WINDOW, "萝乐娜", "总之，不再被债务追着跑了，/也有了思考各种事情的余暇……/或许可以稍微考虑一下将来呢……？"
IF DAY < CONVERT_DAY(6, 1, 1)
	CALL INPUT_YN_M, , "考虑", "暂且放弃"
	IF RESULT
		CALL MESSAGE_WINDOW, "萝乐娜", "算了，下次再说吧"
		RETURN 0
	ENDIF
ENDIF
CLEARLINE MAXLINE() - 6
LOCAL:1 = 0
LOCAL:2 = 0

FOR LOCAL, 0, 结局数
	IF LOCAL == 结局数 - 1
		SIF DAY >= CONVERT_DAY(6, 1, 1)
			CONTINUE
		RESULTS:1 = 还是以后再考虑
	ELSE
		TRYCCALLFORM ENDING_ABLE_{LOCAL}
			SIF !RESULT
				CONTINUE
			CALLFORM ENDING_NAME_{LOCAL}
		CATCH
			CONTINUE
		ENDCATCH
	ENDIF
	SIF CHOICES != ""
		CHOICES += "_"
	CHOICES += TOSTR(LOCAL)
	CALL LAYER_SET, ADD_BTAG(@"[{LOCAL, 2}] %RESULTS:1%", LOCAL), LOCAL:1 + 3, LOCAL:2 * 32
	IF LOCAL:1++ == MAXLINE() - 7 - 3
		LOCAL:1 = 0
		LOCAL:2++
	ENDIF
NEXT
CALL LAYER_PRINT, , MAXLINE()
CALL INPUT_SPLIT, CHOICES, "_"
IF RESULT == 结局数 - 1
	CLEARLINE 6
	CALL MESSAGE_WINDOW, "萝乐娜", "算了，下次再说吧"
	RETURN 0
ELSE
	CALL START_ENDING, RESULT
ENDIF
