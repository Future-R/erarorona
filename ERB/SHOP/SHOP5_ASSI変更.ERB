@SHOPCOMNAME_5
RESULTS = 助手変更

@SHOPCOMABLE_5
#LOCALSIZE 1
IF IS_USEABLE_ATELIER()
	FOR LOCAL, 0, CHARANUM
		SIF IS_ASSIABLE(LOCAL)
			RETURN 1
	NEXT
	RETURN -1
ELSE
	RETURN 0
ENDIF
@SHOPCOM_5, ARG
CALL SET_ASSI, RESULT

@SET_ASSI, ARG
ASSI = ARG
ISASSI:ASSI = 1
SIF ASSI == TARGET
	TARGET = -1

@IS_ASSIABLE, ARG
#FUNCTION
SIF ARG == MASTER
	RETURNF 0
SIF !CFLAG:ARG:助手可能
	RETURNF 0
SIF MARK:ARG:反発刻印
	RETURNF 0
SIF CFLAG:ARG:採集場所 >= 0
	RETURNF 0
SIF !IS_EXIST_HERE(ARG)
	RETURNF 0
RETURNF 1
