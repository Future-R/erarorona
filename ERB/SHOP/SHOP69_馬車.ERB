;------------------------------------------------------------------
;篮子の内容を確認し、破棄・箱子移動をするためのSHOP指令
;------------------------------------------------------------------
@SHOPCOMNAME_69
RESULTS = 马车

@SHOPCOMABLE_69
SIF !GET_EVENT_ATTAIN("随波漂流") && GET_EVENT_STATE("随波漂流") !=  "去酒馆之前"
	RETURN 0
RETURN 1

@SHOPCOM_69, ARG
#LOCALSIZE 2
#DIM LINE
REDRAW 0
CLEARLINE 7
LINE = LINECOUNT
CALL INPUT_YN_M, @"要支付100克尔前往\@FLAG:当前地点 == GET_NO("地点", "亚兰德") ? 阿兰亚村 # 亚兰德\@吗？"
IF !RESULT
	IF MONEY >= 100
		MONEY -= 100
		CALL QUEST_MAP, "马车"
	ELSE
		CLEARLINE LINECOUNT - LINE
		CALL MESSAGE_WINDOW, "", "囊中羞涩……"
	ENDIF
ENDIF
REDRAW 1
