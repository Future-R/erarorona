@SHOPCOMNAME_70
RESULTS = 日出食堂

@SHOPCOMABLE_70
RESULTS = 日出食堂

SIF GET_NAME("地点", FLAG:当前地点) != "亚兰德"
	RETURN 0
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN -1
SIF CFLAG:GET_CNUM("伊克赛尔"):打烊时间
	RETURN -1
	
; 周六折扣日，周日进货日
SIF WEEK(DAY) == 6
	RETURN 3
RETURN 1

@SHOPCOM_70, ARG
CALL MAIN_STORE, GET_NO("商店", "日出食堂")
RETURN 1
