;フルネームは長すぎるので杂货店としてSHOPメニューに出す
@SHOPCOMNAME_71
RESULTS = 杂货店

@SHOPCOMABLE_71
RESULTS = 杂货店
SIF GET_NAME("地点", FLAG:当前地点) != "亚兰德"
	RETURN 0
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN -1
SIF CFLAG:GET_CNUM("蒂华娜"):打烊时间
	RETURN -1
; 周六折扣日，周日进货日
SIF WEEK(DAY) == 6
	RETURN 3
RETURN 1

@SHOPCOM_71, ARG
SIF CFLAG:GET_CNUM("蒂华娜"):打烊时间
	RETURN 0
CALL MAIN_STORE, GET_NO("商店", "罗与蒂华的杂货店")
RETURN 1
