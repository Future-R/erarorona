@SHOPCOMNAME_80
RESULTS = 与库蝶莉娅会面

@SHOPCOMABLE_80
IF CFLAG:GET_CNUM("库蝶莉娅"):认识 && IS_EXIST_HERE(GET_CNUM("库蝶莉娅"))
	IF CFLAG:GET_CNUM("库蝶莉娅"):采集地点 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("库蝶莉娅"):采集完成日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_80, ARG
CALL BGM, "千金大小姐.mp3"
CALL TALK_FRIEND, GET_CNUM("库蝶莉娅"), "广场"
