@SHOPCOMNAME_80
RESULTS = クーデリアと会う

@SHOPCOMABLE_80
IF CFLAG:GET_CNUM("クーデリア"):面識 && IS_EXIST_HERE(GET_CNUM("クーデリア"))
	IF CFLAG:GET_CNUM("クーデリア"):採集場所 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("クーデリア"):採集完了日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_80, ARG
CALL TALK_FRIEND, GET_CNUM("クーデリア")
