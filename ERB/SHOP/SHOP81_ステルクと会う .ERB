@SHOPCOMNAME_81
RESULTS = ステルクと会う

@SHOPCOMABLE_81
IF CFLAG:GET_CNUM("ステルク"):面識 && IS_EXIST_HERE(GET_CNUM("ステルク"))
	IF CFLAG:GET_CNUM("ステルク"):採集場所 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("ステルク"):採集完了日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_81, ARG
CALL TALK_FRIEND, GET_CNUM("ステルク")
