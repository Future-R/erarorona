@SHOPCOMNAME_81
RESULTS = 去见史特尔克

@SHOPCOMABLE_81
IF CFLAG:GET_CNUM("史特尔克"):认识 && IS_EXIST_HERE(GET_CNUM("史特尔克"))
	IF CFLAG:GET_CNUM("史特尔克"):采集地点 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("史特尔克"):采集完成日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_81, ARG
CALL BGM, "王宫的入口.mp3"
CALL TALK_FRIEND, GET_CNUM("史特尔克"), "王宫走廊"
