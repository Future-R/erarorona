@SHOPCOMNAME_82
RESULTS = 去见里欧涅菈

@SHOPCOMABLE_82
IF CFLAG:GET_CNUM("里欧涅菈"):认识 && IS_EXIST_HERE(GET_CNUM("里欧涅菈"))
	IF CFLAG:GET_CNUM("里欧涅菈"):采集地点 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("里欧涅菈"):采集完成日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_82, ARG
CALL BGM, "杂技少女.mp3"
CALL TALK_FRIEND, GET_CNUM("里欧涅菈")
