@SHOPCOMNAME_83
RESULTS = 去见坦特

@SHOPCOMABLE_83
IF CFLAG:GET_CNUM("坦特里斯"):认识 && IS_EXIST_HERE(GET_CNUM("坦特里斯"))
	IF CFLAG:GET_CNUM("坦特里斯"):采集地点 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("坦特里斯"):采集完成日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_83, ARG
CALL BGM, "吟游诗人如是说.mp3"
CALL TALK_FRIEND, GET_CNUM("坦特里斯")