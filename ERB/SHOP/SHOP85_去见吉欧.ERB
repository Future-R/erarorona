@SHOPCOMNAME_85
RESULTS = 去见吉欧

@SHOPCOMABLE_85
IF CFLAG:GET_CNUM("吉欧"):认识 && IS_EXIST_HERE(GET_CNUM("吉欧"))
	; 吉欧目前只在周末出没
	IF WEEK(DAY) < 6
		RETURN 0
	ENDIF
	IF CFLAG:GET_CNUM("吉欧"):采集地点 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("吉欧"):采集完成日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_85, ARG
CALL BGM, "世界地图.mp3"
CALL TALK_FRIEND, GET_CNUM("吉欧")
