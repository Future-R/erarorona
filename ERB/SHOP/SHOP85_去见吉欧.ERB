@SHOPCOMNAME_85
RESULTS = 去见吉欧

@SHOPCOMABLE_85
IF CFLAG:GET_CNUM("吉欧"):认识 && IS_EXIST_HERE(GET_CNUM("吉欧"))
	; 吉欧在亚兰德时只在周末出没
	IF WEEK(DAY) < 6 && FLAG:当前地点 == GET_NO("地点", "亚兰德") 
		RETURN 0
	ENDIF
	IF CFLAG:GET_CNUM("吉欧"):采集地点 == -1
		RETURN 1
	ELSE
		IF CFLAG:GET_CNUM("吉欧"):采集完成日 < DAY
			RETURN 3
		ELSE
			RETURN -1
		ENDIF
	ENDIF
ELSE
	RETURN 0
ENDIF

@SHOPCOM_85, ARG
CALL BGM, "亚兰德之王.mp3"
CALL TALK_FRIEND, GET_CNUM("吉欧")
