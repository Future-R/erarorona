@SHOPCOMNAME_95
RESULTS = パスコード入力

@SHOPCOMABLE_95
#LOCALSIZE 1
SIF !GET_EVENT_ATTAIN("ホムンクルスを作ろう！")
	RETURN -1
RESULTS = パスコード出力
RETURN 1

@SHOPCOM_95, ARG
#DIM CHARA
#DIMS TEMPS
#LOCALSSIZE 1
#LOCALSIZE 7
#DIMS LISTS, 200
DRAWLINE
PRINTL パスコードを入力してください
DRAWLINE
INPUTS
SIF RESULTS == ""
	RETURN 0
LOCALS = %RESULTS%
ADDVOIDCHARA
CHARA = CHARANUM - 1
;キーコード初期化
CALLF KEY_PASSCODE, -2
TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("KEY"), 1)%
;キーコード変更
SIF TEMPS != ""
	CALLF KEY_PASSCODE, DEC_PASSCODE(TEMPS)
TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("VERSION"), 1)%

TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("NAME"), 1)%
FOR LOCAL, 0, STRLENSU(TEMPS), 7
	CALL DEC_PLURAL, SUBSTRINGU(TEMPS, LOCAL, 7), @"{POWER(2, 16)}/{POWER(2, 16)}/{POWER(2, 16)}"
	FOR LOCAL:1, 0, 3
		SIF RESULT:(LOCAL:1) == 0
			CONTINUE
		CALLNAME:CHARA += UNICODE(RESULT:(LOCAL:1))
	NEXT
NEXT
NAME:CHARA '= CALLNAME:CHARA

TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("BASE"), 1)%
FOR LOCAL, 0, STRLENSU(TEMPS), 2
	CALL DEC_PLURAL, SUBSTRINGU(TEMPS, LOCAL, 2), "50/320"
	BASE:CHARA:RESULT = RESULT:1 * 100
	MAXBASE:CHARA:RESULT = RESULT:1 * 100
NEXT

TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("ABL"), 1)%
FOR LOCAL, 0, STRLENSU(TEMPS), 2
	CALL DEC_PLURAL, SUBSTRINGU(TEMPS, LOCAL, 2), "11/11/100"
	ABL:CHARA:(RESULT:2) = RESULT
	CALL SET_MAX_ABL, RESULT:2, CHARA, RESULT:1
NEXT

TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("TALENT"), 1)%
FOR LOCAL, 0, STRLENSU(TEMPS), 2
	CALL DEC_PLURAL, SUBSTRINGU(TEMPS, LOCAL, 2), "4/4/4/255"
	FOR LOCAL:1, 0, 3
		TALENT:CHARA:(RESULT:3 + LOCAL:1) = RESULT:(LOCAL:1)
	NEXT
NEXT

TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("MARK"), 1)%
FOR LOCAL, 0, STRLENSU(TEMPS)
	CALL DEC_PLURAL, SUBSTRINGU(TEMPS, LOCAL, 1), "11/11"
	MARK:CHARA:(RESULT:1) = RESULT
NEXT
TEMPS = %AUTO_SPLIT(LOCALS, SEPARATOR_PASSCODE("FEATURE"), 1)%
FOR LOCAL, 0, 特徴要素数
	LOCAL:1 = DEC_PASSCODE(SUBSTRINGU(TEMPS, LOCAL, 1)) - 1
	IF LOCAL:1 == - 1
		SELECTCASE LOCAL
			CASE 0
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = 感情希薄
			CASE 1
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = 青
			CASE 2
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = ツインテール
			CASE 3
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = レッド
			CASE 4
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = 白
			CASE 5
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = 貧乳
			CASE 6
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = 小柄
			CASE 7
				CSTR:CHARA:GET_NAME("特徴", LOCAL) = スレンダー
		ENDSELECT
	ELSE
		LOCAL:1 += LOCAL < 3 ? PROPERTY_FEATURE_START() # PROPERTY_FEATURE_START() + 100
		CALLFORM PROPERTY_FEATURE_{LOCAL:1}
		CSTR:CHARA:GET_NAME("特徴", LOCAL) = %RESULTS%
	ENDIF
NEXT
NICKNAME:CHARA = %CSTR:CHARA:性格%
CSTR:CHARA:所在地 = アトリエ
CFLAG:CHARA:採集場所 = -1
CFLAG:CHARA:面識 = 1

CALL SHOW_CHARALIST, "パスコード入力確認", CHARA
SORTCHARA CFLAG:0:人間, FORWARD
