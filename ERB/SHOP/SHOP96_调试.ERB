@SHOPCOMNAME_96
RESULTS = 调试

@SHOPCOMABLE_96
SIF !FLAG:DEBUG
	RETURN 0
RETURN 1

; 获得物品、调整状态
@SHOPCOM_96, ARG
#DIM LINE

LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTL 调试
DRAWLINE
PRINTL [0] 卷心菜小游戏
PRINTL [9] 返回
CALL INPUT_SPLIT, "0/9"
SELECTCASE RESULT
	CASE 0
		CALL 卷心菜小游戏
		GOTO START
	CASE 9
		RETURN 0
ENDSELECT
RETURN 0
