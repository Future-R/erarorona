@SHOPCOMNAME_98
RESULTS = 倍率確認

@SHOPCOMABLE_98
SIF !FLAG:DEBUG
	RETURN 0
RETURN 1

@SHOPCOM_98, ARG
#DIM CHARA
#DIM TEMP
#DIM LINE
#LOCALSSIZE 2
DRAWLINE
PRINTFORML [0] 角色クター個別確認
DRAWLINE
PRINTFORML CUP
LOCAL:1 = 0
FOR LOCAL, 0, 100
	SIF PALAMNAME:LOCAL == ""
		CONTINUE
	PRINTFORM %@"[{LOCAL + 100}]" + PALAMNAME:LOCAL, 24, LEFT%
	SIF LOCAL:1++ == 3
		PRINTL 
NEXT
SIF !LINEISEMPTY()
	PRINTL 
DRAWLINE
PRINTFORML SOURCE
LOCAL:1 = 0
FOR LOCAL, 0, 100
	SIF SOURCENAME:LOCAL == ""
		CONTINUE
	PRINTFORM %@"[{LOCAL + 200}]" + SOURCENAME:LOCAL, 24, LEFT%
	SIF LOCAL:1++ == 3
		PRINTL 
NEXT
SIF !LINEISEMPTY()
	PRINTL 
INPUT
LINE = LINECOUNT
IF RESULT == 0
	$START_CHARA
	CALL SHOW_CHARALIST, "倍率確認"
	SIF RESULT == 1000
		RETURN 0
	CHARA = RESULT
	DRAWLINE
	PRINTFORML 　TALENT倍率　%CALLNAME:CHARA%
	DRAWLINE
	VARSET LOCALS
	FOR LOCAL, 0, 100
		SIF PALAMNAME:LOCAL != ""
			LOCALS += "/" + PALAMNAME:LOCAL
		SIF SOURCENAME:LOCAL != ""
			LOCALS:1 += "/" + SOURCENAME:LOCAL
	NEXT
	LOCAL = 0
	PRINTFORML %"CUP倍率", 54,LEFT%SOURCE倍率
	DO 
		LOCAL++
		IF AUTO_SPLIT(LOCALS, "/", LOCAL) == ""
			PRINTFORM %"", 54%
		ELSE
			CALL GET_TALENT_CUP, AUTO_SPLIT(LOCALS, "/", LOCAL), CHARA
			IF RESULT < 0
				TEMP = 100 * 100 / (100 - RESULT)
			ELSE
				TEMP = 100 * (100 + RESULT) / 100
			ENDIF
			SIF TEMP > 100
				SETCOLOR COLOR("p-blue")
			SIF TEMP < 100
				SETCOLOR COLOR("p-red")
			PRINTFORM %AUTO_SPLIT(LOCALS, "/", LOCAL), 20, LEFT%
			PRINTFORM %TOSTR(TEMP, "##.##"), 5%\%%"", 28%
			RESETCOLOR
		ENDIF
		IF AUTO_SPLIT(LOCALS:1, "/", LOCAL) == ""
			PRINTFORM %"", 54%
		ELSE
			CALL GET_TALENT_SOURCE, AUTO_SPLIT(LOCALS:1, "/", LOCAL), CHARA
			IF RESULT < 0
				TEMP = 100 * 100 / (100 - RESULT)
			ELSE
				TEMP = 100 * (100 + RESULT) / 100
			ENDIF
			SIF TEMP > 100
				SETCOLOR COLOR("p-blue")
			SIF TEMP < 100
				SETCOLOR COLOR("p-red")
			PRINTFORM %AUTO_SPLIT(LOCALS:1, "/", LOCAL), 20, LEFT%
			PRINTFORM %TOSTR(TEMP, "##.##"), 5%\%%"", 29%
			RESETCOLOR
		ENDIF
		PRINTL 
	LOOP AUTO_SPLIT(LOCALS, "/", LOCAL) != "" || AUTO_SPLIT(LOCALS:1, "/", LOCAL) != ""
	CALL EQUATE_LINE, LINE + MAXLINE()
	WAIT
	GOTO START_CHARA
ELSE
	IF INRANGE(RESULT, 100, 199)
		TEMP = RESULT - 100
		DRAWLINE
		PRINTFORML [%PALAMNAME:TEMP%]倍率確認
		DRAWLINE
		PRINTFORML %"", 20%%"Lv1", 6%%"Lv2",6%%"Lv3",6%
		FOR LOCAL, 0, VARSIZE("TALENT")
			VARSET RESULT, 0, 0, 7
			TRYCCALLFORM TALENT_CUP_%TALENTNAME:LOCAL%, PALAMNAME:TEMP
				IF MAXARRAY(RESULT, 0, 3)
					PRINTFORM %TALENTNAME:LOCAL, 20, LEFT%
					FOR LOCAL:1, 0, 3
						CALL COLORPRINT, @"{RESULT:(LOCAL:1), 6}", \@RESULT:(LOCAL:1) < 0 ? p-red # p-blue\@
					NEXT
					PRINTL 
				ENDIF
				IF MAXARRAY(RESULT, 4, 7)
					PRINTFORM %TALENTNAME:LOCAL + "(調教者)", 20, LEFT%
					FOR LOCAL:1, 4, 7
						CALL COLORPRINT, @"{RESULT:(LOCAL:1), 6}", \@RESULT:(LOCAL:1) < 0 ? p-red # p-blue\@
					NEXT
					PRINTL 
				ENDIF
			CATCH
			ENDCATCH
		NEXT
		CALL EQUATE_LINE, LINE + MAXLINE()
		WAITANYKEY
	ELSEIF INRANGE(RESULT, 200, 299)
		TEMP = RESULT - 200
		DRAWLINE
		PRINTFORML [%SOURCENAME:TEMP%]倍率確認
		DRAWLINE
		PRINTFORML %"", 20%%"Lv1", 6%%"Lv2",6%%"Lv3",6%
		FOR LOCAL, 0, VARSIZE("TALENT")
			VARSET RESULT, 0, 0, 7
			TRYCCALLFORM TALENT_SOURCE_%TALENTNAME:LOCAL%, SOURCENAME:TEMP
				IF MAXARRAY(RESULT, 0, 3)
					PRINTFORM %TALENTNAME:LOCAL, 20, LEFT%
					FOR LOCAL:1, 0, 3
						CALL COLORPRINT, @"{RESULT:(LOCAL:1), 6}", \@RESULT:(LOCAL:1) < 0 ? p-red # p-blue\@
					NEXT
					PRINTL 
				ENDIF
				IF MAXARRAY(RESULT, 4, 7)
					PRINTFORM %TALENTNAME:LOCAL + "(調教者)", 20, LEFT%
					FOR LOCAL:1, 4, 7
						CALL COLORPRINT, @"{RESULT:(LOCAL:1), 6}", \@RESULT:(LOCAL:1) < 0 ? p-red # p-blue\@
					NEXT
					PRINTL 
				ENDIF
			CATCH
			ENDCATCH
		NEXT
		CALL EQUATE_LINE, LINE + MAXLINE()
		WAITANYKEY
	ENDIF
ENDIF
RESTART
