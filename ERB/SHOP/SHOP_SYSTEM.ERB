;														ASSI変更の条件としてTARGETABLEを見ていたのを修正
;														一覧表示でのPAGEを2桁に
;	003		2012/08/23			kap			0.310		冒頭でスキップつぶし
;														イベントの呼び出し措置を追加
;	004		2012/09/19			kap			0.370		メッセージの点击範囲拡張に対応
;														メッセージの加速係数の初期化を追加
;	005		2012/10/17			kap			0.410		SHOP指令を選んだ時にもイベント呼び出しを行うように
;	006		2012/10/23			kap			0.420		DEBUGと入力することでDEBUGモードに移るように
;	007		2013/07/16			kap			0.480		表示処理をレイヤー式に変更
;	008		2013/10/03			kap			0.481		依頼を確認できるように。テストコードが残ってたのを消去
;---------------------------------------------------------------------
;@EVENTSHOP			:イベント関数
;@SHOW_SHOP			:イベント関数　SHOP画面の描写を行う
;@SHOW_SHOP_INFO	:SHOP画面の上部表示。マスターのステータスなどを表示する
;@SHOW_SHOPCOM		:実行可能なSHOPCOMを判定し、さらに表示する
;@USERSHOP			:イベント関数。SHOPの下位関数に移動させる
;---------------------------------------------------------------------
;----------------------------------------------------
;SHOP画面の制御を行う関数
;----------------------------------------------------
@EVENTSHOP
#ONLY

;----------------------------------------------------
; 播放SHOP主界面的背景音乐
; 阿拉尼亚村沿用村庄专属曲，其余地点使用可配置的默认BGM
;----------------------------------------------------
@播放SHOP背景音乐
#DIMS 背景音乐字符串

背景音乐字符串 = %获取SHOP背景音乐文件名()%
CALL BGM, 背景音乐字符串

@SHOW_SHOP
#LOCALSSIZE 10
#LOCALSIZE 2
#DIM CHARA
#DIM LINE
#DIM SHOP_X
#DIM SHOP_Y
#DIM SHOW_NUM
#DIM TEMP, 2
#DIMS TEMPS, 2
#DIMS PIC_NAME, 1
#DIM L_REQ
#DIMS BUTTONS
#DIM R_LINENUM
SHOPCOMLINE = 20
SIF STRCOUNT(GET_NAME("SHOP", 75), "名称不在") || STRCOUNT(GET_NAME("商店", 5), "名称不在") || STRCOUNT(GET_NAME("角色", 14), "名称不在")
	CALL MAKE_NOLIST

CALL 播放SHOP背景音乐
;-----------------------------------------------------
; 检查事件是否能触发
;-----------------------------------------------------
CALL START_EVENT

;---------------------------------------------------
; 右侧列表栏
;---------------------------------------------------
CALL MAKE_R_SHOPLIST

;--------------------------------------------------
; 执行自动保存
; 注意这里会初始化LOCAL变量
;-------------------------------------------------
CALL SAVE_AUTO_START
; 保持当前工房页的世界地图提示稳定，不随每次重绘变化
世界地图提示 '= GET_TIPS(1)
LINE = LINECOUNT
$START
CALL INIT_LAYER, "`"
; START后再确认一次音乐
CALL 播放SHOP背景音乐

CALL LAYER_DRAWLINE, 0
CALL LAYER_SET, @"　%SHOW_DAY()%%"", 10%-%GET_NAME("地点", FLAG:当前地点)%-%"",20%资金:{MONEY:0, 9}克尔%"",10%\@FLAG:冒险者等阶 ? 冒险者等阶:%GET_NAME("冒险者等阶", FLAG:冒险者等阶)% # \@", 1, 0
CALL LAYER_SET, FORMCELL("🎝" + 获取SHOP背景音乐显示名() + "🎝", 26, "RIGHT"), 1, MAX(0, MAXWIDTH() - 26)
CALL LAYER_DRAWLINE, 2

SHOP_X = 0
SHOP_Y = 3

;-------------------------------------------------
; SHOP上方
;-------------------------------------------------
; CALL LAYER_SET, @"　%CALLNAME:MASTER, 20, LEFT%", SHOP_Y, SHOP_X
CALL LAYER_SET, 获取人类头像(MASTER,400,50) + GET_SPACE(5) + @"%CALLNAME:MASTER, 46, LEFT%" + @"　调合等级:{GET_MIXLV(MASTER),2}%"",5%下次升级:{GET_MIXEXP_NEED(MASTER),4} 经验%"", 14%", SHOP_Y + 1, SHOP_X
SPLIT "体力/气力/魔力/ / /红/蓝/绿", "/", LOCALS
FOR LOCAL, 0, 3
	TEMPS '= " "*8 + "　" + LOCALS:LOCAL + ":"
	TEMPS += LAYER_CBAR(BASE:MASTER:(LOCALS:LOCAL), GET_MAXBASE(LOCALS:LOCAL, MASTER), 64, "▮", "▮", BARCOLORSET(LOCALS:(LOCAL+5)), RESULT:1)
	TEMPS += @"({BASE:MASTER:(LOCALS:LOCAL),5}/{GET_MAXBASE(LOCALS:LOCAL, MASTER),5})"
	CALL LAYER_SET, TEMPS, SHOP_Y + 2 + LOCAL, SHOP_X
NEXT
CALL LAYER_DRAWLINE, SHOP_Y + 5
IF IS_USEABLE_ATELIER()
	IF IS_TARGETABLE(TARGET)
		; 如果是人类或者遗物霍姆，则获取人类头像，否则获取霍姆头像
		IF CSTR:TARGET:角色解说 != "" && SPRITECREATED(CALLNAME:TARGET + "_normal")
			TEMPS '= 获取人类头像(TARGET,400,50) + GET_SPACE(5)
		ELSE
			TEMPS '= 获取霍姆头像(TARGET,400,50) + GET_SPACE(5)
		ENDIF
	ELSE
		TEMPS '= GET_SPACE(5)
	ENDIF
	TEMPS += @"%"调教对象", 16, LEFT%"
	IF IS_TARGETABLE(TARGET)
		TEMPS += ADD_BTAG("[0] 开始调教 ", "0")
	ELSE
		TEMPS += ADD_FTAG("[0] 开始调教 ", COLOR("gray"))
	ENDIF
	TEMPS += ADD_BTAG("[1] 更换 ", "1")
	IF TARGET > -1 && (CSTR:TARGET:所在地 == "工房" || GET_NO("地点", CSTR:TARGET:所在地) == FLAG:当前地点)
		TEMPS += ADD_BTAG("[2] 查看能力 ", "2")
	ELSE
		TEMPS += ADD_FTAG("[2] 查看能力 ", COLOR("gray"))
	ENDIF
	
	CALL LAYER_SET, TEMPS, SHOP_Y + 6, SHOP_X
ENDIF

IF ASSI >= 0
	IF CSTR:ASSI:角色解说 != "" && SPRITECREATED(CALLNAME:ASSI + "_normal")
		TEMPS '= 获取人类头像(ASSI,400,100) + GET_SPACE(5)
	ELSE
		TEMPS '= 获取霍姆头像(ASSI,400,100) + GET_SPACE(5)
	ENDIF
	TEMPS += @"%" 助手", 16, LEFT%"
	TEMPS += ADD_BTAG("[5] 更换 ", "5")
	TEMPS += ADD_BTAG("[6] 查看能力", "6")
	CALL LAYER_SET, TEMPS, SHOP_Y + 6, SHOP_X + 54
ENDIF

FOR LOCAL, 1, 3
	SIF TRAINCHARA(LOCAL) == -1 || ! IS_USEABLE_ATELIER()
		CONTINUE
	CALL LAYER_SET, " "*8 + CALLNAME:TRAINCHARA(LOCAL), SHOP_Y + 7, SHOP_X + 2 + (LOCAL - 1) * 62
	FOR LOCAL:1, 0, 2
		TEMPS = %" "*8 + LOCALS:(LOCAL:1)%:
		TEMPS += LAYER_CBAR(BASE:TRAINCHARA(LOCAL):(LOCALS:(LOCAL:1)), GET_MAXBASE(LOCALS:(LOCAL:1), TRAINCHARA(LOCAL)), 32, "▮", "▮", BARCOLORSET(LOCALS:(LOCAL:1 + 5)), RESULT:1)
		TEMPS += @"({BASE:TRAINCHARA(LOCAL):(LOCALS:(LOCAL:1)),5}/{GET_MAXBASE(LOCALS:(LOCAL:1), TRAINCHARA(LOCAL)),5})"
		CALL LAYER_SET, TEMPS, SHOP_Y + 8 + LOCAL:1, SHOP_X + 2 + (LOCAL - 1) * 62
	NEXT
NEXT
CALL LAYER_DRAWLINE, SHOP_Y + 10

SHOP_X = 0
SHOP_Y = SHOP_Y + 11
SHOW_NUM = 0

;-------------------------------------------------
;SHOP指令の描写
;SHOPCOMABLE_Xで、SHOP指令番号Xの実行判定を行う
;戻り值
;2:実行可能だがここで表記はしない
;1:実行可能
;0:実行不能で表記もしない
;-1:実行不能だが灰色で表記はする
;-------------------------------------------------
IF IS_USEABLE_ATELIER()
	CALL LAYER_SET, @"┌工房%"─" * 37%┐", SHOP_Y, SHOP_X
ELSE
	CALL LAYER_SET, @"┌%"─" * 39%┐", SHOP_Y, SHOP_X
ENDIF
SHOW_NUM += 3
FOR LOCAL, 0, 101
	IF LOCAL % 10 == 0
		;端数切り上げ
		SHOW_NUM = ((SHOW_NUM / 3) + (SHOW_NUM % 3 > 0)) * 3
		IF GROUPMATCH(LOCAL, 60, 90, 100)
			CALL LAYER_SET, @"└%"─" * 39%┘", SHOP_Y + SHOW_NUM / 3
			SHOW_NUM += 3
			IF LOCAL == 60
				CALL LAYER_SET, @"┌%GET_NAME("地点", FLAG:当前地点)%%"─" * (39 - STRLENSU(GET_NAME("地点", FLAG:当前地点)))%┐", SHOP_Y + SHOW_NUM / 3
				SHOW_NUM += 3
			ELSEIF LOCAL == 90
				CALL LAYER_SET, @"┌系统%"─" * 37%┐", SHOP_Y + SHOW_NUM / 3
				SHOW_NUM += 3
			ENDIF
		ENDIF
	ENDIF
	TRYCCALLFORM SHOPCOMABLE_{LOCAL}
		SELECTCASE RESULT
			CASE -1, 1, 3, 4
				TEMPS = [{LOCAL, 3}] %GET_NAME("SHOP", LOCAL)%
				IF RESULT == -1
					TEMPS '= ADD_FTAG(TEMPS, COLOR("灰色"))
				ELSE
					TEMPS '= ADD_BTAG(TEMPS, LOCAL)
					SIF RESULT == 3
						TEMPS '= ADD_FTAG(TEMPS, COLOR("浅绿"))
					SIF RESULT == 4
						TEMPS '= ADD_FTAG(TEMPS, COLOR("黄"))
				ENDIF
				CALL LAYER_SET, TEMPS, SHOP_Y + SHOW_NUM / 3, (SHOW_NUM % 3) * 26 + 2
				IF SHOW_NUM++ % 3 == 0
					CALL LAYER_SET, "│", SHOP_Y + SHOW_NUM / 3, 0
					CALL LAYER_SET, "│", SHOP_Y + SHOW_NUM / 3, 80
				ENDIF
		ENDSELECT
	CATCH
	ENDCATCH
NEXT
;-------------------------------------------------------------------------------
;右欄の描写
;-------------------------------------------------------------------------------
SHOP_X = 82
TEMPS =┌
TEMPS:1 '= ADD_BTAG("[/] 奴隶", "/")
SIF SHOP_R_SHOW == "SLAVE"
	TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("p-blue"))
TEMPS += TEMPS:1

TEMPS:1 '= " [*] 友人"
TEMPS:1 '= ADD_BTAG(TEMPS:1, "*")
SIF SHOP_R_SHOW == "FRIEND"
	TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("p-blue"))

TEMPS += TEMPS:1
TEMPS:1 '= " [.] 请求"
IF GET_EVENT_ATTAIN("柜台任务")
	TEMPS:1 '= ADD_BTAG(TEMPS:1, ".")
	SIF SHOP_R_SHOW == "REQ"
		TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("p-blue"))
ELSE
	TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("gray"))
ENDIF
TEMPS += TEMPS:1
TEMPS += "─" * 7 + "┐"
CALL LAYER_SET, TEMPS, SHOP_Y, SHOP_X
R_LINENUM = MAXLINE() - SHOP_Y - 7
SELECTCASE SHOP_R_SHOW
	CASE "SLAVE", "FRIEND"
		FOR LOCAL, 0, R_LINENUM
			IF SHOP_R_SHOW == "FRIEND"
				TEMP = SHOPPAGE_F * R_LINENUM + LOCAL
				CHARA = SHOPLIST_F:(TEMP)
			ELSE
				TEMP = SHOPPAGE_S * R_LINENUM + LOCAL
				CHARA = SHOPLIST_S:(TEMP)
			ENDIF
			CALL LAYER_SET, "│", SHOP_Y + LOCAL + 1, SHOP_X
			IF CHARA >= 0
				TEMPS '= " "
				TEMPS += ADD_BTAG(@"[{TEMP,2}] %FORMCELL(CALLNAME:CHARA, 12, "LEFT")%", @"c{TEMP}")
				TEMPS += LAYER_RECTBAR(BASE:CHARA:体力, GET_MAXBASE("体力", CHARA), 5, BARCOLORSET("红"), RESULT:1, , , 36)
				TEMP:1 = 5 * 2
				IF CFLAG:CHARA:采集地点 >= 0
					IF CFLAG:CHARA:采集完成日 > DAY
						TEMPS += @"[采集:{CFLAG:CHARA:采集完成日 - DAY,3}日]"
					ELSE
						TEMPS += "[采集完成]"
					ENDIF
				ELSE
					TEMPS:1 '= "[调]"
					IF IS_TARGETABLE(CHARA)
						TEMPS:1 '= ADD_BTAG(TEMPS:1, @"t{TEMP}")
					ELSE
						TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("gray"))
					ENDIF
					TEMPS += TEMPS:1
					TEMPS:1 '= "[助]"
					IF IS_ASSIABLE(CHARA)
						TEMPS:1 '= ADD_BTAG(TEMPS:1, @"a{TEMP}")
					ELSE
						TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("gray"))
					ENDIF
					TEMPS += TEMPS:1
					TEMPS += ADD_BTAG("[能]", @"s{TEMP}")
				ENDIF
				CALL LAYER_SET, TEMPS, SHOP_Y + LOCAL + 1, SHOP_X + 2
			ELSE
				TEMP:1 = 0
			ENDIF
			CALL LAYER_SET, "│", SHOP_Y + LOCAL + 1, SHOP_X + 42 - TEMP:1
		NEXT
	CASE "REQ"
		IF SHOPPAGE_R  == 0
			CALL LAYER_SET, "│" + FORMCELL("接受中的委托", 40, "LEFT") +"│", SHOP_Y + 1, SHOP_X
			TEMP = 2
		ELSE
			SELECTCASE GET_NAME("地点", FLAG:当前地点)
				CASE "亚兰德"
					CALL LAYER_SET, "│" + FORMCELL("王宫委托", 40, "LEFT") +"│", SHOP_Y + 1, SHOP_X
					TEMP = 0
				CASE "阿拉尼亚村"
					CALL LAYER_SET, "│" + FORMCELL("酒馆委托", 40, "LEFT") +"│", SHOP_Y + 1, SHOP_X
					TEMP = 1
			ENDSELECT
		ENDIF
		CALL LAYER_SET, "├" + "─" * 20 +"┤", SHOP_Y + 2, SHOP_X
		FOR LOCAL, 0, 12
			L_REQ = LOCAL + TEMP * 12
			SELECTCASE GET_REQ(L_REQ, "ID")
				CASE 0
					CALL LAYER_SET, "│" + " " * 40 + "│", SHOP_Y + 3 + LOCAL, SHOP_X
					CONTINUE
				CASE IS < 500
					TEMPS '= "【采购】 "
				CASEELSE
					TEMPS '= "【调合】 "
			ENDSELECT
			TEMPS += FORMCELL(GET_NAME("物品", GET_REQ(L_REQ, "ID")), 24, "LEFT") + " * " + TOSTR(GET_REQ(L_REQ, "数量"))
			TEMPS:1 = 
			IF GET_REQ(L_REQ, "ID") < 500
				TEMPS:1 '= "采购　:" + GET_NAME("物品", GET_REQ(L_REQ, "ID"))
			ELSE
				TEMPS:1 '= "调合　:" + GET_NAME("物品", GET_REQ(L_REQ, "ID"))
			ENDIF
			TEMPS:1 += TEXTTAG("L") + "数量　:" + TOSTR(GET_REQ(L_REQ, "数量"))
			TEMPS:1 += TEXTTAG("L") + "持有数:" + TOSTR(REQ_HAVE:L_REQ)
			TEMPS:1 += TEXTTAG("L") + "报酬　:" + TOSTR(GET_REQ(L_REQ, "报酬")) + "克尔"
			IF GET_REQ(L_REQ, "委托方") > 0
				;アストリッドはエスティ名義で依頼をだす
				TEMPS:1 += TEXTTAG("L") + @"%"委托方:" + \@GET_NAME("角色", GET_REQ(L_REQ, "委托方")) != "亚斯特丽德" ? %GET_NAME("角色", GET_REQ(L_REQ, "委托方"))% # 艾丝缇\@%"
			ELSE
				IF TEMP == 0
					TEMPS:1 += TEXTTAG("L") + "委托方:" + "亚兰德王国"
				ELSE
					TEMPS:1 += TEXTTAG("L") + "委托方:" + "阿拉尼亚村酒馆"
				ENDIF
			ENDIF
			CALL LAYER_SET, "│" + ADD_BTAG(ADD_FTAG(FORMCELL(TEMPS, 40, "LEFT"), REQ_ATTAIN_ABLE:L_REQ ? COLOR("p-green") # COLOR("DEF")), , TEMPS:1) + "│", SHOP_Y + 3 + LOCAL, SHOP_X
		NEXT
		FOR LOCAL, LOCAL, R_LINENUM - 3
			CALL LAYER_SET, "│" + " " * 40 + "│", SHOP_Y + 3 + LOCAL, SHOP_X
		NEXT
ENDSELECT
TEMPS '= "└" + "─" * 10 + ADD_BTAG("[-]" + UNICODE(0x25C0), "-") + " 页码."
SELECTCASE SHOP_R_SHOW
	CASE "", "SLAVE"
		TEMPS += @"{SHOPPAGE_S,2}"
	CASE "FRIEND"
		TEMPS += @"{SHOPPAGE_F,2}"
	CASE "REQ"
		TEMPS += @"{SHOPPAGE_R,2}"
ENDSELECT
TEMPS += ADD_BTAG(" " + UNICODE(0x25B6) + " [+]", "+") + "─┘"
CALL LAYER_SET, TEMPS, MAXLINE() - 7, SHOP_X

CALL LAYER_DRAWLINE, MAXLINE() - 6
CALL LAYER_SET, FORMCELL("温馨提示：" + 世界地图提示, MAXWIDTH(), "LEFT"), MAXLINE() - 5, 0
SHOP_Y = SHOP_Y + TEMP / 3 + 1
CALL LAYER_PRINT(, MAXLINE())
FLAG:跳过消息窗口 = 0
FLAG:消息加速系数 = 1
REDRAW 0
;CLEARLINE LINECOUNT - LINE
FLAG:SHOP指令 = -1

;CALL SHOW_SHOPCOM, SHOPCOMLINE
;DRAWLINE
;CALL ADD_LINE, 6
INPUTS
IF RESULTS == "666" || RESULTS == "未来"
	INVERTBIT FLAG:DEBUG, 0
	GOTO START
ELSEIF ISNUMERIC(RESULTS)
	REDRAW 1
	CALL SHOP_COM, TOINT(RESULTS)
	SIF !RESULT
		GOTO START
ELSE
	SELECTCASE RESULTS
		CASE "/"
			SHOP_R_SHOW = SLAVE
		CASE "*"
			SHOP_R_SHOW = FRIEND
		CASE "."
			SIF GET_EVENT_ATTAIN("柜台任务")
				SHOP_R_SHOW = REQ
		CASE "+"
			SELECTCASE SHOP_R_SHOW
				CASE "SLAVE"
					SIF SHOPPAGE_S++ == SHOPMAXPAGE_S
						SHOPPAGE_S = 0
				CASE "FRIEND"
					SIF SHOPPAGE_F++ == SHOPMAXPAGE_F
						SHOPPAGE_F = 0
				CASE "REQ"
					INVERTBIT SHOPPAGE_R, 0
			ENDSELECT
		CASE "-"
			SELECTCASE SHOP_R_SHOW
				CASE "SLAVE"
					SIF SHOPPAGE_S-- == 0
						SHOPPAGE_S = SHOPMAXPAGE_S
				CASE "FRIEND"
					SIF SHOPPAGE_F-- == 0
						SHOPPAGE_F = SHOPMAXPAGE_F
				CASE "REQ"
					INVERTBIT SHOPPAGE_R, 0
			ENDSELECT
		CASE "debug", "DEBUG"
			INVERTBIT FLAG:DEBUG, 0
		CASEELSE
			IF GROUPMATCH(SHOP_R_SHOW, "FRIEND", "SLAVE", "") && GROUPMATCH(SUBSTRING(RESULTS, 0, 1), "c", "t", "a", "s") && SUBSTRING(RESULTS, 1) != ""
				LOCAL = TOINT(SUBSTRING(RESULTS, 1))
				IF SHOP_R_SHOW == "FRIEND"
					IF INRANGE(LOCAL, 0, VARSIZE("SHOPLIST_F") - 1)
						CHARA =  SHOPLIST_F:LOCAL
					ELSE
						GOTO START
					ENDIF
				ELSE
					IF INRANGE(LOCAL, 0, VARSIZE("SHOPLIST_S") - 1)
						CHARA =  SHOPLIST_S:LOCAL
					ELSE
						GOTO START
					ENDIF
				ENDIF
				SIF CHARA == -1
					GOTO START
				SELECTCASE SUBSTRING(RESULTS, 0, 1)
					CASE "c"
						SIF IS_TARGETABLE(CHARA)
							CALL SET_TARGET, CHARA
					CASE "t"
						IF IS_TARGETABLE(CHARA)
							CALL SET_TARGET, CHARA
							CALL SHOP_COM, 0
							RESTART
						ENDIF
					CASE "a"
						IF IS_ASSIABLE(CHARA)
							CALL SET_ASSI, RESULT
						ELSE
							GOTO START
						ENDIF
					CASE "s"
						CALL SHOW_CHARALIST, "查看能力", CHARA
				ENDSELECT
			ENDIF
	ENDSELECT
	GOTO START
ENDIF
RESTART

@SHOP_COM, ARG
#LOCALSIZE 1
;-------------------------------------------------
;SHOP指令実行
;-------------------------------------------------
FLAG:SHOP指令 = ARG
TRYCCALLFORM SHOPCOMABLE_{ARG}
	IF RESULT > 0
		;-----------------------------------------------------
		;イベントの呼び出し処理
		;呼び出された場合はSHOP指令が中止される。
		;-----------------------------------------------------
		CALL START_EVENT
		SIF RESULT
			RETURN 0
		SIF FLAG:SHOP指令 == -1
			RETURN 1
		CALLFORM SHOPCOM_{FLAG:SHOP指令}
	ELSE
		RETURN 0
	ENDIF
CATCH
	RETURN 0
ENDCATCH
FLAG:SHOP指令 = 0
RETURN 1

@MAKE_R_SHOPLIST
#LOCALSIZE 3
#DIM TEMP
VARSET SHOPLIST_S, -1
VARSET SHOPLIST_F, -1
VARSET LOCAL
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	SIF !IS_EXIST_HERE(LOCAL)
		CONTINUE
	;SIF !IS_TARGETABLE(LOCAL)
	;	CONTINUE
	IF CFLAG:LOCAL:人类
		SIF !CFLAG:LOCAL:认识
			CONTINUE
		SHOPLIST_F:(LOCAL:2) = LOCAL
		LOCAL:2++
	ELSE
		SHOPLIST_S:(LOCAL:1) = LOCAL
		LOCAL:1++
	ENDIF
NEXT
SHOPMAXPAGE_S = LOCAL:1 / (SHOPCOMLINE - 2)
SHOPMAXPAGE_F = LOCAL:2 / (SHOPCOMLINE - 2)
SHOPPAGE_S = LIMIT(SHOPPAGE_S, 0, SHOPMAXPAGE_S)
SHOPPAGE_F = LIMIT(SHOPPAGE_F, 0, SHOPMAXPAGE_F)
CALL MAKE_REQ_HAVE_LIST
SIF SHOP_R_SHOW == ""
	SHOP_R_SHOW = SLAVE
@USERSHOP

;----------------------------------------
;角色クターとの関係をもつ際の判定
;----------------------------------------
@JUDGE_MAKE_LOVE, ARG
#FUNCTION
#LOCALSIZE 1
LOCAL = GET_FRIEND_POINT(ARG)
LOCAL += GET_TEQ_M("诱惑") / 5
RETURNF LOCAL >= CSVCFLAG(NO:ARG, GETNUM(CFLAG, "关系难度"))


;----------------------------------------
;アトリエ使用か可能かどうかの判定
;----------------------------------------
@IS_USEABLE_ATELIER
#FUNCTION
SELECTCASE GET_NAME("地点", FLAG:当前地点)
	CASE "亚兰德"
		RETURNF 1
	CASE "阿拉尼亚村"
		SIF GET_EVENT_ATTAIN("分店开业")
			RETURNF 1
ENDSELECT
RETURNF 0
