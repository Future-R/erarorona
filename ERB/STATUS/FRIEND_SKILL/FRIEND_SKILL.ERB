@CHANGE_FR_SKILL, ARG
#LOCALSIZE 2
#LOCALSSIZE 6
#DIM L_LINE
#DIM L_SELECT
#DIM TEMP,3
#DIMS TEMPS
#DIMS FR_TALENTS, 52
#DIM FR_TALENT_COST, 52
#DIM LINE, 2
#DIMS L_KEY

L_SELECT = 0

DRAWLINE
CALL WINDOWPRINTL, @"%"　アビリティ取得", 40, LEFT%"
DRAWLINE
LINE = LINECOUNT
$START
L_KEY = 9/+
CLEARLINE LINECOUNT - LINE
FOR L_LINE, 0, MAXLINE() - 7
	SELECTCASE L_LINE
		CASE 0
			CALL WINDOWPRINT, "┌" + "─" * 60 + "┐"
		CASE 1
			CALL WINDOWPRINT, @"│%CALLNAME:ARG, 120, LEFT%│"
		CASE 2
			CALL WINDOWPRINT, @"│%@"技能值:{CFLAG:ARG:技能值, 3}", 30, LEFT%"
			CALL WINDOWPRINT, @"%@"交友值:{GET_FRIEND_POINT(ARG), 3}", 90, LEFT%│"
		CASE 4
			CALL WINDOWPRINT, "┌素質" + "─"*58 + "┐"
			TEMP = 0
			VARSET FR_TALENTS
		CASE 5 TO 20
			CALL WINDOWPRINT, "│"
			FOR LOCAL, 0, 3
				TEMP:1 = (L_LINE - 5) * 3 + LOCAL
				DO 
					TEMP++
					RESULT = 0
					SIF TEMP < VARSIZE("TALENT")
						TRYCALLFORM TALENT_NOLV_%TALENTNAME:TEMP%
				LOOP (TEMP < VARSIZE("TALENT") && !TALENT:ARG:TEMP) || RESULT
				IF TEMP >= VARSIZE("TALENT")
					PRINTFORM %"", 40%
				ELSE
					L_KEY += "/" + GET_KEYMARK(TEMP:1)
					FR_TALENTS:(TEMP:1) = %TALENTNAME:TEMP%
					IF GET_TALENT_COST(FR_TALENTS:(TEMP:1)) >= 0
						TEMPS = p-blue
						IF TALENT:ARG:TEMP == 3
							FR_TALENT_COST:(TEMP:1) = 0
						ELSE
							FR_TALENT_COST:(TEMP:1) = GET_TALENT_COST(FR_TALENTS:(TEMP:1), TALENT:ARG:TEMP) * (5 - CSVTALENT(NO:ARG, TEMP, 0)) / 2 / 2
						ENDIF
					ELSE
						TEMPS = p-red
						IF TALENT:ARG:TEMP == 1
							FR_TALENT_COST:(TEMP:1) = 0
						ELSE
							FR_TALENT_COST:(TEMP:1) = GET_TALENT_COST(FR_TALENTS:(TEMP:1), 5 - TALENT:ARG:TEMP) * (1 + CSVTALENT(NO:ARG, TEMP, 0)) / 2 / 2
						ENDIF
					ENDIF
					IF FR_TALENT_COST:(TEMP:1)
						CALL PRINTSBUTTON_C, @"%"[" + GET_KEYMARK(TEMP:1) + "] " + TALENTNAME:TEMP, 16, LEFT%: ", GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:(TEMP:1)) ? 100 # 50), CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:(TEMP:1)) ? COLOR("DEF") # COLOR("gray")
					ELSE
						CALL PRINTSBUTTON_C, @"%"[" + GET_KEYMARK(TEMP:1) + "] " + TALENTNAME:TEMP, 16, LEFT%: ", GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", 50),  COLOR("DEF")
					ENDIF
					FOR LOCAL:1, 0, 3
						IF GET_TALENT(TEMP, ARG) <= LOCAL:1
							SETCOLOR GETBGCOLOR()
						ELSE
							SETCOLOR COLOR(TEMPS)
						ENDIF
						PRINTFORM %UNICODE(0x25AE)%
						RESETCOLOR
					NEXT
					IF TEMPS == "p-blue"
						IF FR_TALENT_COST:(TEMP:1)
							CALL PRINTSBUTTON_C, " " * 4 + @"<up  :{FR_TALENT_COST:(TEMP:1),2}pts>" + " " * 3, GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", CFLAG:ARG:技能值 >= FR_TALENT_COST:(TEMP:1) ? 100 # 50), CFLAG:ARG:技能值 >= FR_TALENT_COST:(TEMP:1) ? COLOR("DEF") # COLOR("gray")
						ELSE
							CALL PRINTSBUTTON_C, " " * 4 + @"<max :--pts>" + " " * 3, GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", 50), COLOR("DEF")
						ENDIF
					ELSE
						IF FR_TALENT_COST:(TEMP:1)
							CALL PRINTSBUTTON_C, " " * 4 + @"<down:{ABS(FR_TALENT_COST:(TEMP:1)),2}pts>" + " " * 3, GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:(TEMP:1)) ? 100 # 50), CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:(TEMP:1)) ? COLOR("DEF") # COLOR("gray")
						ELSE
							CALL PRINTSBUTTON_C, " " * 4 + @"<min :--pts>" + " " * 3, GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", 50), COLOR("DEF")
						ENDIF
					ENDIF
				ENDIF
			NEXT
			CALL WINDOWPRINT, "│"
		CASE 22
			PRINTFORM ┌スキル%"─"*57%┐
		CASE 23 TO 25
			TEMP = L_LINE - 23
			TEMP:1 = TEMP + 49
			PRINT │
			TEMPS = %AUTO_SPLIT(CSTR:ARG:拥有技能, "/", TEMP)%
			IF TEMPS == ""
				FR_TALENT_COST:(TEMP:1) = 0
				PRINTFORM %"", 120%
			ELSE
				L_KEY += "/" + GET_KEYMARK(TEMP:1)
				CALLFORM FRIEND_SKILL_COST_%TEMPS%
				FR_TALENT_COST:(TEMP:1) = RESULT:(FR_SKILL_LV:(GET_NO("友人技能", TEMPS)))
				FR_TALENTS:(TEMP:1) = %TEMPS%
				IF FR_TALENT_COST:(TEMP:1)
					CALL PRINTSBUTTON_C, @"%"[" + GET_KEYMARK(TEMP:1) + "] " + TEMPS, 24, LEFT%: ", GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:(TEMP:1)) ? 100 # 50), CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:(TEMP:1)) ? COLOR("DEF") # COLOR("gray")
				ELSE
					CALL PRINTSBUTTON_C, @"%"[" + GET_KEYMARK(TEMP:1) + "] " + TEMPS, 24, LEFT%: ", GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", 50),  COLOR("DEF")
				ENDIF
				FOR LOCAL:1, 0, 3
					IF FR_SKILL_LV:GET_NO("友人技能", TEMPS) <= LOCAL:1
						SETCOLOR GETBGCOLOR()
					ELSE
						SETCOLOR COLOR("p-blue")
					ENDIF
					PRINTFORM %UNICODE(0x25AE)%
					RESETCOLOR
				NEXT
				CALL PRINTSBUTTON_C, " " * 4 + @"<up  :{FR_TALENT_COST:(TEMP:1),2}pts>" + " " * 3, GET_KEYMARK(TEMP:1), L_SELECT == TEMP:1, COLOR("p-green", CFLAG:ARG:技能值 >= FR_TALENT_COST:(TEMP:1) ? 100 # 50), CFLAG:ARG:技能值 >= FR_TALENT_COST:(TEMP:1) ? COLOR("DEF") # COLOR("gray")
				PRINTFORM %"", 72%
			ENDIF
			PRINT │
			
		CASE 3, 7, 15, 21, 26, 33
			PRINTFORM └%"─" * 60%┘
		CASE 27
			PRINTFORM ┌%FR_TALENTS:L_SELECT%%"─" * (60 - STRLENSU(FR_TALENTS:L_SELECT))%┐
			IF L_SELECT < 49
				CALLFORM TALENT_EXPLAIN_%FR_TALENTS:L_SELECT%
				TEMPS = %RESULTS%
			ELSE
				CALLFORM FRIEND_SKILL_EXPLAIN_%FR_TALENTS:L_SELECT%
				TEMPS = %RESULTS%
			ENDIF
		CASE 28 TO 31
			PRINTFORM │%AUTO_SPLIT(TEMPS, "/", L_LINE - 28), 120, LEFT%│
		CASE 32
			PRINTFORM │%@"必要技能值:\@FR_TALENT_COST:L_SELECT ? {ABS(FR_TALENT_COST:L_SELECT),2} # -- \@pts", 40, LEFT%
			IF L_SELECT < 49
				PRINTFORM %"",80%
			ELSE
				PRINTFORM %@"必要交友值:%AUTO_SPLIT("30/50/80/--", "/", FR_SKILL_LV:GET_NO("友人技能", AUTO_SPLIT(CSTR:ARG:拥有技能, "/", L_SELECT - 49)))%pts", 80, LEFT%
			ENDIF
			PRINT │
		CASEELSE
			PRINTFORM 
	ENDSELECT
	PRINTL 
NEXT
DRAWLINE
IF L_SELECT < 49
	CALL PRINTSBUTTON_C, "　[ +] 素質等级変更", "+", FR_TALENT_COST:L_SELECT && CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:L_SELECT), , COLOR("gray")
ELSE
	CALL PRINTSBUTTON_C, "　[ +] スキル等级上昇", "+", FR_TALENT_COST:L_SELECT && CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:L_SELECT), , COLOR("gray")
ENDIF
LINE:1 = LINECOUNT
PRINTFORM %"", 14%
PRINTL 
PRINTBUTTON "　[ 9] 戻る", "9"
PRINTL 
PRINTL 
CALL INPUT_SPLIT, L_KEY
CLEARLINE LINECOUNT - LINE:1
ENCODETOUNI %RESULTS%
SIF L_SELECT == GET_KEYMARK_NUM(RESULTS)
	RESULTS = +
IF GET_KEYMARK_NUM(RESULTS) >= 0
	L_SELECT = GET_KEYMARK_NUM(RESULTS)
ELSE
	SELECTCASE RESULTS
		CASE "9"
			RETURN 0
		CASE "+"
			CLEARLINE LINECOUNT - LINE:1
			IF L_SELECT < 49
				IF FR_TALENT_COST:L_SELECT
					IF CFLAG:ARG:技能值 >= ABS(FR_TALENT_COST:L_SELECT)
						PRINTFORML 技能值を{ABS(FR_TALENT_COST:L_SELECT)}消費して、%FR_TALENTS:L_SELECT%の等级を\@(FR_TALENT_COST:L_SELECT) >= 0 ? {TALENT:ARG:(FR_TALENTS:L_SELECT)+1}にアップさせますか？ # {TALENT:ARG:(FR_TALENTS:L_SELECT)-1}にダウンさせますか？\@
						CALL INPUT_YN
						IF RESULT == 0
							TALENT:ARG:(FR_TALENTS:L_SELECT) += FR_TALENT_COST:L_SELECT > 0 ? 1 # -1
							CFLAG:ARG:技能值 -= ABS(FR_TALENT_COST:L_SELECT)
							CLEARLINE LINECOUNT - LINE:1
							PRINTFORML %CALLNAME:ARG%の%FR_TALENTS:L_SELECT%が{TALENT:ARG:(FR_TALENTS:L_SELECT)}になりました。
						ENDIF
					ELSE
						PRINTFORML %FR_TALENTS:L_SELECT%の等级を変更するには技能值が足りません。
					ENDIF
				ELSE
					IF TALENT:ARG:(FR_TALENTS:L_SELECT) == 3
						PRINTFORML %FR_TALENTS:L_SELECT%の等级をこれ以上アップさせることはできません。
					ELSE
						PRINTFORML %FR_TALENTS:L_SELECT%の等级をこれ以上ダウンさせることはできません。
					ENDIF
				ENDIF
			ELSE
				TEMPS = %FR_TALENTS:L_SELECT%
				TEMP = GET_NO("友人技能", TEMPS)
				IF FR_SKILL_LV:TEMP > 2
					PRINTFORML %FR_TALENTS:L_SELECT%の等级をこれ以上アップさせることはできません。
				ELSE
					IF GET_FRIEND_POINT(ARG) < AUTO_SPLIT_INT("30/50/80", "/", FR_SKILL_LV:TEMP)
						PRINTFORML %TEMPS%の等级をアップさせるには交友值が足りません。
					ELSEIF CFLAG:ARG:技能值 < FR_TALENT_COST:L_SELECT
						PRINTFORML %TEMPS%の等级をアップさせるには技能值が足りません。
					ELSE
						PRINTFORML 技能值を{FR_TALENT_COST:L_SELECT}消費して、%TEMPS%の等级を{FR_SKILL_LV:TEMP+1}にアップさせますか？
						CALL INPUT_YN
						IF RESULT == 0
							FR_SKILL_LV:TEMP += 1
							CFLAG:ARG:技能值 -= ABS(FR_TALENT_COST:L_SELECT)
							CLEARLINE LINECOUNT - LINE:1
							PRINTFORML %CALLNAME:ARG%の%TEMPS%が{FR_SKILL_LV:TEMP}になりました。
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			CALL EQUATE_LINE, LINE:1 + 3
			WAITANYKEY
	ENDSELECT
ENDIF
GOTO START

@FRIEND_SKILL_DOWNBASE, ARGS, ARG, ARG:1
ARGS = \@ISNUMERIC(ARGS) ? %GET_NAME("友人技能", TOINT(ARGS))% # %ARGS%\@
CALLFORM FRIEND_SKILL_DOWNBASE_%ARGS%, ARG, ARG:1
IF TRAIN_SKILL_POWER_体力消耗反转(ARG)
	RESULT:1 += TIMESF(RESULT, TRAIN_SKILL_POWER_体力消耗反转(ARG))
	RESULT -= TIMESF(RESULT, TRAIN_SKILL_POWER_体力消耗反转(ARG))
ENDIF
IF TRAIN_SKILL_POWER_气力消耗反转(ARG)
	RESULT += TIMESF(RESULT:1, TRAIN_SKILL_POWER_气力消耗反转(ARG))
	RESULT:1 -= TIMESF(RESULT:1, TRAIN_SKILL_POWER_气力消耗反转(ARG))
ENDIF
RETURN RESULT, RESULT:1

;---------------------------------------------------------------------
;@GET_FRIEND_SKILL_CUP
;调教技能によるCUP倍率を取得
;ARGS		CUPの名称
;ARG		主体角色
;ARG:1		客体角色
;---------------------------------------------------------------------
@GET_FRIEND_SKILL_CUP, ARGS, ARG = -1, ARG:1 = -1
#LOCALSIZE 1
#DIM L_RESULT, 2
SIF ISNUMERIC(ARGS)
	ARGS = %PALAMNAME:TOINT(ARGS)%
VARSET L_RESULT
FOR LOCAL, 0, 友人技能数
	SIF !FR_SKILL_USE:LOCAL
		CONTINUE
	VARSET RESULT, 0, 0, 2
	TRYCCALLFORM FRIEND_SKILL_CUP_%GET_NAME("友人技能", LOCAL)%, ARGS, ARG, ARG:1
		L_RESULT += RESULT
		L_RESULT:1 += RESULT:1
	CATCH
	ENDCATCH
NEXT
RETURN L_RESULT, L_RESULT:1
