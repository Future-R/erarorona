;@SET_INIT_STATUS		初期値セット関数
;---------------------------------------------------------------------
;@SET_INIT_STATUS
;初期値セット関数
;ARG		セットするキャラ
@SET_INIT_STATUS, ARG
;初期ステータス登録
CSTR:ARG:初期MAXBASE = 
FOR LOCAL, 0, VARSIZE("BASE")
	SIF MAXBASE:ARG:LOCAL
		CALL ADD_STRFLAG, @"CSTR:{ARG}:初期MAXBASE", BASENAME:LOCAL, MAXBASE:ARG:LOCAL
NEXT
CSTR:ARG:初期ABL = 
FOR LOCAL, 0, VARSIZE("ABL")
	SIF ABL:ARG:LOCAL
		CALL ADD_STRFLAG, @"CSTR:{ARG}:初期ABL", ABLNAME:LOCAL, ABL:ARG:LOCAL
NEXT
CSTR:ARG:初期TALENT = 
FOR LOCAL, 0, VARSIZE("TALENT")
	SIF TALENT:ARG:LOCAL
		CALL ADD_STRFLAG, @"CSTR:{ARG}:初期TALENT", TALENTNAME:LOCAL, TALENT:ARG:LOCAL
NEXT
CSTR:ARG:初期FEATURE = 
FOR LOCAL, 0, 特徴要素数
	CALL ADD_STRFLAG, @"CSTR:{ARG}:初期FEATURE", GET_NAME("特徴", LOCAL), CSTR:ARG:GET_NAME("特徴", LOCAL)
NEXT

