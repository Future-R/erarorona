@MARK_CUP_抗拒烙印, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "反感", "不快"
		RETURN 50, 100, 200
	CASE "恭顺"
		RETURN -50, -100, - 200
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@MARK_EXPLAIN_抗拒烙印
RESULTS = 无法忘却的反感与愤怒被烙印下的状态。/[反感]和[不快]的参数容易上升，[恭顺]的参数难以上升。/命令变得难以执行。

@GET_MARK_CUP, ARGS, ARG = -1, ARG:1 = -1
#LOCALSIZE 1
#DIM TEMP
#DIM L_RESULT, 2
SIF ISNUMERIC(ARGS)
	ARGS = %PALAMNAME:TOINT(ARGS)%
VARSET L_RESULT
FOR LOCAL, 0, VARSIZE("MARK")
	TEMP = MARK:ARG:LOCAL
	SIF !TEMP
		CONTINUE
	VARSET RESULT, 0, 0, 6
	TRYCCALLFORM MARK_CUP_%MARKNAME:LOCAL%, ARGS, ARG, ARG:1
		L_RESULT += RESULT:(TEMP - 1)
		L_RESULT:1 += RESULT:(TEMP + 2)
	CATCH
	ENDCATCH
NEXT
RETURN L_RESULT, L_RESULT:1
