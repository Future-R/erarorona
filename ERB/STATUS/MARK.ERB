@MARK_CUP_反発刻印, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "反感", "不快"
		RETURN 50, 100, 200
	CASE "恭順"
		RETURN -50, -100, - 200
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@MARK_EXPLAIN_反発刻印
RESULTS = 忘れられない反感や怒りが刻印されている状態。/[反感]と[不快]のパラメーターがあがりやすく、恭順のパラメーターがあがりにくい/命令を実行しにくくなる。

@GET_MARK_CUP, ARGS, ARG = -1, ARG:1 = -1
#LOCALSIZE 1
#DIM TEMP
#DIM L_RESULT, 2
SIF ISNUMERIC(ARGS)
	ARGS = %PALAMNAME:TOINT(ARGS)%
VARSET L_RESULT
FOR LOCAL, 0, VARSIZE("MARK")
	TEMP = MARK:ARG:LOCAL
	SIF !TEMP
		CONTINUE
	VARSET RESULT, 0, 0, 6
	TRYCCALLFORM MARK_CUP_%MARKNAME:LOCAL%, ARGS, ARG, ARG:1
		L_RESULT += RESULT:(TEMP - 1)
		L_RESULT:1 += RESULT:(TEMP + 2)
	CATCH
	ENDCATCH
NEXT
RETURN L_RESULT, L_RESULT:1
