;---------------------------------------------
;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@MARK_CUP_苦痛烙印, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "苦痛", "恐怖"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@MARK_EXPLAIN_苦痛烙印
RESULTS = 強い苦痛を受けた经验が刻印されている状态。/[苦痛]と[恐怖]のパラメーターがあがりやすい。/命令を実行しやすくなる。


