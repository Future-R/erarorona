;---------------------------------------------
;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@MARK_CUP_苦痛烙印, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "苦痛", "恐怖"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@MARK_EXPLAIN_苦痛烙印
RESULTS = 受到强烈痛苦的经验被烙印下的状态。/[苦痛]和[恐怖]的参数容易上升。/命令变得容易执行。


@MARK_CUP_快乐烙印, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "愉悦", "习得"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@MARK_EXPLAIN_快乐烙印
RESULTS = 受到激烈快感的经验被烙印下的状态。/[愉悦]和[习得]的参数容易上升。/命令变得容易执行。

