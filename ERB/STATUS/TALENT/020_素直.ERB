@TALENT_CUP_淳朴, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "恭顺"
		RETURN 25, 50, 75
	CASE "反感"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

