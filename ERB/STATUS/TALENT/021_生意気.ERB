@TALENT_CUP_自大, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "屈服"
		RETURN -15, -35, -45
	CASE "恭顺"
		RETURN -15, -35, -45
	CASE "反感"
		RETURN 20, 40, 60
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

