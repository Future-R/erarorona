;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_生意気, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "屈服"
		RETURN -15, -35, -45
	CASE "恭順"
		RETURN -15, -35, -45
	CASE "反感"
		RETURN 20, 40, 60
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_生意気
#FUNCTION
TALENT_COST = -3, -6, -9
@TALENT_EXPLAIN_生意気
RESULTS = 生意気で人の言うことを素直に受け入れられない性格。/[反感]のパラメーターがあがりやすく、[恭順]と[屈服]のパラメーターがあがりにくい。/命令を実行しにくくなる。

;相殺の定義
@TALENT_OFFSET_生意気
RETURN GETNUM(TALENT, "素直"), GETNUM(TALENT, "卑屈"), GETNUM(TALENT, "大人しい"), GETNUM(TALENT, "内気")
