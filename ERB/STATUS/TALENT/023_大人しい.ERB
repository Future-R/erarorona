;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_老实, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "恭顺", "屈服"
		RETURN -25, -50, -75
	CASE "反感", "不快"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT
@TALENT_COST_老实
#FUNCTION
TALENT_COST = 4, 7, 10
@TALENT_EXPLAIN_老实
RESULTS = 沉着安静的性格。/[反感]和[不快]的参数难以上升，[恭顺]和[屈服]的参数也难以上升。

;相殺の定義
@TALENT_OFFSET_老实
RETURN GETNUM(TALENT, "活泼"), GETNUM(TALENT, "自大"), GETNUM(TALENT, "任性")
