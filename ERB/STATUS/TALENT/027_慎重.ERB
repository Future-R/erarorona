@TALENT_CUP_慎重, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "恭順", "悦楽", "習得"
		RETURN -20, -40, -60
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

