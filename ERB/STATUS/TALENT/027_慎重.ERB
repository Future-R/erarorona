;---------------------------------------------
;CUP的加成值
;ARGS 	CUP的名称
;ARG	素质的持有者
;ARG:1	正在调教那个素质的人物
;---------------------------------------------
@TALENT_CUP_慎重, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "恭顺", "愉悦", "习得"
		RETURN -20, -40, -60
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_慎重
#FUNCTION
TALENT_COST = -2, -4, -7
@TALENT_EXPLAIN_慎重
RESULTS = 对于变化警惕的谨慎性格。/[习得]、[恭顺]和[愉悦]的参数难以上升。

; 冲突特质
@TALENT_OFFSET_慎重
RETURN GETNUM(TALENT, "活泼"), GETNUM(TALENT, "好奇心"), GETNUM(TALENT, "大胆")
