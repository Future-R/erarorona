;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_臆病, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "恐怖"
		RETURN 30, 60, 90
	CASE "苦痛"
		RETURN 20, 40, 60
	CASE "反感"
		RETURN -20, -40, -60
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_臆病
#FUNCTION
TALENT_COST = 2, 4, 6
@TALENT_EXPLAIN_臆病
RESULTS = 臆病で人を恐れやすい性格。/[恐怖]と[苦痛]のパラメーターがあがりやすく、[反感]のパラメーターがあがりにくい。

;相殺の定義
@TALENT_OFFSET_臆病
