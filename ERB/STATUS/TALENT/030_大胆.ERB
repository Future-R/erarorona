;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_大胆, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "悦楽"
		RETURN 15, 30, 45
	CASE "恐怖", "不快"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_大胆, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "逸脱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT
@TALENT_COST_大胆
#FUNCTION
TALENT_COST = 2, 4, 6
@TALENT_EXPLAIN_大胆
RESULTS = 度胸がすわっており、思い切りのよい性格。/[悦楽]のパラメーターがあがりやすく、[不快]と[恐怖]のパラメーターがあがりにくい/[逸脱]のソースが減少する。

;相殺の定義
@TALENT_OFFSET_大胆
