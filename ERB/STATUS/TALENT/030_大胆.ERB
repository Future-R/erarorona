;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_大胆, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "愉悦"
		RETURN 15, 30, 45
	CASE "恐怖", "不快"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_大胆, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "逃脱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT
@TALENT_COST_大胆
#FUNCTION
TALENT_COST = 2, 4, 6
@TALENT_EXPLAIN_大胆
RESULTS = 有胆量，果断的性格。/[愉悦]的参数容易上升，[不快]和[恐怖]的参数难以上升/[逃脱]的来源被减少。

