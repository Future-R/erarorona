;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_勇敢, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "恭顺", "愉悦", "屈服"
		RETURN -25, -50, -75
	CASE "反感", "抑郁"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_勇敢, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "逃脱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT
@TALENT_COST_勇敢
#FUNCTION
TALENT_COST = -8, -12, -16

@TALENT_EXPLAIN_勇敢
RESULTS = 心持ちがしっかりした、強い性格。/[反感]と抑郁のパラメーターがあがりやすく、/[恭顺]と[愉悦]と[屈服]のパラメーターがあがりにくい。/指令が実行しにくくなる。

