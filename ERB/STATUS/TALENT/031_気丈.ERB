;---------------------------------------------
;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_気丈, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "恭順", "悦楽", "屈服"
		RETURN -25, -50, -75
	CASE "反感", "抑鬱"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_気丈, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "逸脱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT
@TALENT_COST_気丈
#FUNCTION
TALENT_COST = -8, -12, -16

@TALENT_EXPLAIN_気丈
RESULTS = 心持ちがしっかりした、強い性格。/[反感]と抑鬱のパラメーターがあがりやすく、/[恭順]と[悦楽]と[屈服]のパラメーターがあがりにくい。/コマンドが実行しにくくなる。

;相殺の定義
@TALENT_OFFSET_気丈
RETURN GETNUM(TALENT, "臆病"), GETNUM(TALENT, "内気"), GETNUM(TALENT, "卑屈")
