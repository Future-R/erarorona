;---------------------------------------------
;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_坚强, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "恭顺", "愉悦", "屈服"
		RETURN -25, -50, -75
	CASE "反感", "抑郁"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_坚强, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "逃脱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT
@TALENT_COST_坚强
#FUNCTION
TALENT_COST = -8, -12, -16

@TALENT_EXPLAIN_坚强
RESULTS = 意志坚定、刚强的性格。/[反感]和[抑郁]的参数容易上升，/[恭顺]、[愉悦]和[屈服]的参数难以上升。/指令变得难以执行。

;相殺の定義
@TALENT_OFFSET_坚强
