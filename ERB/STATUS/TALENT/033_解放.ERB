@TALENT_CUP_解放, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "屈服", "悦楽"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_解放, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASE "逸脱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

