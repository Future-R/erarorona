;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_抑圧, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	;抑圧
	CASE "悦楽"
			RETURN -25, -50, -75
	CASE "反感", "抑鬱"
		RETURN 30, 60, 90
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_抑圧, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_抑圧
#FUNCTION
TALENT_COST = -8, -12, -16
@TALENT_EXPLAIN_抑圧
RESULTS = 悦びにたいして強い抵抗を持つ性格。/[反感]と[抑鬱]のパラメーターがあがりやすい。[悦楽]のパラメーターがあがりにくい。/[鬱屈]のソースが追加される。コマンドが実行しにくくなる。

@TALENT_OFFSET_抑圧
