@TALENT_CUP_压抑, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	;压抑
	CASE "愉悦"
			RETURN -25, -50, -75
	CASE "反感", "抑郁"
		RETURN 30, 60, 90
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_SOURCE_压抑, ARGS, ARG = -1, ARG:2 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

