;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_高慢, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "反感", "抑鬱"
		RETURN 25, 50, 75
	CASE "屈服", "恐怖", "恭順"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_高慢
#FUNCTION
TALENT_COST = -4, -7, -10
@TALENT_EXPLAIN_高慢
RESULTS = プライドが高く他人を見下している性格。/[反感][抑鬱]のパラメーターがあがりやすく、/[屈服][恭順][恐怖]のパラメーターがあがりにくい。

@TALENT_OFFSET_高慢
RETURN GETNUM(TALENT, "卑屈")
