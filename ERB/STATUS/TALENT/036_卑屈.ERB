;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_卑屈, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "屈服", "恐怖", "恭順"
		RETURN 25, 50, 75
	CASE "反感", "抑鬱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_卑屈
#FUNCTION
TALENT_COST = 4, 7, 10
@TALENT_EXPLAIN_卑屈
RESULTS = プライドが低く他人を恐れている性格。/[屈服][恭順][恐怖]のパラメーターがあがりやすく、/[反感][抑鬱]のパラメーターがあがりにくい。/命令を実行しにくくなる。

@TALENT_OFFSET_卑屈
RETURN GETNUM(TALENT, "気丈"), GETNUM(TALENT, "高慢"), GETNUM(TALENT, "生意気"), GETNUM(TALENT, "わがまま"), GETNUM(TALENT, "意地っ張り")
