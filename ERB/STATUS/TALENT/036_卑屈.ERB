@TALENT_CUP_自卑, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "屈服", "恐怖", "恭顺"
		RETURN 25, 50, 75
	CASE "反感", "抑郁"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_自卑
#FUNCTION
TALENT_COST = 4, 7, 10
@TALENT_EXPLAIN_自卑
RESULTS = 自尊心低，害怕别人的性格。/[屈服]、[恭顺]和[恐怖]的参数容易上升，/[反感]和[抑郁]的参数难以上升。/命令变得难以执行。

@TALENT_OFFSET_自卑
RETURN GETNUM(TALENT, "坚强"), GETNUM(TALENT, "傲慢"), GETNUM(TALENT, "自大"), GETNUM(TALENT, "任性"), GETNUM(TALENT, "倔强")
