@TALENT_CUP_无情的, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "恭顺", "愉悦", "屈服", "耻情", "恐怖", "反感", "不快", "抑郁"
		RETURN -15, -30, -45
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_无情的
#FUNCTION
TALENT_COST = -5, -8, -11
@TALENT_EXPLAIN_无情的
RESULTS = 感情が動きにくい性格。/[恭顺][愉悦][屈服][耻情][恐怖][反感][不快][抑郁]のパラメーターがあがりにくい。

@TALENT_OFFSET_无情的
RETURN GETNUM(TALENT, "有情的"), GETNUM(TALENT, "急躁"), GETNUM(TALENT, "容易寂寞"), GETNUM(TALENT, "梦想家")
