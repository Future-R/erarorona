;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_容易寂寞, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "恭顺", "愉悦", "屈服", "恐怖"
		RETURN 30, 45, 60
	CASE "反感", "不快"
		RETURN -30, -45, -60
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_容易寂寞
#FUNCTION
TALENT_COST = 4, 8, 12
@TALENT_EXPLAIN_容易寂寞
RESULTS = 人を恋しく思う気持ちが強い性格。/[恭顺][愉悦][屈服][恐怖]のパラメーターがあがりやすく、/[反感][不快]のパラメーターがあがりにくい。

@TALENT_OFFSET_容易寂寞
RETURN GETNUM(TALENT, "冷漠"), GETNUM(TALENT, "无情的"), GETNUM(TALENT, "冷淡"), GETNUM(TALENT, "自制的"), GETNUM(TALENT, "顽固")
