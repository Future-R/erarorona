;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_寂しがり屋, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "恭順", "悦楽", "屈服", "恐怖"
		RETURN 30, 45, 60
	CASE "反感", "不快"
		RETURN -30, -45, -60
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_寂しがり屋
#FUNCTION
TALENT_COST = 4, 8, 12
@TALENT_EXPLAIN_寂しがり屋
RESULTS = 人を恋しく思う気持ちが強い性格。/[恭順][悦楽][屈服][恐怖]のパラメーターがあがりやすく、/[反感][不快]のパラメーターがあがりにくい。

@TALENT_OFFSET_寂しがり屋
RETURN GETNUM(TALENT, "無関心"), GETNUM(TALENT, "無感動"), GETNUM(TALENT, "冷淡"), GETNUM(TALENT, "自制的"), GETNUM(TALENT, "頑な")
