;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_享楽的, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "悦楽"
		RETURN 25, 50, 75
	CASE "抑鬱"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_享楽的
#FUNCTION
TALENT_COST = 5, 8, 12
@TALENT_EXPLAIN_享楽的
RESULTS = 快感に素直な性格。/[悦楽]のパラメーターがあがりやすく、[抑鬱]のパラメーターがあがりにくい。/[悦楽]のソースから[恭順]と[屈従]のソースが発生する。

@TALENT_OFFSET_享楽的
RETURN GETNUM(TALENT, "禁欲的"), GETNUM(TALENT, "抑圧")
