;---------------------------------------------
;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_享乐主义, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "愉悦"
		RETURN 25, 50, 75
	CASE "抑郁"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_享乐主义
#FUNCTION
TALENT_COST = 5, 8, 12
@TALENT_EXPLAIN_享乐主义
RESULTS = 对快感坦率的性格。/[愉悦]的参数容易上升，[抑郁]的参数难以上升。/[愉悦]的来源会追加[恭顺]和[屈从]的来源。

@TALENT_OFFSET_享乐主义
RETURN GETNUM(TALENT, "禁欲主义"), GETNUM(TALENT, "压抑")
