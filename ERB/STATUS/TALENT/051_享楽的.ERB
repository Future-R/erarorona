;---------------------------------------------
;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_享乐主义, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "愉悦"
		RETURN 25, 50, 75
	CASE "抑郁"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_享乐主义
#FUNCTION
TALENT_COST = 5, 8, 12
@TALENT_EXPLAIN_享乐主义
RESULTS = 快感に淳朴な性格。/[愉悦]のパラメーターがあがりやすく、[抑郁]のパラメーターがあがりにくい。/[愉悦]のソースから[恭顺]と[屈从]のソースが発生する。

@TALENT_OFFSET_享乐主义
RETURN GETNUM(TALENT, "禁欲主义"), GETNUM(TALENT, "压抑")
