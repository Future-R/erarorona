;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_禁欲主义, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "抑郁"
		RETURN 25, 50, 75
	CASE "愉悦"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_禁欲主义
#FUNCTION
TALENT_COST = -5, -7, -12
@TALENT_EXPLAIN_禁欲主义
RESULTS = 否定快感的性格。/[愉悦]的参数难以上升，[抑郁]的参数容易上升。/[愉悦]的来源会追加[郁闷]的来源。

@TALENT_OFFSET_禁欲主义
RETURN GETNUM(TALENT, "享乐主义"), GETNUM(TALENT, "解放")
