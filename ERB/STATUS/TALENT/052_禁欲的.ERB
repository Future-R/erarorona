;CUPの補正値
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_禁欲的, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "抑鬱"
		RETURN 25, 50, 75
	CASE "悦楽"
		RETURN -25, -50, -75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_禁欲的
#FUNCTION
TALENT_COST = -5, -7, -12
@TALENT_EXPLAIN_禁欲的
RESULTS = 快感に否定的な性格。/[悦楽]のパラメーターがあがりにくく、[抑鬱]のパラメーターがあがりやすい。/[悦楽]のソースから[鬱屈]のソースが発生する。

@TALENT_OFFSET_禁欲的
RETURN GETNUM(TALENT, "享楽的"), GETNUM(TALENT, "解放")
