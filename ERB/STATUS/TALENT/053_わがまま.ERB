;---------------------------------------------
;CUPの加成值
;ARGS 	CUPの名称
;ARG	素質の所持者
;ARG:1	その素質を調教している人物
;---------------------------------------------
@TALENT_CUP_任性, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "屈服", "恭顺"
		RETURN -25, -50, -75
	CASE "习得"
		RETURN -10, -20, -30
	CASE "反感"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_任性
#FUNCTION
TALENT_COST = -5, -7, -12
@TALENT_EXPLAIN_任性
RESULTS = 人に指図されるのを嫌い、自分の思う通りにならないことが許せない性格。/[屈服][恭顺][习得]のパラメーターがあがりにくく、[反感]のパラメーターがあがりやすい/コマンドを実行しにくい。

@TALENT_OFFSET_任性
RETURN GETNUM(TALENT, "淳朴"), GETNUM(TALENT, "自卑"), GETNUM(TALENT, "老实"), GETNUM(TALENT, "献身的")
