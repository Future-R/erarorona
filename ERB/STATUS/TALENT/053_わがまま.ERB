@TALENT_CUP_わがまま, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "屈服", "恭順"
		RETURN -25, -50, -75
	CASE "習得"
		RETURN -10, -20, -30
	CASE "反感"
		RETURN 25, 50, 75
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

