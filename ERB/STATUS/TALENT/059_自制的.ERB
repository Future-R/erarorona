@TALENT_CUP_自制的, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ", "恐怖", "屈服"
		RETURN -15, -30, -45
	CASE "反感"
		RETURN 15, 30, 45
	CASEELSE
		RETURN 0, 0, 0
ENDSELECT

@TALENT_COST_自制的
