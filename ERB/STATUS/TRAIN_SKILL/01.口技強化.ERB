@TRAIN_SKILL_NAME_1
RESULTS = 口活加成

@TRAIN_SKILL_EXPLAIN_口活加成
RESULTS = 口技属性のコマンドの效果が増減する。

;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_口活加成, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += GET_TALENT("擅长口活", ARG) * 50 - GET_TALENT("不擅口活", ARG) * 50
LOCAL += TRAIN_STATE_POWER_口活强化(ARG, ARG:1, ARG:2)
SIF GET_NAME("商店", FLAG:商店指令) == "调教"
	LOCAL += TRAIN_SKILL_POWER_英雄の心(ARG) * TCVAR:(ARG == PLAYER ? TARGET # PLAYER):调教难读 / 100
LOCAL += TRAIN_SKILL_POWER_恭顺の力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:恭顺, 20) * GETPALAMLV(PALAM:ARG:恭顺, 20) / 100
LOCAL += TRAIN_SKILL_POWER_屈服の力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:屈服, 20) * GETPALAMLV(PALAM:ARG:屈服, 20) / 100
SIF ARG != MASTER
	LOCAL += EQUIP:ARG:口活加成
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

