@TRAIN_SKILL_NAME_2
RESULTS = 性交加成

@TRAIN_SKILL_EXPLAIN_性交加成
RESULTS = 增加或减少性交属性指令的效果。

;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_性交加成, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += GET_TALENT("擅长性交", ARG) * 50 - GET_TALENT("不擅性交", ARG) * 50
LOCAL += TRAIN_STATE_POWER_性交强化(ARG, ARG:1, ARG:2)
SIF GET_NAME("SHOP", FLAG:SHOP指令) == "调教"
	LOCAL += TRAIN_SKILL_POWER_英雄之心(ARG) * TCVAR:(ARG == PLAYER ? TARGET # PLAYER):调教难读 / 100
LOCAL += TRAIN_SKILL_POWER_恭顺之力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:恭顺, 20) * GETPALAMLV(PALAM:ARG:恭顺, 20) / 100
LOCAL += TRAIN_SKILL_POWER_屈服之力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:屈服, 20) * GETPALAMLV(PALAM:ARG:屈服, 20) / 100
SIF ARG != MASTER
	LOCAL += EQUIP:ARG:性交加成
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

