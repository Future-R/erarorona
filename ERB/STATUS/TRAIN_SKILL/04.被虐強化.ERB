@TRAIN_SKILL_NAME_4
RESULTS = 受虐加成

@TRAIN_SKILL_EXPLAIN_受虐加成
RESULTS = 受虐属性の指令の效果が増減する。

;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_受虐加成, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += GET_TALENT("擅长受虐", ARG) * 50 - GET_TALENT("不擅受虐", ARG) * 50
LOCAL += TRAIN_STATE_POWER_受虐强化(ARG, ARG:1, ARG:2)
SIF GET_NAME("商店", FLAG:商店指令) == "调教"
	LOCAL += TRAIN_SKILL_POWER_英雄之心(ARG) * TCVAR:(ARG == PLAYER ? TARGET # PLAYER):调教难读 / 100
LOCAL += TRAIN_SKILL_POWER_恭顺の力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:恭顺, 20) * GETPALAMLV(PALAM:ARG:恭顺, 20) / 100
LOCAL += TRAIN_SKILL_POWER_屈服之力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:屈服, 20) * GETPALAMLV(PALAM:ARG:屈服, 20) / 100
SIF ARG != MASTER
	LOCAL += EQUIP:ARG:受虐加成
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

