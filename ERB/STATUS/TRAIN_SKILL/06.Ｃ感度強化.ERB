@TRAIN_SKILL_NAME_6
RESULTS = Ｃ感度強化

@TRAIN_SKILL_EXPLAIN_Ｃ感度強化
RESULTS = Ｃに受ける快感が増加する。

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_Ｃ感度強化, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
SIF ARG != MASTER
	LOCAL += EQUIP:ARG:Ｃ感度補正
;LOCAL += TRAIN_STATE_POWER_快Ｃ増加(ARG, ARG:1, ARG:2)
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL


@TRAIN_SKILL_SOURCE_Ｃ感度強化, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN TRAIN_SKILL_POWER_Ｃ感度強化(ARG, ARG:1)
ENDSELECT
