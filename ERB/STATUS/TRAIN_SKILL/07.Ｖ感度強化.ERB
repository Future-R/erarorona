@TRAIN_SKILL_NAME_7
RESULTS = Ｖ感度强化

@TRAIN_SKILL_EXPLAIN_Ｖ感度强化
RESULTS = Ｖに受ける快感が増加する。

;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_Ｖ感度强化, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
SIF ARG != MASTER
	LOCAL += EQUIP:ARG:Ｖ感度加成
;LOCAL += TRAIN_STATE_POWER_快Ｖ増加(ARG, ARG:1, ARG:2)
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

@TRAIN_SKILL_SOURCE_Ｖ感度强化, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "快Ｖ"
		RETURN TRAIN_SKILL_POWER_Ｖ感度强化(ARG, ARG:1)
ENDSELECT

