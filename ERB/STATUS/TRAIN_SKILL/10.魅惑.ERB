@TRAIN_SKILL_NAME_10
RESULTS = 魅惑

@TRAIN_SKILL_EXPLAIN_魅惑
RESULTS = 調教相手を魅惑し、好意を持たせる。/調教対象の[恭顺][愉悦]のパラメーターがあがりやすくなる/調教対象の[反感]があがりにくくなる。指令を実行させやすくなる。

;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_魅惑, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += GET_TALENT("魅力", ARG) * 15
SIF ARG != MASTER
	LOCAL += EQUIP:ARG:诱惑加成
LOCAL += EQUIP:ARG:魅惑加成
LOCAL += TRAIN_STATE_POWER_诱惑强化(ARG, ARG:1, ARG:2)
SIF GET_NAME("商店", FLAG:商店指令) == "调教"
	LOCAL += TRAIN_SKILL_POWER_英雄之心(ARG) * TCVAR:(ARG == PLAYER ? TARGET # PLAYER):调教难读 / 100
LOCAL += TRAIN_SKILL_POWER_恭顺之力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:恭顺, 20) * GETPALAMLV(PALAM:ARG:恭顺, 20) / 100
LOCAL += TRAIN_SKILL_POWER_屈服之力(ARG, ARG:1, ARG:2) * GETPALAMLV(PALAM:ARG:屈服, 20) * GETPALAMLV(PALAM:ARG:屈服, 20) / 100

SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_SKILL_CUP_魅惑, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "愉悦", "恭顺"
		RETURN 0, TRAIN_SKILL_POWER_魅惑(ARG, ARG:1)
	CASE "反感"
		RETURN 0, -TRAIN_SKILL_POWER_魅惑(ARG, ARG:1)
ENDSELECT
