@TRAIN_SKILL_NAME_20
RESULTS = 恢复力

@TRAIN_SKILL_EXPLAIN_恢复力
RESULTS = 回復物品を使用した際の效果が増減する。

;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_恢复力, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += GET_TALENT("健康的", ARG) * 50 - GET_TALENT("梦幻泡影", ARG) * 50
LOCAL += EQUIP:ARG:恢复力
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

