@TRAIN_SKILL_NAME_20
RESULTS = 回復力

@TRAIN_SKILL_EXPLAIN_回復力
RESULTS = 回復アイテムを使用した際の効果が増減する。

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_回復力, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += GET_TALENT("健康的", ARG) * 50 - GET_TALENT("儚げ", ARG) * 50
LOCAL += EQUIP:ARG:回復力
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

