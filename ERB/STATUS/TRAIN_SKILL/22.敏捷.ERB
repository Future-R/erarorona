@TRAIN_SKILL_NAME_22
RESULTS = 敏捷

@TRAIN_SKILL_EXPLAIN_敏捷
RESULTS = 機敏に動けることを示す。/行動による経過時間を大幅に減少させる。

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;ARG:3	アイテムの登録番号
;--------------------------------
@TRAIN_SKILL_POWER_敏捷, ARG, ARG:1, ARG:2, ARG:3 = -1
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
IF ARG:3 >= 0
	SIF FR_SKILL_USE:GET_NO("フレンドスキル", "クイックユーズ")
		LOCAL += FR_SKILL_LV:GET_NO("フレンドスキル", "クイックユーズ") * 50
ELSE
	LOCAL += EQUIP:ARG:敏捷
ENDIF
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

