@TRAIN_SKILL_NAME_23
RESULTS = 复苏力

@TRAIN_SKILL_EXPLAIN_复苏力
RESULTS = 每回合恢复体力。

;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の调教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_复苏力, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += EQUIP:ARG:复苏力
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

