@TRAIN_SKILL_NAME_31
RESULTS = 平稳

@TRAIN_SKILL_EXPLAIN_平稳
RESULTS = 心情平静，防止情绪低落。/防止[抑郁]上升。

;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_平稳, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += EQUIP:ARG:平稳符文
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_SKILL_CUP_平稳, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "抑郁"
		RETURN  -TRAIN_SKILL_POWER_平稳(ARG, ARG:1), 0
ENDSELECT


