@TRAIN_SKILL_NAME_31
RESULTS = 平穏

@TRAIN_SKILL_EXPLAIN_平穏
RESULTS = 心が安らぎ、気持ちが沈むのを防ぐ。/[抑郁]が上昇するのを防ぐ。

;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_平穏, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += EQUIP:ARG:平稳卢恩
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_SKILL_CUP_平穏, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "抑郁"
		RETURN  -TRAIN_SKILL_POWER_平穏(ARG, ARG:1), 0
ENDSELECT


