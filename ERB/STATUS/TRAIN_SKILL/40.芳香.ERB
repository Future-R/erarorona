@TRAIN_SKILL_NAME_40
RESULTS = 芳香

@TRAIN_SKILL_EXPLAIN_芳香
RESULTS = 場に芳香が満ちる。/全体的に[不快]があがりづらくなる

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_芳香, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += EQUIP:ARG:芳香
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_SKILL_CUP_芳香, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "不快"
		RETURN  -TRAIN_SKILL_POWER_芳香(ARG, ARG:1), -TRAIN_SKILL_POWER_芳香(ARG, ARG:1)
ENDSELECT


