@TRAIN_SKILL_NAME_51
RESULTS = 暴击

@TRAIN_SKILL_EXPLAIN_暴击
RESULTS = 玩弄对方敏感部位时效果上升。

;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_暴击, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += EQUIP:ARG:暴击
SIF FR_SKILL_USE:GET_NO("友人技能", "特务之眼") && ARG == MASTER
	LOCAL += AUTO_SPLIT_INT("30_60_100", "_", FR_SKILL_LV:GET_NO("友人技能", "特务之眼"))
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

@TRAIN_SKILL_CUP_暴击, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		IF GET_TALENT("Ｃ敏感", ARG)
			RETURN TRAIN_SKILL_POWER_暴击(ARG:1, ARG)
		ELSE
			RETURN 0
		ENDIF
	CASE "快Ｖ"
		IF GET_TALENT("Ｖ敏感", ARG)
			RETURN TRAIN_SKILL_POWER_暴击(ARG:1, ARG)
		ELSE
			RETURN 0
		ENDIF
	CASE "快Ａ"
		IF GET_TALENT("Ａ敏感", ARG)
			RETURN TRAIN_SKILL_POWER_暴击(ARG:1, ARG)
		ELSE
			RETURN 0
		ENDIF
	CASE "快Ｂ"
		IF GET_TALENT("Ｂ敏感", ARG)
			RETURN TRAIN_SKILL_POWER_暴击(ARG:1, ARG)
		ELSE
			RETURN 0
		ENDIF
ENDSELECT
