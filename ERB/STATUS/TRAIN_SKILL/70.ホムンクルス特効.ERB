@TRAIN_SKILL_NAME_70
RESULTS = ホムンクルス特効

@TRAIN_SKILL_EXPLAIN_ホムンクルス特効
RESULTS = ホムンクルスに対する調教効果が上昇する。

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_ホムンクルス特効, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += EQUIP:ARG:ホムンクルス特効
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL


;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_SKILL_CUP_ホムンクルス特効, ARGS, ARG = -1, ARG:1 = -1
SIF ARG:1 == -1
	RETURN 0
SIF NICKNAME:(ARG:1) != "ホムくん" && NICKNAME:(ARG:1) != "ホムちゃん" && CFLAG:(ARG:1):人間
	RETURN 0
SELECTCASE ARGS
	CASE "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ"
		RETURN TRAIN_SKILL_POWER_ホムンクルス特効(ARG, ARG:1)
	CASE "屈服", "恭順"
		RETURN TRAIN_SKILL_POWER_ホムンクルス特効(ARG, ARG:1)
	CASE "反感", "不快", "抑鬱"
		RETURN -TRAIN_SKILL_POWER_ホムンクルス特効(ARG, ARG:1)
ENDSELECT