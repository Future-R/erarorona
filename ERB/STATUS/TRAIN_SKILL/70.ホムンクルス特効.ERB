@TRAIN_SKILL_NAME_70
RESULTS = 霍姆克鲁斯特效

@TRAIN_SKILL_EXPLAIN_霍姆克鲁斯特效
RESULTS = ホムンクルスに対する調教效果が上昇する。

;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_霍姆克鲁斯特效, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += EQUIP:ARG:霍姆克鲁斯特效
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL


;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_SKILL_CUP_霍姆克鲁斯特效, ARGS, ARG = -1, ARG:1 = -1
SIF ARG:1 == -1
	RETURN 0
SIF NICKNAME:(ARG:1) != "霍姆弟弟" && NICKNAME:(ARG:1) != "霍姆妹妹" && CFLAG:(ARG:1):人类
	RETURN 0
SELECTCASE ARGS
	CASE "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ"
		RETURN TRAIN_SKILL_POWER_霍姆克鲁斯特效(ARG, ARG:1)
	CASE "屈服", "恭顺"
		RETURN TRAIN_SKILL_POWER_霍姆克鲁斯特效(ARG, ARG:1)
	CASE "反感", "不快", "抑郁"
		RETURN -TRAIN_SKILL_POWER_霍姆克鲁斯特效(ARG, ARG:1)
ENDSELECT