@TRAIN_SKILL_NAME_81
RESULTS = 師弟愛

@TRAIN_SKILL_EXPLAIN_師弟愛
RESULTS = アストリッドにロロナに対するただならぬ愛情。/ロロナに対してコマンドの実行判定を行わない。/また、ロロナに対するコマンドの効果が上昇する。

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;ARG:2	CALLFORMでの呼び出し用
;--------------------------------
@TRAIN_SKILL_POWER_師弟愛, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = NICKNAME:ARG == "アストリッド" ? 100 # 0
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_SKILL_CUP_師弟愛, ARGS, ARG = -1, ARG:1 = -1
SIF ARG == -1 || ARG:1 == -1
	RETURN 0
SIF !(NICKNAME:(ARG:1) == "ロロナ")
	RETURN 0
SIF !TRAIN_SKILL_POWER_師弟愛(ARG, ARG:1)
	RETURN 0
SELECTCASE ARGS
	CASE "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ", "屈服", "恭順"
		RETURN 0, 100
	CASE "反感", "不快", "抑鬱"
		RETURN 0, -100
ENDSELECT
