@TRAIN_STATE_NAME_1
RESULTS = 反感軽減

@TRAIN_STATE_EXPLAIN_反感軽減
RESULTS = 一時的に反感が軽減される。

@TRAIN_STATE_POWER_反感軽減, ARG = -1, ARG:1 = -1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += CFLAG:ARG:天然味
LOCAL += TCVAR:ARG:软筋香
LOCAL += TCVAR:ARG:抵抗力夺取
;表示時は反転させておく
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_STATE_CUP_反感軽減, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "反感"
		RETURN -TRAIN_STATE_POWER_反感軽減(ARG, ARG:1)
ENDSELECT

@TRAIN_STATE_IS_SHOW_反感軽減
RETURN 1
