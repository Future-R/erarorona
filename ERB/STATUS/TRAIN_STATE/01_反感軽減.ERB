@TRAIN_STATE_NAME_1
RESULTS = 反感降低

@TRAIN_STATE_EXPLAIN_反感降低
RESULTS = 暂时降低反感。

@TRAIN_STATE_POWER_反感降低, ARG = -1, ARG:1 = -1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += CFLAG:ARG:朴素的味道
LOCAL += TCVAR:ARG:软筋香
LOCAL += TCVAR:ARG:抵抗力夺取
;表示時は反転させておく
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の调教者
;--------------------------------
@TRAIN_STATE_CUP_反感降低, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "反感"
		RETURN -TRAIN_STATE_POWER_反感降低(ARG, ARG:1)
ENDSELECT

@TRAIN_STATE_IS_SHOW_反感降低
RETURN 1
