@TRAIN_STATE_NAME_2
RESULTS = 恭順追加

@TRAIN_STATE_EXPLAIN_恭順追加
RESULTS = 調教開始時にパラメーター[恭順]が追加される。

;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;ARG:2	FORMで呼ばれたことを示し、RESULTにタッチする
;--------------------------------
@TRAIN_STATE_POWER_恭順追加, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += CFLAG:ARG:甘味
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

@TRAIN_STATE_ADD_CUP_恭順追加, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "恭順"
		RETURN TRAIN_STATE_POWER_恭順追加(ARG, ARG:1)
ENDSELECT

