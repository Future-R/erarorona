@TRAIN_STATE_NAME_4
RESULTS = 气力消耗降低

@TRAIN_STATE_EXPLAIN_气力消耗降低
RESULTS = 暂时降低气力的消耗。

;--------------------------------
;ARG	调教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	FORMで呼ばれたことを示し、RESULTにタッチする
;--------------------------------
@TRAIN_STATE_POWER_气力消耗降低, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += CFLAG:ARG:清爽味
LOCAL += TCVAR:ARG:气力消耗降低
LOCAL += TCVAR:ARG:安神香 % 10000
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

@TRAIN_STATE_IS_SHOW_气力消耗降低
RETURN 1
