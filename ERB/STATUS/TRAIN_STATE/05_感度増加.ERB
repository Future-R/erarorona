@TRAIN_STATE_NAME_5
RESULTS = 感度増加

@TRAIN_STATE_EXPLAIN_感度増加
RESULTS = 一時的に受ける快感が増加する。

@TRAIN_STATE_POWER_感度増加, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += CFLAG:ARG:怪しい味
LOCAL += TCVAR:ARG:媚薬
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARGS	SOURCE名
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_STATE_CUP_感度増加, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ"
		RETURN TRAIN_STATE_POWER_感度増加(ARG, ARG:1)
ENDSELECT

