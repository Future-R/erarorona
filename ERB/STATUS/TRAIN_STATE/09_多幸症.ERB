@TRAIN_STATE_NAME_9
RESULTS = 欣快症

@TRAIN_STATE_EXPLAIN_欣快症
RESULTS = 被幸福感包围的状态。/[恭顺]、[愉悦]和[屈服]的参数变得容易增加。


@TRAIN_STATE_POWER_欣快症, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += TCVAR:ARG:幸福感
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARGS	PALAM名
;ARG	調教状态変化の対象
;ARG:1	その時の调教者
;--------------------------------
@TRAIN_STATE_CUP_欣快症, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "恭顺", "愉悦", "屈服"
		RETURN TRAIN_STATE_POWER_欣快症(ARG, ARG:1)
ENDSELECT

