@TRAIN_STATE_NAME_17
RESULTS = 快Ｖ増加

@TRAIN_STATE_EXPLAIN_快Ｖ増加
RESULTS = 一時的に快Ｖの獲得量があがっている状态。


@TRAIN_STATE_POWER_快Ｖ増加, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += CFLAG:ARG:Ｖ快感增加
LOCAL += TCVAR:ARG:感染的音色
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARGS	SOURCE名
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_STATE_CUP_快Ｖ増加, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "快Ｖ"
		RETURN TRAIN_STATE_POWER_快Ｖ増加(ARG, ARG:1)
ENDSELECT

@TRAIN_STATE_IS_SHOW_快Ｖ増加
RETURN 1

