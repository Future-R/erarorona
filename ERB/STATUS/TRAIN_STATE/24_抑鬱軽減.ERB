@TRAIN_STATE_NAME_24
RESULTS = 抑郁降低

@TRAIN_STATE_EXPLAIN_抑郁降低
RESULTS = 一時的に抑郁が軽減される。

@TRAIN_STATE_POWER_抑郁降低, ARG = -1, ARG:1 = -1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += TCVAR:ARG:抑郁降低
;表示時は反転させておく
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_STATE_CUP_抑郁降低, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "抑郁"
		RETURN -TRAIN_STATE_POWER_抑郁降低(ARG, ARG:1)
ENDSELECT

@TRAIN_STATE_IS_SHOW_抑郁降低
RETURN 1
