@TRAIN_STATE_NAME_25
RESULTS = 恐怖増加

@TRAIN_STATE_EXPLAIN_恐怖増加
RESULTS = 恐怖のパラメーターの獲得量が増加する。

@TRAIN_STATE_POWER_恐怖増加, ARG = -1, ARG:1 = -1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += TCVAR:ARG:破滅的な音色
;表示時は反転させておく
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL
;--------------------------------
;ARG	調教状態変化の対象
;ARG:1	その時の調教者
;--------------------------------
@TRAIN_STATE_CUP_恐怖増加, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASE "恐怖"
		RETURN TRAIN_STATE_POWER_恐怖増加(ARG, ARG:1)
ENDSELECT

@TRAIN_STATE_IS_SHOW_恐怖増加
RETURN 1
