@TRAIN_STATE_NAME_51
RESULTS = 屈从追加

@TRAIN_STATE_EXPLAIN_屈从追加
RESULTS = 根据给予的快感追加屈从的来源。/但是减少情爱的来源。/这个效果仅在连锁期间有效。

;--------------------------------
;ARG	調教状态変化の対象
;ARG:1	その時の調教者
;ARG:2	FORMで呼ばれたことを示し、RESULTにタッチする
;--------------------------------
@TRAIN_STATE_POWER_屈从追加, ARG, ARG:1, ARG:2
#FUNCTION
#LOCALSIZE 1
LOCAL = 0
LOCAL += TCVAR:ARG:屈从追加
SIF ARG:2
	RESULT = LOCAL
RETURNF LOCAL

@TRAIN_STATE_ADD_CUP_屈从追加, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "情爱"
		RETURN -TRAIN_STATE_POWER_屈从追加(ARG, ARG:1)
ENDSELECT


@TRAIN_STATE_IS_SHOW_屈从追加
RETURN 1