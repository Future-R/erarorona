;@GET_TRAIN_STATE_CUP		調教状态によるCUP倍率を取得
;@GET_TRAIN_STATE_SOURCE	調教状态によるSOURCE倍率を取得
;---------------------------------------------------------------------
;@GET_TRAIN_STATE_CUP
;調教状态によるCUP倍率を取得
;ARGS		CUPの名称
;ARG		主体角色
;ARG:1		客体角色
;---------------------------------------------------------------------
@GET_TRAIN_STATE_CUP, ARGS, ARG = -1, ARG:1 = -1
#LOCALSIZE 1
#DIM L_RESULT, 2
SIF ISNUMERIC(ARGS)
	ARGS = %PALAMNAME:TOINT(ARGS)%
VARSET L_RESULT
FOR LOCAL, 0, 调教状态数
	VARSET RESULT, 0, 0, 2
	TRYCCALLFORM TRAIN_STATE_CUP_%GET_NAME("调教状态", LOCAL)%, ARGS, ARG, ARG:1
		L_RESULT += RESULT
		L_RESULT:1 += RESULT:1
	CATCH
	ENDCATCH
NEXT
RETURN L_RESULT, L_RESULT:1

