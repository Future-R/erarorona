@EVENTFIRST
FLAG:プレイ開始時間 = GETMILLISECOND()
CFLAG:0:プレイヤーID = GETMILLISECOND()
CALL SET_ID, 0
CALL SET_GAMESTART
CALL GAMESTART
BEGIN SHOP

@SET_GAMESTART
#LOCALSIZE 2
;---------------------------------------------------------------------
;周回を考慮したフラグ処理
;---------------------------------------------------------------------
VARSET RECIPE
VARSET MAP

VARSET G_REQ_VALUE
VARSET G_REQ_VALUE_0
VARSET G_REQ_VALUE_1
VARSET G_REQ_VALUE_2

VARSET EVENT
VARSET EVENTS

VARSET RECORD_ATTAIN
VARSET RECORD_ABLUP_SUM

VARSET REQ
VARSET MAKE_REQ_NUM

VARSET PLACE_QUESTED

VARSET HOMU_MIX_PROPERTY
VARSET USE_JUEL
VARSET ITEM_KNOWN
;VARSET PROPERTY_KNOWN
;VARSET EFFECT_KNOWN

FOR LOCAL, 0, VARSIZE("FLAG")
	{
	IF GROUPMATCH(FLAGNAME:LOCAL,
		"プレイ時間", "プレイ開始時間", "オートセーブ実施日", "ウィンドウメッセージスキップ", "マウスモード",
		"メッセージ加速係数", "地図全表示", "DEBUG", "調教コマンド表示モード"
		)
	}
		CONTINUE
	ENDIF
	FLAG:LOCAL = 0
NEXT

;---------------------------------------------------------------------
;ロロナの処理
;---------------------------------------------------------------------
VARSET CFLAG:MASTER:0, 0, 200, 300
;ABL初期化
FOR LOCAL, 0, 100
	ABL:MASTER:LOCAL = CSVABL(NO:MASTER, LOCAL)
NEXT

FOR LOCAL, 100, 200
	ABL:MASTER:LOCAL = 10
NEXT
MAXBASE:MASTER:MP = 30
BASE:MASTER:MP = GET_MAXBASE("MP", MASTER)

VARSET CSTR:MASTER:0, "", 100, 200
VARSET JUEL:MASTER:0
LOCAL:1 = 0
FOR LOCAL, 0, 5
	SIF IS_TAKE_OVER("EXP引き継ぎ" + AUTO_SPLIT("10_25_50_75_100", "_", LOCAL) + "\%")
		LOCAL:1 = AUTO_SPLIT_INT("10_25_50_75_100", "_", LOCAL)
NEXT
FOR LOCAL, 0, VARSIZE("EXP")
	EXP:MASTER:LOCAL = TIMESF(EXP:MASTER:LOCAL, LOCAL:1)
NEXT
IF !IS_TAKE_OVER("ロロナの装備引き継ぎ")
	CSTR:MASTER:武器 =ID1601クオリティ2品質60特性00特性10特性20特性30特性40主効果00主効果10主効果20主効果30主効果40カテゴリ0レベル1使用回数0使用回数上限0価格52持ち出しフラグ0在庫数0最大在庫数0カテゴリ補正値0コスト補正値0
	CSTR:MASTER:防具 =ID1701クオリティ2品質60特性00特性10特性20特性30特性40主効果00主効果10主効果20主効果30主効果40カテゴリ0レベル1使用回数0使用回数上限0価格64持ち出しフラグ0在庫数0最大在庫数0カテゴリ補正値0コスト補正値0
	CSTR:MASTER:装飾品0 = 
	CSTR:MASTER:装飾品1 =
	CALL SET_EQUIP_FLAG, MASTER
ENDIF

RECIPE:GET_NO("参考書", "初めての参考書") = 1
MAP:GET_NO("マップ", "アーランド周辺の地図") = 1

TARGET = -1
FLAG:現地点 = GET_NO("場所", "アーランド")
FLAG:ショートカット0 = GET_NO("場所", "アーランド")

FOR LOCAL, 1, 20
	FLAG:@"ショートカット{LOCAL}" = -1
NEXT
SIF !IS_TAKE_OVER("カゴ引き継ぎ")
	VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("カゴ"), GET_ITEM_RANGE("カゴ", 1)
SIF !IS_TAKE_OVER("コンテナ引き継ぎ")
	VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("コンテナ"), GET_ITEM_RANGE("コンテナ", 1)
SIF  !IS_TAKE_OVER("ロロナの装備引き継ぎ")
	VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("探索装備"), GET_ITEM_RANGE("探索装備", 1)
;店データ削除と登録
VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("販売店"), GET_ITEM_RANGE("販売店", 1)
CALL DEL_CHOICE_ITEM
CALL SET_STORE
CALL RECHARGE_STORE


;---------------------------------------------------------------------
;キャラクター処理
;---------------------------------------------------------------------
FOR LOCAL, CHARANUM - 1, -1, -1
	SIF LOCAL == MASTER
		CONTINUE
	IF CFLAG:LOCAL:引き継ぎフラグ
		CFLAG:LOCAL:引き継ぎフラグ = 0
		CFLAG:LOCAL:採集場所 = -1
		VARSET CFLAG:LOCAL:0, 0, 200, 300
		IF !IS_TAKE_OVER("装備引き継ぎ")
			CSTR:LOCAL:武器 =
			CSTR:LOCAL:防具 =
			CSTR:LOCAL:装飾品0 = 
			CSTR:LOCAL:装飾品1 =
			CALL SET_EQUIP_FLAG, LOCAL
		ENDIF
	ELSE
		IF CSTR:LOCAL:所持スキル != ""
			FOR LOCAL:1, 0, STRCOUNT(CSTR:LOCAL:所持スキル, "/") + 1
				FR_SKILL_LV:GET_NO("フレンドスキル", AUTO_SPLIT(CSTR:LOCAL:所持スキル, "/", LOCAL:1)) = 0
			NEXT
		ENDIF
		CALL DELETE_CHARA, LOCAL
	ENDIF
NEXT

FOR LOCAL, 1, キャラ総数
	SIF !EXISTCSV(LOCAL, 0)
		CONTINUE
	SIF GETCHARA(LOCAL) >= 0
		CONTINUE
	CALL ADD_FRIEND, LOCAL
NEXT

CFLAG:GET_CNUM("アストリッド"):面識 = 1
CFLAG:GET_CNUM("ホムちゃん"):面識 = 1
CFLAG:GET_CNUM("ホムくん"):面識 = 1

LOCAL:1 = 0
FOR LOCAL, 0, 5
	SIF IS_TAKE_OVER("GP引き継ぎ" + AUTO_SPLIT("10_25_50_75_100", "_", LOCAL) + "\%")
		LOCAL:1 = AUTO_SPLIT_INT("10_25_50_75_100", "_", LOCAL)
NEXT
FLAG:ギルドポイント = TIMESF(TO_GPOINT, LOCAL:1)

LOCAL:1 = 0
FOR LOCAL, 0, 5
	SIF IS_TAKE_OVER("資金引き継ぎ" + AUTO_SPLIT("10_25_50_75_100", "_", LOCAL) + "\%")
		LOCAL:1 = AUTO_SPLIT_INT("10_25_50_75_100", "_", LOCAL)
NEXT
IF LOCAL:1
	MONEY = TIMESF(TO_MONEY, LOCAL:1)
ELSE
	MONEY = 500
ENDIF
DAY = 7

