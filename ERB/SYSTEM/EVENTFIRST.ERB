@EVENTFIRST
FLAG:游玩开始时间 = GETMILLISECOND()
CFLAG:0:玩家ID = GETMILLISECOND()
CALL SET_ID, 0
CALL SET_GAMESTART
CALL GAMESTART
BEGIN SHOP

@SET_GAMESTART
#LOCALSIZE 2
;---------------------------------------------------------------------
;周回を考慮したフラグ処理
;---------------------------------------------------------------------
VARSET RECIPE
VARSET MAP

VARSET G_REQ_VALUE
VARSET G_REQ_VALUE_0
VARSET G_REQ_VALUE_1
VARSET G_REQ_VALUE_2

VARSET EVENT
VARSET EVENTS

VARSET RECORD_ATTAIN
VARSET RECORD_ABLUP_SUM

VARSET REQ
VARSET MAKE_REQ_NUM

VARSET PLACE_QUESTED

VARSET HOMU_MIX_PROPERTY
VARSET USE_JUEL
VARSET ITEM_KNOWN
;VARSET PROPERTY_KNOWN
;VARSET EFFECT_KNOWN

FOR LOCAL, 0, VARSIZE("FLAG")
	{
	IF GROUPMATCH(FLAGNAME:LOCAL,
		"游玩时间", "游玩开始时间", "自动保存实施日", "跳过消息窗口", "鼠标模式",
		"消息加速系数", "地图全显示", "DEBUG", "调教指令显示模式"
		)
	}
		CONTINUE
	ENDIF
	FLAG:LOCAL = 0
NEXT

;---------------------------------------------------------------------
;ロロナの処理
;---------------------------------------------------------------------
VARSET CFLAG:MASTER:0, 0, 200, 300
;ABL初期化
FOR LOCAL, 0, 100
	ABL:MASTER:LOCAL = CSVABL(NO:MASTER, LOCAL)
NEXT

FOR LOCAL, 100, 200
	ABL:MASTER:LOCAL = 10
NEXT
MAXBASE:MASTER:魔力 = 30
BASE:MASTER:魔力 = GET_MAXBASE("魔力", MASTER)

VARSET CSTR:MASTER:0, "", 100, 200
VARSET JUEL:MASTER:0
LOCAL:1 = 0
FOR LOCAL, 0, 5
	SIF IS_TAKE_OVER("继承EXP" + AUTO_SPLIT("10_25_50_75_100", "_", LOCAL) + "\%")
		LOCAL:1 = AUTO_SPLIT_INT("10_25_50_75_100", "_", LOCAL)
NEXT
FOR LOCAL, 0, VARSIZE("EXP")
	EXP:MASTER:LOCAL = TIMESF(EXP:MASTER:LOCAL, LOCAL:1)
NEXT
IF !IS_TAKE_OVER("继承萝乐娜的装备")
	CSTR:MASTER:武器 =ID1601品阶2品质60特性00特性10特性20特性30特性40主效果00主效果10主效果20主效果30主效果40调合类别0等级1使用次数0使用次数上限0价格52取出标识0库存数0最大库存数0调合类别加成值0消耗额加成值0
	CSTR:MASTER:防具 =ID1701品阶2品质60特性00特性10特性20特性30特性40主效果00主效果10主效果20主效果30主效果40调合类别0等级1使用次数0使用次数上限0价格64取出标识0库存数0最大库存数0调合类别加成值0消耗额加成值0
	CSTR:MASTER:装饰品0 = 
	CSTR:MASTER:装饰品1 =
	CALL SET_EQUIP_FLAG, MASTER
ENDIF

RECIPE:GET_NO("参考书", "初学参考书") = 1
MAP:GET_NO("地图", "亚兰德周边地图") = 1

TARGET = -1
FLAG:当前地点 = GET_NO("地点", "亚兰德")
FLAG:快捷键0 = GET_NO("地点", "亚兰德")

FOR LOCAL, 1, 20
	FLAG:@"快捷键{LOCAL}" = -1
NEXT
SIF !IS_TAKE_OVER("继承篮子")
	VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("篮子"), GET_ITEM_RANGE("篮子", 1)
SIF !IS_TAKE_OVER("继承箱子")
	VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("箱子"), GET_ITEM_RANGE("箱子", 1)
SIF  !IS_TAKE_OVER("继承萝乐娜的装备")
	VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("探索装备"), GET_ITEM_RANGE("探索装备", 1)
;店データ削除と登録
VARSET ITEMCHOICE, 1, GET_ITEM_RANGE("商店"), GET_ITEM_RANGE("商店", 1)
CALL DEL_CHOICE_ITEM
CALL SET_STORE
CALL RECHARGE_STORE


;---------------------------------------------------------------------
;角色クター処理
;---------------------------------------------------------------------
FOR LOCAL, CHARANUM - 1, -1, -1
	SIF LOCAL == MASTER
		CONTINUE
	IF CFLAG:LOCAL:继承标识
		CFLAG:LOCAL:继承标识 = 0
		CFLAG:LOCAL:采集地点 = -1
		VARSET CFLAG:LOCAL:0, 0, 200, 300
		IF !IS_TAKE_OVER("继承装备")
			CSTR:LOCAL:武器 =
			CSTR:LOCAL:防具 =
			CSTR:LOCAL:装饰品0 = 
			CSTR:LOCAL:装饰品1 =
			CALL SET_EQUIP_FLAG, LOCAL
		ENDIF
	ELSE
		IF CSTR:LOCAL:拥有技能 != ""
			FOR LOCAL:1, 0, STRCOUNT(CSTR:LOCAL:拥有技能, "/") + 1
				FR_SKILL_LV:GET_NO("友人技能", AUTO_SPLIT(CSTR:LOCAL:拥有技能, "/", LOCAL:1)) = 0
			NEXT
		ENDIF
		CALL DELETE_CHARA, LOCAL
	ENDIF
NEXT

FOR LOCAL, 1, 角色总数
	SIF !EXISTCSV(LOCAL, 0)
		CONTINUE
	SIF GETCHARA(LOCAL) >= 0
		CONTINUE
	CALL ADD_FRIEND, LOCAL
NEXT

CFLAG:GET_CNUM("亚斯特丽德"):认识 = 1
CFLAG:GET_CNUM("霍姆妹妹"):认识 = 1
CFLAG:GET_CNUM("霍姆弟弟"):认识 = 1

LOCAL:1 = 0
FOR LOCAL, 0, 5
	SIF IS_TAKE_OVER("继承GP" + AUTO_SPLIT("10_25_50_75_100", "_", LOCAL) + "\%")
		LOCAL:1 = AUTO_SPLIT_INT("10_25_50_75_100", "_", LOCAL)
NEXT
FLAG:公会点数 = TIMESF(TO_GPOINT, LOCAL:1)

LOCAL:1 = 0
FOR LOCAL, 0, 5
	SIF IS_TAKE_OVER("继承资金" + AUTO_SPLIT("10_25_50_75_100", "_", LOCAL) + "\%")
		LOCAL:1 = AUTO_SPLIT_INT("10_25_50_75_100", "_", LOCAL)
NEXT
IF LOCAL:1
	MONEY = TIMESF(TO_MONEY, LOCAL:1)
ELSE
	MONEY = 500
ENDIF
DAY = 7
