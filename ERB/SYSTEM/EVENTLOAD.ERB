@EVENTLOAD
LOADGLOBAL
;オートセーブする場合の措置
SIF GLOBAL:オートセーブの位置 > 0
	CALL SAVE_AUTO
CALL GAMESTART
;バージョンアップ措置
CALL VER_UP
GETMILLISECOND
FLAG:プレイ開始時間 = RESULT
IF FLAG:ショップコマンド > 0
	CALLFORM SHOPCOM_{FLAG:ショップコマンド}, 1
	FLAG:ショップコマンド = 0
	RETURN 1
ENDIF