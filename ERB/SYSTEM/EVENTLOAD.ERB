@EVENTLOAD
LOADGLOBAL
;オートセーブする場合の措置
SIF GLOBAL:自动保存的位置 > 0
	CALL SAVE_AUTO
CALL GAMESTART
;バージョンアップ措置
CALL VER_UP
GETMILLISECOND
FLAG:游玩开始时间 = RESULT
IF FLAG:SHOP指令 > 0
	CALLFORM SHOPCOM_{FLAG:SHOP指令}, 1
	FLAG:SHOP指令 = 0
	RETURN 1
ENDIF