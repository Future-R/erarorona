;	004		2013/03/13			kap						グローバルリストの作成を追加
;---------------------------------------------------------------------
@SYSTEM_TITLE
#DIM LINE
LOADGLOBAL
;エラーチェック
SIF LINECOUNT > 1
	WAITANYKEY
IF !GLOBAL:最终启动版本
	GLOBAL:信息速度 = 1
	GLOBAL:自动时等待 = 200
	GLOBAL:PALAM动画帧数 = 20
	GLOBALS:"排序+" = 登録順ソート/登録
	GLOBALS:"排序-" = 品质順ソート/品质
	GLOBALS:"排序*" = ID順ソート/ID
	GLOBALS:"排序/" = 特性ソート/特性
	GLOBALS:"排序." = 选择完毕ソート/选择完毕
	CALL INFO_START
ENDIF
CLEARLINE 1
;デバッグモードの時は常にリスト更新を行う
[IF_DEBUG]
	CALL SET_LIST
[ENDIF]
IF GLOBAL:最终启动版本 != GAMEBASE_VERSION
	[IF_NDEBUG]
		CALL SET_LIST
	[ENDIF]
	CALL TITLE_INFO
ENDIF
GLOBAL:最终启动版本 = GAMEBASE_VERSION
SAVEGLOBAL
CALL ADD_LINE, 50
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
ALIGNMENT CENTER
DRAWLINE
PRINTFORML %GAMEBASE_TITLE%
PRINTFORML Ver{GAMEBASE_VERSION / 1000}.{GAMEBASE_VERSION % 1000}
PRINTFORML %GAMEBASE_AUTHOR%
PRINTFORML (%GAMEBASE_YEAR%)
PRINTFORML
PRINTFORML %GAMEBASE_INFO%
DRAWLINE
PRINTL [0]  ＮＥＷ ＧＡＭＥ 
PRINTL [1] ＬＯＡＤ ＧＡＭＥ
PRINTL [2]     ＩＮＦＯ     
[IF_DEBUG]
	LOCAL = 3
	PRINTL [3]    ＤＥＢＵＧ    
[ENDIF]
PRINTL [9]     ＭＡＫＥ     
CALL EQUATE_LINE(LINE + 5)
ALIGNMENT LEFT
CALL INPUTINT(0, 1, 2, 9, LOCAL)
SELECTCASE RESULT
	CASE 0
		DRAWLINE
		RESETDATA
		ADDCHARA 0
		CALL SET_INIT_STATUS, 0
		BEGIN FIRST
	CASE 1
		DRAWLINE
		CALL TITLE_LOADGAME
	CASE 2
		DRAWLINE
		CALL TITLE_INFO
	CASE 3
		CALL DEBUG
	CASE 9
		CALL MAKE_ARTIFACT
ENDSELECT
GOTO START
@SET_LIST
;名称作成
CALL MAKE_NOLIST
;コスト表の作成
FOR LOCAL, 0, 特性总数
	CALL PROPERTY_COST, LOCAL
	PROPERTYCOST:LOCAL = RESULT
NEXT
SAVEGLOBAL
