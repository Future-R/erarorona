@SYSTEM_TITLE
#DIM LINE
LOADGLOBAL
TOOLTIP_SETDELAY 0
;エラーチェック
SIF LINECOUNT > 1
	WAITANYKEY
IF !GLOBAL:最终启动版本
	CALL INIT_SETTING
ENDIF

CLEARLINE 1
[IF_DEBUG]
	CALL SET_LIST
[ENDIF]
IF GLOBAL:最终启动版本 != GAMEBASE_VERSION
	[IF_NDEBUG]
		CALL SET_LIST
	[ENDIF]
	CALL TITLE_INFO
ENDIF
GLOBAL:最终启动版本 = GAMEBASE_VERSION
SAVEGLOBAL

SETBGMVOLUME GLOBAL:音量
CALL BGM, "坠落吧星光.mp3"
; 启动动画开关，默认开启（在设置里可关闭）
IF GLOBAL:启动动画
	CALL 播放视频, "DATA_VIDEO_OP"
ENDIF

CALL ADD_LINE, 20
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
ALIGNMENT CENTER
; DRAWLINE
CALL PRINT_IMAGE("title_bg", 3000)
; CALL PRINT_ANIME("ktn_money", 3000)
CALL UPDATE_TIPS
PRINTFORML %GAMEBASE_TITLE%
PRINTFORML Ver{GAMEBASE_VERSION / 1000}.{GAMEBASE_VERSION % 1000}
PRINTFORML %GAMEBASE_AUTHOR%
PRINTFORML (%GAMEBASE_YEAR%)
PRINTFORML
PRINTFORML %GAMEBASE_INFO%
DRAWLINE
PRINTL [0] 新的游戏
PRINTL [1] 读取游戏
PRINTL [2]  信  息 
[IF_DEBUG]
	LOCAL = 3
	PRINTL [3]  调  试 
[ENDIF]
PRINTL [7]  设  置 
PRINTL [8]  制  造 
PRINTL [9] 检查更新
CALL EQUATE_LINE(LINE + 5)
ALIGNMENT LEFT
CALL INPUTINT(0, 1, 2, 7, 8, 9, LOCAL)
SELECTCASE RESULT
	CASE 0
		DRAWLINE
		RESETDATA
		ADDCHARA 0
		CALLF STOP_BGM()
		CALL SET_INIT_STATUS, 0
		BEGIN FIRST
	CASE 1
		DRAWLINE
		CALL TITLE_LOADGAME
	CASE 2
		DRAWLINE
		CALL TITLE_INFO
	CASE 3
		CALL DEBUG
	CASE 7
		CALL MESSAGE_WINDOW_CONFIG
	CASE 8
		CALL MAKE_ARTIFACT
	CASE 9
		CALL VERSION_UPDATE_CHECK
ENDSELECT
GOTO START
@SET_LIST
;名称作成
CALL MAKE_NOLIST
;コスト表の作成
FOR LOCAL, 0, 特性总数
	CALL PROPERTY_COST, LOCAL
	PROPERTYCOST:LOCAL = RESULT
NEXT
SAVEGLOBAL
