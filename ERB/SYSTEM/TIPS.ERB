;========================================================================
; 更新游戏提示
;========================================================================
@UPDATE_TIPS

标题提示 '= @"📜%GET_TIPS(0)%📜"
WINDOW_TITLE = era萝乐娜 %TOSTR(GAMEBASE_VERSION / 1000) + "." + TOSTR(GAMEBASE_VERSION % 1000, "00")%\t\t\t\t%标题提示%

; ARG提示类型，0是标题界面提示，1是世界地图提示
@GET_TIPS, ARG
#FUNCTIONS
#DIMS 提示文本

DO
	SELECTCASE RAND:29
		CASE 0
			提示文本 = 有任何吐槽或建议都欢迎向我反馈，玩家的反馈是我制作的最大动力！
		CASE 1
			提示文本 = 相较于消去友人的负面特性，先提升正面特性往往会划算一些。
		CASE 2
			提示文本 = 大部分商店都会在周六甩卖，周日补货。如果想提升与店主的交友值，就去购物吧！
		CASE 3
			提示文本 = 有什么觉得有用的一句话攻略，都欢迎投稿！
		CASE 4
			IF GET_EVENT_ATTAIN("随波漂流")
				提示文本 = 周二派发的马车会更快。如果有前往村子的计划，不妨将快车纳入规划之中。
			ENDIF
		CASE 5
			提示文本 = 按鼠标右键可以加速游戏，但有时会跳过一些重要的信息。
		CASE 6
			提示文本 = 如果遇到了困难，可以随时查阅笔记里的帮助。
		CASE 7
			提示文本 = 情人节：2月14日。别忘了去见喜欢的人，说不定会有好事发生。
		CASE 8
			提示文本 = 标题界面可以制造遗物。感兴趣的话可以投稿给我整合进游戏。
		CASE 9
			提示文本 = 每个月的3日、13日、23日，王宫都会发布5个新的委托。
		CASE 10
			提示文本 = 有空可以试着点一下标题界面的检查更新，万一更新了呢。
		CASE 11
			IF GET_EVENT_ATTAIN("蒂华娜的请求")
				提示文本 = 在商店登记的物品最好有[便宜品]的特性，这样你就可以便宜买回来了。
			ENDIF
		CASE 12
			提示文本 = 想要诱惑他人，就换上诱人的衣服，并且与对方发展交友值吧！
		CASE 13
			提示文本 = 尽早制造更高阶的霍姆克鲁斯来调教吧！越早越好！
		CASE 14
			提示文本 = 在笔记中可以查看成就条件。完成成就后别忘了来公会领取公会点数。
		CASE 15
			提示文本 = 调教时采取不重复行动即可达成连锁，最高可以让连锁奖励达到1000\%！
		CASE 16
			提示文本 = 在野外采集时有可能会采集到遗物，制造出特殊的霍姆克鲁斯。
		CASE 17
			提示文本 = 想继承特质但消耗额不够？使用更高等级的素材来调和吧。炼金的成就也能给予帮助。
		CASE 18
			提示文本 = 你知道吗？点击世界地图边框就能移动地图卷轴。
		CASE 19
			提示文本 = 主城的背景音乐听腻了？可以随时在设置里切换。
		CASE 20
			提示文本 = 注意到了吗，调教界面可以切换道具页面和技能页面。
		CASE 21
			提示文本 = 调合失败也不一定是坏事：损坏的物品可以拿来调合中和剂，转移稀有的特性。
		CASE 22
			提示文本 = 在商店购物时，如果当前数量为0，点一下左按钮就能让数量变为最大值。
		CASE 23
			IF GET_EVENT_ATTAIN("上门推销的少年")
				提示文本 = 每月15日，柯尔会来到亚兰德，别错过时间。
			ENDIF
		CASE 24
			提示文本 = 游戏每天会自动存档，所以不必太过着急地频繁存档。
		CASE 25
			IF GET_EVENT_ATTAIN("采集委托")
				提示文本 = 委托库蝶莉娅采集是不需要费用的，其他人就并非如此喽！
			ENDIF
		CASE 26
			提示文本 = 选择物品时，按住空格可以临时进入多选模式。
		CASE 27
			提示文本 = 受不了慢慢出字的打字机效果？设置里可以开启自动加速器以及调整消息速度！
		CASE 28
			提示文本 = 下手温柔一些，尽量别把调教对象体力调到0了。
	ENDSELECT
LOOP 提示文本 == \@(ARG == 0) ? %标题提示% # %世界地图提示%\@

RETURNF 提示文本