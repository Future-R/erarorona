;========================================================================
;ロードゲーム
;ページ数の記録には便宜性を考えてGLOBALを利用
;========================================================================
@TITLE_LOADGAME
#LOCALSIZE 4
#LOCALSSIZE 1
#DIMS SAVE_TEXT, 2
#DIM LINE, 2
#DIM SHOW_AUTO

LOADGLOBAL
REDRAW 0
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTFORML 　LOAD GAME
DRAWLINE
LOCAL:3 = SHOW_AUTO ? 9 # GLOBAL:保存数据页
FOR LOCAL, LOCAL:3 * 10 , LOCAL:3 * 10 + 5
	VARSET SAVE_TEXT
	CHKDATA LOCAL
	SIF !RESULT
		SAVE_TEXT:0 = %RESULTS%
	CHKDATA LOCAL + 5
	SIF !RESULT
		SAVE_TEXT:1 = %RESULTS%
	FOR LOCAL:1, 0, 6
		FOR LOCAL:2, 0, 2
			SIF LOCAL + 5 * LOCAL:2 == GLOBAL:最终保存
				SETCOLOR  COLOR("p-blue") 
			SIF SAVE_TEXT:(LOCAL:2) == ""
				SETCOLOR  COLOR("gray") 
			SELECTCASE LOCAL:1
				CASE 0
					PRINT ┌
					IF SAVE_TEXT == ""
						PRINTPLAINFORM [{LOCAL + 5 * LOCAL:2, 2}]
					ELSE
						PRINTBUTTON @"[{LOCAL + 5 * LOCAL:2, 2}]", @"{LOCAL + 5 * LOCAL:2}"
					ENDIF
					PRINTFORM %"─"*25%┐
				CASE 1 TO 4
					PRINT │
					IF SAVE_TEXT:(LOCAL:2) == ""
						PRINTFORM %" " * 54%
					ELSE
						PRINTBUTTON @"%AUTO_SPLIT(SAVE_TEXT:(LOCAL:2), "_", LOCAL:1 - 1), 54, LEFT%", @"{LOCAL + 5 * LOCAL:2}"
					ENDIF
					PRINT │
				CASE 5
					PRINTFORM └%"─"*27%┘
			ENDSELECT
			RESETCOLOR
		NEXT
		PRINTL 
	NEXT
NEXT
DRAWLINE
PRINTFORM 　%@"page.\@SHOW_AUTO ? AUTO # {GLOBAL:保存数据页}\@", 20, LEFT%
CALL PRINTSBUTTON_C, @"%"[ -] 前のページ",32,LEFT%", "-", GLOBAL:保存数据页 > 0 && !SHOW_AUTO, , COLOR("gray")
PRINTBUTTON @"%"[/] 返回",32, LEFT%", "/"
CALL PRINTSBUTTON_C, @"%"[ +] 次のページ",32,LEFT%", "+", GLOBAL:保存数据页 < 8 && !SHOW_AUTO, , COLOR("gray")
PRINTL 
PRINTFORM 　%@"", 20, LEFT%
CALL PRINTSBUTTON_C, @"%"[ *] Normal",32,LEFT%", "*", !SHOW_AUTO, COLOR("p-green")
CALL PRINTSBUTTON_C, @"%"[ .] Auto",32,LEFT%", ".", SHOW_AUTO, COLOR("p-green")
CALL PRINTSBUTTON_C, @"%"[90] Last Auto save",32,LEFT%", "90", CHKDATA(90), COLOR("gray")
PRINTL 
DRAWLINE
LINE:1 = LINECOUNT
CALL ADD_LINE, 4
INPUTS
IF ISNUMERIC(RESULTS)
	LOCAL =  TOINT(RESULTS)
	SIF !INRANGE(LOCAL, 0, 99)
		GOTO START
	CHKDATA LOCAL
	SIF RESULT
		GOTO START
	GLOBAL:最终保存 = LOCAL
	SAVEGLOBAL
	LOADDATA LOCAL
ELSE
	SELECTCASE RESULTS
		CASE "-"
			IF !SHOW_AUTO
				GLOBAL:保存数据页 = MAX(GLOBAL:保存数据页 - 1, 0)
				CALL SHOW_BLANK
			ENDIF
		CASE "+"
			IF !SHOW_AUTO
				GLOBAL:保存数据页 = MIN(GLOBAL:保存数据页 + 1, 8)
				CALL SHOW_BLANK
			ENDIF
		CASE "/"
			RETURN 0
		CASE "*"
			SHOW_AUTO = 0
			CALL SHOW_BLANK
		CASE "."
			SHOW_AUTO = 1
			CALL SHOW_BLANK
	ENDSELECT
ENDIF
GOTO START
