;========================================================================
;セーブゲーム
;ページ数の記録には便宜性を考えてGLOBALを利用
;========================================================================
@TITLE_SAVEGAME
#LOCALSIZE 3
#LOCALSSIZE 1
#DIMS SAVE_TEXT, 2
#DIM LINE, 2
LOADGLOBAL
REDRAW 0
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTFORML 　SAVE GAME
DRAWLINE
FOR LOCAL, GLOBAL:セーブデータページ * 10 , (GLOBAL:セーブデータページ) * 10 + 5
	VARSET SAVE_TEXT
	CHKDATA LOCAL
	SIF !RESULT
		SAVE_TEXT:0 = %RESULTS%
	CHKDATA LOCAL + 5
	SIF !RESULT
		SAVE_TEXT:1 = %RESULTS%
	FOR LOCAL:1, 0, 6
		FOR LOCAL:2, 0, 2
			SIF LOCAL + 5 * LOCAL:2 == GLOBAL:最終セーブ
				SETCOLOR  COLOR("p-blue") 
			SIF SAVE_TEXT:(LOCAL:2) == ""
				SETCOLOR  COLOR("gray") 
			SELECTCASE LOCAL:1
				CASE 0
					PRINT ┌
					PRINTBUTTON @"[{LOCAL + 5 * LOCAL:2, 2}]", @"{LOCAL + 5 * LOCAL:2}"
					PRINTFORM %"─"*25%┐
				CASE 1 TO 4
					PRINT │
					IF SAVE_TEXT:(LOCAL:2) == ""
						PRINTBUTTON  " " * 54 , @"{LOCAL + 5 * LOCAL:2}"
					ELSE
						PRINTBUTTON @"%AUTO_SPLIT(SAVE_TEXT:(LOCAL:2), "_", LOCAL:1 - 1), 54, LEFT%", @"{LOCAL + 5 * LOCAL:2}"
					ENDIF
					PRINT │
				CASE 5
					PRINTFORM └%"─"*27%┘
			ENDSELECT
			RESETCOLOR
		NEXT
		PRINTL 
	NEXT
NEXT
DRAWLINE
PRINTFORM 　%@"page.{GLOBAL:セーブデータページ}", 20, LEFT%
CALL PRINTSBUTTON_C, @"%"[-] 前のページ",32,LEFT%", "-", GLOBAL:セーブデータページ > 0, , COLOR("gray")
PRINTBUTTON @"%"[/] 戻る",32, LEFT%", "/"
CALL PRINTSBUTTON_C, @"%"[+] 次のページ",32,LEFT%", "+", GLOBAL:セーブデータページ < 8, , COLOR("gray")
PRINTL 
DRAWLINE
LINE:1 = LINECOUNT
CALL EQUATE_LINE, LINE + MAXLINE()
INPUTS
IF ISNUMERIC(RESULTS)
	LOCAL =  TOINT(RESULTS)
	SIF !INRANGE(LOCAL, 0, 89)
		GOTO START
	CHKDATA LOCAL
	IF !RESULT
		CLEARLINE LINECOUNT - LINE:1
		PRINTL 既にデータが存在しています。上書きしますか？
		CALL EQUATE_LINE, LINE + MAXLINE() - 2
		CALL INPUT_YN
		SIF RESULT == 1
			GOTO START
	ENDIF
	;変数の掃除
	CALL DEL_SAVE_VAR
	;最新のINFOを取るためにここで呼びだしてみる
	CALL SAVEINFO
	;SAVEDATA X, HOGEで、番号Xに、HOGEのてきすとをつけてセーブ
	GLOBAL:最終セーブ = LOCAL
	SAVEGLOBAL
	SAVEDATA LOCAL, SAVESTR:セーブデータメモ
	CALL SHOW_BLANK
	RETURN 0
ELSE
	SELECTCASE RESULTS
		CASE "-"
			GLOBAL:セーブデータページ = MAX(GLOBAL:セーブデータページ - 1, 0)
			CALL SHOW_BLANK
		CASE "+"
			GLOBAL:セーブデータページ = MIN(GLOBAL:セーブデータページ + 1, 8)
			CALL SHOW_BLANK
		CASE "/"
			REDRAW 1
			SAVEGLOBAL
			RETURN 0
	ENDSELECT
ENDIF
GOTO START

@SAVEINFO
SAVESTR:セーブデータメモ =
SAVESTR:セーブデータメモ += @"%SHOW_DAY()% "
SAVESTR:セーブデータメモ += "_"

SAVESTR:セーブデータメモ += @"%CALLNAME:MASTER, 17, LEFT%"
SAVESTR:セーブデータメモ += @"MIXLv:{GET_MIXLV(MASTER),2}" + " " * 5
SAVESTR:セーブデータメモ += "Rank:"+GET_NAME("調教師ランク", FLAG:ギルドランク)
SAVESTR:セーブデータメモ += "_"

IF GET_NO("ショップ", "探索") == FLAG:ショップコマンド
	SAVESTR:セーブデータメモ +=@"%"現在地:" + GET_NAME("場所", FLAG:現地点) + "(探索中)", 30, LEFT%"
ELSE
	SAVESTR:セーブデータメモ += @"%"現在地:アトリエ", 30, LEFT%"
ENDIF
SAVESTR:セーブデータメモ += "所持金:" + TOSTR(MONEY, "0コール")
SAVESTR:セーブデータメモ += "_"
;SAVESTR:セーブデータメモ += "メモ:" + SAVESTR:セーブデータメモ
;SAVESTR:セーブデータメモ += "_"
SAVESTR:セーブデータメモ += "Ver" + TOSTR(GAMEBASE_VERSION / 1000) + "." +TOSTR(GAMEBASE_VERSION % 1000, "00") + " " * 4
GETMILLISECOND
FLAG:プレイ時間 += RESULT - FLAG:プレイ開始時間
FLAG:プレイ開始時間 = RESULT
IF FLAG:プレイ時間 / 1000 / 60 / 60 > 99
	SAVESTR:セーブデータメモ += "【99:59:59】"
ELSE
	SAVESTR:セーブデータメモ += "Play: " + TOSTR(FLAG:プレイ時間 / 1000 / 60 / 60, "00") + ":" + TOSTR(FLAG:プレイ時間 / 1000 / 60 % 60, "00") + ":" + TOSTR(FLAG:プレイ時間 / 1000 % 60 % 60, "00") + " " * 4
ENDIF
GETTIME
SAVESTR:セーブデータメモ += "Last:" + RESULTS

@DEL_SAVE_VAR
;セーブデータサイズ削減処理
;変数は0が入っている場合、セーブデータのサイズが減るので
;一時変数に近いものは0にしたほうがよい
VARSET A
VARSET ITEMLIST
VARSET MIXLIST
VARSET MIXCHOICE
VARSET P_LIST
VARSET F
VARSET G
VARSET H
VARSET I
VARSET J
VARSET K
VARSET L
VARSET M
VARSET N
VARSET O
VARSET P
VARSET Q
VARSET R
VARSET S
VARSET T
VARSET U
VARSET V
VARSET W
VARSET X
VARSET Y
VARSET Z
VARSET TFLAG

REPEAT CHARANUM
	VARSET GOTJUEL:COUNT:0
	VARSET EX:COUNT:0
	VARSET PALAM:COUNT:0
	VARSET SOURCE:COUNT:0
	VARSET TCVAR:COUNT:0
REND

@SAVE_AUTO_START
SIF DAY == FLAG:オートセーブ実施日
	RETURN 0
FLAG:オートセーブ実施日 = DAY
;変数の掃除
CALL DEL_SAVE_VAR
CALL SAVEINFO
;一旦100番に記録しておく
SAVEDATA 100, SAVESTR:セーブデータメモ
;90-98までのセーブデータをずらす
;ただし、コピーが一度ロードを挟む必要があるのでGLOBALを渡して続行させる
FOR GLOBAL:オートセーブの位置, 98, 89, -1
	SIF CHKDATA(GLOBAL:オートセーブの位置)
		CONTINUE
	SAVEGLOBAL
	LOADDATA GLOBAL:オートセーブの位置
NEXT
;オートセーブが存在しない場合、90番に移して終了
DELDATA 100
SAVEDATA 90, SAVESTR:セーブデータメモ

;ロード直後から呼ばれてくる場所
@SAVE_AUTO
IF GLOBAL:オートセーブの位置 == 90
	SAVEDATA GLOBAL:オートセーブの位置 + 1, SAVESTR:セーブデータメモ
	GLOBAL:オートセーブの位置 = 100
	SAVEGLOBAL
	LOADDATA 100
ELSEIF GLOBAL:オートセーブの位置 == 100
	DELDATA 100
	SAVEDATA 90, SAVESTR:セーブデータメモ
	GLOBAL:オートセーブの位置 = 0
	SAVEGLOBAL
	;最後に通常セーブのロード処理に流すために呼び出す
	LOADDATA 90
ELSE
	SAVEDATA GLOBAL:オートセーブの位置 + 1, SAVESTR:セーブデータメモ
	WHILE GLOBAL:オートセーブの位置 >= 90
		GLOBAL:オートセーブの位置--
		SAVEGLOBAL
		SIF !CHKDATA(GLOBAL:オートセーブの位置)
			LOADDATA GLOBAL:オートセーブの位置
	WEND
	IF !CHKDATA(100)
		GLOBAL:オートセーブの位置 = 100
		SAVEGLOBAL
		LOADDATA 100
	ENDIF
	GLOBAL:オートセーブの位置 = 0
ENDIF

;デフォルトでは問題あるので消去
@SYSTEM_AUTOSAVE
RETURN 0
