IF LASTLOAD_VERSION < 0626
	; 0626 以前的旧档仍使用旧的物品分段布局。
	; 先搬移后半区块，再把旧箱子整体平移到新的固定预留区。
	FOR LOCAL, 1509, 1499, -1
		CALL COPY_ITEMDATA, LOCAL, ITEMSLOTEXPLORESTART + (LOCAL - 1500)
		CALL DEL_ITEMDATA, LOCAL
	NEXT
	FOR LOCAL, 1499, 1199, -1
		CALL COPY_ITEMDATA, LOCAL, ITEMSLOTSHOPSTART + (LOCAL - 1200)
		CALL DEL_ITEMDATA, LOCAL
	NEXT
	FOR LOCAL, 1199, 1099, -1
		CALL COPY_ITEMDATA, LOCAL, GET_TEMP_ITEM_SLOT(LOCAL - 1100)
		CALL DEL_ITEMDATA, LOCAL
	NEXT
	FOR LOCAL, 1099, 99, -1
		CALL COPY_ITEMDATA, LOCAL, ITEMSLOTBOXSTART + (LOCAL - 100)
		CALL DEL_ITEMDATA, LOCAL
	NEXT
ENDIF

IF LASTLOAD_VERSION < 0631 && FLAG:高额委托计数器 > 0
	TEMP = GET_NO("事件", "幸运委托？")
	EVENT:TEMP = 0
