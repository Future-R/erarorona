						CALL ADD_STRFLAG, @"CSTR:{LOCAL}:初期ABL", ABLNAME:LOCAL, CSVABL(NO:LOCAL, LOCAL:1)
				NEXT
				CSTR:LOCAL:初期TALENT = 
