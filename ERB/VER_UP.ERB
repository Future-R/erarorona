				CALL SET_INIT_STATUS, LOCAL
			ENDIF
		ELSE
			CSTR:LOCAL:初期MAXBASE = %UNICODE(0x06)%%REPLACE(CSTR:LOCAL:初期MAXBASE,"/", UNICODE(0x06))%
