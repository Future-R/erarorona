IF LASTLOAD_VERSION < 0420
	CFLAG:MASTER:认识 = 1
	FOR LOCAL, 0, 3
		LOCAL:1 = GET_CNUM(AUTO_SPLIT("霍姆妹妹/霍姆弟弟/亚斯特丽德", "/", LOCAL))
		IF LOCAL:1 >= 0
			CFLAG:(LOCAL:1):认识 = 1
			FOR LOCAL:2, 0, VARSIZE("TALENT")
				SIF !TALENT:(LOCAL:1):(LOCAL:2)
					CONTINUE
				TRYCCALLFORM TALENT_NOLV_%TALENTNAME:(LOCAL:2)%
					SIF RESULT
						CONTINUE
				CATCH
				ENDCATCH
				IF GET_TALENT_COST(LOCAL:2, 1) >= 0
					TALENT:(LOCAL:1):(LOCAL:2) = 1
				ELSE
					TALENT:(LOCAL:1):(LOCAL:2) = 3
				ENDIF
			NEXT
		ELSE
			CALL ADD_FRIEND, AUTO_SPLIT("霍姆妹妹/霍姆弟弟/亚斯特丽德", "/", LOCAL)
		ENDIF
	NEXT
	FOR LOCAL, 1, 角色总数
		SIF !EXISTCSV(LOCAL, 0)
			CONTINUE
		SIF GETCHARA(LOCAL, 0) >= 0
			CONTINUE
		CALL ADD_FRIEND, LOCAL
	NEXT
