@EQUIP_CHANGE_MAIN
#DIM CHARA
#LOCALSIZE 4
#DIM TEMP, 2
#DIM LINE, 3
;---------------------------------------------------------------------
;角色決定
;---------------------------------------------------------------------
CALL SHOW_CHARALIST, "更换装备"
SIF RESULT == 1000
	RETURN 0
EQ_CHARA = RESULT
EQ_SHOW = 装饰品0

EQ_SHOW_NUM = MAXLINE() - 14
REDRAW 0
$START
FOR LOCAL, 0, 4
	CALL CONVERT_EQUIP, AUTO_SPLIT("装饰品0/装饰品1/武器/防具", "/", LOCAL), EQ_CHARA, GET_TEMP_ITEM_SLOT(LOCAL)
NEXT
TEMP = GET_EQUIP("装饰品0", EQ_CHARA, "ID"), GET_EQUIP("装饰品1", EQ_CHARA, "ID")
VARSET EQ_LIST_AC0, -1
VARSET EQ_LIST_AC1, -1
VARSET EQ_LIST_WE, -1
VARSET EQ_LIST_AR, -1
VARSET LOCAL
VARSET EQ_MAXLIST, -1
;---------------------------------------------------------------------
;リスト作成
;---------------------------------------------------------------------
FOR LOCAL, GET_ITEM_RANGE("持有物品"), GET_ITEM_RANGE("持有物品", 1)
	TRYCCALLFORM ITEM_TYPE_{GET_ITEMDATA(LOCAL, "ID")}
		SELECTCASE RESULTS
			;同じ装備は2個つけれないのでもう一方の番号は弾く
			CASE "装饰品"
				IF GET_ITEMDATA(LOCAL, "ID") != TEMP:1
					EQ_MAXLIST++
					EQ_LIST_AC0:(EQ_MAXLIST:0) = LOCAL
				ENDIF
				IF GET_ITEMDATA(LOCAL, "ID") != TEMP
					EQ_MAXLIST:1++
					EQ_LIST_AC1:(EQ_MAXLIST:1) = LOCAL
				ENDIF
			CASE "武器"
				EQ_MAXLIST:2++
				EQ_LIST_WE:(EQ_MAXLIST:2) = LOCAL
			CASE "防具"
				EQ_MAXLIST:3++
				EQ_LIST_AR:(EQ_MAXLIST:3) = LOCAL
		ENDSELECT
	CATCH
		CONTINUE
	ENDCATCH
NEXT

$SHOW_START
EQ_SHOW_PAGE = AUTO_SPLIT_NUM("装饰品0/装饰品1/武器/防具", "/", EQ_SHOW)
SELECTCASE EQ_SHOW
	CASE "装饰品0"
		EQ_CHOICE = EQ_LIST_AC0:EQ_LISTNUM
	CASE "装饰品1"
		EQ_CHOICE = EQ_LIST_AC1:EQ_LISTNUM
	CASE "武器"
		EQ_CHOICE = EQ_LIST_WE:EQ_LISTNUM
	CASE "防具"
		EQ_CHOICE = EQ_LIST_AR:EQ_LISTNUM
ENDSELECT
DRAWLINE
PRINTFORML 　更换装备
DRAWLINE
FOR LOCAL, 0, MAXLINE() - 7
	CALL SHOW_EQUIPLIST_LEFT, LOCAL
	CALL SHOW_EQUIPLIST_RIGHT, LOCAL
	PRINTL 
NEXT
DRAWLINE
LINE:1 = LINECOUNT
PRINTBUTTON "　[En] 确定", ""
PRINTFORM %" ", 16%
FOR LOCAL, 0, 4
	SIF EQ_CHARA != MASTER && LOCAL > 1
		CONTINUE
	CALL PRINTSBUTTON_C, AUTO_SPLIT("[+] _[-] _[*] _[/] ", "_", LOCAL) + FORMCELL(AUTO_SPLIT("饰品/饰品/法杖/服装", "/", LOCAL), 16 + (LOCAL > 1) * 2 , "CENTER"), AUTO_SPLIT("+_-_*_/", "_", LOCAL), EQ_SHOW_PAGE == LOCAL, COLOR("p-blue"), COLOR("gray")
NEXT
PRINTL 
CALL PRINTSBUTTON_C, "　[ 3] 卸下", "3", GET_EQUIP(EQ_SHOW, EQ_CHARA, "ID") >= 0, , COLOR("gray")
PRINTL 
PRINTBUTTON "　[ 9] 返回", "9"
PRINTL 
LINE:2 = LINECOUNT
$INPUT_LOOP_2
CLEARLINE LINECOUNT - LINE:2
ONEINPUTS
ENCODETOUNI %RESULTS%
IF GET_KEYMARK_NUM(RESULTS) >= 0
	IF EQ_MARKS_ABLE:GET_KEYMARK_NUM(RESULTS) >= 0
		IF EQ_LISTNUM == (GET_KEYMARK_NUM(RESULTS) + EQ_PAGE * EQ_SHOW_NUM)
			;アイテムを装着
			CALL SET_EQUIP, EQ_SHOW, EQ_CHARA, EQ_CHOICE
			;ステータスを同期させる
			CALL SET_EQUIP_FLAG, EQ_CHARA
			VARSET ITEMCHOICE
			;アイテムを削除
			ITEMCHOICE:EQ_CHOICE = 1
			CALL DEL_CHOICE_ITEM
			;外したアイテムを登録
			FOR LOCAL, GET_ITEM_RANGE("持有物品"), GET_ITEM_RANGE("持有物品", 1)
				SIF GET_ITEMDATA(LOCAL, "ID")
					CONTINUE
				CALL SWAP_ITEMDATA, LOCAL, GET_TEMP_ITEM_SLOT(EQ_SHOW_PAGE)
				BREAK
			NEXT
			CALL SHOW_BLANK
			GOTO START
			;REDRAW C_REDRAW
			;RETURN CHARALIST:EQ_LISTNUM
		ELSE
			EQ_LISTNUM = GET_KEYMARK_NUM(RESULTS) + EQ_PAGE * EQ_SHOW_NUM
		ENDIF
	ENDIF
ELSE
	SELECTCASE RESULTS
		CASE ""
			;REDRAW C_REDRAW
			;RETURN CHARALIST:EQ_LISTNUM
		CASE "+"
			EQ_SHOW = 装饰品0
		CASE "-"
			EQ_SHOW = 装饰品1
		CASE "*"
			EQ_SHOW = 武器
		CASE "/"
			EQ_SHOW = 防具
		CASE "3"
			IF GET_EQUIP(EQ_SHOW, EQ_CHARA, "ID") >= 0
				LOCAL:3 = 0
				FOR LOCAL:1, 0 , 2
					FOR LOCAL, GET_ITEM_RANGE(\@LOCAL:1 ? 篮子 #箱子 \@), RESULT:1
						SIF GET_ITEMDATA(LOCAL, "ID")
							CONTINUE
						LOCAL:3 = 1
						CALL CONVERT_EQUIP, EQ_SHOW, EQ_CHARA, LOCAL
						CSTR:EQ_CHARA:EQ_SHOW = 
						BREAK
					NEXT
					SIF LOCAL:3
						BREAK
				NEXT
			ENDIF
			IF !LOCAL:3
				CLEARLINE LINECOUNT - LINE:1
				PRINTL 持有物品已满，无法卸下！
				PRINTL 
				PRINTL 
				WAITANYKEY
			ELSE
				;ステータスを同期させる
				CALL SET_EQUIP_FLAG, EQ_CHARA
				GOTO START
			ENDIF
		CASE "8"
			EQ_LISTNUM--
		CASE "2"
			EQ_LISTNUM++
		CASE "4"
			EQ_LISTNUM -= EQ_SHOW_NUM
		CASE "6"
			EQ_LISTNUM += EQ_SHOW_NUM
		CASE "9"
		;	REDRAW C_REDRAW
			RESTART
		CASEELSE
	ENDSELECT
ENDIF
SIF EQ_LISTNUM > EQ_MAXLIST:EQ_SHOW_PAGE
	EQ_LISTNUM = 0
SIF EQ_LISTNUM < 0
	EQ_LISTNUM = MAX(EQ_MAXLIST:EQ_SHOW_PAGE, 0)
GOTO SHOW_START
@SHOW_EQUIPLIST_LEFT, ARG
#LOCALSIZE 1
#DIM TEMP
SELECTCASE ARG
	CASE 0, MAXLINE() - 12
		PRINTFORM ┌%"─" * 11%┐
	CASE MAXLINE() - 13
		PRINTFORM └%"─" * 6%页码 [{EQ_PAGE:(EQ_SHOW_PAGE)}/{EQ_MAXPAGE:(EQ_SHOW_PAGE)}]┘
	CASE MAXLINE() - 11
		PRINTFORM │%"",9%
		PRINTBUTTON "[ 8]", "8"
		PRINTFORM %"",9%│
	CASE MAXLINE() - 10
		PRINTFORM │%"",5%
		PRINTBUTTON "[ 4]", "4"
		PRINTFORM %"", 4%
		PRINTBUTTON "[ 6]", "6"
		PRINTFORM %"",5%│
	CASE MAXLINE() - 9
		PRINTFORM │%"",9%
		PRINTBUTTON "[ 2]", "2"
		PRINTFORM %"",9%│
	CASE MAXLINE() - 8
		PRINTFORM └%"─" * 11%┘
	CASEELSE
		PRINT │
		LOCAL = ARG + EQ_PAGE * EQ_SHOW_NUM - 1
		SELECTCASE EQ_SHOW
			CASE "装饰品0"
				TEMP = EQ_LIST_AC0:LOCAL
			CASE "装饰品1"
				TEMP = EQ_LIST_AC1:LOCAL
			CASE "武器"
				TEMP = EQ_LIST_WE:LOCAL
			CASE "防具"
				TEMP = EQ_LIST_AR:LOCAL
		ENDSELECT
		IF TEMP >= 0
			SIF EQ_CHOICE == TEMP
				SETCOLOR COLOR("p-green")
			PRINTBUTTON @"[%GET_KEYMARK(ARG-1)%] %FORMCELL(GET_ITEMNAME(TEMP), 18, "LEFT")%", GET_KEYMARK(ARG - 1)
			RESETCOLOR
			EQ_MARKS_ABLE:(ARG - 1) = TEMP
		ELSE
			PRINTFORM %"",22%
			EQ_MARKS_ABLE:(ARG - 1) = -1
		ENDIF
		PRINT │
ENDSELECT


@SHOW_EQUIPLIST_RIGHT, ARG
#LOCALSIZE 3
#LOCALSSIZE 8
#DIM TEMP,2
#DIMS TEMPS,3
#DIMS 基本性能0, 15
#DIMS 基本性能1, 15
#DIMS 能力加成0, 15
#DIMS 能力加成1, 15
#DIMS 主效果0, 15
#DIMS 主效果1, 15
#DIMS 特性0, 15
#DIMS 特性1, 15
SELECTCASE ARG
	CASE 0
		PRINTFORM ┌%"─" * 48%┐
		VARSET 基本性能0
		VARSET 基本性能1
		VARSET 能力加成0
		VARSET 能力加成1
		VARSET 主效果0
		VARSET 主效果1
		VARSET 特性0
		VARSET 特性1
		TEMP = GET_TEMP_ITEM_SLOT(EQ_SHOW_PAGE)
		IF GET_ITEMDATA(TEMP, "ID")
			基本性能0:0 = %FORMCELL("名称:" + GET_ITEMNAME(TEMP), 20, "LEFT")%
			基本性能0:1 = %FORMCELL("品阶:" + GET_ITEMRANK(TEMP), 20, "LEFT")%
			基本性能0:2 = %FORMCELL("品质:" + TOSTR(GET_ITEMDATA(TEMP, "品质")), 20, "LEFT")%
			LOCAL:1 = 0
			FOR LOCAL, 0, 10
				TEMPS = %AUTO_SPLIT("手活/口活/性交/施虐/受虐/诱惑/Ｃ感度/Ｖ感度/Ａ感度/Ｂ感度", "/", LOCAL)%
				CALL GET_EQUIP_STATUS, TEMPS, TEMP
				能力加成0:LOCAL = %@"%TEMPS, 6, LEFT%" + ":" + @"{RESULT, 5}", 20, LEFT%
			NEXT
			LOCAL:1 = 0
			FOR LOCAL, 0, 4
				SIF !GET_ITEMDATA(TEMP, @"主效果{LOCAL}")
					CONTINUE
				主效果0:(LOCAL:1) = %FORMCELL(GET_ITEMNAME_E(TEMP, LOCAL), 22, "LEFT")%
				LOCAL:1++
			NEXT
			LOCAL:1 = 0
			FOR LOCAL, 0, 5
				SIF !GET_ITEMDATA(TEMP, @"特性{LOCAL}")
					CONTINUE
				特性0:(LOCAL:1) = %FORMCELL(GET_ITEMNAME_P(TEMP, LOCAL), 22, "LEFT")%
				LOCAL:1++
			NEXT
		ENDIF
		IF EQ_CHOICE >= 0
			基本性能1:0 = %FORMCELL("名称:" + GET_ITEMNAME(EQ_CHOICE), 20, "LEFT")%
			基本性能1:1 = %FORMCELL("品阶:" + GET_ITEMRANK(EQ_CHOICE), 20, "LEFT")%
			基本性能1:2 = %FORMCELL("品质:" + TOSTR(GET_ITEMDATA(EQ_CHOICE, "品质")), 20, "LEFT")%
			FOR LOCAL, 0, 10
				TEMPS = %AUTO_SPLIT("手活/口活/性交/施虐/受虐/诱惑/Ｃ感度/Ｖ感度/Ａ感度/Ｂ感度", "/", LOCAL)%
				CALL GET_EQUIP_STATUS, TEMPS, EQ_CHOICE
				能力加成1:LOCAL = %@"%TEMPS, 6, LEFT%" + ":" + @"{RESULT,5}", 20, LEFT%
			NEXT
			LOCAL:1 = 0
			FOR LOCAL, 0, 4
				SIF !GET_ITEMDATA(EQ_CHOICE, @"主效果{LOCAL}")
					CONTINUE
				主效果1:(LOCAL:1) = %FORMCELL(GET_ITEMNAME_E(EQ_CHOICE, LOCAL), 22, "LEFT")%
				LOCAL:1++
			NEXT
			LOCAL:1 = 0
			FOR LOCAL, 0, 5
				SIF !GET_ITEMDATA(EQ_CHOICE, @"特性{LOCAL}")
					CONTINUE
				特性1:(LOCAL:1) = %FORMCELL(GET_ITEMNAME_P(EQ_CHOICE, LOCAL), 22, "LEFT")%
				LOCAL:1++
			NEXT
		ENDIF
	CASE 1
		PRINTFORM │%CALLNAME:EQ_CHARA, 96, LEFT%│
	CASE 2
		PRINT │体力 
		CALL PRINT_COLORBAR, BASE:EQ_CHARA:体力, GET_MAXBASE("体力", EQ_CHARA), 64, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("红"), RESULT:1
		PRINTFORM  ({BASE:EQ_CHARA:体力, 5}/{GET_MAXBASE("体力", EQ_CHARA), 5})%"",13%│
	CASE 3
		PRINT │气力 
		CALL PRINT_COLORBAR, BASE:EQ_CHARA:气力, GET_MAXBASE("气力", EQ_CHARA), 64, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("绿"), RESULT:1
		PRINTFORM  ({BASE:EQ_CHARA:气力, 5}/{GET_MAXBASE("气力", EQ_CHARA), 5})%"",13%│
	CASE 4
		PRINTFORM └%"─" * 48%┘
	CASE 5
		PRINTFORM ┌EQUIP %"─" * 45%┐
	CASE 6
		PRINT │
		FOR LOCAL, 0, 4
			IF LOCAL > 1 && EQ_CHARA != MASTER
				PRINTFORM %" " * 26%
			ELSE
				SIF LOCAL
					PRINT 　　
				IF GET_EQUIP(AUTO_SPLIT("装饰品0/装饰品1/武器/防具", "/", LOCAL), EQ_CHARA, "ID") > 0
					CALL PRINTSBUTTON_C, AUTO_SPLIT("[+] _[-] _[*] _[/] ", "_", LOCAL) + FORMCELL(GET_EQUIPNAME(AUTO_SPLIT("装饰品0/装饰品1/武器/防具", "/", LOCAL), EQ_CHARA), 16 + (LOCAL > 1) * 2, "CENTER"), AUTO_SPLIT("+_-_*_/", "_", LOCAL), EQ_SHOW_PAGE == LOCAL, COLOR("p-blue")
				ELSE
					CALL PRINTSBUTTON_C, AUTO_SPLIT("[+] _[-] _[*] _[/] ", "_", LOCAL) + FORMCELL(AUTO_SPLIT("饰品/饰品/法杖/服装", "/", LOCAL), 16 + (LOCAL > 1) * 2 , "CENTER"), AUTO_SPLIT("+_-_*_/", "_", LOCAL), EQ_SHOW_PAGE == LOCAL, COLOR("p-blue"), COLOR("gray")
				ENDIF
			ENDIF
		NEXT
		PRINT │
	CASE 7
		PRINTFORM └%"─" * 48%┘
	CASE 8, 8 + EQ_SHOW_NUM / 2
		PRINTFORM ┌基本性能%"─"* 6%┐┌能力加成%"─"* 6%┐┌主效果%"─"* 8%┐┌特性%"─"* 9%┐
	CASE 33, 33 - EQ_SHOW_NUM / 2
		PRINTFORM └%"─" * 10%┘└%"─" * 10%┘└%"─" * 11%┘└%"─" * 11%┘
	CASE 9 TO 32
		IF ARG < 8 + EQ_SHOW_NUM / 2
			PRINTFORM │%基本性能0:(ARG - 9), 20, LEFT%│
			PRINTFORM │%能力加成0:(ARG - 9), 20, LEFT%│
			PRINTFORM │%主效果0:(ARG - 9), 22, LEFT%│
			PRINTFORM │%特性0:(ARG - 9), 22, LEFT%│
		ELSE
			PRINTFORM │%基本性能1:(ARG - (9 + EQ_SHOW_NUM / 2)), 20, LEFT%│
			PRINTFORM │%能力加成1:(ARG - (9 + EQ_SHOW_NUM / 2)), 20, LEFT%│
			PRINTFORM │%主效果1:(ARG - (9 + EQ_SHOW_NUM / 2)), 22, LEFT%│
			PRINTFORM │%特性1:(ARG - (9 + EQ_SHOW_NUM / 2)), 22, LEFT%│
		ENDIF
	CASEELSE
		PRINTFORM 
ENDSELECT

;-----------------------------------------------------
;@MAKE_EQUIP
;装備の作成関数
;-----------------------------------------------------
@MAKE_EQUIP_MAIN, ARG
#LOCALSIZE 2
#LOCALSSIZE 3
#DIM L_ARG
#DIM LINE, 2
#DIM WE_LIST, 100
#DIM AR_LIST, 100
#DIMS SHOW_MODE
#DIM MAKE_ABLE, 100
#DIM CHOICE
#DIM CHOICENUM
#DIM SHOWNUM
#DIM LINENUM
#DIM TEMP
#DIMS TEMPS
SIF IS_WINDOW
	GOTO SHOW_START
L_ARG = ARG
SHOWNUM = 0
CHOICENUM = 0
SHOW_MODE = 武器
LINENUM = MAXLINE() - 6 - 4- 3 - 3
VARSET MAKE_ABLE
VARSET WE_LIST, -1
VARSET AR_LIST, -1
FOR LOCAL, 0, 100
	TRYCCALLFORM ITEM_EQUIP_MAKE_ABLE_{1601 + LOCAL}
		SIF RESULT
			WE_LIST:FINDELEMENT(WE_LIST, -1) = 1601 + LOCAL
	CATCH
	ENDCATCH
	TRYCCALLFORM ITEM_EQUIP_MAKE_ABLE_{1701 + LOCAL}
		SIF RESULT
			AR_LIST:FINDELEMENT(AR_LIST, -1) = 1701 + LOCAL
	CATCH
	ENDCATCH
NEXT
EQ_HAVE_MATERIAL = 
FOR LOCAL, GET_ITEM_RANGE("持有"), RESULT:1
	SIF !GET_CATEGORY(LOCAL, "金属块") && !GET_CATEGORY(LOCAL, "布")
		CONTINUE
	SIF STRCOUNT(EQ_HAVE_MATERIAL, GET_ITEMNAME(LOCAL)) > 2
		CONTINUE
	EQ_HAVE_MATERIAL += "_" + GET_ITEMNAME(LOCAL)
NEXT
LINE = LINECOUNT
$SHOW_START
CLEARLINE LINECOUNT - LINE
CHOICE = SHOW_MODE == "武器" ? WE_LIST:CHOICENUM # AR_LIST:CHOICENUM
DRAWLINE
CALL WINDOWPRINTL, @"　%SHOW_DAY()%%"", 8%%"-" + GET_NAME("商店", L_ARG) + "-", 40, LEFT%" + GET_ITEM_STORAGE_TEXT()
DRAWLINE
CALL WINDOWPRINTL, @"┌%"─"*10%┬%"─" * 2%┬%"─"*11%┬%"─"*11%┐┌%"─"*22%┐"
CALL WINDOWPRINT, @"│%"名称",20,LEFT%│%"等级"%│%"素材A",22,LEFT%│%"素材B",22,LEFT%│"
CALL WINDOWPRINTL, @"│%\@CHOICE >= 0 ? %GET_NAME("物品", CHOICE)% # \@,44,LEFT%│"
CALL WINDOWPRINT, "├"
CALL WINDOWPRINTBUTTON,  "─"*10, UNICODE(21004)
CALL WINDOWPRINTL, @"┼%"─"*2%┼%"─"*11%┼%"─"*11%┤├%"─"*22%┤"
FOR LOCAL, SHOWNUM, SHOWNUM + LINENUM
	TEMP = SHOW_MODE == "武器" ? WE_LIST:LOCAL # AR_LIST:LOCAL
	CALL WINDOWPRINT, "│"
	IF TEMP >= 0
		LOCALS = %GET_NAME("物品", TEMP),20,LEFT%│
		CALLFORM ITEM_LV_{TEMP}
		LOCALS += @"{RESULT,4}│"
		VARSET RESULT, 0, 0, 2
		CALLFORM ITEM_MATERIAL_{TEMP}
		FOR LOCAL:1, 0, 2
			IF RESULT
				LOCALS += @"%GET_NAME("物品", RESULT:(LOCAL:1)),22,LEFT%"
			ELSE
				LOCALS += " " * 20
			ENDIF
			SIF !LOCAL:1
				LOCALS += "│"
		NEXT
		;とりあえず1個に
		IF STRCOUNT(EQ_HAVE_MATERIAL, GET_NAME("物品", RESULT)) || (STRCOUNT(EQ_HAVE_MATERIAL, GET_NAME("物品", RESULT:1)) && RESULT:1 > 0)
		;IF STRCOUNT(EQ_HAVE_MATERIAL, GET_NAME("物品", RESULT)) >= 2 || STRCOUNT(EQ_HAVE_MATERIAL, GET_NAME("物品", RESULT:1)) >= 2 || (STRCOUNT(EQ_HAVE_MATERIAL, GET_NAME("物品", RESULT)) && STRCOUNT(EQ_HAVE_MATERIAL, GET_NAME("物品", RESULT:1)))
			MAKE_ABLE:LOCAL = 1
		ELSE
			MAKE_ABLE:LOCAL = 0
			CALL SET_COLOR, "gray"
		ENDIF
		SIF CHOICENUM == LOCAL
			CALL SET_COLOR, "p-green", 50 + MAKE_ABLE:LOCAL * 50
		CALL WINDOWPRINTBUTTON, LOCALS, UNICODE(20000 + LOCAL)
		RESETCOLOR
	ELSE
		CALL WINDOWPRINT, @"%"　"*10%│%"　" * 2%│%"　"*11%│%"　"*11%"
	ENDIF
	CALL WINDOWPRINT, "│"
	IF CHOICE >= 0
		SELECTCASE LOCAL - SHOWNUM
			CASE 0
				CALLFORM ITEM_LV_{CHOICE}
				CALL WINDOWPRINT, @"│%"Lv　:" + @"{RESULT, 5}", 44,LEFT%│"
				CALLFORM ITEM_TYPE_{CHOICE}
				LOCALS:1 = 手活/口活/性交/施虐/受虐/诱惑/Ｃ感度/Ｖ感度/Ａ感度/Ｂ感度
				CALLFORM ITEM_EFFECT_0_{CHOICE}
				LOCALS:2 = %RESULTS%
			CASE 2 TO 7
				CALL WINDOWPRINT, "│"
				FOR LOCAL:1, 0, 2
					TEMPS = %AUTO_SPLIT(LOCALS:1, "/", LOCAL - SHOWNUM - 2 + LOCAL:1 * 6)%
					IF TEMPS == ""
						CALL WINDOWPRINT, " " * 22
					ELSE
						CALLFORM ITEM_EQUIP_STATUS_{CHOICE}, TEMPS
						CALL WINDOWPRINT, @"%TEMPS +":" + @"{RESULT, 5}", 22, LEFT%"
					ENDIF
				NEXT
				CALL WINDOWPRINT, "│"
			CASE 9 TO 11
				TEMPS = %AUTO_SPLIT(LOCALS:2, "/", LOCAL - SHOWNUM - 9)%
				CALL WINDOWPRINT, "│"
				IF TEMPS == ""
					CALL WINDOWPRINT, " " * 44
				ELSE
					IF GET_KNOWN_ITEM(CHOICE, @"主效果0{LOCAL - SHOWNUM - 9}")
						CALL WINDOWPRINT, @"%\@LOCAL - SHOWNUM == 9 ? 效果: # %" " * 5%\@ + TEMPS, 44, LEFT%"
					ELSE
						CALL WINDOWPRINT, @"%\@LOCAL - SHOWNUM == 9 ? 效果: # %" " * 5%\@ + "????", 44, LEFT%"
					ENDIF
				ENDIF
				CALL WINDOWPRINT, "│"
			CASE 13
				CALLFORM ITEM_MATERIAL_{CHOICE}
				CALL WINDOWPRINT, "│" + @"%"素材:" + GET_NAME("物品", RESULT),44, LEFT%"+ "│"
			CASE 14
				RESULT:1 = 0
				CALLFORM ITEM_MATERIAL_{CHOICE}
				IF RESULT:1
					CALL WINDOWPRINT, "│" + @"%"　　 " + GET_NAME("物品", RESULT:1),44, LEFT%"+ "│"
				ELSE
					CALL WINDOWPRINT, "│" + " " * 44 + "│"
				ENDIF
			CASE LINENUM - 6
				CALL WINDOWPRINT, "├" + "─" * 22 + "┤"
				CALLFORM ITEM_EXPLAIN_{CHOICE}, 2
				TEMPS = %RESULTS%
			CASE LINENUM - 5 TO LINENUM - 1
				CALL WINDOWPRINT, @"│%AUTO_SPLIT(TEMPS, "/",LOCAL - (LINENUM - 5)), 44, LEFT%│"
			CASEELSE
				CALL WINDOWPRINT, "│" + " " * 44 + "│"
		ENDSELECT
	ELSE
		CALL WINDOWPRINT, "│" + " " * 44 + "│"
	ENDIF
	PRINTL 
NEXT
CALL WINDOWPRINTL, @"└%"─"*10%┴%"─" * 2%┴%"─"*11%┴%"─"*11%┘└%"─"*22%┘"
DRAWLINE
CALL WINDOWPRINTL, @"　%@"资金: %TOSTR(MONEY, "#,##0"),12%克尔",54,LEFT%"
DRAWLINE
SIF IS_WINDOW
	RETURN 0
LINE:1 = LINECOUNT
CALL WINDOWPRINT, @"┌%"─"*6%┐"
CALL WINDOWPRINT, @"%"", 8%"
CALL PRINTSBUTTON_C, "[0] 制造", "0",  , COLOR("gray"), 
PRINTL 

PRINTFORM │%"",4%
PRINTBUTTON @"%"[8]", 4 ,LEFT%", 8
PRINTFORM %"",4%│
PRINTFORM %"", 8%
CALL PRINTSBUTTON_C, "[1] 武器", "1", SHOW_MODE == "武器" , COLOR("p-green")
PRINTL 

PRINTFORM │
PRINTBUTTON @"%"[4]", 4 ,LEFT%", 4
PRINTFORM %"",4%
PRINTBUTTON @"%"[6]", 4 ,LEFT%", 6
PRINT │
PRINTFORM %"", 8%
CALL PRINTSBUTTON_C, "[3] 防具", "3", SHOW_MODE == "防具" , COLOR("p-green")
PRINTL 


PRINTFORM │%"",4%
PRINTBUTTON @"%"[2]", 4 ,LEFT%", 2
PRINTFORM %"",4%│
PRINTFORM %"", 8%
PRINTBUTTON "[9] 返回", "9"
PRINTL 
PRINTFORML └%"─"*6%┘
PRINTL 
ONEINPUTS
ENCODETOUNI %RESULTS%
SELECTCASE RESULT:1
	CASE 20000 TO 20999
		IF CHOICENUM == RESULT:1 - 20000
			RESULTS = 0
		ELSE
			CHOICENUM = RESULT:1 - 20000
		ENDIF
	CASE 21000 TO 21100
		RESULTS = {RESULT:1 - 21000}
	CASEELSE
ENDSELECT
SELECTCASE RESULTS
	CASE "0", " "
		CLEARLINE LINECOUNT - LINE:1
		IF MAKE_ABLE:CHOICENUM
			TEMP = SHOW_MODE == "武器" ? WE_LIST:CHOICENUM # AR_LIST:CHOICENUM
			CALL SHOW_ITEMLIST, "装备调合", "持有", TEMP, L_ARG
			IF RESULT
				CALL MAKE_EQUIP, FINDELEMENT(ITEMCHOICE, 1), TEMP,  SHOW_MODE, GET_TEMP_ITEM_SLOT()
				;FOR LOCAL, GET_ITEM_RANGE("持有"), RESULT:1
				;	MIXCHOICE:LOCAL = ITEMCHOICE:LOCAL
				;NEXT
				;CALL SET_PROPERTY_MIX, TEMP
				CALL SHOW_EQUIP_STATUS, GET_TEMP_ITEM_SLOT(), ARG
				LOCAL = GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "价格") * 2 * 价格百分比 / 100
				LOCAL = TIMESF(LOCAL, 100 - 10 * FR_SKILL_LV:GET_NO("友人技能", "灵活的手指"))
				IF LOCAL > MONEY
					CALL STORE_MESSAGE, ARG, "资金不足"
				ELSE
					CALL STORE_MESSAGE, ARG, "确认"
					CALL INPUT_YN_M, @"需要{LOCAL}克尔，确定吗？", "确定", "取消"
					IF RESULT
						CALL DEL_ITEMDATA, GET_TEMP_ITEM_SLOT()
					ELSE
						CALL SET_KNOWN_ITEM, CHOICE, "获得"
						IF GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "主效果0")
							TRYCCALLFORM ITEM_EFFECT_0_{CHOICE}
								CALL SET_KNOWN_ITEM(CHOICE, @"主效果0{AUTO_SPLIT_NUM(RESULTS, "/", GET_ITEMNAME_E(GET_TEMP_ITEM_SLOT(), 0))}")
								CALL SET_KNOWN_EFFECT, GET_ITEMNAME_E(GET_TEMP_ITEM_SLOT(), 0), "SET"
							CATCH
							ENDCATCH
						ENDIF
						MONEY -= LOCAL
						CLEARLINE 1
						LOCAL = GETCONFIG("一行の高さ") * 110 - 40
						HTML_PRINT "<p align = 'left'><nobr>" + "-" * MAXWIDTH() + @"<nonbutton pos='{LOCAL}'> <img src='订做' ypos='-2400' height='2150'></nonbutton></nobr></p>"
						CALL STORE_MESSAGE, ARG, "开始合成"
						LOCAL:1 = LINECOUNT
						FOR COUNT, 0, 12
							; CLEARLINE 1
							; HTML_PRINT "<p align = 'left'><nobr>" + "-" * MAXWIDTH() + @"<nonbutton pos='{LOCAL}'> <img src='订做' ypos='-2400' height='2150'></nonbutton></nobr></p>"
							CALL MESSAGE_WINDOW, "", "合成中" + "…" * ((COUNT / 2) % 4), , "没有动画/不再等待/不留日志"
							TWAIT 100, 1
							CLEARLINE LINECOUNT - LOCAL:1
						NEXT
						CALL STORE_MESSAGE, ARG, "完成"
						;材料を削除
						CALL DEL_CHOICE_ITEM
						;装備をアイテム欄へ
						FOR LOCAL, GET_ITEM_RANGE("持有物品"), GET_ITEM_RANGE("持有物品", 1)
							SIF GET_ITEMDATA(LOCAL, "ID")
								CONTINUE
							CALL SWAP_ITEMDATA, LOCAL, GET_TEMP_ITEM_SLOT()
							BREAK
						NEXT
					ENDIF
				ENDIF
			ENDIF
		ELSE
			CALL STORE_MESSAGE, L_ARG, "材料不足"
		ENDIF
	CASE "1"
		SHOW_MODE = 武器
	CASE "3"
		SHOW_MODE = 防具
	CASE "8"
		IF SHOW_MODE == "武器"
			IF CHOICENUM == FINDELEMENT(WE_LIST, -1) - 1 || CHOICENUM == VARSIZE("WE_LIST")  -1
				CHOICENUM = 0
			ELSE
				CHOICENUM++
			ENDIF
		ELSE
			IF CHOICENUM == FINDELEMENT(AR_LIST, -1) - 1 || CHOICENUM == VARSIZE("AR_LIST")  -1
				CHOICENUM = 0
			ELSE
				CHOICENUM++
			ENDIF
		ENDIF
	CASE "2"
		IF CHOICENUM-- == 0
			IF SHOW_MODE == "武器"
				CHOICENUM = FINDELEMENT(WE_LIST, -1) - 1
			ELSE
				CHOICENUM = FINDELEMENT(AR_LIST, -1) - 1
			ENDIF
		ENDIF
	CASE "4"
		IF CHOICENUM == 0
			IF SHOW_MODE == "武器"
				CHOICENUM = FINDELEMENT(WE_LIST, -1) - 1
			ELSE
				CHOICENUM = FINDELEMENT(AR_LIST, -1) - 1
			ENDIF
		ELSE
			CHOICENUM -= LINENUM
			SIF CHOICENUM <= 0
				CHOICENUM = 0
		ENDIF
	CASE "6"
		IF SHOW_MODE == "武器"
			IF CHOICENUM == FINDELEMENT(WE_LIST, -1) - 1 || CHOICENUM == VARSIZE("WE_LIST")  -1
				CHOICENUM = 0
			ELSE
				CHOICENUM += LINENUM
				SIF CHOICENUM >= VARSIZE("WE_LIST") || WE_LIST:CHOICENUM == -1
					CHOICENUM = FINDELEMENT(WE_LIST, -1) - 1
			ENDIF
		ELSE
			IF CHOICENUM == FINDELEMENT(AR_LIST, -1) - 1 || CHOICENUM == VARSIZE("AR_LIST")  -1
				CHOICENUM = 0
			ELSE
				CHOICENUM += LINENUM
				SIF CHOICENUM >= VARSIZE("AR_LIST") || AR_LIST:CHOICENUM == -1
					CHOICENUM = FINDELEMENT(AR_LIST, -1) - 1
			ENDIF
		ENDIF
	CASE "9"
		REDRAW CURRENTREDRAW()
		RETURN 0
ENDSELECT
GOTO SHOW_START
;-----------------------------------------------------
;装備作成関数
;ARG 	素材の番号
;ARG:1	作成アイテムの番号
;ARG:2	作る場所
;-----------------------------------------------------
@MAKE_EQUIP, ARG, ARG:1, ARGS, ARG:2 = -1
#LOCALSIZE 3
SIF ARG:2 < 0
	ARG:2 = GET_TEMP_ITEM_SLOT()
LOCAL:2 = 0
;IDのセット
CALL SET_ITEMDATA, ARG:2, "ID", ARG:1
;特性のセット
FOR LOCAL, 0, 5
	LOCAL:1 = GET_ITEMDATA(ARG, @"特性{LOCAL}")
	TRYCALLFORM PROPERTY_SUCCESSION_{LOCAL:1}
	SIF !STRCOUNT("/" + RESULTS + "/", "/" + ARGS + "/")
		CONTINUE
	CALL SET_ITEMDATA, ARG:2, @"特性{LOCAL:2}", LOCAL:1
	LOCAL:2++
NEXT

; 品质
LOCAL = GET_ITEMDATA(ARG, "品质")
; 检查品质提升
FOR LOCAL:1, 0, 5
	SELECTCASE GET_ITEMNAME_P(ARG, LOCAL:1)
		CASE "高品质Lv1"
			LOCAL = TIMESF(LOCAL, 115)
		CASE "高品质Lv2"
			LOCAL = TIMESF(LOCAL, 130)
		CASE "高品质Lv3"
			LOCAL = TIMESF(LOCAL, 150)
	ENDSELECT
NEXT
; 限制品质上限为999
CALL SET_ITEMDATA(ARG:2, "品质", MIN(999, LOCAL))
; 主效果
VARSET RESULT, 999, 0, 6
TRYCALLFORM ITEM_EFFECT_0_{ARG:1}
SELECTCASE GET_ITEMDATA(ARG, "品质") + GET_ITEMDATA(ARG, "调合类别加成值")
	CASE RESULT:1 TO RESULT:2 - 1
		LOCAL = 1
	CASE RESULT:2 TO RESULT:3 - 1
		LOCAL = 2
	CASE RESULT:3 TO RESULT:4 - 1
		LOCAL = 3
ENDSELECT
SIF LOCAL >= 0 && AUTO_SPLIT(RESULTS, "/", LOCAL) != ""
	CALL SET_ITEMDATA, ARG:2, @"主效果0", MAX(GET_NO("主效果", AUTO_SPLIT(RESULTS, "/", LOCAL)), 0)
;ランクのセット
CALL SET_QUALITY, ARG:2

;価格と等级のセット
CALLFORM ITEM_LV_{ARG:1}
LOCAL = RESULT
CALL SET_ITEMDATA, ARG:2, "等级", LOCAL
CALL SET_ITEMDATA, ARG:2, "价格", LOCAL * GET_ITEMDATA(ARG, "价格")

@SHOW_EQUIP_STATUS, ARG, ARG:1
#LOCALSIZE 4
#DIM L_ARG, 2
#DIM LINENUM
#DIM L_ID
#DIM TEMP
#DIMS TEMPS
#DIM 加成值, 10
IF !IS_WINDOW
	LINENUM = MAXLINE() - 6 - 4- 2
	L_ARG = ARG, ARG:1
	L_ID = GET_ITEMDATA(L_ARG, "ID")
	LOCALS = 手活/口活/性交/施虐/受虐/诱惑/Ｃ感度/Ｖ感度/Ａ感度/Ｂ感度
	CALLFORM ITEM_EFFECT_0_{L_ID}
	LOCALS:1 = %RESULTS%
	;アイテムランクによる加成(0~20%, ただし、最低でも0~20が入る)
	FOR LOCAL:1, 0, 10
		CALL GET_EQUIP_STATUS, AUTO_SPLIT(LOCALS, "/", LOCAL:1), L_ARG
		加成值:(LOCAL:1) = RESULT
	NEXT
ENDIF
DRAWLINE
CALL WINDOWPRINTL, @"　%SHOW_DAY()%%"", 8%%"-" + GET_NAME("商店", L_ARG:1) + "-", 40, LEFT%" + GET_ITEM_STORAGE_TEXT()
DRAWLINE
FOR LOCAL, 0, LINENUM
	SELECTCASE LOCAL
		CASE 0
			CALL WINDOWPRINT, "┌" + "─" * 22 + "┐"
		CASE 1
			CALL WINDOWPRINT, @"│%GET_ITEMNAME(L_ARG), 44,LEFT%│"
		CASE 2
			CALL WINDOWPRINT, "├" + "─" * 22 + "┤"
		CASE 3
			CALL WINDOWPRINT, @"│%"等级:" + @"{GET_ITEMDATA(L_ARG, "等级"), 5}", 44,LEFT%│"
		CASE 4
			CALL WINDOWPRINT, @"│%"品阶:" + @"%GET_ITEMRANK(L_ARG), 5%", 44,LEFT%│"
		CASE 5
			CALL WINDOWPRINT, @"│%"品质:" + @"{GET_ITEMDATA(L_ARG, "品质"), 5}", 44,LEFT%│"
		CASE 7 TO 12
			CALL WINDOWPRINT, "│"
			FOR LOCAL:1, 0, 2
				TEMP = (LOCAL - 7 + LOCAL:1 * 6)
				TEMPS = %AUTO_SPLIT(LOCALS, "/", TEMP)%
				IF TEMP < VARSIZE("加成值")
					CALL WINDOWPRINT, @"%TEMPS +":" + @"{加成值:TEMP, 5}", 22, LEFT%"
				ELSE
					CALL WINDOWPRINT, " " * 22
				ENDIF
			NEXT
			CALL WINDOWPRINT, "│"
		CASE 14 TO 16
			CALL WINDOWPRINT, "│"
			IF GET_ITEMDATA(L_ARG, @"主效果{LOCAL - 14}")
				TEMPS = %GET_ITEMNAME_E(L_ARG, LOCAL - 14)%
				TRYCCALLFORM ITEM_EFFECT_{LOCAL - 14}_{GET_ITEMDATA(L_ARG, "ID")}
					SIF !GET_KNOWN_ITEM(GET_ITEMDATA(L_ARG, "ID"), @"主效果{LOCAL - 14}{AUTO_SPLIT_NUM(RESULTS, "/", TEMPS)}")
						TEMPS = ????
				CATCH
				ENDCATCH
				CALL WINDOWPRINT, @"%\@LOCAL == 14 ? 效果: # % " " * 5% \@ + TEMPS, 44, LEFT%"
			ELSE
				CALL WINDOWPRINT, " " * 44
			ENDIF
			CALL WINDOWPRINT, "│"
		CASE 17 TO 21
			CALL WINDOWPRINT, "│"
			IF GET_ITEMDATA(L_ARG, @"特性{LOCAL - 17}")
				CALL WINDOWPRINT, @"%\@LOCAL == 17 ? 特性: # %" " * 5%\@ + GET_ITEMNAME_P(L_ARG, LOCAL - 17), 44, LEFT%"
			ELSE
				IF LOCAL == 17
					CALL WINDOWPRINT, "特性:" + " " * 39
				ELSE
					CALL WINDOWPRINT, " " * 44
				ENDIF
			ENDIF
			CALL WINDOWPRINT, "│"
		CASE LINENUM - 7
			CALL WINDOWPRINT, "├" + "─" * 22 + "┤"
			CALLFORM ITEM_EXPLAIN_{L_ID}, 2
			TEMPS = %RESULTS%
		CASE LINENUM - 6 TO LINENUM - 2
			CALL WINDOWPRINT, @"│%AUTO_SPLIT(TEMPS, "/",LOCAL - (LINENUM - 6)), 44, LEFT%│"
		CASE LINENUM - 1
			CALL WINDOWPRINT, "└" + "─" * 22 + "┘"
		CASEELSE
			CALL WINDOWPRINT, "│" + " " * 44 + "│"
	ENDSELECT
	PRINTL 
NEXT
DRAWLINE
CALL WINDOWPRINTL, @"　%@"资金: %TOSTR(MONEY, "#,##0"),12%克尔",54,LEFT%所需: %TOSTR(GET_ITEMDATA(L_ARG, "价格") * 2, "#,##0"), 12%克尔"
DRAWLINE
;-----------------------------------------------------
;@GET_EQUIP_STATUS
;装備によるFLAGのセット関数
;ARGS	能力名
;ARG	アイテム登録番号
;ARG:1	角色登録番号
;-----------------------------------------------------
@GET_EQUIP_STATUS, ARGS, ARG, ARG:1
#LOCALSIZE 3
TRYCCALLFORM ITEM_EQUIP_STATUS_{GET_ITEMDATA(ARG, "ID")}, ARGS
	LOCAL = RESULT
CATCH
	LOCAL = 0
ENDCATCH
;アイテムランクによる加成(0~20%, ただし、最低でも0~20が入る)
SIF LOCAL
	LOCAL += MAX((GET_ITEMDATA(ARG, "品阶") - 1) * 5, TIMESF(LOCAL, (GET_ITEMDATA(ARG, "品阶") - 1) * 5), 0)
FOR LOCAL:1, 0, 4
	LOCAL:2 = GET_ITEMDATA(ARG, @"主效果{LOCAL:1}")
	TRYCCALLFORM EFFECT_EQUIP_STATUS_{LOCAL:2}, ARGS, ARG, ARG:1
		LOCAL += RESULT
	CATCH
	ENDCATCH
NEXT
FOR LOCAL:1, 0, 5
	LOCAL:2 = GET_ITEMDATA(ARG, @"特性{LOCAL:1}")
	TRYCCALLFORM PROPERTY_EQUIP_STATUS_{LOCAL:2}, ARGS, ARG, ARG:1
		LOCAL += RESULT
	CATCH
	ENDCATCH
NEXT
RETURN LOCAL
;-----------------------------------------------------
;@SET_EQUIP_FLAG
;装備によるFLAGのセット関数
;ARG	角色登録番号
;-----------------------------------------------------
@SET_EQUIP_FLAG, ARG
#LOCALSIZE 3
#LOCALSSIZE 2
#DIM TEMP, 2
VARSET EQUIP:ARG:0
FOR LOCAL:1, 0, 4
	LOCALS = %AUTO_SPLIT("装饰品0/装饰品1/武器/防具", "/", LOCAL:1)%
	SIF !GET_EQUIP(LOCALS, ARG, "ID")
		CONTINUE
	FOR LOCAL:2, 0, 10
		LOCALS:1 = %AUTO_SPLIT("手活/口活/性交/受虐/施虐/诱惑/Ｃ感度/Ｖ感度/Ａ感度/Ｂ感度", "/", LOCAL:2)%
		TRYCALLFORM ITEM_EQUIP_STATUS_{GET_EQUIP(LOCALS, ARG, "ID")}, LOCALS:1
		LOCAL = RESULT
		;アイテムランクによる加成(0~20%, ただし、最低でも0~20が入る)
		SIF LOCAL
			LOCAL += MAX((GET_EQUIP(LOCALS, ARG, "品阶") - 1) * 5, TIMESF(LOCAL, (GET_EQUIP(LOCALS, ARG, "品阶") - 1) * 5), 0)
		EQUIP:ARG:(LOCALS:1 + "加成") += LOCAL
	NEXT
	LOCAL += MAX((GET_ITEMDATA(ARG, "品阶") - 2) * 5, TIMESF(LOCAL, (GET_ITEMDATA(ARG, "品阶") - 2) * 5), 0)
	FOR LOCAL, 0, 4
		TEMP = GET_EQUIP(LOCALS, ARG, @"主效果{LOCAL}")
		TRYCALLFORM EFFECT_EQUIP_{TEMP}, LOCALS, ARG
		FOR LOCAL:2, 0, 10
			LOCALS:1 = %AUTO_SPLIT("手活/口活/性交/受虐/施虐/诱惑/Ｃ感度/Ｖ感度/Ａ感度/Ｂ感度", "/", LOCAL:2)%
			TRYCCALLFORM EFFECT_EQUIP_STATUS_{TEMP}, LOCALS:1, LOCALS, ARG
				EQUIP:ARG:(LOCALS:1 + "加成") += RESULT
			CATCH
				BREAK
			ENDCATCH
		NEXT
	NEXT
	FOR LOCAL, 0, 5
		TEMP = GET_EQUIP(LOCALS, ARG, @"特性{LOCAL}")
		TRYCALLFORM PROPERTY_EQUIP_{TEMP}, LOCALS, ARG
		FOR LOCAL:2, 0, 10
			LOCALS:1 = %AUTO_SPLIT("手活/口活/性交/受虐/施虐/诱惑/Ｃ感度/Ｖ感度/Ａ感度/Ｂ感度", "/", LOCAL:2)%
			TRYCCALLFORM PROPERTY_EQUIP_STATUS_{TEMP}, LOCALS:1, LOCALS, ARG
				EQUIP:ARG:(LOCALS:1 + "加成") += RESULT
			CATCH
				BREAK
			ENDCATCH
		NEXT
	NEXT
NEXT
BASE:ARG:体力 = MIN(BASE:ARG:体力, GET_MAXBASE("体力", ARG))
BASE:ARG:气力 = MIN(BASE:ARG:气力, GET_MAXBASE("气力", ARG))
