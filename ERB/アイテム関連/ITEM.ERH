#DEFINE ITEMSLOTBASKETMAX 200
#DEFINE ITEMSLOTBOXMAX 4000
#DEFINE ITEMSLOTTEMPMAX 200
#DEFINE ITEMSLOTSHOPMAX 400
#DEFINE ITEMSLOTEXPLOREMAX 10

#DEFINE ITEMSLOTBOXSTART 200
#DEFINE ITEMSLOTTEMPSTART 4200
#DEFINE ITEMSLOTSHOPSTART 4400
#DEFINE ITEMSLOTEXPLORESTART 4800
#DEFINE ITEMSLOTTOTAL 4810

#DIM ITEMLIST, 4810                       ;アイテムを一覧表示するための登録テーブル
#DIM ITEMCHOICE, 4810                     ;アイテムが選択されている状态であることを保存するテーブル
#DIM MIXLIST, 4810                        ;アイテムが调合アイテムとして利用できるかを保存するテーブル
#DIM MIXCHOICE, 4810                      ;アイテムが调合アイテムとして指定されているかを保存するテーブル
#DIM MIXHELP, 1                           ;调合アイテム選択時にHELPのボタンを表示するかどうか
#DIM P_LIST, 1600                         ;継承可能となっている特性の登録テーブル
#DIM GAIN_P_LIST, 1600                    ;ソート済みの特性テーブル
#DIM PROPERTY_MAXPAGE                     ;ソート済みの特性テーブルの最大ページ数
#DIM GLOBAL SAVEDATA PROPERTYCOST, 1600   ;特性のコスト、計算用
#DIM 持有物品, 4810                       ;アイテム所持のきろくリスト
#DIM SAVEDATA RECIPE, 100                 ;レシピ所持の記録リスト
#DIMS SORT_PREVS                          ;前回ソートの内容。昇降逆転で使う

#DIM EQ_CHARA                             ;装備変更中の角色
#DIM EQ_CHOICE                            ;選択中のアイテム

#DIMS EQ_SHOW                             ;装備リストの表示内容
#DIM EQ_SHOW_PAGE                         ;装備リストの番号版

#DIM EQ_PAGE, 4                           ;装備候補のページ
#DIM EQ_MAXPAGE, 4                        ;装備候補の最大ページ
#DIM EQ_MAXLIST, 4                        ;リストの最大番号
#DIM EQ_LISTNUM, 4                        ;選択中のリスト番号

#DIM EQ_SHOW_NUM                          ;装備の表示行数

#DIM EQ_LIST_AC0, 4810                    ;装備候補アクセサリー
#DIM EQ_LIST_AC1, 4810                    ;装備候補アクセサリー
#DIM EQ_LIST_WE, 4810                     ;装備候補武器
#DIM EQ_LIST_AR, 4810                     ;装備候補衣服

#DIM EQ_MARKS_ABLE, 52

#DIMS EQ_HAVE_MATERIAL

#DIM SAVEDATA HOMU_MIX_PROPERTY, 2, 5, 8
#DIM SAVEDATA USE_JUEL, 2, 5, 100
