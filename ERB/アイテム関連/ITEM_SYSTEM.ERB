;---------------------------------------------------------------------
;@GET_EFFECT_POWER
;ARG		調べるアイテム登録番号
;ARG:1		対象
;ARG:2		使用者
;---------------------------------------------------------------------
@GET_EFFECT_POWER, ARG, ARG:1 = -1, ARG:2 = -1
#DIM 效果系数
#DIM TEMP
#DIMS L_TYPE
;基本係数 60 + 45 ~ -60 - 30 = 100 ~ -90
效果系数 = 100
效果系数 += (GET_ITEMDATA(ARG, "品质") - 60)
效果系数 += 15 * (GET_ITEMDATA(ARG, "品阶") - 2)
CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG, "ID")} 
L_TYPE '= RESULTS
FOR LOCAL, 0, 5
	SIF GET_ITEMDATA(ARG, @"特性{LOCAL}") <= 0
		CONTINUE
	SELECTCASE GET_ITEMNAME_P(ARG, LOCAL)
		CASE "效果上升Lv1"
			效果系数 += 10
		CASE "效果上升Lv2"
			效果系数 += 20
		CASE "效果上升Lv3"
			效果系数 += 30
		;並1 娇小2 高挑0　並1　貧2 巨0として、0~4 * 5で0~20%　これにLv1~3で最大60%
		CASE "小体型奖励Lv1", "小体型奖励Lv2", "小体型奖励Lv3"
			SIF ARG:1 == -1
				CONTINUE
			效果系数 += (2 + GET_TALENT("娇小", ARG:1) - GET_TALENT("高挑", ARG:1) + GET_TALENT("贫乳", ARG:1) - GET_TALENT("巨乳", ARG:1)) * (AUTO_SPLIT_NUM("小体型奖励Lv1/小体型奖励Lv2/小体型奖励Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 5
		;小型の逆
		CASE "大体型奖励Lv1", "大体型奖励Lv2", "大体型奖励Lv3"
			SIF ARG:1 == -1
				CONTINUE
			效果系数 += (2 - GET_TALENT("娇小", ARG:1) + GET_TALENT("高挑", ARG:1) - GET_TALENT("贫乳", ARG:1) + GET_TALENT("巨乳", ARG:1)) * (AUTO_SPLIT_NUM("大体型奖励Lv1/大体型奖励Lv2/大体型奖励Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 5
		;コスト*1, 1.5, 2
		;合計コストも低くなるので本家よりだいぶおとなしく。また調整いれるかも？
		CASE "特性强化Lv1", "特性强化Lv2", "特性强化Lv3"
			LOCAL:2 = 0
			FOR LOCAL:1, 0, 5
				RESULT = 0
				LOCAL:2 += PROPERTYCOST:GET_ITEMDATA(ARG, @"特性{LOCAL:1}")
			NEXT
			效果系数 += LOCAL:2 * (AUTO_SPLIT_NUM("特性强化Lv1/特性强化Lv2/特性强化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 2) * 5 / 10
		;ランクはE0でS5なので0~20%
		CASE "等阶强化Lv1", "等阶强化Lv2", "等阶强化Lv3"
			效果系数 += GET_ITEMDATA(ARG, "品阶") * (AUTO_SPLIT_NUM("等阶强化Lv1/等阶强化Lv2/等阶强化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 4
		;使用次数が1回の時限定で25%/50%/75%
		CASE "耗竭强化Lv1", "耗竭强化Lv2", "耗竭强化Lv3"
			效果系数 += (GET_ITEMDATA(ARG, "使用次数") == 1) * (AUTO_SPLIT_NUM("耗竭强化Lv1/耗竭强化Lv2/耗竭强化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 25
		CASE "连锁奖励Lv1", "连锁奖励Lv2", "连锁奖励Lv3"
			效果系数 += (TFLAG:连锁系数 - 100) * (AUTO_SPLIT_NUM("连锁奖励Lv1/连锁奖励Lv2/连锁奖励Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) / 10
	ENDSELECT
NEXT
SIF GET_NO("SHOP", "调教") == FLAG:SHOP指令
	效果系数 += TRAIN_STATE_POWER_连锁特效(ARG:1, ARG:2)
SIF FR_SKILL_USE:GET_NO("友人技能", "使用之力")
	效果系数 += FR_SKILL_LV:GET_NO("友人技能", "使用之力") * 20
SIF FR_SKILL_USE:GET_NO("友人技能", "复制")
	效果系数 = TIMESF(效果系数, FR_SKILL_LV:GET_NO("友人技能", "复制") * 25)
RETURN MAX(效果系数, 10)

;---------------------------------------------------------------------
;@SET_EFFECT_POWER
;ARGS		セット対象のTCVAR
;ARG		セットの基礎ターン
;ARG:1		セットの基礎倍率
;ARG:2		アイテム登録番号
;ARG:3		調教対象
;ARG:4		调教者
;ARGS:1		アイテムが回復アイテムだった場合の対象BASE
;---------------------------------------------------------------------
@SET_EFFECT_TURN, ARGS, ARG = 3, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1 = "体力"
#LOCALSIZE 2
;基礎パワーを取得
CALL GET_EFFECT_POWER, ARG:2, ARG:3, ARG:4
LOCAL = RESULT

;パワーの設定
CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG:2, "ID")}
IF RESULTS == "恢复"
	CALL ITEM_HEAL_POWER, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1
	TCVAR:(ARG:3):ARGS = RESULT
ELSE
	CALL GET_EFFECT_POWER, ARG:2, ARG:3, ARG:4
	TCVAR:(ARG:3):ARGS = ARG:1 * LOCAL / 100
ENDIF
;継続ターン数の設定
LOCAL:1 = ARG
LOCAL:1 += LOCAL / 100
TCVAR:(ARG:3):(ARGS + "持续") = LOCAL:1
;---------------------------------------------------------------------
;@CALCF_EQUIP_POWER
;ARG		係数の基本值
;ARGS		装備箇所(あるいはアイテム番号)
;ARG:1		対象の角色
;200%~52%くらい
;---------------------------------------------------------------------
@CALCF_EQUIP_POWER, ARG, ARGS, ARG:1
#FUNCTION
IF ARG >= 0
	IF ISNUMERIC(ARGS)
		RETURNF CALCF(ARG, GET_ITEMDATA(TOINT(ARGS), "品质") - 60 + 15 * (GET_ITEMDATA(TOINT(ARGS), "品阶") - 2))
	ELSE
		RETURNF CALCF(ARG, GET_EQUIP(ARGS, ARG:1, "品质") - 60 + 15 * (GET_EQUIP(ARGS, ARG:1, "品阶") - 2))
	ENDIF
ELSE
	IF ISNUMERIC(ARGS)
		RETURNF CALCF(ARG, -(GET_ITEMDATA(TOINT(ARGS), "品质") - 60 + 15 * (GET_ITEMDATA(TOINT(ARGS), "品阶") - 2)))
	ELSE
		RETURNF CALCF(ARG, -(GET_EQUIP(ARGS, ARG:1, "品质") - 60 + 15 * (GET_EQUIP(ARGS, ARG:1, "品阶") - 2)))
	ENDIF
ENDIF
;----------------------------------
;@ITEM_HEAL
;アイテムによる回復関数
;ARG	基礎回復量
;ARG:1　アイテム登録番号
;ARG;2	使用対象
;ARG:3	使用者
;ARGS	対象となるBASE
;----------------------------------
@ITEM_HEAL, ARG, ARG:1, ARG:2, ARG:3, ARGS = "体力"
;效果の加算
CALL ITEM_HEAL_POWER, ARG, ARG:1, ARG:2, ARG:3, ARGS
DOWNBASE:(ARG:2):ARGS -= RESULT
RETURN ARG

;----------------------------------
;@ITEM_HEAL＿POWER
;アイテムによる恢复力の獲得関数
;ARG	基礎回復量
;ARG:1　アイテム登録番号
;ARG;2	使用対象
;ARG:3	使用者
;ARGS	対象となるBASE
;----------------------------------
@ITEM_HEAL_POWER, ARG, ARG:1, ARG:2, ARG:3, ARGS = "体力"
#LOCALSIZE 1
;效果の加算
CALL GET_EFFECT_POWER, ARG:1, ARG:2, ARG:3
ARG *= RESULT
ARG /= 100

LOCAL = 0
LOCAL += TRAIN_SKILL_POWER_恢复力(ARG:2, ARG:3)
LOCAL += FR_SKILL_LV:GET_NO("友人技能", "美味的吃法") * 20
ARG = CALCF(ARG, LOCAL)
RETURN ARG

;------------------------------------
;@GET_ITEM_RANGE
;ARGSのDAでの配列の開始点と終点をとる
;------------------------------------
@GET_ITEM_RANGE, ARGS, ARG = -1
#FUNCTION
SELECTCASE ARGS
	CASE "篮子"
		IF ARG == -1
			RESULT:1 = 100
			RETURNF 0
		ELSE
			RETURNF 100
		ENDIF
	CASE "箱子"
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 100
		ELSE
			RETURNF 1100
		ENDIF
	CASE "持有"
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 0
		ELSE
			RETURNF 1100
		ENDIF
	CASE "临时"
		IF ARG == -1
			RESULT:1 = 1200
			RETURNF 1100
		ELSE
			RETURNF 1200
		ENDIF
	CASE "商店"
		IF ARG == -1
			RESULT:1 = 1500
			RETURNF 1200
		ELSE
			RETURNF 1500
		ENDIF
	CASE "探索装备"
		IF ARG == -1
			RESULT:1 = 1510
			RETURNF 1500
		ELSE
			RETURNF 1510
		ENDIF
	CASE "所有"
		IF ARG == -1
			RESULT:1 = VARSIZE("DA")
			RETURNF 0
		ELSE
			RETURNF VARSIZE("DA")
		ENDIF
		
	CASEELSE
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 0
		ELSE
			RETURNF 1100
		ENDIF
ENDSELECT

;---------------------------------------------------------------------
;@SET_QUALITY
;ARG 		:セット対象なるアイテム番号
;
;アイテムの品质ランクを設定する関数
;  0/  1/  2/  3/  4/  5
;  E/  D/  C/  B/  A/   S
;  0/ 40/ 55/ 70/ 85/ 100
;
;ランクは品质＋特性による加成值で決定される
;---------------------------------------------------------------------
@SET_QUALITY, ARG
#LOCALSIZE 2
LOCAL:1 = GET_ITEMDATA(ARG, "品质")
FOR LOCAL, 0, 5
	CALL PROPERTY_RIZE_QUALITY, GET_ITEMDATA(ARG, @"特性{LOCAL}")
	LOCAL:1 += RESULT
NEXT
;品质が100を超えないとSはつかない
SIF GET_ITEMDATA(ARG, "品质") <= 100
	LOCAL:1 = MIN(LOCAL:1, 99)
CALL SET_ITEMDATA, ARG, "品阶", LIMIT((LOCAL:1 - 25) / 15, 0, 5)



;---------------------------------------------------------------------
;@SET_PRICE
;ARG 		:セット対象となるアイテム番号
;---------------------------------------------------------------------
@SET_PRICE, ARG
#DIM PRICE
#LOCALSIZE 2
;基礎价格
CALLFORM ITEM_PRICE_{GET_ITEMDATA(ARG, "ID")}
PRICE = RESULT
LOCAL = 0
;品质で-30% ~ 30%
LOCAL = (GET_ITEMDATA(ARG, "品质") - 60) / 2
;ランクで-40% ~ 60%
LOCAL += (GET_ITEMDATA(ARG, "品阶") - 2) * 20

FOR LOCAL:1, 0, 5
	CALL PROPERTY_PRICE, GET_ITEMDATA(ARG, @"特性{LOCAL:1}")
	LOCAL += RESULT
NEXT

PRICE = MAX(PRICE * (LOCAL  + 100) / 100, 1)
CALL SET_ITEMDATA, ARG, "价格", MIN(PRICE, POWER(10, 10) - 1)

;量販价格設定
LOCAL = (GET_ITEMDATA(ARG, "等级") / 5) *(GET_ITEMDATA(ARG, "等级") / 5) * 10 + 250
PRICE = MAX(PRICE * LOCAL / 100, 1)
CALL SET_ITEMDATA, ARG, "批发价格", MIN(PRICE, POWER(10, 10) - 1)

;---------------------------------------------------------------------
;@SET_REVICE
;ARG 		:セット対象となるアイテム番号
;---------------------------------------------------------------------
@SET_REVICE, ARG
#DIM L_CATEGORY
#DIM L_COST
#LOCALSIZE 2
L_CATEGORY = 0
L_COST = 0
FOR LOCAL, 0, 5
	SELECTCASE GET_ITEMNAME_P(ARG, LOCAL)
		CASE "蕴含力量Lv1"
			L_CATEGORY =+ 5
		CASE "蕴含力量Lv2"
			L_CATEGORY += 7
		CASE "蕴含力量Lv3"
			L_CATEGORY += 10
		CASE "消耗额等级+1"
			L_COST += 5
		CASE "消耗额等级+2"
			L_COST += 10
		CASE "消耗额等级+3"
			L_COST += 15
	ENDSELECT
NEXT
SELECTCASE GET_ITEMNAME_E(ARG, 0)
	CASE "红玉"
		L_CATEGORY =+ 30
	CASE "翠玉"
		L_CATEGORY += 60
	CASE "金刚石"
		L_CATEGORY += 90
ENDSELECT
CALL SET_ITEMDATA(ARG, "调合类别加成值", L_CATEGORY)
CALL SET_ITEMDATA(ARG, "消耗额加成值", L_COST)
;----------------------------------------------------------------------
;@SET_ITEMLIST
;ARGS		:リストを利用する用途(篮子/箱子/所持(篮子+箱子)/帰還/獲得アイテム/调合/調教)
;ARGS:1		:リストに登録するアイテムの範囲
;ARG		:调合の場合の指定番号
;ARGS:2		:アイテム選択時の条件になる関数
;表示するアイテムのリストを作成する関数
;ここで作成されたリストがSHOW_ITEMLISTで表示される
;----------------------------------------------------------------------
@SET_ITEMLIST, ARGS, ARGS:1, ARG, ARGS:2
#LOCALSIZE 2
#LOCALSSIZE 10
#DIM L_CATEGORY
#DIM START
#DIM END
#DIM TEMP, 3
VARSET ITEM_ABLE, -1
VARSET ITEMLIST, -1
IF ARGS:1 == "篮子"
	START = 0
	END = 100
ELSE
	START = GET_ITEM_RANGE(ARGS:1)
	END = RESULT:1
ENDIF
IF ARGS == "装备调合"
	RESULT = 0, 0
	CALLFORM ITEM_MATERIAL_{ARG}
	TEMP:1 = RESULT, RESULT:1
ENDIF
IF ARGS == "批发商店登记"
	L_CATEGORY = 0
	CALLFORM STORE_SALL_ABLE_%ARGS:2%
	SPLIT RESULTS, "/", LOCALS
	FOR LOCAL, 0, RESULT
		SETBIT L_CATEGORY, GET_NO("调合类别", LOCALS:LOCAL)
	NEXT
ENDIF
			
LOCAL:1 = 0
FOR LOCAL, START, END
	IF ARGS == "选择物品"
		CALLFORM %ARGS:2%, LOCAL
		SIF !RESULT
			CONTINUE
	ELSE
		TEMP = GET_ITEMDATA(LOCAL, "ID")
		;アイテムIDがない場合登録しない
		SIF TEMP <= 0
			CONTINUE
		IF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
			SIF !GETBIT(MIXLIST:LOCAL, ARG)
				CONTINUE
			;他のリストで選ばれている場合
			SIF MIXCHOICE:LOCAL > 0 && !GETBIT(MIXCHOICE:LOCAL, ARG)
				CONTINUE
		ELSEIF ARGS == "汇报委托"
			SIF TEMP != GET_REQ(ARG, "ID")
				CONTINUE
		ELSEIF ARGS == "使用物品"
			TRYCCALLFORM ITEM_TYPE_{TEMP}
				SIF RESULTS != "料理"
					CONTINUE
			CATCH
				CONTINUE
			ENDCATCH
		ELSEIF ARGS == "调教"
			TRYCCALLFORM ITEM_TYPE_{TEMP}
				SIF RESULTS != "调教" && RESULTS != "恢复"
					CONTINUE
				;コマンド内で分岐するかチェック
				TRYCCALLFORM ITEM_BRUNCH_{TEMP}, TARGET, PLAYER, LOCAL
					ITEM_BRUNCH:(LOCAL:1) = RESULT
				CATCH
					ITEM_BRUNCH:(LOCAL:1) = 0
				ENDCATCH
				;ABLEチェック
				TRYCCALLFORM COM_ABLE, TEMP, TARGET, PLAYER, LOCAL
					ITEM_ABLE:(LOCAL:1) = RESULT
					SIF RESULT == -1
						CONTINUE
				CATCH
				ENDCATCH
			CATCH
				CONTINUE
			ENDCATCH
		ELSEIF ARGS == "装备调合"
			SIF !GROUPMATCH(TEMP, TEMP:1, TEMP:2)
				CONTINUE
		ELSEIF ARGS == "批发商店登记"
			SIF !INRANGE(GET_ITEMDATA(LOCAL, "ID"), 501, 1500)
				CONTINUE
			SIF !(L_CATEGORY & GET_ITEMDATA(LOCAL, "调合类别"))
				CONTINUE
		ENDIF
	ENDIF
	ITEMLIST:(LOCAL:1) = LOCAL
	;ITEMLIST:(LOCAL:1) = LOCAL
	LOCAL:1++
NEXT
RETURN LOCAL:1
;---------------------------------------------------------------------
;@DEL_CHOICE_ITEM
;ARGS		:@SET_ITEMLISTのものと同じ。アイテムリストが破壊されるので再登録させるのに利用
;ARGS:1		:同上
;ARG
;
;選択したアイテムすべてを削除する
;---------------------------------------------------------------------
@DEL_CHOICE_ITEM, ARGS, ARGS:1, ARG
#LOCALSIZE 1
;まずは削除
FOR LOCAL, 0, VARSIZE("ITEMCHOICE")
	SIF !ITEMCHOICE:LOCAL
		CONTINUE
	;SIF !ITEMCHOICE:LOCAL
	CALL DEL_ITEMDATA, LOCAL
NEXT
;選択抹消
VARSET ITEMCHOICE

;発生した空アイテムを詰める
CALL DISPOSE_OF_ITEM

;リスト再生成
SIF GROUPMATCH("", ARGS, ARGS:1) + (ARG > 0) < 3
	CALL SET_ITEMLIST, ARGS, ARGS:1, ARG

;---------------------------------------------------------------------
;@MOVE_ITEM
;ARGS		送り先(篮子/箱子)
;ARGS:1		:@SET_ITEMLISTのARGS:1と同じ。アイテムリストが破壊されるので再登録させるのに利用
;ARGS:2		:同上
;ARG		:同上
;
;アイテム移動関数
;選択状态のアイテムを送り先に移す
;---------------------------------------------------------------------
@MOVE_ITEM, ARGS, ARGS:1, ARGS:2, ARG
#LOCALSIZE 4
#DIM START
#DIM END
IF ARGS == "篮子"
	START = 0
	END = BASKET_SIZE()
ELSEIF ARGS == "箱子"
	START = 100
	END = 1100
ELSE
	START = 1100
	END = 1200
ENDIF
LOCAL:1 = 0
FOR LOCAL, 0, 1200
	;選択されてないアイテムはスルー
	;SIF !ITEMCHOICE:LOCAL
	SIF !ITEMCHOICE:LOCAL
		CONTINUE
	WHILE START < END
		;アイテムが入ってなかったら入れ替える
		IF !GET_ITEMDATA(START, "ID")
			;交換して入れ替える
			;PRINTFORML SWAP [{LOCAL}] と [{START}]
			CALL SWAP_ITEMDATA(LOCAL, START)
			;選択を解除
			ITEMCHOICE:LOCAL = 0
			BREAK
		ENDIF
		START++
	WEND
NEXT
;移動によって発生した空白を詰める
CALL DISPOSE_OF_ITEM
;リスト再生成
SIF GROUPMATCH("", ARGS:1, ARGS:2) + (ARG > 0) < 3
	CALL SET_ITEMLIST, ARGS:1, ARGS:2, ARG
;最大值が0でない、つまり選択がすべて空になっていれば真が帰り
;偽の場合、入りきらなかったことを示す
RETURN !MAXARRAY(ITEMCHOICE)
;RETURN !MAXARRAY(ITEMCHOICE)

;---------------------------------------------------------------------
;@DISPOSE_OF_ITEM
;
;DAに発生した空欄を詰める関数
;@MOVE_ITEM/DEL_CHOICE_ITEMの下部関数
;---------------------------------------------------------------------
@DISPOSE_OF_ITEM
#LOCALSIZE 2
;篮子の空白を詰める
LOCAL:1 = 0
FOR LOCAL, 0, 99
	SIF GET_ITEMDATA(LOCAL, "ID")
		CONTINUE
	LOCAL:1 = MAX(LOCAL+1, LOCAL:1)
	WHILE LOCAL:1 < 100
		IF GET_ITEMDATA(LOCAL:1, "ID")
			;CALL SWAP(LOCAL, LOCAL:1)
			CALL SWAP_ITEMDATA(LOCAL, LOCAL:1)
			SWAP ITEMCHOICE:LOCAL, ITEMCHOICE:(LOCAL:1)
			LOCAL:1++
			BREAK
		ENDIF
		LOCAL:1++
	WEND
NEXT
LOCAL:1 = 100
;箱子の空白を詰める
FOR LOCAL, 100, 1100
	SIF GET_ITEMDATA(LOCAL, "ID")
		CONTINUE
	LOCAL:1 = MAX(LOCAL+1, LOCAL:1)
	WHILE LOCAL:1 < 1100
		IF GET_ITEMDATA(LOCAL:1, "ID")
			;CALL SWAP(LOCAL, LOCAL:1)
			CALL SWAP_ITEMDATA(LOCAL, LOCAL:1)
			SWAP ITEMCHOICE:LOCAL, ITEMCHOICE:(LOCAL:1)
			LOCAL:1++
			BREAK
		ENDIF
		LOCAL:1++
	WEND
NEXT
LOCAL:1 = 1100
;テンポラリの空白を詰める
FOR LOCAL, 1100, 1200
	SIF GET_ITEMDATA(LOCAL, "ID")
		CONTINUE
	LOCAL:1 = MAX(LOCAL+1, LOCAL:1)
	WHILE LOCAL:1 < 1100
		IF GET_ITEMDATA(LOCAL:1, "ID")
			;CALL SWAP(LOCAL, LOCAL:1)
			CALL SWAP_ITEMDATA(LOCAL, LOCAL:1)
			LOCAL:1++
			BREAK
		ENDIF
		LOCAL:1++
	WEND
NEXT

;---------------------------------------------------------------------
;@ITEM_SORT
;ARGS 排序パターン
;ARG  排序する際の配列の要素数
;
;アイテムリストの排序関数
;---------------------------------------------------------------------
@ITEMLIST_SORT, ARGS, ARG
#LOCALSIZE 3
#LOCALSSIZE 10
#DIMS SORT_NAMELIST, 1500
#DIMS TEMPS
#DIMS 升降
升降 = BACK
VARSET LOCALS
IF GROUPMATCH(ARGS, "+", "-", "*", "/", ".")
	SPLIT GLOBALS:("排序" + ARGS), "/", LOCALS
ELSE
	LOCALS:1 = %ARGS%
ENDIF
LOCAL:2 = 1
WHILE LOCALS:(LOCAL:2) != ""
	SELECTCASE LOCALS:(LOCAL:2)
		CASE "名称"
			VARSET SORT_NAMELIST
			FOR LOCAL, 0, ARG
				SORT_NAMELIST:LOCAL '= GET_ITEMNAME(ITEMLIST:LOCAL) + "_0" + @"{LOCAL}"
			NEXT
			ARRAYSORT SORT_NAMELIST, BACK, 0, ARG
			FOR LOCAL, 0, ARG
				ITEMLIST:AUTO_SPLIT_INT(SORT_NAMELIST:LOCAL, "_", 1) += (LOCAL * 10000 + LOCAL) *10000
			NEXT
		CASE "登记顺序", "登记"
			升降 = FORWARD
		CASE "品质", "品阶", "等级"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, LOCALS:(LOCAL:2)) * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
		CASE "ID"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, "ID") * 10000 + LOCAL) * 10000
			NEXT
			升降 = FORWARD
		CASE "特性"
			CLEARLINE 7
			PRINTFORML 请输入要检索特性的名称
			CALL ADD_LINE, 5
			INPUTS
			升降 = %RESULTS%
			FOR LOCAL, 0, ARG
				FOR LOCAL:1, 0, 5
					IF STRCOUNT(GET_ITEMNAME_P(ITEMLIST:LOCAL, LOCAL:1), 升降)
						ITEMLIST:LOCAL += 10000 * 10000
						BREAK
					ENDIF
				NEXT
				ITEMLIST:LOCAL += (VARSIZE("ITEMLIST") - LOCAL) * 10000
			NEXT
			升降 = BACK
		CASE "已选择"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (ITEMCHOICE:(ITEMLIST:LOCAL) * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
		CASE "持有数"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += ((MATCH(持有物品, GET_ITEMDATA(ITEMLIST:LOCAL, "ID")) * 10000 + (VARSIZE("ITEMLIST") - LOCAL))) * 10000
			NEXT
		CASE "价格"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, "价格") * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
	ENDSELECT
	IF SORT_PREVS == ARGS
		IF 升降 == "FORWARD"
			升降 = BACK
		ELSE
			升降 = FORWARD
		ENDIF
		;逆転したら消しとく
		ARGS = 
	ENDIF
	IF 升降 == "FORWARD"
		ARRAYSORT ITEMLIST, FORWARD, 0, ARG
	ELSE
		ARRAYSORT ITEMLIST, BACK, 0, ARG
	ENDIF
	FOR LOCAL, 0, ARG
		ITEMLIST:LOCAL %= 10000
	NEXT
	LOCAL:2++
WEND
SORT_PREVS = %ARGS%
;---------------------------------------
;排序设置関数
;ユーザーが排序のマクロを組むことができる
;---------------------------------------
@SET_SORT
#LOCALSSIZE 6
#DIM LINE, 2
#LOCALSIZE 2
#DIM SETNUM
#DIMS 排序
排序 = NONE/登记顺序/名称/品质/品阶/等级/ID/价格/持有数/特性/已选择
LINE = LINECOUNT
SETNUM = -1
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTL 　排序设置
DRAWLINE
FOR LOCAL:1, 0, 5
	VARSET LOCALS
	SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL:1)), "/", LOCALS
	PRINTPLAINFORM ┌[%AUTO_SPLIT("+_-_*_/_.", "_", LOCAL:1)%] %"─"*59%┐
	PRINTL 
	PRINTFORML │[{LOCAL:1 * 6,2}] 名称　: %LOCALS:0,109,LEFT%│
	FOR LOCAL, 1, 6
		IF LOCAL % 3 == 1
			PRINT │
		ELSE
			PRINT  
		ENDIF
		SIF SETNUM == LOCAL:1 * 6 + LOCAL
			SETCOLOR COLOR("p-green")
		PRINTBUTTON @"[{LOCAL:1 * 6 + LOCAL, 2}] %LOCALS:LOCAL, 35,LEFT%", LOCAL:1 * 6 + LOCAL
		RESETCOLOR
		SIF LOCAL % 3 == 0
		PRINTL │
	NEXT
	PRINTFORML %"", 41%│
	PRINTFORML └%"─"*61%┘
NEXT
DRAWLINE
LINE:1 = LINECOUNT
IF SETNUM >= 0
	PRINTL 请选择要设置的排序内容。
	FOR LOCAL, 0, 32
		IF AUTO_SPLIT(排序, "/", LOCAL) != ""
			PRINTBUTTON @"[{LOCAL + 30, 2}] %AUTO_SPLIT(排序, "/", LOCAL), 25, LEFT%", LOCAL + 30
		ELSE
			PRINTFORM %"",30%
		ENDIF
		SIF LOCAL % 4 == 3
			PRINTL 
	NEXT
ELSE
	PRINTL 请设置排序规则。
	PRINTL 若在一个排序规则中设置多个排序条件，系统将连续执行排序。
	PRINTL 比如说，若登记品质和ID，会先按品质顺序排序，再按ID顺序二次排序
	PRINTL 通过这种方式，可实现以下效果：先按物品种类分组，再在同类中按品质降序排列。
	PRINTL 请巧妙组合排序条件，创建符合使用习惯的排序规则。
	PRINTL 
	PRINTL 使用鼠标时，也可直接点击物品列表顶部的LV或品质等部分来进行排序。
ENDIF
CALL EQUATE_LINE, LINE + MAXLINE() - 2
DRAWLINE
PRINTL [99] 结束
INPUT
IF RESULT == 99
	SAVEGLOBAL
	RETURN 0
ELSEIF INRANGE(RESULT, 0, 29)
	IF RESULT % 6 == 0
		LOCAL = RESULT / 6
		CLEARLINE LINECOUNT - LINE:1
		PRINTL 请输入排序规则名称。
		PRINTL 名称最长支持半角14字符 
		CALL EQUATE_LINE, LINE + MAXLINE() - 2
		DRAWLINE
		PRINTL [99] 结束
		INPUTS
		CLEARLINE LINECOUNT - LINE:1
		IF STRLENS(RESULTS) > 14
			PRINTL 名称过长! 
			CALL EQUATE_LINE, LINE + MAXLINE() - 2
			DRAWLINE
			PRINTW [99] 结束
		ELSEIF RESULTS != ""
			SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)), "/", LOCALS
			LOCALS = %RESULTS%
			GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) = 
			FOR LOCAL:1, 0, 6
				SIF LOCAL:1
					GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) += "/"
				GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) += LOCALS:(LOCAL:1)
			NEXT
		ENDIF
	ELSE
		IF SETNUM == RESULT
			SETNUM = -1
		ELSE
			SETNUM = RESULT
		ENDIF
	ENDIF
ELSEIF INRANGE(RESULT, 30, 62)
	LOCAL = RESULT - 30
	IF AUTO_SPLIT(排序, "/", LOCAL) != ""
		SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)), "/", LOCALS
		IF LOCAL == 0
			LOCALS:(SETNUM % 6) = 
		ELSE
			LOCALS:(SETNUM % 6) = %AUTO_SPLIT(排序, "/", LOCAL)%
		ENDIF
		GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) = 
		FOR LOCAL:1, 0, 6
			SIF LOCAL:1
				GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) += "/"
			GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) += LOCALS:(LOCAL:1)
		NEXT
	ENDIF
	SETNUM = -1
ENDIF
GOTO START

;---------------------------------------------------------------------
;@GET_RECIPE
;レシピの内容取得関数
;---------------------------------------------------------------------
@GET_RECIPE, ARGS
#LOCALSIZE 1
#LOCALSSIZE 1
LOCALS = 
SIF ISNUMERIC(ARGS)
	ARGS = %GET_NAME("参考书", TOINT(ARGS))%
SIF STRCOUNT(ARGS, "名称不在")
	THROW ARGS(%ARGS%) 指定错误!
FOR LOCAL, 0, 物品总数
	TRYCCALLFORM ITEM_RECIPE_{LOCAL}
		IF ARGS == AUTO_SPLIT(RESULTS, "/", 0)
			SIF LOCALS != ""
				LOCALS += "/"
			LOCALS += GET_NAME("物品", LOCAL)
		ENDIF
	CATCH
	ENDCATCH
NEXT
RESULTS = %LOCALS%
RETURN STRCOUNT(RESULTS, "/")

;---------------------------------------------------------------------
;@HAVE_ITEM
;アイテムの所持チェック関数
;ARGS		アイテム
;ARGS:1		チェック範囲
;---------------------------------------------------------------------
@HAVE_ITEM, ARGS, ARGS:1 = "持有"
#FUNCTION
#LOCALSIZE 4
LOCAL:3 = RESULT:1
IF ISNUMERIC(ARGS)
	LOCAL:1 = TOINT(ARGS)
ELSE
	LOCAL:1 = GET_NO("物品", ARGS)
ENDIF
LOCAL:2 = 0
FOR LOCAL, GET_ITEM_RANGE(ARGS), GET_ITEM_RANGE(ARGS, 1)
	SIF GET_ITEMDATA(LOCAL, "ID") == LOCAL:1
		LOCAL:2++
NEXT
RESULT:1 = LOCAL:3
RETURNF LOCAL:2
