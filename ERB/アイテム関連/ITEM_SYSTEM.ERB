@HAVE_ITEM, ARGS, ARGS:1 = "持有"
#FUNCTION
#LOCALSIZE 4
LOCAL:3 = RESULT:1
IF ISNUMERIC(ARGS)
	LOCAL:1 = TOINT(ARGS)
ELSE
	LOCAL:1 = GET_NO("物品", ARGS)
ENDIF
