;---------------------------------------------------------------------
;@ITEM_SORT
;ARGS 排序パターン
;ARG  排序する際の配列の要素数
;
;物品リストの排序関数
;---------------------------------------------------------------------
@ITEMLIST_SORT, ARGS, ARG
#LOCALSIZE 3
#LOCALSSIZE 10
#DIMS SORT_NAMELIST, 1500
#DIMS TEMPS
#DIMS 昇降
昇降 = BACK
VARSET LOCALS
IF GROUPMATCH(ARGS, "+", "-", "*", "/", ".")
	SPLIT GLOBALS:("排序" + ARGS), "/", LOCALS
ELSE
	LOCALS:1 = %ARGS%
ENDIF
LOCAL:2 = 1
WHILE LOCALS:(LOCAL:2) != ""
	SELECTCASE LOCALS:(LOCAL:2)
		CASE "名称"
			VARSET SORT_NAMELIST
			FOR LOCAL, 0, ARG
				SORT_NAMELIST:LOCAL '= GET_ITEMNAME(ITEMLIST:LOCAL) + "_0" + @"{LOCAL}"
			NEXT
			ARRAYSORT SORT_NAMELIST, BACK, 0, ARG
			FOR LOCAL, 0, ARG
				ITEMLIST:AUTO_SPLIT_INT(SORT_NAMELIST:LOCAL, "_", 1) += (LOCAL * 10000 + LOCAL) *10000
			NEXT
		CASE "登録順", "登録"
			昇降 = FORWARD
		CASE "品质", "质量", "等级"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, LOCALS:(LOCAL:2)) * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
		CASE "ID"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, "ID") * 10000 + LOCAL) * 10000
			NEXT
			昇降 = FORWARD
		CASE "特性"
			CLEARLINE 7
			PRINTFORML 検索する特性の名称を入力してください
			CALL ADD_LINE, 5
			INPUTS
			昇降 = %RESULTS%
			FOR LOCAL, 0, ARG
				FOR LOCAL:1, 0, 5
					IF STRCOUNT(GET_ITEMNAME_P(ITEMLIST:LOCAL, LOCAL:1), 昇降)
						ITEMLIST:LOCAL += 10000 * 10000
						BREAK
					ENDIF
				NEXT
				ITEMLIST:LOCAL += (VARSIZE("ITEMLIST") - LOCAL) * 10000
			NEXT
			昇降 = BACK
		CASE "选择完毕"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (ITEMCHOICE:(ITEMLIST:LOCAL) * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
		CASE "所持数"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += ((MATCH(所持物品, GET_ITEMDATA(ITEMLIST:LOCAL, "ID")) * 10000 + (VARSIZE("ITEMLIST") - LOCAL))) * 10000
			NEXT
		CASE "价格"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, "价格") * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
	ENDSELECT
	IF SORT_PREVS == ARGS
		IF 昇降 == "FORWARD"
			昇降 = BACK
		ELSE
			昇降 = FORWARD
		ENDIF
		;逆転したら消しとく
		ARGS = 
	ENDIF
	IF 昇降 == "FORWARD"
		ARRAYSORT ITEMLIST, FORWARD, 0, ARG
	ELSE
		ARRAYSORT ITEMLIST, BACK, 0, ARG
	ENDIF
	FOR LOCAL, 0, ARG
		ITEMLIST:LOCAL %= 10000
	NEXT
	LOCAL:2++
WEND
SORT_PREVS = %ARGS%
;---------------------------------------
;排序设定関数
;ユーザーが排序のマクロを組むことができる
;---------------------------------------
@SET_SORT
#LOCALSSIZE 6
#DIM LINE, 2
#LOCALSIZE 2
#DIM SETNUM
#DIMS 排序
排序 = NONE/登録順/名前/品質/质量/等级/ID/价格/所持数/特性/选择完毕
LINE = LINECOUNT
SETNUM = -1
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTL 　排序设定
DRAWLINE
FOR LOCAL:1, 0, 5
	VARSET LOCALS
	SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL:1)), "/", LOCALS
	PRINTPLAINFORM ┌[%AUTO_SPLIT("+_-_*_/_.", "_", LOCAL:1)%] %"─"*59%┐
	PRINTL 
	PRINTFORML │[{LOCAL:1 * 6,2}] 名前　: %LOCALS:0,109,LEFT%│
	FOR LOCAL, 1, 6
		IF LOCAL % 3 == 1
			PRINT │
		ELSE
			PRINT  
		ENDIF
		SIF SETNUM == LOCAL:1 * 6 + LOCAL
			SETCOLOR COLOR("p-green")
		PRINTBUTTON @"[{LOCAL:1 * 6 + LOCAL, 2}] %LOCALS:LOCAL, 35,LEFT%", LOCAL:1 * 6 + LOCAL
		RESETCOLOR
		SIF LOCAL % 3 == 0
		PRINTL │
	NEXT
	PRINTFORML %"", 41%│
	PRINTFORML └%"─"*61%┘
NEXT
DRAWLINE
LINE:1 = LINECOUNT
IF SETNUM >= 0
	PRINTL セットする排序内容を選んでください。
	FOR LOCAL, 0, 32
		IF AUTO_SPLIT(排序, "/", LOCAL) != ""
			PRINTBUTTON @"[{LOCAL + 30, 2}] %AUTO_SPLIT(排序, "/", LOCAL), 25, LEFT%", LOCAL + 30
		ELSE
			PRINTFORM %"",30%
		ENDIF
		SIF LOCAL % 4 == 3
			PRINTL 
	NEXT
ELSE
	PRINTL 排序を設定してください。
	PRINTL 1つの排序に複数の排序を設定した場合、連続で排序を実行します
	PRINTL 例えば、品質とIDを登録した場合、まず品質順に並び替えたあと、IDで並べます。
	PRINTL こうすることで物品の種類ごとに並べ、さらにその種類のなかで品質の高い順に並びます。
	PRINTL うまく排序を組み合わせて使いやすい排序を作成してください。
	PRINTL 
	PRINTL なお、マウスの場合、物品リスト上部のLVや品質といった部分を点击することでも排序可能です。
ENDIF
CALL EQUATE_LINE, LINE + MAXLINE() - 2
DRAWLINE
PRINTL [99] 終了
INPUT
IF RESULT == 99
	SAVEGLOBAL
	RETURN 0
ELSEIF INRANGE(RESULT, 0, 29)
	IF RESULT % 6 == 0
		LOCAL = RESULT / 6
		CLEARLINE LINECOUNT - LINE:1
		PRINTL 排序の名称を入力してください。
		PRINTL 名称は最大で半角14字となります
		CALL EQUATE_LINE, LINE + MAXLINE() - 2
		DRAWLINE
		PRINTL [99] 終了
		INPUTS
		CLEARLINE LINECOUNT - LINE:1
		IF STRLENS(RESULTS) > 14
			PRINTL 名称が長過ぎます!
			CALL EQUATE_LINE, LINE + MAXLINE() - 2
			DRAWLINE
			PRINTW [99] 終了
		ELSEIF RESULTS != ""
			SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)), "/", LOCALS
			LOCALS = %RESULTS%
			GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) = 
			FOR LOCAL:1, 0, 6
				SIF LOCAL:1
					GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) += "/"
				GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) += LOCALS:(LOCAL:1)
			NEXT
		ENDIF
	ELSE
		IF SETNUM == RESULT
			SETNUM = -1
		ELSE
			SETNUM = RESULT
		ENDIF
	ENDIF
ELSEIF INRANGE(RESULT, 30, 62)
	LOCAL = RESULT - 30
	IF AUTO_SPLIT(排序, "/", LOCAL) != ""
		SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)), "/", LOCALS
		IF LOCAL == 0
			LOCALS:(SETNUM % 6) = 
		ELSE
			LOCALS:(SETNUM % 6) = %AUTO_SPLIT(排序, "/", LOCAL)%
		ENDIF
		GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) = 
		FOR LOCAL:1, 0, 6
			SIF LOCAL:1
				GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) += "/"
			GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) += LOCALS:(LOCAL:1)
		NEXT
	ENDIF
	SETNUM = -1
ENDIF
GOTO START

;---------------------------------------------------------------------
;@GET_RECIPE
;レシピの内容取得関数
;---------------------------------------------------------------------
@GET_RECIPE, ARGS
#LOCALSIZE 1
#LOCALSSIZE 1
LOCALS = 
SIF ISNUMERIC(ARGS)
	ARGS = %GET_NAME("参考书", TOINT(ARGS))%
SIF STRCOUNT(ARGS, "名称不在")
	THROW ARGS(%ARGS%) の指定が間違っています!
FOR LOCAL, 0, 物品总数
	TRYCCALLFORM ITEM_RECIPE_{LOCAL}
		IF ARGS == AUTO_SPLIT(RESULTS, "/", 0)
			SIF LOCALS != ""
				LOCALS += "/"
			LOCALS += GET_NAME("物品", LOCAL)
		ENDIF
	CATCH
	ENDCATCH
NEXT
RESULTS = %LOCALS%
RETURN STRCOUNT(RESULTS, "/")

;---------------------------------------------------------------------
;@HAVE_ITEM
;物品の所持チェック関数
;ARGS		物品
;ARGS:1		チェック範囲
;---------------------------------------------------------------------
@HAVE_ITEM, ARGS, ARGS:1 = "所持"
#FUNCTION
#LOCALSIZE 4
LOCAL:3 = RESULT:1
IF ISNUMERIC(ARGS)
	LOCAL:1 = TOINT(ARGS)
ELSE
	LOCAL:1 = GET_NO("物品", ARGS)
ENDIF
LOCAL:2 = 0
FOR LOCAL, GET_ITEM_RANGE(ARGS), GET_ITEM_RANGE(ARGS, 1)
	SIF GET_ITEMDATA(LOCAL, "ID") == LOCAL:1
		LOCAL:2++
NEXT
RESULT:1 = LOCAL:3
RETURNF LOCAL:2
