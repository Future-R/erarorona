;---------------------------------------------------------------------
;@GET_EFFECT_POWER			获取道具效果强度的函数
;@SET_EFFECT_TURN			设置道具效果持续回合的函数
;CALCF_EQUIP_POWER			对装备应用品质加成并返回数值的函数
;@ITEM_HEAL					道具恢复功能的执行函数
;@ITEM_HEAL_POWER			获取道具恢复量的函数
;@GET_ITEM_RANGE			获取ARGS在DA数组中的起点和终点
;@SET_QUALITY,				设置道具品阶（品级）的函数
;@SET_PRICE					设置道具价格的函数
;@SET_REVISE				设置道具特殊加成（调合/消耗等）的函数
;@SET_ITEMLIST				为 @SHOW_ITEMLIST 创建用于显示的物品列表
;@DEL_CHOICE_ITEM			删除已登记到物品列表中的物品（用于重建列表）
;@MOVE_ITEM					将物品列表中选中的物品移动到篮子或箱子中
;@DISPOSE_OF_ITEM			用于填补上述两个操作在 DA 数组中留下的空洞
;@ITEM_SORT					物品列表的排序函数
;@SET_SORT					设置排序宏/模式的界面与保存
;@GET_RECIPE				获取配方内容的函数
;@HAVE_ITEM					检查是否持有指定物品的函数
;---------------------------------------------------------------------
;---------------------------------------------------------------------
;@GET_EFFECT_POWER
;ARG		要检查的物品登记编号
;ARG:1		目标
;ARG:2		使用者
;---------------------------------------------------------------------
@GET_EFFECT_POWER, ARG, ARG:1 = -1, ARG:2 = -1
#DIM 效果系数
#DIM TEMP
#DIMS L_TYPE
;基本係数 60 + 45 ~ -60 - 30 = 100 ~ -90
效果系数 = 100
效果系数 += (GET_ITEMDATA(ARG, "品质") - 60)
效果系数 += 15 * (GET_ITEMDATA(ARG, "品阶") - 2)
CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG, "ID")} 
L_TYPE '= RESULTS
FOR LOCAL, 0, 5
	SIF GET_ITEMDATA(ARG, @"特性{LOCAL}") <= 0
		CONTINUE
	SELECTCASE GET_ITEMNAME_P(ARG, LOCAL)
		CASE "效果上升Lv1"
			效果系数 += 10
		CASE "效果上升Lv2"
			效果系数 += 20
		CASE "效果上升Lv3"
			效果系数 += 30
			;并列权重示意：娇小/高挑/贫乳/巨乳 等属性作为权重影响，按 0~4 *5 给出 0~20% 的加成，外加 Lv1~3 的加成（最多可达 ~60%）
		CASE "小体型奖励Lv1", "小体型奖励Lv2", "小体型奖励Lv3"
			SIF ARG:1 == -1
				CONTINUE
			效果系数 += (2 + GET_TALENT("娇小", ARG:1) - GET_TALENT("高挑", ARG:1) + GET_TALENT("贫乳", ARG:1) - GET_TALENT("巨乳", ARG:1)) * (AUTO_SPLIT_NUM("小体型奖励Lv1/小体型奖励Lv2/小体型奖励Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 5
		;小型の逆
		CASE "大体型奖励Lv1", "大体型奖励Lv2", "大体型奖励Lv3"
			SIF ARG:1 == -1
				CONTINUE
			效果系数 += (2 - GET_TALENT("娇小", ARG:1) + GET_TALENT("高挑", ARG:1) - GET_TALENT("贫乳", ARG:1) + GET_TALENT("巨乳", ARG:1)) * (AUTO_SPLIT_NUM("大体型奖励Lv1/大体型奖励Lv2/大体型奖励Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 5
			;消耗系数为 *1, *1.5, *2
			;由于总消耗降低，这里数值比原作更温和；可能还会继续调整
		CASE "特性强化Lv1", "特性强化Lv2", "特性强化Lv3"
			LOCAL:2 = 0
			FOR LOCAL:1, 0, 5
				RESULT = 0
				LOCAL:2 += PROPERTYCOST:GET_ITEMDATA(ARG, @"特性{LOCAL:1}")
			NEXT
			效果系数 += LOCAL:2 * (AUTO_SPLIT_NUM("特性强化Lv1/特性强化Lv2/特性强化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 2) * 5 / 10
			;等级范围从 E(0) 到 S(5)，对应约 0~20% 的增幅范围
		CASE "等阶强化Lv1", "等阶强化Lv2", "等阶强化Lv3"
			效果系数 += GET_ITEMDATA(ARG, "品阶") * (AUTO_SPLIT_NUM("等阶强化Lv1/等阶强化Lv2/等阶强化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 4
			;仅在使用次数为1时生效：分别为 +25% / +50% / +75%
		CASE "耗竭强化Lv1", "耗竭强化Lv2", "耗竭强化Lv3"
			效果系数 += (GET_ITEMDATA(ARG, "使用次数") == 1) * (AUTO_SPLIT_NUM("耗竭强化Lv1/耗竭强化Lv2/耗竭强化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 25
		CASE "连锁奖励Lv1", "连锁奖励Lv2", "连锁奖励Lv3"
			效果系数 += (TFLAG:连锁系数 - 100) * (AUTO_SPLIT_NUM("连锁奖励Lv1/连锁奖励Lv2/连锁奖励Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) / 10
	ENDSELECT
NEXT
SIF GET_NO("SHOP", "调教") == FLAG:SHOP指令
	效果系数 += TRAIN_STATE_POWER_连锁特效(ARG:1, ARG:2)
SIF FR_SKILL_USE:GET_NO("友人技能", "使用之力")
	效果系数 += FR_SKILL_LV:GET_NO("友人技能", "使用之力") * 20
SIF FR_SKILL_USE:GET_NO("友人技能", "复制")
	效果系数 = TIMESF(效果系数, FR_SKILL_LV:GET_NO("友人技能", "复制") * 25)
RETURN MAX(效果系数, 10)

;---------------------------------------------------------------------
;@SET_EFFECT_POWER
;ARGS		: 要设置的 TCVAR 变量名（用于存放效果值）
;ARG		: 基础回合数（基准持续回合）
;ARG:1		: 基础倍率（用于计算实际效果）
;ARG:2		: 物品登记编号（道具编号）
;ARG:3		: 训练/对象目标
;ARG:4		: 训练/执行者（使用者）
;ARGS:1		: 若物品为回复道具时，指定作用的 BASE（例如 "体力"）
;---------------------------------------------------------------------
@SET_EFFECT_TURN, ARGS, ARG = 3, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1 = "体力"
#LOCALSIZE 2
;获取基础POWER
CALL GET_EFFECT_POWER, ARG:2, ARG:3, ARG:4
LOCAL = RESULT

;设置POWER
CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG:2, "ID")}
IF RESULTS == "恢复"
	CALL ITEM_HEAL_POWER, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1
	TCVAR:(ARG:3):ARGS = RESULT
ELSE
	CALL GET_EFFECT_POWER, ARG:2, ARG:3, ARG:4
	TCVAR:(ARG:3):ARGS = ARG:1 * LOCAL / 100
ENDIF
;设置持续回合数
LOCAL:1 = ARG
LOCAL:1 += LOCAL / 100
TCVAR:(ARG:3):(ARGS + "持续") = LOCAL:1
;---------------------------------------------------------------------
;@CALCF_EQUIP_POWER
;ARG		: 係数的基础值（用于计算最终倍率）
;ARGS		: 装备栏位（或直接传入物品编号）
;ARG:1		: 目标角色编号
;返回值约在 200% ~ 52% 区间
;---------------------------------------------------------------------
@CALCF_EQUIP_POWER, ARG, ARGS, ARG:1
#FUNCTION
IF ARG >= 0
	IF ISNUMERIC(ARGS)
		RETURNF CALCF(ARG, GET_ITEMDATA(TOINT(ARGS), "品质") - 60 + 15 * (GET_ITEMDATA(TOINT(ARGS), "品阶") - 2))
	ELSE
		RETURNF CALCF(ARG, GET_EQUIP(ARGS, ARG:1, "品质") - 60 + 15 * (GET_EQUIP(ARGS, ARG:1, "品阶") - 2))
	ENDIF
ELSE
	IF ISNUMERIC(ARGS)
		RETURNF CALCF(ARG, -(GET_ITEMDATA(TOINT(ARGS), "品质") - 60 + 15 * (GET_ITEMDATA(TOINT(ARGS), "品阶") - 2)))
	ELSE
		RETURNF CALCF(ARG, -(GET_EQUIP(ARGS, ARG:1, "品质") - 60 + 15 * (GET_EQUIP(ARGS, ARG:1, "品阶") - 2)))
	ENDIF
ENDIF
;----------------------------------
;@ITEM_HEAL
;アイテムによる回復関数
;ARG	基礎回復量
;ARG:1　アイテム登録番号
;ARG;2	使用対象
;ARG:3	使用者
;ARGS	対象となるBASE
;----------------------------------
@ITEM_HEAL, ARG, ARG:1, ARG:2, ARG:3, ARGS = "体力"
;效果の加算
CALL ITEM_HEAL_POWER, ARG, ARG:1, ARG:2, ARG:3, ARGS
DOWNBASE:(ARG:2):ARGS -= RESULT
RETURN ARG

;----------------------------------
;@ITEM_HEAL＿POWER
;アイテムによる恢复力の獲得関数
;ARG	基礎回復量
;ARG:1　アイテム登録番号
;ARG;2	使用対象
;ARG:3	使用者
;ARGS	対象となるBASE
;----------------------------------
@ITEM_HEAL_POWER, ARG, ARG:1, ARG:2, ARG:3, ARGS = "体力"
#LOCALSIZE 1
;效果の加算
CALL GET_EFFECT_POWER, ARG:1, ARG:2, ARG:3
ARG *= RESULT
ARG /= 100

LOCAL = 0
LOCAL += TRAIN_SKILL_POWER_恢复力(ARG:2, ARG:3)
LOCAL += FR_SKILL_LV:GET_NO("友人技能", "美味的吃法") * 20
ARG = CALCF(ARG, LOCAL)
RETURN ARG

;------------------------------------
;@GET_ITEM_RANGE
;获取 ARGS 在 DA 中对应数组的起点与终点
;------------------------------------
@GET_ITEM_RANGE, ARGS, ARG = -1
#FUNCTION
SELECTCASE ARGS
	CASE "篮子"
		IF ARG == -1
			RESULT:1 = 100
			RETURNF 0
		ELSE
			RETURNF 100
		ENDIF
	CASE "箱子"
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 100
		ELSE
			RETURNF 1100
		ENDIF
	CASE "持有"
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 0
		ELSE
			RETURNF 1100
		ENDIF
	CASE "临时"
		IF ARG == -1
			RESULT:1 = 1200
			RETURNF 1100
		ELSE
			RETURNF 1200
		ENDIF
	CASE "商店"
		IF ARG == -1
			RESULT:1 = 1500
			RETURNF 1200
		ELSE
			RETURNF 1500
		ENDIF
	CASE "探索装备"
		IF ARG == -1
			RESULT:1 = 1510
			RETURNF 1500
		ELSE
			RETURNF 1510
		ENDIF
	CASE "所有"
		IF ARG == -1
			RESULT:1 = VARSIZE("DA")
			RETURNF 0
		ELSE
			RETURNF VARSIZE("DA")
		ENDIF
		
	CASEELSE
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 0
		ELSE
			RETURNF 1100
		ENDIF
ENDSELECT

;---------------------------------------------------------------------
;@SET_QUALITY
;ARG 		: 要设置品阶的物品编号
;
;设置物品品阶（等级/Rank）的函数
;  0/  1/  2/  3/  4/  5
;  E/  D/  C/  B/  A/   S
;  0/ 40/ 55/ 70/ 85/ 100
;
;品阶由品质与特性提供的加成共同决定
;---------------------------------------------------------------------
@SET_QUALITY, ARG
#LOCALSIZE 2
LOCAL:1 = GET_ITEMDATA(ARG, "品质")
FOR LOCAL, 0, 5
	CALL PROPERTY_RIZE_QUALITY, GET_ITEMDATA(ARG, @"特性{LOCAL}")
	LOCAL:1 += RESULT
NEXT
;若品质不超过100则不会判定为S
SIF GET_ITEMDATA(ARG, "品质") <= 100
	LOCAL:1 = MIN(LOCAL:1, 99)
CALL SET_ITEMDATA, ARG, "品阶", LIMIT((LOCAL:1 - 25) / 15, 0, 5)



;---------------------------------------------------------------------
;@SET_PRICE
;ARG 		:セット対象となるアイテム番号
;---------------------------------------------------------------------
@SET_PRICE, ARG
#DIM PRICE
#LOCALSIZE 2
;基礎价格
CALLFORM ITEM_PRICE_{GET_ITEMDATA(ARG, "ID")}
PRICE = RESULT
LOCAL = 0
;品质で-30% ~ 30%
LOCAL = (GET_ITEMDATA(ARG, "品质") - 60) / 2
;ランクで-40% ~ 60%
LOCAL += (GET_ITEMDATA(ARG, "品阶") - 2) * 20

FOR LOCAL:1, 0, 5
	CALL PROPERTY_PRICE, GET_ITEMDATA(ARG, @"特性{LOCAL:1}")
	LOCAL += RESULT
NEXT

PRICE = MAX(PRICE * (LOCAL  + 100) / 100, 1)
CALL SET_ITEMDATA, ARG, "价格", MIN(PRICE, POWER(10, 10) - 1)

;量販价格設定
LOCAL = (GET_ITEMDATA(ARG, "等级") / 5) *(GET_ITEMDATA(ARG, "等级") / 5) * 10 + 250
PRICE = MAX(PRICE * LOCAL / 100, 1)
CALL SET_ITEMDATA, ARG, "批发价格", MIN(PRICE, POWER(10, 10) - 1)

;---------------------------------------------------------------------
;@SET_REVICE
;ARG 		: 要设置的物品编号
;---------------------------------------------------------------------
@SET_REVICE, ARG
#DIM L_CATEGORY
#DIM L_COST
#LOCALSIZE 2
L_CATEGORY = 0
L_COST = 0
FOR LOCAL, 0, 5
	SELECTCASE GET_ITEMNAME_P(ARG, LOCAL)
		CASE "蕴含力量Lv1"
			L_CATEGORY =+ 5
		CASE "蕴含力量Lv2"
			L_CATEGORY += 7
		CASE "蕴含力量Lv3"
			L_CATEGORY += 10
		CASE "消耗额等级+1"
			L_COST += 5
		CASE "消耗额等级+2"
			L_COST += 10
		CASE "消耗额等级+3"
			L_COST += 15
	ENDSELECT
NEXT
SELECTCASE GET_ITEMNAME_E(ARG, 0)
	CASE "红玉"
		L_CATEGORY =+ 30
	CASE "翠玉"
		L_CATEGORY += 60
	CASE "金刚石"
		L_CATEGORY += 90
ENDSELECT
CALL SET_ITEMDATA(ARG, "调合类别加成值", L_CATEGORY)
CALL SET_ITEMDATA(ARG, "消耗额加成值", L_COST)
;----------------------------------------------------------------------
;@SET_ITEMLIST
;ARGS		: 列表用途（篮子/箱子/持有(篮子+箱子)/归还/获得物品/调合/调教）
;ARGS:1		: 要注册到列表的物品范围（例如 篮子/箱子）
;ARG		: 调合时的目标物品编号（若用于调合）
;ARGS:2		: 用于物品选择时作为条件判断的函数名
;创建需要显示的物品列表。
;此处生成的列表会被 @SHOW_ITEMLIST 用来展示
;----------------------------------------------------------------------
@SET_ITEMLIST, ARGS, ARGS:1, ARG, ARGS:2
#LOCALSIZE 2
#LOCALSSIZE 10
#DIM L_CATEGORY
#DIM START
#DIM END
#DIM TEMP, 3
VARSET ITEM_ABLE, -1
VARSET ITEMLIST, -1
IF ARGS:1 == "篮子"
	START = 0
	END = 100
ELSE
	START = GET_ITEM_RANGE(ARGS:1)
	END = RESULT:1
ENDIF
IF ARGS == "装备调合"
	RESULT = 0, 0
	CALLFORM ITEM_MATERIAL_{ARG}
	TEMP:1 = RESULT, RESULT:1
ENDIF
IF ARGS == "批发商店登记"
	L_CATEGORY = 0
	CALLFORM STORE_SALL_ABLE_%ARGS:2%
	SPLIT RESULTS, "/", LOCALS
	FOR LOCAL, 0, RESULT
		SETBIT L_CATEGORY, GET_NO("调合类别", LOCALS:LOCAL)
	NEXT
ENDIF
			
LOCAL:1 = 0
FOR LOCAL, START, END
	IF ARGS == "选择物品"
		CALLFORM %ARGS:2%, LOCAL
		SIF !RESULT
			CONTINUE
	ELSE
		TEMP = GET_ITEMDATA(LOCAL, "ID")
		;アイテムIDがない場合登録しない
		SIF TEMP <= 0
			CONTINUE
		IF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
			SIF !GETBIT(MIXLIST:LOCAL, ARG)
				CONTINUE
			;他のリストで選ばれている場合
			SIF MIXCHOICE:LOCAL > 0 && !GETBIT(MIXCHOICE:LOCAL, ARG)
				CONTINUE
		ELSEIF ARGS == "汇报委托"
			SIF TEMP != GET_REQ(ARG, "ID")
				CONTINUE
		ELSEIF ARGS == "使用物品"
			TRYCCALLFORM ITEM_TYPE_{TEMP}
				SIF RESULTS != "料理"
					CONTINUE
			CATCH
				CONTINUE
			ENDCATCH
		ELSEIF ARGS == "调教"
			TRYCCALLFORM ITEM_TYPE_{TEMP}
				SIF RESULTS != "调教" && RESULTS != "恢复"
					CONTINUE
				;コマンド内で分岐するかチェック
				TRYCCALLFORM ITEM_BRUNCH_{TEMP}, TARGET, PLAYER, LOCAL
					ITEM_BRUNCH:(LOCAL:1) = RESULT
				CATCH
					ITEM_BRUNCH:(LOCAL:1) = 0
				ENDCATCH
				;ABLEチェック
				TRYCCALLFORM COM_ABLE, TEMP, TARGET, PLAYER, LOCAL
					ITEM_ABLE:(LOCAL:1) = RESULT
					SIF RESULT == -1
						CONTINUE
				CATCH
				ENDCATCH
			CATCH
				CONTINUE
			ENDCATCH
		ELSEIF ARGS == "装备调合"
			SIF !GROUPMATCH(TEMP, TEMP:1, TEMP:2)
				CONTINUE
		ELSEIF ARGS == "批发商店登记"
			SIF !INRANGE(GET_ITEMDATA(LOCAL, "ID"), 501, 1500)
				CONTINUE
			SIF !(L_CATEGORY & GET_ITEMDATA(LOCAL, "调合类别"))
				CONTINUE
		ENDIF
	ENDIF
	ITEMLIST:(LOCAL:1) = LOCAL
	;ITEMLIST:(LOCAL:1) = LOCAL
	LOCAL:1++
NEXT
RETURN LOCAL:1
;---------------------------------------------------------------------
;@DEL_CHOICE_ITEM
;ARGS		: 与 @SET_ITEMLIST 相同，用于指示该列表用途（该函数会破坏现有物品列表，之后需重新注册）
;ARGS:1		: 同上
;ARG		: 同上（备用）
;
;删除当前被选中的所有物品
;---------------------------------------------------------------------
@DEL_CHOICE_ITEM, ARGS, ARGS:1, ARG
#LOCALSIZE 1
;まずは削除
SIF FLAG:回想模式
	RETURN 0
FOR LOCAL, 0, VARSIZE("ITEMCHOICE")
	SIF !ITEMCHOICE:LOCAL
		CONTINUE
	;SIF !ITEMCHOICE:LOCAL
	CALL DEL_ITEMDATA, LOCAL
NEXT
;選択抹消
VARSET ITEMCHOICE

;発生した空アイテムを詰める
CALL DISPOSE_OF_ITEM

;リスト再生成
SIF GROUPMATCH("", ARGS, ARGS:1) + (ARG > 0) < 3
	CALL SET_ITEMLIST, ARGS, ARGS:1, ARG

;---------------------------------------------------------------------
;@MOVE_ITEM
;ARGS		送り先(篮子/箱子)
;ARGS:1		:@SET_ITEMLISTのARGS:1と同じ。アイテムリストが破壊されるので再登録させるのに利用
;ARGS:2		:同上
;ARG		:同上
;
;アイテム移動関数
;選択状态のアイテムを送り先に移す
;---------------------------------------------------------------------
@MOVE_ITEM, ARGS, ARGS:1, ARGS:2, ARG
#LOCALSIZE 4
#DIM START
#DIM END
IF ARGS == "篮子"
	START = 0
	END = BASKET_SIZE()
ELSEIF ARGS == "箱子"
	START = 100
	END = 1100
ELSE
	START = 1100
	END = 1200
ENDIF
LOCAL:1 = 0
FOR LOCAL, 0, 1200
	;跳过未被选择的物品
	;SIF !ITEMCHOICE:LOCAL
	SIF !ITEMCHOICE:LOCAL
		CONTINUE
		WHILE START < END
			;如果目标位置为空则进行交换
			IF !GET_ITEMDATA(START, "ID")
				;执行交换以将物品放入目标槽
				;PRINTFORML SWAP [{LOCAL}] 和 [{START}]
				CALL SWAP_ITEMDATA(LOCAL, START)
				;取消该物品的选择标记
				ITEMCHOICE:LOCAL = 0
				BREAK
			ENDIF
			START++
		WEND
NEXT
;填补移动过程中产生的空白槽
CALL DISPOSE_OF_ITEM
;重新生成物品列表
SIF GROUPMATCH("", ARGS:1, ARGS:2) + (ARG > 0) < 3
	CALL SET_ITEMLIST, ARGS:1, ARGS:2, ARG
;返回 !MAXARRAY(ITEMCHOICE)
;若所有选中项均已成功移动（MAXARRAY 为 0）则返回真，
;否则返回假，表示存在未能放入的选中项
RETURN !MAXARRAY(ITEMCHOICE)
;RETURN !MAXARRAY(ITEMCHOICE)

;---------------------------------------------------------------------
;@DISPOSE_OF_ITEM
;
;填补 DA 数组中产生的空槽的函数
;供 @MOVE_ITEM / @DEL_CHOICE_ITEM 调用的下层函数
;---------------------------------------------------------------------
@DISPOSE_OF_ITEM
#LOCALSIZE 2
;填补篮子中的空槽
LOCAL:1 = 0
FOR LOCAL, 0, 99
	SIF GET_ITEMDATA(LOCAL, "ID")
		CONTINUE
	LOCAL:1 = MAX(LOCAL+1, LOCAL:1)
	WHILE LOCAL:1 < 100
		IF GET_ITEMDATA(LOCAL:1, "ID")
			;CALL SWAP(LOCAL, LOCAL:1)
			CALL SWAP_ITEMDATA(LOCAL, LOCAL:1)
			SWAP ITEMCHOICE:LOCAL, ITEMCHOICE:(LOCAL:1)
			LOCAL:1++
			BREAK
		ENDIF
		LOCAL:1++
	WEND
NEXT
LOCAL:1 = 100
;填补箱子中的空槽
FOR LOCAL, 100, 1100
	SIF GET_ITEMDATA(LOCAL, "ID")
		CONTINUE
	LOCAL:1 = MAX(LOCAL+1, LOCAL:1)
	WHILE LOCAL:1 < 1100
		IF GET_ITEMDATA(LOCAL:1, "ID")
			;CALL SWAP(LOCAL, LOCAL:1)
			CALL SWAP_ITEMDATA(LOCAL, LOCAL:1)
			SWAP ITEMCHOICE:LOCAL, ITEMCHOICE:(LOCAL:1)
			LOCAL:1++
			BREAK
		ENDIF
		LOCAL:1++
	WEND
NEXT
LOCAL:1 = 1100
;填补临时区（临时物品槽）中的空槽
FOR LOCAL, 1100, 1200
	SIF GET_ITEMDATA(LOCAL, "ID")
		CONTINUE
	LOCAL:1 = MAX(LOCAL+1, LOCAL:1)
	WHILE LOCAL:1 < 1100
		IF GET_ITEMDATA(LOCAL:1, "ID")
			;CALL SWAP(LOCAL, LOCAL:1)
			CALL SWAP_ITEMDATA(LOCAL, LOCAL:1)
			LOCAL:1++
			BREAK
		ENDIF
		LOCAL:1++
	WEND
NEXT

;---------------------------------------------------------------------
;@ITEM_SORT
;ARGS 排序パターン
;ARG  排序する際の配列の要素数
;
;物品列表的排序函数
;---------------------------------------------------------------------
@ITEMLIST_SORT, ARGS, ARG
#LOCALSIZE 3
#LOCALSSIZE 10
#DIMS SORT_NAMELIST, 1500
#DIMS TEMPS
#DIMS 升降
升降 = BACK
VARSET LOCALS
IF GROUPMATCH(ARGS, "+", "-", "*", "/", ".")
	SPLIT GLOBALS:("排序" + ARGS), "/", LOCALS
ELSE
	LOCALS:1 = %ARGS%
ENDIF
LOCAL:2 = 1
WHILE LOCALS:(LOCAL:2) != ""
	SELECTCASE LOCALS:(LOCAL:2)
		CASE "名称"
			VARSET SORT_NAMELIST
			FOR LOCAL, 0, ARG
				SORT_NAMELIST:LOCAL '= GET_ITEMNAME(ITEMLIST:LOCAL) + "_0" + @"{LOCAL}"
			NEXT
			ARRAYSORT SORT_NAMELIST, BACK, 0, ARG
			FOR LOCAL, 0, ARG
				ITEMLIST:AUTO_SPLIT_INT(SORT_NAMELIST:LOCAL, "_", 1) += (LOCAL * 10000 + LOCAL) *10000
			NEXT
		CASE "登记顺序", "登记"
			升降 = FORWARD
		CASE "品质", "品阶", "等级"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, LOCALS:(LOCAL:2)) * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
		CASE "ID"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, "ID") * 10000 + LOCAL) * 10000
			NEXT
			升降 = FORWARD
		CASE "特性"
			CLEARLINE 7
			PRINTFORML 请输入要检索特性的名称
			CALL ADD_LINE, 5
			INPUTS
			升降 = %RESULTS%
			; 尽量避免玩家输入错误的正则表达式
			SUBSTRING 升降, 0, 1
			IF RESULTS == "+" || RESULTS == "*" || RESULTS == "?"
				升降 = "\" + 升降
			ENDIF
			FOR LOCAL, 0, ARG
				FOR LOCAL:1, 0, 5
					IF STRCOUNT(GET_ITEMNAME_P(ITEMLIST:LOCAL, LOCAL:1), 升降)
						ITEMLIST:LOCAL += 10000 * 10000
						BREAK
					ENDIF
				NEXT
				ITEMLIST:LOCAL += (VARSIZE("ITEMLIST") - LOCAL) * 10000
			NEXT
			升降 = BACK
		CASE "已选择"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (ITEMCHOICE:(ITEMLIST:LOCAL) * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
		CASE "持有数"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += ((MATCH(持有物品, GET_ITEMDATA(ITEMLIST:LOCAL, "ID")) * 10000 + (VARSIZE("ITEMLIST") - LOCAL))) * 10000
			NEXT
		CASE "价格"
			FOR LOCAL, 0, ARG
				ITEMLIST:LOCAL += (GET_ITEMDATA(ITEMLIST:LOCAL, "价格") * 10000 + (VARSIZE("ITEMLIST") - LOCAL)) * 10000
			NEXT
	ENDSELECT
	IF SORT_PREVS == ARGS
		IF 升降 == "FORWARD"
			升降 = BACK
		ELSE
			升降 = FORWARD
		ENDIF
		;逆転したら消しとく
		ARGS = 
	ENDIF
	IF 升降 == "FORWARD"
		ARRAYSORT ITEMLIST, FORWARD, 0, ARG
	ELSE
		ARRAYSORT ITEMLIST, BACK, 0, ARG
	ENDIF
	FOR LOCAL, 0, ARG
		ITEMLIST:LOCAL %= 10000
	NEXT
	LOCAL:2++
WEND
SORT_PREVS = %ARGS%
;---------------------------------------
;排序设置関数
;ユーザーが排序のマクロを組むことができる
;---------------------------------------
@SET_SORT
#LOCALSSIZE 6
#DIM LINE, 2
#LOCALSIZE 2
#DIM SETNUM
#DIMS 排序
排序 = NONE/登记顺序/名称/品质/品阶/等级/ID/价格/持有数/特性/已选择
LINE = LINECOUNT
SETNUM = -1
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTL 　排序设置
DRAWLINE
FOR LOCAL:1, 0, 5
	VARSET LOCALS
	SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL:1)), "/", LOCALS
	PRINTPLAINFORM ┌[%AUTO_SPLIT("+_-_*_/_.", "_", LOCAL:1)%] %"─"*59%┐
	PRINTL 
	PRINTFORML │[{LOCAL:1 * 6,2}] 名称　: %LOCALS:0,109,LEFT%│
	FOR LOCAL, 1, 6
		IF LOCAL % 3 == 1
			PRINT │
		ELSE
			PRINT  
		ENDIF
		SIF SETNUM == LOCAL:1 * 6 + LOCAL
			SETCOLOR COLOR("p-green")
		PRINTBUTTON @"[{LOCAL:1 * 6 + LOCAL, 2}] %LOCALS:LOCAL, 35,LEFT%", LOCAL:1 * 6 + LOCAL
		RESETCOLOR
		SIF LOCAL % 3 == 0
		PRINTL │
	NEXT
	PRINTFORML %"", 41%│
	PRINTFORML └%"─"*61%┘
NEXT
DRAWLINE
LINE:1 = LINECOUNT
IF SETNUM >= 0
	PRINTL 请选择要设置的排序内容。
	FOR LOCAL, 0, 32
		IF AUTO_SPLIT(排序, "/", LOCAL) != ""
			PRINTBUTTON @"[{LOCAL + 30, 2}] %AUTO_SPLIT(排序, "/", LOCAL), 25, LEFT%", LOCAL + 30
		ELSE
			PRINTFORM %"",30%
		ENDIF
		SIF LOCAL % 4 == 3
			PRINTL 
	NEXT
ELSE
	PRINTL 请设置排序规则。
	PRINTL 若在一个排序规则中设置多个排序条件，系统将连续执行排序。
	PRINTL 比如说，若登记品质和ID，会先按品质顺序排序，再按ID顺序二次排序
	PRINTL 通过这种方式，可实现以下效果：先按物品种类分组，再在同类中按品质降序排列。
	PRINTL 请巧妙组合排序条件，创建符合使用习惯的排序规则。
	PRINTL 
	PRINTL 使用鼠标时，也可直接点击物品列表顶部的LV或品质等部分来进行排序。
ENDIF
CALL EQUATE_LINE, LINE + MAXLINE() - 2
DRAWLINE
PRINTL [99] 结束
INPUT
IF RESULT == 99
	SAVEGLOBAL
	RETURN 0
ELSEIF INRANGE(RESULT, 0, 29)
	IF RESULT % 6 == 0
		LOCAL = RESULT / 6
		CLEARLINE LINECOUNT - LINE:1
		PRINTL 请输入排序规则名称。
		PRINTL 名称最长支持半角14字符 
		CALL EQUATE_LINE, LINE + MAXLINE() - 2
		DRAWLINE
		PRINTL [99] 结束
		INPUTS
		CLEARLINE LINECOUNT - LINE:1
		IF STRLENS(RESULTS) > 14
			PRINTL 名称过长! 
			CALL EQUATE_LINE, LINE + MAXLINE() - 2
			DRAWLINE
			PRINTW [99] 结束
		ELSEIF RESULTS != ""
			SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)), "/", LOCALS
			LOCALS = %RESULTS%
			GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) = 
			FOR LOCAL:1, 0, 6
				SIF LOCAL:1
					GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) += "/"
				GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL)) += LOCALS:(LOCAL:1)
			NEXT
		ENDIF
	ELSE
		IF SETNUM == RESULT
			SETNUM = -1
		ELSE
			SETNUM = RESULT
		ENDIF
	ENDIF
ELSEIF INRANGE(RESULT, 30, 62)
	LOCAL = RESULT - 30
	IF AUTO_SPLIT(排序, "/", LOCAL) != ""
		SPLIT GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)), "/", LOCALS
		IF LOCAL == 0
			LOCALS:(SETNUM % 6) = 
		ELSE
			LOCALS:(SETNUM % 6) = %AUTO_SPLIT(排序, "/", LOCAL)%
		ENDIF
		GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) = 
		FOR LOCAL:1, 0, 6
			SIF LOCAL:1
				GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) += "/"
			GLOBALS:("排序" + AUTO_SPLIT("+_-_*_/_.", "_", SETNUM / 6)) += LOCALS:(LOCAL:1)
		NEXT
	ENDIF
	SETNUM = -1
ENDIF
GOTO START

;---------------------------------------------------------------------
