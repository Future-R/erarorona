;---------------------------------------------------------------------
;@GET_EFFECT_POWER
;ARG		調べる物品登録番号
;ARG:1		対象
;ARG:2		使用者
;---------------------------------------------------------------------
@GET_EFFECT_POWER, ARG, ARG:1 = -1, ARG:2 = -1
#DIM 效果係数
#DIM TEMP
#DIMS L_TYPE
;基本係数 60 + 45 ~ -60 - 30 = 100 ~ -90
效果係数 = 100
效果係数 += (GET_ITEMDATA(ARG, "品质") - 60)
效果係数 += 15 * (GET_ITEMDATA(ARG, "质量") - 2)
CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG, "ID")} 
L_TYPE '= RESULTS
FOR LOCAL, 0, 5
	SIF GET_ITEMDATA(ARG, @"特性{LOCAL}") <= 0
		CONTINUE
	SELECTCASE GET_ITEMNAME_P(ARG, LOCAL)
		CASE "效果アップLv1"
			效果係数 += 10
		CASE "效果アップLv2"
			效果係数 += 20
		CASE "效果アップLv3"
			效果係数 += 30
		;並1 娇小2 高挑0　並1　貧2 巨0として、0~4 * 5で0~20%　これにLv1~3で最大60%
		CASE "小型ボーナスLv1", "小型ボーナスLv2", "小型ボーナスLv3"
			SIF ARG:1 == -1
				CONTINUE
			效果係数 += (2 + GET_TALENT("娇小", ARG:1) - GET_TALENT("高挑", ARG:1) + GET_TALENT("贫乳", ARG:1) - GET_TALENT("巨乳", ARG:1)) * (AUTO_SPLIT_NUM("小型ボーナスLv1/小型ボーナスLv2/小型ボーナスLv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 5
		;小型の逆
		CASE "大型ボーナスLv1", "大型ボーナスLv2", "大型ボーナスLv3"
			SIF ARG:1 == -1
				CONTINUE
			效果係数 += (2 - GET_TALENT("娇小", ARG:1) + GET_TALENT("高挑", ARG:1) - GET_TALENT("贫乳", ARG:1) + GET_TALENT("巨乳", ARG:1)) * (AUTO_SPLIT_NUM("大型ボーナスLv1/大型ボーナスLv2/大型ボーナスLv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 5
		;コスト*1, 1.5, 2
		;合計コストも低くなるので本家よりだいぶおとなしく。また調整いれるかも？
		CASE "特性強化Lv1", "特性強化Lv2", "特性強化Lv3"
			LOCAL:2 = 0
			FOR LOCAL:1, 0, 5
				RESULT = 0
				LOCAL:2 += PROPERTYCOST:GET_ITEMDATA(ARG, @"特性{LOCAL:1}")
			NEXT
			效果係数 += LOCAL:2 * (AUTO_SPLIT_NUM("特性強化Lv1/特性強化Lv2/特性強化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 2) * 5 / 10
		;ランクはE0でS5なので0~20%
		CASE "ランク強化Lv1", "ランク強化Lv2", "ランク強化Lv3"
			效果係数 += GET_ITEMDATA(ARG, "质量") * (AUTO_SPLIT_NUM("ランク強化Lv1/ランク強化Lv2/ランク強化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 4
		;使用次数が1回の時限定で25%/50%/75%
		CASE "使い切り強化Lv1", "使い切り強化Lv2", "使い切り強化Lv3"
			效果係数 += (GET_ITEMDATA(ARG, "使用次数") == 1) * (AUTO_SPLIT_NUM("使い切り強化Lv1/使い切り強化Lv2/使い切り強化Lv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) * 25
		CASE "連携ボーナスLv1", "連携ボーナスLv2", "連携ボーナスLv3"
			效果係数 += (TFLAG:连锁系数 - 100) * (AUTO_SPLIT_NUM("連携ボーナスLv1/連携ボーナスLv2/連携ボーナスLv3", "/", GET_ITEMNAME_P(ARG, LOCAL)) + 1) / 10
	ENDSELECT
NEXT
SIF GET_NO("商店", "调教") == FLAG:商店指令
	效果係数 += TRAIN_STATE_POWER_连锁特效(ARG:1, ARG:2)
SIF FR_SKILL_USE:GET_NO("友人技能", "パワーユーズ")
	效果係数 += FR_SKILL_LV:GET_NO("友人技能", "パワーユーズ") * 20
SIF FR_SKILL_USE:GET_NO("友人技能", "デュプリケイト")
	效果係数 = TIMESF(效果係数, FR_SKILL_LV:GET_NO("友人技能", "デュプリケイト") * 25)
RETURN MAX(效果係数, 10)

;---------------------------------------------------------------------
;@SET_EFFECT_POWER
;ARGS		セット対象のTCVAR
;ARG		セットの基礎ターン
;ARG:1		セットの基礎倍率
;ARG:2		物品登録番号
;ARG:3		調教対象
;ARG:4		調教者
;ARGS:1		物品が回復物品だった場合の対象BASE
;---------------------------------------------------------------------
@SET_EFFECT_TURN, ARGS, ARG = 3, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1 = "体力"
#LOCALSIZE 2
;基礎パワーを取得
CALL GET_EFFECT_POWER, ARG:2, ARG:3, ARG:4
LOCAL = RESULT

;パワーの設定
CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG:2, "ID")}
IF RESULTS == "回復"
	CALL ITEM_HEAL_POWER, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1
	TCVAR:(ARG:3):ARGS = RESULT
ELSE
	CALL GET_EFFECT_POWER, ARG:2, ARG:3, ARG:4
	TCVAR:(ARG:3):ARGS = ARG:1 * LOCAL / 100
ENDIF
;継続ターン数の設定
LOCAL:1 = ARG
LOCAL:1 += LOCAL / 100
TCVAR:(ARG:3):(ARGS + "持续") = LOCAL:1
;---------------------------------------------------------------------
;@CALCF_EQUIP_POWER
;ARG		係数の基本值
;ARGS		装備箇所(あるいは物品番号)
;ARG:1		対象の角色
;200%~52%くらい
;---------------------------------------------------------------------
@CALCF_EQUIP_POWER, ARG, ARGS, ARG:1
#FUNCTION
IF ARG >= 0
	IF ISNUMERIC(ARGS)
		RETURNF CALCF(ARG, GET_ITEMDATA(TOINT(ARGS), "品质") - 60 + 15 * (GET_ITEMDATA(TOINT(ARGS), "质量") - 2))
	ELSE
		RETURNF CALCF(ARG, GET_EQUIP(ARGS, ARG:1, "品质") - 60 + 15 * (GET_EQUIP(ARGS, ARG:1, "质量") - 2))
	ENDIF
ELSE
	IF ISNUMERIC(ARGS)
		RETURNF CALCF(ARG, -(GET_ITEMDATA(TOINT(ARGS), "品质") - 60 + 15 * (GET_ITEMDATA(TOINT(ARGS), "质量") - 2)))
	ELSE
		RETURNF CALCF(ARG, -(GET_EQUIP(ARGS, ARG:1, "品质") - 60 + 15 * (GET_EQUIP(ARGS, ARG:1, "质量") - 2)))
	ENDIF
ENDIF
;----------------------------------
;@ITEM_HEAL
;物品による回復関数
;ARG	基礎回復量
;ARG:1　物品登録番号
;ARG;2	使用対象
;ARG:3	使用者
;ARGS	対象となるBASE
;----------------------------------
@ITEM_HEAL, ARG, ARG:1, ARG:2, ARG:3, ARGS = "体力"
;效果の加算
CALL ITEM_HEAL_POWER, ARG, ARG:1, ARG:2, ARG:3, ARGS
DOWNBASE:(ARG:2):ARGS -= RESULT
RETURN ARG

;----------------------------------
;@ITEM_HEAL＿POWER
;物品による回復力の獲得関数
;ARG	基礎回復量
;ARG:1　物品登録番号
;ARG;2	使用対象
;ARG:3	使用者
;ARGS	対象となるBASE
;----------------------------------
@ITEM_HEAL_POWER, ARG, ARG:1, ARG:2, ARG:3, ARGS = "体力"
#LOCALSIZE 1
;效果の加算
CALL GET_EFFECT_POWER, ARG:1, ARG:2, ARG:3
ARG *= RESULT
ARG /= 100

LOCAL = 0
LOCAL += TRAIN_SKILL_POWER_回復力(ARG:2, ARG:3)
LOCAL += FR_SKILL_LV:GET_NO("友人技能", "美味しい食べ方") * 20
ARG = CALCF(ARG, LOCAL)
RETURN ARG

;------------------------------------
;@GET_ITEM_RANGE
;ARGSのDAでの配列の開始点と終点をとる
;------------------------------------
@GET_ITEM_RANGE, ARGS, ARG = -1
#FUNCTION
SELECTCASE ARGS
	CASE "篮子"
		IF ARG == -1
			RESULT:1 = 100
			RETURNF 0
		ELSE
			RETURNF 100
		ENDIF
	CASE "箱子"
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 100
		ELSE
			RETURNF 1100
		ENDIF
	CASE "所持"
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 0
		ELSE
			RETURNF 1100
		ENDIF
	CASE "临时"
		IF ARG == -1
			RESULT:1 = 1200
			RETURNF 1100
		ELSE
			RETURNF 1200
		ENDIF
	CASE "贩售店"
		IF ARG == -1
			RESULT:1 = 1500
			RETURNF 1200
		ELSE
			RETURNF 1500
		ENDIF
	CASE "探索装備"
		IF ARG == -1
			RESULT:1 = 1510
			RETURNF 1500
		ELSE
			RETURNF 1510
		ENDIF
	CASE "全て"
		IF ARG == -1
			RESULT:1 = VARSIZE("DA")
			RETURNF 0
		ELSE
			RETURNF VARSIZE("DA")
		ENDIF
		
	CASEELSE
		IF ARG == -1
			RESULT:1 = 1100
			RETURNF 0
		ELSE
			RETURNF 1100
		ENDIF
ENDSELECT

;---------------------------------------------------------------------
;@SET_QUALITY
;ARG 		:セット対象なる物品番号
;
;物品の品質ランクを設定する関数
;  0/  1/  2/  3/  4/  5
;  E/  D/  C/  B/  A/   S
;  0/ 40/ 55/ 70/ 85/ 100
;
;ランクは品質＋特性による加成值で決定される
;---------------------------------------------------------------------
@SET_QUALITY, ARG
#LOCALSIZE 2
LOCAL:1 = GET_ITEMDATA(ARG, "品质")
FOR LOCAL, 0, 5
	CALL PROPERTY_RIZE_QUALITY, GET_ITEMDATA(ARG, @"特性{LOCAL}")
	LOCAL:1 += RESULT
NEXT
;品質が100を超えないとSはつかない
SIF GET_ITEMDATA(ARG, "品质") <= 100
	LOCAL:1 = MIN(LOCAL:1, 99)
CALL SET_ITEMDATA, ARG, "质量", LIMIT((LOCAL:1 - 25) / 15, 0, 5)



;---------------------------------------------------------------------
;@SET_PRICE
;ARG 		:セット対象となる物品番号
;---------------------------------------------------------------------
@SET_PRICE, ARG
#DIM PRICE
#LOCALSIZE 2
;基礎价格
CALLFORM ITEM_PRICE_{GET_ITEMDATA(ARG, "ID")}
PRICE = RESULT
LOCAL = 0
;品質で-30% ~ 30%
LOCAL = (GET_ITEMDATA(ARG, "品质") - 60) / 2
;ランクで-40% ~ 60%
LOCAL += (GET_ITEMDATA(ARG, "质量") - 2) * 20

FOR LOCAL:1, 0, 5
	CALL PROPERTY_PRICE, GET_ITEMDATA(ARG, @"特性{LOCAL:1}")
	LOCAL += RESULT
NEXT

PRICE = MAX(PRICE * (LOCAL  + 100) / 100, 1)
CALL SET_ITEMDATA, ARG, "价格", MIN(PRICE, POWER(10, 10) - 1)

;量販价格設定
LOCAL = (GET_ITEMDATA(ARG, "等级") / 5) *(GET_ITEMDATA(ARG, "等级") / 5) * 10 + 250
PRICE = MAX(PRICE * LOCAL / 100, 1)
CALL SET_ITEMDATA, ARG, "贩卖价格", MIN(PRICE, POWER(10, 10) - 1)

;---------------------------------------------------------------------
;@SET_REVICE
;ARG 		:セット対象となる物品番号
;---------------------------------------------------------------------
@SET_REVICE, ARG
#DIM L_CATEGORY
#DIM L_COST
#LOCALSIZE 2
L_CATEGORY = 0
L_COST = 0
FOR LOCAL, 0, 5
	SELECTCASE GET_ITEMNAME_P(ARG, LOCAL)
		CASE "力を秘めたLv1"
			L_CATEGORY =+ 5
		CASE "力を秘めたLv2"
			L_CATEGORY += 7
		CASE "力を秘めたLv3"
			L_CATEGORY += 10
		CASE "消耗等级+1"
			L_COST += 5
		CASE "消耗等级+2"
			L_COST += 10
		CASE "消耗等级+3"
			L_COST += 15
	ENDSELECT
NEXT
SELECTCASE GET_ITEMNAME_E(ARG, 0)
	CASE "紅玉"
		L_CATEGORY =+ 30
	CASE "翠玉"
		L_CATEGORY += 60
	CASE "金剛石"
		L_CATEGORY += 90
ENDSELECT
CALL SET_ITEMDATA(ARG, "分类加成值", L_CATEGORY)
CALL SET_ITEMDATA(ARG, "消耗加成值", L_COST)
;----------------------------------------------------------------------
;@SET_ITEMLIST
;ARGS		:リストを利用する用途(篮子/箱子/所持(篮子+箱子)/帰還/獲得物品/调合/調教)
;ARGS:1		:リストに登録する物品の範囲
;ARG		:调合の場合の指定番号
;ARGS:2		:物品選択時の条件になる関数
;表示する物品のリストを作成する関数
;ここで作成されたリストがSHOW_ITEMLISTで表示される
;----------------------------------------------------------------------
@SET_ITEMLIST, ARGS, ARGS:1, ARG, ARGS:2
#LOCALSIZE 2
#LOCALSSIZE 10
#DIM L_CATEGORY
#DIM START
#DIM END
#DIM TEMP, 3
VARSET ITEM_ABLE, -1
VARSET ITEMLIST, -1
IF ARGS:1 == "篮子"
	START = 0
	END = 100
ELSE
	START = GET_ITEM_RANGE(ARGS:1)
	END = RESULT:1
ENDIF
IF ARGS == "装备调合"
	RESULT = 0, 0
	CALLFORM ITEM_MATERIAL_{ARG}
	TEMP:1 = RESULT, RESULT:1
ENDIF
IF ARGS == "量販店登録"
	L_CATEGORY = 0
	CALLFORM STORE_SALL_ABLE_%ARGS:2%
	SPLIT RESULTS, "/", LOCALS
	FOR LOCAL, 0, RESULT
		SETBIT L_CATEGORY, GET_NO("分类", LOCALS:LOCAL)
	NEXT
ENDIF
			
LOCAL:1 = 0
FOR LOCAL, START, END
	IF ARGS == "物品選択"
		CALLFORM %ARGS:2%, LOCAL
		SIF !RESULT
			CONTINUE
	ELSE
		TEMP = GET_ITEMDATA(LOCAL, "ID")
		;物品IDがない場合登録しない
		SIF TEMP <= 0
			CONTINUE
		IF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
			SIF !GETBIT(MIXLIST:LOCAL, ARG)
				CONTINUE
			;他のリストで選ばれている場合
			SIF MIXCHOICE:LOCAL > 0 && !GETBIT(MIXCHOICE:LOCAL, ARG)
				CONTINUE
		ELSEIF ARGS == "依頼報告"
			SIF TEMP != GET_REQ(ARG, "ID")
				CONTINUE
		ELSEIF ARGS == "使用物品"
			TRYCCALLFORM ITEM_TYPE_{TEMP}
				SIF RESULTS != "料理"
					CONTINUE
			CATCH
				CONTINUE
			ENDCATCH
		ELSEIF ARGS == "调教"
			TRYCCALLFORM ITEM_TYPE_{TEMP}
				SIF RESULTS != "调教" && RESULTS != "回復"
					CONTINUE
				;指令内で分岐するかチェック
				TRYCCALLFORM ITEM_BRUNCH_{TEMP}, TARGET, PLAYER, LOCAL
					ITEM_BRUNCH:(LOCAL:1) = RESULT
				CATCH
					ITEM_BRUNCH:(LOCAL:1) = 0
				ENDCATCH
				;ABLEチェック
				TRYCCALLFORM COM_ABLE, TEMP, TARGET, PLAYER, LOCAL
					ITEM_ABLE:(LOCAL:1) = RESULT
					SIF RESULT == -1
						CONTINUE
				CATCH
				ENDCATCH
			CATCH
				CONTINUE
			ENDCATCH
		ELSEIF ARGS == "装备调合"
			SIF !GROUPMATCH(TEMP, TEMP:1, TEMP:2)
				CONTINUE
		ELSEIF ARGS == "量販店登録"
			SIF !INRANGE(GET_ITEMDATA(LOCAL, "ID"), 501, 1500)
				CONTINUE
			SIF !(L_CATEGORY & GET_ITEMDATA(LOCAL, "分类"))
				CONTINUE
		ENDIF
	ENDIF
	ITEMLIST:(LOCAL:1) = LOCAL
	;ITEMLIST:(LOCAL:1) = LOCAL
	LOCAL:1++
NEXT
RETURN LOCAL:1
;---------------------------------------------------------------------
;@DEL_CHOICE_ITEM
;ARGS		:@SET_ITEMLISTのものと同じ。物品リストが破壊されるので再登録させるのに利用
;ARGS:1		:同上
;ARG
;
;選択した物品すべてを削除する
;---------------------------------------------------------------------
@DEL_CHOICE_ITEM, ARGS, ARGS:1, ARG
#LOCALSIZE 1
;まずは削除
FOR LOCAL, 0, VARSIZE("ITEMCHOICE")
	SIF !ITEMCHOICE:LOCAL
		CONTINUE
	;SIF !ITEMCHOICE:LOCAL
	CALL DEL_ITEMDATA, LOCAL
NEXT
;選択抹消
VARSET ITEMCHOICE

;発生した空物品を詰める
CALL DISPOSE_OF_ITEM

;リスト再生成
SIF GROUPMATCH("", ARGS, ARGS:1) + (ARG > 0) < 3
	CALL SET_ITEMLIST, ARGS, ARGS:1, ARG

;---------------------------------------------------------------------
;@MOVE_ITEM
;ARGS		送り先(篮子/箱子)
;ARGS:1		:@SET_ITEMLISTのARGS:1と同じ。物品リストが破壊されるので再登録させるのに利用
;ARGS:2		:同上
;ARG		:同上
;
;物品移動関数
;選択状态の物品を送り先に移す
;---------------------------------------------------------------------
@MOVE_ITEM, ARGS, ARGS:1, ARGS:2, ARG
#LOCALSIZE 4
#DIM START
#DIM END
IF ARGS == "篮子"
	START = 0
	END = BASKET_SIZE()
ELSEIF ARGS == "箱子"
	START = 100
	END = 1100
ELSE
	START = 1100
	END = 1200
ENDIF
LOCAL:1 = 0
FOR LOCAL, 0, 1200
	;選択されてない物品はスルー
	;SIF !ITEMCHOICE:LOCAL
	SIF !ITEMCHOICE:LOCAL
		CONTINUE
	WHILE START < END
		;物品が入ってなかったら入れ替える
		IF !GET_ITEMDATA(START, "ID")
			;交換して入れ替える
			;PRINTFORML SWAP [{LOCAL}] と [{START}]
			CALL SWAP_ITEMDATA(LOCAL, START)
			;選択を解除
			ITEMCHOICE:LOCAL = 0
			BREAK
		ENDIF
		START++
	WEND
NEXT
;移動によって発生した空白を詰める
CALL DISPOSE_OF_ITEM
;リスト再生成
SIF GROUPMATCH("", ARGS:1, ARGS:2) + (ARG > 0) < 3
	CALL SET_ITEMLIST, ARGS:1, ARGS:2, ARG
;最大值が0でない、つまり選択がすべて空になっていれば真が帰り
;偽の場合、入りきらなかったことを示す
RETURN !MAXARRAY(ITEMCHOICE)
;RETURN !MAXARRAY(ITEMCHOICE)

;---------------------------------------------------------------------
;@DISPOSE_OF_ITEM
;
;DAに発生した空欄を詰める関数
;@MOVE_ITEM/DEL_CHOICE_ITEMの下部関数
;---------------------------------------------------------------------
@DISPOSE_OF_ITEM
#LOCALSIZE 2
