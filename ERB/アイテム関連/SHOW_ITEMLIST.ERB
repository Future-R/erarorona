@ITEM_DEBUG_ID, ARG
#DIM PAGE, 2
#DIM PAGE_ABLE, 20
#DIM MAXPAGE
#DIM L_ID
#DIM 目录閾值, 6
#DIM LINE
#DIM TEMP
#DIM L_PROP, 5
#DIMS TEMPS
#DIMS MODE
MODE = ID
LINE = LINECOUNT
MAXPAGE = 0
FOR LOCAL, 0, 物品总数 / 100
	FOR LOCAL:1, LOCAL * 100, (LOCAL + 1) * 100
		TRYCCALLFORM ITEM_NAME_{LOCAL:1}
			PAGE_ABLE:MAXPAGE = 1
			MAXPAGE++
			BREAK
		CATCH
		ENDCATCH
	NEXT
NEXT
MAXPAGE -= 1
$START
CLEARLINE LINECOUNT - LINE
DRAWLINE
PRINTFORM 　%GET_ITEMNAME(ARG), 40, LEFT%
PRINTBUTTON "[◀] " , "-"
IF MODE == "SHOW"
	PRINTFORM PAGE.{PAGE,2}
ELSE
	PRINTFORM PAGE.{PAGE:1,2}
ENDIF
PRINTBUTTON " [▶]", "+"
PRINTFORM %"", 16%
CALL PRINTSBUTTON_C, "[ID]", "ID", MODE == "ID", COLOR("p-blue")
PRINTFORM %"", 4%
CALL PRINTSBUTTON_C, "[特性]", "特性", MODE == "特性", COLOR("p-blue")
PRINTL 
DRAWLINE
IF MODE == "ID"
	FOR LOCAL, PAGE * 100 + 1, (PAGE + 1) * 100 + 1
		TRYCCALLFORM ITEM_NAME_{LOCAL}
			CALL PRINTSBUTTON_C, @"%@"[{LOCAL, 4}] " + RESULTS, 24, LEFT%", TOSTR(LOCAL), LOCAL == GET_ITEMDATA(ARG, "ID"), COLOR("p-green")
		CATCH
			PRINTFORM %"",24%
		ENDCATCH
		SIF LOCAL % 5 == 0
			PRINTL 
	NEXT
ELSE
	TEMP = GET_ITEMDATA(ARG, "ID")
	TRYCCALLFORM ITEM_TYPE_{TEMP}
		TEMPS = %RESULTS%
	CATCH
		TEMPS = ALL
	ENDCATCH
	FOR LOCAL, 0, 5
		L_PROP:LOCAL = GET_ITEMDATA(ARG, @"特性{LOCAL}")
	NEXT
	FOR LOCAL, PAGE:1 * 100 + 1, (PAGE:1 + 1) * 100 + 1
		IF LOCAL < 400 && !STRCOUNT(GET_NAME("特性", LOCAL), "不在")
			CALL PROPERTY_SUCCESSION, LOCAL
			LOCAL:2 = 0
			FOR LOCAL:1, 0, STRCOUNT(TEMPS, "/")
				SIF !STRCOUNT(RESULTS, AUTO_SPLIT(TEMPS, "/", LOCAL:1))
					CONTINUE
				LOCAL:2 = 1
				BREAK
			NEXT
			IF LOCAL:2 || TEMPS == "ALL"
				IF  MATCH(L_PROP, LOCAL)
					CALL PRINTSBUTTON_C, @"%@"[{LOCAL, 4}] " + GET_NAME("特性", LOCAL), 24, LEFT%", TOSTR(FINDELEMENT(L_PROP, LOCAL) + 5000), 1, COLOR("p-green")
				ELSE
					PRINTBUTTON @"%@"[{LOCAL, 4}] " + GET_NAME("特性", LOCAL), 24, LEFT%", TOSTR(LOCAL + 4000)
				ENDIF
			ELSE
				CALL COLORPRINT, @"%@"[{LOCAL, 4}] " + GET_NAME("特性", LOCAL), 24, LEFT%", COLOR("gray")
			ENDIF
		ELSE
			PRINTFORM %"",24%
		ENDIF
		SIF LOCAL % 5 == 0
			PRINTL 
	NEXT
ENDIF
DRAWLINE
PRINTFORM 　Qu:%GET_ITEMRANK(ARG)%　　　　　
PRINTFORM 品質:{GET_ITEMDATA(ARG, "品质"),3}　　　　　
PRINTBUTTON " [◀] " , "<"
CALL PRINTSBUTTON_C, UNICODE(0x2580), TOSTR(3000), 1, COLOR("BG")
FOR LOCAL, 1, 61
	CALL PRINTSBUTTON_C, UNICODE(0x2580), TOSTR(3000 + LOCAL), LOCAL * 2 <= GET_ITEMDATA(ARG, "品质") , COLOR("p-red") , COLOR("gray")
NEXT
PRINTBUTTON " [▶]", ">"
PRINTL 
DRAWLINE
PRINTFORML ┌%"─"*5%┬%"─"*9%┬%"─"*9%┬%"─"*9%┬%"─"* 25%┐
FOR LOCAL, 0, 4
	PRINTFORM │ %@"效果{LOCAL+1}", 9,LEFT%
	VARSET RESULT, 999, 0, 6
	TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{GET_ITEMDATA(ARG, "ID")}
		目录閾值 = 0, RESULT / 2, RESULT:1 / 2, RESULT:2 / 2, RESULT:3 / 2, 999
		VARSET LOCALS, "", 0, 5
		SPLIT RESULTS, "/", LOCALS
		;主效果セット
		FOR LOCAL:1, 0, 3
			PRINT │
			CALL PRINTSBUTTON_C, @"%LOCALS:(LOCAL:1),18,LEFT%", @"主效果{LOCAL}_" + LOCALS:(LOCAL:1), GET_ITEMNAME_E(ARG, LOCAL) == LOCALS:(LOCAL:1), COLOR("p-green")
		NEXT
		PRINT │
		FOR LOCAL:1, 0, 4
			CALL SET_COLOR, AUTO_SPLIT("gray/p-blue/p-green/p-red", "/", LOCAL:1)
			SELECTCASE AUTO_SPLIT("gray/p-blue/p-green/p-red", "/", LOCAL:1)
				CASE "p-blue"
					TEMPS = %LOCALS%
				CASE "p-green"
					TEMPS = %LOCALS:1%
				CASE "p-red"
					TEMPS = %LOCALS:2%
				CASEELSE
					TEMPS = 
			ENDSELECT
			PRINTBUTTON UNICODE(0x2580) * (LIMIT(目录閾值:(LOCAL:1 + 1), 0, 50) - LIMIT(目录閾值:(LOCAL:1), 0, 50)), @"主效果{LOCAL}_" + TEMPS
		NEXT
		PRINTBUTTON UNICODE(0x2580) * MAX(50 - 目录閾值:4, 0), @"主效果{LOCAL}_"
		RESETCOLOR
	CATCH
		FOR LOCAL:1, 0, 3
			PRINTFORM │%"",18%
		NEXT
		PRINTFORM │%"",50%
	ENDCATCH
	PRINTFORML │
NEXT
PRINTFORML ├%"─"*5%┴%"─"*9%┴%"─"*9%┴%"─"*9%┴%"─"* 25%┤
LOCALS = 
FOR LOCAL:1, 0, 目录要素数
	TRYCCALLFORM ITEM_CATEGORY_{GET_ITEMDATA(ARG, "ID")}, LOCAL:1
		SIF RESULT >= 0
			LOCALS += " " + GET_NAME("目录", LOCAL:1)
	CATCH
		BREAK
	ENDCATCH
NEXT
PRINTFORML │%LOCALS,122,LEFT%│
PRINTFORML ├%"─"*61%┤
PRINT │
FOR LOCAL, 0, 3
	SIF LOCAL
		PRINT  
	IF GET_ITEMDATA(ARG, @"特性{LOCAL}")
		PRINTBUTTON @"%GET_ITEMNAME_P(ARG, LOCAL), 40, LEFT%", TOSTR(5000 + LOCAL)
	ELSE
		PRINTFORM %" " * 40%
	ENDIF
NEXT
PRINTL │
PRINT │
FOR LOCAL, 0, 2
	SIF LOCAL
		PRINT  
	IF GET_ITEMDATA(ARG, @"特性{LOCAL + 3}")
		PRINTBUTTON @"%GET_ITEMNAME_P(ARG, LOCAL + 3), 40, LEFT%", TOSTR(5000 + LOCAL + 3)
	ELSE
		PRINTFORM %" " * 40%
	ENDIF
NEXT
PRINTFORML %" " * 41%│
PRINTFORML └%"─"*61%┘
DRAWLINE
PRINTL [9] 戻る
CALL EQUATE_LINE, LINE + MAXLINE()
INPUTS
SELECTCASE RESULTS
	CASE "9"
		RETURN 0
	CASE "+"
		IF MODE == "ID"
			SIF PAGE++ == MAXPAGE
				PAGE = 0
		ELSE
			SIF PAGE:1++ == 4
				PAGE:1 = 0
		ENDIF
	CASE "-"
		IF MODE == "ID"
			SIF PAGE-- == 0
				PAGE = MAXPAGE
		ELSE
			SIF PAGE:1-- == 0
				PAGE:1 = 4
		ENDIF
	CASE ">"
		CALL SET_ITEMDATA, ARG, "品质", MIN(GET_ITEMDATA(ARG, "品质") + 1, 120)
	CASE "<"
		CALL SET_ITEMDATA, ARG, "品质", MAX(GET_ITEMDATA(ARG, "品质") - 1, 0)
	CASE "ID", "特性"
		MODE = %RESULTS%
	CASEELSE
		IF STRCOUNT(RESULTS, "主效果")
			IF AUTO_SPLIT(RESULTS, "_", 1) == ""
				CALL SET_ITEMDATA, ARG, AUTO_SPLIT(RESULTS, "_", 0), 0
			ELSE
				CALL SET_ITEMDATA, ARG, AUTO_SPLIT(RESULTS, "_", 0), GET_NO("主效果", AUTO_SPLIT(RESULTS, "_", 1))
			ENDIF
		ELSEIF ISNUMERIC(RESULTS)
			TEMP = TOINT(RESULTS)
			SELECTCASE TEMP
				CASE IS < 2000
					CALL SET_ITEMDATA, ARG, "ID", TEMP
					CALL SET_CATEGORY, ARG
					CALLFORM ITEM_LV_{TEMP}
					CALL SET_ITEMDATA, ARG, "等级", RESULT
					;主效果を一旦リセット
					FOR LOCAL, 0, 4
						CALL SET_ITEMDATA, ARG, @"主效果{LOCAL}", 0
					NEXT
					;固定特性を突っ込む
					TRYCCALLFORM PROPERTY_OF_CHARACTERISTIC_{TEMP}
						CALL SET_ITEMDATA, ARG, "特性0", RESULT
					CATCH
					ENDCATCH
					;不適正な特性を剥がす
					TRYCCALLFORM ITEM_TYPE_{TEMP}
						TEMPS = %RESULTS%
						FOR LOCAL, 0, 5
							IF GET_ITEMDATA(ARG, @"特性{LOCAL}") > 0
								LOCAL:2 = 0
								CALL PROPERTY_SUCCESSION, GET_ITEMDATA(ARG, @"特性{LOCAL}")
								FOR LOCAL:1, 0, STRCOUNT(TEMPS, "/")
									SIF !STRCOUNT(RESULTS, AUTO_SPLIT(TEMPS, "/", LOCAL:1))
										CONTINUE
									LOCAL:2 = 1
									BREAK
								NEXT
								SIF !LOCAL:2
									CALL SET_ITEMDATA, ARG, @"特性{LOCAL}", 0
							ENDIF
						NEXT
					CATCH
					ENDCATCH
				CASE 3000 TO 3060
					CALL SET_ITEMDATA, ARG, "品质", (TEMP - 3000) * 2
				CASE 4000 TO 4399
					FOR LOCAL, 4, 0, -1
						CALL SET_ITEMDATA(ARG, @"特性{LOCAL}", GET_ITEMDATA(ARG, @"特性{LOCAL - 1}"))
					NEXT
					CALL SET_ITEMDATA(ARG, "特性0", TEMP - 4000)
				CASE 5000 TO 5004
					CALL SET_ITEMDATA(ARG, @"特性{TEMP - 5000}", 0)
					FOR LOCAL, 0, 4
						IF !GET_ITEMDATA(ARG, @"特性{LOCAL}")
							CALL SET_ITEMDATA(ARG, @"特性{LOCAL}", GET_ITEMDATA(ARG, @"特性{LOCAL + 1}"))
							CALL SET_ITEMDATA(ARG, @"特性{LOCAL + 1}", 0)
						ENDIF
					NEXT
			ENDSELECT
		ENDIF
ENDSELECT
CALL SET_QUALITY, ARG
GOTO START
