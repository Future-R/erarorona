				ITEMCHOICE:(ITEMLIST:NUM) = 0
			ELSE
				IF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
					IF MATCH(ITEMCHOICE, 1) != MIXNUM
						ITEMCHOICE:(ITEMLIST:NUM) = 1
					ELSE
						IF MIXNUM == 1
							ITEMCHOICE:FINDELEMENT(ITEMCHOICE, 1) = 0
							ITEMCHOICE:(ITEMLIST:NUM) = 1
						ENDIF
					ENDIF
				ELSEIF ARGS == "依頼報告"
					SIF MATCH(ITEMCHOICE, 1) < GET_REQ(ARG, "個数")
						ITEMCHOICE:(ITEMLIST:NUM) = 1
				ELSEIF ARGS == "物品选择"
					IF MATCH(ITEMCHOICE, 1) == ARG
						ITEMCHOICE:(ITEMLIST:NUM) = 1
					ELSE
						IF ARG == 1
							ITEMCHOICE:FINDELEMENT(ITEMCHOICE, 1) = 0
							ITEMCHOICE:(ITEMLIST:NUM) = 1
						ENDIF
					ENDIF
				ELSE
					ITEMCHOICE:(ITEMLIST:NUM) = 1
				ENDIF
			ENDIF
		ENDIF
	CASE "2", "6", "3"
		IF NUM == MAXNUM - 1
			PAGE = 0
			NUM = 0
		ELSE
			SELECTCASE RESULTS
				CASE "2"
					NUM = LIMIT(NUM + 1, 0, MAX(0, MAXNUM - 1))
					SIF PAGE + 显示数 - 1 < NUM
						PAGE = LIMIT(PAGE + 1, 0, MAX(0, MAXNUM - 显示数))
				CASE "6"
					NUM = LIMIT(PAGE + 显示数, 0, MAX(0, MAXNUM - 1))
					PAGE = LIMIT(PAGE + 显示数, 0, MAX(0, MAXNUM - 显示数))
				CASE "3"
					NUM = LIMIT(PAGE + 显示数 * 5, 0, MAX(0, MAXNUM - 1))
					PAGE = LIMIT(PAGE + 显示数 * 5 , 0, MAX(0, MAXNUM - 显示数))
			ENDSELECT
		ENDIF
	CASE "7"
		INVERTBIT HELP, 0
	CASE ">"
		PAGE = MAXNUM - 显示数
		NUM = MAXNUM - 1
	CASE "<"
		PAGE = 0
		NUM = 0
	CASE "^"
		PICKUP_PROP_COUNT = (PICKUP_PROP_COUNT + 1) % VARSIZE("PICKUP_PROP")
	CASE "排序"
		CALL ITEMLIST_SORT, AUTO_SPLIT(RESULTS, "_", 1), MAXNUM
	CASE "+"
		IF STRCOUNT(MODE, "选择")
			MODE = 选择
		ELSE
			CALL ITEMLIST_SORT, "+", MAXNUM
		ENDIF
	CASE "-", 
		IF STRCOUNT(MODE, "选择")
			NUM:1 = NUM
			MODE = 複数选择
		ELSE
			CALL ITEMLIST_SORT, "-", MAXNUM
		ENDIF
	CASE "*"
		IF STRCOUNT(MODE, "选择")
			NUM:1 = NUM
			MODE = 複数选择解除
		ELSE
			CALL ITEMLIST_SORT, "*", MAXNUM
		ENDIF
	CASE "/"
		RESULTS:1 = %RESULTS%
		IF STRCOUNT(MODE, "选择")
			FOR LOCAL, 0, 1200
				SIF ITEMLIST:LOCAL < 0
					BREAK
				SIF (ARGS == "调合" || ARGS == "制造霍姆克鲁斯") && MATCH(ITEMCHOICE, 1) == MIXNUM
					BREAK
				SIF ARGS == "物品选择" && MATCH(ITEMCHOICE, 1) == ARG
					BREAK
				SIF ARGS == "依頼報告" && MATCH(ITEMCHOICE, 1) == GET_REQ(ARG, "個数")
					BREAK
				ITEMCHOICE:(ITEMLIST:LOCAL) = 1
				MODE = 选择
			NEXT
		ELSE
			CALL ITEMLIST_SORT, "/", MAXNUM
		ENDIF
	CASE "."
		IF STRCOUNT(MODE, "选择")
			VARSET ITEMCHOICE
			MODE = 选择
		ELSE
			CALL ITEMLIST_SORT, ".", MAXNUM
		ENDIF
	;所持数排序
	CASE "@"
		CALL SET_SORT
	CASE "9"
		IF ARGS == "获得物品"
			IF ARGS:1 != "临时" 
				CLEARLINE LINECOUNT - LINE:2
				CALL MESSAGE_WINDOW, , "物品獲得処理に戻ります"
				CLEARLINE LINECOUNT - LINE
				REDRAW C_REDRAW
				ARGS = 获得物品
				ARGS:1 = 临时
				CALL SHOW_BLANK
				RESTART
			ELSE
				CLEARLINE LINECOUNT - LINE:2
				;选择物品なしなら即終了
				IF !MAXARRAY(ITEMCHOICE)
					CALL MESSAGE_WINDOW, , "物品獲得処理を終了します"
					CALL SHOW_BLANK
					RETURN 1
				ELSE
					;CALL INPUT_YN_M, "选择されている物品を獲得して/物品獲得処理を終了してもよろしいですか？"
					;SIF RESULT
					;	GOTO START
					TEMPS = \@FLAG:当前地点 == GET_NO("地点", "亚兰德") ? 箱子 # 篮子\@
					CALL MOVE_ITEM, TEMPS, ARGS, ARGS:1, ARG
					IF !RESULT
						CLEARLINE LINECOUNT - LINE:2
						CALL MESSAGE_WINDOW, "", TEMPS + "の容量が不足しています/物品の一部は移動させられませんでした"
						GOTO START
					ELSE
						CALL SHOW_BLANK
						REDRAW C_REDRAW
						RETURN 1
					ENDIF
				ENDIF
			ENDIF
		ELSEIF ARGS == "归返时"
			CLEARLINE LINECOUNT - LINE:2
			;选择物品なしなら即終了
			IF !MAXARRAY(ITEMCHOICE)
				RETURN 1
			ELSE
				;CALL INPUT_YN_M, "选择されている物品を獲得して/物品獲得処理を終了してもよろしいですか？"
				;SIF RESULT
				;	GOTO START
				CALL MOVE_ITEM, "箱子", ARGS, ARGS:1, ARG
				IF !RESULT
					CLEARLINE LINECOUNT - LINE:2
					CALL MESSAGE_WINDOW, "", "箱子の容量が不足しています/物品の一部は移動させられませんでした"
					GOTO START
				ELSE
					CALL SHOW_BLANK
					REDRAW C_REDRAW
					RETURN 1
				ENDIF
			ENDIF
		ELSEIF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
			REDRAW C_REDRAW
			;选择数の情報を返す
			RETURN MATCH(ITEMCHOICE, 1)
		ELSEIF ARGS == "量販店登録"
			REDRAW C_REDRAW
			RETURN -1
		ELSE
			$END
			REDRAW C_REDRAW
			RETURN 0
		ENDIF
	CASE "物品解説"
		IF ITEMLIST:NUM >= 0
			IF FLAG:DEBUG
				CALL ITEM_DEBUG_ID, ITEMLIST:NUM
			ELSE
				TRYCCALLFORM ITEM_EXPLAIN_{GET_ITEMDATA(ITEMLIST:NUM, "ID")}
					CLEARLINE LINECOUNT - LINE:2
					CALL MESSAGE_WINDOW, , RESULTS
				CATCH
				ENDCATCH
			ENDIF
		ENDIF
	CASE "特性解説"
		IF AUTO_SPLIT(RESULTS, "_", 1) != ""
			IF ISNUMERIC(AUTO_SPLIT(RESULTS, "_", 1))
				LOCAL = TOINT(AUTO_SPLIT(RESULTS, "_", 1))
			ELSE
				LOCAL = GET_NO("特性", AUTO_SPLIT(RESULTS, "_", 1))
			ENDIF
			IF LOCAL > 0
				CALL PROPERTY_EXPLAIN, LOCAL
				CLEARLINE LINECOUNT - LINE:2
				CALL MESSAGE_WINDOW, , RESULTS
			ENDIF
		ENDIF
	CASE "效果解説"
		IF AUTO_SPLIT(RESULTS, "_", 1) != ""
			IF ISNUMERIC(AUTO_SPLIT(RESULTS, "_", 1))
				LOCAL = TOINT(AUTO_SPLIT(RESULTS, "_", 1))
			ELSE
				LOCAL = GET_NO("主效果", AUTO_SPLIT(RESULTS, "_", 1))
			ENDIF
			IF LOCAL > 0
				TRYCCALLFORM EFFECT_EXPLAIN_{LOCAL}
					CLEARLINE LINECOUNT - LINE:2
					CALL MESSAGE_WINDOW, , RESULTS
				CATCH
				ENDCATCH
			ENDIF
		ENDIF
	CASE "素質解説"
		IF AUTO_SPLIT(RESULTS, "_", 1) != ""
			TRYCCALLFORM TALENT_EXPLAIN_%AUTO_SPLIT(RESULTS, "_", 1)%
				CLEARLINE LINECOUNT - LINE:2
				CALL MESSAGE_WINDOW, , RESULTS
			CATCH
			ENDCATCH
		ENDIF
	CASE "q"
		SIF ARGS == "调合" && P_PAGE > 0
			P_PAGE--
	CASE "w"
		SIF ARGS == "调合" && GAIN_P_LIST:((P_PAGE+1) * 25)
			P_PAGE++
	CASE "物品"
		TEMP = AUTO_SPLIT_INT(RESULTS, "_", 1)
		IF GROUPMATCH(ARGS, "使用物品", "量販店登録")
			IF NUM == TEMP
				GOTO MENU_START
			ELSE
				NUM = TEMP
			ENDIF
		ELSE
			NUM = TEMP
			IF ARGS == "装备调合"
				IF ITEMCHOICE:(ITEMLIST:NUM)
					GOTO MENU_START
				ELSE
					VARSET ITEMCHOICE
					ITEMCHOICE:(ITEMLIST:NUM) = 1
				ENDIF
			ELSE
				;IF !IS_SP_DOWN && 
				IF !STRCOUNT(MODE, "複数选择")
					IF ITEMCHOICE:(ITEMLIST:NUM)
						ITEMCHOICE:(ITEMLIST:NUM) = 0
					ELSE
						IF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
							IF MATCH(ITEMCHOICE, 1) != MIXNUM
								ITEMCHOICE:(ITEMLIST:NUM) = 1
							ELSE
								IF MIXNUM == 1
									ITEMCHOICE:FINDELEMENT(ITEMCHOICE, 1) = 0
									ITEMCHOICE:(ITEMLIST:NUM) = 1
								ENDIF
							ENDIF
						ELSEIF ARGS == "依頼報告"
							SIF MATCH(ITEMCHOICE, 1) < GET_REQ(ARG, "個数")
								ITEMCHOICE:(ITEMLIST:NUM) = 1
						ELSEIF ARGS == "物品选择"
							IF MATCH(ITEMCHOICE, 1) != ARG
								ITEMCHOICE:(ITEMLIST:NUM) = 1
							ELSE
								IF ARG == 1
									ITEMCHOICE:FINDELEMENT(ITEMCHOICE, 1) = 0
									ITEMCHOICE:(ITEMLIST:NUM) = 1
								ENDIF
							ENDIF
						ELSE
							ITEMCHOICE:(ITEMLIST:NUM) = 1
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	CASE "特质"
		TEMP = AUTO_SPLIT_INT(RESULTS, "_", 1)
		CLEARLINE LINECOUNT - LINE:2
		CALLFORM TALENT_EXPLAIN_%TALENTNAME:TEMP%
		SPLIT RESULTS, "/", LOCALS
		FOR LOCAL, 0, RESULT
			PRINTFORML %LOCALS:LOCAL%
		NEXT
		CALL EQUATE_LINE, LINE + MAXLINE()
		WAITANYKEY
ENDSELECT
;IF (IS_SP_DOWN || STRCOUNT(MODE, "複数选择")) && ITEMLIST:LOCAL >= 0
IF STRCOUNT(MODE, "複数选择") && ITEMLIST:LOCAL >= 0
	FOR LOCAL, MIN(NUM, NUM:1), MAX(NUM, NUM:1) + 1
		IF MODE == "複数选择解除" || SP_MODE == "解除"
			ITEMCHOICE:(ITEMLIST:LOCAL) = 0
		ELSE
			SIF (ARGS == "调合" || ARGS == "制造霍姆克鲁斯") && MATCH(ITEMCHOICE, 1) == MIXNUM
				BREAK
			SIF ARGS == "依頼報告" && MATCH(ITEMCHOICE, 1) == GET_REQ(ARG, "個数")
				BREAK
			SIF ARGS == "物品选择" && MATCH(ITEMCHOICE, 1) == ARG
				BREAK
			ITEMCHOICE:(ITEMLIST:LOCAL) = 1
		ENDIF
	NEXT
	;IS_SP_DOWN = 5
	NUM:1 = NUM
ENDIF
IF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
	;调合はMIX_SELECTを更新する
	FOR LOCAL, 0, 1200
		IF ITEMCHOICE:LOCAL
			SETBIT MIXCHOICE:LOCAL, ARG
		ELSE
			CLEARBIT MIXCHOICE:LOCAL, ARG
		ENDIF
	NEXT
ENDIF
;PAGEが一度に2以上動いた場合、暗転表示を入れる
SIF ABS(PAGE - PAGE:1) > 1
	CALL SHOW_BLANK 
PAGE:1 = PAGE
GOTO START

