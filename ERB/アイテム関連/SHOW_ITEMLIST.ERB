;					　主に@SYSTEM_ITEM.ERBの関数を下部として利用する
;
;
;	Edit	Date			Ver		Author					Reason					
;	001		2012/05/30				kap						新規作成			
;	002		2012/07/29		0.300	kap						物品使用を追加		
;							0.300							行数を調整				
;	003		2012/08/19		0.305	kap						各表示の横幅を変更		
;							0.305							排序システムを変更	
;	004		2012/08/28		0.320	kap						価格排序を追加	
;															同一排序を連続実行することで昇降が逆転するように
;															[.]の排序が使えなかったのを修正
;	005		2012/09/01		0.340	kap						物品の詳細表示にも次数表示を追加
;	006		2012/09/10		0.351	kap						物品リストの一部ボタンがESCAPEされていなかったのを修正
;	007		2012/09/19		0.370	kap						メッセージの点击範囲拡張に対応
;	008		2012/09/25		0.390	kap						下部の情報欄の物品名の表示を修正
;															一覧の始端と末端でループするように
;	008		2012/09/25		0.410	kap						装備调合を追加
;															店舗情報をARGS:2に変更
;	009		2012/10/23		0.420	kap						スペースキー押しっぱなしで複数选择モードになるように
;	010		2012/12/09		0.430	kap						商売人の效果で売却額が上昇するように変更
;	011		2012/12/16		0.440	kap						获得物品→篮子などの領域移動が正しく実行されなかったのを修正
;	012		2012/01/20		0.446	kap						一部素質の説明文のためにLOCALSのサイズを増加
;	013		2013/10/30		0.490	kap						排序機能が死んでいたのを修正
;	014		2013/11/01		0.491	kap						特性の色強調機能を追加
;	015		2013/11/03		0.492	kap						特性の色強調機能と排序設定のボタンかぶりを修正
;	016		2013/11/19		0.500	kap						量販店登録を追加
;	017		2014/04/01		0.540	kap						売却額の表示処理を変更
;	018		2014/06/23		0.570	kap						出し入れ自由自在の処理を追加
;---------------------------------------------------------------------
;------------------------------------
;リストをセットし
;更に表示する関数
;ARGS   呼び出し分類
;ARGS:1 登録範囲 篮子/箱子/临时/所持物品
;ARG	调合時の番号(ホムンクルス合成の要求物品番号)(选择時の個数)
;ARGS:2 要求物品名/要求個数/调合物品名 (売却時の店番号)
;------------------------------------
@SHOW_ITEMLIST, ARGS, ARGS:1, ARG, ARGS:2
#LOCALSIZE 4
#LOCALSSIZE 5

#DIM TEMP
#DIMS TEMPS
#DIM LAYER_X
#DIM LAYER_Y

#DIM ITEMNUM
#DIM PAGE, 2
#DIM NUM, 2
#DIM MAXNUM, 1
#DIM 显示数, 1
#DIM LIST_A,1200
#DIM NUM_A
#DIM LIST_B,1200
#DIM NUM_B
#DIMS L_PROPERTY, 2
#DIM L_PROP_COLOR
#DIM L_DEF_COLOR
#DIMS CONST PICKUP_PROP = "", "通常", "调教", "特征", "不良"
#DIM PICKUP_PROP_COUNT
#DIM CATEGORY, 5
#DIM PRICE

#DIMS MENU_CHOICE_ABLE
#DIM CHOICENUM

#DIM P_PAGE

#DIMS MODE
#DIM HELP

#DIM 目录閾值, 6
#DIM 目录值

#DIMS MIXNAME
#DIM MIXITEM
#DIM MIXNUM

#DIM HOMUNUM

#DIM LINE, 3
#DIM C_REDRAW

#DIM IS_SP_DOWN
#DIMS SP_MODE

NUM:1 = -1
;-------------------------------------------------
;物品のリスト作成
;-------------------------------------------------
;処理用に変数引き写し
FOR LOCAL, GET_ITEM_RANGE(ARGS:1), RESULT:1
	所持物品:LOCAL = GET_ITEMDATA(LOCAL, "ID")
NEXT

;物品の选择情報
IF ARGS == "调合" || ARGS == "制造霍姆克鲁斯"
	SPLIT ARGS:2, "/", LOCALS
	P_PAGE = 0
	MIXNAME = %LOCALS%
	MIXNUM = TOINT(LOCALS:1)
	MIXITEM = TOINT(LOCALS:2)
	FOR LOCAL, 0, VARSIZE("ITEMCHOICE")
		ITEMCHOICE:LOCAL = GETBIT(MIXCHOICE:LOCAL, ARG)
	NEXT
ELSEIF !GROUPMATCH(ARGS, "归返时")
	VARSET ITEMCHOICE
ENDIF

CALL SET_ITEMLIST, ARGS, ARGS:1, ARG, ARGS:2

;获得物品は全部チェック状态からスタート
IF ARGS == "获得物品" && ARGS:1 == "临时"
	LOCAL = 0
	WHILE ITEMLIST:LOCAL >= 0
		ITEMCHOICE:(ITEMLIST:LOCAL) = 1
		LOCAL++
	WEND
ENDIF

LINE = LINECOUNT
IF GROUPMATCH(ARGS, "使用物品", "装备调合", "量販店登録")
	MODE = 排序
ELSE
	MODE = 选择
ENDIF

C_REDRAW = CURRENTREDRAW()

REDRAW 0
SELECTCASE ARGS
	CASE "制造霍姆克鲁斯"
		显示数 = 8
	CASE "出售", "依頼報告"
		显示数 = 16
	CASEELSE
		显示数 = 18
ENDSELECT

SORT_PREVS = 

PAGE = 0
PAGE:1 = 0
NUM = 0

$START
;物品数の変動で物品がない位置にポイントがあってしまった場合の措置
IF ITEMLIST:NUM < 0
	PAGE = 0
	PAGE:1 = 0
	NUM = 0
ENDIF
CLEARLINE LINECOUNT - LINE
CALL INIT_LAYER

MAXNUM = VARSIZE("ITEMLIST") - MATCH(ITEMLIST, -1)

;--------------------------------------------------
;売却の場合、現在の売却総額を計算
;--------------------------------------------------
IF ARGS == "出售"
	PRICE = 0
	FOR LOCAL, 0, VARSIZE("ITEMLIST")
		SIF ITEMCHOICE:LOCAL
			PRICE +=  GET_SELL_PRICE(LOCAL)
	NEXT
ENDIF

;---------------------------------------------------
;ヘッダー部分
;---------------------------------------------------
CALL LAYER_DRAWLINE, 0
;容量表示
LOCALS = 篮子空间 [{GET_ITEM_TOTAL("篮子")} / {BASKET_SIZE()}] 箱子空间 [{GET_ITEM_TOTAL("箱子")} / 1000]
SELECTCASE ARGS
	CASE "篮子", "箱子"
		CALL LAYER_SET, @"　%ARGS + @" [{1 + PAGE}～ {PAGE + 显示数}]",65,LEFT%" + LOCALS, 1
	CASE "归返时"
		CALL LAYER_SET, @"　%"篮子" + @" [{1 + PAGE}～ {PAGE + 显示数}]",65,LEFT%" + LOCALS, 1
	CASE "获得物品"
		IF FLAG:当前地点 == GET_NO("地点", "亚兰德") || IS_ITEM_MOVE_ABLE()
			LOCALS '= @" 获得数[{GET_ITEM_TOTAL("临时"),2}] " + LOCALS
			SELECTCASE ARGS:1
				CASE "篮子"
					CALL LAYER_SET, @"　%"篮子" + @" [{1 + PAGE}～ {PAGE + 显示数}]",52,LEFT%" + LOCALS, 1
				CASE "箱子"
					CALL LAYER_SET, @"　%"箱子" + @" [{1 + PAGE}～ {PAGE + 显示数}]",52,LEFT%" + LOCALS, 1
				CASE "临时"
					CALL LAYER_SET, @"　%"获得物品" + @" [{1 + PAGE}～ {PAGE + 显示数}]",52,LEFT%" + LOCALS, 1
			ENDSELECT
		ELSE
			CALL LAYER_SET, @"　%\@ARGS:1 == "篮子" ? 篮子 # 获得物品 \@ + @" [{1 + PAGE}～ {PAGE + 显示数}]",68,LEFT%获得物品 [{GET_ITEM_TOTAL("临时")}] 篮子容量 [{GET_ITEM_TOTAL("篮子")} / {BASKET_SIZE()}]", 1
		ENDIF
	CASE "调合"
		CALL LAYER_SET, @"　%MIXNAME,22,LEFT%[{MATCH(ITEMCHOICE, 1),4}/{MIXNUM,4}]　 Lv[{GET_COSTLV_IN_MIX(ARG),3}]", 1
	CASE "使用物品"
		CALL LAYER_SET, @"　%SHOW_DAY()%", 1
	CASE "出售", "装备调合", "量販店登録"
		CALL LAYER_SET, @"　%SHOW_DAY()%%"", 8%%"-" + GET_NAME("贩售店", TOINT(ARGS:2)) + "-", 40, LEFT%" + LOCALS, 1
	CASE "依頼報告"
		CALL LAYER_SET, @"　%GET_NAME("物品", GET_REQ(ARG, "ID")),22,LEFT%[{MATCH(ITEMCHOICE, 1),4}/{GET_REQ(ARG, "個数"),4}]", 1
	CASE "物品选择"
		CALL LAYER_SET, @"　%"物品选择" + @" [{1 + PAGE}～ {PAGE + 显示数}]",65,LEFT%" + LOCALS, 1
	CASE "制造霍姆克鲁斯"
		CALLFORM HOMU_NAME_{MIXITEM}
		LOCALS '= @"　%RESULTS,34,LEFT%[{MATCH(ITEMCHOICE, 1)}/{MIXNUM}]"
		SIF ARG == 3
			LOCALS += @"%"",8%※アーティファクトを追加しなくてもホムンクルスの作成は可能です"
		CALL LAYER_SET, LOCALS, 1
ENDSELECT
CALL LAYER_DRAWLINE, 2

;-------------------------------------------------------
;メイン表示欄
;-------------------------------------------------------
LAYER_X = 0
LAYER_Y = 3

IF GROUPMATCH(ARGS, "出售", "量販店登録")
	CALL LAYER_SET, @"┌%"─"*11%┬─┬──┬─┬────┬%"─"*37%┐", LAYER_Y, LAYER_X
ELSE
	CALL LAYER_SET, @"┌%"─"*11%┬─┬──┬─┬%"─"*42%┐", LAYER_Y, LAYER_X
ENDIF

LOCALS '= "│" + ADD_BTAG(@"%"名前",22,LEFT%", "排序_名前", "名前で排序")
LOCALS += "│" + ADD_BTAG("Qu", "排序_クオリティ", "クオリティで排序")
LOCALS += "│" + ADD_BTAG("品质", "排序_品質", "品質で排序")
LOCALS += "│" + ADD_BTAG("Lv", "排序_等级", "等级で排序")
SIF GROUPMATCH(ARGS, "出售", "量販店登録")
	LOCALS += "│" + ADD_BTAG("价格" + " " * 4, "排序_価格", "価格で排序")
CALL WINDOWPRINT, @"│"
IF GROUPMATCH(ARGS, "出售", "量販店登録")
	LOCALS += "│" + ADD_BTAG(@"%"特性", 74, LEFT%", "排序_特性", "特性で排序")
ELSE
	LOCALS += "│" + ADD_BTAG(@"%"特性", 84, LEFT%", "排序_特性", "特性で排序")
ENDIF
LOCALS += "│"

CALL LAYER_SET, LOCALS, LAYER_Y + 1, LAYER_X

LOCALS '= "├" + ADD_BTAG("─"*11, "点击_4")
IF GROUPMATCH(ARGS, "出售", "量販店登録")
	LOCALS += @"┼─┼──┼─┼────┼%"─"*37%┤"
ELSE
	LOCALS += @"┼─┼──┼─┼%"─"*42%┤"
ENDIF
CALL LAYER_SET, LOCALS, LAYER_Y + 2, LAYER_X

FOR LOCAL, PAGE, PAGE + 显示数
	;表示物がない
	IF ITEMLIST:LOCAL < 0 || GET_ITEMDATA(ITEMLIST:LOCAL, "ID") < 0
		IF  GROUPMATCH(ARGS, "出售", "量販店登録")
			CALL LAYER_SET, @"│%"",22,LEFT%│  │　　│　│　　　　│%"",74,LEFT%│", LAYER_Y + 3 + LOCAL - PAGE, LAYER_X
		ELSE
			CALL LAYER_SET, @"│%"",22,LEFT%│  │　　│　│%"",84,LEFT%│", LAYER_Y + 3 + LOCAL - PAGE, LAYER_X
		ENDIF
	ELSE
		ITEMNUM = ITEMLIST:LOCAL
		;基本色の設定
		IF PICKUP_PROP:PICKUP_PROP_COUNT == "不良"
			L_PROP_COLOR = COLOR("p-red")
		ELSE
			L_PROP_COLOR = COLOR("p-blue")
		ENDIF
		IF ITEMCHOICE:ITEMNUM
			IF NUM == LOCAL && !FLAG:鼠标模式
				L_DEF_COLOR = COLOR("p-green", 50)
				IF PICKUP_PROP:PICKUP_PROP_COUNT == "不良"
					L_PROP_COLOR = COLOR("p-red", 50)
				ELSE
					L_PROP_COLOR = COLOR("p-blue", 50)
				ENDIF
			ELSE
				L_DEF_COLOR = COLOR("p-green")
			ENDIF
		ELSEIF NUM == LOCAL && !FLAG:鼠标模式
			L_DEF_COLOR = COLOR("FOCUS")
		ELSE
			L_DEF_COLOR = COLOR("DEF")
		ENDIF
		LOCALS = 
		IF NUM == LOCAL
			LOCALS += "*"
		ELSE
			LOCALS += " "
		ENDIF
		IF GET_ITEMDATA(ITEMNUM, "使用次数") > 0
			LOCALS += FORMCELL(GET_ITEMNAME(ITEMNUM), 16, "LEFT")
			LOCALS += @"[{GET_ITEMDATA(ITEMNUM, "使用次数")}/{GET_ITEMDATA(ITEMNUM, "使用次数上限")}]" + "│"
		ELSE
			LOCALS += @"%GET_ITEMNAME(ITEMNUM),21,LEFT%" + "│"
		ENDIF
		LOCALS += @"%AUTO_SPLIT("E/D/C/B/A/S", "/", GET_ITEMDATA(ITEMNUM, "质量")),2%"
		LOCALS += @"│{GET_ITEMDATA(ITEMNUM, "品质"),4}"
		LOCALS += @"│{GET_ITEMDATA(ITEMNUM, "等级"),2}"
		SIF ARGS == "出售"
			LOCALS += @"│{GET_SELL_PRICE(ITEMNUM),8}"
		SIF ARGS == "量販店登録"
			LOCALS += @"│{GET_ITEMDATA(ITEMNUM, "贩卖价格"),8}"
		LOCALS '= ADD_FTAG(LOCALS, L_DEF_COLOR)
		L_PROPERTY = 
		LOCAL:2 = 0
		FOR LOCAL:1, 0, 5
			TEMP = GET_ITEMDATA(ITEMNUM, @"特性{LOCAL:1}")
			IF GET_ITEMDATA(ITEMNUM, @"特性{LOCAL:1}") > 0
				SIF LOCAL:2++
					L_PROPERTY += " "
				SELECTCASE PICKUP_PROP:PICKUP_PROP_COUNT
					CASE "通常"
						TEMP = GET_ITEMDATA(ITEMNUM, @"特性{LOCAL:1}") < 400
					CASE "调教"
						TEMP = INRANGE(GET_ITEMDATA(ITEMNUM, @"特性{LOCAL:1}"), 400, 1299)
					CASE "特征"
						TEMP = GET_ITEMDATA(ITEMNUM, @"特性{LOCAL:1}") >= 1300
					CASE "不良"
						TEMP = PROPERTYCOST:GET_ITEMDATA(ITEMNUM, @"特性{LOCAL:1}") < 0
					CASEELSE
						TEMP = 0
				ENDSELECT
				L_PROPERTY += ADD_FTAG("[" + GET_ITEMNAME_P(ITEMNUM, LOCAL:1) + "]", TEMP ? L_PROP_COLOR # L_DEF_COLOR)
			ENDIF
		NEXT
		L_PROPERTY '= "│" + HTML_TAGADDFORM(L_PROPERTY, (GROUPMATCH(ARGS, "出售", "量販店登録")  ? 74 # 84), "LEFT")
		LOCALS += L_PROPERTY
		LOCALS '= ADD_BTAG(LOCALS, @"物品_{LOCAL}")
		CALL LAYER_SET, "│" + LOCALS + "│", LAYER_Y + 3 + LOCAL - PAGE, LAYER_X
	ENDIF
NEXT
LOCALS '= "└" + ADD_BTAG("─" * 11, "点击_6")
IF GROUPMATCH(ARGS, "出售", "量販店登録")
	LOCALS += @"┴─┴──┴─┴────┴%"─"*37%┘"
ELSE
	LOCALS += @"┴─┴──┴─┴%"─"*42%┘"
ENDIF
CALL LAYER_SET, LOCALS, LAYER_Y + 显示数 + 3, LAYER_X
;-------------------------------------------------------
;サブ表示欄
;-------------------------------------------------------
LAYER_X = 0
LAYER_Y = LAYER_Y + 显示数 + 4

LINE:1 = LINECOUNT
;ITEMNUM = ITEMLIST:(NUM + PAGE)
ITEMNUM = ITEMLIST:NUM
IF ARGS == "调合"
	CALL LAYER_SET, @"┌%"─"*6%┬%"─"*11%┬%"─"*42%┐", LAYER_Y, LAYER_X
	LOCALS = │%"效果", 12,LEFT%
	CALL GET_CATEGORY_VAR
	目录值 = RESULT:ARG
	VARSET RESULT, 999, 0, 6
	TRYCCALLFORM ITEM_EFFECT_{ARG}_{MIXITEM}
		LOCALS += "│"
		目录閾值 = 0, RESULT * 4 / 5, RESULT:1 * 4 / 5, RESULT:2 * 4 / 5, RESULT:3 * 4 / 5, 999
		SELECTCASE 目录值 * 4 / 5
			CASE IS >= 目录閾值:4
				LOCAL:3 = -1
			CASE IS >= 目录閾值:3
				LOCAL:3 = 2
			CASE IS >= 目录閾值:2
				LOCAL:3 = 1
			CASE IS >= 目录閾值:1
				LOCAL:3 = 0
			CASEELSE
				LOCAL:3 = -1
		ENDSELECT
		IF LOCAL:3 >= 0 && AUTO_SPLIT(RESULTS, "/", LOCAL:3) != ""
			IF GET_KNOWN_ITEM(MIXITEM, @"主效果{ARG}{LOCAL:3}")
				LOCALS += ADD_BTAG(@"%AUTO_SPLIT(RESULTS, "/", LOCAL:3),22,LEFT%", "效果解说_" + AUTO_SPLIT(RESULTS, "/", LOCAL:3))
			ELSE
				LOCALS += @"%"????", 22, LEFT%"
			ENDIF
		ELSE
			LOCALS+= " " * 22
		ENDIF
		LOCALS += "│　"
		LOCAL:2 = 目录值 * 4 / 5
		FOR LOCAL:1, 1, 81
			SELECTCASE LOCAL:1
				CASE LOCAL:2
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("yellow"))
				CASE IS >= 目录閾值:4
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("gray"))
				CASE IS >= 目录閾值:3
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("赤", !INRANGE(LOCAL:2, 目录閾值:3, 目录閾值:4 -1)))
				CASE IS >= 目录閾值:2
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("緑", !INRANGE(LOCAL:2, 目录閾值:2, 目录閾值:3 -1)))
				CASE IS >= 目录閾值:1
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("青", !INRANGE(LOCAL:2, 目录閾值:1, 目录閾值:2 -1)))
				CASEELSE
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("gray"))
			ENDSELECT
		NEXT
		LOCALS += "　"
	CATCH
		LOCALS += @"│%"",22%│%"",84%"
	ENDCATCH
	LOCALS += "│"
	CALL LAYER_SET, LOCALS, LAYER_Y + 1, LAYER_X
	CALL LAYER_SET, @"├%"─"*6%┴%"─"*11%┴%"─"*42%┤", LAYER_Y + 2, LAYER_X
	CALL SET_PROPERTY_LIST, MIXITEM
	CALL SHOW_PROPERTY_LIST, P_PAGE, 1
	FOR LOCAL, 0, 4
		CALL LAYER_SET, HTML_GETPRINTEDSTR(4 - LOCAL), LAYER_Y + 3 + LOCAL, LAYER_X
	NEXT
	CLEARLINE 4
	LOCALS '= @"└%"─"*51%"
	LOCALS += ADD_BTAG("[q] " + UNICODE(0x25C0), "q")
	LOCALS += @" PAGE.{P_PAGE,2} "
	LOCALS += ADD_BTAG(UNICODE(0x25B6) + " [w]", "w")
	LOCALS += " ┘"
	CALL LAYER_SET, LOCALS, LAYER_Y + 7, LAYER_X
	LAYER_Y = LAYER_Y + 8
ELSEIF ARGS == "制造霍姆克鲁斯"
	CALL SET_PROPERTY_LIST, MIXITEM
	CALL SHOW_HOMU_MAXABL, MIXITEM, LAYER_Y, LAYER_X
	CALL SHOW_HOMU_FEATURE, , LAYER_Y + 5, LAYER_X
	CALL SHOW_HOMU_TALENT, LAYER_Y + 9, LAYER_X
	CALL GET_CATEGORY_VAR
	LOCAL:1 = RESULT
	CALLFORM HOMU_EFFECT_1
	CALL LAYER_SET, @"┌%"─"*7%%("┬"+"─"*17)*3%┐", LAYER_Y + 16, LAYER_X
	LOCALS '= @"│%"特征候補",14,LEFT%"
	FOR LOCAL, 0, 3
		LOCALS += "│"
		LOCALS += ADD_FTAG(@"%AUTO_SPLIT(RESULTS, "/", LOCAL),34,LEFT%", INRANGE(LOCAL:1, RESULT:LOCAL, RESULT:(LOCAL+1)-1) ? COLOR("p-blue") # COLOR("DEF"))
	NEXT
	CALL LAYER_SET, LOCALS + "│", LAYER_Y + 17, LAYER_X
	CALL LAYER_SET, @"└%"─"*7%%("┴"+"─"*17)*3%┘", LAYER_Y + 18, LAYER_X
	LAYER_Y = LAYER_Y + 19
ELSEIF ARGS == "装备调合"
	CALL LAYER_SET, @"┌%"─"*6%┬%"─"*11%┬%"─"*42%┐",  LAYER_Y, LAYER_X
	LOCALS '= @"│ %"效果", 11,LEFT%"
	目录值 = 0
	FOR LOCAL, GET_ITEM_RANGE(ARGS:1), GET_ITEM_RANGE(ARGS:1, 1)
		SIF ITEMCHOICE:LOCAL
			目录值 += (GET_ITEMDATA(LOCAL, "品质") + GET_ITEMDATA(LOCAL, "消耗加成值")) / ((MATCH(ITEMCHOICE, 1) == 2) + 1)
	NEXT
	VARSET RESULT, 999, 0, 6
	TRYCCALLFORM ITEM_EFFECT_0_{ARG}
		目录閾值 = 0, RESULT * 4 / 5, RESULT:1 * 4 / 5, RESULT:2 * 4 / 5, RESULT:3 * 4 / 5, 999
		SELECTCASE 目录值 * 4 / 5
			CASE IS >= 目录閾值:4
				LOCAL:3 = -1
			CASE IS >= 目录閾值:3
				LOCAL:3 = 2
			CASE IS >= 目录閾值:2
				LOCAL:3 = 1
			CASE IS >= 目录閾值:1
				LOCAL:3 = 0
			CASEELSE
				LOCAL:3 = -1
		ENDSELECT
		LOCALS += "│"
		IF LOCAL:3 >= 0 && AUTO_SPLIT(RESULTS, "/", LOCAL:3) != ""
			IF GET_KNOWN_ITEM(ARG, @"主效果0{LOCAL:3}")
				LOCALS += ADD_BTAG(@"%AUTO_SPLIT(RESULTS, "/", LOCAL:3),22,LEFT%", "效果解说_" + AUTO_SPLIT(RESULTS, "/", LOCAL:3))
			ELSE
				LOCALS += @"%"????", 22, LEFT%"
			ENDIF
		ELSE
			LOCALS += " " * 22
		ENDIF
		LOCALS += "│　"
		LOCAL:2 = 目录值 * 4 / 5
		FOR LOCAL:1, 1, 81
			SELECTCASE LOCAL:1
				CASE LOCAL:2
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("yellow"))
				CASE IS >= 目录閾值:4
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("gray"))
