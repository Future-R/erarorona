;
;	Modification Data:非調教時に角色クターに対してアイテムを使うための関数
;
;
;	Edit	Date				Author		Ver			Reason	
;	001		2012/07/29			kap			0.300		新規作成
;	002		2012/08/01			kap			0.300		体力変動のタイミングを最大值変動を見越して最後に移動
;	003		2012/09/18			kap			0.363		特性番号を見るべきところで、主效果番号を見ていたのを修正
;	004		2012/09/24			kap			0.380		メッセージウィンドウの点击はに拡張に対応
;---------------------------------------------------------------------
;@USE_ITEM
;ARG	アイテム番号
;---------------------------------------------------------------------
@USE_ITEM, ARG, CHARA = -2, ARGS = "使用物品", ARGS:1 = "持有物品"
#LOCALSIZE 2
#LOCALSSIZE 20
#DIMS MESSAGE, 5
#DIM LINE, 2
#DIM CHARA
LINE = LINECOUNT
IF CHARA == -2
	CALL SHOW_CHARALIST, "使用物品", , , ARG
	SIF RESULT == 1000
		RETURN 0
	CHARA = RESULT
ENDIF
IF CHARA >= 0
	;数值変動系は一度変数にとるのでここでリセット
	VARSET DOWNBASE:CHARA:0
	VARSET CUP:CHARA:0
ENDIF
TRYCALLFORM ITEM_ACT_{GET_ITEMDATA(ARG, "ID")}, ARG, CHARA, MASTER
FOR LOCAL, 0, 4
	TRYCALLFORM EFFECT_ACT_{GET_ITEMDATA(ARG, @"主效果{LOCAL}")}, ARG, CHARA, MASTER
NEXT

FOR LOCAL, 0, 5
	TRYCALLFORM PROPERTY_ACT_{GET_ITEMDATA(ARG, @"特性{LOCAL}")}, ARG, CHARA, MASTER
NEXT

LOCALS = 
RESULTS = 
TRYCCALLFORM ITEM_MESSAGE_{GET_ITEMDATA(ARG, "ID")}, ARG, CHARA, MASTER
	LOCALS += "/" + RESULTS
CATCH
	CALLFORM ITEM_TYPE_{GET_ITEMDATA(ARG, "ID")}
	SELECTCASE RESULTS
		CASE "料理"
			IF CHARA == MASTER
				LOCALS += "/" + CALLNAME:CHARA + "吃了" + GET_ITEMNAME(ARG) + "。"
			ELSE
				LOCALS += "/" + CALLNAME:CHARA + "被喂食了" + GET_ITEMNAME(ARG) + "。"
			ENDIF
	ENDSELECT
ENDCATCH

IF CHARA >= 0
	;体力・气力・魔力のメッセージ追加
	FOR LOCAL, 0, 300
		SIF !DOWNBASE:CHARA:LOCAL
			CONTINUE
		IF DOWNBASE:CHARA:LOCAL > 0
			LOCALS += "/" + CALLNAME:CHARA + "的" + BASENAME:LOCAL + "减少了" + TOSTR(DOWNBASE:CHARA:LOCAL) + "。"
		ELSE
			LOCALS += "/" + CALLNAME:CHARA + "的" + BASENAME:LOCAL + "恢复了" + TOSTR(ABS(DOWNBASE:CHARA:LOCAL)) + "。"
		ENDIF
	NEXT
ENDIF

;主效果と特性のメッセージ追加
FOR LOCAL, 0, 4
	RESULTS = 
	TRYCALLFORM EFFECT_MESSAGE_{GET_ITEMDATA(ARG, @"主效果{LOCAL}")}, ARG, CHARA, MASTER
	LOCALS += "/" + RESULTS
NEXT

FOR LOCAL, 0, 5
	RESULTS = 
	TRYCALLFORM PROPERTY_MESSAGE_{GET_ITEMDATA(ARG, @"主效果{LOCAL}")}, ARG, CHARA, MASTER
	LOCALS += "/" + RESULTS
NEXT
IF CHARA >= 0
	;体力・气力の処理(最大值が変動するので遅らせる)
	FOR LOCAL, 0, 300
		SIF !DOWNBASE:CHARA:LOCAL
			CONTINUE
		BASE:CHARA:LOCAL = LIMIT(BASE:CHARA:LOCAL - DOWNBASE:CHARA:LOCAL, 1, GET_MAXBASE(LOCAL, CHARA))
	NEXT
ENDIF
CALL SET_ITEMDATA(ARG, "使用次数", GET_ITEMDATA(ARG, "使用次数") - 1)
IF GET_ITEMDATA(ARG, "使用次数") <= 0
	ITEMCHOICE:ARG = 1
	CALL DEL_CHOICE_ITEM, ARGS, ARGS:1
	ITEMCHOICE:ARG = 0
ENDIF
VARSET MESSAGE
SPLIT SUBSTRING(LOCALS, 1), "/", LOCALS
FOR LOCAL, 0, RESULT
	SIF LOCALS:LOCAL == ""
		BREAK
	MESSAGE:(LOCAL / 4) += LOCALS:LOCAL
	SIF LOCAL % 4 < 3
		MESSAGE:(LOCAL / 4) += "/"
NEXT
LINE:1 = LINECOUNT
CALL SHOW_BLANK
FOR LOCAL, 0 , 5
	SIF MESSAGE:LOCAL == ""
		BREAK
	CLEARLINE LINECOUNT - LINE
	CALL MESSAGE_WINDOW, "", MESSAGE:LOCAL
NEXT
RETURN 1

@USE_ITEM_UP
PRINTL 
DRAWLINE
PRINTFORML 　%SHOW_DAY()%
@USE_ITEM_ABLE, ARG
RETURN 1
