@ITEM_NAME_41
RESULTS = 泥头菇

@ITEM_CATEGORY_41, ARG
SELECTCASE GET_NAME("分类", ARG)
	CASE "中和剂"
		RETURN 50
	CASE "食材•蔬菜"
		RETURN 20
	CASE "蘑菇"
		RETURN 0
	CASE "植物类"
		RETURN 0
	CASEELSE
		RETURN -1
ENDSELECT

@ITEM_LV_41
RETURN 2

@ITEM_EXPLAIN_41, ARG
IF ARG
	RESULTS = 地中で成長し、上を通りかかると突然顔を出す性質を持つキノコ。
ELSE
	RESULTS = 生长在树根处的蘑菇。/在地下生长，当动物经过时，会突然从土里露出脸来吓人。/采集的时候要注意不要不小心摔倒。
ENDIF

@ITEM_PRICE_41
RETURN 4
