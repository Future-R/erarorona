		RETURN 50
	CASE "调味料"
		RETURN 40
	CASE "蘑菇"
		RETURN 10
	CASEELSE
		RETURN -1
ENDSELECT

@ITEM_LV_42
RETURN 1

@ITEM_EXPLAIN_42, ARG
