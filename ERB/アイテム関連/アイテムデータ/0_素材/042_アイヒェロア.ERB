@ITEM_NAME_42
RESULTS = 橡树菇

@ITEM_CATEGORY_42, ARG
;分类ー值
SELECTCASE GET_NAME("分类", ARG)
	CASE "中和剂"
		RETURN 50
	CASE "调味料"
		RETURN 40
	CASE "蘑菇"
		RETURN 10
	CASEELSE
		RETURN -1
ENDSELECT

@ITEM_LV_42
RETURN 1

@ITEM_EXPLAIN_42, ARG
IF ARG
	RESULTS = 随处可见的蘑菇。不太适合食用。
ELSE
	RESULTS = 一种蘑菇，生长在各种地方。/街道外自不必说，即使在有点脏的房间壁橱里也能看到。/因为茎部的纤维很硬，所以不太适合食用。
ENDIF

@ITEM_PRICE_42
RETURN 8
	