		RETURN 30
	CASE "万灵药"
		RETURN 10
	CASE "毒性材料"
		RETURN 0
	CASE "中和剂"
		RETURN 50
	CASE "怪物素材"
		RETURN 10
	CASEELSE
		RETURN -1
ENDSELECT

