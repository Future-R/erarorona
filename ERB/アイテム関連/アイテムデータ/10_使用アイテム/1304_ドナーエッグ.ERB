@COM_ACT_1304, ARG, ARG:1, ARG:2

@MESSAGE_COM_1304, ARG, ARG:1, ARG:2
RESULTS = 在%CALLNAME:ARG%
IF ITEM_BRUNCH:(ARG:2) == 0
	;男性＋欲情のLV3以上
	IF IS_MALE(TARGET)
		SIF 欲情等级(ARG) >= 3
			RESULTS += "坚挺勃起的"
		RESULTS +=  "阴茎上"
	;扶她＋欲情のPALAMLV3以上
	ELSEIF HAVE_BODY("阴茎", ARG)
		SIF 欲情等级(ARG) >= 3
			RESULTS +=  "泥泞的"
		RESULTS +=  "秘唇上"
	ELSE
	;欲情のPALAMLV3以上
		SIF 欲情等级(ARG) >= 3
			RESULTS += "坚挺突起的"
		RESULTS += "阴蒂上"
	ENDIF
	RESULTS += "压上了振动着的电导之蛋……"
ELSE
	;欲情のPLAMLV3以上
	SIF 欲情等级(ARG) >= 3
		RESULTS +=  "期待得坚挺突起的"
	RESULTS += "乳头上压上了振动着的电导之蛋……"
ENDIF
