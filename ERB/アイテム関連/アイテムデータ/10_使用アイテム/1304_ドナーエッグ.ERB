@COM_ACT_1304, ARG, ARG:1, ARG:2

@MESSAGE_COM_1304, ARG, ARG:1, ARG:2
RESULTS = %CALLNAME:ARG%の
IF ITEM_BRUNCH:(ARG:2) == 0
	;男性＋欲情のLV3以上
	IF IS_MALE(TARGET)
		SIF 欲情等级(ARG) >= 3
			RESULTS += "硬くそそり勃った"
		RESULTS +=  "ペニスに"
	;扶她＋欲情のPALAMLV3以上
	ELSEIF HAVE_BODY("阴茎", ARG)
		SIF 欲情等级(ARG) >= 3
			RESULTS +=  "ぬかるんだ"
		RESULTS +=  "秘唇に"
	ELSE
	;欲情のPALAMLV3以上
		SIF 欲情等级(ARG) >= 3
			RESULTS += "硬く尖った"
		RESULTS += "クリトリスに"
	ENDIF
	RESULTS += "震えるドナーエッグを押し当てた……"
ELSE
	;欲情のPLAMLV3以上
	SIF 欲情等级(ARG) >= 3
		RESULTS +=  "期待に硬く尖った"
	RESULTS += "乳首に震えるドナーエッグを押し当てた……"
ENDIF
