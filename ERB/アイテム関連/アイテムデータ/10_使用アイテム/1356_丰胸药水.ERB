RETURN 1

;------------------------------------------------------------
;使用时效果
;------------------------------------------------------------
@ITEM_ACT_1356, ARG, ARG:1, ARG:2
#LOCALSIZE 2
; 丰胸一级：贫乳→移除（变普通） / 无特质→巨乳 / 已有巨乳→不变
LOCAL = GETNUM(TALENT, "贫乳")
LOCAL:1 = GETNUM(TALENT, "巨乳")
IF TALENT:(ARG:1):LOCAL
	; 有贫乳 → 移除贫乳（变为普通）
	TALENT:(ARG:1):LOCAL = 0
ELSEIF TALENT:(ARG:1):(LOCAL:1) == 0
	; 无任何罩杯特质 → 赋予巨乳
	TALENT:(ARG:1):(LOCAL:1) = 1
ENDIF

@ITEM_MESSAGE_1356, ARG, ARG:1, ARG:2
#LOCALSIZE 2
LOCAL = GETNUM(TALENT, "巨乳")
LOCAL:1 = GETNUM(TALENT, "贫乳")
IF TALENT:(ARG:1):LOCAL
	RESULTS = %CALLNAME:(ARG:1)%饮下了丰胸药水，胸部变得丰满了……！
ELSEIF TALENT:(ARG:1):(LOCAL:1) == 0
	RESULTS = %CALLNAME:(ARG:1)%饮下了丰胸药水，胸部恢复到了普通大小。
ELSE
	RESULTS = %CALLNAME:(ARG:1)%饮下了丰胸药水，但似乎没有发生变化……
ENDIF
