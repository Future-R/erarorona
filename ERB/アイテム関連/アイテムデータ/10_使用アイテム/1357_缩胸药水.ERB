@ITEM_MP_1357
RETURN 5

@ITEM_COUNT_1357
RETURN 3

@ITEM_PRICE_1357
RETURN 240

@ITEM_USE_ABLE_1357
RETURN 1

;------------------------------------------------------------
;使用时效果
;------------------------------------------------------------
@ITEM_ACT_1357, ARG, ARG:1, ARG:2
#LOCALSIZE 2
; 缩胸一级：巨乳→移除（变普通） / 无特质→贫乳 / 已有贫乳→不变
LOCAL = GETNUM(TALENT, "巨乳")
LOCAL:1 = GETNUM(TALENT, "贫乳")
IF TALENT:(ARG:1):LOCAL
	; 有巨乳 → 移除巨乳（变为普通）
	TALENT:(ARG:1):LOCAL = 0
ELSEIF TALENT:(ARG:1):(LOCAL:1) == 0
	; 无任何罩杯特质 → 赋予贫乳
	TALENT:(ARG:1):(LOCAL:1) = 1
ENDIF

@ITEM_MESSAGE_1357, ARG, ARG:1, ARG:2
#LOCALSIZE 2
LOCAL = GETNUM(TALENT, "贫乳")
LOCAL:1 = GETNUM(TALENT, "巨乳")
IF TALENT:(ARG:1):LOCAL
	RESULTS = %CALLNAME:(ARG:1)%饮下了缩胸药水，胸部变得小巧了……！
ELSEIF TALENT:(ARG:1):(LOCAL:1) == 0
	RESULTS = %CALLNAME:(ARG:1)%饮下了缩胸药水，胸部恢复到了普通大小。
ELSE
	RESULTS = %CALLNAME:(ARG:1)%饮下了缩胸药水，但似乎没有发生变化……
ENDIF
