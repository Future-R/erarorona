@EFFECT_NAME_241
RESULTS = 凛々しい力

@EFFECT_EXPLAIN_241
RESULTS = 一時的にモノが生えてくる…

@EFFECT_MESSAGE_241, ARG, ARG:1, ARG:2
RESULTS = 次回の調教でペニスを使用することができます。

;----------------------------------
;ARG　	物品登録番号
;ARG;1	使用対象
;ARG:2	使用者
;----------------------------------
@EFFECT_ACT_241, ARG, ARG:1, ARG:2
#LOCALSIZE 1
CALL GET_EFFECT_POWER, ARG, ARG:1, ARG:2
RESULT = 60 * RESULT / 100 - 100
SIF RESULT == 0
	RESULT = 1
IF !CFLAG:(ARG:1):蘑菇之力
	CFLAG:(ARG:1):蘑菇之力 = 1
ELSE
	CFLAG:(ARG:1):蘑菇之力 = MAX(CFLAG:(ARG:1):蘑菇之力, RESULT)
ENDIF
