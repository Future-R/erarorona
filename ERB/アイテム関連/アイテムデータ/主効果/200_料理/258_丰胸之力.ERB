@EFFECT_NAME_258
RESULTS = 丰胸之力

@EFFECT_EXPLAIN_258
RESULTS = 胸部变大了一级……

@EFFECT_MESSAGE_258, ARG, ARG:1, ARG:2
#LOCALSIZE 2
LOCAL = GETNUM(TALENT, "巨乳")
LOCAL:1 = GETNUM(TALENT, "贫乳")
IF TALENT:(ARG:1):LOCAL
	RESULTS = %CALLNAME:(ARG:1)%的胸部变得丰满了……！
ELSEIF TALENT:(ARG:1):(LOCAL:1) == 0
	RESULTS = %CALLNAME:(ARG:1)%的胸部恢复到了普通大小。
ELSE
	RESULTS = %CALLNAME:(ARG:1)%的胸部似乎没有发生变化……
ENDIF

@EFFECT_ACT_258, ARG, ARG:1, ARG:2
#LOCALSIZE 2
; 丰胸一级：贫乳→移除（变普通） / 无罩杯→巨乳 / 已有巨乳→不变
LOCAL = GETNUM(TALENT, "贫乳")
LOCAL:1 = GETNUM(TALENT, "巨乳")
IF TALENT:(ARG:1):LOCAL
	TALENT:(ARG:1):LOCAL = 0
ELSEIF TALENT:(ARG:1):(LOCAL:1) == 0
	TALENT:(ARG:1):(LOCAL:1) = 1
ENDIF