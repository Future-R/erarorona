@EFFECT_ACT_627, ARG, ARG:1, ARG:2
#LOCALSIZE 2
CALL GET_EFFECT_POWER, ARG, ARG:1, ARG:2
LOCAL:1 = RESULT * 50 / 100
FOR LOCAL, 0, 6
	TCVAR:(ARG:1):(AUTO_SPLIT("手活/口活/性交/施虐/受虐/诱惑", "/", LOCAL) + "强化")  = MAX(TCVAR:(ARG:1):(AUTO_SPLIT("手活/口活/性交/施虐/受虐/诱惑", "/", LOCAL) + "强化"), LOCAL)
NEXT
