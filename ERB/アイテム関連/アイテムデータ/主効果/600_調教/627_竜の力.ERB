@EFFECT_NAME_627
RESULTS = 竜之力

@EFFECT_EXPLAIN_627
RESULTS = 手活・口活・性交・施虐・受虐・诱惑を一時的にあげる。/效果は连锁结束まで継続する。

@EFFECT_SOURCE_627, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT

@EFFECT_DOWNBASE_627, ARG, ARG:1, ARG:2
