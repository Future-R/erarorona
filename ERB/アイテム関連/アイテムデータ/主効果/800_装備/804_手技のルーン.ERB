@EFFECT_NAME_804
RESULTS = 手技のルーン

@EFFECT_EXPLAIN_804
RESULTS = 手技属性の調教コマンドの効果を強化する。

;装備箇所・装備キャラ
@EFFECT_EQUIP_804, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = 手技強化
	RETURN 30
ENDIF
;EQUIP:ARG:手技強化 += CALCF_EQUIP_POWER(30, ARGS, ARG)

;ARGS	効果名
;ARGS:1	装備箇所あるいは登録アイテム番号
;ARG	装備キャラクター
@EFFECT_EQUIP_STATUS_804, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "手技"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT