@EFFECT_NAME_804
RESULTS = 手活卢恩

@EFFECT_EXPLAIN_804
RESULTS = 手活属性の調教指令の效果を強化する。

;装備箇所・装備角色
@EFFECT_EQUIP_804, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = 手活强化
	RETURN 30
ENDIF
;EQUIP:ARG:手活强化 += CALCF_EQUIP_POWER(30, ARGS, ARG)

;ARGS	效果名
;ARGS:1	装備箇所あるいは登録物品番号
;ARG	装備角色クター
@EFFECT_EQUIP_STATUS_804, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "手活"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT