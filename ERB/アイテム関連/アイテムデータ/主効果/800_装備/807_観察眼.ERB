@EFFECT_NAME_807
RESULTS = 观察力

@EFFECT_EXPLAIN_807
RESULTS = 将调教对象的期望看穿。/强化受虐属性和施虐属性调教指令的效果。

;装備箇所・装備角色
@EFFECT_EQUIP_807, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = ＳＭ强化
	RETURN 30
ENDIF

@EFFECT_EQUIP_STATUS_807, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "施虐", "受虐"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT
