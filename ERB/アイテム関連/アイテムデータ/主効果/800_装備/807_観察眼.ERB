@EFFECT_NAME_807
RESULTS = 観察眼

@EFFECT_EXPLAIN_807
RESULTS = 調教相手の望みを見抜く。/被虐属性と加虐属性の調教コマンドの效果を強化する。

;装備箇所・装備角色
@EFFECT_EQUIP_807, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = ＳＭ強化
	RETURN 30
ENDIF

@EFFECT_EQUIP_STATUS_807, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "加虐", "被虐"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT
