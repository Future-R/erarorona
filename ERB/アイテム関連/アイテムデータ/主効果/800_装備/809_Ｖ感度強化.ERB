@EFFECT_NAME_809
RESULTS = Ｖ感度強化

@EFFECT_EXPLAIN_809
RESULTS = Ｖ感度を強化する。

;装備箇所・装備角色
@EFFECT_EQUIP_809, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = Ｖ感度強化
	RETURN 30
ENDIF

@EFFECT_EQUIP_STATUS_809, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "Ｖ感度"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT