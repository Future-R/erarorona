@EFFECT_NAME_810
RESULTS = Ａ感度強化

@EFFECT_EXPLAIN_810
RESULTS = Ａ感度を強化する。

;装備箇所・装備角色
@EFFECT_EQUIP_810, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = Ａ感度強化
	RETURN 30
ENDIF

@EFFECT_EQUIP_STATUS_810, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "Ａ感度"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT