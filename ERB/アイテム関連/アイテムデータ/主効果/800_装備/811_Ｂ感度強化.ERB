@EFFECT_NAME_811
RESULTS = Ｂ感度强化

@EFFECT_EXPLAIN_811
RESULTS = 强化Ｂ感度。

;装備箇所・装備角色
@EFFECT_EQUIP_811, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = Ｂ感度强化
	RETURN 30
ENDIF

@EFFECT_EQUIP_STATUS_811, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "Ｂ感度"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT