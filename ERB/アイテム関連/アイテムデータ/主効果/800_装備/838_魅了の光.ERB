@EFFECT_NAME_838
RESULTS = 魅了の光

@EFFECT_EXPLAIN_838
RESULTS = 見たものをを魅了する美しさ。/調教相手の[恭順][悦楽]があがりやすくなり、/[反感]があがりにくくなる。

;装備箇所・装備キャラ
@EFFECT_EQUIP_838, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = 魅惑補正
	RETURN 50
ENDIF
EQUIP:ARG:誘惑補正 += CALCF_EQUIP_POWER(50, ARGS, ARG)

@EFFECT_EQUIP_STATUS_838, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "誘惑"
		RETURN CALCF_EQUIP_POWER(50, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT
