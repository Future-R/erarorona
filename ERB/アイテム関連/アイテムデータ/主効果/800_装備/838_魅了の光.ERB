;ARG		アイテムの登録番号
;ARG:1		使用対象
;ARG:2		使用者
;--------------------
@EFFECT_NAME_838
RESULTS = 魅惑之光

@EFFECT_EXPLAIN_838
RESULTS = 让人一见倾心的美丽。/调教对象的[恭顺]和[愉悦]变得容易上升，/[反感]变得难以上升。

;装備箇所・装備角色
@EFFECT_EQUIP_838, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = 魅惑加成
	RETURN 50
ENDIF
EQUIP:ARG:诱惑加成 += CALCF_EQUIP_POWER(50, ARGS, ARG)

@EFFECT_EQUIP_STATUS_838, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "诱惑"
		RETURN CALCF_EQUIP_POWER(50, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT
