;ARG		アイテムの登録番号
;ARG:1		使用対象
;ARG:2		使用者
;--------------------
@PROPERTY_NAME_TALENT, ARG
RESULTS = %TALENTNAME:PROPERTY_NUM_TALENT(ARG)%
SIF RESULTS != ""
	RESULTS += "Lv" + TOSTR(RESULT:1 + 1)

;コスト等级
@PROPERTY_COST_TALENT, ARG
#LOCALSIZE 2
RETURN GET_TALENT_COST(PROPERTY_NUM_TALENT(ARG), RESULT:1 + 1)

;特性效果
@PROPERTY_EFFECT_TALENT, ARG
RETURN 0

@PROPERTY_RIZE_QUALITY_TALENT, ARG
RETURN 0

;継承タイプ
@PROPERTY_SUCCESSION_TALENT, ARG
RESULTS = 调合/ホムンクルス

;特性效果
@PROPERTY_PRICE_TALENT, ARG
RETURN 20

;特性の解説
@PROPERTY_EXPLAIN_TALENT, ARG
#LOCALSSIZE 1
CALLFORM TALENT_EXPLAIN_%TALENTNAME:PROPERTY_NUM_TALENT(ARG)%
;RESULTS = 素質[%LOCALS%Lv{RESULT:1 + 1}]を付与する。/%RESULTS%

;LOCALでLvも返しておく
@PROPERTY_OFFSET_TALENT, ARG
#LOCALSSIZE 1
LOCALS = %TALENTNAME:PROPERTY_NUM_TALENT(ARG)%
LOCAL = RESULT:1
VARSET RESULT, 0, 0, 6
TRYCALLFORM TALENT_OFFSET_%LOCALS%
RETURN RESULT, RESULT:1, RESULT:2, RESULT:3, RESULT:4, LOCAL
;特性番号ARGのTALENT番号と、LVを返す
@PROPERTY_NUM_TALENT, ARG
#FUNCTION
RESULT:1 = (ARG - PROPERTY_TALENT_START()) / VARSIZE("TALENT")
RETURNF (ARG - PROPERTY_TALENT_START()) % VARSIZE("TALENT")
