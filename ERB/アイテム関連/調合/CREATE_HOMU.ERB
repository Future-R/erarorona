@CREATE_HOMU_MENU
#LOCALSIZE 3
#DIMS SHOW_MODE, 1
#DIM PAGE, 2
#DIM NUM, 2
#DIM MAXNUM
#DIM TEMP
#DIM LAYER_X
#DIM LAYER_Y

#DIM TEMP_COLOR
#DIM LIST, 100

#DIM 显示数
#DIM C_REDRAW
#DIM LINE,3

VARSET ITEMCHOICE
VARSET MIXLIST
VARSET MIXCHOICE
VARSET P_LIST
显示数 = 18
LINE = LINECOUNT
C_REDRAW = CURRENTREDRAW()
REDRAW 0
VARSET LIST
;リスト作成
LOCAL:1 = 0
FOR LOCAL, 0, 100
	TRYCCALLFORM HOMU_ABLE_{LOCAL}
		SIF !RESULT
			CONTINUE
		LIST:(LOCAL:1) = LOCAL
		LOCAL:1++
	CATCH
	ENDCATCH
NEXT

PAGE = 0
PAGE:1 = 0
NUM = 0
$SHOW_START

CALL INIT_LAYER
LAYER_X = 0
LAYER_Y = 0
CLEARLINE LINECOUNT - LINE
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, " 　制造霍姆克鲁斯", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2

MAXNUM = VARSIZE("LIST") - MATCH(LIST, 0)

CALL LAYER_SET, @"┌%"─"*16%┬%"─"*14%┬%"─"*14%┬%"─"*14%┐", LAYER_Y + 3
CALL LAYER_SET, @"│%"名称",32,LEFT%│%"主素材",28,LEFT%│%"万灵药",28,LEFT%│%"神秘之力",28,LEFT%│", LAYER_Y + 4
CALL LAYER_SET, @"├%"─"*16%┼%"─"*14%┼%"─"*14%┼%"─"*14%┤", LAYER_Y + 5

LAYER_X = 0
LAYER_Y = LAYER_Y + 6

FOR LOCAL, PAGE, PAGE+显示数
	TEMP_COLOR = COLOR("DEF")
	IF !LIST:LOCAL
		LOCALS '= @"│%"",32,LEFT%│%"",28,LEFT%│%"",28,LEFT%│%"",28,LEFT%│"
	ELSE
		LOCALS '= "│"
		IF NUM == LOCAL
			SIF !FLAG:鼠标模式
				TEMP_COLOR = COLOR("FOCUS")
			LOCALS += "*"
		ELSE
			LOCALS += " "
		ENDIF
		CALLFORM HOMU_NAME_{LIST:LOCAL}
		LOCALS += @"%RESULTS, 31, LEFT%"
		LOCALS += "│"
		CALLFORM HOMU_MATERIAL_{LIST:LOCAL}
		LOCALS += @"%GET_NAME("物品", RESULT)+"*2", 28, LEFT%│"
		LOCALS += @"%"【万灵药】*2", 28, LEFT%│"
		LOCALS += @"%"【神秘之力】", 28, LEFT%"
		LOCALS '=  ADD_BTAG(ADD_FTAG(LOCALS, TEMP_COLOR), @"配方_{LOCAL}")
		LOCALS += "│"
	ENDIF
	CALL LAYER_SET, LOCALS, LAYER_Y + LOCAL
NEXT
CALL LAYER_SET, @"└%"─"*16%┴%"─"*14%┴%"─"*14%┴%"─"*14%┘", LAYER_Y + LOCAL

LAYER_Y = LAYER_Y + LOCAL + 1

CALL SHOW_HOMU_MAXABL, LIST:NUM, LAYER_Y, LAYER_X

LAYER_Y = LAYER_Y + 5
CALL LAYER_SET, @"┌%"─"*7%%("┬"+"─"*17)*3%┐", LAYER_Y
LOCALS '= @"│%"特征候补",14,LEFT%"
CALLFORM HOMU_EFFECT_1
FOR LOCAL, 0, 3
	LOCALS += "│"
	LOCALS += @"%AUTO_SPLIT(RESULTS,"/",LOCAL),34,LEFT%"
NEXT
CALL LAYER_SET, LOCALS + "│", LAYER_Y + 1
CALL LAYER_SET, @"└%"─"*7%%("┴"+"─"*17)*3%┘", LAYER_Y + 2
CALL LAYER_DRAWLINE, LAYER_Y + 3
{
	CALL LAYER_SET,
		ADD_BTAG(HTML_ESCAPE(@"%"",5%[1] <<< "), "点击_1") + 
		ADD_BTAG(HTML_ESCAPE(@"%"",5%[4] << ") , "点击_4") + 
		ADD_BTAG(HTML_ESCAPE(@"%"",5%[8] < ")  , "点击_8") + 
		ADD_BTAG(HTML_ESCAPE(@"%"",5%[5] ")    , "点击_5") + 
		ADD_BTAG(HTML_ESCAPE(@"%"",5%[2] >>> "), "点击_2") + 
		ADD_BTAG(HTML_ESCAPE(@"%"",5%[6] >> ") , "点击_6") + 
		ADD_BTAG(HTML_ESCAPE(@"%"",5%[3] > ")  , "点击_3"),
		LAYER_Y + 4
}
CALL LAYER_DRAWLINE, LAYER_Y + 5
LINE:1 = LINECOUNT + LAYER_Y + 5
LAYER_Y = LAYER_Y + 6
CALL LAYER_SET, "", LAYER_Y
CALL LAYER_SET, "", LAYER_Y + 1
CALL LAYER_SET, "", LAYER_Y + 2

CALL LAYER_SET, " " * 5 + ADD_BTAG("[9] 返回", "点击_9"), LAYER_Y + 3
CALL LAYER_PRINT, , MAXLINE()
ONEINPUTS
ENCODETOUNI %RESULTS%
FLAG:鼠标模式 = STRLENS(RESULTS) >= 1
SIF AUTO_SPLIT(RESULTS, "_", 0) == "点击"
	RESULTS '= AUTO_SPLIT(RESULTS, "_", 1)
SELECTCASE AUTO_SPLIT(RESULTS, "_", 0)
	CASE "", "5"
		$CREATE
		IF LIST:NUM > 0
			CALL CREATE_HOMU, LIST:NUM
			IF RESULT == 1
				REDRAW C_REDRAW
				RETURN 1
			ELSEIF RESULT < 0
				; 返回负值表示材料不足，按返回码显示具体缺少项
				CLEARLINE LINECOUNT - LINE:1
				PRINTL
				PRINTL
				IF RESULT == -1
					PRINTL 　　※主素材不足※
				ELSEIF RESULT == -2
					PRINTL 　　※万灵药不足※
				ELSEIF RESULT == -4
					PRINTL 　　※神秘之力不足※
				ELSE
					PRINTL 　　※材料不足※
				ENDIF
				CALL EQUATE_LINE(LINE:1+6)
				WAITANYKEY
			ENDIF
		ENDIF
	CASE "1"
		NUM = LIMIT(PAGE - 显示数 * 4 - 1, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE - 显示数 * 5, 0, MAX(0, MAXNUM - 显示数))
	CASE "4"
		NUM = LIMIT(PAGE - 1, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE - 显示数, 0, MAX(0, MAXNUM - 显示数))
	CASE "8"
		NUM = LIMIT(NUM - 1, 0, MAXNUM - 1)
		SIF PAGE > NUM
			PAGE = LIMIT(PAGE - 1, 0, MAX(0, MAXNUM - 显示数))
	CASE "2"
		NUM = LIMIT(NUM + 1, 0, MAX(0, MAXNUM - 1))
		SIF PAGE + 显示数 - 1 < NUM
			PAGE = LIMIT(PAGE + 1, 0, MAX(0, MAXNUM - 显示数))
	CASE "6"
		NUM = LIMIT(PAGE + 显示数, 0, MAX(0, MAXNUM - 1))
		PAGE = LIMIT(PAGE + 显示数, 0, MAX(0, MAXNUM - 显示数))
	CASE "3"
		NUM = LIMIT(PAGE + 显示数 * 5, 0, MAX(0, MAXNUM - 1))
		PAGE = LIMIT(PAGE + 显示数 * 5 , 0, MAX(0, MAXNUM - 显示数))
	CASE "9"
		REDRAW C_REDRAW
		RETURN 0
	CASE "配方"
		IF NUM == AUTO_SPLIT_INT(RESULTS, "_", 1)
			GOTO CREATE
		ELSE
			NUM = AUTO_SPLIT_INT(RESULTS, "_", 1)
		ENDIF
ENDSELECT
GOTO SHOW_START

@CREATE_HOMU, ARG
#LOCALSSIZE 6
#DIM 主素材,1
#DIM 素材持有数,16
#DIM 判定,3
#DIM LINE,2
#DIM 选择数,4
#DIM CHARA
#DIM LAYER_Y
#DIM LAYER_X
VARSET 选择数
;-------------------------------------------
;リスト作成しつつ可否判定
;-------------------------------------------
;调合リストにビット演算で登録
;MIXLIST予定
CALLFORM HOMU_MATERIAL_{ARG}
主素材 = RESULT
VARSET MIXLIST
FOR LOCAL:1, 0, 4
	FOR LOCAL, 0, 1100
		SIF GET_ITEMDATA(LOCAL, "ID") <= 0
			CONTINUE
		IF LOCAL:1 == 0
			SIF GET_ITEMDATA(LOCAL, "ID") != 主素材
				CONTINUE
		ELSEIF LOCAL:1 == 1
			SIF !GET_CATEGORY(LOCAL, "万灵药")
				CONTINUE
		ELSEIF LOCAL:1 == 2
			SIF !GET_CATEGORY(LOCAL, "神秘之力")
				CONTINUE
		ELSEIF LOCAL:1 == 3
			SIF !GET_CATEGORY(LOCAL, "遗物")
				CONTINUE
		ENDIF
		SETBIT MIXLIST:LOCAL, LOCAL:1
	NEXT
NEXT
;素材持有数登録
;なお複数の素材条件を満たすものはビット演算でまとめる
VARSET 素材持有数, 0
FOR LOCAL, 0, 1100
	SIF MIXLIST:LOCAL
		素材持有数:(MIXLIST:LOCAL)++
NEXT

判定 = 2, 2, 1
判定:0 -= 素材持有数:1
素材持有数:1 = 0
判定:1 -= 素材持有数:2
素材持有数:2 = 0
判定:2 -= 素材持有数:4
素材持有数:4 = 0
WHILE MAXARRAY(判定) > 0
	IF 判定:0 > 0
		SIF 素材持有数:1 + 素材持有数:3 + 素材持有数:5 + 素材持有数:7 <= 0
			; 缺少主素材
			RETURN -1
		IF 素材持有数:3 > 0 && 判定:0 >= 判定:1
			素材持有数:3--
			判定:0--
		ENDIF
		IF 素材持有数:5 > 0 && 判定:0 >= 判定:2
			素材持有数:5--
			判定:0--
		ENDIF
		IF 素材持有数:7 > 0 && 判定:0 >= 判定:1 && 判定:0 >= 判定:2
			素材持有数:7--
			判定:0--
		ENDIF
	ENDIF
	IF 判定:1 > 0
		SIF 素材持有数:2 + 素材持有数:3 + 素材持有数:6 + 素材持有数:7 <= 0
			; 缺少万灵药
			RETURN -2
		IF 素材持有数:3 > 0 && 判定:1 >= 判定:0
			素材持有数:3--
			判定:1--
		ENDIF
		IF 素材持有数:6 > 0 && 判定:1 >= 判定:2
			素材持有数:6--
			判定:1--
		ENDIF
		IF 素材持有数:7 > 0 && 判定:1 >= 判定:0 && 判定:1 >= 判定:2
			素材持有数:7--
			判定:1--
		ENDIF
	ENDIF
	IF 判定:2 > 0
		SIF 素材持有数:4 + 素材持有数:5 + 素材持有数:6 + 素材持有数:7 <= 0
			; 缺少神秘之力
			RETURN -4
		IF 素材持有数:5 > 0 && 判定:2 >= 判定:0
			素材持有数:3--
			判定:2--
		ENDIF
		IF 素材持有数:6 > 0 && 判定:2 >= 判定:1
			素材持有数:6--
			判定:2--
		ENDIF
		IF 素材持有数:7 > 0 && 判定:2 >= 判定:0 && 判定:2 >= 判定:1
			素材持有数:7--
			判定:2--
		ENDIF
	ENDIF
WEND

LINE = LINECOUNT
;MIX_SELECT予定
VARSET MIXCHOICE
LINE = LINECOUNT
$START
CALL INIT_LAYER
LAYER_X = 0
LAYER_Y = 0
CLEARLINE LINECOUNT - LINE
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, " 制造霍姆克鲁斯", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2
;-------------------------------------
;素材欄
;-------------------------------------
LAYER_Y = LAYER_Y + 3
FOR LOCAL, 0 , 4
	LAYER_X = 32 * LOCAL
	LOCAL:1 = AUTO_SPLIT_INT("2_2_1_1", "_", LOCAL) == 选择数:LOCAL ? COLOR("p-blue") # COLOR("DEF")
	CALL LAYER_SET, ADD_FTAG(ADD_BTAG("┌" + "─" * 13 + "┐", TOSTR(LOCAL)), LOCAL:1), LAYER_Y, LAYER_X
	CALL LAYER_SET, ADD_FTAG(ADD_BTAG(@"│ [{LOCAL}]%AUTO_SPLIT(@"%GET_NAME("物品", 主素材)%/【万灵药】/【神秘之力】/【遗物】","/",LOCAL),22,LEFT%│", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 1, LAYER_X
	CALL LAYER_SET, ADD_FTAG(ADD_BTAG("├" + "─" * 13 + "┤", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 2, LAYER_X
	CALL LAYER_SET, ADD_FTAG(ADD_BTAG(@"│%"所需数　" + AUTO_SPLIT("[2]/[2]/[1]/[0]([1])", "/", LOCAL), 26,LEFT%│", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 3, LAYER_X
	CALL LAYER_SET, ADD_FTAG(ADD_BTAG(@"│%"选择数　["+@"{选择数:LOCAL}"+"]",26,LEFT%│", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 4, LAYER_X
	CALL LAYER_SET, ADD_FTAG(ADD_BTAG("└" + "─" * 13 + "┘", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 5, LAYER_X
NEXT
;------------------------------------
;ホムンクルスの予定性能
;------------------------------------
LAYER_X = 0
LAYER_Y = LAYER_Y + 6 + 6
CALL SHOW_HOMU_MAXABL, ARG, LAYER_Y
CALL SHOW_HOMU_FEATURE, ARG, LAYER_Y + 5
CALL SHOW_HOMU_TALENT, LAYER_Y + 9, LAYER_X

LOCAL:1 = RESULT
CALLFORM HOMU_EFFECT_1
CALL LAYER_SET, @"┌%"─"*7%%("┬"+"─"*17)*3%┐", LAYER_Y + 16, LAYER_X
CALL LAYER_SET, @"│%"特征候补",14,LEFT%", LAYER_Y + 17, LAYER_X
CALL GET_CATEGORY_VAR
FOR LOCAL, 0, 3
	CALL LAYER_SET, "│", LAYER_Y + 17
	CALL LAYER_SET, ADD_FTAG(@"%AUTO_SPLIT(RESULTS, "/", LOCAL),34,LEFT%", INRANGE(LOCAL:1, RESULT:LOCAL, RESULT:(LOCAL+1)-1) ? COLOR("p-blue") # COLOR("DEF")), LAYER_Y + 17
NEXT
CALL LAYER_SET, "│", LAYER_Y + 17
CALL LAYER_SET, @"└%"─"*7%%("┴"+"─"*17)*3%┘", LAYER_Y + 18, LAYER_X
LAYER_Y = LAYER_Y + 19
CALL LAYER_DRAWLINE, LAYER_Y
LINE:1 = LINECOUNT + LAYER_Y + 1
IF (选择数:0 == 2) && (选择数:1 == 2) && (选择数:2 == 1)
	CALL LAYER_SET, ADD_BTAG("[En] 制造", "En"), LAYER_Y + 1
ELSE
	CALL LAYER_SET, ADD_FTAG("[En] 制造", COLOR("gray")), LAYER_Y + 1
ENDIF
CALL LAYER_SET, ADD_BTAG("[ 9] 返回", "9"), LAYER_Y + 2
CALL LAYER_PRINT, , MAXLINE()
ONEINPUTS
SELECTCASE AUTO_SPLIT(RESULTS, "_", 0)
	CASE "", "En"
		IF (选择数:0 == 2) && (选择数:1 == 2) && (选择数:2 == 1)
			CLEARLINE LINECOUNT - LINE:1
			CALL INPUT_YN_M, "真的要制造霍姆克鲁斯吗？"
			SIF RESULT
				GOTO START
			;角色クター作成
			ADDVOIDCHARA
			CHARA = CHARANUM - 1
			$NAME_INPUTS
			CLEARLINE LINECOUNT - LINE:1
			;アーティファクトチェック
			LOCAL = FINDELEMENT(MIXCHOICE, 8)
			IF LOCAL >= 0
				CALLFORM ITEM_HOMU_NAME_{GET_ITEMDATA(LOCAL,"ID")}
				LOCALS '= RESULTS, RESULTS:1, RESULTS:2
				CALL MESSAGE_WINDOW, "", @"霍姆克鲁斯的名字是%RESULTS%。"
				CALLNAME:CHARA = %LOCALS%
				NAME:CHARA = %LOCALS:1%
				NICKNAME:CHARA = %LOCALS:2%
				CALLFORM ARTIFACT_EXP_{GET_ITEMDATA(LOCAL,"ID")}
				IF RESULTS != ""
					SPLIT RESULTS, "/", RESULTS
					FOR LOCAL:1, 0, RESULT
						EXP:CHARA:AUTO_SPLIT(RESULTS:(LOCAL:1), "_", 0) += AUTO_SPLIT_INT(RESULTS:(LOCAL:1), "_", 1)
					NEXT
				ENDIF
				VARSET RESULTS
				CALLFORM ARTIFACT_EXPLAIN_{GET_ITEMDATA(LOCAL,"ID")}
				FOR LOCAL, 0, 30
					CSTR:CHARA:角色解说 += RESULTS:LOCAL
					SIF LOCAL < 29
						CSTR:CHARA:角色解说 += "_"
				NEXT
				CFLAG:CHARA:独特 = 2
			ELSE
				NAME:CHARA '= RAND_HOMUNAME(NAME:CHARA)
				CALL MESSAGE_WINDOW, "", @"请为霍姆克鲁斯起名。/当前：%NAME:CHARA%/在下方手动输入要起的名字，或者直接留空表示不变更。/回车以确认。", , "保留日志/禁用按钮/禁止复用/不再等待/无需点击"
				INPUTS
				SIF RESULTS == ""
					RESULTS '= NAME:CHARA
				CLEARLINE LINECOUNT - LINE:1
				LOCALS = %RESULTS%
				CALL INPUT_YN_M, @"起名为 %LOCALS% 这样可以吗？", "就这个了", "重新起名"
				SIF RESULT
					GOTO NAME_INPUTS
				CALLNAME:CHARA = %LOCALS%
				NAME:CHARA = %LOCALS%
				NICKNAME:CHARA = 无感情
			ENDIF
			;体力气力は基礎值に(品质/2)%分の追加を与え、下二桁を切り落とす
			LOCAL:1 = 0
			FOR LOCAL, 0, VARSIZE("MIXCHOICE")
				SIF !MIXCHOICE:LOCAL
					CONTINUE
				LOCAL:1 += GET_ITEMDATA(LOCAL, "品质")
			NEXT
			LOCAL:1 /= VARSIZE("MIXCHOICE") - MATCH(MIXCHOICE, 0)
			LOCAL:1 /= 2
			LOCAL:1 += 100
			CSTR:CHARA:所在地 = 工房
			CALLFORM HOMU_BASE_{ARG}, GETNUM(BASE, "体力")
			MAXBASE:CHARA:体力 = RESULT * LOCAL:1 / 10000 *100 
			CALLFORM HOMU_BASE_{ARG}, GETNUM(BASE, "气力")
			MAXBASE:CHARA:气力 = RESULT * LOCAL:1 / 10000 * 100
			MAXBASE:CHARA:润滑 = 10000
			MAXBASE:CHARA:欲情 = 10000
			CALL SET_HOMU_MAXABL, ARG, CHARA
			CALL SET_HOMU_FEATURE, ARG, CHARA
			CALL SET_HOMU_TALENT, ARG, CHARA
			BASE:CHARA:体力 = GET_MAXBASE("体力", CHARA)
			BASE:CHARA:气力 = GET_MAXBASE("气力", CHARA)
			CFLAG:CHARA:调教者ID = CFLAG:MASTER:玩家ID
			CFLAG:CHARA:采集地点 = -1
			CFLAG:CHARA:认识 = 1
			CALL SET_INIT_STATUS, CHARA
			CALL DEL_MIX_MATERIAL
			VARSET ITEMCHOICE
			VARSET MIXLIST
			VARSET MIXCHOICE
			VARSET P_LIST
			SORTCHARA CFLAG:0:人类, FORWARD
			CALL ADD_DAY, 1
			CALL SHOW_BLANK
			RETURN 1
		ENDIF
	CASE "0", "1", "2", "3"
		CALL SHOW_BLANK
		LOCAL = TOINT(RESULTS)
		CALL SHOW_ITEMLIST("制造霍姆克鲁斯", , LOCAL, @"%AUTO_SPLIT(@"%GET_NAME("物品", 主素材)%/【万灵药】/【神秘之力】/【遗物】", "/", LOCAL)%/%AUTO_SPLIT("2/2/1/1","/" ,LOCAL)%/{ARG}")
		选择数:LOCAL = RESULT
		CALL SHOW_BLANK
	CASE "9"
		VARSET ITEMCHOICE
		VARSET MIXLIST
		VARSET MIXCHOICE
		VARSET P_LIST
		CALL SHOW_BLANK
		RETURN 0
	CASE "特质解说"
		IF AUTO_SPLIT(RESULTS, "_", 1) != ""
			TRYCCALLFORM TALENT_EXPLAIN_%AUTO_SPLIT(RESULTS, "_", 1)%
				CLEARLINE LINECOUNT - LINE:1
				CALL MESSAGE_WINDOW, , RESULTS
			CATCH
			ENDCATCH
		ENDIF
	CASEELSE
		ENCODETOUNI %RESULTS%
		SELECTCASE RESULT:1
			CASE 12000 TO 13000
				CLEARLINE LINECOUNT - LINE:1
				CALLFORM TALENT_EXPLAIN_%TALENTNAME:(RESULT:1 - 12000)%
				SPLIT RESULTS, "/", LOCALS
				FOR LOCAL, 0, RESULT
					PRINTFORML %LOCALS:LOCAL%
				NEXT
				CALL EQUATE_LINE, LINE + MAXLINE()
				WAITANYKEY
		ENDSELECT
ENDSELECT
GOTO START

; 获取一个随机名字，且不和上次的名字(ARGS)相同
@RAND_HOMUNAME, ARGS
#FUNCTIONS
#DIM num
#DIMS word, 100

IF num == 0
	word:(num++) = 阿莱西娅
	word:(num++) = 瓦伦蒂娜
	word:(num++) = 米娅
	word:(num++) = 艾米丽
	word:(num++) = 玛尔塔
	word:(num++) = 卡拉
	word:(num++) = 玛雅
	word:(num++) = 罗莎莉
	word:(num++) = 米拉
	word:(num++) = 菲欧娜
	word:(num++) = 玛琳
	word:(num++) = 尤娜
	word:(num++) = 玛丽
	word:(num++) = 克拉拉
	word:(num++) = 玛格达莱娜
	word:(num++) = 詹娜
	word:(num++) = 安娜
	word:(num++) = 斯维娅
	word:(num++) = 罗妮娅
	word:(num++) = 莉娜
	word:(num++) = 莱奥妮
