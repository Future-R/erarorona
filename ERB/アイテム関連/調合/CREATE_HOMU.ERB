@GET_HOMU_FEATURE, ARG
#LOCALSIZE 1
#DIMS FEATURE, 8
#DIM FEATUREPOINT, 8
#DIMS FEATURES, 8
#DIM TEMP
;アーティファクトチェック
LOCAL = FINDELEMENT(MIXCHOICE, 8)
IF LOCAL >= 0
	CALLFORM ARTIFACT_FEATURE_{GET_ITEMDATA(LOCAL,"ID")}
	SPLIT RESULTS, "/", RESULTS
	RETURN 1
ENDIF
;基本はホムちゃん
FEATURE:0 = 感情淡薄
FEATURE:1 = 蓝
FEATURE:2 = 双马尾
FEATURE:3 = 红色瞳
FEATURE:4 = 白
FEATURE:5 = 贫乳
FEATURE:6 = 娇小
FEATURE:7 = 苗条
VARSET FEATUREPOINT
VARSET FEATURES

P_LIST:GETNUM(TALENT, "贫乳") = 0
P_LIST:GETNUM(TALENT, "巨乳") = 0
P_LIST:GETNUM(TALENT, "娇小") = 0
P_LIST:GETNUM(TALENT, "高挑") = 0

;特征は最も数が多いものになる
;なお、同数の場合はIDが若いほうが優先される
FOR LOCAL, 0, VARSIZE("P_LIST")
	SIF !P_LIST:LOCAL
		CONTINUE
	RESULTS:1 = 
	TRYCCALLFORM PROPERTY_FEATURE_{LOCAL}
		IF P_LIST:LOCAL > FEATUREPOINT:RESULT
			FEATUREPOINT:RESULT = P_LIST:LOCAL
			FEATURE:RESULT = %RESULTS%
			FEATURES:RESULT = %RESULTS:1%
		ENDIF
	CATCH
	ENDCATCH
NEXT
FOR LOCAL, 0, 特征要素数
	RESULTS:LOCAL = %FEATURE:LOCAL%
NEXT

SIF FEATURES:GET_NO("特征", "胸") != ""
	P_LIST:(GETNUM(TALENT, FEATURES:GET_NO("特征", "胸")) + PROPERTY_TALENT_START()) = 99
SIF FEATURES:GET_NO("特征", "身高") != ""
	P_LIST:(GETNUM(TALENT, FEATURES:GET_NO("特征", "身高")) + PROPERTY_TALENT_START()) = 99

@SET_HOMU_FEATURE, ARG, ARG:1
CALL GET_HOMU_FEATURE, ARG
FOR LOCAL, 0, 特征要素数
	CSTR:(ARG:1):GET_NAME("特征", LOCAL) = %RESULTS:LOCAL%
NEXT
@GET_HOMU_TALENT, L_RESULT
#LOCALSIZE 1
#DIM TEMP
#DIM REF L_RESULT
VARSET L_RESULT
;アーティファクトチェック
LOCAL = FINDELEMENT(MIXCHOICE, 8)
IF LOCAL >= 0
	CALLFORM ARTIFACT_TALENT_{GET_ITEMDATA(LOCAL,"ID")}
	SPLIT RESULTS, "/", RESULTS
	FOR LOCAL, 0, RESULT
		L_RESULT:GETNUM(TALENT, AUTO_SPLIT(RESULTS:LOCAL, "_", 0)) = AUTO_SPLIT_INT(RESULTS:LOCAL, "_", 1)
	NEXT
ELSE
	;通常チェック
	FOR LOCAL, 0, VARSIZE("GAIN_P_LIST")
		SIF !GAIN_P_LIST:LOCAL
			CONTINUE
		SIF !IS_PROPERTY_TALENT(GAIN_P_LIST:LOCAL)
			CONTINUE
		TEMP = PROPERTY_NUM_TALENT(GAIN_P_LIST:LOCAL)
		L_RESULT:TEMP = RESULT:1 + 1
	NEXT
ENDIF
RETURN 1

@SHOW_HOMU_TALENT, ARG, ARG:1
#LOCALSSIZE 20
#LOCALSIZE 2
#DIMS TEMPS, 2
#DIM TEMP
#DIM NOLV
#DIM L_TALENT, 200
VARSET LOCALS
CALL GET_HOMU_TALENT, L_TALENT
TEMP = 0
TEMPS = 
LOCAL:1 = 0
CALL LAYER_SET, @"┌特质%"─"*59%┐", ARG, ARG:1
FOR LOCAL, 0, 200
	SIF !L_TALENT:LOCAL && LOCAL != 199
		CONTINUE
	TEMPS:1 = %TALENTNAME:LOCAL%
	NOLV = 0
	TRYCCALLFORM TALENT_NOLV_%TEMPS:1%
		IF RESULT
			NOLV = 1
		ELSE
			TEMPS:1 += " Lv" + TOSTR(L_TALENT:LOCAL)
		ENDIF
	CATCH
		TEMPS:1 += " Lv" + TOSTR(L_TALENT:LOCAL)
	ENDCATCH
	IF (TEMP + STRLENS(TEMPS:1) + 2 > 122) || (LOCAL == 199 && TEMP > 0)
		CALL LAYER_SET, "│" + TEMPS + (122 - TEMP) * " " + "│", ARG + 1 + LOCAL:1 , ARG:1
		TEMP = 0
		TEMPS = 
		LOCAL:1++
	ENDIF
	TEMPS += ADD_BTAG("[" + TEMPS:1 + "]",  "特质解说" + "_" + TALENTNAME:LOCAL + "_" + \@ NOLV ? 0 # %TOSTR(L_TALENT:LOCAL)%\@)
	TEMP += STRLENS(TEMPS:1) + 2
NEXT
FOR LOCAL, LOCAL:1, 5
	CALL LAYER_SET, "│" + " " * 122  + "│", ARG + 1 + LOCAL, ARG:1
NEXT
CALL LAYER_SET, @"└%"─"*61%┘", ARG + 6, ARG:1

@SET_HOMU_TALENT, ARG, ARG:1
#DIM L_TALENT, 200
CALL GET_HOMU_TALENT, L_TALENT
FOR LOCAL, 0, VARSIZE("TALENT")
	TALENT:(ARG:1):LOCAL = L_TALENT:LOCAL
NEXT
