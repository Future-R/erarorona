CALL LAYER_SET, @"│肤色:%RESULTS:4,26,LEFT%胸　:%RESULTS:5,26,LEFT%身高:%RESULTS:6, 25,LEFT%体型:%RESULTS:7,25,LEFT%│", ARG:1 + 2, ARG:2
