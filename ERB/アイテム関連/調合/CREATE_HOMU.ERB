@GET_HOMU_MAXABL, ARG
#LOCALSIZE 1
#DIM MAXABL, 100
#DIM 初期ABL, 100
VARSET MAXABL
VARSET 初期ABL
;基礎值
FOR LOCAL, 0, 100
	CALLFORM HOMU_MAXABL_{ARG}, LOCAL
	MAXABL:LOCAL = RESULT
NEXT
FOR LOCAL, 0, 特性总数
	SIF !P_LIST:LOCAL
		CONTINUE
	CALL PROPERTY_ABL, LOCAL
	IF RESULT >= 0
		MAXABL:RESULT += RESULT:1
		初期ABL:RESULT += RESULT:1
	ENDIF
NEXT
LOCAL = FINDELEMENT(MIXCHOICE, 8)
IF LOCAL >= 0
	CALLFORM ARTIFACT_ABL_{GET_ITEMDATA(LOCAL,"ID")}
	IF RESULTS != ""
		SPLIT RESULTS, "/", RESULTS
		FOR LOCAL, 0, RESULT
			MAXABL:GETNUM(ABL, AUTO_SPLIT(RESULTS:LOCAL, "_", 0)) += AUTO_SPLIT_INT(RESULTS:LOCAL, "_", 1)
			初期ABL:GETNUM(ABL, AUTO_SPLIT(RESULTS:LOCAL, "_", 0)) += AUTO_SPLIT_INT(RESULTS:LOCAL, "_", 1)
		NEXT
	ENDIF
ENDIF

VARSET RESULT
FOR LOCAL, 0, 100
	RESULT:(100+LOCAL) = LIMIT(MAXABL:LOCAL, 3, 10)
	RESULT:LOCAL = LIMIT(初期ABL:LOCAL, 0, 10)
NEXT
RETURN RESULT
@SHOW_HOMU_MAXABL, ARG, ARG:1, ARG:2
#LOCALSIZE 2
#LOCALSSIZE 1
CALL GET_HOMU_MAXABL, ARG
CALL LAYER_SET, @"┌能力%"─"*59%┐", ARG:1, ARG:2
LOCAL = 0
LOCAL:1 = 0
FOR LOCAL, 0, 100
	SIF ABLNAME:LOCAL == ""
		CONTINUE
	IF LOCAL:1 % 6 == 0
		LOCALS = │
	ELSE
		LOCALS += " " * 4
	ENDIF
	LOCALS += @"%ABLNAME:LOCAL,10,LEFT%: {RESULT:LOCAL,2}/{RESULT:(LOCAL+100),2}"
	SIF LOCAL:1 % 6 == 5
		CALL LAYER_SET, LOCALS + "│", ARG:1 + LOCAL:1 / 6 + 1, ARG:2
	LOCAL:1++
NEXT
WHILE LOCAL:1 < 18
	IF LOCAL:1 % 6 == 0
		LOCALS = │
	ELSE
		LOCALS += " " * 4
	ENDIF
	LOCALS += " " * 17
	SIF LOCAL:1 % 6 == 5
		CALL LAYER_SET, LOCALS + "│", ARG:1 + LOCAL:1 / 6 + 1, ARG:2
	LOCAL:1++
WEND
CALL LAYER_SET, @"└%"─"*61%┘", ARG:1 + 4, ARG:2

@SET_HOMU_MAXABL, ARG, ARG:1
CALL GET_HOMU_MAXABL, ARG
FOR LOCAL, 0, 100
	ABL:(ARG:1):LOCAL = RESULT:LOCAL
	CALL SET_MAX_ABL, LOCAL, ARG:1, RESULT:(LOCAL+100)
NEXT

