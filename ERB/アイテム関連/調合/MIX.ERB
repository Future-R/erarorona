;---------------------------------------------------------------------
;
;	Module		:MIX.ERB
;	Facility	:物品调合関数群
;
;	Licence		:フリー
;
;	Modification Data:物品调合のインターフェイス
;
;
;	Edit	Date				Author		Ver			Reason													
;	001		2012/05/30			kap			0.300		新規作成
;	002		2012/07/28			kap						调合後の既知情報の取得を特性選択前に移動				
;														特性選択時に候補がない場合エラー落ちしていたのを修正	
;														GAIN_PROPERTY_LISTを廃止というか、特性関係を大幅変更
;	003		2012/08/18			kap			0.304		物品调合可能数でMINARRAYの使い方が間違っていたのを修正。ついでに调合可能数最少が99のとき打ち切るように修正
;	004		2012/08/19			kap			0.305		リストの幅を変更
;	005		2012/09/04			kap			0.350		主效果の既知情報の獲得処理を追加
;	006		2012/09/19			kap			0.370		特定物品を選んだ際に素質特性の相殺処理が機能していなかったのを修正
;														メッセージの点击範囲拡張に対応
;	007		2012/09/26			kap			0.390		物品がホムンクルス素材であるときホムンクルスの作成に関する特性が継承されるように
;	008		2012/10/05			kap			0.400		MIX_ITEMから调合可能数取得関数を独立させる
;---------------------------------------------------------------------
;なにをするかを選ばせる関数
;選ぶ物品のリストは持っている参考书によって決定される
;---------------------------------------------------------------------
@MIX_SELECT
#LOCALSSIZE 6

#DIM TEMP
#DIMS TEMPS, 3
#DIM LAYER_X
#DIM LAYER_Y

#DIM PAGE, 2
#DIM NUM, 2
#DIM MAXNUM

#DIMS SHOW_MODE, 1
#DIM 必要素材
#DIM 必要素材数

#DIM MIX_LIST, 2000
#DIMS MIX_TABLE, 2000
#DIM CATEGORY_ABLE

#DIM ITEMNUM

#DIM 显示数
#DIM C_REDRAW

#DIM 分类閾值, 6
#DIM LINE,3

#DIM 所持物品分类, 物品总数
C_REDRAW = CURRENTREDRAW()
REDRAW 0
显示数 = 17
LINE = LINECOUNT
VARSET 所持物品
VARSET 所持物品分类
;速度改良のために変数に入れてつかう
FOR LOCAL, GET_ITEM_RANGE("所持物品"), GET_ITEM_RANGE("所持物品", 1)
	所持物品:LOCAL = GET_ITEMDATA(LOCAL, "ID")
	所持物品分类:LOCAL = GET_ITEMDATA(LOCAL, "分类")
NEXT


FOR LOCAL, 0, 物品总数
	RESULTS = 
	TRYCALLFORM ITEM_RECIPE_{LOCAL}
	SIF RESULTS == ""
		CONTINUE
	MIX_TABLE:LOCAL = %RESULTS%
NEXT
;変数を初期化しておく
VARSET ITEMCHOICE
VARSET MIXLIST
VARSET MIXCHOICE
VARSET P_LIST
VARSET GAIN_P_LIST
$CREATE_LIST
PAGE = 0
PAGE:1 = 0
NUM = 0
NUM:1 = 0
VARSET MIX_LIST, -1
LOCAL:1 = 0
FOR LOCAL, 0, 物品总数
	SIF MIX_TABLE:LOCAL == ""
		CONTINUE
	SIF !RECIPE:GET_NO("参考书", AUTO_SPLIT(MIX_TABLE:LOCAL, "/", 0))
		CONTINUE
	FOR LOCAL:2, 0, 分类要素数
		SIF GETBIT(CATEGORY_ABLE, LOCAL:2)
			CONTINUE
		CALLFORM ITEM_CATEGORY_{LOCAL}, LOCAL:2
		SIF RESULT >= 0
			SETBIT CATEGORY_ABLE, LOCAL:2
	NEXT
	IF SHOW_MODE != ""
		RESULTS = 
		TRYCALLFORM ITEM_TYPE_{LOCAL}
	ENDIF
	SELECTCASE AUTO_SPLIT(SHOW_MODE, "_", 0)
		CASE "调合物品"
			SIF !STRCOUNT(RESULTS, "调合")
				CONTINUE
		CASE "使用物品"
			SIF !STRCOUNT(RESULTS, "料理") && !STRCOUNT(RESULTS, "攻击")
				CONTINUE
		CASE "調教物品"
			SIF !STRCOUNT(RESULTS, "调教") && !STRCOUNT(RESULTS, "回復")
				CONTINUE
		CASE "装備材料"
			SIF !STRCOUNT(RESULTS, "素材")
				CONTINUE
		CASE "分类"
			CALLFORM ITEM_CATEGORY_{LOCAL}, AUTO_SPLIT_INT(SHOW_MODE, "_", 1)
			SIF RESULT < 0
				CONTINUE
	ENDSELECT
	MIX_LIST:(LOCAL:1) = LOCAL
	LOCAL:1++
NEXT
$SHOW_START
MAXNUM = 2000 - MATCH(MIX_LIST, -1)
CLEARLINE LINECOUNT - LINE
CALL LAYER_INIT

;---------------------------------------------------
;ヘッダー部分
;---------------------------------------------------
CALL LAYER_DRAWLINE, 0
CALL LAYER_SET, @"　%SHOW_DAY()%　-物品调合-%"",50%ＭＰ[{BASE:MASTER:MP,3}/{GET_MAXBASE("MP", MASTER),3}]　　　MLv: {GET_MIXLV()}　", 1
CALL LAYER_DRAWLINE, 2

;---------------------------------------------------
;调合物品候補
;---------------------------------------------------
LAYER_Y = 3
CALL LAYER_SET, @"┌%"─"*10%┬%"─" * 2%┬%"─"*11%┬%"─"*11%┬%"─"*11%┬%"─"*11%┐", LAYER_Y
CALL LAYER_SET, @"│%"名前",20,LEFT%│%"所持"%│%"素材1",22,LEFT%│%"素材2",22,LEFT%│%"素材3",22,LEFT%│%"素材4",22,LEFT%│", LAYER_Y + 1
TEMPS '= "├"
TEMPS += ADD_BTAG("─"*10, "点击_4")
TEMPS += @"┼%"─"*2%┼%"─"*11%┼%"─"*11%┼%"─"*11%┼%"─"*11%┤"
CALL LAYER_SET, TEMPS, LAYER_Y + 2
FOR LOCAL, PAGE, PAGE + 显示数
	IF MIX_LIST:LOCAL == -1
		TEMPS '= @"│%"",20%│%"",4%│%"",22,LEFT%│%"",22,LEFT%│%"",22,LEFT%│%"",22,LEFT%│"
	ELSE
		VARSET LOCALS, "", 0, 6
		TEMPS '= "│"
		IF GET_KNOWN_ITEM(MIX_LIST:LOCAL, "获得")
			TEMPS += ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))
		ELSE
			TEMPS += "　"
		ENDIF
		TEMPS += ADD_FTAG(ADD_BTAG(@"%"要制作" + GET_NAME("物品", MIX_LIST:LOCAL),18,LEFT%", @"物品_{LOCAL}"), NUM == LOCAL ? COLOR("FOCUS") # COLOR("DEF"))
		TEMPS += @"│{MATCH(所持物品, MIX_LIST:LOCAL), 4}"
		SPLIT MIX_TABLE:(MIX_LIST:LOCAL), "/", LOCALS
		FOR LOCAL:1, 1, 5
			TEMPS += "│"
			IF LOCALS:(LOCAL:1) != ""
				TEMPS:1 = %AUTO_SPLIT(LOCALS:(LOCAL:1), "*", 0)%
				必要素材数 = MAX(AUTO_SPLIT_INT(LOCALS:(LOCAL:1), "*", 1), 1)
				IF STRCOUNT(LOCALS:(LOCAL:1), "【")
					;分类を番号化
					TEMP = GET_NO("分类", SUBSTRINGU(TEMPS:1, 1, STRLENSU(TEMPS:1)-2))
					LOCAL:3 = 0
					FOR LOCAL:2, GET_ITEM_RANGE("所持物品"), GET_ITEM_RANGE("所持物品", 1)
						SIF !GETBIT(所持物品分类:(LOCAL:2), TEMP)
							CONTINUE
						SIF ++LOCAL:3 < 必要素材数
							CONTINUE
						BREAK
					NEXT
					IF 必要素材数 > 1
						TEMPS:1 = %TEMPS:1, 16, LEFT% * {必要素材数, 3}
					ELSE
						TEMPS:1 = %TEMPS:1, 22, LEFT%
					ENDIF
					SIF LOCAL:3 < 必要素材数
						TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("gray"))
				ELSE
					TEMP = GET_NO("物品", TEMPS:1)
					TEMPS:1 += "　"
					IF 必要素材数 > 1
						TEMPS:1 = %TEMPS:1, 16, LEFT% * {必要素材数, 3}
					ELSE
						TEMPS:1 = %TEMPS:1, 22, LEFT%
					ENDIF
					TRYCCALLFORM ITEM_RECIPE_{TEMP}
						TEMPS:1 '= ADD_BTAG(TEMPS:1, @"调合_{TEMP}")
					CATCH
					ENDCATCH
					SIF MATCH(所持物品, TEMP) < 必要素材数
						TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("gray"))
				ENDIF
			ELSE
				TEMPS:1 = %"", 22%
			ENDIF
			TEMPS += TEMPS:1
		NEXT
		TEMPS += "│"
	ENDIF
	CALL LAYER_SET, TEMPS, LAYER_Y + 3 + (LOCAL - PAGE)
NEXT
TEMPS '= "└"
TEMPS += ADD_BTAG("─"*10, "点击_6")
TEMPS += @"┴%"─"*2%┴%"─"*11%┴%"─"*11%┴%"─"*11%┴%"─"*11%┘"
CALL LAYER_SET, TEMPS, LAYER_Y + 3 + 显示数
CALL LAYER_PRINT, , LAYER_Y + 4 + 显示数
;-------------------------------------------------
;物品解説
;-------------------------------------------------
LINE:1 = LINECOUNT
CALL SHOW_MIX_ITEM_EXPLAIN, MIX_LIST:NUM

;------------------------------------------
;選択欄
;------------------------------------------
LAYER_Y = 0
CALL LAYER_INIT
CALL LAYER_DRAWLINE, LAYER_Y
LINE:2 = LINECOUNT + 1
LAYER_Y = LAYER_Y + 1
TEMPS = 
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[1] <<< "), "1")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[4] << "), "4")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[8] < "), "8")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[5] "), "点击_5")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[2] > "), "2")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",9%[6] >> "), "6")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[3] >>>"), "3")
CALL LAYER_SET, TEMPS, LAYER_Y
CALL LAYER_DRAWLINE, LAYER_Y + 1

TEMPS '= " " * 5
FOR LOCAL, 0, 5
	TEMPS:1 '= ADD_BTAG(@"%AUTO_SPLIT("[+]_[-]_[*]_[/]_[.]", "_", LOCAL)% %AUTO_SPLIT("全部/调合物品/使用物品/装備材料/調教物品", "/", LOCAL), 14, LEFT%", "点击_" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL))
	SIF SHOW_MODE == AUTO_SPLIT("/调合物品/使用物品/装備材料/調教物品", "/", LOCAL)
		TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("p-green"))
	TEMPS += TEMPS:1
NEXT
CALL LAYER_SET, TEMPS, LAYER_Y + 2
TEMPS '= " " * 5
TEMPS += ADD_BTAG("[En] 決定　　 　　", "点击_")
TEMPS += ADD_FTAG(ADD_BTAG("[0] 分类指定　", "点击_0"), STRCOUNT(SHOW_MODE, "分类") ? COLOR("p-green") # COLOR("DEF"))
TEMPS += ADD_BTAG( "[7] 帮助　　　　", "点击_7")
TEMPS += ADD_BTAG("[9] 戻る", "点击_9")
CALL LAYER_SET, TEMPS, LAYER_Y + 3
CALL LAYER_PRINT, , LAYER_Y + 3 + 1
CALL EQUATE_LINE, LINE + MAXLINE()
ONEINPUTS

FLAG:鼠标模式 = STRLENS(RESULTS) > 1
SIF RESULTS == "q"
	RESULTS = 物品解説
SIF STRCOUNT("_a_s_d_f_g_h_j_k_l_z_x_c_v_b_", "_" + RESULTS + "_")
	RESULTS '= @"主效果解说_{AUTO_SPLIT_NUM("a_s_d_f_g_h_j_k_l_z_x_c_v_b", "_", RESULTS)}"
SIF AUTO_SPLIT(RESULTS, "_", 0) == "点击"
	RESULTS = %AUTO_SPLIT(RESULTS, "_", 1)%
SELECTCASE AUTO_SPLIT(RESULTS, "_", 0)
	CASE "", "5"
		TEMP = MIX_LIST:NUM
		$MIX
		IF TEMP >= 0
			CLEARLINE LINECOUNT - LINE:2
			CALL MIX_ITEM, TEMP
			IF RESULT == 1
				NUM = 0
				PAGE = 0
				PAGE:1 = 0
				REDRAW C_REDRAW
				RESTART
			ENDIF
		ENDIF
	CASE "0"
		$絞込み開始
		CLEARLINE LINECOUNT - LINE:2
		FOR LOCAL, 0, 4
			FOR LOCAL:1, 0, 8
				TEMP = LOCAL * 8 + LOCAL:1
				IF TEMP == 31
					PRINTBUTTON " [9] キャンセル", 9
				ELSE
					IF TEMP < 分类要素数 && GET_NAME("分类", TEMP) != "神器"
						IF GETBIT(CATEGORY_ABLE, TEMP)
							PRINTBUTTON " [" + GET_KEYMARK(TEMP) + "]" + " " + @"%GET_NAME("分类", TEMP), 10, LEFT%", GET_KEYMARK(TEMP)
						ELSE
							SETCOLOR COLOR("gray")
							PRINTPLAINFORM  [%GET_KEYMARK(TEMP)%] %GET_NAME("分类", TEMP), 10, LEFT%
							RESETCOLOR
						ENDIF
					ELSE
						PRINTFORM %"", 15%
					ENDIF
				ENDIF
			NEXT
			PRINTL 
		NEXT
		CALL EQUATE_LINE(LINE:2 + 6)
		ONEINPUTS
		IF RESULTS == "9"
			SHOW_MODE = 
		ELSE
			IF INRANGE(GET_KEYMARK_NUM(RESULTS), 0, 分类要素数 - 1)
				SHOW_MODE '= @"分类_{GET_KEYMARK_NUM(RESULTS)}"
			ELSE
				GOTO 絞込み開始
			ENDIF
		ENDIF
		CALL SHOW_BLANK
		GOTO CREATE_LIST
	CASE "1"
		NUM = LIMIT(PAGE - 显示数 * 4 - 1, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE - 显示数 * 5, 0, MAX(0, MAXNUM - 显示数))
	CASE "4"
		NUM = LIMIT(PAGE - 1, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE - 显示数, 0, MAX(0, MAXNUM - 显示数))
	CASE "8"
		NUM = LIMIT(NUM - 1, 0, MAXNUM - 1)
		SIF PAGE > NUM
			PAGE = LIMIT(PAGE - 1, 0, MAX(0, MAXNUM - 显示数))
	CASE "2"
		NUM = LIMIT(NUM + 1, 0, MAXNUM - 1)
		SIF PAGE + 显示数 - 1 < NUM
			PAGE = LIMIT(PAGE + 1, 0, MAX(0, MAXNUM - 显示数))
	CASE "6"
		NUM = LIMIT(PAGE + 显示数, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE + 显示数, 0, MAX(0, MAXNUM - 显示数))
	CASE "3"
		NUM = LIMIT(PAGE + 显示数 * 5, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE + 显示数 * 5 , 0, MAX(0, MAXNUM - 显示数))
	CASE "7"
		INVERTBIT MIXHELP, 0
	CASE "+", "-", "*", "/", "."
		SELECTCASE RESULTS
			CASE "+"
				LOCALS = 
			CASE "-"
				LOCALS = 调合物品
			CASE "*"
				LOCALS = 使用物品
			CASE "/"
				LOCALS = 装備材料
			CASE "."
				LOCALS = 調教物品
		ENDSELECT
		SHOW_MODE = \@SHOW_MODE == LOCALS ?  # %LOCALS%\@
		CALL SHOW_BLANK
		GOTO CREATE_LIST
	CASE "9"
		$END
		REDRAW C_REDRAW
		RETURN 1
	CASE "物品解説"
		IF MIX_LIST:NUM >= 0
			TRYCCALLFORM ITEM_EXPLAIN_{MIX_LIST:NUM}
				CLEARLINE LINECOUNT - LINE:2
				CALL MESSAGE_WINDOW, , RESULTS
			CATCH
			ENDCATCH
		ENDIF
	CASE "主效果解说"
		IF MIX_LIST:NUM >= 0
			LOCAL = AUTO_SPLIT_INT(RESULTS, "_", 1) /3
			LOCAL:1 = AUTO_SPLIT_INT(RESULTS, "_", 1) % 3
			IF GET_KNOWN_ITEM(MIX_LIST:NUM, @"主效果{LOCAL}{LOCAL:1}")
				TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{MIX_LIST:NUM}
					TRYCCALLFORM EFFECT_EXPLAIN_{GET_NO("主效果", AUTO_SPLIT(RESULTS, "/", LOCAL:1))}
						CLEARLINE LINECOUNT - LINE:2
						CALL MESSAGE_WINDOW, , RESULTS
					CATCH
					ENDCATCH
				CATCH
				ENDCATCH
			ENDIF
		ENDIF
	CASE "分类"
		IF GETBIT(CATEGORY_ABLE, AUTO_SPLIT_INT(RESULTS, "_", 1))
			SHOW_MODE = %RESULTS%
			CALL SHOW_BLANK
			GOTO CREATE_LIST
		ELSE
			CLEARLINE LINECOUNT - LINE:2
			CALL MESSAGE_WINDOW, , @"【%GET_NAME("分类", AUTO_SPLIT_INT(RESULTS, "_", 1))%】のレシピはありません。"
		ENDIF
	CASE "物品"
		IF NUM == AUTO_SPLIT_INT(RESULTS, "_", 1)
			TEMP = MIX_LIST:NUM
			GOTO MIX
		ELSE
			NUM = AUTO_SPLIT_INT(RESULTS, "_", 1)
		ENDIF
	CASE "调合"
		TEMP = AUTO_SPLIT_INT(RESULTS, "_", 1)
		TRYCCALLFORM ITEM_RECIPE_{TEMP}
			IF MATCH(MIX_TABLE, RESULTS)
				CLEARLINE LINECOUNT - LINE:1
				CALL SHOW_MIX_ITEM_EXPLAIN, TEMP
				DRAWLINE
				CALL GET_MIX_ABLE_NUM, TEMP
				IF RESULT
					CALL INPUT_YN_M, "要制作" + GET_NAME("物品", TEMP) + "吗？"
					SIF !RESULT
						GOTO MIX
				ELSE
					CALL MESSAGE_WINDOW, , "要制作" + GET_NAME("物品", TEMP) + "を调合するには素材が足りません。"
				ENDIF
			ELSE
				CALL MESSAGE_WINDOW, "", "要制作" + GET_NAME("物品", TEMP) + "の作り方をしりません。"
			ENDIF
		CATCH
		ENDCATCH
ENDSELECT
;PAGEが一度に2以上動いた場合、暗転表示を入れる
SIF ABS(PAGE - PAGE:1) > 1
	CALL SHOW_BLANK 
PAGE:1 = PAGE
GOTO SHOW_START
;-----------------------------------------------------------------------------------------------
;调合物品の説明文
;-----------------------------------------------------------------------------------------------
@SHOW_MIX_ITEM_EXPLAIN, ARG
#LOCALSIZE 2
#LOCALSSIZE 6
#DIM LAYER_Y
#DIMS TEMPS
#DIM TEMP
#DIM 分类閾值, 6
LAYER_Y = 0
CALL LAYER_INIT
CALL LAYER_SET, @"┌%"─"*10%┬%"─"*2%┬%"─"*11%┬%"─"*11%┬%"─"*11%┬%"─"*11%┐", LAYER_Y
IF ARG >= 0
	TEMPS '= "│"
	TEMPS += ADD_BTAG(FORMCELL(@"%\@MIXHELP ? [q] # %" "% \@ + "要制作" + GET_NAME("物品", ARG)%", 20, "LEFT"), "物品解説")
	TEMPS += @"│{MATCH(所持物品, ARG), 4}"
	RESULT = 0
	TRYCALLFORM ITEM_LV_{ARG}
	TEMPS += @"│%@"目標Lv: {RESULT,2}",22,LEFT%"
	CALL MIX_SUCCESS_RATE, ARG
	TEMPS += @"│%@"成功率: {RESULT,4}\%", 22, LEFT%"
	CALL GET_MIX_DAY, ARG
	RESULTS = %TOSTR(RESULT/10)%
	SIF RESULT % 10
		RESULTS += "." + TOSTR(RESULT%10)
	TEMPS += @"│%@"%RESULTS,4%日/ 1個",22,LEFT%"
	CALL GET_MIX_MP, ARG
	TEMPS += @"│%@"{RESULT,4}ＭＰ/ 1個",22,LEFT%│"
	RESULTS = 
;	TRYCALLFORM ITEM_EXPLAIN_{ARG}, 1
;	CALL WINDOWPRINTL, @"│%AUTO_SPLIT(RESULTS, "/", 0), 108,LEFT%│
ELSE
	TEMPS '= @"│%"",20%│%"",4%│%"",22%│%"",22%│%"",22%│%"",22%│"
ENDIF
CALL LAYER_SET, TEMPS, LAYER_Y + 1
CALL LAYER_SET, @"├%"─"*5%┬%"─"*4%┴%"─"*2%┴%"─"*1%┬%"─"*9%┼%"─"*9%┬%"─"*1%┴%"─"*11%┴%"─"*11%┤", LAYER_Y + 2
FOR LOCAL, 0, 4
	TEMPS '= @"│ %@"效果{LOCAL+1}", 9,LEFT%"
	VARSET RESULT, 999, 0, 6
	TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{ARG}
		分类閾值 = 0, RESULT / 2, RESULT:1 / 2, RESULT:2 / 2, RESULT:3 / 2, 999
		VARSET LOCALS, "", 0, 5
		SPLIT RESULTS, "/", LOCALS
		;主效果セット
		FOR LOCAL:1, 0, 3
			TEMPS += "│"
			IF LOCALS:(LOCAL:1) != ""
				IF GET_KNOWN_ITEM(ARG, @"主效果{LOCAL}{LOCAL:1}")
					TEMPS += ADD_BTAG(FORMCELL(@"%\@MIXHELP ? [%AUTO_SPLIT("a_s_d_f_g_h_j_k_l_z_x_c_v_b", "_", LOCAL *3 + LOCAL:1)%] #\@ + LOCALS:(LOCAL:1)%",18, "LEFT") , @"主效果解说_{LOCAL *3 + LOCAL:1}")
				ELSE
					TEMPS += @"%"????",18,LEFT%"
				ENDIF
			ELSE
				TEMPS += @"%"", 18%"
			ENDIF
		NEXT
		TEMPS += "│"
		FOR LOCAL:1, 0, 4
			TEMPS += ADD_FTAG(@"%UNICODE(0x2580)%" * (LIMIT(分类閾值:(LOCAL:1 + 1), 0, 50) - LIMIT(分类閾值:(LOCAL:1), 0, 50)), COLOR(AUTO_SPLIT("gray/p-blue/p-green/p-red", "/", LOCAL:1)))
		NEXT
		TEMPS += @"%UNICODE(0x2580)%" * MAX(50 - 分类閾值:4, 0)
	CATCH
		FOR LOCAL:1, 0, 3
			TEMPS += @"│%"",18%"
		NEXT
		TEMPS += @"│%"",50%"
	ENDCATCH
	TEMPS += "│"
	CALL LAYER_SET, TEMPS, LAYER_Y + 3 + LOCAL
NEXT
CALL LAYER_SET, @"├%"─"*5%┴%"─"*9%┴%"─"*9%┴%"─"*9%┴%"─"* 25%┤", LAYER_Y + 7
LOCALS = 
FOR LOCAL:1, 0, 分类要素数
	TRYCCALLFORM ITEM_CATEGORY_{ARG}, LOCAL:1
		SIF RESULT >= 0
			LOCALS += " " + GET_NAME("分类", LOCAL:1)
	CATCH
		BREAK
	ENDCATCH
NEXT
CALL LAYER_SET, @"│%LOCALS,122,LEFT%│", LAYER_Y + 8
CALL LAYER_SET, @"└%"─"*61%┘", LAYER_Y + 9
CALL LAYER_PRINT, , LAYER_Y + 10
;------------------------------------
;前半部でいくつ调合出来るかを取得し
;後半部で必要な物品のセットのためにSHOW_ITEMLISTに送る
;ARG　调合する物品番号
;------------------------------------
@MIX_ITEM, ARG
#LOCALSIZE 10
#DIM TEMP
#DIM C_REDRAW
#DIM LINE,5
#DIM LAYER_X
#DIM LAYER_Y

#DIMS 素材名, 5
#DIM 素材必要数, 4

#DIM MIX_NUM
#DIM MIX_ABLE_NUM
#DIM EXP_PREV
#DIM EXP_NEXT
#DIM MP_PREV
#DIM MP_NEXT

#DIM TEMPLV
#DIM P_PAGE

#DIM MIX_SUM

#DIM 分类閾值, 6
#DIM 分类值, 4
