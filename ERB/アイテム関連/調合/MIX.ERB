CALL LAYER_SET, ADD_BTAG("[ 9] 返回", "9"), LAYER_Y + 8
CALL LAYER_PRINT, , MAXLINE()
;------------------------------------
;入力開始
;------------------------------------
ONEINPUTS
SELECTCASE RESULTS
	CASE "", "En"
		IF (选择数:0 == 素材必要数:0) && (选择数:1 == 素材必要数:1) && (选择数:2 == 素材必要数:2) && (选择数:3 == 素材必要数:3)
			CALL GET_MIX_DAY, ARG
			LOCAL = (RESULT * MIX_NUM) / 10 + (RESULT * MIX_NUM % 10 > 0)
			CALL GET_MIXEXP, ARG, MIX_NUM
			TEMPLV = GET_MIXLV()
			LOCAL:3 = -999
			EXP_PREV = BASE:MASTER:调合经验值
			EXP_NEXT = BASE:MASTER:调合经验值 + RESULT
			CALL GET_MIX_MP, ARG
			MP_PREV = BASE:MASTER:MP
			MP_NEXT = BASE:MASTER:MP - RESULT * MIX_NUM
			
			LINE:2 = LINECOUNT
			FOR LOCAL:1, 0, LOCAL + 1
				CLEARLINE LINECOUNT - LINE:2
				LINE:3 = LINECOUNT
				FOR LOCAL:2, 0, 8
					CLEARLINE LINECOUNT - LINE:3
					IF LOCAL:1 == LOCAL
						BASE:MASTER:调合经验值 = EXP_NEXT
						BASE:MASTER:MP = MAX(MP_NEXT, 0)
					ELSE
						BASE:MASTER:调合经验值 = (EXP_PREV * (LOCAL * 8 - LOCAL:1 * 8 - LOCAL:2) + EXP_NEXT * (LOCAL:1 * 8 + LOCAL:2)) / (LOCAL * 8)
						BASE:MASTER:MP = MAX((MP_PREV * (LOCAL * 8 - LOCAL:1 * 8 - LOCAL:2) + MP_NEXT * (LOCAL:1 * 8 + LOCAL:2)) / (LOCAL * 8), 0)
					ENDIF
					IF GET_MIXLV() > TEMPLV
						TEMPLV = GET_MIXLV()
						LOCAL:3 = LOCAL:1 * 8 + LOCAL:2
					ENDIF
					CALL INIT_LAYER
					LAYER_X = 0
					LAYER_Y = MAXLINE() - 14
					CALL LAYER_DRAWLINE, LAYER_Y
					CALL LAYER_SET, @"　%@"{YEAR()}年目 {MONTH()}月 {DAYS()}日",28,LEFT%%"要制作" + GET_NAME("物品", ARG)%调合", LAYER_Y + 1
					CALL LAYER_DRAWLINE, LAYER_Y + 2
					CALL LAYER_SET, CALLNAME:MASTER, LAYER_Y + 3
					CALL LAYER_SET, @"MIXLv: {GET_MIXLV()}", LAYER_Y + 4
					{
					CALL LAYER_SET, "MP   : " + 
									LAYER_CBAR(BASE:MASTER:MP, GET_MAXBASE("MP", MASTER), 50, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("緑"), RESULT:1) + 
									@"　{BASE:MASTER:MP,4}/{GET_MAXBASE("MP", MASTER),4} "
									, LAYER_Y + 5
					}
					IF GET_MIXLV() == 50
						{
						CALL LAYER_SET, "EXP  : " + 
										LAYER_CBAR(0, 1, 50, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("紫"), RESULT:1) + 
										@"　{GET_MIXEXP_NOW(),4}/{GET_MIXEXP_NEXT(),4} \@ LOCAL:3 + 8 > LOCAL:1 * 8 + LOCAL:2 ? LEVELUP!! # \@"
										, LAYER_Y + 6
						}
					ELSE
						{
						CALL LAYER_SET, "EXP  : " + 
										LAYER_CBAR(GET_MIXEXP_NOW(), GET_MIXEXP_NEXT(), 50, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("紫"), RESULT:1) + 
										@"　{GET_MIXEXP_NOW(),4}/{GET_MIXEXP_NEXT(),4} \@ LOCAL:3 + 8 > LOCAL:1 * 8 + LOCAL:2 ? LEVELUP!! # \@"
										, LAYER_Y + 6
						}
					ENDIF
					CALL LAYER_DRAWLINE, LAYER_Y + 7
					CALL LAYER_PRINT, , MAXLINE() - 6
					CALL MESSAGE_WINDOW, "", "调合中" + "…" * ((LOCAL:2 / 2) % 4), , "NOANIME/NOWAIT/NOLOG/NOCLICK"
					TWAIT 100, 1
				NEXT
				SIF LOCAL:1 < LOCAL
					CALL ADD_DAY, 1
			NEXT
			CLEARLINE LINECOUNT - LINE:3
			CALL LAYER_PRINT, , MAXLINE() - 6
			;成功判定　MPが0未満の場合、ここで50%判定が入る
			CALL MIX_SUCCESS_RATE, ARG
			IF RESULT > RAND:(100 + (MP_NEXT < 0) * 100)
				CALL MESSAGE_WINDOW, "", @"调合成功!!/%GET_NAME("物品", ARG)%制作完毕！/请选择要保留的特性。"
			ELSE
				CALL MESSAGE_WINDOW, "", @"调合失败!!/出现了损坏的物品……/请选择要保留的特性。"
				ARG = GET_NO("物品", "壊れた物品")
				CALL SET_ITEMDATA(1100, "ID", GET_NO("物品", "壊れた物品"))
			ENDIF
			;既知情報の設定
			CALL SET_KNOWN_ITEM, ARG, "获得"
			FOR LOCAL, 0, 4
				TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{ARG}
					FOR LOCAL:1, 0 , 3
						IF GET_ITEMNAME_E(1100, LOCAL) == AUTO_SPLIT(RESULTS, "/", LOCAL:1)
							CALL SET_KNOWN_ITEM, ARG, @"主效果{LOCAL}{LOCAL:1}"
							CALL SET_KNOWN_EFFECT, GET_ITEMNAME_E(1100, LOCAL), "SET"
						ENDIF
					NEXT
				CATCH
				ENDCATCH
			NEXT
			CLEARLINE LINECOUNT - LINE
			;分类の確定
			CALL SET_CATEGORY, 1100
			;等级設定
			CALLFORM ITEM_LV_{ARG}
			CALL SET_ITEMDATA, 1100, "等级", RESULT
			;特性の決定,ランク、品質の確定
			CALL SET_PROPERTY_MIX, ARG
			;価格設定
			CALL SET_PRICE, 1100
			;素材を削除
			CALL DEL_MIX_MATERIAL
			;物品の登録
			ITEMCHOICE:1100 = 1
			;一旦テンポラリにいれる
			FOR LOCAL, 1101, 1100 + MIX_NUM
				FOR LOCAL:1, 0, 物品要素数
					DA:LOCAL:(LOCAL:1) = DA:1100:(LOCAL:1)
				NEXT
				ITEMCHOICE:LOCAL = 1
			NEXT
			CALL MOVE_ITEM, "箱子"
			SIF RESULT
				CALL MOVE_ITEM, "篮子"
			VARSET ITEMCHOICE
			VARSET MIXLIST
			VARSET MIXCHOICE
			CLEARLINE LINECOUNT - LINE:1
			;调合等级による実績の判定
			FOR LOCAL, 0, 10
				TEMP = LOCAL + GET_NO("记录", "素人錬金術士")
				SIF GET_RECORD_ATTAIN(TEMP)
					CONTINUE
				SIF GET_MIXLV() < (LOCAL + 1) * 5
					BREAK
				CALL MESSAGE_WINDOW, "", @"因为调合等级达到{(LOCAL+1) * 5}，/因此达成了【%GET_NAME("记录", TEMP)%】が达成されました！"
				CALL SET_RECORD_ATTAIN, TEMP, 1
			NEXT
			MIX_SUM = 0
			FOR LOCAL, 501, 1600
				MIX_SUM += GET_KNOWN_ITEM(LOCAL, "获得")
			NEXT
			FOR LOCAL, 0, 6
				TEMP = LOCAL + GET_NO("记录", "錬金知識四級")
				SIF GET_RECORD_ATTAIN(TEMP)
					CONTINUE
				SIF MIX_SUM < AUTO_SPLIT_INT("10_25_40_60_75_90", "_", LOCAL)
					BREAK
				CALL MESSAGE_WINDOW, "", @"{AUTO_SPLIT_INT("10_25_40_60_75_90", "_", LOCAL)}種類の物品を调合したことにより/【%GET_NAME("记录", TEMP)%】が达成されました！"
				CALL SET_RECORD_ATTAIN, TEMP, 1
			NEXT
			CALL SHOW_BLANK
			RETURN 1
		ENDIF
	CASE "0", "1", "2", "3"
		CALL SHOW_BLANK
		LOCAL = TOINT(RESULTS)
		CALL SHOW_ITEMLIST("调合", , LOCAL, @"%素材名:LOCAL%/{素材必要数:LOCAL}/{ARG}")
		选择数:LOCAL = RESULT			;確率判定
		;ひな形用にテンポラリを確保
		CALL DEL_ITEMDATA, 1100
		;IDをセット
		CALL SET_ITEMDATA, 1100, "ID", ARG
		;基本の品質とランクをセット
		LOCAL:1 = 0
		FOR LOCAL, 0, VARSIZE("MIXCHOICE")
			SIF !MIXCHOICE:LOCAL
				CONTINUE
			LOCAL:1 += GET_ITEMDATA(LOCAL, "品质")
		NEXT
		LOCAL:1 /= MAX(1, VARSIZE("MIXCHOICE") - MATCH(MIXCHOICE, 0))
		CALL SET_ITEMDATA, 1100, "品质", LOCAL:1
		CALL SHOW_BLANK
		GOTO START
	CASE "9"
		VARSET MIXLIST
		VARSET MIXCHOICE
		CALL SHOW_BLANK
		RETURN 0
	CASE "q"
		SIF P_PAGE > 0
			P_PAGE--
	CASE "w"
		SIF GAIN_P_LIST:((P_PAGE+1) * 25)
			P_PAGE++
ENDSELECT
GOTO START
;------------------------------------------------
;ARGの物品番号の物品を调合できる数を取得する関数
;------------------------------------------------
@GET_MIX_ABLE_NUM, ARG
#DIMS 素材名, 5
#DIM 素材番号, 4
#DIM 素材必要数, 4
#DIM 素材分类, 4

#DIM 素材所持数, 16
#DIM 调合可能数, 4
#DIM 最大调合可能数, 4
#DIM 素材数, 1
#DIM 組み合わせ数, 1
#DIM 可能数比較用, 4
#DIM 可能数ランク, 4
#DIM 終了判定, 4
#DIM 最少
#DIM 最少必要数

VARSET 素材番号, -1
VARSET 素材分类, -1
VARSET 素材必要数
VARSET 素材名, "", 0, 5

;------------------------------------------------------------------------------------------
;レシピ取得
;------------------------------------------------------------------------------------------
CALLFORM ITEM_RECIPE_{ARG}
SPLIT RESULTS, "/", 素材名
ARRAYREMOVE 素材名, 0, 1
素材数 = 0
FOR LOCAL, 0, 4
	SIF 素材名:LOCAL == ""
		CONTINUE
	LOCALS:1 = 
	SPLIT 素材名:LOCAL, "*", LOCALS
	;必要数量を取得
	素材必要数:LOCAL = LOCALS:1 != "" ? TOINT(LOCALS:1) # 1
	IF STRCOUNT(LOCALS, "【")
		素材分类:LOCAL = GET_NO("分类", SUBSTRINGU(LOCALS, 1, STRLENSU(LOCALS)-2))
		CALLF GET_MATERIAL_TYPE(LOCAL, "分类", 素材分类:LOCAL)
	ELSE
		素材番号:LOCAL = GET_NO("物品", LOCALS)
		CALLF GET_MATERIAL_TYPE(LOCAL, "個別", 素材番号:LOCAL)
	ENDIF
	素材数++
NEXT
;------------------------------------------------------------------------------------------
;最大调合可能数の取得
;------------------------------------------------------------------------------------------
;素材の組み合わせは素材数の2乗-1に等しい
組み合わせ数 = 素材数 * 素材数 - 1

;调合リストにビット演算で登録
;MIXLIST予定
VARSET MIXLIST
FOR LOCAL:1, 0, 素材数
	FOR LOCAL, 0, 1100
		SIF GET_ITEMDATA(LOCAL, "ID") <= 0
			CONTINUE
		IF 素材分类:(LOCAL:1) >= 0
			SIF !GET_CATEGORY(LOCAL, GET_NAME("分类", 素材分类:(LOCAL:1)))
				CONTINUE
		ELSE
			SIF GET_ITEMDATA(LOCAL, "ID") != 素材番号:(LOCAL:1)
				CONTINUE
		ENDIF
		SETBIT MIXLIST:LOCAL, LOCAL:1
	NEXT
NEXT
;素材所持数登録
;なお複数の素材条件を満たすものはビット演算でまとめる
VARSET 素材所持数, 0
FOR LOCAL, 0, 1100
	SIF MIXLIST:LOCAL
		素材所持数:(MIXLIST:LOCAL)++
NEXT
调合可能数 = 0
VARSET 调合可能数
;単独素材を调合可能数に加える
FOR LOCAL, 0, 素材数
	调合可能数:LOCAL = 素材所持数:POWER(2, LOCAL) / 素材必要数:LOCAL
	素材所持数:POWER(2, LOCAL) -= 调合可能数:LOCAL * 素材必要数:LOCAL
NEXT
;条件２種达成素材を调合可能数に加える
WHILE 1
	最少 = FINDELEMENT(调合可能数, MINARRAY(调合可能数, 0, 素材数))
	;99個が作成上限
	SIF 调合可能数:最少 >= 99
		BREAK
	最少必要数 = 素材必要数:最少
	;最大调合可能数の取得
	FOR LOCAL:1, 0, 素材数
		最大调合可能数:(LOCAL:1) = 调合可能数:(LOCAL:1) * 素材必要数:(LOCAL:1)
		FOR LOCAL, 0, 組み合わせ数
			SIF GETBIT(LOCAL, LOCAL:1)
				最大调合可能数:(LOCAL:1) += 素材所持数:(LOCAL) 
		NEXT
		最大调合可能数:(LOCAL:1) /= 素材必要数:(LOCAL:1)
	NEXT
	FOR LOCAL, 0, 素材数
		可能数比較用:LOCAL = 最大调合可能数:LOCAL
	NEXT
	DO
		LOCAL:1 = 0
		;可能数が多い順に並べる
		FOR LOCAL, 0, 素材数 - 1
			IF 可能数比較用:LOCAL < 可能数比較用:(LOCAL:1)
				SWAP 可能数比較用:LOCAL, 可能数比較用:(LOCAL:1)
				LOCAL:1 = 1
			ENDIF
		NEXT
	LOOP LOCAL:1
	FOR LOCAL, 0, 素材数
		可能数ランク:LOCAL = FINDELEMENT(最大调合可能数 , 可能数比較用:LOCAL)
	NEXT
	;この時点で可能数ランクは可能数が多い順に入っている
	
	;まだ単独が残ってたら使う
	IF 素材所持数:POWER(2, 最少) > 0
		最少必要数 -= 素材所持数:POWER(2, LOCAL)
		素材所持数:POWER(2, 最少) = 0
	ENDIF
	SIF 素材数 < 2
		BREAK
	
	;二者で判定
	FOR LOCAL:2, 0, 素材数
		SIF 最少 == 可能数ランク:(LOCAL:2)
			CONTINUE
		LOCAL = POWER(2, 最少) + POWER(2, 可能数ランク:(LOCAL:2))
		SIF !素材所持数:LOCAL
			CONTINUE
		IF 素材所持数:LOCAL >= 最少必要数
			素材所持数:LOCAL -=最少必要数 
			最少必要数 = 0
			调合可能数:最少++
			BREAK
		ELSE
			最少必要数 -= 素材所持数:LOCAL
			素材所持数:LOCAL = 0
		ENDIF
	NEXT
	SIF !最少必要数
		CONTINUE
	SIF 素材数 < 3
		BREAK
	
	
	;三者で判定
	IF 素材数 == 3
		IF 素材所持数:7 >= 最少必要数
			素材所持数:7 -= 最少必要数 
			最少必要数 = 0
			调合可能数:最少++
			CONTINUE
		ELSE
			BREAK
		ENDIF
	ELSE
		FOR LOCAL:2, 3, -1
			SIF 最少 == 可能数ランク:(LOCAL:2)
				CONTINUE
			LOCAL = 15 - POWER(2, 可能数ランク:(LOCAL:2))
			SIF !素材所持数:LOCAL
				CONTINUE
			IF 素材所持数:LOCAL >= 最少必要数
				素材所持数:LOCAL -=最少必要数 
				最少必要数 = 0
				BREAK
			ELSE
				最少必要数 -= 素材所持数:LOCAL
				素材所持数:LOCAL = 0
			ENDIF
		NEXT
	ENDIF
	SIF !最少必要数
		CONTINUE
	SIF 素材数 < 4
		BREAK
	
	IF 素材所持数:15 >= 最少必要数
		素材所持数:15 -= 最少必要数 
		最少必要数 = 0
		调合可能数:最少++
		CONTINUE
	ELSE
		BREAK
	ENDIF
WEND
RETURN MINARRAY(调合可能数, 0, 素材数)

;------------------------------------
;特性の選択関数
;なお、ここで一部の特性の效果が発揮される
;ARG 作る物品
;------------------------------------
@SET_PROPERTY_MIX, ARG
#LOCALSIZE 3
#LOCALSSIZE 2

#DIM LAYER_X
#DIM LAYER_Y
#DIM L_COLOR

#DIM L_LIST, 500
#DIM R_LIST, 500
#DIM CHOICE, 特性总数
#DIM COST
#DIM QUALITY
#DIM LINE, 2
#DIM MAXNUM
#DIM NUM, 2
#DIM PAGE, 2
#DIM ITEMNUM
#DIMS MODE
#DIM 显示数
#DIM TEMP
ITEMNUM = ARG

;変数の初期化
NUM = 0
PAGE = 0
PAGE:1 = 0
显示数 = 17
MODE = LEFT
VARSET L_LIST
VARSET R_LIST
VARSET CHOICE
;左右リストの内容を定義
LOCAL:1 = 0
LOCAL:2 = 0
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) < 0
		CONTINUE
	L_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT
;基本の品質とランクをセット
QUALITY = 0
FOR LOCAL, 0, VARSIZE("MIXCHOICE")
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	QUALITY += GET_ITEMDATA(LOCAL, "品质")
NEXT
QUALITY /= (VARSIZE("MIXCHOICE") - MATCH(MIXCHOICE, 0))

;使用次数の設定
TRYCCALLFORM ITEM_COUNT_{ARG}
	LOCAL:1 = RESULT
	CALL SET_ITEMDATA, 1100, "使用次数", LOCAL:1
	CALL SET_ITEMDATA, 1100, "使用次数上限", LOCAL:1
CATCH
ENDCATCH
LINE = LINECOUNT

CALL SET_ITEMDATA, 1100, "品质", QUALITY
CALL SET_QUALITY, 1100
$START
;右のSHOWLISTを作成
VARSET R_LIST
LOCAL:1 = 0
;強制特性
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) >= 0
		CONTINUE
	SIF CHOICE:(GAIN_P_LIST:LOCAL)
		CONTINUE
	R_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT
;選択特性
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) < 0
		CONTINUE
	SIF !CHOICE:(GAIN_P_LIST:LOCAL)
		CONTINUE
	R_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT
;引き継がない強制特性
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) >= 0
		CONTINUE
	SIF !CHOICE:(GAIN_P_LIST:LOCAL)
		CONTINUE
	R_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT

;特性のセット
FOR LOCAL, 0, 5
	TEMP = R_LIST:LOCAL
	IF  TEMP && !(CHOICE:TEMP && PROPERTYCOST:TEMP < 0)
		CALL SET_ITEMDATA, 1100, @"特性{LOCAL}", TEMP
	ELSE
		CALL SET_ITEMDATA, 1100, @"特性{LOCAL}", 0
	ENDIF
NEXT
;コスト計算
COST = 0
FOR LOCAL, 0, 特性总数
	SIF CHOICE:LOCAL
		COST += ABS(PROPERTYCOST:LOCAL)
NEXT
	
;品質とコストをセット
CALL SET_ITEMDATA, 1100, "品质", QUALITY
TEMP = 0
;品質アップをチェック
FOR LOCAL, 0, 5
	SELECTCASE GET_ITEMNAME_P(1100, LOCAL)
		CASE "高品質Lv1"
			CALL SET_ITEMDATA(1100, "品质", GET_ITEMDATA(1100, "品质") * 115 / 100)
		CASE "高品質Lv2"
			CALL SET_ITEMDATA(1100, "品质", GET_ITEMDATA(1100, "品质") * 130 / 100)
		CASE "高品質Lv3"
			CALL SET_ITEMDATA(1100, "品质", GET_ITEMDATA(1100, "品质") * 150 / 100)
	ENDSELECT
NEXT
;使用次数の設定
TRYCCALLFORM ITEM_COUNT_{ARG}
	LOCAL:1 = RESULT
	FOR LOCAL, 0, 5
		SELECTCASE GET_ITEMNAME_P(1100, LOCAL)
			CASE "使用次数+1"
				LOCAL:1 += 1
			CASE "使用次数+2"
				LOCAL:1 += 2
			CASE "使用次数+3"
				LOCAL:1 += 3
		ENDSELECT
	NEXT
	CALL SET_ITEMDATA, 1100, "使用次数", LOCAL:1
	CALL SET_ITEMDATA, 1100, "使用次数上限", LOCAL:1
CATCH
ENDCATCH

CALL SET_QUALITY, 1100
CALL SET_REVICE, 1100
$SHOW_START
CLEARLINE LINECOUNT - LINE
CALL LAYER_INIT
LAYER_X = 0
LAYER_Y = 0
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, "　物品につける特性を選んでください。継承特性のうち、上から５つが実際に継承されます。", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2
CALL SHOW_MIX_ITEM_ST, ITEMNUM, 1
LAYER_Y = LAYER_Y + 3
FOR LOCAL, 0, 10
	CALL LAYER_SET, HTML_GETPRINTEDSTR(9 - LOCAL), LAYER_Y + LOCAL
NEXT
CLEARLINE 10
LAYER_Y = LAYER_Y + 10
CALL LAYER_SET, @"┌%"─"*26%┐┌%"─"*26%┐", LAYER_Y
CALL LAYER_SET, @"│%"特性候補",52,LEFT%││%"継承特性",37,LEFT%コスト[{COST,3}/{GET_COSTLV_IN_MIX(), 3}]│", LAYER_Y + 1
CALL LAYER_SET, @"├──┬%"─"*23%┤├──┬%"─"*23%┤", LAYER_Y + 2

LAYER_Y = LAYER_Y + 3
FOR LOCAL, 0, 显示数
	LOCALS '= "│"
	TEMP = L_LIST:(LOCAL + PAGE * 显示数)
	IF TEMP
		L_COLOR = COLOR("DEF")
		SIF CHOICE:TEMP
			L_COLOR = COLOR("p-blue")
		SIF NUM == TEMP && !FLAG:鼠标模式 && MODE == "LEFT"
			L_COLOR = COLOR("p-green")
		LOCALS += ADD_FTAG(@"{PROPERTYCOST:(TEMP),4}", L_COLOR)
		LOCALS += "│"
		LOCALS += ADD_FTAG(ADD_BTAG(@"%"[" + GET_KEYMARK(LOCAL) + "] " +GET_NAME("特性", TEMP),46,LEFT%", UNICODE(10000 + LOCAL)), L_COLOR)
	ELSE
		LOCALS += @"%"",4%│%"",46%"
	ENDIF
	LOCALS += "││"
	TEMP = R_LIST:(LOCAL + PAGE:1 * 显示数)
	IF TEMP
		L_COLOR = COLOR("DEF")
		IF MATCH(R_LIST, TEMP)
			IF CHOICE:TEMP
				IF PROPERTYCOST:TEMP < 0
					L_COLOR = COLOR("gray")
				ELSE
					L_COLOR = COLOR("p-blue")
				ENDIF
			ELSE
				L_COLOR = COLOR("p-red")
			ENDIF
		ENDIF
		SIF NUM == TEMP && !FLAG:鼠标模式 && MODE == "RIGHT"
			L_COLOR = COLOR("p-green")
		LOCALS += ADD_FTAG(@"{PROPERTYCOST:(TEMP),4}", L_COLOR)
		LOCALS += "│"
		LOCALS += ADD_FTAG(ADD_BTAG(@"%"[" + GET_KEYMARK(LOCAL + 27) + "] " +GET_NAME("特性", TEMP),46,LEFT%", UNICODE(10000 + LOCAL + 27)), L_COLOR)
	ELSE
		LOCALS += @"%"",4%│%"",46%"
	ENDIF
	LOCALS += "│"
	CALL LAYER_SET, LOCALS, LAYER_Y + LOCAL
NEXT
CALL LAYER_SET, @"└──┴%"─"*13%" + ADD_BTAG("[-] " + UNICODE(0x25C0), "-") + @" PAGE.{PAGE, 2} " + ADD_BTAG(UNICODE(0x25B6) + " [+] ", "+") + "┘" , LAYER_Y + LOCAL
CALL LAYER_SET, @"└──┴%"─"*13%" + ADD_BTAG("[/] " + UNICODE(0x25C0), "/") + @" PAGE.{PAGE:1, 2} " + ADD_BTAG(UNICODE(0x25B6) + " [*] ", "*") + "┘", LAYER_Y + LOCAL
CALL LAYER_DRAWLINE, LAYER_Y + LOCAL + 1
LAYER_Y = LAYER_Y + LOCAL + 2
LINE:1 = LINECOUNT + LAYER_Y + LOCAL + 2
CALL LAYER_SET, " " * 5 + ADD_BTAG("[ 9] 決定", UNICODE(21009)), LAYER_Y
CALL LAYER_PRINT, , MAXLINE()
ONEINPUTS
ENCODETOUNI %RESULTS%
FLAG:鼠标模式 = (RESULT:1 >= 10000)
SIF RESULTS == UNICODE(21009)
	RESULTS = 9
SIF GET_KEYMARK_NUM(RESULTS) >= 0
	RESULT:1 = GET_KEYMARK_NUM(RESULTS) + 10000
SELECTCASE RESULTS
	CASE "9"
		CALL SHOW_BLANK
		RETURN 1
	CASE "+"
		SIF L_LIST:((PAGE +1) * 显示数) > 0
			PAGE++
	CASE "-"
		SIF PAGE > 0
			PAGE--
	CASE "*"
		SIF R_LIST:((PAGE:1 +1) * 显示数) > 0
			PAGE:1++
	CASE "/"
		SIF PAGE:1 > 0
			PAGE:1++
	CASEELSE
		IF INRANGE(RESULT:1, 10000, 10026)
			TEMP = L_LIST:(RESULT:1 - 10000 + PAGE * 显示数)
			IF TEMP > 0
				IF CHOICE:TEMP
					CHOICE:TEMP = 0
				ELSE
					IF GET_COSTLV_IN_MIX() >= PROPERTYCOST:TEMP + COST
						CHOICE:TEMP = 1
					ELSE
						CLEARLINE 7
						CALL MESSAGE_WINDOW, "", "コストが足りません。", , , , 108
						GOTO START
					ENDIF
				ENDIF
			ENDIF
		ELSEIF INRANGE(RESULT:1, 10027, 10051)
			TEMP = R_LIST:(RESULT:1 - 10027 + PAGE:1 * 显示数)
			IF TEMP > 0
				IF CHOICE:TEMP
					CHOICE:TEMP = 0
				ELSE
					IF GET_COSTLV_IN_MIX() >= ABS(PROPERTYCOST:TEMP) + COST
						CHOICE:TEMP = 1
					ELSE
						CLEARLINE 7
						CALL MESSAGE_WINDOW, "", "コストが足りません。", , , , 108
						GOTO START
					ENDIF
				ENDIF
			ENDIF
		ELSE
			GOTO START
		ENDIF
ENDSELECT
GOTO START


;---------------------------------------------------
;リストに特性の数をとっていく
;ARG 作成予定の物品(継承判定に使う)
;---------------------------------------------------
@SET_PROPERTY_LIST, ARG
#DIMS 継承タイプ
#DIM 継承リスト, 特性总数
#DIM TEMP, 5
#DIM TLV, 1
IF FLAG:商店指令 == GET_NO("商店", "制造霍姆克鲁斯")
	VARSET 継承リスト, 1
ELSE
	CALLFORM ITEM_TYPE_{ARG}
	継承タイプ = %RESULTS%
	VARSET 継承リスト
	FOR LOCAL, 0, 特性总数
		CALL PROPERTY_SUCCESSION, LOCAL
		SIF STRCOUNT(RESULTS, 継承タイプ)
			継承リスト:LOCAL = 1
	NEXT
	TRYCCALLFORM ITEM_HOMU_MATERIAL_{ARG}
		IF RESULT
			VARSET 継承リスト, 1, PROPERTY_TALENT_START(), PROPERTY_TALENT_END() + 1
			VARSET 継承リスト, 1, PROPERTY_ABL_START(), PROPERTY_ABL_END() + 1
			VARSET 継承リスト, 1, PROPERTY_FEATURE_START(), PROPERTY_FEATURE_END() + 1
		ENDIF
	CATCH
	ENDCATCH
ENDIF
;----------------------------------------------------
;特性のリスト化
;----------------------------------------------------
VARSET P_LIST
FOR LOCAL, 0, VARSIZE("MIXCHOICE")
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	FOR LOCAL:1, 0, 5
		TEMP = GET_ITEMDATA(LOCAL, @"特性{LOCAL:1}")
		SIF TEMP > 0 && 継承リスト:TEMP >0
			P_LIST:TEMP++
	NEXT
NEXT
;---------------------------------------------------
;合成なんかで消えるかどうか判定
;---------------------------------------------------
;対象消滅チェック
FOR LOCAL, 0, 特性总数
	SIF !P_LIST:LOCAL
		CONTINUE
	CALL PROPERTY_OFFSET, LOCAL
	TEMP = RESULT, RESULT:1, RESULT:2, RESULT:3, RESULT:4
	TLV = RESULT:5
	;TALENTは特殊処理
	FOR LOCAL:1, 0, 5
		IF IS_PROPERTY_TALENT(LOCAL)
			SIF !TEMP:(LOCAL:1)
				CONTINUE
			;同等级で対消滅チェック
			TEMP:(LOCAL:1) = TEMP:(LOCAL:1) + PROPERTY_TALENT_START() + VARSIZE("TALENT") * TLV
		ENDIF
		IF P_LIST:LOCAL > P_LIST:(TEMP:(LOCAL:1))
			P_LIST:LOCAL -= P_LIST:(TEMP:(LOCAL:1))
			P_LIST:(TEMP:(LOCAL:1)) = 0
		ELSE
			P_LIST:(TEMP:(LOCAL:1)) -= P_LIST:LOCAL
			P_LIST:LOCAL = 0
		ENDIF
	NEXT
NEXT
;合成チェック
FOR LOCAL, 0, 100
	SELECTCASE LOCAL
		CASEELSE
			BREAK
	ENDSELECT
NEXT
;性格の下位ランク消しチェック
FOR LOCAL, 0, 200
	TEMP = LOCAL + PROPERTY_TALENT_START()
	IF P_LIST:(TEMP + VARSIZE("TALENT") * 2)
		TLV = 2
		P_LIST:(TEMP + VARSIZE("TALENT")) = 0
	ELSEIF P_LIST:(TEMP + VARSIZE("TALENT"))
		TLV = 1
	ELSE
		CONTINUE
	ENDIF
	P_LIST:TEMP = 0
	TRYCCALLFORM TALENT_OFFSET_%TALENTNAME:LOCAL%
	CATCH
		CONTINUE
	ENDCATCH
	FOR LOCAL:1, 0, 5
		SIF !RESULT:(LOCAL:1)
			CONTINUE
		SIF TLV == 2
			P_LIST:(RESULT:(LOCAL:1) + PROPERTY_TALENT_START() + VARSIZE("TALENT")) = 0
		P_LIST:(RESULT:(LOCAL:1) + PROPERTY_TALENT_START()) = 0
	NEXT
NEXT
VARSET GAIN_P_LIST
;------------------------------------------------------
;ソート＆登録処理
;------------------------------------------------------
FOR LOCAL, 0, 特性总数
	SIF !P_LIST:LOCAL
		CONTINUE
	GAIN_P_LIST:LOCAL = LOCAL
	GAIN_P_LIST:LOCAL += ABS(PROPERTYCOST:LOCAL) * 10000
	;マイナスの場合1000k加算
	SIF PROPERTYCOST:LOCAL < 0
		GAIN_P_LIST:LOCAL += 1000 * 1000
NEXT
ARRAYSORT GAIN_P_LIST, BACK
FOR LOCAL, 0, 特性总数
	GAIN_P_LIST:LOCAL %= 10000
NEXT

@SHOW_PROPERTY_LIST, ARG, ARG:1
#LOCALSIZE 2
#LOCALSSIZE 2
LOCAL:1 = 20 + ARG:1  * 2
FOR LOCAL, ARG * 25, (ARG + 1) *25
	SIF LOCAL % 5 == 0
		LOCALS = │
	IF GAIN_P_LIST:LOCAL
		IF STRLENS(GET_NAME("特性", GAIN_P_LIST:LOCAL)) > (LOCAL:1 - 4)
			LOCALS:1 '= FORMCELL(GET_NAME("特性", GAIN_P_LIST:LOCAL), LOCAL:1 - 4) + "(" + @"{PROPERTYCOST:(GAIN_P_LIST:LOCAL), 2}" + ")"
			LOCALS:1 '= ADD_BTAG(LOCALS:1, @"特性解说_{GAIN_P_LIST:LOCAL}", GET_NAME("特性", GAIN_P_LIST:LOCAL))
		ELSE
			LOCALS:1 '= @"%GET_NAME("特性", GAIN_P_LIST:LOCAL) + "(" + @"{PROPERTYCOST:(GAIN_P_LIST:LOCAL), 2}" + ")", LOCAL:1, LEFT%"
			LOCALS:1 '= ADD_BTAG(LOCALS:1, @"特性解说_{GAIN_P_LIST:LOCAL}")
		ENDIF
		IF PROPERTYCOST:(GAIN_P_LIST:LOCAL) < 0
			LOCALS += ADD_FTAG(LOCALS:1, COLOR("p-red"))
		ELSE
			LOCALS += LOCALS:1
		ENDIF
	ELSE
		LOCALS += " " * LOCAL:1
	ENDIF
	IF LOCAL % 5 < 4
		IF ARG:1
			LOCALS += "　 "
		ELSE
			LOCALS += "　"
		ENDIF
	ELSE
		HTML_PRINT LOCALS + "│"
	ENDIF
NEXT
;------------------------------------
;分类值の判定関数
;なお、返り值はRESULT:0~4にそれぞれはいる
;
;分类值
;物品個別:品質の平均
;分类指定:物品分类值 + (品質により-10~+12)
;------------------------------------
@GET_CATEGORY_VAR
#LOCALSIZE 2
#DIM 分类值, 4
#DIM ITEMNUM
VARSET LOCAL
VARSET 分类值
FOR LOCAL, 0, 1200
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	SELECTCASE MIXCHOICE:LOCAL
		CASE 1
			LOCAL:1 = 0
		CASE 2
			LOCAL:1 = 1
		CASE 4
			LOCAL:1 = 2
		CASE 8
			LOCAL:1 = 3
	ENDSELECT
	IF GET_MATERIAL_TYPE(LOCAL:1) == "分类"
		ITEMNUM = GET_ITEMDATA(LOCAL, "ID")
		CALLFORM ITEM_CATEGORY_{ITEMNUM}, RESULT:1
		分类值:(LOCAL:1) += RESULT + MAX((GET_ITEMDATA(LOCAL, "品质") -50) / 5, 0)
	ELSE
		分类值:(LOCAL:1) += GET_ITEMDATA(LOCAL, "品质")
	ENDIF
	分类值:(LOCAL:1) += GET_ITEMDATA(LOCAL, "分类加成值")
NEXT
FOR LOCAL, 0, 4
	分类值:LOCAL /= LIMIT(MAX(MATCH(MIXCHOICE, POWER(2, LOCAL)), 1), 0, 120)
NEXT
RETURN 分类值:0, 分类值:1, 分类值:2, 分类值:3

;------------------------------------
;调合物品のコスト值取得関数
;------------------------------------
@GET_COSTLV_IN_MIX, ARG = -1
#FUNCTION
#LOCALSIZE 2
#DIM COSTLV, 4
#DIM COST_REVICE
COST_REVICE = 0
VARSET LOCAL
VARSET COSTLV
FOR LOCAL, 0, 1200
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	SELECTCASE MIXCHOICE:LOCAL
		CASE 1
			LOCAL:1 = 0
		CASE 2
			LOCAL:1 = 1
		CASE 4
			LOCAL:1 = 2
		CASE 8
			LOCAL:1 = 3
	ENDSELECT
	COSTLV:(LOCAL:1) += GET_ITEMDATA(LOCAL, "等级")
	COST_REVICE = MAX(COST_REVICE, GET_ITEMDATA(LOCAL, "消耗加成值"))
NEXT
SIF GET_RECORD_ATTAIN("初級錬金術士")
	COST_REVICE += 2
SIF GET_RECORD_ATTAIN("中級錬金術士")
	COST_REVICE += 2
SIF GET_RECORD_ATTAIN("上級錬金術士")
	COST_REVICE += 3
SIF GET_RECORD_ATTAIN("熟練錬金術士")
	COST_REVICE += 3
SIF GET_RECORD_ATTAIN("最強錬金術士")
	COST_REVICE += 5
FOR LOCAL, 0, 4
	COSTLV:LOCAL /= MAX(MATCH(MIXCHOICE, POWER(2, LOCAL)), 1)
NEXT
IF ARG == -1
	RETURNF COSTLV:0 + COSTLV:1 + COSTLV:2 + COSTLV:3 + COST_REVICE
ELSE
	RETURNF COSTLV:ARG
ENDIF

;------------------------------------
;调合物品のステータス表示関数
