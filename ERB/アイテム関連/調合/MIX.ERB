CALL LAYER_SET, "└" + "─"* 35 + "┘", LAYER_Y + 2

CALL GET_MIX_MP, ARG
LOCAL = RESULT * MIX_NUM
CALL LAYER_SET, "┌" + "─" * 3 + "┬" + "─" * 12 + "┐", LAYER_Y + 3, LAYER_X
CALL LAYER_SET, @"│ＭＰ　│[{BASE:MASTER:MP,4}/{GET_MAXBASE("MP", MASTER),4}]→[{BASE:MASTER:MP - LOCAL,4}/{GET_MAXBASE("MP", MASTER),4}]│", LAYER_Y + 4, LAYER_X
CALL LAYER_SET, "└" + "─" * 3 + "┴" + "─" * 12 + "┘", LAYER_Y + 5, LAYER_X

LAYER_X = 38
CALL GET_MIXEXP, ARG, MIX_NUM
LOCAL = RESULT
