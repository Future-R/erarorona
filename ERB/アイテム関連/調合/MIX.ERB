;---------------------------------------------------------------------
;
;	Module		:MIX.ERB
;	Facility	:アイテム调合関数群
;
;	Licence		:フリー
;
;	Modification Data:アイテム调合のインターフェイス
;
;
;	Edit	Date				Author		Ver			Reason													
;	001		2012/05/30			kap			0.300		新規作成
;	002		2012/07/28			kap						调合後の既知情報の取得を特性選択前に移動				
;														特性選択時に候補がない場合エラー落ちしていたのを修正	
;														GAIN_PROPERTY_LISTを廃止というか、特性関係を大幅変更
;	003		2012/08/18			kap			0.304		アイテム可调合数でMINARRAYの使い方が間違っていたのを修正。ついでに可调合数最少が99のとき打ち切るように修正
;	004		2012/08/19			kap			0.305		リストの幅を変更
;	005		2012/09/04			kap			0.350		主效果の既知情報の獲得処理を追加
;	006		2012/09/19			kap			0.370		特定アイテムを選んだ際に素質特性の相殺処理が機能していなかったのを修正
;														メッセージの点击範囲拡張に対応
;	007		2012/09/26			kap			0.390		アイテムがホムンクルス素材であるときホムンクルスの作成に関する特性が継承されるように
;	008		2012/10/05			kap			0.400		MIX_ITEMから可调合数取得関数を独立させる
;---------------------------------------------------------------------
; 选择要执行的操作的函数
; 可选物品列表由持有的参考书决定
;---------------------------------------------------------------------
@MIX_SELECT
#LOCALSSIZE 6

#DIM TEMP
#DIMS TEMPS, 3
#DIM LAYER_X
#DIM LAYER_Y

#DIM PAGE, 2
#DIM NUM, 2
#DIM MAXNUM

#DIMS SHOW_MODE, 1
#DIM 所需素材
#DIM 所需素材数

#DIM MIX_LIST, 2000
#DIMS MIX_TABLE, 2000
#DIM CATEGORY_ABLE

#DIM ITEMNUM

#DIM 显示数
#DIM C_REDRAW

#DIM 调合类别阈值, 6
#DIM LINE,3

#DIM 持有物品调合类别, 物品总数
#DIM 持有物品数, 物品总数
#DIM 持有类别数, 调合类别要素数


CALL BGM, "萝乐娜的工房.mp3"
C_REDRAW = CURRENTREDRAW()
REDRAW 0
显示数 = 17
LINE = LINECOUNT
VARSET 持有物品
VARSET 持有物品调合类别
VARSET 持有物品数
VARSET 持有类别数
; 为提高速度，将数据存入变量使用
FOR LOCAL, GET_ITEM_RANGE("持有物品"), GET_ITEM_RANGE("持有物品", 1)
	持有物品:LOCAL = GET_ITEMDATA(LOCAL, "ID")
	持有物品调合类别:LOCAL = GET_ITEMDATA(LOCAL, "调合类别")
	SIF 持有物品:LOCAL > 0
		持有物品数:(持有物品:LOCAL)++
	FOR LOCAL:1, 0, 调合类别要素数
		SIF !GETBIT(持有物品调合类别:LOCAL, LOCAL:1)
			CONTINUE
		持有类别数:(LOCAL:1)++
	NEXT
NEXT


FOR LOCAL, 0, 物品总数
	RESULTS = 
	TRYCALLFORM ITEM_RECIPE_{LOCAL}
	SIF RESULTS == ""
		CONTINUE
	MIX_TABLE:LOCAL = %RESULTS%
NEXT
; 初始化变量
VARSET ITEMCHOICE
VARSET MIXLIST
VARSET MIXCHOICE
VARSET P_LIST
VARSET GAIN_P_LIST
$CREATE_LIST
PAGE = 0
PAGE:1 = 0
NUM = 0
NUM:1 = 0
VARSET MIX_LIST, -1
LOCAL:1 = 0
FOR LOCAL, 0, 物品总数
	SIF MIX_TABLE:LOCAL == ""
		CONTINUE
	SIF !RECIPE:GET_NO("参考书", AUTO_SPLIT(MIX_TABLE:LOCAL, "/", 0))
		CONTINUE
	FOR LOCAL:2, 0, 调合类别要素数
		SIF GETBIT(CATEGORY_ABLE, LOCAL:2)
			CONTINUE
		CALLFORM ITEM_CATEGORY_{LOCAL}, LOCAL:2
		SIF RESULT >= 0
			SETBIT CATEGORY_ABLE, LOCAL:2
	NEXT
	IF SHOW_MODE != ""
		RESULTS = 
		TRYCALLFORM ITEM_TYPE_{LOCAL}
	ENDIF
	SELECTCASE AUTO_SPLIT(SHOW_MODE, "_", 0)
		CASE "调合物品"
			SIF !STRCOUNT(RESULTS, "调合")
				CONTINUE
		CASE "消耗品"
			SIF !STRCOUNT(RESULTS, "料理") && !STRCOUNT(RESULTS, "攻击")
				CONTINUE
		CASE "调教物品"
			SIF !STRCOUNT(RESULTS, "调教") && !STRCOUNT(RESULTS, "恢复")
				CONTINUE
		CASE "装备材料"
			SIF !STRCOUNT(RESULTS, "素材")
				CONTINUE
		CASE "调合类别"
			CALLFORM ITEM_CATEGORY_{LOCAL}, AUTO_SPLIT_INT(SHOW_MODE, "_", 1)
			SIF RESULT < 0
				CONTINUE
	ENDSELECT
	MIX_LIST:(LOCAL:1) = LOCAL
	LOCAL:1++
NEXT
$SHOW_START
MAXNUM = 2000 - MATCH(MIX_LIST, -1)
CLEARLINE LINECOUNT - LINE
CALL LAYER_INIT

;---------------------------------------------------
; 头部区域
;---------------------------------------------------
CALL LAYER_DRAWLINE, 0
CALL LAYER_SET, @"　%SHOW_DAY()%　　　-物品调合-%"",50%魔力[{BASE:MASTER:魔力,3}/{GET_MAXBASE("魔力", MASTER),3}]　　　调合等级: {GET_MIXLV()}　", 1
CALL LAYER_DRAWLINE, 2

;---------------------------------------------------
; 调合物品候补
;---------------------------------------------------
LAYER_Y = 3
CALL LAYER_SET, @"┌%"─"*10%┬%"─" * 2%┬%"─"*11%┬%"─"*11%┬%"─"*11%┬%"─"*11%┐", LAYER_Y
CALL LAYER_SET, @"│%"名称",20,LEFT%│%"持有"%│%"素材1",22,LEFT%│%"素材2",22,LEFT%│%"素材3",22,LEFT%│%"素材4",22,LEFT%│", LAYER_Y + 1
TEMPS '= "├"
TEMPS += ADD_BTAG("─"*10, "点击_4")
TEMPS += @"┼%"─"*2%┼%"─"*11%┼%"─"*11%┼%"─"*11%┼%"─"*11%┤"
CALL LAYER_SET, TEMPS, LAYER_Y + 2
FOR LOCAL, PAGE, PAGE + 显示数
	IF MIX_LIST:LOCAL == -1
		TEMPS '= @"│%"",20%│%"",4%│%"",22,LEFT%│%"",22,LEFT%│%"",22,LEFT%│%"",22,LEFT%│"
	ELSE
		VARSET LOCALS, "", 0, 6
		TEMPS '= "│"
		IF GET_KNOWN_ITEM(MIX_LIST:LOCAL, "获得")
			TEMPS += ADD_FTAG(UNICODE(0x273F), COLOR("p-red"))
		ELSE
			TEMPS += "　"
		ENDIF
		TEMPS += ADD_FTAG(ADD_BTAG(@"%GET_NAME("物品", MIX_LIST:LOCAL),18,LEFT%", @"物品_{LOCAL}"), NUM == LOCAL ? COLOR("FOCUS") # COLOR("DEF"))
		TEMPS += @"│{持有物品数:(MIX_LIST:LOCAL), 4}"
		SPLIT MIX_TABLE:(MIX_LIST:LOCAL), "/", LOCALS
		FOR LOCAL:1, 1, 5
			TEMPS += "│"
			IF LOCALS:(LOCAL:1) != ""
				TEMPS:1 = %AUTO_SPLIT(LOCALS:(LOCAL:1), "*", 0)%
				所需素材数 = MAX(AUTO_SPLIT_INT(LOCALS:(LOCAL:1), "*", 1), 1)
				IF STRCOUNT(LOCALS:(LOCAL:1), "【")
					; 把调合类别转为编号
					TEMP = GET_NO("调合类别", SUBSTRINGU(TEMPS:1, 1, STRLENSU(TEMPS:1)-2))
					LOCAL:3 = 持有类别数:TEMP
					IF 所需素材数 > 1
						TEMPS:1 = %TEMPS:1, 16, LEFT% * {所需素材数, 3}
					ELSE
						TEMPS:1 = %TEMPS:1, 22, LEFT%
					ENDIF
					SIF LOCAL:3 < 所需素材数
						TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("gray"))
				ELSE
					TEMP = GET_NO("物品", TEMPS:1)
					TEMPS:1 += "　"
					IF 所需素材数 > 1
						TEMPS:1 = %TEMPS:1, 16, LEFT% * {所需素材数, 3}
					ELSE
						TEMPS:1 = %TEMPS:1, 22, LEFT%
					ENDIF
					TRYCCALLFORM ITEM_RECIPE_{TEMP}
						TEMPS:1 '= ADD_BTAG(TEMPS:1, @"调合_{TEMP}")
					CATCH
					ENDCATCH
					SIF 持有物品数:TEMP < 所需素材数
						TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("gray"))
				ENDIF
			ELSE
				TEMPS:1 = %"", 22%
			ENDIF
			TEMPS += TEMPS:1
		NEXT
		TEMPS += "│"
	ENDIF
	CALL LAYER_SET, TEMPS, LAYER_Y + 3 + (LOCAL - PAGE)
NEXT
TEMPS '= "└"
TEMPS += ADD_BTAG("─"*10, "点击_6")
TEMPS += @"┴%"─"*2%┴%"─"*11%┴%"─"*11%┴%"─"*11%┴%"─"*11%┘"
CALL LAYER_SET, TEMPS, LAYER_Y + 3 + 显示数
CALL LAYER_PRINT, , LAYER_Y + 4 + 显示数
;-------------------------------------------------
; 物品解说
;-------------------------------------------------
LINE:1 = LINECOUNT
CALL SHOW_MIX_ITEM_EXPLAIN, MIX_LIST:NUM

;------------------------------------------
; 选择栏
;------------------------------------------
LAYER_Y = 0
CALL LAYER_INIT
CALL LAYER_DRAWLINE, LAYER_Y
LINE:2 = LINECOUNT + 1
LAYER_Y = LAYER_Y + 1
TEMPS = 
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[1] <<< "), "1")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[4] << "), "4")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[8] < "), "8")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[5] "), "点击_5")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[2] > "), "2")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",9%[6] >> "), "6")
TEMPS += ADD_BTAG(HTML_ESCAPE(@"%"",5%[3] >>>"), "3")
CALL LAYER_SET, TEMPS, LAYER_Y
CALL LAYER_DRAWLINE, LAYER_Y + 1

TEMPS '= " " * 5
FOR LOCAL, 0, 5
	TEMPS:1 '= ADD_BTAG(@"%AUTO_SPLIT("[+]_[-]_[*]_[/]_[.]", "_", LOCAL)% %AUTO_SPLIT("全部/调合物品/消耗品/装备材料/调教物品", "/", LOCAL), 14, LEFT%", "点击_" + AUTO_SPLIT("+_-_*_/_.", "_", LOCAL))
	SIF SHOW_MODE == AUTO_SPLIT("/调合物品/消耗品/装备材料/调教物品", "/", LOCAL)
		TEMPS:1 '= ADD_FTAG(TEMPS:1, COLOR("p-green"))
	TEMPS += TEMPS:1
NEXT
CALL LAYER_SET, TEMPS, LAYER_Y + 2
TEMPS '= " " * 5
TEMPS += ADD_BTAG("[En] 确定　　 　　", "点击_")
TEMPS += ADD_FTAG(ADD_BTAG("[0] 指定调合类别　", "点击_0"), STRCOUNT(SHOW_MODE, "调合类别") ? COLOR("p-green") # COLOR("DEF"))
TEMPS += ADD_BTAG("[7] 帮助　　  　　", "点击_7")
TEMPS += ADD_BTAG("[9] 返回", "点击_9")
CALL LAYER_SET, TEMPS, LAYER_Y + 3
CALL LAYER_PRINT, , LAYER_Y + 3 + 1
CALL EQUATE_LINE, LINE + MAXLINE()
ONEINPUTS

FLAG:鼠标模式 = STRLENS(RESULTS) > 1
SIF RESULTS == "q"
	RESULTS = 物品解说
SIF STRCOUNT("_a_s_d_f_g_h_j_k_l_z_x_c_v_b_", "_" + RESULTS + "_")
	RESULTS '= @"主效果解说_{AUTO_SPLIT_NUM("a_s_d_f_g_h_j_k_l_z_x_c_v_b", "_", RESULTS)}"
SIF AUTO_SPLIT(RESULTS, "_", 0) == "点击"
	RESULTS = %AUTO_SPLIT(RESULTS, "_", 1)%
SELECTCASE AUTO_SPLIT(RESULTS, "_", 0)
	CASE "", "5"
		TEMP = MIX_LIST:NUM
		$MIX
		IF TEMP >= 0
			CLEARLINE LINECOUNT - LINE:2
			CALL MIX_ITEM, TEMP
			IF RESULT == 1
				NUM = 0
				PAGE = 0
				PAGE:1 = 0
				REDRAW C_REDRAW
				RESTART
			ENDIF
		ENDIF
	CASE "0"
		$絞込み開始
		CLEARLINE LINECOUNT - LINE:2
		FOR LOCAL, 0, 4
			FOR LOCAL:1, 0, 8
				TEMP = LOCAL * 8 + LOCAL:1
				IF TEMP == 31
					PRINTBUTTON " [9] 取消", 9
				ELSE
					IF TEMP < 调合类别要素数 && GET_NAME("调合类别", TEMP) != "遗物"
						IF GETBIT(CATEGORY_ABLE, TEMP)
							PRINTBUTTON " [" + GET_KEYMARK(TEMP) + "]" + " " + @"%GET_NAME("调合类别", TEMP), 10, LEFT%", GET_KEYMARK(TEMP)
						ELSE
							SETCOLOR COLOR("gray")
							PRINTPLAINFORM  [%GET_KEYMARK(TEMP)%] %GET_NAME("调合类别", TEMP), 10, LEFT%
							RESETCOLOR
						ENDIF
					ELSE
						PRINTFORM %"", 15%
					ENDIF
				ENDIF
			NEXT
			PRINTL 
		NEXT
		CALL EQUATE_LINE(LINE:2 + 6)
		ONEINPUTS
		IF RESULTS == "9"
			SHOW_MODE = 
		ELSE
			IF INRANGE(GET_KEYMARK_NUM(RESULTS), 0, 调合类别要素数 - 1)
				SHOW_MODE '= @"调合类别_{GET_KEYMARK_NUM(RESULTS)}"
			ELSE
				GOTO 絞込み開始
			ENDIF
		ENDIF
		CALL SHOW_BLANK
		GOTO CREATE_LIST
	CASE "1"
		NUM = LIMIT(PAGE - 显示数 * 4 - 1, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE - 显示数 * 5, 0, MAX(0, MAXNUM - 显示数))
	CASE "4"
		NUM = LIMIT(PAGE - 1, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE - 显示数, 0, MAX(0, MAXNUM - 显示数))
	CASE "8"
		NUM = LIMIT(NUM - 1, 0, MAXNUM - 1)
		SIF PAGE > NUM
			PAGE = LIMIT(PAGE - 1, 0, MAX(0, MAXNUM - 显示数))
	CASE "2"
		NUM = LIMIT(NUM + 1, 0, MAXNUM - 1)
		SIF PAGE + 显示数 - 1 < NUM
			PAGE = LIMIT(PAGE + 1, 0, MAX(0, MAXNUM - 显示数))
	CASE "6"
		NUM = LIMIT(PAGE + 显示数, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE + 显示数, 0, MAX(0, MAXNUM - 显示数))
	CASE "3"
		NUM = LIMIT(PAGE + 显示数 * 5, 0, MAXNUM - 1)
		PAGE = LIMIT(PAGE + 显示数 * 5 , 0, MAX(0, MAXNUM - 显示数))
	CASE "7"
		INVERTBIT MIXHELP, 0
	CASE "+", "-", "*", "/", "."
		SELECTCASE RESULTS
			CASE "+"
				LOCALS = 
			CASE "-"
				LOCALS = 调合物品
			CASE "*"
				LOCALS = 消耗品
			CASE "/"
				LOCALS = 装备材料
			CASE "."
				LOCALS = 调教物品
		ENDSELECT
		SHOW_MODE = \@SHOW_MODE == LOCALS ?  # %LOCALS%\@
		CALL SHOW_BLANK
		GOTO CREATE_LIST
	CASE "9"
		$END
		REDRAW C_REDRAW
		RETURN 1
	CASE "物品解说"
		IF MIX_LIST:NUM >= 0
			TRYCCALLFORM ITEM_EXPLAIN_{MIX_LIST:NUM}
				CLEARLINE LINECOUNT - LINE:2
				CALL MESSAGE_WINDOW, , RESULTS
			CATCH
			ENDCATCH
		ENDIF
	CASE "主效果解说"
		IF MIX_LIST:NUM >= 0
			LOCAL = AUTO_SPLIT_INT(RESULTS, "_", 1) /3
			LOCAL:1 = AUTO_SPLIT_INT(RESULTS, "_", 1) % 3
			IF GET_KNOWN_ITEM(MIX_LIST:NUM, @"主效果{LOCAL}{LOCAL:1}")
				TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{MIX_LIST:NUM}
					TRYCCALLFORM EFFECT_EXPLAIN_{GET_NO("主效果", AUTO_SPLIT(RESULTS, "/", LOCAL:1))}
						CLEARLINE LINECOUNT - LINE:2
						CALL MESSAGE_WINDOW, , RESULTS
					CATCH
					ENDCATCH
				CATCH
				ENDCATCH
			ENDIF
		ENDIF
	CASE "调合类别"
		IF GETBIT(CATEGORY_ABLE, AUTO_SPLIT_INT(RESULTS, "_", 1))
			SHOW_MODE = %RESULTS%
			CALL SHOW_BLANK
			GOTO CREATE_LIST
		ELSE
			CLEARLINE LINECOUNT - LINE:2
			CALL MESSAGE_WINDOW, , @"【%GET_NAME("调合类别", AUTO_SPLIT_INT(RESULTS, "_", 1))%】的配方不存在。"
		ENDIF
	CASE "物品"
		IF NUM == AUTO_SPLIT_INT(RESULTS, "_", 1)
			TEMP = MIX_LIST:NUM
			GOTO MIX
		ELSE
			NUM = AUTO_SPLIT_INT(RESULTS, "_", 1)
		ENDIF
	CASE "调合"
		TEMP = AUTO_SPLIT_INT(RESULTS, "_", 1)
		TRYCCALLFORM ITEM_RECIPE_{TEMP}
			IF RECIPE:GET_NO("参考书", AUTO_SPLIT(RESULTS, "/", 0)) > 0
				CLEARLINE LINECOUNT - LINE:1
				CALL SHOW_MIX_ITEM_EXPLAIN, TEMP
				DRAWLINE
				CALL GET_MIX_ABLE_NUM, TEMP
				IF RESULT
					CALL INPUT_YN_M, "要制作" + GET_NAME("物品", TEMP) + "吗？"
					SIF !RESULT
						GOTO MIX
				ELSE
					CALL MESSAGE_WINDOW, , GET_NAME("物品", TEMP) + "所需调合素材不足。"
				ENDIF
			ELSE
				CLEARLINE LINECOUNT - LINE:1
				CALL SHOW_MIX_ITEM_EXPLAIN, TEMP
				DRAWLINE
				CALL MESSAGE_WINDOW, "", "还不了解" + GET_NAME("物品", TEMP) + "的制作方法。"
			ENDIF
		CATCH
		ENDCATCH
ENDSELECT
; 如果PAGE一次移动2页以上，则加入黑屏转场过渡
SIF ABS(PAGE - PAGE:1) > 1
	CALL SHOW_BLANK 
PAGE:1 = PAGE
GOTO SHOW_START
;-----------------------------------------------------------------------------------------------
; 调合物品说明
;-----------------------------------------------------------------------------------------------
@SHOW_MIX_ITEM_EXPLAIN, ARG
#LOCALSIZE 2
#LOCALSSIZE 6
#DIM LAYER_Y
#DIMS TEMPS
#DIM TEMP
#DIM 调合类别阈值, 6
LAYER_Y = 0
CALL LAYER_INIT
CALL LAYER_SET, @"┌%"─"*10%┬%"─"*2%┬%"─"*11%┬%"─"*11%┬%"─"*11%┬%"─"*11%┐", LAYER_Y
	IF ARG >= 0
		TEMPS '= "│"
		TEMPS += ADD_BTAG(FORMCELL(@"%\@MIXHELP ? [q] # %" "% \@ + GET_NAME("物品", ARG)%", 20, "LEFT"), "物品介绍")
		TEMPS += @"│{MATCH(持有物品, ARG), 4}"
	RESULT = 0
	TRYCALLFORM ITEM_LV_{ARG}
	TEMPS += @"│%@"目标等级: {RESULT,2}",22,LEFT%"
	CALL MIX_SUCCESS_RATE, ARG
	TEMPS += @"│%@"成功率: {RESULT,4}\%", 22, LEFT%"
	CALL GET_MIX_DAY, ARG
	RESULTS = %TOSTR(RESULT/10)%
	SIF RESULT % 10
		RESULTS += "." + TOSTR(RESULT%10)
	TEMPS += @"│%@"%RESULTS,4%天/ 1个",22,LEFT%"
	CALL GET_MIX_MP, ARG
	TEMPS += @"│%@"{RESULT,4}魔力/ 1个",22,LEFT%│"
	RESULTS = 
ELSE
	TEMPS '= @"│%"",20%│%"",4%│%"",22%│%"",22%│%"",22%│%"",22%│"
ENDIF
CALL LAYER_SET, TEMPS, LAYER_Y + 1
CALL LAYER_SET, @"├%"─"*5%┬%"─"*4%┴%"─"*2%┴%"─"*1%┬%"─"*9%┼%"─"*9%┬%"─"*1%┴%"─"*11%┴%"─"*11%┤", LAYER_Y + 2
FOR LOCAL, 0, 4
	TEMPS '= @"│ %@"效果{LOCAL+1}", 9,LEFT%"
	VARSET RESULT, 999, 0, 6
	TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{ARG}
		调合类别阈值 = 0, RESULT / 2, RESULT:1 / 2, RESULT:2 / 2, RESULT:3 / 2, 999
		VARSET LOCALS, "", 0, 5
		SPLIT RESULTS, "/", LOCALS
		; 输出效果说明
		FOR LOCAL:1, 0, 3
			TEMPS += "│"
			IF LOCALS:(LOCAL:1) != ""
				IF GET_KNOWN_ITEM(ARG, @"主效果{LOCAL}{LOCAL:1}")
					TEMPS += ADD_BTAG(FORMCELL(@"%\@MIXHELP ? [%AUTO_SPLIT("a_s_d_f_g_h_j_k_l_z_x_c_v_b", "_", LOCAL *3 + LOCAL:1)%] #\@ + LOCALS:(LOCAL:1)%",18, "LEFT") , @"主效果解说_{LOCAL *3 + LOCAL:1}")
				ELSE
					TEMPS += @"%"????",18,LEFT%"
				ENDIF
			ELSE
				TEMPS += @"%"", 18%"
			ENDIF
		NEXT
		TEMPS += "│"
		FOR LOCAL:1, 0, 4
			TEMPS += ADD_FTAG(@"%UNICODE(0x2580)%" * (LIMIT(调合类别阈值:(LOCAL:1 + 1), 0, 50) - LIMIT(调合类别阈值:(LOCAL:1), 0, 50)), COLOR(AUTO_SPLIT("gray/p-blue/p-green/p-red", "/", LOCAL:1)))
		NEXT
		TEMPS += @"%UNICODE(0x2580)%" * MAX(50 - 调合类别阈值:4, 0)
	CATCH
		FOR LOCAL:1, 0, 3
			TEMPS += @"│%"",18%"
		NEXT
		TEMPS += @"│%"",50%"
	ENDCATCH
	TEMPS += "│"
	CALL LAYER_SET, TEMPS, LAYER_Y + 3 + LOCAL
NEXT
CALL LAYER_SET, @"├%"─"*5%┴%"─"*9%┴%"─"*9%┴%"─"*9%┴%"─"* 25%┤", LAYER_Y + 7
LOCALS = 
FOR LOCAL:1, 0, 调合类别要素数
	TRYCCALLFORM ITEM_CATEGORY_{ARG}, LOCAL:1
		SIF RESULT >= 0
			LOCALS += " " + GET_NAME("调合类别", LOCAL:1)
	CATCH
		BREAK
	ENDCATCH
NEXT
CALL LAYER_SET, @"│%LOCALS,122,LEFT%│", LAYER_Y + 8
CALL LAYER_SET, @"└%"─"*61%┘", LAYER_Y + 9
CALL LAYER_PRINT, , LAYER_Y + 10
;------------------------------------
; 在前半部分获取可调合数量
; 在后半部分把所需素材集合传给 SHOW_ITEMLIST
; ARG：要调合的物品编号
;------------------------------------
@MIX_ITEM, ARG
#LOCALSIZE 12
#LOCALSSIZE 4
#DIM TEMP
#DIM C_REDRAW
#DIM LINE,5
#DIM LAYER_X
#DIM LAYER_Y

#DIMS 素材名, 5
#DIM 素材所需数, 4
#DIM 原选择数, 4
#DIM 原选择, 4810

#DIM MIX_NUM
#DIM MIX_ABLE_NUM
#DIM EXP_PREV
#DIM EXP_NEXT
#DIM MP_PREV
#DIM MP_NEXT

#DIM TEMPLV
#DIM P_PAGE

#DIM MIX_SUM

#DIM 调合类别阈值, 6
#DIM 调合类别值, 4
#DIM 选择数, 4

#DIMS 调合类别
#DIMS 调合图像

; #DIM SCORE

CALL GET_MIX_ABLE_NUM, ARG
MIX_ABLE_NUM = RESULT

IF !MIX_ABLE_NUM
	CALL MESSAGE_WINDOW, "", "材料不足"
	RETURN 0
ENDIF

;------------------------------------------------------------------------------
; 输入调合数量
;------------------------------------------------------------------------------
CALL MESSAGE_WINDOW, "", "请输入要调合的数量"
CALL INPUT_MANY, 0, MIN(MIX_ABLE_NUM, 99)
MIX_NUM = RESULT
CALL SHOW_BLANK
SIF !MIX_NUM
	RETURN 0

;-------------------------------------------------
; 获取配方所需素材
;-------------------------------------------------
VARSET 素材所需数
VARSET 素材名, "", 0, 5

CALLFORM ITEM_RECIPE_{ARG}
SPLIT RESULTS, "/", 素材名
ARRAYREMOVE 素材名, 0, 1

FOR LOCAL, 0, 4
	SIF 素材名:LOCAL == ""
		CONTINUE
	LOCALS:1 = 
	SPLIT 素材名:LOCAL, "*", LOCALS
	; 获取所需数量
	素材所需数:LOCAL = LOCALS:1 != "" ? TOINT(LOCALS:1) # 1
	素材所需数:LOCAL *= MIX_NUM
	IF STRCOUNT(LOCALS, "【")
		CALLF GET_MATERIAL_TYPE(LOCAL, "调合类别", GET_NO("调合类别", SUBSTRINGU(LOCALS, 1, STRLENSU(LOCALS)-2)))
	ELSE
		CALLF GET_MATERIAL_TYPE(LOCAL, "分别", GET_NO("物品", LOCALS))
	ENDIF
NEXT


P_PAGE = 0
VARSET 选择数
; 为模板准备临时空间
CALL DEL_ITEMDATA, GET_TEMP_ITEM_SLOT()
; 设置 ID
CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "ID", ARG
;--------------------------------------------------------------------------
; 确定要调合的物品
;--------------------------------------------------------------------------
; MIX_SELECT 预定
VARSET MIXLIST
FOR LOCAL, 0, GET_ITEM_RANGE("持有", 1)
	SIF GET_ITEMDATA(LOCAL, "ID") <= 0
		CONTINUE
	FOR LOCAL:1, 0, 4
		SIF !素材所需数:(LOCAL:1)
			CONTINUE
		LOCALS:2 = %GET_MATERIAL_TYPE(LOCAL:1)%
		IF LOCALS:2 == "调合类别"
			SIF !GET_CATEGORY(LOCAL, GET_NAME("调合类别", RESULT:1))
				CONTINUE
		ELSE
			SIF GET_ITEMDATA(LOCAL, "ID") != RESULT:1
				CONTINUE
		ENDIF
		SETBIT MIXLIST:LOCAL, LOCAL:1
	NEXT
NEXT
VARSET MIXCHOICE
CALL INVALIDATE_MIX_SELECTION_CACHE
LINE = LINECOUNT
;--------------------------------------------------------------------------
; 开始显示
;--------------------------------------------------------------------------
$START
CALL INIT_LAYER
CLEARLINE LINECOUNT - LINE

; 顶部区域
CALL LAYER_DRAWLINE, 0

CALL LAYER_DRAWLINE, 2


LAYER_Y = 3
LAYER_X = 0
; 上部区域
	CALL GET_MIX_DAY, ARG
	RESULT *= MIX_NUM
	LOCAL = RESULT / 10 + (RESULT % 10 > 0)
	CALL LAYER_SET, "┌" + "─" * 35 + "┐", LAYER_Y
	CALL LAYER_SET, "│" + @"%SHOW_DAY(), 33, LEFT% →  %SHOW_DAY(DAY + LOCAL), 32,LEFT%" + "│", LAYER_Y + 1
	CALL LAYER_SET, "└" + "─"* 35 + "┘", LAYER_Y + 2

	CALL LAYER_SET, "┌" + "─" * 16 + "┐", LAYER_Y, 76
	CALL LAYER_SET, "│ " + ADD_BTAG(FORMCELL("[@] 随机投入素材", 30, "LEFT"), "@") + " │", LAYER_Y + 1, 76
	CALL LAYER_SET, "└" + "─" * 16 + "┘", LAYER_Y + 2, 76

	CALL GET_MIX_MP, ARG
	LOCAL = RESULT * MIX_NUM
CALL LAYER_SET, "┌" + "─" * 3 + "┬" + "─" * 12 + "┐", LAYER_Y + 3, LAYER_X
CALL LAYER_SET, @"│魔力　│[{BASE:MASTER:魔力,4}/{GET_MAXBASE("魔力", MASTER),4}]→[{BASE:MASTER:魔力 - LOCAL,4}/{GET_MAXBASE("魔力", MASTER),4}]│", LAYER_Y + 4, LAYER_X
CALL LAYER_SET, "└" + "─" * 3 + "┴" + "─" * 12 + "┘", LAYER_Y + 5, LAYER_X

LAYER_X = 38
CALL GET_MIXEXP, ARG, MIX_NUM
LOCAL = RESULT
CALL LAYER_SET, "┌" + "─" * 3 + "┬" + "─" * 12 + "┐", LAYER_Y + 3, LAYER_X
CALL LAYER_SET, @"│ＥＸＰ│[{GET_MIXEXP_NOW(),4}/{GET_MIXEXP_NEXT(), 4}]→[{GET_MIXEXP_NOW()+LOCAL,4}/{GET_MIXEXP_NEXT(), 4}]│", LAYER_Y + 4, LAYER_X
CALL LAYER_SET, "└" + "─" * 3 + "┴" + "─" * 12 + "┘", LAYER_Y + 5, LAYER_X

LAYER_X = 76
CALL MIX_SUCCESS_RATE, ARG
LOCAL = RESULT
CALL LAYER_SET, "┌" + "─" * 3 + "┬" + "─" * 12 + "┐", LAYER_Y + 3, LAYER_X
CALL LAYER_SET, @"│成功率│ %TOSTR(LOCAL) + "\%",23,LEFT%│", LAYER_Y + 4, LAYER_X
CALL LAYER_SET, "└" + "─" * 3 + "┴" + "─" * 12 + "┘", LAYER_Y + 5, LAYER_X
CALL LAYER_DRAWLINE, LAYER_Y + 6
;-------------------------------------
; 素材栏
;-------------------------------------
LAYER_Y = LAYER_Y + 7
FOR LOCAL, 0 , 4
	LAYER_X = 28 * LOCAL
	IF 素材所需数:LOCAL
		LOCAL:1 = 素材所需数:LOCAL == 选择数:LOCAL ? COLOR("p-blue") # COLOR("DEF")
		CALL LAYER_SET, ADD_FTAG(ADD_BTAG("┌" + "─" * 12 + "┐", TOSTR(LOCAL)), LOCAL:1), LAYER_Y, LAYER_X
		CALL LAYER_SET, ADD_FTAG(ADD_BTAG(@"│ [{LOCAL}]%素材名:LOCAL,20,LEFT%│", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 1, LAYER_X
		CALL LAYER_SET, ADD_FTAG(ADD_BTAG("├" + "─" * 12 + "┤", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 2, LAYER_X
		CALL LAYER_SET, ADD_FTAG(ADD_BTAG(@"│%"所需数　["+@"{素材所需数:LOCAL,3}"+"]",24,LEFT%│", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 3, LAYER_X
		CALL LAYER_SET, ADD_FTAG(ADD_BTAG(@"│%"选择数　["+@"{选择数:LOCAL,3}"+"]",24,LEFT%│", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 4, LAYER_X
		CALL LAYER_SET, ADD_FTAG(ADD_BTAG("└" + "─" * 12 + "┘", TOSTR(LOCAL)), LOCAL:1), LAYER_Y + 5, LAYER_X
	ELSE
		CALL LAYER_SET, ADD_FTAG("┌" + "─" * 12 + "┐", COLOR("gray")), LAYER_Y, LAYER_X
		CALL LAYER_SET, ADD_FTAG(@"│ [{LOCAL}]%"",20,LEFT%│", COLOR("gray")), LAYER_Y + 1, LAYER_X
		CALL LAYER_SET, ADD_FTAG("├" + "─" * 12 + "┤", COLOR("gray")), LAYER_Y + 2, LAYER_X
		CALL LAYER_SET, ADD_FTAG("│" + " " * 24 + "│", COLOR("gray")), LAYER_Y + 3, LAYER_X
		CALL LAYER_SET, ADD_FTAG("│" + " " * 24 + "│", COLOR("gray")), LAYER_Y + 4, LAYER_X
		CALL LAYER_SET, ADD_FTAG("└" + "─" * 12 + "┘", COLOR("gray")), LAYER_Y + 5, LAYER_X
	ENDIF
NEXT
;------------------------------------
; 调合物品的预计性能
;------------------------------------
LAYER_Y = LAYER_Y + 6
CALL SHOW_MIX_ITEM_ST, ARG
FOR LOCAL, 0, 10
	CALL LAYER_SET, HTML_GETPRINTEDSTR(9 - LOCAL), LAYER_Y + LOCAL
NEXT
CLEARLINE 10
LAYER_Y = LAYER_Y + 10
CALL LAYER_SET, @"┌%"─"*54%┐", LAYER_Y
CALL SHOW_PROPERTY_LIST, P_PAGE
FOR LOCAL, 0, 4
	CALL LAYER_SET, HTML_GETPRINTEDSTR(4 - LOCAL), LAYER_Y + LOCAL + 1
NEXT
CLEARLINE 4
CALL LAYER_SET, @"└%"─"*44%" + ADD_BTAG("[q] " + UNICODE(0x25C0), "q") + @" 页码.{P_PAGE,2} " + ADD_BTAG(UNICODE(0x25B6) + " [w]", "w") + " ┘", LAYER_Y + 5

; 菜单
CALL LAYER_DRAWLINE, LAYER_Y + 6
LINE:1 = LINECOUNT + LAYER_Y + 7
IF !((选择数:0 == 素材所需数:0) && (选择数:1 == 素材所需数:1) && (选择数:2 == 素材所需数:2) && (选择数:3 == 素材所需数:3))
	CALL LAYER_SET, ADD_FTAG(ADD_BTAG("[En] 调合", "En"), COLOR("gray")), LAYER_Y + 7
ELSE
	CALL LAYER_SET, ADD_BTAG("[En] 调合", "En"), LAYER_Y + 7
ENDIF
CALL LAYER_SET, ADD_BTAG("[ 9] 返回", "9"), LAYER_Y + 8
CALL LAYER_PRINT, , MAXLINE()
;------------------------------------
; 开始输入
;------------------------------------
ONEINPUTS
SELECTCASE RESULTS
	CASE "", "En"
		IF (选择数:0 == 素材所需数:0) && (选择数:1 == 素材所需数:1) && (选择数:2 == 素材所需数:2) && (选择数:3 == 素材所需数:3)
			CALL GET_MIX_DAY, ARG
			LOCAL = (RESULT * MIX_NUM) / 10 + (RESULT * MIX_NUM % 10 > 0)
			CALL GET_MIXEXP, ARG, MIX_NUM
			TEMPLV = GET_MIXLV()
			LOCAL:3 = -999
			EXP_PREV = BASE:MASTER:调合经验值
			EXP_NEXT = BASE:MASTER:调合经验值 + RESULT
			CALL GET_MIX_MP, ARG
			MP_PREV = BASE:MASTER:魔力
			MP_NEXT = BASE:MASTER:魔力 - RESULT * MIX_NUM
			; 决定采用什么图像
			调合类别 =
			FOR LOCAL:1, 0, 调合类别要素数
				CALLFORM ITEM_CATEGORY_{ARG}, LOCAL:1
				SIF RESULT >= 0
					调合类别 += " (" + GET_NAME("调合类别", LOCAL:1) + ")"
			NEXT
			IF GET_NAME("物品", ARG) == "中和剂" || GROUPMATCH(调合类别, "(液体)", "(调味料)", "药品")
				调合图像 = 炼金_液体
			ELSE
				调合图像 = 炼金_通常
			ENDIF
			IF RAND:2 == 0
				调合图像 += "_妹妹"
			ELSE
				调合图像 += "_弟弟"
			ENDIF
			
			LINE:2 = LINECOUNT
			FOR LOCAL:1, 0, LOCAL + 1
				CLEARLINE LINECOUNT - LINE:2
				LINE:3 = LINECOUNT
				FOR LOCAL:2, 0, 8
					CLEARLINE LINECOUNT - LINE:3
					IF LOCAL:1 == LOCAL
						BASE:MASTER:调合经验值 = EXP_NEXT
						BASE:MASTER:魔力 = MAX(MP_NEXT, 0)
					ELSE
						BASE:MASTER:调合经验值 = (EXP_PREV * (LOCAL * 8 - LOCAL:1 * 8 - LOCAL:2) + EXP_NEXT * (LOCAL:1 * 8 + LOCAL:2)) / (LOCAL * 8)
						BASE:MASTER:魔力 = MAX((MP_PREV * (LOCAL * 8 - LOCAL:1 * 8 - LOCAL:2) + MP_NEXT * (LOCAL:1 * 8 + LOCAL:2)) / (LOCAL * 8), 0)
					ENDIF
					IF GET_MIXLV() > TEMPLV
						TEMPLV = GET_MIXLV()
						LOCAL:3 = LOCAL:1 * 8 + LOCAL:2
					ENDIF
					CALL INIT_LAYER
					LAYER_X = 0
					LAYER_Y = 0
					CALL LAYER_DRAWLINE, LAYER_Y
					CALL LAYER_SET, @"　%@"第{YEAR()}年 {MONTH()}月 {DAYS()}日",28,LEFT%调合%GET_NAME("物品", ARG)%", LAYER_Y + 1
					CALL LAYER_DRAWLINE, LAYER_Y + 2
					CALL LAYER_SET, CALLNAME:MASTER, LAYER_Y + 3
					CALL LAYER_SET, @"调合等级: {GET_MIXLV()}", LAYER_Y + 4
					{
					CALL LAYER_SET, "魔力　　: " + 
									LAYER_CBAR(BASE:MASTER:魔力, GET_MAXBASE("魔力", MASTER), 80, "▮", "▮", BARCOLORSET("緑"), RESULT:1) + 
									@"　{BASE:MASTER:魔力,4}/{GET_MAXBASE("魔力", MASTER),4} "
									, LAYER_Y + 5
					}
					IF GET_MIXLV() == 50
						{
						CALL LAYER_SET, "经验值　: " + 
										LAYER_CBAR(0, 1, 100, "▮", "▮", BARCOLORSET("紫"), RESULT:1) + 
										@"　{GET_MIXEXP_NOW(),4}/{GET_MIXEXP_NEXT(),4} \@ LOCAL:3 + 8 > LOCAL:1 * 8 + LOCAL:2 ? 升级！ # \@"
										, LAYER_Y + 6
						}
					ELSE
						{
						CALL LAYER_SET, "经验值　: " + 
										LAYER_CBAR(GET_MIXEXP_NOW(), GET_MIXEXP_NEXT(), 80, "▮", "▮", BARCOLORSET("紫"), RESULT:1) + 
										@"　{GET_MIXEXP_NOW(),4}/{GET_MIXEXP_NEXT(),4} \@ LOCAL:3 + 8 > LOCAL:1 * 8 + LOCAL:2 ? 升级！ # \@"
										, LAYER_Y + 6
						}
					ENDIF
					CALL LAYER_DRAWLINE, LAYER_Y + 7
					CALL LAYER_SET, GET_SINGLE_IMAGE(调合图像, 2700, 450), LAYER_Y + 8
					CALL LAYER_SET, "┌" + "─" * ((MAXWIDTH()-4)/2) + "┐", MAXLINE() - 6
					CALL LAYER_SET, "│" + FORMCELL("调合中" + "……" * ((LOCAL:2 / 2) % 4), (MAXWIDTH()-4), "LEFT") + "│", MAXLINE() - 5
                    CALL LAYER_SET, "│" + " " * (MAXWIDTH()-4) + "│", MAXLINE() - 4
                    CALL LAYER_SET, "│" + " " * (MAXWIDTH()-4) + "│", MAXLINE() - 3
                    CALL LAYER_SET, "│" + " " * (MAXWIDTH()-4) + "│", MAXLINE() - 2
                    CALL LAYER_SET, "└" + "─" * ((MAXWIDTH()-4)/2) + "┘", MAXLINE() - 1
					CALL LAYER_PRINT
					; CALL MESSAGE_WINDOW, "", "正在调合" + "…" * ((LOCAL:2 / 2) % 4), , "没有动画/不再等待/不留日志/无需点击"
					TWAIT 100, 1
				NEXT
				SIF LOCAL:1 < LOCAL
					CALL ADD_DAY, 1
			NEXT
			CLEARLINE LINECOUNT - LINE:3
			CALL LAYER_PRINT, , MAXLINE() - 6
			; 成功判定：当 MP 小于 0 时，在此处进行 50% 判定
			CALL MIX_SUCCESS_RATE, ARG
			IF RESULT > RAND:(100 + (MP_NEXT < 0) * 100)
				CALL MESSAGE_WINDOW, "", @"调合成功！！/%GET_NAME("物品", ARG)%制作完毕！/请选择要保留的特性。"
			ELSE
				CALL MESSAGE_WINDOW, "", @"调合失败！！/出现了损坏的物品……/请选择要保留的特性。"
				ARG = GET_NO("物品", "损坏的物品")
				CALL SET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "ID", GET_NO("物品", "损坏的物品"))
			ENDIF
			; 设置已知信息
			CALL SET_KNOWN_ITEM, ARG, "获得"
			FOR LOCAL, 0, 4
				TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{ARG}
					FOR LOCAL:1, 0 , 3
						IF GET_ITEMNAME_E(GET_TEMP_ITEM_SLOT(), LOCAL) == AUTO_SPLIT(RESULTS, "/", LOCAL:1)
							CALL SET_KNOWN_ITEM, ARG, @"主效果{LOCAL}{LOCAL:1}"
							CALL SET_KNOWN_EFFECT, GET_ITEMNAME_E(GET_TEMP_ITEM_SLOT(), LOCAL), "SET"
						ENDIF
					NEXT
				CATCH
				ENDCATCH
			NEXT
			; 确定调合类别
			CALL SET_CATEGORY, GET_TEMP_ITEM_SLOT()
			; 等级设置
			CALLFORM ITEM_LV_{ARG}
			CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "等级", RESULT
			; 确定特性、等级与品质
			CALL SET_PROPERTY_MIX, ARG
			; 设置价格
			CALL SET_PRICE, GET_TEMP_ITEM_SLOT()
			; 删除素材
			CALL DEL_MIX_MATERIAL
			; 注册物品
			ITEMCHOICE:GET_TEMP_ITEM_SLOT() = 1
			; 临时放入
			FOR LOCAL, GET_TEMP_ITEM_SLOT(1), GET_TEMP_ITEM_SLOT() + MIX_NUM
				FOR LOCAL:1, 0, 物品要素数
					DA:LOCAL:(LOCAL:1) = DA:GET_TEMP_ITEM_SLOT():(LOCAL:1)
				NEXT
				ITEMCHOICE:LOCAL = 1
			NEXT
			; 设置最高分
			CALL SET_HIGHEST_SCORE_ITEM, ARG, GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质")
			; 触发炼金事件
			CALL START_EVENT, 1
			CLEARLINE LINECOUNT - LINE
			CALL MOVE_ITEM, "箱子"
			SIF RESULT
				CALL MOVE_ITEM, "篮子"
			VARSET ITEMCHOICE
			VARSET MIXLIST
			VARSET MIXCHOICE
			CALL INVALIDATE_MIX_SELECTION_CACHE
			CLEARLINE LINECOUNT - LINE:1
			; 根据调合等级判定成就
			FOR LOCAL, 0, 10
				TEMP = LOCAL + GET_NO("成就", "外行炼金术士")
				SIF GET_RECORD_ATTAIN(TEMP)
					CONTINUE
				SIF GET_MIXLV() < (LOCAL + 1) * 5
					BREAK
				CALL MESSAGE_WINDOW, "", @"因为调合等级达到{(LOCAL+1) * 5}，/达成了【%GET_NAME("成就", TEMP)%】！"
				CALL SET_RECORD_ATTAIN, TEMP, 1
			NEXT
			MIX_SUM = 0
			FOR LOCAL, 调合品起始编号, 调合品结束编号
				MIX_SUM += GET_KNOWN_ITEM(LOCAL, "获得")
			NEXT
			FOR LOCAL, 0, 6
				TEMP = LOCAL + GET_NO("成就", "炼金知识四级")
				SIF GET_RECORD_ATTAIN(TEMP)
					CONTINUE
				SIF MIX_SUM < AUTO_SPLIT_INT("10_25_40_60_75_90", "_", LOCAL)
					BREAK
				CALL MESSAGE_WINDOW, "", @"{AUTO_SPLIT_INT("10_25_40_60_75_90", "_", LOCAL)}种类的物品调配/【%GET_NAME("成就", TEMP)%】！"
				CALL SET_RECORD_ATTAIN, TEMP, 1
			NEXT
			CALL SHOW_BLANK
			RETURN 1
		ENDIF
	CASE "0", "1", "2", "3"
		CALL SHOW_BLANK
		LOCAL = TOINT(RESULTS)
		CALL SHOW_ITEMLIST("调合", , LOCAL, @"%素材名:LOCAL%/{素材所需数:LOCAL}/{ARG}")
		选择数:LOCAL = RESULT
		CALL REFRESH_MIX_PREVIEW, ARG
		CALL SHOW_BLANK
		GOTO START
	CASE "@"
		FOR LOCAL, 0, VARSIZE("MIXCHOICE")
			原选择:LOCAL = MIXCHOICE:LOCAL
		NEXT
		FOR LOCAL, 0, 4
			原选择数:LOCAL = 选择数:LOCAL
		NEXT
		FOR LOCAL:10, 0, 11
			VARSET MIXCHOICE
			VARSET 选择数
			LOCAL:11 = 1
			; 先填固定指定物品，避免占用掉稀缺素材。
			FOR LOCAL, 0, 4
				SIF !素材所需数:LOCAL
					CONTINUE
				SIF GET_MATERIAL_TYPE(LOCAL) == "调合类别"
					CONTINUE
				FOR LOCAL:1, 0, 素材所需数:LOCAL
					TEMP = MIX_RANDOM_PICK(LOCAL)
					IF TEMP < 0
						LOCAL:11 = 0
						BREAK
					ENDIF
					MIXCHOICE:TEMP = POWER(2, LOCAL)
					选择数:LOCAL++
				NEXT
				SIF !LOCAL:11
					BREAK
			NEXT
			SIF !LOCAL:11
				CONTINUE
			LOCAL:8 = 选择数:0 + 选择数:1 + 选择数:2 + 选择数:3
			LOCAL:9 = 素材所需数:0 + 素材所需数:1 + 素材所需数:2 + 素材所需数:3
			; 类别素材按当前可选数最少的槽位优先填充，尽量避免随机把可共用素材用错地方。
			WHILE LOCAL:8 < LOCAL:9
				LOCAL:5 = -1
				LOCAL:6 = 999999
				FOR LOCAL, 0, 4
					SIF !素材所需数:LOCAL || 选择数:LOCAL >= 素材所需数:LOCAL
						CONTINUE
					SIF GET_MATERIAL_TYPE(LOCAL) != "调合类别"
						CONTINUE
					TEMP = MIX_RANDOM_CANDIDATE_COUNT(LOCAL)
					IF TEMP <= 0
						LOCAL:11 = 0
						BREAK
					ENDIF
					IF TEMP < LOCAL:6 || (TEMP == LOCAL:6 && RAND:2 == 0)
						LOCAL:5 = LOCAL
						LOCAL:6 = TEMP
					ENDIF
				NEXT
				IF !LOCAL:11 || LOCAL:5 < 0
					LOCAL:11 = 0
					BREAK
				ENDIF
				CALL MIX_RANDOM_PICK_BEST, LOCAL:5, ARG, MIX_NUM
				TEMP = RESULT
				IF TEMP < 0
					LOCAL:11 = 0
					BREAK
				ENDIF
				MIXCHOICE:TEMP = POWER(2, LOCAL:5)
				选择数:(LOCAL:5) += 1
				LOCAL:8++
			WEND
			IF LOCAL:11
				CALL REFRESH_MIX_PREVIEW, ARG
				GOTO START
			ENDIF
		NEXT
		FOR LOCAL, 0, VARSIZE("MIXCHOICE")
			MIXCHOICE:LOCAL = 原选择:LOCAL
		NEXT
		VARSET 选择数
		FOR LOCAL, 0, 4
			选择数:LOCAL = 原选择数:LOCAL
		NEXT
		CALL REFRESH_MIX_PREVIEW, ARG
		CALL MESSAGE_WINDOW, "", "随机填充失败，请手动选择素材。"
	CASE "9"
		VARSET MIXLIST
		VARSET MIXCHOICE
		CALL INVALIDATE_MIX_SELECTION_CACHE
		CALL SHOW_BLANK
		RETURN 0
	CASE "q"
		SIF P_PAGE > 0
			P_PAGE--
	CASE "w"
		SIF GAIN_P_LIST:((P_PAGE+1) * 25)
			P_PAGE++
ENDSELECT
GOTO START
;------------------------------------------------
; ARG : 要调合的物品编号
; RESULT : 可调合数量
; 获取配方
;------------------------------------------------
@GET_MIX_ABLE_NUM, ARG
#DIMS 素材名, 5
#DIM 素材编号, 4
#DIM 素材所需数, 4
#DIM 素材调合类别, 4

#DIM 素材掩码数, 16
#DIM 素材可用数, 4
#DIM 素材数, 1
#DIM 最大可调合数
#DIM 槽位需求
#DIM 槽位供给

VARSET 素材编号, -1
VARSET 素材调合类别, -1
VARSET 素材所需数
VARSET 素材名, "", 0, 5

;------------------------------------------------------------------------------------------
; 获取配方
;------------------------------------------------------------------------------------------
CALLFORM ITEM_RECIPE_{ARG}
SPLIT RESULTS, "/", 素材名
ARRAYREMOVE 素材名, 0, 1
素材数 = 0
FOR LOCAL, 0, 4
	SIF 素材名:LOCAL == ""
		CONTINUE
	LOCALS:1 = 
	SPLIT 素材名:LOCAL, "*", LOCALS
	; 获取所需数量
	素材所需数:LOCAL = LOCALS:1 != "" ? TOINT(LOCALS:1) # 1
	IF STRCOUNT(LOCALS, "【")
		素材调合类别:LOCAL = GET_NO("调合类别", SUBSTRINGU(LOCALS, 1, STRLENSU(LOCALS)-2))
		CALLF GET_MATERIAL_TYPE(LOCAL, "调合类别", 素材调合类别:LOCAL)
	ELSE
		素材编号:LOCAL = GET_NO("物品", LOCALS)
		CALLF GET_MATERIAL_TYPE(LOCAL, "分别", 素材编号:LOCAL)
	ENDIF
	素材数++
NEXT
;------------------------------------------------------------------------------------------
; 获取最大可调合数
;------------------------------------------------------------------------------------------
VARSET 素材掩码数, 0
VARSET 素材可用数, 0

; 将当前持有素材聚合成“能满足哪些槽位”的掩码计数。
FOR LOCAL, 0, GET_ITEM_RANGE("持有", 1)
	SIF GET_ITEMDATA(LOCAL, "ID") <= 0
		CONTINUE
	LOCAL:1 = 0
	FOR LOCAL:2, 0, 素材数
		IF 素材调合类别:(LOCAL:2) >= 0
			SIF !GET_CATEGORY(LOCAL, GET_NAME("调合类别", 素材调合类别:(LOCAL:2)))
				CONTINUE
		ELSE
			SIF GET_ITEMDATA(LOCAL, "ID") != 素材编号:(LOCAL:2)
				CONTINUE
		ENDIF
		SETBIT LOCAL:1, LOCAL:2
	NEXT
	SIF !LOCAL:1
		CONTINUE
	素材掩码数:(LOCAL:1)++
NEXT

; 单槽位上界。真实可调合数不会超过任一槽位的可用上限。
最大可调合数 = 99
FOR LOCAL, 0, 素材数
	FOR LOCAL:1, 1, POWER(2, 素材数)
		SIF !GETBIT(LOCAL:1, LOCAL)
			CONTINUE
		素材可用数:LOCAL += 素材掩码数:(LOCAL:1)
	NEXT
	SIF !素材所需数:LOCAL
		CONTINUE
	最大可调合数 = MIN(最大可调合数, 素材可用数:LOCAL / 素材所需数:LOCAL)
NEXT

; 对 4 个以内槽位直接做精确可行性检查。
; 依据容量版 Hall 条件：对每个槽位子集，需求总量不能大于能覆盖该子集的素材数。
FOR LOCAL, 最大可调合数, -1, -1
	LOCAL:1 = 1
	FOR LOCAL:2, 1, POWER(2, 素材数)
		槽位需求 = 0
		槽位供给 = 0
		FOR LOCAL:3, 0, 素材数
			SIF !GETBIT(LOCAL:2, LOCAL:3)
				CONTINUE
			槽位需求 += 素材所需数:(LOCAL:3) * LOCAL
		NEXT
		FOR COUNT, 1, POWER(2, 素材数)
			SIF !(COUNT & LOCAL:2)
				CONTINUE
			槽位供给 += 素材掩码数:COUNT
		NEXT
		IF 槽位需求 > 槽位供给
			LOCAL:1 = 0
			BREAK
		ENDIF
	NEXT
	SIF LOCAL:1
		RETURN LOCAL
NEXT
RETURN 0

;------------------------------------
; 特性的选择函数
; 注意：在此处部分特性的效果会生效
; ARG：要制作的物品
;------------------------------------
@SET_PROPERTY_MIX, ARG
#LOCALSIZE 3
#LOCALSSIZE 2

#DIM LAYER_X
#DIM LAYER_Y
#DIM L_COLOR

#DIM L_LIST, 500
#DIM R_LIST, 500
#DIM CHOICE, 特性总数
#DIM COST
#DIM QUALITY
#DIM LINE, 2
#DIM MAXNUM
#DIM NUM, 2
#DIM PAGE, 2
#DIM ITEMNUM
#DIMS MODE
#DIM 显示数
#DIM TEMP
ITEMNUM = ARG

; 变量初始化
NUM = 0
PAGE = 0
PAGE:1 = 0
显示数 = 17
MODE = LEFT
VARSET L_LIST
VARSET R_LIST
VARSET CHOICE
; 定义左右列表内容
LOCAL:1 = 0
LOCAL:2 = 0
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) < 0
		CONTINUE
	L_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT
;基本の品质とランクをセット
QUALITY = 0
FOR LOCAL, 0, VARSIZE("MIXCHOICE")
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	QUALITY += GET_ITEMDATA(LOCAL, "品质")
NEXT
QUALITY /= (VARSIZE("MIXCHOICE") - MATCH(MIXCHOICE, 0))
QUALITY = MIN(QUALITY, 999)

; 设置使用次数
TRYCCALLFORM ITEM_COUNT_{ARG}
	LOCAL:1 = RESULT
	CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "使用次数", LOCAL:1
	CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "使用次数上限", LOCAL:1
CATCH
ENDCATCH
LINE = LINECOUNT

CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "品质", QUALITY
CALL SET_QUALITY, GET_TEMP_ITEM_SLOT()
$START
; 构建右侧的 SHOWLIST
VARSET R_LIST
LOCAL:1 = 0
; 强制特性
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) >= 0
		CONTINUE
	SIF CHOICE:(GAIN_P_LIST:LOCAL)
		CONTINUE
	R_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT
; 可选特性
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) < 0
		CONTINUE
	SIF !CHOICE:(GAIN_P_LIST:LOCAL)
		CONTINUE
	R_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT
; 不继承的强制特性
FOR LOCAL, 0, 特性总数
	SIF !GAIN_P_LIST:LOCAL
		BREAK
	SIF PROPERTYCOST:(GAIN_P_LIST:LOCAL) >= 0
		CONTINUE
	SIF !CHOICE:(GAIN_P_LIST:LOCAL)
		CONTINUE
	R_LIST:(LOCAL:1) = GAIN_P_LIST:LOCAL
	LOCAL:1++
NEXT

; 特性设置
FOR LOCAL, 0, 5
	TEMP = R_LIST:LOCAL
	IF  TEMP && !(CHOICE:TEMP && PROPERTYCOST:TEMP < 0)
		CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), @"特性{LOCAL}", TEMP
	ELSE
		CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), @"特性{LOCAL}", 0
	ENDIF
NEXT
; 计算消耗额
COST = 0
FOR LOCAL, 0, 特性总数
	SIF CHOICE:LOCAL
		COST += ABS(PROPERTYCOST:LOCAL)
NEXT
	
; 设置品质与消耗额
CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "品质", QUALITY
TEMP = 0
	; 检查品质提升
	FOR LOCAL, 0, 5
		SELECTCASE GET_ITEMNAME_P(GET_TEMP_ITEM_SLOT(), LOCAL)
		CASE "高品质Lv1"
			CALL SET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质", MIN(999, GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质") * 115 / 100))
		CASE "高品质Lv2"
			CALL SET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质", MIN(999, GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质") * 130 / 100))
		CASE "高品质Lv3"
			CALL SET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质", MIN(999, GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质") * 150 / 100))
	ENDSELECT
NEXT
; 设置使用次数
TRYCCALLFORM ITEM_COUNT_{ARG}
	LOCAL:1 = RESULT
	FOR LOCAL, 0, 5
		SELECTCASE GET_ITEMNAME_P(GET_TEMP_ITEM_SLOT(), LOCAL)
			CASE "使用次数+1"
				LOCAL:1 += 1
			CASE "使用次数+2"
				LOCAL:1 += 2
			CASE "使用次数+3"
				LOCAL:1 += 3
		ENDSELECT
	NEXT
	CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "使用次数", LOCAL:1
	CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "使用次数上限", LOCAL:1
CATCH
ENDCATCH

CALL SET_QUALITY, GET_TEMP_ITEM_SLOT()
CALL SET_REVICE, GET_TEMP_ITEM_SLOT()
$SHOW_START
CLEARLINE LINECOUNT - LINE
CALL LAYER_INIT
LAYER_X = 0
LAYER_Y = 0
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, "　请选择物品的特性。继承的特性中，前５位将实际继承。", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2
CALL SHOW_MIX_ITEM_ST, ITEMNUM, 1
LAYER_Y = LAYER_Y + 3
FOR LOCAL, 0, 10
	CALL LAYER_SET, HTML_GETPRINTEDSTR(9 - LOCAL), LAYER_Y + LOCAL
NEXT
CLEARLINE 10
LAYER_Y = LAYER_Y + 10
CALL LAYER_SET, @"┌%"─"*26%┐┌%"─"*26%┐", LAYER_Y
CALL LAYER_SET, @"│%"特性候补",52,LEFT%││%"继承特性",37,LEFT%消耗额[{COST,3}/{GET_COSTLV_IN_MIX(), 3}]│", LAYER_Y + 1
CALL LAYER_SET, @"├──┬%"─"*23%┤├──┬%"─"*23%┤", LAYER_Y + 2

LAYER_Y = LAYER_Y + 3
FOR LOCAL, 0, 显示数
	LOCALS '= "│"
	TEMP = L_LIST:(LOCAL + PAGE * 显示数)
	IF TEMP
		L_COLOR = COLOR("DEF")
		SIF CHOICE:TEMP
			L_COLOR = COLOR("p-blue")
		SIF NUM == TEMP && !FLAG:鼠标模式 && MODE == "LEFT"
			L_COLOR = COLOR("p-green")
		LOCALS += ADD_FTAG(@"{PROPERTYCOST:(TEMP),4}", L_COLOR)
		LOCALS += "│"
		LOCALS += ADD_FTAG(ADD_BTAG(@"%"[" + GET_KEYMARK(LOCAL) + "] " +GET_NAME("特性", TEMP),46,LEFT%", UNICODE(10000 + LOCAL)), L_COLOR)
	ELSE
		LOCALS += @"%"",4%│%"",46%"
	ENDIF
	LOCALS += "││"
	TEMP = R_LIST:(LOCAL + PAGE:1 * 显示数)
	IF TEMP
		L_COLOR = COLOR("DEF")
		IF MATCH(R_LIST, TEMP)
			IF CHOICE:TEMP
				IF PROPERTYCOST:TEMP < 0
					L_COLOR = COLOR("gray")
				ELSE
					L_COLOR = COLOR("p-blue")
				ENDIF
			ELSE
				L_COLOR = COLOR("p-red")
			ENDIF
		ENDIF
		SIF NUM == TEMP && !FLAG:鼠标模式 && MODE == "RIGHT"
			L_COLOR = COLOR("p-green")
		LOCALS += ADD_FTAG(@"{PROPERTYCOST:(TEMP),4}", L_COLOR)
		LOCALS += "│"
		LOCALS += ADD_FTAG(ADD_BTAG(@"%"[" + GET_KEYMARK(LOCAL + 27) + "] " +GET_NAME("特性", TEMP),46,LEFT%", UNICODE(10000 + LOCAL + 27)), L_COLOR)
	ELSE
		LOCALS += @"%"",4%│%"",46%"
	ENDIF
	LOCALS += "│"
	CALL LAYER_SET, LOCALS, LAYER_Y + LOCAL
NEXT
CALL LAYER_SET, @"└──┴%"─"*13%" + ADD_BTAG("[-] " + UNICODE(0x25C0), "-") + @" 页码.{PAGE, 2} " + ADD_BTAG(UNICODE(0x25B6) + " [+] ", "+") + "┘" , LAYER_Y + LOCAL
CALL LAYER_SET, @"└──┴%"─"*13%" + ADD_BTAG("[/] " + UNICODE(0x25C0), "/") + @" 页码.{PAGE:1, 2} " + ADD_BTAG(UNICODE(0x25B6) + " [*] ", "*") + "┘", LAYER_Y + LOCAL
CALL LAYER_DRAWLINE, LAYER_Y + LOCAL + 1
LAYER_Y = LAYER_Y + LOCAL + 2
LINE:1 = LINECOUNT + LAYER_Y + LOCAL + 2
CALL LAYER_SET, " " * 5 + ADD_BTAG("[ 9] 确定", UNICODE(21009)), LAYER_Y
CALL LAYER_PRINT, , MAXLINE()
ONEINPUTS
ENCODETOUNI %RESULTS%
FLAG:鼠标模式 = (RESULT:1 >= 10000)
SIF RESULTS == UNICODE(21009)
	RESULTS = 9
SIF GET_KEYMARK_NUM(RESULTS) >= 0
	RESULT:1 = GET_KEYMARK_NUM(RESULTS) + 10000
SELECTCASE RESULTS
	CASE "9"
		CALL SHOW_BLANK
		RETURN 1
	CASE "+"
		SIF L_LIST:((PAGE +1) * 显示数) > 0
			PAGE++
	CASE "-"
		SIF PAGE > 0
			PAGE--
	CASE "*"
		SIF R_LIST:((PAGE:1 +1) * 显示数) > 0
			PAGE:1++
	CASE "/"
		SIF PAGE:1 > 0
			PAGE:1++
	CASEELSE
		IF INRANGE(RESULT:1, 10000, 10026)
			TEMP = L_LIST:(RESULT:1 - 10000 + PAGE * 显示数)
			IF TEMP > 0
				IF CHOICE:TEMP
					CHOICE:TEMP = 0
				ELSE
					IF GET_COSTLV_IN_MIX() >= PROPERTYCOST:TEMP + COST
						CHOICE:TEMP = 1
					ELSE
						CLEARLINE 7
						CALL MESSAGE_WINDOW, "", "消耗额不足。", , , , 108
						GOTO START
					ENDIF
				ENDIF
			ENDIF
		ELSEIF INRANGE(RESULT:1, 10027, 10051)
			TEMP = R_LIST:(RESULT:1 - 10027 + PAGE:1 * 显示数)
			IF TEMP > 0
				IF CHOICE:TEMP
					CHOICE:TEMP = 0
				ELSE
					IF GET_COSTLV_IN_MIX() >= ABS(PROPERTYCOST:TEMP) + COST
						CHOICE:TEMP = 1
					ELSE
						CLEARLINE 7
						CALL MESSAGE_WINDOW, "", "消耗额不足。", , , , 108
						GOTO START
					ENDIF
				ENDIF
			ENDIF
		ELSE
			GOTO START
		ENDIF
ENDSELECT
GOTO START


;---------------------------------------------------
; 统计并记录特性的数量到列表中
; ARG：将要制作的物品（用于继承判定）
;---------------------------------------------------
@SET_PROPERTY_LIST, ARG
#DIMS 继承类型
#DIM 继承列表, 特性总数
#DIM TEMP, 5
#DIM TLV, 1
SIF GROUPMATCH(FLAG:SHOP指令, GET_NO("SHOP", "调合"), GET_NO("SHOP", "制造霍姆克鲁斯")) && MIX_SELECTION_PROPERTY_CACHE_VALID && MIX_SELECTION_CACHE_ITEM == ARG
	RETURN 0
IF FLAG:SHOP指令 == GET_NO("SHOP", "制造霍姆克鲁斯")
	VARSET 继承列表, 1
ELSE
	CALLFORM ITEM_TYPE_{ARG}
	继承类型 = %RESULTS%
	VARSET 继承列表
	FOR LOCAL, 0, 特性总数
		CALL PROPERTY_SUCCESSION, LOCAL
		SIF STRCOUNT(RESULTS, 继承类型)
			继承列表:LOCAL = 1
	NEXT
	TRYCCALLFORM ITEM_HOMU_MATERIAL_{ARG}
		IF RESULT
			VARSET 继承列表, 1, PROPERTY_TALENT_START(), PROPERTY_TALENT_END() + 1
			VARSET 继承列表, 1, PROPERTY_ABL_START(), PROPERTY_ABL_END() + 1
			VARSET 继承列表, 1, PROPERTY_FEATURE_START(), PROPERTY_FEATURE_END() + 1
		ENDIF
	CATCH
	ENDCATCH
ENDIF
;----------------------------------------------------
; 特性列表化
;----------------------------------------------------
VARSET P_LIST
FOR LOCAL, 0, VARSIZE("MIXCHOICE")
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	FOR LOCAL:1, 0, 5
		TEMP = GET_ITEMDATA(LOCAL, @"特性{LOCAL:1}")
		SIF TEMP > 0 && 继承列表:TEMP >0
			P_LIST:TEMP++
	NEXT
NEXT
;---------------------------------------------------
; 判定在合成等情况下特性是否会消失
;---------------------------------------------------
; 目标消失检查
FOR LOCAL, 0, 特性总数
	SIF !P_LIST:LOCAL
		CONTINUE
	CALL PROPERTY_OFFSET, LOCAL
	TEMP = RESULT, RESULT:1, RESULT:2, RESULT:3, RESULT:4
	TLV = RESULT:5
	; TALENT（天赋）为特殊处理
	FOR LOCAL:1, 0, 5
		IF IS_PROPERTY_TALENT(LOCAL)
			SIF !TEMP:(LOCAL:1)
				CONTINUE
			; 同等级时进行对消灭检查
			TEMP:(LOCAL:1) = TEMP:(LOCAL:1) + PROPERTY_TALENT_START() + VARSIZE("TALENT") * TLV
		ENDIF
		IF P_LIST:LOCAL > P_LIST:(TEMP:(LOCAL:1))
			P_LIST:LOCAL -= P_LIST:(TEMP:(LOCAL:1))
			P_LIST:(TEMP:(LOCAL:1)) = 0
		ELSE
			P_LIST:(TEMP:(LOCAL:1)) -= P_LIST:LOCAL
			P_LIST:LOCAL = 0
		ENDIF
	NEXT
NEXT
; 合成检查
FOR LOCAL, 0, 100
	SELECTCASE LOCAL
		CASEELSE
			BREAK
	ENDSELECT
NEXT
; 性格下位等级消除检查
FOR LOCAL, 0, 200
	TEMP = LOCAL + PROPERTY_TALENT_START()
	IF P_LIST:(TEMP + VARSIZE("TALENT") * 2)
		TLV = 2
		P_LIST:(TEMP + VARSIZE("TALENT")) = 0
	ELSEIF P_LIST:(TEMP + VARSIZE("TALENT"))
		TLV = 1
	ELSE
		CONTINUE
	ENDIF
	P_LIST:TEMP = 0
	TRYCCALLFORM TALENT_OFFSET_%TALENTNAME:LOCAL%
	CATCH
		CONTINUE
	ENDCATCH
	FOR LOCAL:1, 0, 5
		SIF !RESULT:(LOCAL:1)
			CONTINUE
		SIF TLV == 2
			P_LIST:(RESULT:(LOCAL:1) + PROPERTY_TALENT_START() + VARSIZE("TALENT")) = 0
		P_LIST:(RESULT:(LOCAL:1) + PROPERTY_TALENT_START()) = 0
	NEXT
NEXT
VARSET GAIN_P_LIST
;------------------------------------------------------
; 排序与注册处理
;------------------------------------------------------
FOR LOCAL, 0, 特性总数
	SIF !P_LIST:LOCAL
		CONTINUE
	GAIN_P_LIST:LOCAL = LOCAL
	GAIN_P_LIST:LOCAL += ABS(PROPERTYCOST:LOCAL) * 10000
	; 如果为负值则加 1000k
	SIF PROPERTYCOST:LOCAL < 0
		GAIN_P_LIST:LOCAL += 1000 * 1000
NEXT
ARRAYSORT GAIN_P_LIST, BACK
FOR LOCAL, 0, 特性总数
	GAIN_P_LIST:LOCAL %= 10000
NEXT
IF GROUPMATCH(FLAG:SHOP指令, GET_NO("SHOP", "调合"), GET_NO("SHOP", "制造霍姆克鲁斯"))
	MIX_SELECTION_CACHE_ITEM = ARG
	MIX_SELECTION_PROPERTY_CACHE_VALID = 1
ENDIF

@SHOW_PROPERTY_LIST, ARG, ARG:1
#LOCALSIZE 2
#LOCALSSIZE 2
LOCAL:1 = 20 + ARG:1  * 2
FOR LOCAL, ARG * 25, (ARG + 1) *25
	SIF LOCAL % 5 == 0
		LOCALS = │
	IF GAIN_P_LIST:LOCAL
		IF STRLENS(GET_NAME("特性", GAIN_P_LIST:LOCAL)) > (LOCAL:1 - 4)
			LOCALS:1 '= FORMCELL(GET_NAME("特性", GAIN_P_LIST:LOCAL), LOCAL:1 - 4) + "(" + @"{PROPERTYCOST:(GAIN_P_LIST:LOCAL), 2}" + ")"
			LOCALS:1 '= ADD_BTAG(LOCALS:1, @"特性解说_{GAIN_P_LIST:LOCAL}", GET_NAME("特性", GAIN_P_LIST:LOCAL))
		ELSE
			LOCALS:1 '= @"%GET_NAME("特性", GAIN_P_LIST:LOCAL) + "(" + @"{PROPERTYCOST:(GAIN_P_LIST:LOCAL), 2}" + ")", LOCAL:1, LEFT%"
			LOCALS:1 '= ADD_BTAG(LOCALS:1, @"特性解说_{GAIN_P_LIST:LOCAL}")
		ENDIF
		IF PROPERTYCOST:(GAIN_P_LIST:LOCAL) < 0
			LOCALS += ADD_FTAG(LOCALS:1, COLOR("p-red"))
		ELSE
			LOCALS += LOCALS:1
		ENDIF
	ELSE
		LOCALS += " " * LOCAL:1
	ENDIF
	IF LOCAL % 5 < 4
		IF ARG:1
			LOCALS += "　 "
		ELSE
			LOCALS += "　"
		ENDIF
	ELSE
		HTML_PRINT LOCALS + "│"
	ENDIF
NEXT
;------------------------------------
; 调合类别值判定函数
; 注意：返回值分别位于 RESULT:0~4
;
; 调合类别值说明：
; - 单个物品：品质平均值
; - 指定调合类别：物品调合类别值 + （根据品质 -10 到 +12 的修正）
;------------------------------------
@GET_CATEGORY_VAR
#LOCALSIZE 2
#DIM 调合类别值, 4
#DIM ITEMNUM
VARSET LOCAL
VARSET 调合类别值
FOR LOCAL, 0, VARSIZE("MIXCHOICE")
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	SELECTCASE MIXCHOICE:LOCAL
		CASE 1
			LOCAL:1 = 0
		CASE 2
			LOCAL:1 = 1
		CASE 4
			LOCAL:1 = 2
		CASE 8
			LOCAL:1 = 3
	ENDSELECT
	IF GET_MATERIAL_TYPE(LOCAL:1) == "调合类别"
		ITEMNUM = GET_ITEMDATA(LOCAL, "ID")
		CALLFORM ITEM_CATEGORY_{ITEMNUM}, RESULT:1
		调合类别值:(LOCAL:1) += RESULT + MAX((GET_ITEMDATA(LOCAL, "品质") -50) / 5, 0)
	ELSE
		调合类别值:(LOCAL:1) += GET_ITEMDATA(LOCAL, "品质")
	ENDIF
	调合类别值:(LOCAL:1) += GET_ITEMDATA(LOCAL, "调合类别加成值")
NEXT
FOR LOCAL, 0, 4
	调合类别值:LOCAL /= LIMIT(MAX(MATCH(MIXCHOICE, POWER(2, LOCAL)), 1), 0, 120)
NEXT
RETURN 调合类别值:0, 调合类别值:1, 调合类别值:2, 调合类别值:3

;------------------------------------
; 获取调合物品的消耗额值的函数
;------------------------------------
@GET_COSTLV_IN_MIX, ARG = -1
#FUNCTION
CALLF REFRESH_MIX_COST_CACHE()
IF ARG == -1
	RETURNF MIX_SELECTION_TOTAL_COSTLV_CACHE
ELSE
	RETURNF MIX_SELECTION_COSTLV_CACHE:ARG
ENDIF

@REFRESH_MIX_COST_CACHE
#FUNCTION
#LOCALSIZE 2
#DIM COSTLV, 4
#DIM COST_REVICE
SIF MIX_SELECTION_COST_CACHE_VALID
	RETURNF 0

COST_REVICE = 0
VARSET LOCAL
VARSET COSTLV
FOR LOCAL, 0, VARSIZE("MIXCHOICE")
	SIF !MIXCHOICE:LOCAL
		CONTINUE
	SELECTCASE MIXCHOICE:LOCAL
		CASE 1
			LOCAL:1 = 0
		CASE 2
			LOCAL:1 = 1
		CASE 4
			LOCAL:1 = 2
		CASE 8
			LOCAL:1 = 3
	ENDSELECT
	COSTLV:(LOCAL:1) += GET_ITEMDATA(LOCAL, "等级")
	COST_REVICE = MAX(COST_REVICE, GET_ITEMDATA(LOCAL, "消耗额加成值"))
NEXT
SIF GET_RECORD_ATTAIN("初级炼金术士")
	COST_REVICE += 2
SIF GET_RECORD_ATTAIN("中级炼金术士")
	COST_REVICE += 2
SIF GET_RECORD_ATTAIN("上级炼金术士")
	COST_REVICE += 3
SIF GET_RECORD_ATTAIN("熟练炼金术士")
	COST_REVICE += 3
SIF GET_RECORD_ATTAIN("最强炼金术士")
	COST_REVICE += 5
FOR LOCAL, 0, 4
	COSTLV:LOCAL /= MAX(MATCH(MIXCHOICE, POWER(2, LOCAL)), 1)
	MIX_SELECTION_COSTLV_CACHE:LOCAL = COSTLV:LOCAL
NEXT
MIX_SELECTION_TOTAL_COSTLV_CACHE = COSTLV:0 + COSTLV:1 + COSTLV:2 + COSTLV:3 + COST_REVICE
MIX_SELECTION_COST_CACHE_VALID = 1
RETURNF 0

;------------------------------------
; 显示调合物品状态的函数
; ARG：物品编号
; ARG:1：表示调用方
;------------------------------------
@SHOW_MIX_ITEM_ST, ARG, ARG:1
#LOCALSIZE 4
#LOCALSSIZE 1
#DIM 调合类别阈值, 6
#DIM 调合类别值, 4
HTML_PRINT @"┌%"─"*10%┬%"─"*43%┐"
RESULTS = 
IF GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "使用次数") > 0
	LOCALS '= FORMCELL(GET_NAME("物品", ARG), 15, "LEFT")
	LOCALS += @"[{GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "使用次数")}/{GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "使用次数上限")}]"
ELSE
	LOCALS '= GET_NAME("物品", ARG)
ENDIF
TRYCALLFORM ITEM_EXPLAIN_{ARG}, 1
{
	HTML_PRINT "│"
				+ ADD_BTAG(@"%LOCALS,20,LEFT%", "物品解说")
				+ @"│%AUTO_SPLIT(RESULTS, "/", 0),86,LEFT%│"
}
HTML_PRINT @"├%"─"*4%┬%"─"*5%┴%"─"*4%┬%"─"*38%┤"
CALL GET_CATEGORY_VAR
调合类别值 = RESULT, RESULT:1, RESULT:2, RESULT:3
FOR LOCAL, 0, 4
	LOCALS '= @"│ %@"效果{LOCAL+1}", 7,LEFT%"
	VARSET RESULT, 999, 0, 6
	TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{ARG}
		调合类别阈值 = 0, RESULT * 3 / 4, RESULT:1 * 3 / 4, RESULT:2 * 3 / 4, RESULT:3 * 3 / 4, 999
		SELECTCASE 调合类别值:LOCAL * 3 / 4
			CASE IS >= 调合类别阈值:4
				LOCAL:3 = -1
			CASE IS >= 调合类别阈值:3
				LOCAL:3 = 2
			CASE IS >= 调合类别阈值:2
				LOCAL:3 = 1
			CASE IS >= 调合类别阈值:1
				LOCAL:3 = 0
			CASEELSE
				LOCAL:3 = -1
		ENDSELECT
		; 主效果显示
		LOCALS += "│"
		IF LOCAL:3 >= 0 && AUTO_SPLIT(RESULTS, "/", LOCAL:3) != ""
			CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), @"主效果{LOCAL}", MAX(GET_NO("主效果", AUTO_SPLIT(RESULTS, "/", LOCAL:3)), 0)
			IF GET_KNOWN_ITEM(ARG, @"主效果{LOCAL}{LOCAL:3}")
				LOCALS += ADD_BTAG(@"%AUTO_SPLIT(RESULTS, "/", LOCAL:3),20,LEFT%", "tes")
			ELSE
				LOCALS += @"%"????", 20, LEFT%"
			ENDIF
		ELSE
			CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), @"主效果{LOCAL}", 0
			LOCALS += " " * 20
		ENDIF
		LOCALS += "│"
		LOCAL:2 = 调合类别值:LOCAL * 3 / 4
		FOR LOCAL:1, 1, 76
			SELECTCASE LOCAL:1
				CASE LOCAL:2
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("yellow"))
				CASE IS >= 调合类别阈值:4
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("gray"))
				CASE IS >= 调合类别阈值:3
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("红", !INRANGE(LOCAL:2, 调合类别阈值:3, 调合类别阈值:4 -1)))
				CASE IS >= 调合类别阈值:2
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("绿", !INRANGE(LOCAL:2, 调合类别阈值:2, 调合类别阈值:3 -1)))
				CASE IS >= 调合类别阈值:1
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("蓝", !INRANGE(LOCAL:2, 调合类别阈值:1, 调合类别阈值:2 -1)))
				CASEELSE
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("gray"))
			ENDSELECT
		NEXT
	CATCH
		LOCALS += @"│%"",20%│%"",75%"
	ENDCATCH
	LOCALS +=" │"
	HTML_PRINT LOCALS
NEXT
LOCALS = 
FOR LOCAL:1, 0, 调合类别要素数
	CALLFORM ITEM_CATEGORY_{ARG}, LOCAL:1
	SIF RESULT >= 0
		LOCALS += " (" + GET_NAME("调合类别", LOCAL:1) + ")"
NEXT
HTML_PRINT @"├%"─"*4%┼%"─"*5%┬%"─"*4%┼%"─"*38%┤"
HTML_PRINT @"│品阶:%AUTO_SPLIT("Ｅ/Ｄ/Ｃ/Ｂ/Ａ/Ｓ", "/", GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品阶"))% │品质:{GET_ITEMDATA(GET_TEMP_ITEM_SLOT(), "品质"),5}│等级:{GET_COSTLV_IN_MIX(),3}│调合类别: %LOCALS,66,LEFT%│"
HTML_PRINT @"└────┴%"─"*5%┴%"─"*4%┴%"─"*38%┘"
;------------------------------------
; 记录素材0~3是单独指定还是按调合类别指定的函数
;
; ARG    目标素材（0~3）。当 ARGS/ARG:1 为真时，将其赋给 ARG；否则返回 ARGS 和 ARG:1
; ARGS   请放入“调合类别/个别”二者之一，函数按需返回该值
; ARG:1  放入调合类别编号或物品编号
;------------------------------------
@GET_MATERIAL_TYPE, ARG, ARGS, ARG:1
#FUNCTIONS
#LOCALSSIZE 4
#LOCALSIZE 4
IF ARGS != ""
	LOCALS:ARG = %ARGS%
	LOCAL:ARG = ARG:1
ELSE
	RESULT:1 = LOCAL:ARG
	RETURNF LOCALS:ARG
ENDIF

;------------------------------------
; 随机填充时，检查物品是否能作为指定槽位素材。
;------------------------------------
@MIX_RANDOM_MATCH_MATERIAL, ARG, ARG:1
#FUNCTION
#LOCALSIZE 2
SIF MIXCHOICE:(ARG:1)
	RETURNF 0
SIF GET_ITEMDATA(ARG:1, "ID") <= 0
	RETURNF 0
LOCALS = %GET_MATERIAL_TYPE(ARG)%
LOCAL = RESULT:1
IF LOCALS == "调合类别"
	RETURNF GETBIT(GET_ITEMDATA(ARG:1, "调合类别"), LOCAL)
ELSE
	RETURNF GET_ITEMDATA(ARG:1, "ID") == LOCAL
ENDIF

;------------------------------------
; 返回当前槽位还能随机到的候补数。
;------------------------------------
@MIX_RANDOM_CANDIDATE_COUNT, ARG
#FUNCTION
#LOCALSIZE 1
RESULT = 0
FOR LOCAL, GET_ITEM_RANGE("持有物品"), GET_ITEM_RANGE("持有物品", 1)
	SIF !MIX_RANDOM_MATCH_MATERIAL(ARG, LOCAL)
		CONTINUE
	RESULT++
NEXT
RETURNF RESULT

;------------------------------------
; 从当前持有素材中随机挑一个可用素材。
;------------------------------------
@MIX_RANDOM_PICK, ARG
#FUNCTION
#LOCALSIZE 3
LOCAL = GET_ITEM_RANGE("持有物品")
LOCAL:1 = RESULT:1
LOCAL:2 = RAND(LOCAL, LOCAL:1)
FOR COUNT, LOCAL:2, LOCAL:1
	SIF !MIX_RANDOM_MATCH_MATERIAL(ARG, COUNT)
		CONTINUE
	RETURNF COUNT
NEXT
FOR COUNT, LOCAL, LOCAL:2
	SIF !MIX_RANDOM_MATCH_MATERIAL(ARG, COUNT)
		CONTINUE
	RETURNF COUNT
NEXT
RETURNF -1

;------------------------------------
; 返回指定素材槽当前总共需要多少份素材。
;------------------------------------
@MIX_RANDOM_REQUIRED_NUM, ARG, ARG:1, ARG:2 = 1
#LOCALSSIZE 2
#DIMS L_素材名, 5
CALLFORM ITEM_RECIPE_{ARG:1}
SPLIT RESULTS, "/", L_素材名
ARRAYREMOVE L_素材名, 0, 1
SIF L_素材名:ARG == ""
	RETURN 0
LOCALS:1 = 
SPLIT L_素材名:ARG, "*", LOCALS
RETURN (LOCALS:1 != "" ? TOINT(LOCALS:1) # 1) * ARG:2

;------------------------------------
; 统计一个候补素材还能满足多少个未完成的类别槽位。
; 值越小，说明它越“专用”，应优先消耗。
;------------------------------------
@MIX_RANDOM_ITEM_FLEX, ARG, ARG:1, ARG:2 = 1
#LOCALSIZE 2
LOCAL:1 = 0
FOR LOCAL, 0, 4
	CALL MIX_RANDOM_REQUIRED_NUM, LOCAL, ARG:1, ARG:2
	SIF !RESULT
		CONTINUE
	SIF MATCH(MIXCHOICE, POWER(2, LOCAL)) >= RESULT
		CONTINUE
	SIF GET_MATERIAL_TYPE(LOCAL) != "调合类别"
		CONTINUE
	SIF !MIX_RANDOM_MATCH_MATERIAL(LOCAL, ARG)
		CONTINUE
	LOCAL:1++
NEXT
RETURN LOCAL:1

;------------------------------------
; 为指定槽位挑选“冲突最少”的候补素材。
; 在最优候补之间仍然随机，以保留随机填充的感觉。
;------------------------------------
@MIX_RANDOM_PICK_BEST, ARG, ARG:1, ARG:2 = 1
#LOCALSIZE 4
#DIM 候补编号
#DIM 最佳评分
#DIM 同分候补数
候补编号 = -1
最佳评分 = 999999
同分候补数 = 0
FOR LOCAL, GET_ITEM_RANGE("持有物品"), GET_ITEM_RANGE("持有物品", 1)
	SIF !MIX_RANDOM_MATCH_MATERIAL(ARG, LOCAL)
		CONTINUE
	CALL MIX_RANDOM_ITEM_FLEX, LOCAL, ARG:1, ARG:2
	IF RESULT < 最佳评分
		最佳评分 = RESULT
		候补编号 = LOCAL
		同分候补数 = 1
	ELSEIF RESULT == 最佳评分
		同分候补数++
		SIF RAND:同分候补数 == 0
			候补编号 = LOCAL
	ENDIF
NEXT
RETURN 候补编号

;------------------------------------
; 根据当前 MIXCHOICE 刷新调合结果预览。
;------------------------------------
@REFRESH_MIX_PREVIEW, ARG
#LOCALSIZE 2
CALL INVALIDATE_MIX_SELECTION_CACHE
CALL DEL_ITEMDATA, GET_TEMP_ITEM_SLOT()
CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "ID", ARG
LOCAL = 0
LOCAL:1 = 0
FOR COUNT, 0, VARSIZE("MIXCHOICE")
	SIF !MIXCHOICE:COUNT
		CONTINUE
	LOCAL++
	LOCAL:1 += GET_ITEMDATA(COUNT, "品质")
NEXT
SIF LOCAL
	LOCAL:1 /= LOCAL
CALL SET_ITEMDATA, GET_TEMP_ITEM_SLOT(), "品质", MIN(LOCAL:1, 999)

;------------------------------------
; 调合素材选择相关缓存失效
;------------------------------------
@INVALIDATE_MIX_SELECTION_CACHE
VARSET MIX_SELECTION_COSTLV_CACHE
MIX_SELECTION_CACHE_ITEM = -1
MIX_SELECTION_COST_CACHE_VALID = 0
MIX_SELECTION_PROPERTY_CACHE_VALID = 0
MIX_SELECTION_TOTAL_COSTLV_CACHE = 0
RETURN 0
;------------------------------------
; 素材删除函数
; 将已使用的素材从选择项中移除
;------------------------------------
@DEL_MIX_MATERIAL
FOR LOCAL, 0, VARSIZE("MIXCHOICE")
	ITEMCHOICE:LOCAL = MIXCHOICE:LOCAL > 0
NEXT
CALL DEL_CHOICE_ITEM
VARSET ITEMCHOICE

@MIX_SUCCESS_RATE, ARG
#DIM 成功率
#LOCALSIZE 1
成功率 = 100
CALLFORM ITEM_LV_{ARG}
LOCAL = RESULT
; 等级差：把炼金术的知识等视作提升等级本身来计算
LOCAL -= GET_MIXLV()
LOCAL -= FR_SKILL_LV:GET_NO("友人技能", "炼金术的知识")
LOCAL -= GET_RECORD_ATTAIN("炼金知识四级") > 0
LOCAL -= GET_RECORD_ATTAIN("炼金知识一级") > 0
; 等级差 0~4 时，成功率从 100% 下降到 80%
成功率 -= LIMIT(LOCAL, 0, 4) * 5
; 等级差 4~16 时，成功率从 80% 下降到 -40%
成功率 -= LIMIT(LOCAL - 4, 0, 12) * 10
; 根据特性调整成功率
IF P_LIST:(GET_NO("特性", "面向新手"))
	成功率 += 50
ELSEIF P_LIST:(GET_NO("特性", "成功率上升Lv2"))
	成功率 += 30
ELSEIF P_LIST:(GET_NO("特性", "成功率上升Lv1"))
	成功率 += 10
ENDIF
RETURN LIMIT(成功率, 0, 100)

@GET_MIX_DAY, ARG
#LOCALSIZE 1
LOCAL = 0
LOCAL += FR_SKILL_LV:GET_NO("友人技能", "霍姆支援♀")
LOCAL += GET_RECORD_ATTAIN("炼金知识二级") > 0
LOCAL += GET_RECORD_ATTAIN("炼金知识超级") > 0
TRYCALLFORM ITEM_DAY_{ARG}
RESULT -= RESULT * LOCAL * 5 / 100
RETURN RESULT

@GET_MIX_MP, ARG
#DIM L_VALUE
L_VALUE = 60
CALLFORM ITEM_LV_{ARG}
L_VALUE -= LIMIT(GET_MIXLV(MASTER) - RESULT + 8, 0, 16) * 10
L_VALUE -= FR_SKILL_LV:GET_NO("友人技能", "霍姆支援♂") * 15
CALLFORM ITEM_MP_{ARG}
RESULT = CALCF(RESULT, L_VALUE)
RETURN RESULT
