CALLFORM ITEM_RECIPE_{ARG}
SPLIT RESULTS, "/", 素材名
ARRAYREMOVE 素材名, 0, 1

FOR LOCAL, 0, 4
	SIF 素材名:LOCAL == ""
		CONTINUE
	LOCALS:1 = 
	SPLIT 素材名:LOCAL, "*", LOCALS
	;必要数量を取得
