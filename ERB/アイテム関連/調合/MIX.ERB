	CALL LAYER_SET, HTML_GETPRINTEDSTR(4 - LOCAL), LAYER_Y + LOCAL + 1
NEXT
CLEARLINE 4
CALL LAYER_SET, @"└%"─"*44%" + ADD_BTAG("[q] " + UNICODE(0x25C0), "q") + @" PAGE.{P_PAGE,2} " + ADD_BTAG(UNICODE(0x25B6) + " [w]", "w") + " ┘", LAYER_Y + 5

;メニュー
CALL LAYER_DRAWLINE, LAYER_Y + 6
LINE:1 = LINECOUNT + LAYER_Y + 7
IF !((选择数:0 == 素材必要数:0) && (选择数:1 == 素材必要数:1) && (选择数:2 == 素材必要数:2) && (选择数:3 == 素材必要数:3))
