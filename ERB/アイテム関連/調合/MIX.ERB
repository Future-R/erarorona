					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("gray"))
				CASE IS >= 分类閾值:3
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("赤", !INRANGE(LOCAL:2, 分类閾值:3, 分类閾值:4 -1)))
				CASE IS >= 分类閾值:2
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("緑", !INRANGE(LOCAL:2, 分类閾值:2, 分类閾值:3 -1)))
				CASE IS >= 分类閾值:1
					LOCALS += ADD_FTAG(UNICODE(0x2580), BARCOLORSET("青", !INRANGE(LOCAL:2, 分类閾值:1, 分类閾值:2 -1)))
				CASEELSE
					LOCALS += ADD_FTAG(UNICODE(0x2580), COLOR("gray"))
			ENDSELECT
		NEXT
	CATCH
		LOCALS += @"│%"",20%│%"",75%"
	ENDCATCH
	LOCALS +=" │"
	HTML_PRINT LOCALS
NEXT
LOCALS = 
FOR LOCAL:1, 0, 分类要素数
	CALLFORM ITEM_CATEGORY_{ARG}, LOCAL:1
	SIF RESULT >= 0
		LOCALS += " (" + GET_NAME("分类", LOCAL:1) + ")"
NEXT
HTML_PRINT @"├%"─"*4%┼%"─"*5%┬%"─"*4%┼%"─"*38%┤"
HTML_PRINT @"│ Qu:%AUTO_SPLIT("Ｅ/Ｄ/Ｃ/Ｂ/Ａ/Ｓ", "/", GET_ITEMDATA(1100, "质量"))%　│品質:{GET_ITEMDATA(1100, "品质"),5}│  lv:{GET_COSTLV_IN_MIX(),3}│分类: %LOCALS,66,LEFT%│"
HTML_PRINT @"└────┴%"─"*5%┴%"─"*4%┴%"─"*38%┘"
;------------------------------------
;素材0~3が個別指定か、分类指定かをしまっておく関数
;
;ARG　	対象素材(0~3)。ARGS/ARG:1が真の時はARGに代入。そうでないときはARGSとARG:1を返す
;ARGS	分类/個別　のいずれかをいれておき。必要に応じて返す
;ARG:1	分类番号あるいは物品番号をいれておく
;------------------------------------
@GET_MATERIAL_TYPE, ARG, ARGS, ARG:1
#FUNCTIONS
#LOCALSSIZE 4
#LOCALSIZE 4
IF ARG:1
	LOCALS:ARG = %ARGS%
	LOCAL:ARG = ARG:1
ELSE
	RESULT:1 = LOCAL:ARG
	RETURNF LOCALS:ARG
ENDIF
;------------------------------------
;素材消去関数
;使った素材を消去する
;------------------------------------
@DEL_MIX_MATERIAL
;素材を削除
FOR LOCAL, 0, 1200
	ITEMCHOICE:LOCAL = MIXCHOICE:LOCAL > 0
NEXT
CALL DEL_CHOICE_ITEM
VARSET ITEMCHOICE

@MIX_SUCCESS_RATE, ARG
#DIM 成功率
#LOCALSIZE 1
成功率 = 100
CALLFORM ITEM_LV_{ARG}
LOCAL = RESULT
;等级差, 錬金術の知識などは等级自体を上昇してるとみなす
LOCAL -= GET_MIXLV()
LOCAL -= FR_SKILL_LV:GET_NO("友人技能", "錬金術の知識")
LOCAL -= GET_RECORD_ATTAIN("錬金知識四級") > 0
LOCAL -= GET_RECORD_ATTAIN("錬金知識一級") > 0
;0~4 100%~80%
成功率 -= LIMIT(LOCAL, 0, 4) * 5
;4~16 80%~-40%
成功率 -= LIMIT(LOCAL - 4, 0, 12) * 10
;特性による計算
IF P_LIST:(GET_NO("特性", "初心者向け"))
	成功率 += 50
ELSEIF P_LIST:(GET_NO("特性", "成功率上昇Lv2"))
	成功率 += 30
ELSEIF P_LIST:(GET_NO("特性", "成功率上昇Lv1"))
	成功率 += 10
ENDIF
RETURN LIMIT(成功率, 0, 100)

@GET_MIX_DAY, ARG
#LOCALSIZE 1
LOCAL = 0
LOCAL += FR_SKILL_LV:GET_NO("友人技能", "ホムサポート♀")
LOCAL += GET_RECORD_ATTAIN("錬金知識二級") > 0
LOCAL += GET_RECORD_ATTAIN("錬金知識超級") > 0
TRYCALLFORM ITEM_DAY_{ARG}
RESULT -= RESULT * LOCAL * 5 / 100
RETURN RESULT

@GET_MIX_MP, ARG
#DIM L_VALUE
L_VALUE = 60
CALLFORM ITEM_LV_{ARG}
L_VALUE -= LIMIT(GET_MIXLV(MASTER) - RESULT + 8, 0, 16) * 10
L_VALUE -= FR_SKILL_LV:GET_NO("友人技能", "ホムサポート♂") * 15
CALLFORM ITEM_MP_{ARG}
RESULT = CALCF(RESULT, L_VALUE)
RETURN RESULT
