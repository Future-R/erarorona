@STORE_MESSAGE_0, ARGS
SELECTCASE ARGS
	CASE "问候"
		RESULTS = 哟，是你啊。/要吃点什么吗？
	CASE "补充库存"
		RESULTS = 少し在庫を足しといたから、/欲しい物があるなら今の内に買っとけよ
	CASE "开始购买"
		RESULTS = 今日のメニューは、こんな感じだぜ/好きなのを選んでくれよ
	CASE "确认"
		RESULTS = それいいんだな？
	CASE "商談成立"
		RESULTS = 毎度ありっ
	CASE "开始出售"
		RESULTS = で、どれを売るんだ？
	CASE "开始注册"
		RESULTS = お、売ってほしい料理を持ってきたのか？
	CASE "登録"
		RESULTS = それじゃ、メニューに加えとくぜ
	CASE "登録数オーバー"
		RESULTS = さすがに、そんなにいっぱいは無理だぜ/それを売りたいなら、/別の物と入れ替えてくれよ
	CASE "篮子溢出"
		RESULTS = お前、そんなに持ち切れないだろ…/ちょっと荷物を整理してから来いよ
	CASE "箱子オーバー"
		RESULTS = って、お前、箱子がいっぱいじゃねえか/しょうがねえな/ちょっと整理して来いよ
	CASE "资金不足"
		RESULTS = お前、そんなに金持ってないだろ？/いくらお前でも、タダで食わせるわけには/いかないぜ
	CASE "価格交渉"
		RESULTS = うーん…しょうがねぇなぁ
	CASE "価格交渉確認"
		RESULTS = じゃあ、{STORE_DISCOUNT_PRICE}コールでどうだ？
	CASE "关系成立"
		RESULTS = 事情はわかったが…/いや、いつもお前に世話になってるしな/よし、調教でもなんでも任せとけ！
	CASE "关系不成立"
		RESULTS = いきなりどうしたんだ…？/変なもんでも食ったのか…？
ENDSELECT

@STORE_SALL_ABLE_0
RESULTS '= "料理/パイ/デザート/調味料"

