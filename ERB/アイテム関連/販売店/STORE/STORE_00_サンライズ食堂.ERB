		RETURN GET_NO("物品", "药木的树根"),       2,   50,  120,         5
	CASE 3
		RETURN GET_NO("物品", "带骨兽肉"),       1,   40,   32,         5
	CASE 4
		RETURN GET_NO("物品", "不知名的蛋"),       1,   40,   80,        10
	CASE 5
		RETURN GET_NO("物品", "不知名的蛋"),       2,   60,  181,         5
