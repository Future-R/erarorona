@STORE_SELL_1, ARG
;特性
RESULTS = 
;主效果
RESULTS:1 = 
SELECTCASE ARG
		;						           名前/ ランク/ 品质/価格/最大在庫数
	CASE 0
		RETURN GET_NO("物品", "盖土菇"),       0,   30,   15,        10
	CASE 1
		RETURN GET_NO("物品", "盖土菇"),       2,   60,   58,         5
	CASE 2
		RETURN GET_NO("物品", "蜂巢"),       1,   40,   24,        10
	CASE 3
		RETURN GET_NO("物品", "蜂巢"),       2,   60,  111,         3
	CASE 4
		RETURN GET_NO("物品", "橡木"),       1,   40,   55,        10
	CASE 5
		RESULTS:1 = 很痛
		RETURN GET_NO("物品", "海胆"),           2,   60,   61,        10
	CASE 6
		RESULTS = 耐用的/效果上升Lv1
		RETURN GET_NO("物品", "飞鹰的尾羽"), 2,   60,  112,         5
	CASE 7
		RETURN GET_NO("物品", "针木果实"),       1,   40,   24,        10
	CASE 8
		RESULTS = 小体型奖励Lv2
		RETURN GET_NO("物品", "针木果实"),       2,   50,  161,         5
	CASE 9
		RETURN GET_NO("物品", "云棉花"),         2,   50,   80,        10
	CASE 10
		RETURN GET_NO("物品", "碧蓝星砂"),   0,   20,   98,         5
	CASE 11
		RETURN GET_NO("物品", "恩惠之石"),       1,   40,  186,         5
	CASEELSE
		RETURN -1
ENDSELECT

@STORE_MESSAGE_1, ARGS
SELECTCASE ARGS
	CASE "问候"
		RESULTS = 欢迎光临。萝乐娜。
	CASE "补充库存"
		RESULTS = 库存已经补充过一些了哦。/如果有需要的东西，/不用客气，尽管买吧。
	CASE "开始购买"
		RESULTS = 有哪些中意的吗？
	CASE "确认"
		RESULTS = 这样就可以了吗？
	CASE "交易完成"
		RESULTS = 感谢惠顾。
	CASE "开始出售"
		RESULTS = 要卖给我些什么呢？
	CASE "开始登记"
		RESULTS = 帮大忙了。/放些什么比较好呢？
	CASE "登记"
		RESULTS = 谢谢你。/那么就快点摆上货架吧。
	CASE "登记数溢出"
		RESULTS = 抱歉。商品已经很多了，/再继续增加的话有点……/可以先把其他商品换下来吗？
	CASE "篮子溢出"
		RESULTS = 哎呀，你的篮子好像要满了……
	CASE "箱子溢出"
		RESULTS = 哎呀，你的箱子好像要满了。/不好意思，能麻烦你先整理一下行李，/再过来一次吗？
	CASE "资金不足"
		RESULTS = 哎呀哎呀，钱好像不够呢。
	CASE "议价"
		RESULTS = 毕竟一直受萝乐娜照顾，/稍微让我练习一下议价技巧也可以哦。
	CASE "议价确认"
		RESULTS = 那么，{STORE_DISCOUNT_PRICE}克尔如何呢？
	CASE "关系成立"
		RESULTS = ……嗯，毕竟一直受萝乐娜照顾嘛。/如果能派上用场的话，就让我来帮忙吧。
	CASE "关系不成立"
		RESULTS = ……我就当作没听见好了。/那种玩笑话还是少说为妙哦。
ENDSELECT

