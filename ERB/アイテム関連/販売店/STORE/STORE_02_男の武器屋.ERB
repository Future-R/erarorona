@STORE_NAME_2
RESULTS = 男子汉武器店

@STORE_OWNER_2
RESULTS = 光格尔

@STORE_SELL_2, ARG
;特性
RESULTS = 
;主效果
RESULTS:1 = 
SELECTCASE ARG
		;								 名前/ ランク/ 品质/価格/最大在庫数
	CASE 0
		RETURN GET_NO("物品", "费斯特石"),     2,   60,   30,        10
	CASE 1
		RETURN GET_NO("物品", "燃素"), 1,   40,   26,        10
	CASE 2
		RESULTS = 效果上升Lv1
		RETURN GET_NO("物品", "燃素"), 2,   50,   53,         5
	CASE 3
		RETURN GET_NO("物品", "史提姆钢石"), 2,   50,   34,        10
	CASE 4
		RETURN GET_NO("物品", "史提姆钢石"), 3,   70,   82,         5
	CASE 5
		RESULTS = 轻量化
		RETURN GET_NO("物品", "蒸馏石"),       1,   40,   28,         5
	CASE 6
		RETURN GET_NO("物品", "树冰石"),       0,   30,   39,         5
	CASE 7
		RETURN GET_NO("物品", "可燃之砂"),     2,   60,   46,        10
	CASE 8
		RETURN GET_NO("物品", "钢铁矿"),       4,  100,  605,         1
	CASE 9
		RESULTS = 大体型奖励Lv1
		RETURN GET_NO("物品", "重力石"),     3,   80,  365,         1
	CASEELSE
		RETURN -1
ENDSELECT

@STORE_MESSAGE_2, ARGS
SELECTCASE ARGS
	CASE "问候"
		RESULTS = 哦，欢迎！/今天有什么事呢？
	CASE "补充库存"
		RESULTS = 因为库存快用完了，/所以我补充了一些。
	CASE "开始购买"
		RESULTS = 要是看上了什么东西，就尽管说吧。
	CASE "确认"
		RESULTS = 确定是这个吗？
	CASE "交易完成"
		RESULTS = 谢谢啦！
	CASE "开始出售"
		RESULTS = 要出售哪个给我？
	CASE "开始登记"
		RESULTS = 哦，要放在我店里吗？/要放哪个呢？
	CASE "登记"
		RESULTS = 好，包在我身上！
	CASE "登记数溢出"
		RESULTS = 呃，这么多还真放不下呢……想放在这的话，就替换下别的商品吧。
	CASE "篮子溢出"
		RESULTS = 喂喂，你拿不下那么多吧。
	CASE "箱子溢出"
		RESULTS = 喂喂，你的箱子不是满了吗。/整理一下东西再来吧。
	CASE "资金不足"
		RESULTS = 喂喂，小姑娘。/钱好像不够啊。
	CASE "选择材料"
		RESULTS = 好，交给我啦！/我会做出很厉害的给你！/接下来要决定，/想做的东西跟使用的材料啦！
	CASE "材料不足"
		RESULTS = 材料好像不够啊……/这样根本做不出来啊。
	CASE "开始合成"
		RESULTS = 好！/看我拿出真功夫啦！
	CASE "完成"
		RESULTS = 看吧！/利落地完成了！
	CASE "议价"
		RESULTS = 既然是小姑娘你的请求，就给你便宜点吧。
	CASE "议价确认"
		RESULTS = 好，{STORE_DISCOUNT_PRICE}克尔怎样？
	CASE "关系成立"
		RESULTS = 说实话，我有点犯罪的感觉。/但既然是小姑娘的请求，就让光格尔我帮你一把吧。
	CASE "关系不成立"
		RESULTS = 对不起啊，/我没听清楚。/你再说一遍吧。
ENDSELECT

