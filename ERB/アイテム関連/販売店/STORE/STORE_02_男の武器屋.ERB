@STORE_NAME_2
RESULTS = 男子汉武器店

@STORE_OWNER_2
RESULTS = 谢顶尔

@STORE_SELL_2, ARG
;特性
RESULTS = 
;主效果
RESULTS:1 = 
SELECTCASE ARG
		;								 名前/ ランク/ 品质/価格/最大在庫数
	CASE 0
		RETURN GET_NO("物品", "费斯特石"),     2,   60,   30,        10
	CASE 1
		RETURN GET_NO("物品", "燃素"), 1,   40,   26,        10
	CASE 2
		RESULTS = 效果上升Lv1
		RETURN GET_NO("物品", "燃素"), 2,   50,   53,         5
	CASE 3
		RETURN GET_NO("物品", "史提姆钢石"), 2,   50,   34,        10
	CASE 4
		RETURN GET_NO("物品", "史提姆钢石"), 3,   70,   82,         5
	CASE 5
		RESULTS = 轻量化
		RETURN GET_NO("物品", "蒸馏石"),       1,   40,   28,         5
	CASE 6
		RETURN GET_NO("物品", "树冰石"),       0,   30,   39,         5
	CASE 7
		RETURN GET_NO("物品", "可燃之砂"),     2,   60,   46,        10
	CASE 8
		RETURN GET_NO("物品", "钢铁矿"),       4,  100,  605,         1
	CASE 9
		RESULTS = 大型ボーナスLv1
		RETURN GET_NO("物品", "重力石"),     3,   80,  365,         1
	CASEELSE
		RETURN -1
ENDSELECT

@STORE_MESSAGE_2, ARGS
SELECTCASE ARGS
	CASE "挨拶"
		RESULTS = おう、らっしゃい！/今日は何の用だい？
	CASE "在庫補充"
		RESULTS = 在庫が切れそうだったんで、/補充しといたぜ
	CASE "購入開始"
		RESULTS = 欲しいもんがあったら言ってくんな
	CASE "确认"
		RESULTS = こいつでいいんだな？
	CASE "商談成立"
		RESULTS = ありがとよ！
	CASE "売却開始"
		RESULTS = どれを売ってくれるんだ？
	CASE "登録開始"
		RESULTS = お、オレの店に置いてくれんのか？/どれを置いてくれるんだ？
	CASE "登録"
		RESULTS = よっしゃ、任せときな！
	CASE "登録数オーバー"
		RESULTS = と、さすがにこんなには置けねえな…置きたいなら、別の物と取り替えてくれよ
	CASE "篮子溢出"
		RESULTS = おいおい、そんなに持ちきれねえだろ
	CASE "箱子オーバー"
		RESULTS = おいおい、箱子がいっぱいじゃねえか/ものを整理してから、もっかい来てくれよ
	CASE "资金不足"
		RESULTS = おいおい、嬢ちゃん/金が足りねえみてえだぜ
	CASE "材料選択"
		RESULTS = おう、任せときな！/すげえの作ってやるからよ！/それじゃ作る物と、/使う材料を決めてくんな！
	CASE "材料不足"
		RESULTS = 材料が足りねえみたいだな…/これじゃ作りようがねえよ
	CASE "合成開始"
		RESULTS = よっしゃ！/いっちょ気合入れてやるか！
	CASE "完成"
		RESULTS = ほらよっ！/ばっちり完成だぜ！
	CASE "価格交渉"
		RESULTS = ほかならぬ嬢ちゃんの頼みだ。まけてやるぜ。
	CASE "価格交渉確認"
		RESULTS = よし、{STORE_DISCOUNT_PRICE}コールでどうだ？
	CASE "関係成立"
		RESULTS = 正直犯罪な気はするが嬢ちゃんの頼みだから/この男谢顶尔一肤色脱ぐとするぜ
	CASE "関係不成立"
		RESULTS = すまねぇ/よく聞こえなかった。/もう一回いってくれよ。
ENDSELECT

