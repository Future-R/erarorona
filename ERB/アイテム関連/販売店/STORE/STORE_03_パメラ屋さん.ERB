@STORE_MESSAGE_3, ARGS
SELECTCASE ARGS
	CASE "挨拶"
		RESULTS = いらっしゃい～/ゆっくりしていってね
	CASE "在庫補充"
		RESULTS = そうそう。売り切れだった品物、/補充しておいたから/またいっぱい買って行ってね～
	CASE "購入開始"
		RESULTS = 何が欲しいの～？
	CASE "確認"
		RESULTS = これでいいのね？
	CASE "商談成立"
		RESULTS = は～い。毎度ありがとうございま～す
	CASE "売却開始"
		RESULTS = どれを売ってくれるの～？
	CASE "登録開始"
		RESULTS = 助かるわ～/どれを置いてくれるのかしら？
	CASE "登録"
		RESULTS = ありがとう～/これでお客さん、増えるといいんだけど
	CASE "登録数オーバー"
		RESULTS = そんなにいっぱいは置けないわ/どうしてもって言うなら、/今売ってる物と入れ替えてもらわないと～
	CASE "カゴオーバー"
		RESULTS = そんなに持ち切れないわよ～
	CASE "コンテナオーバー"
		RESULTS = あら～？　コンテナがいっぱいじゃない/少し荷物を減らしてきた方が/いいんじゃない～？
	CASE "所持金不足"
		RESULTS = ロロナ～/それじゃお金が足りないわよ～
	CASE "価格交渉"
		RESULTS = え～。でも売れないよりはいいのかしら～
	CASE "価格交渉確認"
		RESULTS = {STORE_DISCOUNT_PRICE}コールでどう～？
	CASE "関係成立"
		RESULTS = そうね～/まぁ暇してたし～/つきあってあげるわ～
	CASE "関係不成立"
		RESULTS = うーん/面白そうだけど～/いまちょっと忙しいのよね～
ENDSELECT

