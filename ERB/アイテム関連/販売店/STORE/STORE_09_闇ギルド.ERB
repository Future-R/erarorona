;主効果
RESULTS:1 = 
SELECTCASE ARG
		;									   名前/ ランク/ 品質/価格/最大在庫数
	CASE 0
		RESULTS = 高品質Lv1
		RETURN GET_NO("アイテム", "水"),                 3,   80,   50,        3
	CASE 1
		RETURN GET_NO("アイテム", "蛇の毒袋"),           3,   80,   50,        3
	CASE 2
		RETURN GET_NO("アイテム", "クラリタケの胞子"),   3,   80,  100,        3
	CASE 3
		RETURN GET_NO("アイテム", "モリギンチャク"),     3,   80,  100,        3
	CASE 4
		RESULTS = 効果アップLv3
		RETURN GET_NO("アイテム", "震える結晶"),         4,   90,  100,        3
	CASE 5
		RESULTS = 処女
		RETURN GET_NO("アイテム", "ユニコーンの角"),     2,   60,  200,        3
	CASE 6
		RESULTS = 使用回数+1
		RETURN GET_NO("アイテム", "ベヒモスの心臓"),     2,   60,  200,        3
	CASE 7
		IF GET_EVENT_ATTAIN("アストリッドの参考書")
			RESULTS = 効果アップLv2
			RESULTS:1 = Ｂに快感(中)
			RETURN GET_NO("アイテム", "ドナーエッグ"),     2,   80,  300,        3
		ELSE
			RETURN -1
		ENDIF
	CASEELSE
		RETURN -1
ENDSELECT

