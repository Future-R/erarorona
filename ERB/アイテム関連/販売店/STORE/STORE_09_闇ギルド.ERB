@STORE_NAME_9
RESULTS = 暗之公会

@STORE_OWNER_9
RESULTS = ギルド員

@STORE_SELL_9, ARG
;特性
RESULTS = 
;主效果
RESULTS:1 = 
SELECTCASE ARG
		;									   名前/ ランク/ 品質/価格/最大在庫数
	CASE 0
		RESULTS = 高品質Lv1
		RETURN GET_NO("物品", "水"),                 3,   80,   50,        3
	CASE 1
		RETURN GET_NO("物品", "蛇的毒囊"),           3,   80,   50,        3
	CASE 2
		RETURN GET_NO("物品", "迷幻菇的孢子"),   3,   80,  100,        3
	CASE 3
		RETURN GET_NO("物品", "森葵"),     3,   80,  100,        3
	CASE 4
		RESULTS = 效果アップLv3
		RETURN GET_NO("物品", "震える結晶"),         4,   90,  100,        3
	CASE 5
		RESULTS = 处女
		RETURN GET_NO("物品", "独角兽的角"),     2,   60,  200,        3
	CASE 6
		RESULTS = 使用次数+1
		RETURN GET_NO("物品", "巨兽的心脏"),     2,   60,  200,        3
	CASE 7
		IF GET_EVENT_ATTAIN("亚斯特丽德的参考书")
			RESULTS = 效果アップLv2
			RESULTS:1 = Ｂに快感(中)
			RETURN GET_NO("物品", "ドナーエッグ"),     2,   80,  300,        3
		ELSE
			RETURN -1
		ENDIF
	CASEELSE
		RETURN -1
ENDSELECT

