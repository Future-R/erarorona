	CASE 5
		RESULTS = 处女
		RETURN GET_NO("物品", "独角兽的角"),     2,   60,  200,        3
	CASE 6
		RESULTS = 使用次数+1
		RETURN GET_NO("物品", "巨兽的心脏"),     2,   60,  200,        3
	CASE 7
		IF GET_EVENT_ATTAIN("亚斯特丽德的参考书")
			RESULTS = 效果上升Lv2
			RESULTS:1 = 对Ｂ快感(中)
			RETURN GET_NO("物品", "电导之蛋"),     2,   80,  300,        3
		ELSE
			RETURN -1
		ENDIF
	CASEELSE
		RETURN -1
ENDSELECT

