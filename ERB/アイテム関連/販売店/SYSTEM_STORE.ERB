;-------------------------------------------------------------------------------
;@SET_STORE
;店の基本商品の登録, ERBに設定されている情報からアイテムを配列に入れる
;アイテム情報は登録品との絡みもあるので、通常のアイテムと同じようにDAにいれて保存する
;
;ARG	対象とする販売店番号、省略した場合は全店舗
;-------------------------------------------------------------------------------
@SET_STORE, ARG = -1
#DIM ITEMNUM
#DIM TEMP
#DIM ID
FOR LOCAL:1, (ARG == -1 ? 0 # ARG), (ARG == -1 ? 商店数 # ARG + 1)
	FOR LOCAL, 0, 最大商品数
		ITEMNUM = GET_ITEM_RANGE("商店") + LOCAL:1 * (最大商品数 + 最大登录数) + LOCAL
		TRYCCALLFORM STORE_SELL_{LOCAL:1}, LOCAL
			IF RESULT <= 0
				CALL DEL_ITEMDATA, ITEMNUM
				CONTINUE
			ENDIF
		CATCH
			CONTINUE
		ENDCATCH
		ID = RESULT
		CALL SET_ITEMDATA, ITEMNUM, "ID", RESULT
		CALL SET_ITEMDATA, ITEMNUM, "质量", RESULT:1
		CALL SET_ITEMDATA, ITEMNUM, "品质", RESULT:2
		CALL SET_ITEMDATA, ITEMNUM, "价格", RESULT:3
		CALL SET_ITEMDATA, ITEMNUM, "贩卖价格", RESULT:3
		CALL SET_ITEMDATA, ITEMNUM, "最大库存数", RESULT:4
		CALL SET_ITEMDATA, ITEMNUM, "库存数", MIN(GET_ITEMDATA(ITEMNUM, "库存数") ,RESULT:4)
		SPLIT RESULTS, "/", LOCALS
		FOR LOCAL:2, 0, RESULT
			SIF LOCALS:(LOCAL:2) == ""
				CONTINUE
			CALL SET_ITEMDATA, ITEMNUM, @"特性{LOCAL:2}", GET_NO("特性", LOCALS:(LOCAL:2))
		NEXT
		SPLIT RESULTS:1, "/", LOCALS
		FOR LOCAL:2, 0, RESULT
			SIF LOCALS:(LOCAL:2) == ""
				CONTINUE
			CALL SET_ITEMDATA, ITEMNUM, @"主效果{LOCAL:2}", GET_NO("主效果", LOCALS:(LOCAL:2))
		NEXT
		;使用次数の設定
		TRYCCALLFORM ITEM_COUNT_{ID}
			LOCAL:2 = RESULT
			CALL SET_ITEMDATA, ITEMNUM, "使用次数", LOCAL:2
			CALL SET_ITEMDATA, ITEMNUM, "使用次数上限", LOCAL:2
		CATCH
		ENDCATCH
		;调合类别の設定
		CALL SET_CATEGORY, ITEMNUM
		;LVの設定
		CALLFORM ITEM_LV_{ID}
		CALL SET_ITEMDATA, ITEMNUM, "等级", RESULT
		;加成值の設定
		CALL SET_REVICE, ITEMNUM
	NEXT
NEXT

;-----------------------------------------------------------------------
;@RECHARGE_STORE
;在庫補充関数
;-----------------------------------------------------------------------
@RECHARGE_STORE
#LOCALSIZE 3
FOR LOCAL:2, 0, 商店数
	FOR LOCAL:1, 0, 最大商品数 + 最大登录数
		LOCAL = GET_ITEM_RANGE("商店") + LOCAL:2 * (最大商品数 + 最大登录数) + LOCAL:1
		SIF MAX(GET_ITEMDATA(LOCAL, "最大库存数"), GET_ITEMDATA(LOCAL, "库存数")) <= GET_ITEMDATA(LOCAL, "库存数")
			CONTINUE
		;补充情报もつけておく。また補充された場合、交友值があがる
		IF !GETBIT(FLAG:补充情报, LOCAL:2)
			CALLFORM STORE_OWNER_{LOCAL:2}
			SIF GET_CNUM(RESULTS) >= 0 && GET_FRIEND_POINT(RESULTS) < 60
				CALL GAIN_FRIEND_POINT, RESULTS, 100
			SETBIT FLAG:补充情报, LOCAL:2
		ENDIF
		CALL SET_ITEMDATA, LOCAL, "库存数", MAX(GET_ITEMDATA(LOCAL, "最大库存数"), GET_ITEMDATA(LOCAL, "库存数"))
	NEXT
NEXT


;-----------------------------------------------------------------------
;@STORE_MESSAGE
;販売店メッセージ表示用関数
;
;ARG, 	登録店番号
;ARGS,	シチュエーション
;-----------------------------------------------------------------------
@STORE_MESSAGE, ARG, ARGS
#LOCALSSIZE 1
CALLFORM STORE_OWNER_{ARG}
LOCALS = %RESULTS%
IF GET_CNUM(LOCALS) >= 0
	;オーナーとの认识が出来る
	CFLAG:GET_CNUM(LOCALS):认识 = 1
ENDIF
CALLFORM STORE_MESSAGE_{ARG}, ARGS
SELECTCASE ARGS
	CASE "価格交渉確認"
		CALL MESSAGE_WINDOW, LOCALS, RESULTS
		CALL INPUT_YN_M, , "购买", "不买了"
		RETURN RESULT
	CASEELSE
		CALL MESSAGE_WINDOW, LOCALS, RESULTS
ENDSELECT

;-----------------------------------------------------------------------
;@GET_SELL_PRICE
;アイテムの価格取得関数
;
;ARG 売るアイテムの番号
;-----------------------------------------------------------------------
@GET_SELL_PRICE, ARG
#FUNCTION
#LOCALSIZE 1
LOCAL = 100
;素材
IF GET_ITEMDATA(ARG, "ID") < 500
	LOCAL += (GET_RECORD_ATTAIN("素材知识三级") > 0) * 20
	LOCAL += (GET_RECORD_ATTAIN("素材知识特级") > 0) * 20
ELSEIF GET_ITEMDATA(ARG, "ID") < 1600
	LOCAL += (GET_RECORD_ATTAIN("炼金知识三级") > 0) * 20
	LOCAL += (GET_RECORD_ATTAIN("炼金知识特级") > 0) * 20
ENDIF
LOCAL += FR_SKILL_LV:GET_NO("友人技能", "商人") * 20
RETURNF TIMESF(GET_ITEMDATA(ARG, "价格"), LOCAL)
