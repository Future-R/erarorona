;-----------------------------------------------------------
; 采集素材
;ARG 0是采集1次　2是采集到篮子满　3是只获得1件物品
;-----------------------------------------------------------
@GATHER_MATERIAL, ARG
#LOCALSIZE 5
#LOCALSSIZE 2
#DIMS 物品表
#DIMS 消息, 100
#DIM 物品编号, 10
#DIM 最低品质, 10
#DIM 最高品质, 10
#DIM 最高消耗额等级, 10
#DIM 最低消耗额等级, 10
#DIM 调合类别加成, 调合类别要素数
#DIMS 特性表
#DIMS 特质表
#DIM 获得数
#DIM 获得数加成
#DIM 合计获得数
#DIM 预定合计获得数
#DIMS 赋予特性
#DIMS 除外特性
#DIM 已赋予的特征, 8
#DIMS 特征表, 8
#DIM TEMP
#DIM DAYCOST
#DIM 遗物获取
#DIM 遗物获取加速
#DIM 卷心菜编号
卷心菜编号 = GET_NO("物品", "森林卷心菜")
VARSET 最低品质
VARSET 最高品质
VARSET 最高消耗额等级
VARSET 最低消耗额等级
;-----------------------------------------------------------
; 清空临时物品区
;-----------------------------------------------------------
FOR LOCAL, GET_ITEM_RANGE("临时"), GET_ITEM_RANGE("临时", 1)
	CALL DEL_ITEMDATA, LOCAL
NEXT
;-----------------------------------------------------------
; 取得各调合类别的加成等级
;-----------------------------------------------------------
FOR LOCAL, 0, 调合类别要素数
	SELECTCASE GET_NAME("调合类别", LOCAL)
		CASE "宝石类", "香料"
			调合类别加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "富豪的独到眼光")
		CASE "食材：肉", "食材：蔬菜", "调味料"
			调合类别加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "厨师的独到眼光")
		CASE "丝线素材", "菌菇", "植物类"
			调合类别加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "旅行艺人的独到眼光")
		CASE "毒性材料", "药品材料"
			调合类别加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "旅人的独到眼光")
		CASE "矿石类", "火药"
			调合类别加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "铁匠的独到眼光")
		CASE "木材", "液体", "燃料"
			调合类别加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "杂货商的独到眼光")
		CASE "神秘之力", "万灵药"
			调合类别加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "幽灵的独到眼光")
		CASE "怪物素材"
			调合类别加成:LOCAL = AUTO_SPLIT_INT("0_2_3_4", "_", FR_SKILL_LV:GET_NO("友人技能", "王之剑"))
	ENDSELECT
NEXT
;-----------------------------------------------------------
; 构建入手物品表，并预先记录物品数据
;-----------------------------------------------------------
;获得数加成
LOCAL:3 = 0
物品表 = 
VARSET 物品编号
FOR LOCAL, 0, 10
	VARSET RESULT, 0, 0, 10
	TRYCCALLFORM PLACE_MATERIAL_%TOSTR(FLAG:当前地点,"X2")%, LOCAL
		IF RESULT:1 > 0
			物品编号:LOCAL = RESULT
			SIF ARG == 3 && !RESULT
				CONTINUE
			物品表 += ("/" + TOSTR(LOCAL)) * RESULT:1
			SIF !RESULT
				CONTINUE
				
			; 取得类别加成值
			LOCAL:2 = 0
			FOR LOCAL:1, 0, 调合类别要素数
				CALLFORM ITEM_CATEGORY_{物品编号:LOCAL}, LOCAL:1
				SIF RESULT >= 0
					LOCAL:2 = MAX(LOCAL:2, 调合类别加成:(LOCAL:1))
			NEXT
			; 先累计获得数加成
			LOCAL:3 += LOCAL:2
			
			; 调合类别加成每 Lv1 相当于 4 点品质
			LOCAL:2 *= 4
			LOCAL:2 += FR_SKILL_LV:GET_NO("友人技能", "霍姆搜索♂") * 2
			LOCAL:2 += (GET_RECORD_ATTAIN("素材知识二级") > 0) * 2
			LOCAL:2 += (GET_RECORD_ATTAIN("素材知识超级") > 0) * 2
			IF FLAG:材料混沌化
				最低品质:LOCAL = 0
			ELSE
				最低品质:LOCAL = RESULT:2
			ENDIF
			最高品质:LOCAL = RESULT:3 + RAND:(1 + LOCAL:2)
			
			CALLFORM ITEM_LV_{物品编号:LOCAL}
			IF FLAG:材料混沌化
				最低消耗额等级:LOCAL = 1
			ELSE
				最低消耗额等级:LOCAL = LIMIT(TIMESF(RESULT, 35 + 最低品质:LOCAL), 1, 8)
			ENDIF
			最高消耗额等级:LOCAL = MAX(TIMESF(RESULT, 100 + 最高品质:LOCAL), 4)
		ENDIF
	CATCH
		物品表 = /0
		BREAK
	ENDCATCH
NEXT
;一文字目が/になっているので削る
物品表 = %SUBSTRING(物品表, 1)%

;--------------------------------------------------------------
; 决定获得数量
;--------------------------------------------------------------
;获得数加成
获得数加成 = 0
获得数加成 += LOCAL:3 / 2 + LOCAL:3 % 2
获得数加成 += FR_SKILL_LV:GET_NO("友人技能", "霍姆搜索♀")
获得数加成 += (GET_RECORD_ATTAIN("素材知识四级") > 0)
获得数加成 += (GET_RECORD_ATTAIN("素材知识一级") > 0)
获得数加成 += GROUPMATCH(1, GET_ITEMNAME_E(GET_NO_QEQUIP("手套"), 0) == "成为采集高手了", GET_ITEMNAME_E(GET_NO_QEQUIP("手套"), 1) == "成为采集高手了", GET_ITEMNAME_E(GET_NO_QEQUIP("篮子"), 0) == "成为采集高手了", GET_ITEMNAME_E(GET_NO_QEQUIP("篮子"), 1) == "成为采集高手了") * 3
获得数加成 += GROUPMATCH(1, GET_ITEMNAME_E(GET_NO_QEQUIP("手套"), 0) == "成为采集宗师了", GET_ITEMNAME_E(GET_NO_QEQUIP("手套"), 1) == "成为采集宗师了", GET_ITEMNAME_E(GET_NO_QEQUIP("篮子"), 0) == "成为采集宗师了", GET_ITEMNAME_E(GET_NO_QEQUIP("篮子"), 1) == "成为采集宗师了") * 6

合计获得数 = 0
IF ARG == 2
	预定合计获得数 = BASKET_SIZE() - GET_ITEM_TOTAL("篮子")
ELSEIF ARG == 3
	预定合计获得数 = 1
	获得数加成 = 0
	FLAG:材料获得数提升 = 0
ELSE
	预定合计获得数 = MIN(15 + FLAG:材料获得数提升* 3 + FLAG:材料混沌化 * 15 + RAND:(1 + 获得数加成), 50)
ENDIF
遗物获取 = 0
遗物获取加速 = FR_SKILL_LV:GET_NO("友人技能", "王之眼")
FOR LOCAL, 0, 预定合计获得数/5+1
	; 判定是否获得遗物
	IF FLAG:遗物获取计数器 > 100 && RAND:100 < FLAG:遗物获取计数器 / 10
		遗物获取 = 1
	ELSE
		FLAG:遗物获取计数器 += RAND:(3+遗物获取加速)
	ENDIF
NEXT
;-------------------------------------------------------------
;入手アイテム決定
;品质決定
;消息作成
;调合类别值代入
;-------------------------------------------------------------
VARSET 消息
LOCAL:1 = GET_TEMP_ITEM_SLOT()
LOCAL = 0
DAYCOST = 0
LOCAL:3 = 0
IF 遗物获取
	FLAG:遗物获取计数器 = 0
	遗物获取 = 0
	LOCALS = 
	FOR LOCAL:2, 1801 , 2000
		SIF GET_KNOWN_ITEM(LOCAL:2, "获得")
			CONTINUE
		TRYCCALLFORM ITEM_NAME_{LOCAL:2}
			LOCALS += "/" + RESULTS
		CATCH
			CONTINUE
		ENDCATCH
	NEXT
	IF LOCALS != ""
		LOCALS = %RAND_SPLIT(SUBSTRING(LOCALS, 1))%
		CALL ADD_ARTIFACT, LOCALS, LOCAL:1
		消息:(LOCAL / 4) += "找到了【" + GET_NAME("物品", RESULT) + "】！"
		LOCAL++
		LOCAL:1++
		LOCAL:3++
		合计获得数++
	ENDIF
ENDIF

WHILE 1
	DAYCOST++
	FOR LOCAL, 0, MIN(15 + FLAG:材料获得数提升* 3 + FLAG:材料混沌化 * 15 + RAND:(1 + 获得数加成), 50)
		SIF LOCAL:3 % 4
			消息:(LOCAL / 4) += "/"
		LOCAL:3++
		LOCAL:2 = TOINT(RAND_SPLIT(物品表, "/"))
		IF  !(物品编号:(LOCAL:2))
			; 一无所获
			消息:(LOCAL / 4) += "什么都没找到……"
		ELSE
			消息:(LOCAL / 4) += "找到了【" + GET_NAME("物品", 物品编号:(LOCAL:2)) + "】！"
			; 登录物品的ID
			CALL SET_ITEMDATA, LOCAL:1, "ID", 物品编号:(LOCAL:2)
			; 设置品质
			CALL SET_ITEMDATA, LOCAL:1, "品质", MIN(120, RAND(最低品质:(LOCAL:2), 最高品质:(LOCAL:2) + FLAG:材料品质提升 * 7 + 1))
			SIF 物品编号:(LOCAL:2) == 卷心菜编号 && GET_TALENT("卷心菜女孩", MASTER)
				CALL SET_ITEMDATA, LOCAL:1, "品质", MIN(120, GET_ITEMDATA(LOCAL:1, "品质") + 3)
			; 设置调合类别
			CALL SET_CATEGORY, LOCAL:1
			;赋予COST
			CALLFORM ITEM_LV_{物品编号:(LOCAL:2)}
			CALL SET_ITEMDATA, LOCAL:1, "等级", RESULT
			; 将物品设为已知
			CALL SET_KNOWN_ITEM, 物品编号:(LOCAL:2), "获得"
			LOCAL:1++
		ENDIF
		合计获得数++
		SIF ARG >= 2 && (合计获得数 >= 预定合计获得数)
			BREAK
	NEXT
	IF ARG >= 2
		SIF 合计获得数 >= 预定合计获得数
			BREAK
	; 通常情况下，循环达到预定获得次数后就结束
	ELSE
		BREAK
	ENDIF
WEND

;------------------------------------------------------------------
;消息表示
;------------------------------------------------------------------
IF ARG == 2
	CALL MESSAGE_WINDOW, "", @"花费{DAYCOST}天采集到了素材！", , , , 108
ELSE
	CALL MESSAGE_WINDOW, "", "收集到素材了！/请挑选放入篮子中的素材。", , , , 108
ENDIF
IF FLAG:采集提示 == 0
	CALL MESSAGE_WINDOW, "", "注意！注意！", , , , 108
	CALL MESSAGE_WINDOW, "", "待会儿你会获得一些物品。", , , , 108
	CALL MESSAGE_WINDOW, "", "如果希望收获所有物品，进入界面后直接【[9] 退出】即可。", , , , 108
	FLAG:采集提示 = 1
ENDIF
;FOR LOCAL, 0, 4
;	SIF 消息:LOCAL != ""
;		CALL MESSAGE_WINDOW, "", 消息:LOCAL
;NEXT

;--------------------------------------------------------------------
;入手アイテムの特性決定
;--------------------------------------------------------------------

FOR LOCAL:2, 0, 10
	SIF !物品编号:(LOCAL:2)
		BREAK
	;テーブル作成
	特质表 = 
	特性表 = 
	FOR LOCAL:1, 1, 特性总数
		;固有特性を弾く
		TRYCCALLFORM PROPERTY_IS_CHARACTERISTIC_{LOCAL:1}
			SIF RESULT
				CONTINUE
			CATCH
		ENDCATCH
		;名前を持たない場合は落とす
		SIF STRCOUNT(GET_NAME("特性", LOCAL:1), "名称不在")
			CONTINUE
		;強化系も別枠判定の為に落とす
		SIF IS_PROPERTY_ABL(LOCAL:1)
			CONTINUE
		;特征系も別枠判定の為に落とす
		SIF IS_PROPERTY_FEATURE(LOCAL:1)
			CONTINUE
		;コストを持たない場合落とす
		SIF !PROPERTYCOST:(LOCAL:1)
			CONTINUE
		SIF !INRANGE(ABS(PROPERTYCOST:(LOCAL:1)), 最低消耗额等级:(LOCAL:2), 最高消耗额等级:(LOCAL:2) + FLAG:材料Lv提升)
			CONTINUE
		IF IS_PROPERTY_TALENT(LOCAL:1)
			特质表 += @"/{LOCAL:1}" 
		ELSE
			特性表 += @"/{LOCAL:1}" 
		ENDIF
	NEXT
	;一文字目が/になっているので削る
	特质表 = %SUBSTRING(特质表, 1)%
	特性表 = %SUBSTRING(特性表, 1)%
	FOR LOCAL:1, GET_TEMP_ITEM_SLOT(), GET_TEMP_ITEM_SLOT() + 合计获得数
		SIF GET_ITEMDATA(LOCAL:1, "ID") != 物品编号:(LOCAL:2)
			CONTINUE
		赋予特性 = _
		除外特性 = _
		VARSET 已赋予的特征
		FOR LOCAL, 0, 5
			LOCALS = 
			;一つ目は固有特性の判定
			IF LOCAL == 0
				TRYCCALLFORM PROPERTY_OF_CHARACTERISTIC_{物品编号:(LOCAL:2)}
					IF RESULT
						赋予特性 += TOSTR(RESULT) + "_"
						CALL SET_ITEMDATA(LOCAL:1, "特性0", RESULT)
						CONTINUE
					ENDIF
				CATCH
				ENDCATCH
			ENDIF
			;最高コストが-1の場合は最初の一つだけつけて終わる
			SIF 最高消耗额等级:(LOCAL:2) == -1
				BREAK
			DO
				SELECTCASE LOCAL
					CASE 0
						LOCALS:1 = %RAND_SPLIT("一般/一般/一般/一般/特质/特质/特质/能力/特征/特征")%
					CASE 1, 2
						LOCALS:1 = %RAND_SPLIT("一般/一般/没有赋予/没有赋予/没有赋予")%
					CASE 3, 4
						LOCALS:1 = %RAND_SPLIT("特质/特质/特质/能力/特征/特征/没有赋予/没有赋予")%
				ENDSELECT
				SELECTCASE LOCALS:1
					CASE "一般"
						LOCALS = %RAND_SPLIT(特性表, "/")%
					CASE "特质"
						LOCALS = %RAND_SPLIT(特质表, "/")%
					CASE "能力"
						DO
							TEMP = RAND(PROPERTY_ABL_START(), PROPERTY_ABL_END()+1)
						LOOP STRCOUNT(GET_NAME("特性", TEMP), "名称不在")
						LOCALS = %TOSTR(TEMP)%
					CASE "特征"
						;特征は同一系統が複数つかないようにする
						;初回はテーブル作成
						IF 特征表:1 == ""
							FOR LOCAL:3, PROPERTY_FEATURE_START(), PROPERTY_FEATURE_END()+1
								TRYCCALLFORM PROPERTY_FEATURE_{LOCAL:3}
									特征表:RESULT += @"/{LOCAL:3}"
								CATCH
								ENDCATCH
							NEXT
							FOR LOCAL:3, 0, 特征要素数
								特征表:(LOCAL:3) = %SUBSTRING(特征表:(LOCAL:3), 1)%
							NEXT
						ENDIF
						DO
							TEMP = RAND(0, 特征要素数)
						LOOP 已赋予的特征:TEMP > 0 || 特征表:TEMP == ""
						已赋予的特征:TEMP = 1
						LOCALS = %RAND_SPLIT(特征表:TEMP, "/")%
					CASE "没有赋予"
						LOCALS = 没有赋予
						BREAK
				ENDSELECT
			LOOP STRCOUNT(除外特性, "_"+LOCALS+"_") || LOCALS == ""
			SIF LOCALS == "没有赋予"
				CONTINUE
			赋予特性 += LOCALS + "_"
			除外特性 += LOCALS + "_"
			IF IS_PROPERTY_TALENT(TOINT(LOCALS))
				CALL PROPERTY_OFFSET_TALENT, TOINT(LOCALS)
				FOR LOCAL, 0, 5
					SIF !RESULT:LOCAL
						CONTINUE
					SIF STRCOUNT(除外特性, "_"+ TOSTR(RESULT:LOCAL) + "_")
						CONTINUE
					除外特性 += TOSTR(RESULT:LOCAL) + "_"
				NEXT
			ENDIF
		NEXT
		TEMP = 0
		FOR LOCAL, 1, 6
			SIF AUTO_SPLIT(赋予特性, "_", LOCAL) == ""
				CONTINUE
			CALL SET_ITEMDATA(LOCAL:1, @"特性{TEMP}", TOINT(AUTO_SPLIT(赋予特性, "_", LOCAL)))
			CALL SET_KNOWN_PROPERTY, TOINT(AUTO_SPLIT(赋予特性, "_", LOCAL))
			TEMP++
		NEXT
		;特性がついたらランク判定
		CALL SET_QUALITY(LOCAL:1)
		;主效果の判定
		FOR LOCAL, 0, 5
			VARSET RESULT, 255, 0, 5
			TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{物品编号:(LOCAL:2)}
				TEMP = -1
				FOR LOCAL:3, 0, 5
					SIF GET_ITEMDATA((LOCAL:1), "品质") >= RESULT:(LOCAL:3)
						TEMP = LOCAL:3
				NEXT
				SIF TEMP >= 0
					CALL SET_ITEMDATA, LOCAL:1, @"主效果{LOCAL}", GET_NO("主效果", AUTO_SPLIT(RESULTS, "/", TEMP))
			CATCH
			ENDCATCH
		NEXT
		;価格設定
		CALL SET_PRICE, LOCAL:1
		;加成值設定
		CALL SET_REVICE, LOCAL:1
	NEXT
NEXT
CALL SHOW_ITEMLIST, "获得物品", "临时"
LOCAL:1 = 0
FOR LOCAL, 1, 500
	LOCAL:1 += GET_KNOWN_ITEM(LOCAL, "获得")
NEXT
FOR LOCAL, 0, 6
	TEMP = LOCAL + GET_NO("成就", "素材知识四级")
	SIF GET_RECORD_ATTAIN(TEMP)
		CONTINUE
	SIF LOCAL:1 < AUTO_SPLIT_INT("15_30_45_60_75_90", "_", LOCAL)
		BREAK
	CALL MESSAGE_WINDOW, "", @"{AUTO_SPLIT_INT("15_30_45_60_75_90", "_", LOCAL)}种素材已获得的缘故，/达成了【%GET_NAME("成就", TEMP)%】！"
	CALL SET_RECORD_ATTAIN, TEMP, 1
NEXT
; 如果不是采集单件的话就度过时间
IF ARG != 3
	CALL ADD_DAY, DAYCOST
ENDIF
