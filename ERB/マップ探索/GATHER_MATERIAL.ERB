;-----------------------------------------------------------
;素材採取関数
;ARG オプション　2の場合篮子満載採取
;-----------------------------------------------------------
@GATHER_MATERIAL, ARG
#LOCALSIZE 5
#LOCALSSIZE 2
#DIMS 物品テーブル
#DIMS メッセージ, 100
#DIM 物品番号, 10
#DIM 最低品質, 10
#DIM 最高品質, 10
#DIM 最高消耗等级, 10
#DIM 最低消耗等级, 10
#DIM 分类加成, 分类要素数
#DIMS 特性テーブル
#DIMS 特质表
#DIM 入手数
#DIM 获得数加成
#DIM 合計入手数
#DIM 予定合計入手数
#DIMS 付与特性
#DIMS 除外特性
#DIM 付与済み特征, 8
#DIMS 特征テーブル, 8
#DIM TEMP
#DIM DAYCOST
#DIM アーティファクト入手
VARSET 最低品質
VARSET 最高品質
VARSET 最高消耗等级
VARSET 最低消耗等级
;-----------------------------------------------------------
;テンポラリを空に
;-----------------------------------------------------------
FOR LOCAL, 1100, 1200
	CALL DEL_ITEMDATA, LOCAL
NEXT
;-----------------------------------------------------------
;分类ごとの加成等级を取得
;-----------------------------------------------------------
FOR LOCAL, 0, 分类要素数
	SELECTCASE GET_NAME("分类", LOCAL)
		CASE "宝石", "香料"
			分类加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "富豪の目利き")
		CASE "食材•肉", "食材•蔬菜", "调味料"
			分类加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "料理人の目利き")
		CASE "丝线素材", "蘑菇", "植物类"
			分类加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "旅芸人の目利き")
		CASE "毒性材料", "药品材料"
			分类加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "旅人の目利き")
		CASE "鉱石", "火药"
			分类加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "鍛冶屋の目利き")
		CASE "木材", "液体", "燃料"
			分类加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "雑貨屋の目利き")
		CASE "神秘之力", "灵药"
			分类加成:LOCAL = FR_SKILL_LV:GET_NO("友人技能", "幽灵の目利き")
	ENDSELECT
NEXT
;-----------------------------------------------------------
;入手物品のテーブルを作成 + 物品データを変数にとっておく
;-----------------------------------------------------------
;获得数加成
LOCAL:3 = 0
物品テーブル = 
VARSET 物品番号
FOR LOCAL, 0, 10
	VARSET RESULT, 0, 0, 10
	TRYCCALLFORM PLACE_MATERIAL_%TOSTR(FLAG:当前地点,"X2")%, LOCAL
		IF RESULT:1 > 0
			物品番号:LOCAL = RESULT
			物品テーブル += ("/" + TOSTR(LOCAL)) * RESULT:1
			SIF !RESULT
				CONTINUE
				
			;加成值をとる
			LOCAL:2 = 0
			FOR LOCAL:1, 0, 分类要素数
				CALLFORM ITEM_CATEGORY_{物品番号:LOCAL}, LOCAL:1
				SIF RESULT >= 0
					LOCAL:2 = MAX(LOCAL:2, 分类加成:(LOCAL:1))
			NEXT
			;获得数加成用に先に処理
			LOCAL:3 += LOCAL:2
			
			;分类加成はLv1につき品質4に相当
			LOCAL:2 *= 4
			LOCAL:2 += FR_SKILL_LV:GET_NO("友人技能", "ホムサーチ♂") * 2
			LOCAL:2 += (GET_RECORD_ATTAIN("素材知識二級") > 0) * 2
			LOCAL:2 += (GET_RECORD_ATTAIN("素材知識超級") > 0) * 2
			IF FLAG:材料混沌化
				最低品質:LOCAL = 0
			ELSE
				最低品質:LOCAL = RESULT:2
			ENDIF
			最高品質:LOCAL = RESULT:3 + RAND:(1 + LOCAL:2)
			
			CALLFORM ITEM_LV_{物品番号:LOCAL}
			IF FLAG:材料混沌化
				最低消耗等级:LOCAL = 1
			ELSE
				最低消耗等级:LOCAL = LIMIT(TIMESF(RESULT, 35 + 最低品質:LOCAL), 1, 8)
			ENDIF
			最高消耗等级:LOCAL = MAX(TIMESF(RESULT, 100 + 最高品質:LOCAL), 4)
		ENDIF
	CATCH
		物品テーブル = /0
		BREAK
	ENDCATCH
NEXT
;一文字目が/になっているので削る
物品テーブル = %SUBSTRING(物品テーブル, 1)%

;--------------------------------------------------------------
;獲得数の決定
;--------------------------------------------------------------
;获得数加成
获得数加成 = 0
获得数加成 += LOCAL:3 / 2 + LOCAL:3 % 2
获得数加成 += FR_SKILL_LV:GET_NO("友人技能", "ホムサーチ♀")
获得数加成 += (GET_RECORD_ATTAIN("素材知識四級") > 0)
获得数加成 += (GET_RECORD_ATTAIN("素材知識一級") > 0)
获得数加成 += (GET_ITEMNAME_E(GET_NO_QEQUIP("手套"), 0) == "成为采集高手了") * 3
获得数加成 += (GET_ITEMNAME_E(GET_NO_QEQUIP("手套"), 0) == "成为采集宗师了") * 6

合計入手数 = 0
IF ARG == 2
	予定合計入手数 = BASKET_SIZE() - GET_ITEM_TOTAL("篮子")
ELSE
	予定合計入手数 = MIN(15 + FLAG:材料获得数提升 * 3 + FLAG:材料混沌化 * 15 + RAND:(1 + 获得数加成), 50)
ENDIF
アーティファクト入手 = 0
FOR LOCAL, 0, 予定合計入手数 / 5 + 1
	;特殊な物品の判定
	IF FLAG:神器获取计数器 > 100 && RAND:100 < FLAG:神器获取计数器 / 10
		アーティファクト入手 = 1
	ELSE
		FLAG:神器获取计数器 += RAND:3
	ENDIF
NEXT
;-------------------------------------------------------------
;入手物品決定
;品質決定
;メッセージ作成
;分类值代入
;-------------------------------------------------------------
VARSET メッセージ
LOCAL:1 = 1100
LOCAL = 0
DAYCOST = 0
LOCAL:3 = 0
IF アーティファクト入手
	FLAG:神器获取计数器 = 0
	アーティファクト入手 = 0
	LOCALS = 
	FOR LOCAL:2, 1801 , 2000
		SIF GET_KNOWN_ITEM(LOCAL:2, "获得")
			CONTINUE
		TRYCCALLFORM ITEM_NAME_{LOCAL:2}
			LOCALS += "/" + RESULTS
		CATCH
			CONTINUE
		ENDCATCH
	NEXT
	IF LOCALS != ""
		LOCALS = %RAND_SPLIT(SUBSTRING(LOCALS, 1))%
		CALL ADD_ARTIFACT, LOCALS, LOCAL:1
		メッセージ:(LOCAL / 4) += "【" + GET_NAME("物品", RESULT) + "】を見つけた！"
		LOCAL++
		LOCAL:1++
		LOCAL:3++
		合計入手数++
	ENDIF
ENDIF

WHILE 1
	DAYCOST++
	FOR LOCAL, 0, MIN(15 + FLAG:材料获得数提升 * 3 + FLAG:材料混沌化 * 15 + RAND:(1 + 获得数加成), 50)
		SIF LOCAL:3 % 4
			メッセージ:(LOCAL / 4) += "/"
		LOCAL:3++
		LOCAL:2 = TOINT(RAND_SPLIT(物品テーブル, "/"))
		IF  !(物品番号:(LOCAL:2))
			;何もなし
			メッセージ:(LOCAL / 4) += "何もなかった……"
		ELSE
			メッセージ:(LOCAL / 4) += "【" + GET_NAME("物品", 物品番号:(LOCAL:2)) + "】を見つけた！"
			;物品のIDを登録
			CALL SET_ITEMDATA, LOCAL:1, "ID", 物品番号:(LOCAL:2)
			;品質セット
			CALL SET_ITEMDATA, LOCAL:1, "品质", MIN(120, RAND(最低品質:(LOCAL:2), 最高品質:(LOCAL:2) + FLAG:材料品质提升 * 7 + 1))
			;分类セット
			CALL SET_CATEGORY, LOCAL:1
			;コスト付与
			CALLFORM ITEM_LV_{物品番号:(LOCAL:2)}
			CALL SET_ITEMDATA, LOCAL:1, "等级", RESULT
			;物品既知フラグを立てる
			CALL SET_KNOWN_ITEM, 物品番号:(LOCAL:2), "获得"
			LOCAL:1++
			合計入手数++
		ENDIF
		SIF ARG == 2 && (合計入手数 >= 予定合計入手数)
			BREAK
	NEXT
	IF ARG == 2
		SIF 合計入手数 >= 予定合計入手数
			BREAK
	;通常は既定の入手数回分だけ回したら終了
	ELSE
		BREAK
	ENDIF
WEND

;------------------------------------------------------------------
;メッセージ表示
;------------------------------------------------------------------
IF ARG == 2
	CALL MESSAGE_WINDOW, "", @"花费{DAYCOST}天采集到了素材！", , , , 108
ELSE
	CALL MESSAGE_WINDOW, "", "收集到素材了！/请挑选放入篮子中的素材。", , , , 108
ENDIF
;FOR LOCAL, 0, 4
;	SIF メッセージ:LOCAL != ""
;		CALL MESSAGE_WINDOW, "", メッセージ:LOCAL
;NEXT

;--------------------------------------------------------------------
;入手物品の特性決定
;--------------------------------------------------------------------

FOR LOCAL:2, 0, 10
	SIF !物品番号:(LOCAL:2)
		BREAK
	;テーブル作成
	特质表 = 
	特性テーブル = 
	FOR LOCAL:1, 1, 特性总数
		;固有特性を弾く
		TRYCCALLFORM PROPERTY_IS_CHARACTERISTIC_{LOCAL:1}
			SIF RESULT
				CONTINUE
			CATCH
		ENDCATCH
		;名前を持たない場合は落とす
		SIF STRCOUNT(GET_NAME("特性", LOCAL:1), "名称不在")
			CONTINUE
		;強化系も別枠判定の為に落とす
		SIF IS_PROPERTY_ABL(LOCAL:1)
			CONTINUE
		;特征系も別枠判定の為に落とす
		SIF IS_PROPERTY_FEATURE(LOCAL:1)
			CONTINUE
		;コストを持たない場合落とす
		SIF !PROPERTYCOST:(LOCAL:1)
			CONTINUE
		SIF !INRANGE(ABS(PROPERTYCOST:(LOCAL:1)), 最低消耗等级:(LOCAL:2), 最高消耗等级:(LOCAL:2) + FLAG:材料Lv提升)
			CONTINUE
		IF IS_PROPERTY_TALENT(LOCAL:1)
			特质表 += @"/{LOCAL:1}" 
		ELSE
			特性テーブル += @"/{LOCAL:1}" 
		ENDIF
	NEXT
	;一文字目が/になっているので削る
	特质表 = %SUBSTRING(特质表, 1)%
	特性テーブル = %SUBSTRING(特性テーブル, 1)%
	FOR LOCAL:1, 1100, 1100 + 合計入手数
		SIF GET_ITEMDATA(LOCAL:1, "ID") != 物品番号:(LOCAL:2)
			CONTINUE
		付与特性 = _
		除外特性 = _
		VARSET 付与済み特征
		FOR LOCAL, 0, 5
			LOCALS = 
			;一つ目は固有特性の判定
			IF LOCAL == 0
				TRYCCALLFORM PROPERTY_OF_CHARACTERISTIC_{物品番号:(LOCAL:2)}
					IF RESULT
						付与特性 += TOSTR(RESULT) + "_"
						CALL SET_ITEMDATA(LOCAL:1, "特性0", RESULT)
						CONTINUE
					ENDIF
				CATCH
				ENDCATCH
			ENDIF
			;最高コストが-1の場合は最初の一つだけつけて終わる
			SIF 最高消耗等级:(LOCAL:2) == -1
				BREAK
			DO
				SELECTCASE LOCAL
					CASE 0
						LOCALS:1 = %RAND_SPLIT("一般/一般/一般/一般/特质/特质/特质/能力/特征/特征")%
					CASE 1, 2
						LOCALS:1 = %RAND_SPLIT("一般/一般/没有赋予/没有赋予/没有赋予")%
					CASE 3, 4
						LOCALS:1 = %RAND_SPLIT("特质/特质/特质/能力/特征/特征/没有赋予/没有赋予")%
				ENDSELECT
				SELECTCASE LOCALS:1
					CASE "一般"
						LOCALS = %RAND_SPLIT(特性テーブル, "/")%
					CASE "特质"
						LOCALS = %RAND_SPLIT(特质表, "/")%
					CASE "能力"
						DO
							TEMP = RAND(PROPERTY_ABL_START(), PROPERTY_ABL_END()+1)
						LOOP STRCOUNT(GET_NAME("特性", TEMP), "名称不在")
						LOCALS = %TOSTR(TEMP)%
					CASE "特征"
						;特征は同一系統が複数つかないようにする
						;初回はテーブル作成
						IF 特征テーブル:1 == ""
							FOR LOCAL:3, PROPERTY_FEATURE_START(), PROPERTY_FEATURE_END()+1
								TRYCCALLFORM PROPERTY_FEATURE_{LOCAL:3}
									特征テーブル:RESULT += @"/{LOCAL:3}"
								CATCH
								ENDCATCH
							NEXT
							FOR LOCAL:3, 0, 特征要素数
								特征テーブル:(LOCAL:3) = %SUBSTRING(特征テーブル:(LOCAL:3), 1)%
							NEXT
						ENDIF
						DO
							TEMP = RAND(0, 特征要素数)
						LOOP 付与済み特征:TEMP > 0 || 特征テーブル:TEMP == ""
						付与済み特征:TEMP = 1
						LOCALS = %RAND_SPLIT(特征テーブル:TEMP, "/")%
					CASE "没有赋予"
						LOCALS = 没有赋予
						BREAK
				ENDSELECT
			LOOP STRCOUNT(除外特性, "_"+LOCALS+"_") || LOCALS == ""
			SIF LOCALS == "没有赋予"
				CONTINUE
			付与特性 += LOCALS + "_"
			除外特性 += LOCALS + "_"
			IF IS_PROPERTY_TALENT(TOINT(LOCALS))
				CALL PROPERTY_OFFSET_TALENT, TOINT(LOCALS)
				FOR LOCAL, 0, 5
					SIF !RESULT:LOCAL
						CONTINUE
					SIF STRCOUNT(除外特性, "_"+ TOSTR(RESULT:LOCAL) + "_")
						CONTINUE
					除外特性 += TOSTR(RESULT:LOCAL) + "_"
				NEXT
			ENDIF
		NEXT
		TEMP = 0
		FOR LOCAL, 1, 6
			SIF AUTO_SPLIT(付与特性, "_", LOCAL) == ""
				CONTINUE
			CALL SET_ITEMDATA(LOCAL:1, @"特性{TEMP}", TOINT(AUTO_SPLIT(付与特性, "_", LOCAL)))
			CALL SET_KNOWN_PROPERTY, TOINT(AUTO_SPLIT(付与特性, "_", LOCAL))
			TEMP++
		NEXT
		;特性がついたらランク判定
		CALL SET_QUALITY(LOCAL:1)
		;主效果の判定
		FOR LOCAL, 0, 5
			VARSET RESULT, 255, 0, 5
			TRYCCALLFORM ITEM_EFFECT_{LOCAL}_{物品番号:(LOCAL:2)}
				TEMP = -1
				FOR LOCAL:3, 0, 5
					SIF GET_ITEMDATA((LOCAL:1), "品质") >= RESULT:(LOCAL:3)
						TEMP = LOCAL:3
				NEXT
				SIF TEMP >= 0
					CALL SET_ITEMDATA, LOCAL:1, @"主效果{LOCAL}", GET_NO("主效果", AUTO_SPLIT(RESULTS, "/", TEMP))
			CATCH
			ENDCATCH
		NEXT
		;価格設定
		CALL SET_PRICE, LOCAL:1
		;加成值設定
		CALL SET_REVICE, LOCAL:1
	NEXT
NEXT
CALL SHOW_ITEMLIST, "获得物品", "临时"
LOCAL:1 = 0
FOR LOCAL, 1, 500
	LOCAL:1 += GET_KNOWN_ITEM(LOCAL, "获得")
NEXT
FOR LOCAL, 0, 6
	TEMP = LOCAL + GET_NO("记录", "素材知識四級")
	SIF GET_RECORD_ATTAIN(TEMP)
		CONTINUE
	SIF LOCAL:1 < AUTO_SPLIT_INT("15_30_45_60_75_90", "_", LOCAL)
		BREAK
	CALL MESSAGE_WINDOW, "", @"{AUTO_SPLIT_INT("15_30_45_60_75_90", "_", LOCAL)}種類の素材を入手したことにより/【%GET_NAME("记录", TEMP)%】が达成されました！"
	CALL SET_RECORD_ATTAIN, TEMP, 1
NEXT
;一日経過
CALL ADD_DAY, DAYCOST
