	SIF GET_ITEMNAME_E(GET_NO_QEQUIP("鞋子"), 0) == "万能跑一趟"
		ARG:2 -= 2
	SIF GET_ITEMNAME_E(GET_NO_QEQUIP("鞋子"), 0) == "街道跑一趟"
		ARG:2 -= 1
	SIF GET_NO("SHOP", "马车") == FLAG:SHOP指令 || GET_NO("SHOP", "特快马车") == FLAG:SHOP指令
		ARG:2 = 1
