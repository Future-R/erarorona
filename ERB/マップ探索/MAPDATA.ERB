;---------------------------------------------------------------------
;@PLACE_ABLE, ARG
;PLACE移動可能条件取得関数
;ARG 　場所番号(10進数)
;---------------------------------------------------------------------
@PLACE_ABLE, ARG
;地図をチェック
SIF FLAG:地图全显示
	RETURN 1
TRYCCALLFORM PLACE_MAP_%TOSTR(ARG,"X2")%
	SIF !MAP:RESULT
		RETURN 0
CATCH
ENDCATCH
TRYCCALLFORM PLACE_ABLE_%TOSTR(ARG,"X2")%
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH
