;---------------------------------------------------------------------
;@EXIST_PLACE
;ARG		:ARGのPLACEが存在し、利用可能なことを示す
;ARG:1		:セッター用。真の時、ARGの場所を存在することにする
;
;場所の利用可否状況をTRYを使わずに取るためにまとめて変数にいれておくための関数
;---------------------------------------------------------------------
@EXIST_PLACE, ARG, ARG:1 = -1
#FUNCTION
#LOCALSIZE 256
SIF ARG:1 >= 0
	LOCAL:ARG = ARG:1
RETURNF LOCAL:ARG

;---------------------------------------------------------------------
;@GET_ROOT_E,W,S,N
;ARG		:判定基準となるPLACE
;ARG:1		:セッター用。真の時、ARGの場所を存在することにする
;
;ARGのPLACEから東(西南北)に道があるかをどうかを記録しておく関数
;---------------------------------------------------------------------
@GET_ROOT_E, ARG, ARG:1 = -1
#FUNCTION
#LOCALSIZE 256
SIF !MAXARRAY(LOCAL) && !MINARRAY(LOCAL)
	VARSET LOCAL, -1
IF ARG:1 == -1
	RETURNF LOCAL:ARG
ELSE
	LOCAL:ARG = ARG:1
ENDIF
@GET_ROOT_W, ARG, ARG:1 = -1
#FUNCTION
#LOCALSIZE 256
SIF !MAXARRAY(LOCAL) && !MINARRAY(LOCAL)
