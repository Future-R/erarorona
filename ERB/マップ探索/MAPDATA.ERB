;---------------------------------------------------------------------
;@GET_MAP
;地図の内容取得関数
;---------------------------------------------------------------------
@GET_MAP, ARGS
#LOCALSIZE 2
#LOCALSSIZE 1
LOCALS = 
IF ISNUMERIC(ARGS)
	LOCAL:1 = TOINT(ARGS)
ELSE
	LOCAL:1 = GET_NO("地图", ARGS)
ENDIF
FOR LOCAL, 0, 地点总数
	TRYCCALLFORM PLACE_ABLE_%TOSTR(LOCAL, "X2")%
		SIF !RESULT
			CONTINUE
	CATCH
	ENDCATCH
	TRYCCALLFORM PLACE_MAP_%TOSTR(LOCAL, "X2")%
		IF LOCAL:1 == RESULT
			SIF LOCALS != ""
				LOCALS += "/"
			LOCALS += GET_NAME("地点", LOCAL)
		ENDIF
	CATCH
	ENDCATCH
NEXT
RESULTS = %LOCALS%
RETURN STRCOUNT(RESULTS, "/")
