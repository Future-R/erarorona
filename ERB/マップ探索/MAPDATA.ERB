MAX_X = 48
MAX_Y = 40

VARSET PLACE_TASKED

;文字列のMAP情報を数值化して情報獲得させる
;数值化以降は数值を用いてMAP関係の処理を行う
FOR LOCAL:1, 0, MAX_Y + 1
	;一緒にROOT_IDの初期化をしておく
	FOR LOCAL, 0, MAX_X + 1
		L_STR = %SUBSTRING(LOCALS:(LOCAL:1), LOCAL*2, 2)%
		SELECTCASE L_STR
			CASE "　"
				MAP_DATA:LOCAL:(LOCAL:1) '= "　"
				CALLF GET_PLACE, LOCAL, LOCAL:1, -1
			CASE "│"
				MAP_DATA:LOCAL:(LOCAL:1) '= "│"
				CALLF GET_PLACE, LOCAL, LOCAL:1, -2
			CASE "─"
				MAP_DATA:LOCAL:(LOCAL:1) '= "─"
				CALLF GET_PLACE, LOCAL, LOCAL:1, -3
			CASEELSE
				;MAPの出現条件の取得
				CALL PLACE_ABLE, TOINT("0x" + L_STR)
				IF RESULT
					TEMP = TOINT("0x" + L_STR)
					SELECTCASE TEMP
						CASE GET_NO("地点", "亚兰德")
							MAP_DATA:LOCAL:(LOCAL:1) '= ADD_BTAG("☆", @"地点_{TEMP}", "亚兰德")
						CASE GET_NO("地点", "阿拉尼亚村")
							MAP_DATA:LOCAL:(LOCAL:1) '= ADD_BTAG("○", @"地点_{TEMP}", "阿拉尼亚村")
						CASE IS < 100
							MAP_DATA:LOCAL:(LOCAL:1) '= ADD_BTAG("□", @"地点_{TEMP}", GET_NAME("地点", TEMP))
							FOR LOCAL:2, 0, 10
								;引き受け済み依頼のアイテムがあるかどうかチェック
								TRYCCALLFORM PLACE_MATERIAL_%L_STR%, LOCAL:2
									IF RESULT >= 0
										IF STRCOUNT(REQ_TASKED, "_" + GET_NAME("物品", RESULT) + "_")
											PLACE_TASKED:TEMP = 1
											BREAK
										ENDIF
									ENDIF
								CATCH
								ENDCATCH
							NEXT
						CASEELSE
							MAP_DATA:LOCAL:(LOCAL:1) '= ADD_BTAG("△", @"地点_{TEMP}", "分岔路")
					ENDSELECT
					;場所ごとのXY座標を代入しておく
					CALLF GET_PLACE, LOCAL, LOCAL:1, TEMP
					CALLF GET_PLACE_X, TEMP, LOCAL
					CALLF GET_PLACE_Y, TEMP, LOCAL:1
					CALLF EXIST_PLACE, TEMP, 1
				ELSE
					CALLF GET_PLACE, LOCAL, LOCAL:1, -1
					CALLF EXIST_PLACE, TOINT("0x" + L_STR), 0
					MAP_DATA:LOCAL:(LOCAL:1) '= "　"
				ENDIF
		ENDSELECT
	NEXT
	;PRINTL 
NEXT
;デフォ距離設定
CALLF GET_DISTANCE, LOCAL, LOCAL:1, -2

;距離の設定
FOR LOCAL, 0, 256
	SIF !EXIST_PLACE(LOCAL)
		CONTINUE
	ABLE = RESULT
	X = GET_PLACE_X(LOCAL)
	Y = GET_PLACE_Y(LOCAL)
	MIN_PLACE = 0
	FOR LOCAL:3, 0, 4
		SELECTCASE LOCAL:3
			CASE 0
				LOCAL:1 = X + 1
				LOCAL:2 = Y
				L_STR = E
			CASE 1
				LOCAL:1 = X - 1
				LOCAL:2 = Y
				L_STR = W
			CASE 2
				LOCAL:1 = X
				LOCAL:2 = Y + 1
				L_STR = S
			CASE 3
				LOCAL:1 = X
				LOCAL:2 = Y - 1
				L_STR = N
		ENDSELECT
		LENGTH = 0
		WHILE GET_PLACE(LOCAL:1, LOCAL:2) != -1
			;条件を満たしていない場所にあたった時
			IF GET_PLACE(LOCAL:1, LOCAL:2) == -99
				BREAK
			;場所にあたった時
			ELSEIF GET_PLACE(LOCAL:1, LOCAL:2) >= 0
				CALLF GET_DISTANCE, LOCAL, GET_PLACE(LOCAL:1, LOCAL:2), LENGTH
				CALLFORMF GET_ROOT_%L_STR%, LOCAL, GET_PLACE(LOCAL:1, LOCAL:2)
				;分岐点潰し用に取得しておく
				PLACE_NUM++
				BREAK
			ELSE
				LENGTH++
				SELECTCASE LOCAL:3
					CASE 0
						LOCAL:1++
					CASE 1
						LOCAL:1--
					CASE 2
						LOCAL:2++
					CASE 3
						LOCAL:2--
				ENDSELECT
			ENDIF
		WEND
	NEXT
	;接続が2個未満の分岐点は抹消する
	IF MIN_PLACE >= 100 && PLACE_NUM < 2
		CALLF EXIST_PLACE, LOCAL, 0
		CALLF GET_PLACE, LOCAL, LOCAL:1, -1
	ENDIF
NEXT
;空白と連結してる道を消す
;順逆一回づつ走らせれば全部消えるはず
FOR LOCAL:2, 0, 2
	FOR LOCAL:1, LOCAL:2 ? MAX_Y # 0, LOCAL:2 ? -1 # MAX_Y + 1, LOCAL:2 ? -1 # 1
		FOR LOCAL, LOCAL:2 ? MAX_X # 0, LOCAL:2 ? -1 # MAX_X + 1, LOCAL:2 ? -1 # 1
			SELECTCASE MAP_DATA:LOCAL:(LOCAL:1)
				; 縦方向に空白があれば消す
				CASE "│"
					IF LOCAL:1 < MAX_Y && MAP_DATA:LOCAL:(LOCAL:1 + 1) == "　"
						MAP_DATA:LOCAL:(LOCAL:1) '= "　"
						CALLF GET_PLACE, LOCAL, LOCAL:1, -1
					ELSEIF LOCAL:1 > 0 && MAP_DATA:LOCAL:(LOCAL:1 - 1) == "　"
						MAP_DATA:LOCAL:(LOCAL:1) '= "　"
						CALLF GET_PLACE, LOCAL, LOCAL:1, -1
					ENDIF
				;
				CASE "─"
					IF LOCAL < MAX_X && MAP_DATA:(LOCAL + 1):(LOCAL:1) == "　"
						MAP_DATA:LOCAL:(LOCAL:1) '= "　"
						CALLF GET_PLACE, LOCAL, LOCAL:1, -1
					ELSEIF LOCAL > 0 && MAP_DATA:(LOCAL - 1):(LOCAL:1) == "　"
						MAP_DATA:LOCAL:(LOCAL:1) '= "　"
						CALLF GET_PLACE, LOCAL, LOCAL:1, -1
					ENDIF
			ENDSELECT
		NEXT
	NEXT
NEXT
