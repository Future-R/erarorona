;			0/	   1/       2/       3
;アイテム番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_00, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("アイテム", "黒の魔石"),   30, 80, 100
	CASE 1
		RETURN GET_NO("アイテム", "闇の雫"),     30, 80, 100
	CASE 2
		RETURN GET_NO("アイテム", "ひかる円盤"), 30, 80, 100
	CASE 5
		RETURN 0, 10
ENDSELECT


