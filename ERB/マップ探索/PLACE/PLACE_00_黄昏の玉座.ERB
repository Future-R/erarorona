;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_00, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "黑之魔石"),   30, 80, 100
	CASE 1
		RETURN GET_NO("物品", "黑暗水滴"),     30, 80, 100
	CASE 2
		RETURN GET_NO("物品", "发光的圆盘"), 30, 80, 100
	CASE 5
		RETURN 0, 10
ENDSELECT


