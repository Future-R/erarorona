@PLACE_NAME_04
RESULTS = 月光の森

@PLACE_ABLE_04
RETURN 1

@PLACE_MAP_04
RETURN GET_NO("地图", "聖域の地図")

;			0/	   1/       2/       3
;物品番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_04, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "世界樹の枝"), 30, 60, 80
	CASE 1
		RETURN GET_NO("物品", "薬泉の湧き水"), 20, 60, 60
	CASE 2
		RETURN GET_NO("物品", "森の雫"),     30, 80,100
	;何もなし
	CASEELSE
		RETURN 0, 10
ENDSELECT
;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_04, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "月光花")
ENDSELECT
