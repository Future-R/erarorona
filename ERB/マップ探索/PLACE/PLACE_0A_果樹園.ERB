@PLACE_NAME_0A
RESULTS = 果樹園

@PLACE_ABLE_0A
RETURN 1

@PLACE_MAP_0A
RETURN GET_NO("マップ", "果樹園の地図")

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_0A, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("アイテム", "森キャベツ"), 25, 50, 80
	CASE 1
		RETURN GET_NO("アイテム", "サワーアップル"), 25, 60, 80
	CASE 2
		RETURN GET_NO("アイテム", "フレッシュミント"), 25, 40, 60
	CASE 3
		RETURN GET_NO("アイテム", "青い実"), 15, 20, 50
	;何もなし
	CASE 4
		RETURN 0, 10
ENDSELECT
;フレンド採集のみで見つけられるレア枠
