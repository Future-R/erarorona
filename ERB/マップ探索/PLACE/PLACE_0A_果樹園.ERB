@PLACE_NAME_0A
RESULTS = 果树园

@PLACE_ABLE_0A
RETURN 1

@PLACE_MAP_0A
RETURN GET_NO("地图", "果树园地图")

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_0A, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "森林卷心菜"), 25, 50, 80
	CASE 1
		RETURN GET_NO("物品", "沙瓦金苹果"), 25, 60, 80
	CASE 2
		RETURN GET_NO("物品", "清新薄荷"), 25, 40, 60
	CASE 3
		RETURN GET_NO("物品", "蓝果实"), 15, 20, 50
	;何もなし
	CASE 4
		RETURN 0, 10
ENDSELECT
;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_0A, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "佐尼果")
ENDSELECT

