@PLACE_NAME_10
RESULTS = 旅人の街道

@PLACE_ABLE_10
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN 0
RETURN 1


;			0/	   1/       2/       3
;物品番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_10, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "土かぶり"),         20, 20, 50
	CASE 1
		RETURN GET_NO("物品", "蒸留石"),           15, 20, 40
	CASE 2
		RETURN GET_NO("物品", "紫ぶどう"),         15, 20, 40
	CASE 3
		RETURN GET_NO("物品", "水"),               25, 40, 40, -1, -1
	CASE 4
		RETURN GET_NO("物品", "アードラの尾羽"),   15, 5, 30
	;何もなし
	CASE 5
		RETURN 0,                                      10
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_10, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "ユニコーンの角")
ENDSELECT

@PLACE_MAP_10
RETURN GET_NO("地图", "亚兰德周边地图")
