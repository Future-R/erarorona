@PLACE_NAME_10
RESULTS = 旅人街道

@PLACE_ABLE_10
SIF !GET_EVENT_ATTAIN("采集吧！")
	RETURN 0
RETURN 1


;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_10, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "盖土菇"),         20, 20, 50
	CASE 1
		RETURN GET_NO("物品", "蒸馏石"),           15, 20, 40
	CASE 2
		RETURN GET_NO("物品", "紫葡萄"),         15, 20, 40
	CASE 3
		RETURN GET_NO("物品", "水"),               25, 40, 40, -1, -1
	CASE 4
		RETURN GET_NO("物品", "飞鹰的尾羽"),   15, 5, 30
	;何もなし
	CASE 5
		RETURN 0,                                      10
ENDSELECT

; 仅通过好友采集可找到的稀有道具
@PLACE_RARE_MATERIAL_10, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "独角兽的角")
ENDSELECT

@PLACE_MAP_10
RETURN GET_NO("地图", "亚兰德周边地图")
