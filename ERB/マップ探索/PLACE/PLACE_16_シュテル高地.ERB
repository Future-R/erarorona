@PLACE_NAME_16
RESULTS = シュテル高地
@PLACE_ABLE_16
RETURN 1

@PLACE_MAP_16
RETURN GET_NO("地图", "シュテル高地の地図")

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_16, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "飞鹰的尾羽"), 25, 60, 80
	CASE 1
		RETURN GET_NO("物品", "黑阳矿"),         15, 40, 60
	CASE 2
		RETURN GET_NO("物品", "重力石"),       15, 40, 80
	CASE 3
		RETURN GET_NO("物品", "震动结晶"),     25, 40, 80
	CASE 4
		RETURN 0,                                    20
ENDSELECT
;フレンド採集のみで見つけられるレア枠
