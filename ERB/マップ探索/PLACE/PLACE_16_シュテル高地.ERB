@PLACE_NAME_16
RESULTS = シュテル高地
@PLACE_ABLE_16
RETURN 1

@PLACE_MAP_16
RETURN GET_NO("地图", "シュテル高地の地図")

;			0/	   1/       2/       3
;物品番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_16, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "魔鸟的羽毛"), 25, 60, 80
	CASE 1
		RETURN GET_NO("物品", "黒陽鉱"),         15, 40, 60
	CASE 2
		RETURN GET_NO("物品", "グラビ石"),       15, 40, 80
	CASE 3
		RETURN GET_NO("物品", "震える結晶"),     25, 40, 80
	CASE 4
		RETURN 0,                                    20
ENDSELECT
