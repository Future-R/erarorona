@PLACE_NAME_18
RESULTS = オルトガ遺跡

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_18, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("アイテム", "獣のしかばね"),     25, 20, 50
	CASE 1
		RETURN GET_NO("アイテム", "アードラの尾羽"),   25, 25, 45
	CASE 2
		RETURN GET_NO("アイテム", "石ころ"),           20,  1, 60, 1, 5
	CASE 3
		RETURN GET_NO("アイテム", "何かのタマゴ"),     10, 30, 60
	CASE 4
		RETURN GET_NO("アイテム", "弾む石"),           10, 20, 50
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT


@PLACE_MAP_18
RETURN GET_NO("マップ", "オルトガ遺跡の地図")

@PLACE_ABLE_18
RETURN 1

