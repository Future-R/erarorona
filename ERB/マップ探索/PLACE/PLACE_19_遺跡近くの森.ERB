@PLACE_NAME_19
RESULTS = 遗迹附近的森林

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_19, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "三色莓果"),       20, 30, 60
	CASE 1
		RETURN GET_NO("物品", "钴蓝莓"),   30, 20, 60
	CASE 2
		RETURN GET_NO("物品", "费斯特石"),         20, 10, 40
	CASE 3
		RETURN GET_NO("物品", "燃素"),     20, 10, 40
	;何もなし
	CASE 4
		RETURN 0, 10
ENDSELECT


@PLACE_MAP_19
RETURN GET_NO("地图", "奥尔托加遗迹地图")

@PLACE_ABLE_19
RETURN 1

