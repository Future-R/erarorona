@PLACE_NAME_1B
RESULTS = 附近的森林

@PLACE_ABLE_1B
RETURN 1

@PLACE_MAP_1B
RETURN GET_NO("地图", "亚兰德周边地图")
;			0/	   1/       2/       3
;物品番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_1B, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "森林卷心菜"), 25, 30, 60
	CASE 1
		RETURN GET_NO("物品", "橡树菇"), 20, 20, 50
	CASE 2
		RETURN GET_NO("物品", "橡木"), 20, 10, 40
	CASE 3
		RETURN GET_NO("物品", "魔法草"), 15, 20, 40
	CASE 4
		RETURN GET_NO("物品", "风茄的根"), 15, 15, 45
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

