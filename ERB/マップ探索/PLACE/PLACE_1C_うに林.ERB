;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_1C, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "海胆"),       30, 40, 60
	CASE 1
		RETURN GET_NO("物品", "蜂巢"),   20, 30, 50
	CASE 2
		RETURN GET_NO("物品", "噗尼噗尼珠"), 15, 10, 40
	CASE 3
		RETURN GET_NO("物品", "针木果实"),   20, 20, 50
	;何もなし
	CASE 4
		RETURN 0, 10
ENDSELECT

