@PLACE_NAME_1E
RESULTS = 変異の森
@PLACE_ABLE_1E
RETURN 1

@PLACE_MAP_1E
RETURN GET_NO("地图", "最果ての地図")

;			0/	   1/       2/       3
;物品番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_1E, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "盖土菇"),         50, 80, 100
	CASE 1
		RETURN GET_NO("物品", "贤者的香草"),     20, 60, 80
	CASE 2
		RETURN GET_NO("物品", "鬼屋"),   20, 80, 100
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_1E, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "药虫的丝")
ENDSELECT

