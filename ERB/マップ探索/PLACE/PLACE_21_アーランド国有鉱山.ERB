@PLACE_NAME_21
RESULTS = 亚兰德国有矿山

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_21, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "树冰石"),         15, 20, 40
	CASE 1
		RETURN GET_NO("物品", "史提姆钢石"),   20, 40, 60
	CASE 2
		RETURN GET_NO("物品", "萤火草"),     15, 20, 60
	CASE 3
		RETURN GET_NO("物品", "燃素"),   20, 40, 70
	CASE 4
		RETURN GET_NO("物品", "岩盐"),           10, 20, 50
	CASE 5
		RETURN GET_NO("物品", "不知名的蛋"),   10, 40, 60
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_21, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "刚铁矿")
	CASE 1
		RETURN GET_NO("物品", "黑阳矿")
ENDSELECT


@PLACE_MAP_21
RETURN GET_NO("地图", "亚兰德国有矿山地图")

@PLACE_ABLE_21
RETURN 1

