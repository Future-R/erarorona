@PLACE_NAME_21
RESULTS = アーランド国有鉱山

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_21, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("アイテム", "樹氷石"),         15, 20, 40
	CASE 1
		RETURN GET_NO("アイテム", "スティム鋼石"),   20, 40, 60
	CASE 2
		RETURN GET_NO("アイテム", "ほたる火草"),     15, 20, 60
	CASE 3
		RETURN GET_NO("アイテム", "フロジストン"),   20, 40, 70
	CASE 4
		RETURN GET_NO("アイテム", "岩塩"),           10, 20, 50
	CASE 5
		RETURN GET_NO("アイテム", "何かのタマゴ"),   10, 40, 60
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_21, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("アイテム", "剛鉄鉱")
	CASE 1
		RETURN GET_NO("アイテム", "黒陽鉱")
ENDSELECT


@PLACE_MAP_21
RETURN GET_NO("マップ", "アーランド国有鉱山の地図")

@PLACE_ABLE_21
RETURN 1

