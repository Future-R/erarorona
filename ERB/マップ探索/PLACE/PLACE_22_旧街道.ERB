@PLACE_NAME_22
RESULTS = 旧街道

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_22, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "震动结晶"),       20, 40, 60
	CASE 1
		RETURN GET_NO("物品", "云棉花"),           20, 40, 60
	CASE 2
		RETURN GET_NO("物品", "药木的树根"),     20, 40, 60
	CASE 3
		RETURN GET_NO("物品", "小麦"),             30, 40, 60
	;何もなし
	CASE 4
		RETURN 0, 10
ENDSELECT

@PLACE_MAP_22
RETURN GET_NO("地图", "旧街道の地図")

@PLACE_ABLE_22
RETURN 1

