@PLACE_NAME_23
RESULTS = 灼熱の荒野

@PLACE_MAP_23
RETURN GET_NO("地图", "荒野の地図")

;											0/	   1/       2/       3/         4/        5
;								アイテム番号/入手率/最低品质/最高品质/最低等级/最高等级
@PLACE_MATERIAL_23, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "活着的仙人掌"),     15, 40, 60
	CASE 1
		RETURN GET_NO("物品", "被遗忘的兽骨"), 30, 40, 60
	CASE 2
		RETURN GET_NO("物品", "石化蜥蜴"),       15, 40, 60
	CASE 3
		RETURN GET_NO("物品", "碧蓝星砂"),     20, 40, 60
	;何もなし
	CASE 4
		RETURN 0, 20
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_23, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "巨兽的心脏")
ENDSELECT
@PLACE_ABLE_23
RETURN 1
