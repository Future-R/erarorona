	CASE 0
		RETURN GET_NO("アイテム", "青い実"),       35, 30, 80
	CASE 1
		RETURN GET_NO("アイテム", "赤い実"),       35, 30, 80
	CASE 2
		RETURN GET_NO("アイテム", "紫ぶどう"),     25, 30, 80
