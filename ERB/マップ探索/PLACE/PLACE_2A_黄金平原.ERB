@PLACE_NAME_2A
RESULTS = 黄金平原

@PLACE_MAP_2A
RETURN GET_NO("地图", "黄金平原地图")

@PLACE_ABLE_2A
RETURN 1

;											0/	      1/       2/       3/         4/        5
;								アイテム番号/   入手率/最低品质/最高品质/最低等级/最高等级
@PLACE_MATERIAL_2A, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "蓝果实"),       15, 50, 60
	CASE 1
		RETURN GET_NO("物品", "红果实"),       15, 50, 60
	CASE 2
		RETURN GET_NO("物品", "紫葡萄"),     15, 50, 60
	CASE 3
		RETURN GET_NO("物品", "小麦"),         20, 40, 60
	CASE 4
		RETURN GET_NO("物品", "可燃土"),     10, 40, 60
	CASE 5
		RETURN GET_NO("物品", "红萝卜"),     15, 40, 60
	;何もなし
	CASE 6
		RETURN 0,                                  10
ENDSELECT
