;											0/	   1/       2/       3/         4/        5
;								物品番号/入手率/最低品質/最高品質/最低等级/最高等级
@PLACE_MATERIAL_2C, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "蒸留石"),       25, 40, 60
	CASE 1
		RETURN GET_NO("物品", "臭い石"),       20, 40, 60
	CASE 2
		RETURN GET_NO("物品", "ブルーサンド"), 15, 10, 40
	CASE 3
		RETURN GET_NO("物品", "イワマタケ"),   15, 40, 60
	CASE 4
		RETURN GET_NO("物品", "獣のしかばね"), 10, 50, 80
	;何もなし
	CASE 5
		RETURN 0, 15
ENDSELECT


