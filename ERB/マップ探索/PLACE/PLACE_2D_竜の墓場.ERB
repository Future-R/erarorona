@PLACE_MATERIAL_2D, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("アイテム", "蛇の毒袋"),         15, 40, 60
	CASE 1
		RETURN GET_NO("アイテム", "石化トカゲ")      , 30, 60, 80
	CASE 2
		RETURN GET_NO("アイテム", "忘れられた獣の骨"), 15, 40, 60
