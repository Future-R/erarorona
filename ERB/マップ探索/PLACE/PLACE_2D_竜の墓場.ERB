@PLACE_NAME_2D
RESULTS = 竜の墓場

@PLACE_MAP_2D
RETURN GET_NO("地图", "竜の墓場の地図")

;											0/	   1/       2/       3/         4/        5
;								アイテム番号/入手率/最低品质/最高品质/最低等级/最高等级
@PLACE_MATERIAL_2D, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "蛇的毒囊"),         15, 40, 60
	CASE 1
		RETURN GET_NO("物品", "石化蜥蜴")      , 30, 60, 80
	CASE 2
		RETURN GET_NO("物品", "被遗忘的兽骨"), 15, 40, 60
	CASE 3
		RETURN GET_NO("物品", "碎石"),           20, 40, 60
	;何もなし
	CASE 4
		RETURN 0,                                      20
ENDSELECT
@PLACE_ABLE_2D
RETURN 1
