@PLACE_MAP_35
RETURN GET_NO("地图", "大陸海岸線の地図")

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_35, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("アイテム", "弾む石"),       20, 60, 80
	CASE 1
		RETURN GET_NO("アイテム", "星のかけら"),   30, 40, 60
	CASE 2
		RETURN GET_NO("アイテム", "謎の宝石の原石"),     25, 40, 80
	CASE 3
		RETURN GET_NO("アイテム", "樹氷石"),     25, 60, 80
	CASE 4
		RETURN GET_NO("アイテム", "剛鉄鉱"),     20, 60, 80
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

