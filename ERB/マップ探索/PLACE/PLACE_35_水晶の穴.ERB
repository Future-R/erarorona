@PLACE_NAME_35
RESULTS = 水晶洞穴
@PLACE_ABLE_35
RETURN 1

@PLACE_MAP_35
RETURN GET_NO("地图", "大陆海岸线地图")

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_35, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "弹跳石"),       20, 60, 80
	CASE 1
		RETURN GET_NO("物品", "星之碎片"),   30, 40, 60
	CASE 2
		RETURN GET_NO("物品", "神秘宝石的原石"),     25, 40, 80
	CASE 3
		RETURN GET_NO("物品", "树冰石"),     25, 60, 80
	CASE 4
		RETURN GET_NO("物品", "钢铁矿"),     20, 60, 80
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_35, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "熔岩石")
ENDSELECT
