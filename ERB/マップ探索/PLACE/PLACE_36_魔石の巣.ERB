@PLACE_NAME_36
RESULTS = 魔石の巣
@PLACE_ABLE_36
RETURN 1

@PLACE_MAP_36
RETURN GET_NO("地图", "魔窟の地図")

;			0/	   1/       2/       3
;物品番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_36, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "ほたる火草"),   15, 80, 100
	CASE 1
		RETURN GET_NO("物品", "恵みの石"),     20, 80, 100
	CASE 2
		RETURN GET_NO("物品", "黒の魔石"),     25, 40, 60
	CASE 3
		RETURN GET_NO("物品", "星のかけら"),   30, 40, 60
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_36, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "虹のかけら")
ENDSELECT
