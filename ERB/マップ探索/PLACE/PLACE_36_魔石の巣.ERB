@PLACE_NAME_36
RESULTS = 魔石の巣
@PLACE_ABLE_36
RETURN 1

@PLACE_MAP_36
RETURN GET_NO("地图", "魔窟の地図")

;			0/	   1/       2/       3
;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_36, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "萤火草"),   15, 80, 100
	CASE 1
		RETURN GET_NO("物品", "恩惠之石"),     20, 80, 100
	CASE 2
		RETURN GET_NO("物品", "黑之魔石"),     25, 40, 60
	CASE 3
		RETURN GET_NO("物品", "星之碎片"),   30, 40, 60
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT

;フレンド採集のみで見つけられるレア枠
@PLACE_RARE_MATERIAL_36, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "彩虹碎片")
ENDSELECT
