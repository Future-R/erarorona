;アイテム番号/入手率/最低品质/最高品质
@PLACE_MATERIAL_3D, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "贤者的香草"),     30, 80, 100
	CASE 1
		RETURN GET_NO("物品", "噗尼噗尼珠"),       30, 80, 100
	CASE 2
		RETURN GET_NO("物品", "星之碎片"),       30, 80, 100
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT


