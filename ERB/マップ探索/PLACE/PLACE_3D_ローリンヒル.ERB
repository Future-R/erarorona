;物品番号/入手率/最低品質/最高品質
@PLACE_MATERIAL_3D, ARG
SELECTCASE ARG
	CASE 0
		RETURN GET_NO("物品", "賢者のハーブ"),     30, 80, 100
	CASE 1
		RETURN GET_NO("物品", "ぷにぷに玉"),       30, 80, 100
	CASE 2
		RETURN GET_NO("物品", "星のかけら"),       30, 80, 100
	;何もなし
	CASE 5
		RETURN 0, 10
ENDSELECT


