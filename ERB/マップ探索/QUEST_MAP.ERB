@QUEST_MAP, ARGS
#LOCALSIZE 3
#DIM NOW_X, 1
#DIM NOW_Y, 1
#DIM SHOW_X, 1
#DIM SHOW_Y, 1
#DIM CHOICE_PLACE, 1
#DIM LINE, 3
#DIM DAY_COST
#DIM MOVE_COST
#DIM SPEED
CALL SET_MAP_COST, FLAG:当前地点
NOW_X = GET_PLACE_X(FLAG:当前地点)
NOW_Y = GET_PLACE_Y(FLAG:当前地点)
SHOW_X = LIMIT(NOW_X, 15, 49 -15)
SHOW_Y = LIMIT(NOW_Y, 10, 40 - 10)
CHOICE_PLACE = FLAG:当前地点
LINE = LINECOUNT
$START
FLAG:跳过消息窗口 = 0
FLAG:消息加速系数 = 1
CLEARLINE LINECOUNT - LINE
REDRAW 0
CALL SHOW_MAP, CHOICE_PLACE, NOW_X, NOW_Y, SHOW_X, SHOW_Y, MAP_COST:CHOICE_PLACE
LINE:1 = LINECOUNT
PRINTFORML %"┌" + "─" * 54 + "┐"%
PRINTFORML │%"请选择指令", 108, LEFT%│
PRINTFORML %"│" + "  " * 54 + "│"%
PRINTFORML │%"8426或大写WASD可移动光标", 108, LEFT%│
PRINTFORML %"│" + "  " * 54 + "│"%
PRINTFORML %"└" + "─" * 54 + "┘"%
$INPUT_START
SELECTCASE ARGS
	CASE "马车", "特快马车"
		CHOICE_PLACE = FLAG:当前地点 == GET_NO("地点", "亚兰德") ? GET_NO("地点", "阿拉尼亚村") # GET_NO("地点", "亚兰德")
		CALL SET_ROOT_CHOICE, CHOICE_PLACE
		CALL SET_ROOT
		GOTO MOVE
	CASEELSE
		ONEINPUTS
ENDSELECT
SELECTCASE AUTO_SPLIT(RESULTS, "_", 0)
	CASE "+", ""
		;選択地点が当前地点なら採取
		IF FLAG:当前地点 == CHOICE_PLACE
			$GATHER
			;アーランドならSHOP画面に帰る
			CLEARLINE LINECOUNT - LINE:1
			IF FLAG:当前地点 == GET_NO("地点", "亚兰德")
				CALL INPUT_YN_M, "要回到工房吗？", "确定", "取消", , , , , 108
				IF !RESULT
					$ATELIER
					VARSET ITEMCHOICE
					FOR LOCAL, 0, BASKET_SIZE()
						SIF !GET_ITEMDATA(LOCAL, "ID")
							CONTINUE
						SIF GET_ITEMDATA(LOCAL, "取出标识")
							CONTINUE
						ITEMCHOICE:LOCAL = 1
					NEXT
					IF MATCH(ITEMCHOICE, 1, 0, BASKET_SIZE())
						CLEARLINE LINECOUNT - LINE:1
						CALL MESSAGE_WINDOW, "", "请选择要移动到箱子里的物品。", , , , 108
						CALL SHOW_ITEMLIST, "归返时", "篮子"
					ENDIF
					RETURN 0
				ENDIF
			ELSEIF  FLAG:当前地点 == GET_NO("地点", "阿拉尼亚村")
				IF GET_EVENT_ATTAIN("随波漂流") || (GET_EVENT_STATE("随波漂流") ==  "去酒馆之前")
					CALL INPUT_YN_M, "要进入阿拉尼亚村吗？", "确定", "取消", , , , , 108
					IF !RESULT
						RETURN 0
					ENDIF
				ENDIF
			ELSEIF FLAG:当前地点 < 100
				CALL INPUT_SELECT_M, @"要在%GET_NAME("地点", CHOICE_PLACE)%采集吗？/[0] 是/[1] 否/[2] 采集到篮子装满为止", , , , , , 108
				SIF RESULT == 1
					GOTO START
				IF RESULT == 2 && BASKET_SIZE() <= GET_ITEM_TOTAL("篮子")
					CALL MESSAGE_WINDOW, "", "篮子已经满了！", , , , 108
					GOTO START
				ENDIF
				CLEARLINE LINECOUNT - LINE:1
				CALL GATHER_MATERIAL, RESULT
			ENDIF
		;移動
		ELSE
			CLEARLINE LINECOUNT - LINE:1
			CALL INPUT_YN_M, @"要移动到%\@ CHOICE_PLACE < 100 ?%GET_NAME("地点", CHOICE_PLACE)%#岔路口 \@%吗？", "确定", "取消", , , , , 108
			SIF RESULT
				GOTO START
			$MOVE
			;栄養剤の效果を消去
			FLAG:材料获得数提升 = 0
			FLAG:材料品质提升 = 0
			FLAG:材料Lv提升 = 0
			FLAG:材料混沌化 = 0
			LOCAL = 0
			;合計歩数を先にチェック
			WHILE ROOT_X:LOCAL >= 0
				LOCAL++
			WEND
			MOVE_COST = LOCAL
			LOCAL = 0
			DAY_COST = 0
			IF ARGS == "马车"
				SPEED = 100
			ELSEIF ARGS == "特快马车"
				SPEED = 1
			ELSEIF GET_ITEMNAME_E(GET_NO_QEQUIP("鞋子"), 0) == "万能跑一趟"
				SPEED = 120
			ELSEIF GET_ITEMNAME_E(GET_NO_QEQUIP("鞋子"), 0) == "街道跑一趟"
				SPEED = 150
			ELSE
				SPEED = 200
			ENDIF
			WHILE ROOT_X:LOCAL >= 0
				CLEARLINE LINECOUNT - LINE
				CALLF GET_ROOT, NOW_X, NOW_Y, 0
				NOW_X = ROOT_X:LOCAL
				NOW_Y = ROOT_Y:LOCAL
				;日数経過
				; 如果是特快马车的话，2天相当于1天
				; 没办法了，因为马车本身就是1格1天，没法继续降低
				IF ARGS == "特快马车"
					DAY_COST += MAP_COST:CHOICE_PLACE / 2
				ELSE
					DAY_COST += MAP_COST:CHOICE_PLACE
				ENDIF
				IF DAY_COST >= MOVE_COST
					DAY_COST -= MOVE_COST
					; 如果没在坐马车，消耗旅行的技艺的充能来跳过时间
					; 1级消耗5，2级消耗4，3级消耗3
					IF ARGS != "特快马车" && ARGS != "马车" && FR_SKILL_LV:GET_NO("友人技能", "旅行的技艺") > 0 && FLAG:旅行充能计数器 >= 6 - FR_SKILL_LV:GET_NO("友人技能", "旅行的技艺")
						FLAG:旅行充能计数器 -= 6 - FR_SKILL_LV:GET_NO("友人技能", "旅行的技艺")
					ELSE
						CALL ADD_DAY, 1
					ENDIF
				ENDIF
				SHOW_X = LIMIT(NOW_X, 15, 49 -15)
				SHOW_Y = LIMIT(NOW_Y, 10, 40 - 10)
				; 更新地图显示
				CALL SHOW_MAP, CHOICE_PLACE, NOW_X, NOW_Y, SHOW_X, SHOW_Y, 0

				; 如果没在坐马车，则可以触发探索事件
				IF ARGS != "特快马车" && ARGS != "马车"
					CALL EXPLORE_EVENT
				ENDIF

				CALL MESSAGE_WINDOW, "", "正在移动" + "…" * (LOCAL % 4), , "没有动画/不再等待/不留日志/无需点击", , 108
				IF INRANGE(GET_PLACE(NOW_X, NOW_Y), 0, 256)
					FLAG:当前地点 = GET_PLACE(NOW_X, NOW_Y)
					CALL START_EVENT
					IF RESULT == 1
						BREAK
					ELSEIF RESULT == 2
						RETURN 1
					ENDIF
				ENDIF
				TWAIT SPEED, 1
				LOCAL++
			WEND
			SIF DAY_COST
				CALL ADD_DAY, 1
			CLEARLINE LINECOUNT - LINE
			SIF ARGS == "马车" || ARGS == "特快马车"
				GOTO ATELIER
			RESTART
		ENDIF
	CASE "-"
		CALL SHOW_ITEMLIST, "篮子", "篮子"
	CASE "/"
		CALL SHOW_ITEMLIST, "箱子", "箱子"
	CASE "#"
		IF FLAG:DEBUG
			INVERTBIT FLAG:地图全显示, 0
			CALL MAP_DATA
			RESTART
		ENDIF
	CASE "*"
		IF GET_ITEMNAME_E(GET_NO_QEQUIP("门"), 0) == "工房归返"
			CLEARLINE LINECOUNT - LINE:1
			IF GET_EVENT_ATTAIN("随波漂流") || (GET_EVENT_STATE("随波漂流") ==  "去酒馆之前")
				CALL INPUT_SELECT_M, "要回到工房吗？/[0] 回到亚兰德/[1] 回到阿拉尼亚村/[9] 取消", , , , , , 108
				SELECTCASE RESULT
					CASE 0
						FLAG:当前地点 = GET_NO("地点", "亚兰德")
						GOTO ATELIER
					CASE 1
						FLAG:当前地点 = GET_NO("地点", "阿拉尼亚村")
						GOTO ATELIER
				ENDSELECT
			ELSE
				CALL INPUT_YN_M, "要回到工房吗？", "确定", "取消", , , , , 108
				IF !RESULT
					FLAG:当前地点 = GET_NO("地点", "亚兰德")
					GOTO ATELIER
				ENDIF
			ENDIF
		ENDIF
	CASE "0"
		CALL TITLE_SAVEGAME
	CASE "9"
		CALL TITLE_LOADGAME
	CASE "."
		CALL MESSAGE_WINDOW_CONFIG
	CASE "2", "4", "6", "8", "W", "A", "S", "D"
		;選択地点を変更
		SELECTCASE RESULTS
			CASE "8","W","w"
				SIF GET_ROOT_N(CHOICE_PLACE) == -1
					GOTO START
				CHOICE_PLACE = GET_ROOT_N(CHOICE_PLACE)
			CASE "4","A","a"
				SIF GET_ROOT_W(CHOICE_PLACE) == -1
					GOTO START
				CHOICE_PLACE = GET_ROOT_W(CHOICE_PLACE)
			CASE "6","D","s"
				SIF GET_ROOT_E(CHOICE_PLACE) == -1
					GOTO START
				CHOICE_PLACE = GET_ROOT_E(CHOICE_PLACE)
			CASE "2","S","d"
				SIF GET_ROOT_S(CHOICE_PLACE) == -1
					GOTO START
				CHOICE_PLACE = GET_ROOT_S(CHOICE_PLACE)
		ENDSELECT
		SHOW_X = LIMIT(GET_PLACE_X(CHOICE_PLACE), 15, 49 - 15)
		SHOW_Y = LIMIT(GET_PLACE_Y(CHOICE_PLACE), 10, 40 - 10)
		LOCAL = 0
		;ルート更新
		WHILE 1
			;空欄があったらいれる
			IF MAP_ROOT:LOCAL == -1
				MAP_ROOT:LOCAL = CHOICE_PLACE
				BREAK
			ENDIF
			;すでに経過しているルートを選んだ場合、そこまで戻す
			IF MAP_ROOT:LOCAL == CHOICE_PLACE
				VARSET MAP_ROOT, -1, LOCAL+1, 50
				BREAK
			ENDIF
			LOCAL++
		WEND
	CASE "外框"
		SELECTCASE AUTO_SPLIT(RESULTS, "_", 1)
			CASE "上"
				SHOW_Y = MAX(SHOW_Y - 1, 0 + 10)
			CASE "下"
				SHOW_Y = MIN(SHOW_Y + 1, 41 - 10)
			CASE "左"
				SHOW_X = MAX(SHOW_X - 1, 0 + 15)
			CASE "右"
				SHOW_X = MIN(SHOW_X + 1, 49 - 15)
		ENDSELECT
	CASE "地点"
		LOCAL = AUTO_SPLIT_INT(RESULTS, "_", 1)
		$CHOICE_PLACE
		;選択地点が当前地点なら採取
		IF LOCAL == FLAG:当前地点 && LOCAL == CHOICE_PLACE
			GOTO GATHER
		;選択地点が選択済みなら移動
		ELSEIF LOCAL == CHOICE_PLACE
			GOTO MOVE
		ELSE
			CHOICE_PLACE = LOCAL
			CALL SET_ROOT_CHOICE, LOCAL
		ENDIF
	CASE "N", "n"
		IF FLAG:采集提示 == 1
			FLAG:采集提示 = 2
		ENDIF
		CALLFORM SHOPCOM_93
	CASEELSE
		IF STRCOUNT("_q_e_r_t_y_u_i_o_p_f_g_h_j_k_l_", "_" + ESCAPE(RESULTS) + "_")
			LOCAL = FLAG:@"快捷键{AUTO_SPLIT_NUM("q_e_r_t_y_u_i_o_p_f_g_h_j_k_l", "_", RESULTS)}"
			GOTO CHOICE_PLACE
		ELSE
			CLEARLINE 1
			GOTO INPUT_START
		ENDIF
ENDSELECT
CALL SET_ROOT
GOTO START
@SET_ROOT_CHOICE, ARG
#LOCALSIZE 1
LOCAL = ARG
;一旦ルート破棄
VARSET MAP_ROOT, -1
;ルート登録
WHILE 1
	ARRAYSHIFT MAP_ROOT, 1, LOCAL, 0
	SIF !MAP_COST:LOCAL
		BREAK
	LOCAL = MAP_PREV:LOCAL
WEND

@SET_ROOT
#LOCALSIZE 3
;一度経路情報を抹消する
CALLF GET_ROOT, , , -2
VARSET ROOT_X, -1
VARSET ROOT_Y, -1
LOCAL = 0
LOCAL:2 = 0
;経路情報にあわせて道を設定する
WHILE MAP_ROOT:(LOCAL+1) >= 0
	IF GET_PLACE_X(MAP_ROOT:LOCAL) == GET_PLACE_X(MAP_ROOT:(LOCAL+1))
		FOR LOCAL:1, GET_PLACE_Y(MAP_ROOT:LOCAL) + (GET_PLACE_Y(MAP_ROOT:LOCAL) < GET_PLACE_Y(MAP_ROOT:(LOCAL + 1)) ? 1 # -1), GET_PLACE_Y(MAP_ROOT:(LOCAL + 1)) + (GET_PLACE_Y(MAP_ROOT:LOCAL) < GET_PLACE_Y(MAP_ROOT:(LOCAL + 1)) ? 1 # -1), (GET_PLACE_Y(MAP_ROOT:LOCAL) < GET_PLACE_Y(MAP_ROOT:(LOCAL + 1)) ? 1 # -1)
			CALLF GET_ROOT, GET_PLACE_X(MAP_ROOT:LOCAL), LOCAL:1, 1
			ROOT_X:(LOCAL:2) = GET_PLACE_X(MAP_ROOT:LOCAL)
			ROOT_Y:(LOCAL:2) = LOCAL:1
			LOCAL:2++
		NEXT
	ELSE
		FOR LOCAL:1, GET_PLACE_X(MAP_ROOT:LOCAL) + (GET_PLACE_X(MAP_ROOT:LOCAL) < GET_PLACE_X(MAP_ROOT:(LOCAL + 1)) ? 1 # -1), GET_PLACE_X(MAP_ROOT:(LOCAL + 1)) + (GET_PLACE_X(MAP_ROOT:LOCAL) < GET_PLACE_X(MAP_ROOT:(LOCAL + 1)) ? 1 # -1), (GET_PLACE_X(MAP_ROOT:LOCAL) < GET_PLACE_X(MAP_ROOT:(LOCAL + 1)) ? 1 # -1)
			CALLF GET_ROOT, LOCAL:1, GET_PLACE_Y(MAP_ROOT:LOCAL), 1
			ROOT_X:(LOCAL:2) = LOCAL:1
			ROOT_Y:(LOCAL:2) = GET_PLACE_Y(MAP_ROOT:LOCAL)
			LOCAL:2++
		NEXT
	ENDIF
	LOCAL++
WEND
;REDRAW 1

;通過ルートの履歴の保存・取得
@GET_ROOT, ARG, ARG:1, ARG:2 = -1
#FUNCTION
#LOCALSIZE 2500
IF ARG:2 >= 0
	LOCAL:(ARG * 50 + ARG:1) = ARG:2
ELSEIF ARG:2 == -2
	VARSET LOCAL, 0
ELSE
	RETURNF LOCAL:(ARG * 50 + ARG:1)
ENDIF

@SET_MAP_COST, ARG = -1
#LOCALSIZE 2
#DIM START
#DIM MIN_COST
#DIM DONE, 256
#DIM COST_B, 10
#DIM ROOT_COST
;経路情報の初期值設定
CALL MAP_DATA
LOCAL = -1
VARSET DONE, 0
VARSET MAP_COST, 256
START = ARG
VARSET MAP_ROOT, -1
MAP_ROOT = START
MAP_COST:START = 0
LOCAL:1 = 0

;-------------------------------
;ダイクストラ法で距離を計算する
;-------------------------------
WHILE MINARRAY(DONE) == 0
	MIN_COST = 1024
 	FOR LOCAL, 0, 256
 		SIF DONE:LOCAL
 			CONTINUE
 		IF EXIST_PLACE(LOCAL) <= 0
 			DONE:LOCAL = 1
			CONTINUE
		ENDIF
 		IF MAP_COST:LOCAL < MIN_COST
 			MIN_COST = MAP_COST:LOCAL
 			START = LOCAL
 		ENDIF
 	NEXT
 	DONE:START = 1
 	FOR LOCAL, 0, 256
 		IF MAP_COST:LOCAL > MAP_COST:START + GET_DISTANCE(LOCAL, START)
 			MAP_PREV:LOCAL = START
 			MAP_COST:LOCAL = MAP_COST:START + GET_DISTANCE(LOCAL, START)
 		ENDIF
 	NEXT
WEND
;一度経路情報を抹消する
CALLF GET_ROOT, , , -2
