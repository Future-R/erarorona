; 标签，用来在设置里控制某些事件的开关，比如非自愿色情事件
@EXPLORER_TAG_1
RESULTS =

; 触发次数上限，约定-1为无限
@EXPLORER_MAX_1
RETURN -1

; 优先级，越小越优先，不可重复，小于100，定义在探索事件数
@EXPLORER_ORDER_1
RETURN 50

@EXPLORER_CHECK_1
; 在野外且不是岔路口才能触发
SIF !IS_OUTDOOR(FLAG:当前地点)
    RETURN 0
SIF IS_ROADFORK()
    RETURN 0
SIF !探索事件1_存在可拾取物品()
    RETURN 0
; 基础触发概率为3%，加成先不做
IF RAND:10000 < 9700
    RETURN 0
ENDIF
RETURN 1

@EXPLORER_ACT_1
CALL INPUT_YN_M, "咦！地上有什么东西？", "捡起", "不管", , "没有动画", , , 108
IF !RESULT
    CALL GATHER_MATERIAL, 3
    ; CALL MESSAGE_WINDOW, "", "测试01！", , , , 108
ENDIF

@探索事件1_存在可拾取物品()
#FUNCTION
#DIM 物品表序号

FOR 物品表序号, 0, 10
	VARSET RESULT, 0, 0, 10
	TRYCCALLFORM PLACE_MATERIAL_%TOSTR(FLAG:当前地点,"X2")%, 物品表序号
		SIF RESULT == 0 || RESULT:1 <= 0
			CONTINUE
		RETURNF 1
	CATCH
	ENDCATCH
NEXT

RETURNF 0
