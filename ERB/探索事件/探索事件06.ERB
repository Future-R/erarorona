; 标签，用来在设置里控制某些事件的开关，比如非自愿色情事件
@EXPLORER_TAG_6
RESULTS = "非自愿色情事件"

; 触发次数上限，约定-1为无限
@EXPLORER_MAX_6
RETURN 3

; 优先级，越小越优先，不可重复，小于100，定义在探索事件数
@EXPLORER_ORDER_6
RETURN 49

@EXPLORER_CHECK_6
; 在野外才能触发
SIF !IS_OUTDOOR(FLAG:当前地点)
    RETURN 0
; 基础触发概率为1%，加成先不做
IF RAND:10000 < 9900
    RETURN 0
ENDIF
RETURN 1

