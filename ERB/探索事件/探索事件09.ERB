@EXPLORER_TAG_9
RESULTS =

; 触发次数上限, 约定-1为无限
@EXPLORER_MAX_9
RETURN -1

; 优先级, 越小越优先, 不可重复, 小于100, 定义在探索事件数
@EXPLORER_ORDER_9
RETURN 55

@EXPLORER_CHECK_9
; 在名字带有“森林”的地点才能触发
IF !STRCOUNT(GET_NAME("地点", FLAG:当前地点), "森林")
	RETURN 0
ENDIF
; 当前为扶她无法触发
SIF CFLAG:(MASTER):蘑菇之力 !=0
    RETURN 0
; 经过事件"新品馅饼？"才能触发
SIF !GET_EVENT_ATTAIN("新品馅饼？")
	RETURN 0
; 概率2%
IF RAND:10000 < 9800
	RETURN 0
ENDIF
RETURN 1

