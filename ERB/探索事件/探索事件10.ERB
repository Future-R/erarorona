; 标签, 用来在设置里控制某些事件的开关, 比如非自愿色情事件
@EXPLORER_TAG_10
RESULTS =

; 触发次数上限, 约定-1为无限
@EXPLORER_MAX_10
RETURN 1

; 优先级, 越小越优先, 不可重复, 小于100, 定义在探索事件数
@EXPLORER_ORDER_10
RETURN 56

@EXPLORER_CHECK_10
; 在亚兰德才能触发
SIF FLAG:当前地点 != GET_NO("地点", "亚兰德")
	RETURN 0
; 认识里欧且认识坦特才能触发
SIF !CFLAG:GET_CNUM("里欧涅菈"):认识 || !CFLAG:GET_CNUM("坦特里斯"):认识
	RETURN 0
; 里欧和坦特都在时才能触发
SIF FLAG:当前地点 != GET_NO("地点", CSTR:GET_CNUM("坦特里斯"):所在地)
	RETURN 0
SIF FLAG:当前地点 != GET_NO("地点", CSTR:GET_CNUM("里欧涅菈"):所在地)
	RETURN 0
RETURN 1

