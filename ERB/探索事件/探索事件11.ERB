; 标签, 用来在设置里控制某些事件的开关, 比如非自愿色情事件
@EXPLORER_TAG_11
RESULTS =

; 触发次数上限, 约定-1为无限
@EXPLORER_MAX_11
RETURN 1

; 优先级, 越小越优先, 不可重复, 小于100, 定义在探索事件数
@EXPLORER_ORDER_11
RETURN 57

@EXPLORER_CHECK_11
; 经过事件"奇怪的吟游诗人"3天后才能触发
SIF !GET_EVENT_ATTAIN("奇怪的吟游诗人") || GET_EVENT_ATTAIN("奇怪的吟游诗人") + 3 < DAY
	RETURN 0

RETURN 1

