; 优先级，越小越优先，不可重复，小于100，定义在探索事件数
@EXPLORER_ORDER_12
RETURN 46

@EXPLORER_CHECK_12
; 在野外才能触发
SIF !IS_OUTDOOR(FLAG:当前地点)
	RETURN 0
; 在产出纠缠草的地点才能触发
CALL HAVE_MATERIAL, "纠缠草"
IF !RESULT
	RETURN 0
ENDIF
; 基础触发概率为2%
IF RAND:10000 < 9800
	RETURN 0
ENDIF
RETURN 1

