@ITEM_NAME_41
RESULTS = 盖土菇

@ITEM_CATEGORY_41, ARG
SELECTCASE GET_NAME("调合类别", ARG)
	CASE "中和剂"
		RETURN 50
	CASE "食材：蔬菜"
		RETURN 20
	CASE "菌菇"
		RETURN 0
	CASE "植物类"
		RETURN 0
	CASEELSE
		RETURN -1
ENDSELECT

@ITEM_LV_41
RETURN 2

@ITEM_EXPLAIN_41, ARG
IF ARG
	RESULTS = 在土地中成长，具有上方有生物通过时突然从土里钻出的性质。
ELSE
	RESULTS = 群升于树木根部的菌菇。/它生长在土里，具有当动物等从上放经过时，突然从土里钻出惊吓对方的性质。/采集时必须注意别因一时疏忽，而不小心跌倒。
ENDIF

@ITEM_PRICE_41
RETURN 4
