@ITEM_NAME_42
RESULTS = 橡树菇

@ITEM_CATEGORY_42, ARG
;调合类别ー值
SELECTCASE GET_NAME("调合类别", ARG)
	CASE "中和剂"
		RETURN 50
	CASE "调味料"
		RETURN 40
	CASE "菌菇"
		RETURN 10
	CASEELSE
		RETURN -1
ENDSELECT

@ITEM_LV_42
RETURN 1

@ITEM_EXPLAIN_42, ARG
IF ARG
	RESULTS = 随处可见的蘑菇。不太适合食用。
ELSE
	RESULTS = 还算是遍地生长的菌菇。/城镇外就不用说，也能在稍微肮脏的房间橱柜里见到。/茎的部分纤维很粗，因此不太适合拿来食用。
ENDIF

@ITEM_PRICE_42
RETURN 8
	