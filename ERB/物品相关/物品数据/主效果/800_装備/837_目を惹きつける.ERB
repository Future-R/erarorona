@EFFECT_NAME_837
RESULTS = 引人注目

@EFFECT_EXPLAIN_837
RESULTS = 调教对象的[恭顺]和[愉悦]参数变得容易上升/调教对象的[反感]变得难以上升。指令变得容易执行。

;装備箇所・装備角色
@EFFECT_EQUIP_837, ARGS, ARG = -1
IF ARG == -1 && ARGS == ""
	RESULTS = 魅惑加成
	RETURN 30
ENDIF
EQUIP:ARG:诱惑加成 += CALCF_EQUIP_POWER(30, ARGS, ARG)
@EFFECT_EQUIP_STATUS_837, ARGS, ARGS:1, ARG
SELECTCASE ARGS
	CASE "诱惑"
		RETURN CALCF_EQUIP_POWER(30, ARGS:1, ARG)
	CASEELSE
		RETURN 0
ENDSELECT

