CATCH
	IF IS_PROPERTY_TALENT(ARG)
		CALL PROPERTY_NAME_TALENT, ARG
	ELSEIF IS_PROPERTY_ABL(ARG)
		CALL PROPERTY_NAME_ABL, ARG
	ELSE
