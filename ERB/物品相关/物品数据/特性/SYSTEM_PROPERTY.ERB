
@PROPERTY_TALENT_START
#FUNCTION
RETURNF 400

@PROPERTY_TALENT_END
#FUNCTION
RETURNF 999

@PROPERTY_TALENT_SIZE
#FUNCTION
RETURNF MIN(VARSIZE("TALENT"), (PROPERTY_TALENT_END() - PROPERTY_TALENT_START() + 1) / VARSIZE("TALENT_COST"))

@IS_PROPERTY_TALENT, ARG
#FUNCTION
RETURNF INRANGE(ARG, PROPERTY_TALENT_START(), PROPERTY_TALENT_END())

@PROPERTY_ABL_START
