;その等级のになるのに必要な総经验值のテーブル
@GET_TABLE_MIXLV, ARG
#FUNCTION
#LOCALSIZE 51
IF LOCAL:1 == 0
	LOCAL:1  =    0,    8,   18,   31,   47,   67,   92,  123,  160,  204
	LOCAL:11 =  256,  316,  385,  464,  553,  653,  764,  886, 1020, 1166
	LOCAL:21 = 1321, 1485, 1659, 1843, 2037, 2241, 2456, 2682, 2919, 3167
	LOCAL:31 = 3426, 3697, 3980, 4275, 4582, 4901, 5224, 5552, 5885, 6224
	LOCAL:41 = 6569, 6921, 7280, 7646, 8019, 8400, 8789, 9186, 9591, 10000
ENDIF
RETURNF LOCAL:ARG

;ARGの現在の调合等级を经验值から取る
@GET_MIXLV, ARG = -1
#FUNCTION
#LOCALSIZE 1
ARG = -1 ? MASTER # ARG
FOR LOCAL, 1, 49
	SIF BASE:ARG:调合经验值 < GET_TABLE_MIXLV(LOCAL+1)
		RETURNF LOCAL
NEXT
RETURNF 50

;次までの必要经验值
@GET_MIXEXP_NEED, ARG = -1
#FUNCTION
#LOCALSIZE 1
ARG = -1 ? MASTER # ARG
IF GET_MIXLV(ARG) < 50
	RETURNF GET_TABLE_MIXLV(GET_MIXLV(ARG) + 1) - BASE:ARG:调合经验值
ELSE
	RETURNF 0
ENDIF

;等级があがってから稼いだ经验值
@GET_MIXEXP_NOW, ARG = -1
#FUNCTION
ARG = -1 ? MASTER # ARG
IF GET_MIXLV(ARG) < 50
	RETURNF BASE:ARG:调合经验值 - GET_TABLE_MIXLV(GET_MIXLV(ARG))
ELSE
	RETURNF 0
ENDIF

;等级と等级の間の必要经验值
@GET_MIXEXP_NEXT, ARG = -1
#FUNCTION
ARG = -1 ? MASTER # ARG
IF GET_MIXLV(ARG) < 50
	RETURNF GET_TABLE_MIXLV(GET_MIXLV(ARG)+1) - GET_TABLE_MIXLV(GET_MIXLV(ARG))
ELSE
	RETURNF 0
ENDIF

;取得经验值
;ARGはアイテム、ARG:1は数量
;引数の指定なしで
@GET_MIXEXP, ARG, ARG:1
#LOCALSIZE 1
#DIM ITEMLV
#DIM ITEMDAY
#DIM MIXEXP
#DIM MIXEXP_SUM
CALLFORM ITEM_LV_{ARG}
ITEMLV = RESULT
CALLFORM ITEM_DAY_{ARG}
ITEMDAY = RESULT

;基礎值はLV + 5(あとで10でわるのでここでは10倍しておく)
MIXEXP = 50 + ITEMLV * 10

;经验值は必要日数倍される(これも10倍された数值がはいってるので注意)
MIXEXP *= ITEMDAY

;必要日数が多いアイテムはボーナスがはいる(1日以下0% 2日 8% 3日　18% 4日 36% 5日 50%)
MIXEXP *= (ITEMDAY * ITEMDAY) / 50 + 100

;等级差加成(-8~8 50%-150%)
LOCAL = ITEMLV - GET_MIXLV()
MIXEXP *= LOCAL >= 0 ? 100 + MIN(LOCAL * LOCAL, 50) # 100 - MIN(LOCAL * LOCAL, 50)
LOCAL = 1
MIXEXP_SUM = 0
;数量にあわせて調整
FOR LOCAL, 0, ARG:1
	MIXEXP_SUM += MIXEXP / (LOCAL + 1)
NEXT
LOCAL = 100
LOCAL += FR_SKILL_LV:GET_NO("友人技能", "一本正经") * 20
LOCAL += IS_TAKE_OVER("调合EXP增加：小") * 10
LOCAL += IS_TAKE_OVER("调合EXP增加：中") * 25
LOCAL += IS_TAKE_OVER("调合EXP增加：大") * 50
MIXEXP_SUM = TIMESF(MIXEXP_SUM, LOCAL)
;10倍、10倍、100倍, 100倍になってるので割る
MIXEXP_SUM /= 10 * 10 * 100 * 100
RETURN MIXEXP_SUM
