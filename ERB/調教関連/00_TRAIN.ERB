@TRAIN
#LOCALSIZE 2
CALL 记录调教开始, TARGET
CALL BGM, "扭曲的念头.mp3"
CALL TRAIN_START
REDRAW 0
WHILE 1
	CALL TURN_START

	$SELECT
	CALL SHOW_TRAIN_STATUS
	CALL SELECT_COMMAND
	IF RESULT == -1
		BREAK
	ELSE
		CALL COM_ORDER, SELECTCOM, TFLAG:消耗品登记编号, TARGET, PLAYER
		SIF !RESULT
			GOTO SELECT
		LOCAL:1 = 0
		IF IS_TRAINITEM(SELECTCOM)
			FOR LOCAL, 0, 4
				SIF GET_ITEMNAME_E(TFLAG:消耗品登记编号, LOCAL) == "对调教者用"
					LOCAL:1 = 1
			NEXT
		ENDIF
		IF LOCAL:1
			CALL COM_ACT, SELECTCOM, TFLAG:消耗品登记编号, PLAYER, TARGET
		ELSE
			CALL COM_ACT, SELECTCOM, TFLAG:消耗品登记编号, TARGET, PLAYER
		ENDIF
	ENDIF
	CALL TEQUIP_ACT, SELECTCOM
	REDRAW 0
	CALL ADD_SOURCE
	CALL SOURCE_CHECK_PREASURE
	CALL ADD_SOURCE_PREASURE
	CALL SOURCE_CHECK
	CALL SOURCE_CHECK_AFTER
	CALL SHOW_SOURCE_CHECK
	CALL TURN_END
	SIF RESULT == -1
		BREAK
WEND
REDRAW 1
CALL SHOW_RESULT
CALL ABL_UP, TARGET
CALL TRAIN_END
即视感本次调教生效 = 0
RETURN 1
;BEGIN SHOP
