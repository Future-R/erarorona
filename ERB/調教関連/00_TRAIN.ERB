@TRAIN
#LOCALSIZE 2
CALL TRAIN_START
REDRAW 0
WHILE 1
	CALL TURN_START

	$SELECT
	CALL SHOW_TRAIN_STATUS
	CALL SELECT_COMMAND
	IF RESULT == -1
		BREAK
	ELSE
		CALL COM_ORDER, SELECTCOM, TFLAG:使用アイテム登録番号, TARGET, PLAYER
		SIF !RESULT
			GOTO SELECT
		LOCAL:1 = 0
		IF IS_TRAINITEM(SELECTCOM)
			FOR LOCAL, 0, 4
				SIF GET_ITEMNAME_E(TFLAG:使用アイテム登録番号, LOCAL) == "調教者用"
					LOCAL:1 = 1
			NEXT
		ENDIF
		IF LOCAL:1
			CALL COM_ACT, SELECTCOM, TFLAG:使用アイテム登録番号, PLAYER, TARGET
		ELSE
			CALL COM_ACT, SELECTCOM, TFLAG:使用アイテム登録番号, TARGET, PLAYER
		ENDIF
	ENDIF
	CALL TEQUIP_ACT, SELECTCOM
	REDRAW 0
	CALL ADD_SOURCE
	CALL SOURCE_CHECK_PREASURE
	CALL ADD_SOURCE_PREASURE
	CALL SOURCE_CHECK
	CALL SOURCE_CHECK_AFTER
	CALL SHOW_SOURCE_CHECK
	CALL TURN_END
	SIF RESULT == -1
		BREAK
WEND
REDRAW 1
CALL SHOW_RESULT
CALL ABL_UP, TARGET
CALL TRAIN_END
RETURN 1
;BEGIN SHOP
