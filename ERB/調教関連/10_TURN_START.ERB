@TURN_START
#DIM 连锁增加倍率
;ターン数追加
TFLAG:当前回合++

FOR LOCAL, 0, 3
	SIF TRAINCHARA(LOCAL) < 0
		CONTINUE
	;変数初期化
	VARSET TCVAR:TRAINCHARA(LOCAL):0, 0, 0, 500
	VARSET NOWEX:TRAINCHARA(LOCAL):0
	VARSET SOURCE:TRAINCHARA(LOCAL):0
	VARSET CUP:TRAINCHARA(LOCAL):0
	VARSET CDOWN:TRAINCHARA(LOCAL):0
	VARSET DOWNBASE:TRAINCHARA(LOCAL):0
NEXT

;TFLAGは499までがターンごと
;500以降が調教ごととなる
VARSET TFLAG, 0, 0, 500
VARSET TSTR, "", 0, 500
TFLAG:消耗品登记编号 = -1
TFLAG:连锁系数 = 100
TFLAG:连锁系数负值 = 100
连锁增加倍率 = 获取习惯特质连锁增加倍率()
FOR LOCAL, 0, GET_STRFLAG_ELEMENTNUM("TSTR:连锁判定") - 1
	TFLAG:连锁系数 = TIMESF(TFLAG:连锁系数, 100 + TIMESF(10 + (TRAIN_SKILL_POWER_连锁强化(PLAYER, TARGET) + TRAIN_STATE_POWER_连锁特效(TARGET, PLAYER)) / 10, 连锁增加倍率))
	TFLAG:连锁系数负值 = TIMESF(TFLAG:连锁系数负值, 95 - TRAIN_SKILL_POWER_连锁强化(PLAYER, TARGET) + TRAIN_STATE_POWER_连锁特效(TARGET, PLAYER) / 20)
NEXT
TFLAG:连锁系数 = MIN(TFLAG:连锁系数, 1000)
TFLAG:连锁系数负值 = MAX(TFLAG:连锁系数负值, 10)
;使用可能アイテム候補のリスト作成
CALL SET_ITEMLIST, "调教"



