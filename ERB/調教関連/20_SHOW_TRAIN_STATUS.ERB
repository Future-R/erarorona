;---------------------------------------------------------------------
;
;	Module		:20_SHOW_TRAIN_STATUS.ERB
;	Facility	:調教ステータス表示関数
;
;	Licence		:フリー
;
;	Modification Data:調教時のステータスを表示する
;
;
;	Edit	Date		ver		Author					Reason
;	001		2012/06/10	X.XXX	kap						新規作成
;	002		2012/08/07	X.XXX	kap						想定画面サイズを変更
;	003		2012/08/30	0.330	kap						アニメーションのコマ数設定機能を追加
;	004		2012/12/01	0.430	kap						友人技能の発動を表示するように
;	005		2013/09/25	0.480	kap						内部の処理をLAYER形式に変更
;---------------------------------------------------------------------
;ARG 	基準となるターン
;コマ	現在のコマ数を示す。-1はアニメなし、-2は状況欄もなし
;--------------------------------------------------------------------
@SHOW_TRAIN_STATUS, ARG = -1, コマ = -1
#LOCALSIZE 2
#DIM N_TURN
#DIM P_TURN
#DIM コマ
#DIM コマ数
#DIM 表示BASEP, 10
#DIM 表示BASET, 10
#DIM 表示PALAMP, 100
#DIM 表示PALAMT, 100
#DIM 表示TIME, 1

#DIM LAYER_X
#DIM LAYER_Y
コマ数 = GLOBAL:PALAM动画帧数
N_TURN = ARG == -1 ? TFLAG:当前回合 # ARG
P_TURN = MAX(0, N_TURN - 1)
IF コマ >= 0
	FOR LOCAL, 0, 10
		表示BASET:LOCAL = (GET_TRAINRECORD_C("TARGET", "BASE", P_TURN, LOCAL) * (コマ数 - コマ) + GET_TRAINRECORD_C("TARGET", "BASE", N_TURN, LOCAL) * コマ) / コマ数
		表示BASEP:LOCAL = (GET_TRAINRECORD_C("PLAYER", "BASE", P_TURN, LOCAL) * (コマ数 - コマ) + GET_TRAINRECORD_C("PLAYER", "BASE", N_TURN, LOCAL) * コマ) / コマ数
	NEXT
	FOR LOCAL, 0, 100
		表示PALAMT:LOCAL = (GET_TRAINRECORD_C("TARGET", "PALAM", P_TURN, LOCAL) * (コマ数 - コマ) + GET_TRAINRECORD_C("TARGET", "PALAM", N_TURN, LOCAL) * コマ) / コマ数
		表示PALAMP:LOCAL = (GET_TRAINRECORD_C("PLAYER", "PALAM", P_TURN, LOCAL) * (コマ数 - コマ) + GET_TRAINRECORD_C("PLAYER", "PALAM", N_TURN, LOCAL) * コマ) / コマ数
	NEXT
	表示TIME = (GET_TRAINRECORD("剩余时间", P_TURN) * (コマ数 - コマ) + GET_TRAINRECORD("剩余时间", N_TURN) * コマ) / コマ数
ELSE
	FOR LOCAL, 0, 10
		表示BASET:LOCAL = GET_TRAINRECORD_C("TARGET", "BASE", N_TURN, LOCAL)
		表示BASEP:LOCAL = GET_TRAINRECORD_C("PLAYER", "BASE", N_TURN, LOCAL)
	NEXT
	FOR LOCAL, 0, 100
		表示PALAMT:LOCAL = GET_TRAINRECORD_C("TARGET", "PALAM", N_TURN, LOCAL)
		表示PALAMP:LOCAL = GET_TRAINRECORD_C("PLAYER", "PALAM", N_TURN, LOCAL)
	NEXT
	表示TIME = GET_TRAINRECORD("剩余时间", N_TURN)
ENDIF
SIF コマ <= -1
	TFLAG:显示开始线 = LINECOUNT

CALL INIT_LAYER
LAYER_X = 0
LAYER_Y = 0
CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"%@"　%SHOW_DAY()%　　-%NAME:TARGET%調教-", 56, LEFT%Turn:{N_TURN,2}　Time:%LAYER_CBAR(表示TIME, 10000, 50, UNICODE(0x2584), UNICODE(0x2584), BARCOLORSET("黄"), RESULT:1)%", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2

CALL LAYER_SET, @"　%CALLNAME:TARGET,60, LEFT%", LAYER_Y + 3
CALL LAYER_SET, "　体力", LAYER_Y + 4
CALL LAYER_SET, LAYER_CBAR(表示BASET:(GETNUM(BASE, "体力")), GET_MAXBASE("体力", TARGET), 41, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("红"), RESULT:1), LAYER_Y + 4
CALL LAYER_SET, @"({表示BASET:(GETNUM(BASE, "体力")), 5}/{GET_MAXBASE("体力", TARGET), 5})", LAYER_Y + 4

CALL LAYER_SET, "　气力", LAYER_Y + 5
CALL LAYER_SET, LAYER_CBAR(表示BASET:(GETNUM(BASE, "气力")), GET_MAXBASE("气力", TARGET), 41, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("绿"), RESULT:1), LAYER_Y + 5
CALL LAYER_SET, @"({表示BASET:(GETNUM(BASE, "气力")), 5}/{GET_MAXBASE("气力", TARGET), 5})", LAYER_Y + 5

CALL LAYER_SET, "　欲情", LAYER_Y + 6
CALL LAYER_SET, LAYER_CBAR(表示BASET:(GETNUM(BASE, "欲情")), GET_MAXBASE("欲情", TARGET), 41, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("紫"), RESULT:1), LAYER_Y + 6
CALL LAYER_SET, @"({表示BASET:(GETNUM(BASE, "欲情")), 5}/{GET_MAXBASE("欲情", TARGET), 5})", LAYER_Y + 6

CALL LAYER_SET, "　润滑", LAYER_Y + 7
CALL LAYER_SET, LAYER_CBAR(表示BASET:(GETNUM(BASE, "润滑")), GET_MAXBASE("润滑", TARGET), 41, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("白"), RESULT:1), LAYER_Y + 7
CALL LAYER_SET, @"({表示BASET:(GETNUM(BASE, "润滑")), 5}/{GET_MAXBASE("润滑", TARGET), 5})", LAYER_Y + 7


CALL LAYER_SET, @"　%CALLNAME:PLAYER,60, LEFT%", LAYER_Y + 3, 60
CALL LAYER_SET, "　体力", LAYER_Y + 4
CALL LAYER_SET, LAYER_CBAR(表示BASEP:(GETNUM(BASE, "体力")), GET_MAXBASE("体力", PLAYER), 41, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("红"), RESULT:1), LAYER_Y + 4
CALL LAYER_SET, @"({表示BASEP:(GETNUM(BASE, "体力")), 5}/{GET_MAXBASE("体力", PLAYER), 5})", LAYER_Y + 4

CALL LAYER_SET, "　气力", LAYER_Y + 5, 60
CALL LAYER_SET, LAYER_CBAR(表示BASEP:(GETNUM(BASE, "气力")), GET_MAXBASE("气力", PLAYER), 41, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("绿"), RESULT:1), LAYER_Y + 5
CALL LAYER_SET, @"({表示BASEP:(GETNUM(BASE, "气力")), 5}/{GET_MAXBASE("气力", PLAYER), 5})", LAYER_Y + 5

CALL LAYER_SET, "　欲情", LAYER_Y + 6, 60
CALL LAYER_SET, LAYER_CBAR(表示BASEP:(GETNUM(BASE, "欲情")), GET_MAXBASE("欲情", PLAYER), 24, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("紫"), RESULT:1), LAYER_Y + 6
CALL LAYER_SET, "　润滑", LAYER_Y + 6
CALL LAYER_SET, LAYER_CBAR(表示BASEP:(GETNUM(BASE, "润滑")), GET_MAXBASE("润滑", PLAYER), 24, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("白"), RESULT:1), LAYER_Y + 6

CALL LAYER_SET, , LAYER_Y + 7, 60
FOR LOCAL, 0, 4
	CALL LAYER_SET, "　" + AUTO_SPLIT("快Ｃ_快Ｖ_快Ａ_快Ｂ", "_", LOCAL), LAYER_Y + 7
	CALL LAYER_SET, LAYER_CBAR(表示PALAMP:(GETNUM(PALAM, AUTO_SPLIT("快Ｃ_快Ｖ_快Ａ_快Ｂ", "_", LOCAL))), 10000, 9, UNICODE(0x2583), UNICODE(0x2583), BARCOLORSET("蓝"), RESULT:1), LAYER_Y + 7
NEXT
CALL LAYER_DRAWLINE, LAYER_Y + 8
;CALL SHOW_EQUIP_2

;------------------------------------------------------------------------------------------------------------------------
;パラメーター表示
;------------------------------------------------------------------------------------------------------------------------
LOCAL:1 = 0
FOR LOCAL, 0, 14
	SIF LOCAL % 4 == 0
		CALL LAYER_SET, "　", LAYER_Y + 9 + LOCAL / 4, 0
	LOCALS = %AUTO_SPLIT("快Ｃ/快Ｖ/快Ａ/快Ｂ/恭顺/愉悦/屈服/习得/耻情/苦痛/恐怖/反感/不快/抑郁", "/", LOCAL)%
	CALL LAYER_SET, SHOW_INFO_PALAM(LOCALS, 表示PALAMT:GETNUM(PALAM, LOCALS)) + "　", LAYER_Y + 9 + LOCAL / 4
NEXT
IF コマ >= -1
	VARSET LOCALS
	CALL LAYER_DRAWLINE, LAYER_Y + 13
	SPLIT TRAIN_CONDITIONS:N_TURN, "_", LOCALS
	FOR LOCAL, 0, 4
		CALL LAYER_SET, LOCALS:LOCAL, LAYER_Y + 14 + LOCAL
	NEXT
	CALL LAYER_DRAWLINE, LAYER_Y + 18
	CALL LAYER_PRINT, , 19
ELSE
	CALL LAYER_DRAWLINE, LAYER_Y + 13
	CALL LAYER_PRINT, , 14
ENDIF
SIF コマ == -1
	TFLAG:菜单显示线 = LINECOUNT
IF コマ < 0
	FOR LOCAL, 0, 10
		表示BASET:LOCAL = GET_TRAINRECORD_C("TARGET", "BASE", N_TURN, LOCAL)
		表示BASEP:LOCAL = GET_TRAINRECORD_C("PLAYER", "BASE", N_TURN, LOCAL)
	NEXT
	FOR LOCAL, 0, 100
		表示PALAMT:LOCAL = GET_TRAINRECORD_C("TARGET", "PALAM", N_TURN, LOCAL)
		表示PALAMP:LOCAL = GET_TRAINRECORD_C("PLAYER", "PALAM", N_TURN, LOCAL)
	NEXT
ENDIF
;CALL SHOW_EQUIP_1
;==========================================================
;<関数名>
; SHOW_INFO_PALAM
;<関数の説明>
; 対象の現在のパラメータ状況を表示する。
;<引数>
; [ARG] PALAMの值
;<戻り值>: なし
;==========================================================
@SHOW_INFO_PALAM, ARGS, ARG
#FUNCTIONS
#DIM PLV, 1
#LOCALSIZE 4
#LOCALSSIZE 1
LOCALS '= ARGS
PLV = GETPALAMLV(ARG, 20)
LOCALS += @"Lv{PLV, 2} "
;SELECTCASE FLAG:PALAM表示設定
LOCAL:1 = ARG
LOCAL:2 = ARG-PALAMLV:PLV
LOCAL:3 = PALAMLV:(PLV+1)-PALAMLV:PLV
LOCALS += LAYER_RECTBAR(LOCAL:2, LOCAL:3, 5, BARCOLORSET("蓝"), RESULT:1, , , 30)
LOCALS += " ("
SELECTCASE STRLENS(TOSTR(LOCAL:1))
	CASE IS < 7
		LOCALS += @"{LOCAL:1, 6}"
	CASEELSE
		LOCALS += @"%TOSTR(LOCAL:1 / POWER(10, 4 + 2), "##"), 2%.%TOSTR(LOCAL:1 / POWER(10, 4) % POWER(10, 2), "00"), 2%M"
ENDSELECT
LOCALS += ")"
RETURNF LOCALS

@SET_TRAIN_CONDITION, ARG
TRAIN_CONDITIONS:ARG = 
CALL SET_TRAIN_CONDITION_SUB, , "スタート"
SIF SELECTCOM >= 0
	CALL SET_TRAIN_CONDITION_SUB, ARG, @"COM:%GET_SELECTCOMNAME()%"
SIF GET_STRFLAG_ELEMENTNUM("TSTR:连锁判定") > 2
	CALL SET_TRAIN_CONDITION_SUB, ARG, @"{GET_STRFLAG_ELEMENTNUM("TSTR:连锁判定")}CHAIN.{TFLAG:连锁系数}\%"
FOR LOCAL, 0, 4
	LOCALS = %AUTO_SPLIT("苦痛/快乐/屈服/抗拒", "/", LOCAL)%烙印
	SIF TCVAR:TARGET:@"调教中获得%LOCALS%" > 0
		CALL SET_TRAIN_CONDITION_SUB, ARG, @"获得%LOCALS%Lv{TCVAR:TARGET:("调教中获得" + LOCALS)}"
NEXT
IF TRAIN_STATE_POWER_疲劳感麻痹(TARGET)
	CALL SET_TRAIN_CONDITION_SUB, ARG, "疲劳感麻痹"
ELSE
	SIF !BASE:TARGET:气力
		CALL SET_TRAIN_CONDITION_SUB, ARG, "疲労状态"
	SIF TRAIN_STATE_POWER_疲劳感增加(TARGET)
		CALL SET_TRAIN_CONDITION_SUB, ARG, "疲劳感增加"
ENDIF
	
FOR LOCAL:1, 0, 3
	SIF TRAINCHARA(LOCAL:1) < 0
		CONTINUE
	FOR LOCAL, 0, 调教状态数
		RESULTS '= ""
		RESULT = 0
		TRYCCALLFORM TRAIN_STATE_IS_SHOW_%GET_NAME("调教状态", LOCAL)%
			SIF !RESULT
				CONTINUE
			SIF RESULTS == ""
				RESULTS '= GET_NAME("调教状态", LOCAL)
			CALLFORMF TRAIN_STATE_POWER_%GET_NAME("调教状态", LOCAL)%, TRAINCHARA(LOCAL:1), , 1
			SIF !RESULT
				CONTINUE
			SIF LOCAL:1 != 1
				RESULTS += "(" + CALLNAME:TRAINCHARA(LOCAL:1) + ")"
			CALL SET_TRAIN_CONDITION_SUB, ARG, RESULTS
		CATCH
		ENDCATCH
	NEXT
	FOR LOCAL, 700, 800
		SIF !TCVAR:TRAINCHARA(LOCAL:1):LOCAL
			CONTINUE
		CALL SET_TRAIN_CONDITION_SUB, ARG, @"%TCVARNAME:(LOCAL - 400)%(%CALLNAME:TRAINCHARA(LOCAL:1)%)"
	NEXT
NEXT

FOR LOCAL, 0, 友人技能数
	SIF !FR_SKILL_USE:LOCAL
		CONTINUE
	CALL SET_TRAIN_CONDITION_SUB, ARG, @"%GET_NAME("友人技能", LOCAL)%"
NEXT

@SET_TRAIN_CONDITION_SUB, ARG, ARGS
#DIM 字数
IF ARGS == "スタート"
	字数 = 0
	RETURN 0
ENDIF
IF STRLENS(HTML_TOPLAINTEXT(ARGS)) + 3 +字数 > MAXWIDTH() - 6
	TRAIN_CONDITIONS:ARG += "_"
	字数 = 0
ENDIF
字数 += STRLENS(HTML_TOPLAINTEXT(ARGS)) + 3
TRAIN_CONDITIONS:ARG += " " + "[" + ARGS + "]"

