;恐怖によるソース変動の処理
CALL ADD_FEAR_SOURCE, TARGET, PLAYER, SELECTCOM, TFLAG:使用アイテム登録番号
;快ソースの補正値チェック(ステータスやスキルによる倍化)
FOR LOCAL, 0, 4
	LOCALS = 快%AUTO_SPLIT("Ｃ/Ｖ/Ａ/Ｂ", "/", LOCAL)%
	CALL GET_SOURCE_POWER, LOCALS, TARGET, PLAYER
	SOURCE:TARGET:LOCALS = CALCF(SOURCE:TARGET:LOCALS, RESULT)
	SOURCE:PLAYER:LOCALS = CALCF(SOURCE:PLAYER:LOCALS, RESULT:1)
	CALL GET_SOURCE_POWER, LOCALS, PLAYER, TARGET
	SOURCE:PLAYER:LOCALS = CALCF(SOURCE:PLAYER:LOCALS, RESULT)
	SOURCE:TARGET:LOCALS = CALCF(SOURCE:TARGET:LOCALS, RESULT:1)
NEXT
FOR LOCAL, 0, 2
	CHARA = LOCAL ? PLAYER # TARGET
	CHARA:1 = LOCAL ? TARGET # PLAYER
	DOWNBASE:CHARA:体力 -= TRAIN_STATE_POWER_体力継続回復(CHARA, CHARA:1)
	DOWNBASE:CHARA:気力 -= TRAIN_STATE_POWER_気力継続回復(CHARA, CHARA:1)
	DOWNBASE:CHARA:体力 += TRAIN_STATE_POWER_体力継続消費(CHARA, CHARA:1)
	DOWNBASE:CHARA:気力 += TRAIN_STATE_POWER_気力継続消費(CHARA, CHARA:1)
NEXT
