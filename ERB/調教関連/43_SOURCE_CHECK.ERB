@SOURCE_CHECK
#LOCALSIZE 5
#DIM CHARA, 2
#DIM PCOUNT, 2
#DIM 絶頂数 , 1
FOR PCOUNT, 0, 2
	IF PCOUNT == 0
		CHARA = TARGET
		CHARA:1 = PLAYER
	ELSE
		CHARA = PLAYER
		CHARA:1 = TARGET
	ENDIF
	;-------------------------------------------------
	;液体のソース
	;-------------------------------------------------
	LOCAL = SOURCE:CHARA:液体
	DOWNBASE:CHARA:潤滑 -= SOURCE:CHARA:液体

	;-------------------------------------------------
	;悦楽のソース
	;-------------------------------------------------
	LOCAL = SOURCE:CHARA:悦楽
	;欲望を見る
	SELECTCASE GET_ABL("欲望", CHARA)
		CASE 0
			TIMES LOCAL , 0.60
		CASE 1
			TIMES LOCAL , 0.90
		CASE 2
			TIMES LOCAL , 1.35
		CASE 3
			TIMES LOCAL , 1.50
		CASE 4
			TIMES LOCAL , 1.75
		CASE 5
			TIMES LOCAL , 2.00
		CASE 6
			TIMES LOCAL , 2.20
		CASE 7
			TIMES LOCAL , 2.40
		CASE 8
			TIMES LOCAL , 2.60
		CASE 9
			TIMES LOCAL , 2.80
		CASEELSE
			TIMES LOCAL , 3.00
	ENDSELECT
	CUP:CHARA:悦楽 += LOCAL

	;-------------------------------------------------
	;痛みのソース
	;マゾっ気があるとPALAM:悦楽も上がり、欲情も追加される
	;そのとき調教者が【サド】だと効果的
	;-------------------------------------------------
	LOCAL = SOURCE:CHARA:痛み
	LOCAL:1 = SOURCE:CHARA:痛み

	;マゾっ気
	SELECTCASE GET_ABL("マゾっ気", CHARA)
		CASE 0
			TIMES LOCAL:1 , 0.00
		CASE 1
			TIMES LOCAL:1 , 0.10
		CASE 2
			TIMES LOCAL:1 , 0.20
		CASE 3
			TIMES LOCAL:1 , 0.30
		CASE 4
			TIMES LOCAL:1 , 0.45
		CASE 5
			TIMES LOCAL:1 , 0.60
		CASE 6
			TIMES LOCAL:1 , 0.75
		CASE 7
			TIMES LOCAL:1 , 0.90
		CASE 8
			TIMES LOCAL:1 , 1.20
		CASE 9
			TIMES LOCAL:1 , 1.50
		CASEELSE
			TIMES LOCAL:1 , 3.00
	ENDSELECT

	CUP:CHARA:苦痛 += LOCAL
	CUP:CHARA:屈服 += LOCAL:1/2
	CUP:CHARA:悦楽 += LOCAL:1
	CUP:CHARA:恭順 += LOCAL:1 / 2
	DOWNBASE:CHARA:欲情 -= LOCAL:1 / 10
