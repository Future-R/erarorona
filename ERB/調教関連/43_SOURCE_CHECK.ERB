		CASE 8
			TIMES LOCAL:2 , 3.80
		CASE 9
			TIMES LOCAL:2 , 4.40
		CASEELSE
			TIMES LOCAL:2 , 5.00
	ENDSELECT
	FOR LOCAL:3, 0, TCVAR:CHARA:情愛加算回数
		TIMES LOCAL:2, 0.80
	NEXT
	CUP:CHARA:恭順 += LOCAL
	CUP:CHARA:悦楽 += LOCAL:1
	DOWNBASE:CHARA:欲情 -= LOCAL:2
	SIF LOCAL:2 > 0
		TCVAR:CHARA:情愛加算回数++
