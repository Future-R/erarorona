	;体力消耗降低
	;-------------------------------------------------
	SIF DOWNBASE:CHARA:体力 > 0
		DOWNBASE:CHARA:体力 = TIMESF(DOWNBASE:CHARA:体力, 100 - TCVAR:CHARA:体力消耗降低)

	;-------------------------------------------------
	;苦痛变换吸收
	;-------------------------------------------------
	DOWNBASE:CHARA:气力 -= TIMESF(MIN(CUP:CHARA:苦痛, 1000) / 10, TRAIN_SKILL_POWER_苦痛变换吸收(CHARA))
	DOWNBASE:CHARA:气力 -= TIMESF(MAX(CUP:CHARA:苦痛 - 1000, 0) / 50, TRAIN_SKILL_POWER_苦痛变换吸收(CHARA))

	
	;-------------------------------------------------
	;素質の影響を受けさせないためにここで処理する
	;-------------------------------------------------
	CUP:CHARA:不快 -= TCVAR:CHARA:神秘的灵药
	CUP:CHARA:反感 -= TCVAR:CHARA:神秘的灵药
	CUP:CHARA:抑郁 -= TCVAR:CHARA:神秘的灵药
	;-------------------------------------------------
	;气力０による上下の処理
	;-------------------------------------------------
	IF (!BASE:CHARA:气力 || BASE:CHARA:气力 < DOWNBASE:CHARA:气力)
		;PRINTL ★气力０★
		;CUP:CHARA:快Ｃ,1,2は絶頂に絡むので先に処理してある
		IF !TRAIN_STATE_POWER_疲劳感麻痹(CHARA)
			CUP:CHARA:恭顺 /= 2 + TRAIN_STATE_POWER_疲劳感增加(CHARA)
			CUP:CHARA:愉悦 /= 2 + TRAIN_STATE_POWER_疲劳感增加(CHARA)
			CUP:CHARA:屈服 /= 2 + TRAIN_STATE_POWER_疲劳感增加(CHARA)
			CUP:CHARA:耻情 /= 2 + TRAIN_STATE_POWER_疲劳感增加(CHARA)
			CUP:CHARA:恐怖 /= 2 + TRAIN_STATE_POWER_疲劳感增加(CHARA)
			CUP:CHARA:抑郁 /= 2 + TRAIN_STATE_POWER_疲劳感增加(CHARA)
		ENDIF
		DOWNBASE:CHARA:体力 *= 2
		DOWNBASE:CHARA:体力 += 50 + DOWNBASE:CHARA:气力
	ELSE
		IF TRAIN_SKILL_POWER_幽灵之躯(CHARA)
			DOWNBASE:CHARA:气力 += DOWNBASE:CHARA:体力
			DOWNBASE:CHARA:体力 = 0
		ENDIF
	ENDIF
NEXT


