		CASE 8
			TIMES LOCAL:1 , 3.20
		CASE 9
			TIMES LOCAL:1 , 3.60
		CASEELSE
			TIMES LOCAL:1 , 4.00
	ENDSELECT
	
	;服从と欲望を見る
	LOCAL:2 = SOURCE:CHARA:情爱
	SELECTCASE (GET_ABL("服从", CHARA) * 2 + GET_ABL("欲望", CHARA)) / 3
		CASE 0
			TIMES LOCAL:2 , 0.00
		CASE 1
			TIMES LOCAL:2 , 0.40
		CASE 2
			TIMES LOCAL:2 , 0.80
		CASE 3
			TIMES LOCAL:2 , 1.20
		CASE 4
