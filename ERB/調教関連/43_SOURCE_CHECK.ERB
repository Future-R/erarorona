	LOCAL = SOURCE:CHARA:愉悦
	;欲望を見る
	SELECTCASE GET_ABL("欲望", CHARA)
		CASE 0
			TIMES LOCAL , 0.60
		CASE 1
			TIMES LOCAL , 0.90
		CASE 2
			TIMES LOCAL , 1.35
		CASE 3
			TIMES LOCAL , 1.50
		CASE 4
			TIMES LOCAL , 1.75
		CASE 5
			TIMES LOCAL , 2.00
		CASE 6
			TIMES LOCAL , 2.20
		CASE 7
			TIMES LOCAL , 2.40
		CASE 8
			TIMES LOCAL , 2.60
		CASE 9
			TIMES LOCAL , 2.80
		CASEELSE
			TIMES LOCAL , 3.00
	ENDSELECT
	CUP:CHARA:愉悦 += LOCAL

	;-------------------------------------------------
