	ENDSELECT
	FOR LOCAL:3, 0, TCVAR:CHARA:情爱加算次数
		TIMES LOCAL:2, 0.80
	NEXT
	CUP:CHARA:恭顺 += LOCAL
	CUP:CHARA:愉悦 += LOCAL:1
	DOWNBASE:CHARA:欲情 -= LOCAL:2
	SIF LOCAL:2 > 0
		TCVAR:CHARA:情爱加算次数++
