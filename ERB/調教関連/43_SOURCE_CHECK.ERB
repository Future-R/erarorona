	FOR LOCAL, 0, VARSIZE("PALAM")
		SIF GROUPMATCH(PALAMNAME:LOCAL, "", "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ")
			CONTINUE
		CALL GET_CUP_POWER, PALAMNAME:LOCAL, CHARA, (CHARA:1)
