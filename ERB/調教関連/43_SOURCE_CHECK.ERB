@SOURCE_CHECK
#LOCALSIZE 5
#DIM CHARA, 2
#DIM PCOUNT, 2
#DIM 高潮数 , 1
FOR PCOUNT, 0, 2
	IF PCOUNT == 0
		CHARA = TARGET
		CHARA:1 = PLAYER
	ELSE
		CHARA = PLAYER
		CHARA:1 = TARGET
	ENDIF
