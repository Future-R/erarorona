	;-------------------------------------------------
	;体力消費軽減
	;-------------------------------------------------
	SIF DOWNBASE:CHARA:体力 > 0
		DOWNBASE:CHARA:体力 = TIMESF(DOWNBASE:CHARA:体力, 100 - TCVAR:CHARA:体力消費軽減)

	;-------------------------------------------------
	;苦痛変換吸収
	;-------------------------------------------------
	DOWNBASE:CHARA:気力 -= TIMESF(MIN(CUP:CHARA:苦痛, 1000) / 10, TRAIN_SKILL_POWER_苦痛変換吸収(CHARA))
	DOWNBASE:CHARA:気力 -= TIMESF(MAX(CUP:CHARA:苦痛 - 1000, 0) / 50, TRAIN_SKILL_POWER_苦痛変換吸収(CHARA))

	
	;-------------------------------------------------
	;素質の影響を受けさせないためにここで処理する
	;-------------------------------------------------
	CUP:CHARA:不快 -= TCVAR:CHARA:神秘の霊薬
	CUP:CHARA:反感 -= TCVAR:CHARA:神秘の霊薬
	CUP:CHARA:抑鬱 -= TCVAR:CHARA:神秘の霊薬
	;-------------------------------------------------
	;気力０による上下の処理
	;-------------------------------------------------
	IF (!BASE:CHARA:気力 || BASE:CHARA:気力 < DOWNBASE:CHARA:気力)
		;PRINTL ★気力０★
		;CUP:CHARA:快Ｃ,1,2は絶頂に絡むので先に処理してある
		IF !TRAIN_STATE_POWER_疲労感麻痺(CHARA)
			CUP:CHARA:恭順 /= 2 + TRAIN_STATE_POWER_疲労感増加(CHARA)
			CUP:CHARA:悦楽 /= 2 + TRAIN_STATE_POWER_疲労感増加(CHARA)
			CUP:CHARA:屈服 /= 2 + TRAIN_STATE_POWER_疲労感増加(CHARA)
			CUP:CHARA:恥情 /= 2 + TRAIN_STATE_POWER_疲労感増加(CHARA)
			CUP:CHARA:恐怖 /= 2 + TRAIN_STATE_POWER_疲労感増加(CHARA)
			CUP:CHARA:抑鬱 /= 2 + TRAIN_STATE_POWER_疲労感増加(CHARA)
		ENDIF
		DOWNBASE:CHARA:体力 *= 2
		DOWNBASE:CHARA:体力 += 50 + DOWNBASE:CHARA:気力
	ELSE
		IF TRAIN_SKILL_POWER_幽霊のからだ(CHARA)
			DOWNBASE:CHARA:気力 += DOWNBASE:CHARA:体力
			DOWNBASE:CHARA:体力 = 0
		ENDIF
	ENDIF
NEXT


