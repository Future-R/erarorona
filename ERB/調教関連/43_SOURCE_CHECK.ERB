		CASE 5
			TIMES LOCAL:1 , 0.60
		CASE 6
			TIMES LOCAL:1 , 0.75
		CASE 7
			TIMES LOCAL:1 , 0.90
		CASE 8
			TIMES LOCAL:1 , 1.20
		CASE 9
			TIMES LOCAL:1 , 1.50
		CASEELSE
			TIMES LOCAL:1 , 3.00
	ENDSELECT

	CUP:CHARA:苦痛 += LOCAL
	CUP:CHARA:屈服 += LOCAL:1/2
	CUP:CHARA:愉悦 += LOCAL:1
	CUP:CHARA:恭顺 += LOCAL:1 / 2
	DOWNBASE:CHARA:欲情 -= LOCAL:1 / 10
