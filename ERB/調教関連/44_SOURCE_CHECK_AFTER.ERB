;-------------------------------------------------
;苦痛快乐经验、侍奉快乐经验のチェック
;-------------------------------------------------
@EXP_GOT_CHECK, ARG, ARG:1
#LOCALSIZE 4
#DIM PRESURE
#DIM PLAY_RESULT
;奉仕系である、奉仕快楽のチェック
;   1      2      3       4      5       6
; 200 / 1600 / 5400 / 12800/ 25000 / 43200
PRESURE = 0
WHILE CUP:ARG:快Ｃ + CUP:ARG:快Ｖ + CUP:ARG:快Ａ + CUP:ARG:快Ｂ >= (PRESURE + 1) * (PRESURE + 1) * (PRESURE + 1) * 200
	PRESURE++
WEND
PRESURE = MIN(PRESURE, 6)
RESULTS = 
TRYCALLFORM COM_PROPERTY_{SELECTCOM}
IF STRCOUNT(RESULTS, "奉献")
	PLAY_RESULT = 0
	WHILE (PLAY_RESULT + 1) * (PLAY_RESULT + 1) * 1000 <= GET_NATURE_PREASURE_CUP("快Ｃ", ARG:1) + GET_NATURE_PREASURE_CUP("快Ｖ", ARG:1) + GET_NATURE_PREASURE_CUP("快Ａ", ARG:1) + GET_NATURE_PREASURE_CUP("快Ｂ", ARG:1)
		PLAY_RESULT++
	WEND
	PLAY_RESULT = LIMIT(PLAY_RESULT, 0, 6)
	;奉仕系は
	;欲情と与快感で反感が低下する
	CUP:ARG:反感 = CUP:ARG:反感 * (100 - (PRESURE * PLAY_RESULT) * 2) / 100
	;侍奉快乐经验は欲情と与快感で決定される(1~6 * 1~6)
	CALL ADD_EXP("侍奉快乐经验", PRESURE * PLAY_RESULT, ARG)
ENDIF

;---------------------------
;苦痛快乐经验・施虐经验
;Chain中の快楽が多いほど加算量が増える
;施虐经验の方は1点が保証される
;---------------------------
PLAY_RESULT = 0
WHILE CUP:ARG:苦痛 * 2 + TCVAR:ARG:连锁中获得苦痛 > (PLAY_RESULT + 1) * (PLAY_RESULT + 1) * 200
	PLAY_RESULT++
WEND
PLAY_RESULT = MIN(PLAY_RESULT, 6)
;苦痛快乐经验は欲情と苦痛で決定される(0~6 * 0~6)
CALL ADD_EXP("苦痛快乐经验", PRESURE * PLAY_RESULT, ARG)
CALL ADD_EXP("施虐经验", PRESURE * PLAY_RESULT + CUP:ARG:苦痛 > 0, ARG:1)
TRYCALLFORM COM_PROPERTY_{SELECTCOM}
IF STRCOUNT(RESULTS, "施虐")
	;施虐系の反感は獲得した快感によって軽減される
	CUP:ARG:反感 = CUP:ARG:反感 * (100 - PRESURE * PRESURE * 2) / 100
ENDIF

;-------------------------------------------------
;絶頂表示
;-------------------------------------------------
@SHOW_EX, ARG
#LOCALSSIZE 2
#LOCALSIZE 2
LOCAL:1 = 0
LOCALS:1 = 
FOR LOCAL, 0, 4
	LOCALS = %AUTO_SPLIT("Ｃ/Ｖ/Ａ/Ｂ", "/", LOCAL)%
	SIF !NOWEX:ARG:(LOCALS + "高潮")
		CONTINUE
	SIF LOCAL:1
		LOCALS:1 += "_"
	LOCALS:1 +=  @"%AUTO_SPLIT("/高潮/强高潮", "/", NOWEX:ARG:(LOCALS + "高潮"))% %LOCALS%"
	LOCAL:1++
NEXT
IF LOCAL:1 > 0
	SIF LOCAL:1 > 1
		LOCALS:1 += @"_%AUTO_SPLIT("/二重/三重/四重", "/", LOCAL:1 - 1)%高潮(各部位分别获得{POWER(2, LOCAL:1-1)}倍宝珠)"
	CALL TRAINTEXT, LOCALS:1
ENDIF
;-------------------------------------------------
;刻印取得のチェック
;-------------------------------------------------
@MARK_GOT_CHECK, ARG
#LOCALSIZE 2
#LOCALSSIZE 1
;-------------------------------------------------
;苦痛烙印
;-------------------------------------------------
SELECTCASE CUP:ARG:苦痛
	CASE IS >= 8000
		TCVAR:ARG:获得苦痛烙印 = 3
	CASE IS >= 4000
		TCVAR:ARG:获得苦痛烙印 = 2
	CASE IS >= 2000
		TCVAR:ARG:获得苦痛烙印 = 1
	CASEELSE
		TCVAR:ARG:获得苦痛烙印 = 0
ENDSELECT
SIF MARK:ARG:苦痛烙印 >= TCVAR:ARG:获得苦痛烙印
	TCVAR:ARG:获得苦痛烙印 = 0


;-------------------------------------------------
;快乐烙印の判定
;強度は絶頂強度を利用、ただしVAは2倍扱い
;強度2 Lv1 強度3 Lv2 強度4 Lv3
;-------------------------------------------------
LOCAL = LIMIT(NOWEX:Ｃ高潮 + NOWEX:Ｖ高潮 * 2 + NOWEX:Ａ高潮 * 2 + NOWEX:Ｂ高潮 - 1, 0 ,3)
SIF LOCAL > MARK:ARG:快乐烙印
	TCVAR:ARG:获得快乐烙印 = LOCAL

;---------------------------------------------------
;欲望の上昇判定
;---------------------------------------------------
LOCAL = GROUPMATCH(1, NOWEX:Ｃ高潮 >= 2, NOWEX:Ｖ高潮 >= 1, NOWEX:Ａ高潮 >= 1, NOWEX:Ｂ高潮 >= 2) - GET_TALENT("自制的", ARG)
SIF MIN(LOCAL, GET_MAX_ABL("欲望", ARG)) > GET_NATURE_ABL("欲望", ARG)
	TCVAR:ARG:欲望上升 = MIN(LOCAL, GET_MAX_ABL("欲望", ARG))


;-------------------------------------------------
;屈服烙印
;-------------------------------------------------
FOR LOCAL, 1, 4
	SELECTCASE LOCAL
		CASE 1
			LOCAL:1 = CUP:ARG:快Ｃ + CUP:ARG:快Ｖ + CUP:ARG:快Ｂ + CUP:ARG:快Ａ / 2
		CASE 2
			LOCAL:1 = CUP:ARG:苦痛 + CUP:ARG:恐怖
		CASE 3
			LOCAL:1 = CUP:ARG:恭顺 + CUP:ARG:屈服
	ENDSELECT
	SELECTCASE LOCAL:1
		CASE IS >= 5000
			TCVAR:ARG:获得屈服烙印 = 3
		CASE IS >= 3000
			TCVAR:ARG:获得屈服烙印 = 2
		CASE IS >= 1500
			TCVAR:ARG:获得屈服烙印 = 1
		CASEELSE
			TCVAR:ARG:获得屈服烙印 = 0
	ENDSELECT
	SIF MARK:ARG:屈服烙印 >= TCVAR:ARG:获得屈服烙印
		TCVAR:ARG:获得屈服烙印 = 0
	;1等级づつしかあがらない
	TCVAR:ARG:获得屈服烙印 = MIN(MARK:ARG:屈服烙印 +1, TCVAR:ARG:获得屈服烙印)
	IF TCVAR:ARG:获得屈服烙印
		TCVAR:ARG:屈服烙印获得手段 = LOCAL
		BREAK
	ENDIF
NEXT

;-------------------------------------------------
;抗拒烙印
;-------------------------------------------------
SELECTCASE 反感等级(ARG)
	CASE 5
		TCVAR:ARG:获得抗拒烙印 = 3
	CASE 4
		TCVAR:ARG:获得抗拒烙印 = 2
	CASE 3
		TCVAR:ARG:获得抗拒烙印 = 1
	CASEELSE
		TCVAR:ARG:获得抗拒烙印 = 0
ENDSELECT
SIF MARK:ARG:抗拒烙印 >= TCVAR:ARG:获得抗拒烙印
	TCVAR:ARG:获得抗拒烙印 = 0

FOR LOCAL, 0, 5
	LOCALS = \@LOCAL < 4 ? 获得%AUTO_SPLIT("苦痛/快乐/屈服/抗拒", "/", LOCAL)%烙印 # 屈服烙印获得手段\@
	TCVAR:ARG:("调教中" + LOCALS) = MAX(TCVAR:ARG:("调教中" + LOCALS), TCVAR:ARG:LOCALS)
NEXT
;-------------------------------------------------
;刻印取得の処理
;-------------------------------------------------
@MARK_GOT_RESULT, ARG, ARG:1
#LOCALSSIZE 2
#LOCALSIZE 3
LOCAL:2 = GETCOLOR()
FOR LOCAL, 0, 4
	LOCALS = %AUTO_SPLIT("快乐烙印/苦痛烙印/屈服烙印/抗拒烙印", "/", LOCAL)%
	SIF !TCVAR:ARG:("获得" + LOCALS)
		CONTINUE
	LOCALS:1 '= ADD_FTAG(@"%CALLNAME:ARG%は%LOCALS%LV{TCVAR:ARG:("获得" + LOCALS)}を得た", COLOR("RED"))
	MARK:ARG:LOCALS = TCVAR:ARG:("获得" + LOCALS)
	SELECTCASE LOCALS
		CASE "苦痛烙印"
			IF TCVAR:ARG:("获得" + LOCALS) >= 2 && !GET_NATURE_ABL("服从", ARG)
				LOCALS:1 +="_" + ADD_FTAG("そして服从がLV1になった", COLOR("RED"))
				ABL:ARG:服从 = 1
			ENDIF
			IF TCVAR:ARG:("获得" + LOCALS) == 3
				;IF GET_TALENT("サド", ARG:1)
				;	CALL ADDS_ABNORMAL_EXP("苦痛烙印LV3（サド）", ARG)
				;ELSEIF TALENT:PLAYER:53 && SELECTCOM == 104
				;	CALL ADDS_ABNORMAL_EXP("苦痛烙印LV3（針さばき）", TARGET)
				;ELSE
				;	CALL ADDS_ABNORMAL_EXP("苦痛烙印LV3", ARG)
				;ENDIF
			ENDIF
		CASE "苦痛烙印"
			IF TCVAR:ARG:("获得" + LOCALS) == 3 && GET_NATURE_ABL("服从", ARG) < 2
				LOCALS:1 += "_" + ADD_FTAG("そして服从がLV2になった", COLOR("RED"))
				ABL:ARG:服从 = 2
			ENDIF
			IF TCVAR:ARG:("获得" + LOCALS) == 2 && GET_NATURE_ABL("服从", ARG) < 1
				LOCALS:1 += "_"+ ADD_FTAG("そして服从がLV1になった", COLOR("RED"))
				ABL:ARG:服从 = 1
			ENDIF
		CASE "抗拒烙印"
			LOCAL:1 = LIMIT(TCVAR:ARG:("获得" + LOCALS) - GET_TALENT("无情", ARG), 0, GET_NATURE_ABL("服从", ARG))
			IF LOCAL:1
				LOCALS:1 += "_" + ADD_FTAG(@"そして服从がLV{GET_NATURE_ABL("服从", ARG) - LOCAL:1}に下がった", COLOR("RED"))
				ABL:ARG:服从 -= LOCAL:1
			ENDIF
	ENDSELECT
	CALL TRAINTEXT, LOCALS:1, "SET", , "FORCEWAIT"
NEXT
SETCOLOR LOCAL:2

@BREAK_CHAIN
#LOCALSIZE 1
TSTR:连锁判定 = 
