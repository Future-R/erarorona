@TURN_END
;-------------------------------------------------
;連鎖中の獲得PALAMの加算
;-------------------------------------------------
FOR LOCAL, 0, 3
	SIF TRAINCHARA(LOCAL) >= 0
		TCVAR:TRAINCHARA(LOCAL):连锁中获得苦痛 += CUP:TRAINCHARA(LOCAL):苦痛
NEXT
;----------------------------------------------------
;アイテム数減少処理
;----------------------------------------------------
IF IS_TRAINITEM(SELECTCOM) && !FR_SKILL_USE:GET_NO("友人技能", "复制")
	CALL SET_ITEMDATA(TFLAG:使用物品登录编号, "使用次数", GET_ITEMDATA(TFLAG:使用物品登录编号, "使用次数") - 1)
	IF GET_ITEMDATA(TFLAG:使用物品登录编号, "使用次数") <= 0
		ITEMCHOICE:(TFLAG:使用物品登录编号) = 1
		CALL DEL_CHOICE_ITEM, "调教"
	ENDIF
ENDIF

;----------------------------------------------------
;スキル持続時間などの処理
;----------------------------------------------------
FOR LOCAL, 0, 友人技能数
	FR_SKILL_USE:LOCAL = MAX(0, FR_SKILL_USE:LOCAL - 1)
NEXT

FOR LOCAL:1, 0, 3
	SIF TRAINCHARA(LOCAL:1) < 0
		CONTINUE
	FOR LOCAL, 1300, 1400
		TCVAR:TRAINCHARA(LOCAL:1):LOCAL = MAX(TCVAR:TRAINCHARA(LOCAL:1):LOCAL - 1, 0)
		SIF !TCVAR:TRAINCHARA(LOCAL:1):LOCAL
			TCVAR:TRAINCHARA(LOCAL:1):(LOCAL - 100) = 0
	NEXT
NEXT

;----------------------------------------------------
;次ターン開始時の表示の登録
;----------------------------------------------------
CALLF GET_TRAINRECORD_C, "SET", , TFLAG:当前回合 + 1
CALL SET_TRAIN_CONDITION, TFLAG:当前回合 + 1

;ターンごとのコマンドを記載
PREVCOM:(TFLAG:当前回合) = SELECTCOM
;SELECTCOMをずらす
ARRAYSHIFT SELECTCOM, 1, -1

IF BASE:TARGET:体力 == 0
	PRINTFORMW %CALLNAME:TARGET%の体力は限界です。
	PRINTFORMW 结束调教。
	RETURN -1
ELSEIF BASE:MASTER:体力 == 0
	PRINTFORMW %CALLNAME:MASTER%の体力は限界です。
	PRINTFORMW 结束调教。
	RETURN -1
ENDIF

IF TFLAG:剩余时间 == 0
	PRINTFORMW 調教時間が終了しました。
	RETURN -1
ENDIF