@SHOW_RESULT_HEADER
#LOCALSIZE 1
CLEARLINE LINECOUNT - TFLAG:菜单显示线
PRINTL 调　教　结　果
DRAWLINE
FOR LOCAL, 0, MAXLINE() - (TFLAG:菜单显示线 - TFLAG:显示开始线) - 8
	CALL WINDOWPRINTBUTTON, " " * 120
	PRINTL 
NEXT
@SHOW_RESULT
#LOCALSIZE 4
#DIM LINE
#DIM CHARA
CALL SHOW_TRAIN_STATUS
CALL SHOW_RESULT_HEADER
LINE = LINECOUNT
CALL MESSAGE_WINDOW, "", "调教结束了/显示调教结果"
CALL SHOW_TRAIN_STATUS, , -2
FOR LOCAL:2, 0, 2
	CHARA = LOCAL:2 ? MASTER # TARGET
	PRINTFORML 高潮(%CALLNAME:CHARA%)
	PRINT 　　　次数
	FOR LOCAL, 0, 4
		PRINTFORM 　%AUTO_SPLIT("Ｃ/Ｖ/Ａ/Ｂ", "/", LOCAL)%:{EX:CHARA:AUTO_SPLIT("Ｃ高潮/Ｖ高潮/Ａ高潮/Ｂ高潮", "/", LOCAL), 3}回　　
	NEXT
	PRINTL 
	PRINT 　　　强度
	FOR LOCAL, 0, 4
		PRINTFORM 　%AUTO_SPLIT("Ｃ/Ｖ/Ａ/Ｂ", "/", LOCAL)%:{EX:CHARA:AUTO_SPLIT("Ｃ高潮强度/Ｖ高潮强度/Ａ高潮强度/Ｂ高潮强度", "/", LOCAL),3}回相当
	NEXT
	PRINTL 
	DRAWLINE
NEXT
FOR LOCAL:2, 0, 2
	CHARA = LOCAL:2 ? MASTER # TARGET
	PRINTFORML 获得经验(%CALLNAME:CHARA%)
	LOCAL:1 = 0
	FOR LOCAL, 0, 100
		SIF EXPNAME:LOCAL == ""
			CONTINUE
		SIF !GET_ADD_SUMEXP(LOCAL, CHARA)
			SETCOLOR COLOR("gray")
		SIF LOCAL:1 % 5 == 0
			PRINT 　　　
		PRINTFORM %EXPNAME:LOCAL, 12,LEFT%　+{GET_ADD_SUMEXP(LOCAL, CHARA), 5} 　
		RESETCOLOR
		SIF LOCAL:1++ % 5 == 4
			PRINTL 
	NEXT
	SIF !LINEISEMPTY()
		PRINTL 
NEXT
DRAWLINE
PRINTFORML 获得宝珠(%CALLNAME:TARGET%)

LOCAL:1 = 0
FOR LOCAL, 0, VARSIZE("PALAM")
	SIF PALAMNAME:LOCAL == ""
		CONTINUE
	LOCAL:3 = 0
	SELECTCASE GETPALAMLV(PALAM:TARGET:LOCAL, 20)
		CASE 0
			LOCAL:3 = 0
		CASE 1
			LOCAL:3 = 1
		CASE 2
			LOCAL:3 = 2
		CASE 3
			LOCAL:3 = 10
		CASE 4
			LOCAL:3 = 20
		CASE 5
			LOCAL:3 = 100
		CASE 6
			LOCAL:3 = 200
		CASE 7
			LOCAL:3 = 1000
		CASE 8
			LOCAL:3 = 2000
		CASE 9
			LOCAL:3 = 3000
		CASE 10
			LOCAL:3 = 5000
		CASE 11
			LOCAL:3 = 8000
		CASE 12
			LOCAL:3 = 12000
		CASE 13
			LOCAL:3 = 16000
		CASE 14
			LOCAL:3 = 20000
		CASE 15
			LOCAL:3 = 25000
		CASE 16
			LOCAL:3 = 30000
		CASE 17
			LOCAL:3 = 36000
		CASE 18
			LOCAL:3 = 42000
		CASEELSE
			LOCAL:3 = 50000
	ENDSELECT
	;否定の珠の回収
	IF GROUPMATCH(PALAMNAME:LOCAL, "反感", "不快", "抑郁")
		SIF GET_ITEMNAME_E(GET_NO_QEQUIP("护身符"), 0) == "开发力提升"
			LOCAL:3 = TIMESF(LOCAL:3, 75)
		GOTJUEL:TARGET:否定 += LOCAL:3
		CONTINUE
	ELSE
		SIF GROUPMATCH(PALAMNAME:LOCAL, "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ")
			LOCAL:3 += EX:TARGET:(LOCAL + 10) * 1000
		SIF GET_ITEMNAME_E(GET_NO_QEQUIP("护身符"), 0) == "开发力提升"
			LOCAL:3 = TIMESF(LOCAL:3, 150)
	ENDIF
	GOTJUEL:TARGET:LOCAL += LOCAL:3
	SIF !GOTJUEL:TARGET:LOCAL
		SETCOLOR COLOR("gray")
	SIF LOCAL:1 % 4 == 0
		PRINT 　　　
	PRINTFORM %PALAMNAME:LOCAL + "宝珠", 8,LEFT%　+{GOTJUEL:TARGET:LOCAL, 14}　  
	RESETCOLOR
	SIF LOCAL:1++ % 4 == 3
		PRINTL 
NEXT
SIF !LINEISEMPTY()
	PRINTL 
DRAWLINE
CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE()
WAITANYKEY
CALL SHOW_GET_JUEL
@SHOW_GET_JUEL
#DIM LINE
#DIM 帧数
#DIM PREV_JUEL, 101
#DIM NEXT_JUEL, 101
#DIM LOSTJUEL, 101
帧数 = LIMIT(MAXARRAY(GOTJUEL:TARGET:0), 1, 30)
CALL SHOW_TRAIN_STATUS, , -2
PRINTL 获得宝珠
DRAWLINE
FOR LOCAL, 0, 101
	PREV_JUEL:LOCAL = JUEL:TARGET:LOCAL
	NEXT_JUEL:LOCAL = MIN(JUEL:TARGET:LOCAL + GOTJUEL:TARGET:LOCAL, 9999999999)
	JUEL:TARGET:LOCAL = NEXT_JUEL:LOCAL
NEXT
REDRAW 0
LINE = LINECOUNT
FOR LOCAL:1, 0, 帧数 + 1
	SIF MESSKIP()
		LOCAL = 帧数
	CLEARLINE LINECOUNT - LINE
	FOR LOCAL, 0, VARSIZE("JUEL")
		SIF PALAMNAME:LOCAL == ""
			CONTINUE
		SIF GROUPMATCH(PALAMNAME:LOCAL, "反感", "不快", "抑郁")
			CONTINUE
		PRINTFORML %PALAMNAME:LOCAL + "宝珠", 8,LEFT%　{(PREV_JUEL:LOCAL * (帧数 - LOCAL:1) + NEXT_JUEL:LOCAL * LOCAL:1) / 帧数 , 16}(+{GOTJUEL:TARGET:LOCAL * LOCAL:1 / 帧数,15})
	NEXT
	CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE() - 6
	CALL MESSAGE_WINDOW, "", "获得的宝珠已加到持有的宝珠上", , "没有动画/不再等待/不留日志/无需点击"
	TWAIT 100, 0
NEXT
REDRAW 1
WAITANYKEY
;否定の珠の計算
VARSET LOSTJUEL
LOCAL = 0
WHILE NEXT_JUEL:100 && MAXARRAY(NEXT_JUEL, 4, 80)
	;最も数が多いJUELを選定
	LOCAL = FINDELEMENT(NEXT_JUEL, MAXARRAY(NEXT_JUEL, 4, 80), 4, 80)
	;マイナス量を計算
	LOCAL:1 = MIN(NEXT_JUEL:LOCAL, NEXT_JUEL:100 / 2 + NEXT_JUEL:100 % 2)
	LOSTJUEL:LOCAL += LOCAL:1
	NEXT_JUEL:LOCAL -= LOCAL:1
	;否定の珠も当然だけど減る
	NEXT_JUEL:100 -= LOCAL:1
	LOSTJUEL:100 += LOCAL:1
WEND
;WHILEに入らなかった場合は抜ける
SIF !MAXARRAY(LOSTJUEL)
	RETURN 0
FOR LOCAL, 0, 101
	PREV_JUEL:LOCAL = JUEL:TARGET:LOCAL
	LOSTJUEL:LOCAL = GOTJUEL:TARGET:LOCAL - LOSTJUEL:LOCAL
	JUEL:TARGET:LOCAL = NEXT_JUEL:LOCAL
NEXT
REDRAW 0
FOR LOCAL:1, 0, 帧数 + 1
	SIF MESSKIP()
		LOCAL = 帧数
	CLEARLINE LINECOUNT - LINE
	FOR LOCAL, 0, VARSIZE("JUEL")
		SIF PALAMNAME:LOCAL == ""
			CONTINUE
		SIF GROUPMATCH(PALAMNAME:LOCAL, "反感", "不快", "抑郁")
			CONTINUE
		PRINTFORM %PALAMNAME:LOCAL + "宝珠", 8,LEFT%　{(PREV_JUEL:LOCAL * (帧数 - LOCAL:1) + NEXT_JUEL:LOCAL * LOCAL:1) / 帧数 , 16}
		PRINTFORML (+{(GOTJUEL:TARGET:LOCAL * (帧数 - LOCAL:1) + LOSTJUEL:LOCAL * LOCAL:1) / 帧数,15})
	NEXT
	CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE() - 6
	CALL MESSAGE_WINDOW, "", "否定宝珠正在抵消其他宝珠", , "没有动画/不再等待/不留日志/无需点击"
	TWAIT 100, 0
NEXT
REDRAW 1
WAITANYKEY
