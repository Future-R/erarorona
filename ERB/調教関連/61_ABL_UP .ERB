@ABL_UP, CHARA = -1
#LOCALSIZE 5
#LOCALSSIZE 1
#DIM CHARA
#DIM UPABLE, 100, 4
#DIM NEED_JUEL, 100, 4, 100
#DIM NEED_EXP, 100, 4, 100
#DIM NEED_ABL, 100, 4, 100
#DIM NEED_MARK, 100, 4, 100
#DIM 行内条件未达成数量, 6
#DIM NUM, 4
#DIM CHOICE
#DIM TEMP, 2
#DIMS TEMPS
#DIM TEMP_NEED
#DIM L_RESULT, 5
#DIM LINE, 2
#DIMS EXPS
#DIMS ABLS
#DIMS JUELS

#DIM L_COLOR
#DIMS L_BUTTON

#DIM LAYER_Y
#DIM LAYER_X
$START
VARSET NEED_JUEL
VARSET NEED_EXP
VARSET NEED_ABL
VARSET NEED_MARK
;------------------------------------------------------------------
; 条件判断
; 一开始先设定成可以全部执行的状态，然后再判断赋值
; 1:可升级 0:不可升级 -1:无条件或等级达到上限
;-----------------------------------------------------------------

FOR	LOCAL:2, 0, 100
	
	SIF ABLNAME:(LOCAL:2) == ""
		CONTINUE

	; 虚设一个消除抗拒的能力
	ABL:CHARA:消除抗拒 = MAX(3 - MARK:CHARA:抗拒烙印,0)
	ABL:CHARA:消除抗拒上限 = 3

	FOR LOCAL, 0, 4
		UPABLE:(LOCAL:2):LOCAL = 1
	NEXT

	; 检查是否满级
	IF GET_NATURE_ABL(LOCAL:2, CHARA) >= GET_MAX_ABL(LOCAL:2, CHARA)
		FOR LOCAL, 0, 4
			UPABLE:(LOCAL:2):LOCAL = -1
		NEXT
		CONTINUE
	ENDIF

	; 判断条件
	FOR LOCAL, 0, 4
		VARSET RESULT, 0, 0, 3
		CALLFORM ABLUP_JUEL_{LOCAL:2}, GET_NATURE_ABL(LOCAL:2, CHARA), LOCAL, CHARA
		; 假设JUEL请求不存在小于0的条件
		IF RESULT <= 0
			UPABLE:(LOCAL:2):LOCAL = -1
			CONTINUE
		ELSE
			; 必要JUEL的判断和记录
			FOR LOCAL:1, 0, 3
				TEMP_NEED = RESULT:(LOCAL:1)
				SIF TEMP_NEED <= 0
					CONTINUE
				; 计算等级加成
				TEMP_NEED = TIMESF(TEMP_NEED, 100 + ABL:CHARA:(LOCAL:2) / 2 * 25)
				; 根据RECORD乘以必要数量
				TEMP = 0
				FOR LOCAL:3, 0, 4
					; 调教术系
					TEMP += (GET_RECORD_ATTAIN(LOCAL:2 * 4 + LOCAL:3) > 0) * 5
					; 调教知识系
					TEMP += (GET_RECORD_ATTAIN(LOCAL:2 * 4 + RECORD_ABLUP_SUM_START + LOCAL:3) > 0) * 10
				NEXT
				TEMP_NEED = MAX(TIMESF(TEMP_NEED, 100 - TEMP), 1)
				; 记录必要JUE
				NEED_JUEL:(LOCAL:2):LOCAL:GETNUM(JUEL, RESULTS:(LOCAL:1)) = TEMP_NEED
				; 如果JUEL不足，则判定失败
				SIF JUEL:CHARA:(RESULTS:(LOCAL:1)) < TEMP_NEED
					UPABLE:(LOCAL:2):LOCAL = 0
			NEXT
		ENDIF
		VARSET RESULT, 0, 0, 3
		VARSET RESULTS, "" , 0, 3
		TRYCCALLFORM ABLUP_EXP_{LOCAL:2}, GET_NATURE_ABL(LOCAL:2, CHARA), LOCAL, CHARA
			FOR LOCAL:1, 0, 3
				TEMP_NEED = RESULT:(LOCAL:1)
				SIF TEMP_NEED <= 0
					CONTINUE
				SIF RESULTS:(LOCAL:1) == ""
					CONTINUE
				; 暂时先忽略
				SIF RESULTS:(LOCAL:1) == "异常经验"
					CONTINUE
				; 记录必要的EXP
				NEED_EXP:(LOCAL:2):LOCAL:GETNUM(EXP, RESULTS:(LOCAL:1)) = TEMP_NEED
				SIF EXP:CHARA:(RESULTS:(LOCAL:1)) < TEMP_NEED
					UPABLE:(LOCAL:2):LOCAL = 0
			NEXT
		CATCH
		ENDCATCH
		VARSET RESULT, 0, 0, 3
		TRYCCALLFORM ABLUP_ABL_{LOCAL:2}, GET_NATURE_ABL(LOCAL:2, CHARA), LOCAL, CHARA
			FOR LOCAL:1, 0, 3
				TEMP_NEED = RESULT:(LOCAL:1)
				SIF TEMP_NEED <= 0
					CONTINUE
				; 记录必要的ABL
				NEED_ABL:(LOCAL:2):LOCAL:GETNUM(ABL, RESULTS:(LOCAL:1)) = TEMP_NEED
				SIF ABL:CHARA:(RESULTS:(LOCAL:1)) < TEMP_NEED
					UPABLE:(LOCAL:2):LOCAL = 0
			NEXT
		CATCH
		ENDCATCH
		; 检查MARK条件
		VARSET RESULT, 0, 0, 3
		TRYCCALLFORM ABLUP_MARK_{LOCAL:2}, GET_NATURE_ABL(LOCAL:2, CHARA), LOCAL, CHARA
			FOR LOCAL:1, 0, 3
				TEMP_NEED = RESULT:(LOCAL:1)
				SIF TEMP_NEED <= 0
					CONTINUE
				; 记录必要的MARK
				NEED_MARK:(LOCAL:2):LOCAL:GETNUM(MARK, RESULTS:(LOCAL:1)) = TEMP_NEED
				; 如果MARK等级不足则判定为失败
				SIF MARK:CHARA:GETNUM(MARK, RESULTS:(LOCAL:1)) < TEMP_NEED
					UPABLE:(LOCAL:2):LOCAL = 0
			NEXT
		CATCH
		ENDCATCH
	NEXT
NEXT
REDRAW 0
;------------------------------------------
; 开始显示
;------------------------------------------
LINE = LINECOUNT
VARSET TEMP
$SHOW_START
CLEARLINE LINECOUNT - LINE
CALL INIT_LAYER
LAYER_Y = 0
LAYER_X = 0

CALL LAYER_DRAWLINE, LAYER_Y
CALL LAYER_SET, @"　能力提升(%CALLNAME:CHARA%)", LAYER_Y + 1
CALL LAYER_DRAWLINE, LAYER_Y + 2

CALL LAYER_SET, @"┌烙印%"─"* ((MAXWIDTH() - 8) / 2)%┐", LAYER_Y + 3
LOCAL = 0
LOCAL:1 = 0
LAYER_Y = LAYER_Y + 4
FOR LOCAL, 0, 100
	SIF MARKNAME:LOCAL == ""
		CONTINUE
	SIF LOCAL:1 % 4 == 0
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 / 4
	CALL LAYER_SET, @"%MARKNAME:LOCAL,10,LEFT%: ", LAYER_Y + LOCAL:1 / 4
	FOR LOCAL:2, 1, 4
		CALL LAYER_SET, ADD_FTAG(UNICODE(0x25AE), MARK:CHARA:LOCAL >= LOCAL:2 ? COLOR("p-blue") # COLOR("gray")), LAYER_Y + LOCAL:1 / 4
	NEXT
	CALL LAYER_SET, " " * (14 + ((LOCAL:1 % 4) < 3) * 2), LAYER_Y + LOCAL:1 / 4
	SIF LOCAL:1 % 4 == 3
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 / 4
	LOCAL:1++
NEXT
CALL LAYER_SET, @"└%"─"* ((MAXWIDTH() - 4) / 2)%┘", LAYER_Y + LOCAL:1 / 4

CALL LAYER_SET, @"┌经验%"─"* ((MAXWIDTH() - 8) / 2)%┐", LAYER_Y + LOCAL:1 / 4 + 1
LAYER_Y = LAYER_Y + LOCAL:1 / 4 + 2
LOCAL = 0
LOCAL:1 = 0
FOR LOCAL, 0, 100
	SIF EXPNAME:LOCAL == ""
		CONTINUE
	SIF LOCAL:1 % 4 == 0
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 / 4
	CALL LAYER_SET, ADD_FTAG(@"%EXPNAME:LOCAL,14,LEFT%:{EXP:CHARA:LOCAL,8}", STRCOUNT(EXPS, "_" + EXPNAME:LOCAL + "_") ? COLOR("p-red") # COLOR("DEF")), LAYER_Y + LOCAL:1 /4
	CALL LAYER_SET, " " * (6 + (LOCAL:1 % 4 > 0) * 2), LAYER_Y + LOCAL:1 / 4
	SIF LOCAL:1 % 4 == 3
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 / 4
	LOCAL:1++ 
NEXT
FOR LOCAL:1, LOCAL:1, 20
	SIF LOCAL:1 % 4 == 0
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 /4
	CALL LAYER_SET, " " * (29 + (LOCAL:1 % 4 > 0) * 2), LAYER_Y + LOCAL:1 /4
	SIF LOCAL:1 % 4 == 3
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 /4
NEXT
CALL LAYER_SET, @"└%"─"* ((MAXWIDTH() - 4) / 2)%┘", LAYER_Y + LOCAL:1 /4

CALL LAYER_SET, @"┌宝珠%"─"* ((MAXWIDTH() - 8) / 2)%┐", LAYER_Y + LOCAL:1 /4 + 1
LAYER_Y = LAYER_Y + LOCAL:1 /4 + 2
LOCAL = 0
LOCAL:1 = 0
FOR LOCAL, 0, VARSIZE("PALAM")
	SIF GROUPMATCH(PALAMNAME:LOCAL, "", "反感", "不快", "抑郁")
		CONTINUE
	SIF LOCAL:1 % 4 == 0
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 / 4
	CALL LAYER_SET, ADD_FTAG(@"%PALAMNAME:LOCAL + "宝珠",8,LEFT%:%TOSTR(JUEL:CHARA:LOCAL,"#,##0"),14%", STRCOUNT(JUELS, "_" + PALAMNAME:LOCAL + "_") ? COLOR("red") # COLOR("DEF")), LAYER_Y + LOCAL:1 /4
	CALL LAYER_SET, " " * (6 + (LOCAL:1 % 4 > 0) * 2), LAYER_Y + LOCAL:1 / 4
	SIF LOCAL:1 % 4 == 3
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 / 4
	LOCAL:1++
NEXT
FOR LOCAL:1, LOCAL:1, 16
	SIF LOCAL:1 % 4 == 0
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 /4
	CALL LAYER_SET, " " * (29 + (LOCAL:1 % 4 > 0) * 2), LAYER_Y + LOCAL:1 /4
	SIF LOCAL:1 % 4 == 3
		CALL LAYER_SET, "│", LAYER_Y + LOCAL:1 /4
NEXT
CALL LAYER_SET, @"└%"─"* ((MAXWIDTH() - 4) / 2)%┘", LAYER_Y + LOCAL:1 /4
CALL LAYER_DRAWLINE, LAYER_Y + LOCAL:1 /4 + 1, "="
CALL LAYER_SET, @"　%ABLNAME:CHOICE%", LAYER_Y + LOCAL:1 /4 + 2
LAYER_Y = LAYER_Y + LOCAL:1 /4 + 3
;----------------------------------------------------------------
; 选择栏
;---------------------------------------------------------------
VARSET 行内条件未达成数量
FOR LOCAL, 0, 4
	SELECTCASE UPABLE:CHOICE:LOCAL
		CASE -1
			L_COLOR = COLOR("gray")
			L_BUTTON = 
		CASE 1
			L_COLOR = COLOR("p-green")
			L_BUTTON '= AUTO_SPLIT("/_*_-_+", "_", LOCAL)
		CASEELSE
			L_COLOR = COLOR("DEF")
			L_BUTTON = 
	ENDSELECT
	CALL LAYER_SET, ADD_FTAG(@"┌%"─"*13%┐", L_COLOR), LAYER_Y, LOCAL * 32
	IF UPABLE:CHOICE:LOCAL >= 0
		CALL LAYER_SET, ADD_FTAG("│ ", L_COLOR), LAYER_Y + 1, LOCAL * 32
		CALL LAYER_SET, ADD_BTAG(ADD_FTAG(@"%"[" + AUTO_SPLIT("/_*_-_+", "_", LOCAL) + "]" + @"\@UPABLE:CHOICE:LOCAL == 1 ? 可 # 无法\@提升能力", 25 , LEFT%", L_COLOR), L_BUTTON), LAYER_Y + 1
		CALL LAYER_SET, ADD_FTAG("│", L_COLOR), LAYER_Y + 1
	ELSE
		CALL LAYER_SET, ADD_FTAG("│ " + @"[%AUTO_SPLIT("/_*_-_+", "_", LOCAL)%] %"",21,LEFT%" + "│", L_COLOR), LAYER_Y + 1, LOCAL * 32
	ENDIF
	CALL LAYER_SET, ADD_FTAG(@"├%"─"*13%┤", L_COLOR), LAYER_Y + 2, LOCAL * 32
	LOCAL:1 = 0
	FOR LOCAL:2, 0, 100
		SIF !NEED_JUEL:CHOICE:LOCAL:(LOCAL:2)
			CONTINUE
		LOCALS '= \@JUEL:CHARA:(LOCAL:2) >= NEED_JUEL:CHOICE:LOCAL:(LOCAL:2) ? ○ # %UNICODE(0x2717)%\@
		LOCALS += @"%PALAMNAME:(LOCAL:2) + "宝珠" + @"{NEED_JUEL:CHOICE:LOCAL:(LOCAL:2), 18 - 4 - STRLENS(PALAMNAME:(LOCAL:2))}" + "个　", 24, LEFT%"
		CALL LAYER_SET, ADD_FTAG("│", L_COLOR) + ADD_BTAG(ADD_FTAG(LOCALS, L_COLOR), L_BUTTON) + ADD_FTAG("│", L_COLOR), LAYER_Y + LOCAL:1 + 3, LOCAL * 32 - 行内条件未达成数量:(LOCAL:1)
		SIF JUEL:CHARA:(LOCAL:2) < NEED_JUEL:CHOICE:LOCAL:(LOCAL:2)
			行内条件未达成数量:(LOCAL:1)++
		LOCAL:1++
	NEXT
	FOR LOCAL:2, 0, 100
		SIF !NEED_EXP:CHOICE:LOCAL:(LOCAL:2)
			CONTINUE
		LOCALS '= \@EXP:CHARA:(LOCAL:2) >= NEED_EXP:CHOICE:LOCAL:(LOCAL:2) ? ○ # %UNICODE(0x2717)%\@
		LOCALS += @"%EXPNAME:(LOCAL:2) + @"{NEED_EXP:CHOICE:LOCAL:(LOCAL:2), 18 - STRLENS(EXPNAME:(LOCAL:2))}", 24, LEFT%"
		CALL LAYER_SET, ADD_FTAG("│", L_COLOR) + ADD_BTAG(ADD_FTAG(LOCALS, L_COLOR), L_BUTTON) + ADD_FTAG("│", L_COLOR), LAYER_Y + LOCAL:1 + 3, LOCAL * 32 - 行内条件未达成数量:(LOCAL:1)
		SIF EXP:CHARA:(LOCAL:2) < NEED_EXP:CHOICE:LOCAL:(LOCAL:2)
			行内条件未达成数量:(LOCAL:1)++
		LOCAL:1++
	NEXT
	FOR LOCAL:2, 0, 100
		SIF !NEED_ABL:CHOICE:LOCAL:(LOCAL:2)
			CONTINUE
		LOCALS '= \@GET_NATURE_ABL(LOCAL:2, CHARA) >= NEED_ABL:CHOICE:LOCAL:(LOCAL:2) ? ○ # %UNICODE(0x2717)%\@
		LOCALS += @"%ABLNAME:(LOCAL:2) + @"{NEED_ABL:CHOICE:LOCAL:(LOCAL:2), 18 - STRLENS(ABLNAME:(LOCAL:2))}", 24, LEFT%"
		CALL LAYER_SET, ADD_FTAG("│", L_COLOR) + ADD_BTAG(ADD_FTAG(LOCALS, L_COLOR), L_BUTTON) + ADD_FTAG("│", L_COLOR), LAYER_Y + LOCAL:1 + 3, LOCAL * 32 - 行内条件未达成数量:(LOCAL:1)
		SIF GET_NATURE_ABL(LOCAL:2, CHARA) < NEED_ABL:CHOICE:LOCAL:(LOCAL:2)
			行内条件未达成数量:(LOCAL:1)++
		LOCAL:1++
	NEXT
	FOR LOCAL:2, 0, 100
		SIF !NEED_MARK:CHOICE:LOCAL:(LOCAL:2)
			CONTINUE
		TRYCCALLFORM OTHER_CHECK_{CHOICE}
			IF RESULTS:1 == "满足"
				LOCALS '= "○"
			ELSEIF RESULTS:1 == "不足"
				LOCALS '= %UNICODE(0x2717)%
			ELSE
				CONTINUE
			ENDIF
			LOCALS += @"%RESULTS, 24, LEFT%"
			CALL LAYER_SET, ADD_FTAG("│", L_COLOR) + ADD_BTAG(ADD_FTAG(LOCALS, L_COLOR), L_BUTTON) + ADD_FTAG("│", L_COLOR), LAYER_Y + LOCAL:1 + 3, LOCAL * 32 - 行内条件未达成数量:(LOCAL:1)
			SIF RESULTS:1 == "不足"
				行内条件未达成数量:(LOCAL:1)++
			LOCAL:1++
		CATCH
			CONTINUE
		ENDCATCH
	NEXT
	FOR LOCAL:1, LOCAL:1, 6
		CALL LAYER_SET, ADD_FTAG("│", L_COLOR) + ADD_BTAG(ADD_FTAG(" " * 26, L_COLOR), L_BUTTON) + ADD_FTAG("│", L_COLOR), LAYER_Y + LOCAL:1 + 3, LOCAL * 32 - 行内条件未达成数量:(LOCAL:1)
	NEXT
	CALL LAYER_SET, ADD_FTAG(@"└%"─"*13%┘", L_COLOR), LAYER_Y + LOCAL:1 + 3, LOCAL * 32
NEXT
LAYER_Y = LAYER_Y + LOCAL:1 + 4
LOCAL = 0
LOCAL:1 = 0
FOR LOCAL, 0, 100
	SIF ABLNAME:LOCAL == ""
		CONTINUE
	IF GROUPMATCH(1, UPABLE:LOCAL:0, UPABLE:LOCAL:1, UPABLE:LOCAL:2, UPABLE:LOCAL:3)
		L_COLOR = COLOR("p-blue")
	ELSEIF LOCAL == CHOICE
		L_COLOR = GETFOCUSCOLOR()
	ELSE
		L_COLOR = COLOR("DEF")
	ENDIF
	CALL LAYER_SET, ADD_BTAG(ADD_FTAG(@" \@GROUPMATCH(1, UPABLE:LOCAL:0, UPABLE:LOCAL:1, UPABLE:LOCAL:2, UPABLE:LOCAL:3) ? ○ # %UNICODE(0x2717)%\@[{LOCAL,2}] %ABLNAME:LOCAL,12,LEFT%:({GET_NATURE_ABL(LOCAL, CHARA),2}/{ABL:CHARA:(LOCAL+100),2})  ", L_COLOR), TOSTR(LOCAL)), LAYER_Y + LOCAL:1 / 4
	CALL LAYER_SET, " " * 2 * (LOCAL:1 % 4 < 3), LAYER_Y + LOCAL:1 / 4
	LOCAL:1++ 
NEXT
FOR LOCAL:1, LOCAL:1, 16
	CALL LAYER_SET, @"%"", 30%" + " " * 2 * (LOCAL:1 % 4 < 3), LAYER_Y + LOCAL:1 / 4
NEXT
LAYER_Y = LAYER_Y + LOCAL:1 / 4
LINE:1 = LINECOUNT + LAYER_Y
CALL LAYER_SET, @"┌%"─"* ((MAXWIDTH() - 4) / 2)%┐", LAYER_Y
CALL LAYER_SET, @"│%"请选择要提升的能力", 122, LEFT%│", LAYER_Y + 1
CALL LAYER_SET, @"│%"", 122, LEFT%│", LAYER_Y + 2
CALL LAYER_SET, @"│%"", 102, LEFT%" + ADD_BTAG(@"%"[-1] 一键提升能力",20, LEFT%", "-1") + "│", LAYER_Y + 3
CALL LAYER_SET, @"│%"", 102, LEFT%" + ADD_BTAG(@"%"[99] 结束提升能力",20, LEFT%", "99") + "│", LAYER_Y + 4
CALL LAYER_SET, @"└%"─"* ((MAXWIDTH() - 4) / 2)%┘", LAYER_Y + 5
CALL LAYER_PRINT, , MAXLINE()
INPUTS
IF RESULTS == "99"
	CLEARLINE LINECOUNT - LINE:1
	CALL MESSAGE_WINDOW, , @"%CALLNAME:CHARA%的能力提升结束了"
	REDRAW 1
	RETURN 0
; 一键升级
ELSEIF RESULTS == "-1" 
	CLEARLINE LINECOUNT - LINE:1
	CALL MESSAGE_WINDOW, , @"开始升级%CALLNAME:CHARA%的能力……"
	; 记录成功升级的次数
	TEMP:1 = 0
	; 遍历所有能力
	FOR LOCAL:1, 0, 100
		SIF ABLNAME:(LOCAL:1) == ""
			CONTINUE
		; 遍历所有升级类型
		FOR LOCAL:2, 0, 4
			; 如果此能力此类型可升级
			IF UPABLE:(LOCAL:1):(LOCAL:2) == 1 
				; 执行升级操作，与单个升级的逻辑相同
				FOR LOCAL:3, 0, 100
					JUEL:CHARA:(LOCAL:3) -= NEED_JUEL:(LOCAL:1):(LOCAL:2):(LOCAL:3)
				NEXT
				ABL:CHARA:(LOCAL:1)++
				MARK:CHARA:抗拒烙印 = MAX(3 - ABL:CHARA:消除抗拒,0)
				RECORD_ABLUP_SUM:(LOCAL:1) += ABL:CHARA:(LOCAL:1)
				CALL MESSAGE_WINDOW, , @"%CALLNAME:CHARA%的%ABLNAME:(LOCAL:1)%变为{GET_NATURE_ABL(LOCAL:1, CHARA)}了！"
				TEMP:1++
				;------------------------
				; 判定成就
				;------------------------
				FOR LOCAL, 0, 4
					TEMP = LOCAL:1 * 4 + LOCAL
					TEMP:0 = AUTO_SPLIT_INT("3_5_7_10" , "_", LOCAL)
					SIF GET_RECORD_ATTAIN(TEMP)
						CONTINUE
					SIF GET_STRFLAG_NUM("CSTR:CHARA:初期ABL", ABLNAME:(LOCAL:1)) >= TEMP:0
						CONTINUE
					SIF GET_NATURE_ABL(LOCAL:1, CHARA) < TEMP:0
						CONTINUE
					CALL SET_RECORD_ATTAIN, TEMP, 1
					CALL MESSAGE_WINDOW, , @"%ABLNAME:(LOCAL:1)%提升到{TEMP:0}以上/达成了【%GET_NAME("成就", TEMP)%】！"
				NEXT
				FOR LOCAL, 0, 4
					TEMP = LOCAL:1 * 4 + LOCAL + RECORD_ABLUP_SUM_START
					TEMP:0 = AUTO_SPLIT_INT("15_40_100_200" , "_", LOCAL)
					SIF GET_RECORD_ATTAIN(TEMP)
						CONTINUE
					SIF RECORD_ABLUP_SUM:(LOCAL:1) < TEMP:0
						CONTINUE
					CALL SET_RECORD_ATTAIN, TEMP, 1
					CALL MESSAGE_WINDOW, , @"%ABLNAME:(LOCAL:1)%的等级提升已达成一定次数以上/达成了【%GET_NAME("成就", TEMP)%】！"
				NEXT
				IF SUMARRAY(ABL:CHARA:0, 0, 100) >= 25
					FOR LOCAL, 20, 180
						LOCALS = 因为%CALLNAME:CHARA%的成长，
						FOR LOCAL:4, 0, 3
							SIF TALENT:CHARA:LOCAL <= LOCAL:4
								CONTINUE
							TEMP = RECORD_TALENT_START + LOCAL * 3 + LOCAL:4
							SIF GET_RECORD_ATTAIN(TEMP)
								CONTINUE
							CALL SET_RECORD_ATTAIN, TEMP, 1
							LOCALS += @"/达成了【%GET_NAME("成就", TEMP)%】！"
						NEXT
						SIF STRCOUNT(LOCALS, "/")
							CALL MESSAGE_WINDOW, , LOCALS
					NEXT
				ENDIF
				CALL SHOW_BLANK
			ENDIF
		NEXT
	NEXT
	IF TEMP:1 > 0
		CALL MESSAGE_WINDOW, , @"一键升级完成，共提升了{TEMP:1}次能力！"
	ELSE
		CALL MESSAGE_WINDOW, , "没有可升级的能力。"
	ENDIF
	REDRAW 1
	GOTO START
ELSEIF ISNUMERIC(RESULTS)
	SIF INRANGE(TOINT(RESULTS), 0, 99) && ABLNAME:TOINT(RESULTS) != ""
		CHOICE = TOINT(RESULTS)
ELSE
	SELECTCASE RESULTS
		CASE "/"
			TEMP = 0
		CASE "*"
			TEMP = 1
		CASE "-"
			TEMP = 2
		CASE "+"
			TEMP = 3
	ENDSELECT
	IF TEMP >= 0 && UPABLE:CHOICE:TEMP > 0
		CLEARLINE LINECOUNT - LINE:1
		CALLFORM ABLUP_JUEL_{CHOICE}, GET_NATURE_ABL(CHOICE, CHARA), TEMP, CHARA
		L_RESULT = RESULT, RESULT:1, RESULT:2
		SPLIT RESULTS, "/", LOCALS
		TEMP:1 = RESULT
		FOR LOCAL, 0, TEMP:1
			IF !LOCAL
				TEMPS = %LOCALS%宝珠
			ELSE
				TEMPS += "和" + LOCALS:LOCAL + "宝珠"
			ENDIF
		NEXT
		CALL INPUT_YN_M, @"确定要使用%TEMPS%/提升%ABLNAME:CHOICE%吗？"
		IF !RESULT
			FOR LOCAL, 0, 100
				JUEL:CHARA:LOCAL -= NEED_JUEL:CHOICE:TEMP:LOCAL
			NEXT
			; 能力提升
			ABL:CHARA:CHOICE++
			; 消除抗拒烙印
			MARK:CHARA:抗拒烙印 = MAX(3 - ABL:CHARA:消除抗拒,0)
			; 记录等级合计UP量
			RECORD_ABLUP_SUM:CHOICE += ABL:CHARA:CHOICE
			CALL MESSAGE_WINDOW, , @"%CALLNAME:CHARA%的%ABLNAME:CHOICE%变为{GET_NATURE_ABL(CHOICE, CHARA)}了！"
			;------------------------
			; 判定成就
			;------------------------
			FOR LOCAL, 0, 4
				TEMP = CHOICE * 4 + LOCAL
				TEMP:1 = AUTO_SPLIT_INT("3_5_7_10" , "_", LOCAL)
				; 如果达成了就跳过
				SIF GET_RECORD_ATTAIN(TEMP)
					CONTINUE
				; 如果超过了原本的数值就跳过
				SIF GET_STRFLAG_NUM("CSTR:CHARA:初期ABL", ABLNAME:CHOICE) >= TEMP:1
					CONTINUE
				; 检查是否达到了门槛
				SIF GET_NATURE_ABL(CHOICE, CHARA) < TEMP:1
					CONTINUE
				CALL SET_RECORD_ATTAIN, TEMP, 1
				CALL MESSAGE_WINDOW, , @"%ABLNAME:CHOICE%提升到{TEMP:1}以上/达成了【%GET_NAME("成就", TEMP)%】！"
			NEXT
			FOR LOCAL, 0, 4
				TEMP = CHOICE * 4 + LOCAL + RECORD_ABLUP_SUM_START
				TEMP:1 = AUTO_SPLIT_INT("15_40_100_200" , "_", LOCAL)
				; 如果达成了就跳过
				SIF GET_RECORD_ATTAIN(TEMP)
					CONTINUE
				; 检查是否达到了门槛
				SIF RECORD_ABLUP_SUM:CHOICE < TEMP:1
					CONTINUE
				CALL SET_RECORD_ATTAIN, TEMP, 1
				CALL MESSAGE_WINDOW, , @"%ABLNAME:CHOICE%的等级提升已达成一定次数以上/达成了【%GET_NAME("成就", TEMP)%】！"
			NEXT
			; 判定ABL合计25以上的素质成就
			IF SUMARRAY(ABL:CHARA:0, 0, 100) >= 25
				FOR LOCAL, 20, 180
					LOCALS = 因为%CALLNAME:CHARA%的成长，
					FOR LOCAL:1, 0, 3
						SIF TALENT:CHARA:LOCAL <= LOCAL:1
							CONTINUE
						TEMP = RECORD_TALENT_START + LOCAL * 3 + LOCAL:1
						SIF GET_RECORD_ATTAIN(TEMP)
							CONTINUE
						CALL SET_RECORD_ATTAIN, TEMP, 1
						LOCALS += @"/达成了【%GET_NAME("成就", TEMP)%】！"
					NEXT
					SIF STRCOUNT(LOCALS, "/")
						CALL MESSAGE_WINDOW, , LOCALS
				NEXT
			ENDIF
			CALL SHOW_BLANK
		ENDIF
	ENDIF
ENDIF
GOTO START
