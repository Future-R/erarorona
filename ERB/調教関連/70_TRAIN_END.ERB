;
;	Modification Data:
;
;
;	Edit	Date				Author		Ver			Reason					
;	001		2012/XX/XX			kap			X.XX		新規作成				
;	002		2012/08/01			kap			0.300		各種味のリセットとそれによる体力の最大值チェックを追加
;	003		2012/09/11			kap			0.360		蘑菇之力のリセット処理を追加
;	004		2012/12/02			kap			0.430		スキル使用效果のリセットを追加
;---------------------------------------------------------------------
@TRAIN_END
#LOCALSIZE 1
FOR LOCAL, 0, 3
	SIF TRAINCHARA(LOCAL) < 0
		CONTINUE
	;味などの処理
	VARSET CFLAG:TRAINCHARA(LOCAL):0, 0, 200, 300
	;上限チェックもしておく
	BASE:TRAINCHARA(LOCAL):体力 = MIN(MAXBASE:TRAINCHARA(LOCAL):体力, BASE:TRAINCHARA(LOCAL):体力)
NEXT
;スキル使用をリセット
VARSET FR_SKILL_USE, 0
; 如果调教使体力用尽，则本次调教友情值-1
LOCAL = BASE:体力 > 1 ? 0 # 100
; 调教结束获得的交友值(单位是百) = 300 * 信赖之心系数 * 消耗的时间比；
; 如果调教目标体力耗尽，则-100，但不会低于0。
SIF CFLAG:TARGET:人类
	CALL GAIN_FRIEND_POINT, TARGET, MAX(CALCF(300, TRAIN_SKILL_POWER_信赖之力(TARGET)) * (10000 - GET_TRAINRECORD("剩余时间", TFLAG:当前回合)) / 10000 - LOCAL,0)
SIF GET_EVENT_PLAY("第一次调教")
	CALL SET_EVENTFLAG, "第一次调教", "状态", "第一次调教结束"
; 再检查连锁成就，避免尾刀吃不到
CALL 检查连锁成就
;--------------------------------------------
;コマンドの习得判定
;-------------------------------------------
IF GET_EVENT_ATTAIN("邀请练习")
	FOR LOCAL, 0, 指令总数
		SIF STRCOUNT(GET_NAME("指令", LOCAL), "名称不在")
			CONTINUE
		SIF GET_COM_LEARN_M(LOCAL) != 1
			CONTINUE
		COM_LEARN:LOCAL = 1
		;とりあえず奉仕を弾く
		SIF STRCOUNT(GET_NAME("指令", LOCAL), "(侍奉)")
			CONTINUE
		CALL MESSAGE_WINDOW, , @"因为%CALLNAME:MASTER%积累了足够的经验，/习得了【%GET_NAME("指令", LOCAL)%】！"
	NEXT
ENDIF
CALL ADD_DAY, 1
@TRAIN_END_HEADER
CLEARLINE LINECOUNT - TFLAG:菜单显示线
DRAWLINE
PRINTFORML ＴＲＡＩＮ　ＥＮＤ
DRAWLINE
FOR LOCAL, 0, MAXLINE() - (TFLAG:菜单显示线 - TFLAG:显示开始线) - 8
	CALL WINDOWPRINTBUTTON, " " * 120
	PRINTL 
NEXT
