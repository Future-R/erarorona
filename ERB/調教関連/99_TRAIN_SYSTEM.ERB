;--------------------------------------------
;SOURCEの補正倍率を取得する
;ARGS 	SOURCE名称
;AR1	対象のキャラ
;ARG:1	調教関係者
;-------------------------------------------
@GET_SOURCE_POWER, ARGS, ARG = -1, ARG:1 = -1
#DIM L_RESULT, 2
SIF ISNUMERIC(ARGS)
	ARGS = %PALAMNAME:TOINT(ARGS)%
VARSET L_RESULT
CALL GET_TALENT_SOURCE, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1

CALL GET_TRAIN_STATE_SOURCE, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1

CALL GET_TRAIN_SKILL_SOURCE, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1
RETURN L_RESULT, L_RESULT:1

;--------------------------------------------
;CUPの補正倍率を取得する
;ARGS 	SOURCE名称
;AR1	対象のキャラ
;ARG:1	調教関係者
;-------------------------------------------
@GET_CUP_POWER, ARGS, ARG = -1, ARG:1 = -1
#DIM L_RESULT, 2
SIF ISNUMERIC(ARGS)
	ARGS = %PALAMNAME:TOINT(ARGS)%
VARSET L_RESULT
CALL GET_TALENT_CUP, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1

CALL GET_MARK_CUP, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1

CALL GET_TRAIN_STATE_CUP, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1

CALL GET_TRAIN_SKILL_CUP, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1

CALL GET_FRIEND_SKILL_CUP, ARGS, ARG, ARG:1
L_RESULT += RESULT
L_RESULT:1 += RESULT:1

;特殊処理
SELECTCASE ARGS
	CASE "反感"
		L_RESULT -= GETPALAMLV(PALAM:ARG:恭順, 20) * 10
		L_RESULT -= GETPALAMLV(PALAM:ARG:恐怖, 20) * 20
ENDSELECT

RETURN L_RESULT, L_RESULT:1

