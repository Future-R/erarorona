;-------------------------------------------------
;手交
;-------------------------------------------------
@COM_NAME_10
RESULTS = 手交

@COM_DOWNBASE_10
RETURN 40, 20

@COM_LEARN_10, ARG
#FUNCTION
RESULT = 2
RETURNF 1

@COM_ABLE_10, ARG, ARG:1, ARG:2
RESULTS = 调教者的手可以使用/调教对象的性器可以使用
SIF !USE_HAND(ARG:1)
	RETURN 0
IF COM_BRUNCH:10 == 0
	SIF !USE_PENIS(ARG)
		RETURN 0
ELSE
	SIF !USE_CLI(ARG)
		RETURN 0
ENDIF
RETURN 1

@COM_BRUNCH_10, ARG, ARG:1, ARG:2
IF HAVE_BODY("阴茎", ARG)
	RETURN 0
ELSE
	RETURN 1
ENDIF

@COM_EFFECT_10
RESULTS = 对Ｃ快感(小)

@COM_PROPERTY_10
RESULTS = 爱抚/手活

@COM_SOURCE_10, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN 120
	CASE "露出"
		RETURN 10
	CASE "逃脱"
		RETURN 10
	CASE "反感"
		RETURN 15
	CASEELSE
		RETURN 0
ENDSELECT

@COM_ACT_10, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_10, ARG, ARG:1, ARG:2
RESULTS = 
IF COM_BRUNCH:10 == 0
	SELECTCASE GETPALAMLV(PALAM:ARG:快Ｃ, 20)
		CASE IS < 4
			RESULTS = %CALLNAME:ARG%还未勃起的阴茎被手轻轻地握住，温柔地抚摸着。
		CASE IS < 7
			RESULTS = %CALLNAME:ARG%的阴茎被手指拢住撸动着。
		CASEELSE
			RESULTS = %CALLNAME:ARG%坚挺勃起的阴茎被抓住，粗暴地榨取着。
	ENDSELECT
ELSE
	SELECTCASE 润滑等级(ARG)
		CASE IS < 3
			RESULTS = %CALLNAME:ARG%干涸的阴道被手指温柔地刺激着。
		CASE IS < 5
			IF 欲情等级(ARG) < 4
				RESULTS = %CALLNAME:ARG%的阴蒂被手指轻柔地摩擦着。
			ELSE
				RESULTS = %CALLNAME:ARG%坚硬挺立的阴蒂被指腹用力地揉搓着。
			ENDIF
		CASE IS < 7
			RESULTS = %CALLNAME:ARG%爱液满溢的阴道被手指激烈地抠弄着。
	ENDSELECT
ENDIF
@COM_TOUCH_10
RESULTS = %性器()%/手

@COM_STAIN_10

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_10, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT

