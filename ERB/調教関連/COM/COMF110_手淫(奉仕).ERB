@COM_SOURCE_110, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN 0, 150
	CASE "露出"
		RETURN 20
	CASE "性行动"
		RETURN 70, 0
	CASE "屈从"
		RETURN 50, 0
	CASE "逃脱"
		RETURN 80
	CASE "反感"
		RETURN 80
	CASEELSE
		RETURN 0
ENDSELECT
@MESSAGE_COM_110, ARG, ARG:1, ARG:2
RESULTS = 
IF COM_BRUNCH:110 == 0
	IF GET_ABL("侍奉精神", ARG) > 1
		SELECTCASE GETPALAMLV(PALAM:(ARG:1):快Ｃ, 20)
			CASE IS < 4
				RESULTS = %CALLNAME:ARG%愉快地套弄着自己手中%CALLNAME:(ARG:1)%逐渐勃起的阴茎。
			CASE IS < 7
				RESULTS = %CALLNAME:(ARG:1)%的阴茎被手指拢住，仔细地撸动着。
			CASEELSE
				RESULTS = %CALLNAME:ARG%露出兴奋的神情，抓住%CALLNAME:(ARG:1)%坚挺勃起的阴茎，粗暴地榨取着。
		ENDSELECT
	ELSE
		SELECTCASE GETPALAMLV(PALAM:(ARG:1):快Ｃ, 20)
			CASE IS < 4
				RESULTS = %CALLNAME:ARG%仔细地抚摸着%CALLNAME:(ARG:1)%还未勃起的阴茎。
			CASE IS < 7
				RESULTS = %CALLNAME:ARG%
				SIF GET_TALENT("好奇心", ARG)
					RESULTS += "的眼中亮起好奇的光芒，"
				RESULTS += "用手指拢住%CALLNAME:(ARG:1)%的阴茎，撸动着……"
			CASEELSE
				RESULTS = %CALLNAME:ARG%有些胆怯地握住%CALLNAME:(ARG:1)%坚挺勃起的阴茎，撸动着。
		ENDSELECT
	ENDIF
ELSE
	IF GET_ABL("侍奉精神", ARG) > 1
		SELECTCASE 润滑等级(ARG:1)
			CASE IS < 3
				RESULTS = %CALLNAME:ARG%用手指温柔地刺激着%CALLNAME:(ARG:1)%干涸的阴道。
			CASE IS < 5
				IF 欲情等级(ARG:1) < 4
					RESULTS = %CALLNAME:ARG%手指轻柔地摩擦着%CALLNAME:(ARG:1)%的阴蒂。
				ELSE
					RESULTS = %CALLNAME:ARG%用指腹用力地揉搓着%CALLNAME:(ARG:1)%坚硬挺立的阴蒂。
				ENDIF
			CASE IS < 7
				RESULTS = %CALLNAME:ARG%在看着%CALLNAME:(ARG:1)%脸的同时，用手指激烈地抠弄着对方爱液满溢的阴道……
		ENDSELECT
	ELSE
		SELECTCASE 润滑等级(ARG:1)
			CASE IS < 3
				RESULTS = %CALLNAME:ARG%担心伤到了对方，仔细地摩擦着%CALLNAME:(ARG:1)%的阴蒂。
			CASEELSE
				RESULTS = %CALLNAME:ARG%仔细地摩擦着%CALLNAME:(ARG:1)%的阴蒂。
		ENDSELECT
	ENDIF
ENDIF
