	CASE "快Ｃ"
		RETURN 0, 300
	CASE "露出"
		RETURN 50
	CASE "性行動"
		RETURN 200, 0
	CASE "屈従"
		RETURN 100, 0
	CASE "液体"
		RETURN 150
	CASE "逸脱"
		RETURN 250
	CASE "反感"
		RETURN 400
	CASEELSE
		RETURN 0
ENDSELECT

@MESSAGE_COM_111, ARG, ARG:1, ARG:2
IF GET_ABL("奉仕精神", ARG) > 1
	SELECTCASE 潤滑レベル(ARG:1)
		CASE IS < 3
			RESULTS = %CALLNAME:ARG%はヴァギナに口づけると激しく舐めはじめた……
		CASEELSE
			IF 欲情レベル(ARG:1)
				RESULTS = %CALLNAME:ARG%は快感に跳ねる%CALLNAME:(ARG:1)%の腰をしっかりとおさえて、ヴァギナを激しく舐めている……
			ELSE
				RESULTS = %CALLNAME:ARG%は溢れる愛液を音を立てて啜りながら、ヴァギナを舐めている……
			ENDIF
	ENDSELECT
ELSE
	SELECTCASE 潤滑レベル(ARG:1)
		CASE IS < 3
			RESULTS = %CALLNAME:ARG%は恐る恐るヴァギナに口づけるとちろちろと舐めはじめた……
		CASEELSE
			IF 欲情レベル(ARG:1)
				RESULTS = %CALLNAME:ARG%の控えめな愛撫にもどかしくなった%CALLNAME:(ARG:1)%はヴァギナを強く押し付けて舐めさせた……
			ELSE
				RESULTS = %CALLNAME:ARG%は溢れる愛液に顔を汚しながら、ヴァギナを丁寧に舐めている……
			ENDIF
	ENDSELECT
ENDIF
