@COM_SOURCE_112, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN 0, 350
	CASE "露出"
		RETURN 50
	CASE "达成"
		RETURN 70, 0
	CASE "屈从"
		RETURN 150, 0
	CASE "逃脱"
		RETURN 250
	CASE "反感"
		RETURN 400
	CASEELSE
		RETURN 0
ENDSELECT

@MESSAGE_COM_112, ARG, ARG:1, ARG:2
SELECTCASE 反感等级(ARG)
	CASE IS > 2
		RESULTS = %CALLNAME:ARG%皱眉露出愤怒的神色，将阴茎含入口中……
	CASE IS > 0
		RESULTS = %CALLNAME:ARG%胆怯地亲吻上对方的阴茎，开始舔舐起来……
	CASEELSE
		SELECTCASE 勃起等级(ARG)
			CASE 0
				IF GET_ABL("精液成瘾", ARG) > 1
					IF GET_STAIN("阴茎", "精液", ARG)
						RESULTS = %CALLNAME:ARG%津津有味地舔舐起阴茎上的精液，/随着硬度逐渐增加，再次将阴茎含入口中猛烈舔弄……
					ELSE
						RESULTS = %CALLNAME:ARG%含住仍然柔软的阴茎，享受着逐渐膨胀的过程，来回舔弄。
					ENDIF
				ELSE
					RESULTS = %CALLNAME:ARG%含住仍然柔软的阴茎，轻柔地舔弄。
				ENDIF
			CASE 1
				IF GET_ABL("精液成瘾", ARG) > 1
					IF GET_STAIN("阴茎", "精液", ARG)
						RESULTS = %CALLNAME:ARG%细心舔掉阴茎上的精液，/为了让其再次射精，将阴茎含入口中……
					ELSE
						RESULTS = %CALLNAME:ARG%眯起眼睛，高兴地向阴茎扑过来……
					ENDIF
				ELSE
					RESULTS = %CALLNAME:ARG%含住已经坚硬挺立的阴茎，用力吮吸舔弄……
				ENDIF
			CASEELSE
				IF GET_ABL("精液成瘾", ARG) > 1
					RESULTS = %CALLNAME:ARG%迫不及待地想要对方射精，专心致志地舔舐着阴茎……
				ELSE
					RESULTS = %CALLNAME:ARG%的眼中满溢着期待，将颤动着的阴茎含入口中开始爱抚……
				ENDIF
		ENDSELECT
ENDSELECT
