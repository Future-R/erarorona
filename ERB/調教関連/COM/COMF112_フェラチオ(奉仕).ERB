RESULTS = 調教者がペニスを所持
RETURN GET_NO("コマンド", "クンニ(奉仕)")

@COM_SOURCE_112, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN 0, 350
	CASE "露出"
		RETURN 50
	CASE "達成"
		RETURN 70, 0
	CASE "屈従"
		RETURN 150, 0
	CASE "逸脱"
		RETURN 250
	CASE "反感"
		RETURN 400
	CASEELSE
		RETURN 0
ENDSELECT

@MESSAGE_COM_112, ARG, ARG:1, ARG:2
SELECTCASE 反感レベル(ARG)
	CASE IS > 2
		RESULTS = %CALLNAME:ARG%は顔を顰め、怒りを露わにしながらペニスを口に含んだ……
	CASE IS > 0
		RESULTS = %CALLNAME:ARG%は恐る恐るペニスに口づけるとちろちろと舐めはじめた……
	CASEELSE
		SELECTCASE 勃起レベル(ARG)
			CASE 0
				IF GET_ABL("精液中毒", ARG) > 1
					IF GET_STAIN("ペニス", "精液", ARG)
						RESULTS = %CALLNAME:ARG%はペニスについている精液を美味しそうに舐めとると、/そのまま硬度を増してきたペニスを口に含んで激しく舐め回した…
					ELSE
						RESULTS = %CALLNAME:ARG%はまだ柔らかなペニスを口に含み、大きくなっていく様を楽しむかのように舐め回している。
					ENDIF
				ELSE
					RESULTS = %CALLNAME:ARG%はまだ柔らかなペニスを口に含み、優しく舐め回した。
				ENDIF
			CASE 1
				IF GET_ABL("精液中毒", ARG) > 1
					IF GET_STAIN("ペニス", "精液", ARG)
						RESULTS = %CALLNAME:ARG%はペニスについている精液を丁寧に舐めとると、/再び精液を吐き出させるため、ペニスを口に含んだ…
					ELSE
						RESULTS = %CALLNAME:ARG%は目を細め、嬉しそうにペニスにむしゃぶりついている…
					ENDIF
				ELSE
					RESULTS = %CALLNAME:ARG%は硬くそそり勃ったペニスを口に咥えて舐めまわした……
				ENDIF
			CASEELSE
				IF GET_ABL("精液中毒", ARG) > 1
					RESULTS = %CALLNAME:ARG%は射精が待ちきれず、一心不乱にペニスを舐めまわしている…
				ELSE
					RESULTS = %CALLNAME:ARG%は期待に満ちた目で、びくびくとうごくペニスを口に含んで愛撫をはじめた…
				ENDIF
		ENDSELECT
ENDSELECT
