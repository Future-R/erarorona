	CASE "快Ｃ"
		RETURN 240
	CASE "液体"
		RETURN 120
	CASE "露出"
		RETURN 60
	CASE "逸脱"
		RETURN 150
	CASE "反感"
		RETURN 150
	CASEELSE
		RETURN 0
ENDSELECT
