;-------------------------------------------------
;舔阴
;-------------------------------------------------
@COM_NAME_11
RESULTS = 舔阴

@COM_DOWNBASE_11
RETURN 60, 80

@COM_JUMP_11, ARG, ARG:1, ARG:2
RESULTS = 调教对象拥有阴茎
SIF HAVE_BODY("阴茎", ARG)
	RETURN GET_NO("指令", "口交")
RETURN 0

@COM_LEARN_11, ARG
#FUNCTION
RESULTS = 口活经验 10 或Ｃ经验 10
RESULT = 1
SIF EXP:ARG:口活经验 < 10 && EXP:ARG:Ｃ经验 < 10
	RESULT = 0
RETURNF RESULT

@COM_ABLE_11, ARG, ARG:1, ARG:2
RESULTS = 调教者的口可以使用/调教对象的阴蒂可以使用/调教对象的阴蒂已清洁
;性器が汚れているとMASTERの場合舔阴はできない（调教者が无视污秽か愛液、母乳のよごれならＯＫ）
SIF DIRTY("阴道", ARG) && !GET_TALENT("无视污秽", ARG:1)
	RETURN 0
SIF !USE_MOUTH(ARG:1)
	RETURN 0
SIF !USE_CLI(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_11
RESULTS = 对Ｃ快感(中)

@COM_PROPERTY_11
RESULTS = 爱抚/口活

@COM_SOURCE_11, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN 240
	CASE "液体"
		RETURN 120
	CASE "露出"
		RETURN 60
	CASE "逃脱"
		RETURN 150
	CASE "反感"
		RETURN 150
	CASEELSE
		RETURN 0
ENDSELECT
@COM_ACT_11, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
;0,愛撫
;-------------------------------------------------
@MESSAGE_COM_11, ARG, ARG:1, ARG:2
	SELECTCASE 润滑等级(ARG)
		CASE IS < 3
			RESULTS = %CALLNAME:PLAYER%舔舐着%CALLNAME:TARGET%光滑的阴户，为接下来更进一步的调教做着准备……
		CASEELSE
			RESULTS = 舔舐着%CALLNAME:TARGET%湿漉漉的蜜裂，%CALLNAME:PLAYER%将温润柔软的舌头探入其中，在穴口内部刺激着周围软嫩的肉壁
			IF 欲情等级(ARG) > 3
			RESULTS += @"_%CALLNAME:TARGET%的小穴轻微地一开一合散发出旖旎的气味，充血而高昂的阴蒂与%CALLNAME:PLAYER%的鼻尖轻轻磨蹭起来……"
			ELSE
            RESULTS += @"……"
			ENDIF
	ENDSELECT
@COM_TOUCH_11
RESULTS = 阴道/口

@COM_STAIN_11

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_11, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT

