@COM_ABLE_11, ARG, ARG:1, ARG:2
RESULTS = 調教者が口を使用可能/調教対象のクリトリスを使用可能/調教対象のクリトリスが清潔
;性器が汚れているとMASTERの場合舔阴はできない（調教者が无视污秽か愛液、母乳のよごれならＯＫ）
SIF DIRTY("阴道", ARG) && !GET_TALENT("无视污秽", ARG:1)
	RETURN 0
SIF !USE_MOUTH(ARG:1)
	RETURN 0
SIF !USE_CLI(ARG)
	RETURN 0
RETURN 1

