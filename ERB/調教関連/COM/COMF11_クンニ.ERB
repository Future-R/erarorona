@COM_JUMP_11, ARG, ARG:1, ARG:2
RESULTS = 調教対象にペニスがある
SIF HAVE_BODY("ペニス", ARG)
	RETURN GET_NO("コマンド", "フェラチオ")
RETURN 0

@COM_LEARN_11, ARG
#FUNCTION
RESULTS = 口技経験 10 あるいはＣ経験 10
RESULT = 1
SIF EXP:ARG:口技経験 < 10 && EXP:ARG:Ｃ経験 < 10
	RESULT = 0
RETURNF RESULT

@COM_ABLE_11, ARG, ARG:1, ARG:2
RESULTS = 調教者が口を使用可能/調教対象のクリトリスを使用可能/調教対象のクリトリスが清潔
;性器が汚れているとMASTERの場合クンニはできない（調教者が汚れ無視か愛液、母乳のよごれならＯＫ）
SIF DIRTY("ヴァギナ", ARG) && !GET_TALENT("汚れ無視", ARG:1)
	RETURN 0
SIF !USE_MOUTH(ARG:1)
	RETURN 0
SIF !USE_CLI(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_11
