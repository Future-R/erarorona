@COM_ACT_12, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_12, ARG, ARG:1, ARG:2
SELECTCASE 勃起等级(ARG)
	CASE 0
		IF GET_STAIN("阴茎", "精液", ARG)
			RESULTS = 细心舔掉%CALLNAME:ARG%阴茎上的精液，/为了使其勃起，含入口中猛烈舔弄……
		ELSE
			RESULTS = 含住%CALLNAME:ARG%仍然柔软的阴茎，轻柔地舔弄。
		ENDIF
	CASE 1
		IF GET_STAIN("阴茎", "精液", ARG)
			RESULTS = 细心舔掉%CALLNAME:ARG%阴茎上的精液，/为了让其再次射精，将阴茎含入口中……
		ELSE
			RESULTS = 含住%CALLNAME:ARG%已经坚硬挺立的阴茎，用力吮吸舔弄……
		ENDIF
	CASEELSE
		IF GET_STAIN("阴茎", "精液", ARG)
			RESULTS = 吮吸着%CALLNAME:ARG%被精液和前液沾染的阴茎，/前后摆动头部，用舌头激烈地舔弄……
		ELSE
			RESULTS = 紧紧含住%CALLNAME:ARG%抽搐跳动的阴茎，用舌头激烈地舔弄……
		ENDIF
ENDSELECT

