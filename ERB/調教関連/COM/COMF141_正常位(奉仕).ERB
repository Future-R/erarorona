;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_141, ARG, ARG:1, ARG:2
#LOCALSSIZE 2
RESULTS = 
;前回と今回の調教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("調教者", TFLAG:現ターン - 1) == ARG && TCVAR:ARG:挿入継続
	IF IS_PREVCOM("正常位(奉仕)")
		RESULTS += @"%CALLNAME:(ARG:1)%は%CALLNAME:ARG%に命じて、そのまま抽送を続けさせた"
	ELSE
		RESULTS +=  @"膣内から抜かせずに、仰向けになると%CALLNAME:ARG%に再び腰を動かすように命じた"
	ENDIF
	IF GET_ABL("欲望", ARG:1) > 3 && 欲情レベル(ARG:1) > 4
		IF GET_ABL("Ｃ感覚", ARG:1) < 3
			RESULTS += @"_%CALLNAME:ARG%はうっとりしながら腰を動かしはじめた……"
		ELSE
			RESULTS += @"_それを聞いて%CALLNAME:ARG%はさきほどより一層激しく腰を動かしはじめた……"
		ENDIF
	ELSE
		RESULTS += "……"
	ENDIF
ELSE
	LOCALS = 
	;処女
	IF GET_TALENT("処女", ARG:1)
		LOCALS += "男を受け入れたことのない"
	;潤滑LV4以上
	ELSEIF 潤滑レベル(ARG:1) > 3
		LOCALS += "濡れそぼった"
	ENDIF
	IF GET_TALENT("小柄", ARG:1)
		LOCALS += "幼いワレメ"
	ELSE
		LOCALS += "秘裂"
	ENDIF
	SELECTCASE 欲情レベル(ARG)
		CASE IS >= 5
			LOCALS:1 = はちきれんばかり勃起したペニス
		CASE IS > 2
			LOCALS:1 = 硬く屹立したペニス
		CASEELSE
			LOCALS:1 = %CALLNAME:ARG%のペニス
	ENDSELECT
	IF GET_ABL("奉仕精神", ARG) > 1
		RESULTS += @"%CALLNAME:(ARG:1)%は%CALLNAME:ARG%の前で大きく股を開き_"
		RESULTS += @"自らの%LOCALS%で%LOCALS:1%を受け入れた…"
	ELSE
		RESULTS += @"%CALLNAME:(ARG:1)%は寝そべって股を開き、%CALLNAME:ARG%に命じて%LOCALS%を貫かせた"
	ENDIF
ENDIF
;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_REACT_S_141, ARG, ARG:1, ARG:2
IF TCVAR:(ARG:1):処女喪失
	IF GET_ABL("奉仕精神", ARG) > 1
		RESULTS += @"%CALLNAME:ARG%は苦痛に身を震わせる%CALLNAME:(ARG:1)%を労ってゆっくりと腰を動かしている…"
	ELSEIF GET_ABL("欲望", ARG) > 3
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の苦しげな様子に戸惑っているものの腰を止められないでいる…"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の苦しげな様子に戸惑っているもの、%CALLNAME:(ARG:1)%の支持に従い、腰を動かし続けている…"
	ENDIF
ENDIF
IF TCVAR:ARG:初膣内射精
	IF CFLAG:ARG:ユニーク == 0
		IF GET_ABL("奉仕精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精から沸き立つ、不思議な幸福感に顔を綻ばせている…"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精から沸き立つ感情が何なのかわからず戸惑っている…"
		ENDIF
	ELSE
		IF GET_ABL("奉仕精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に感極まって%CALLNAME:(ARG:1)%を強く抱きしめてきた…"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めて膣内に出してしまい、不安そうに%CALLNAME:(ARG:1)%の顔を見つめている…"
		ENDIF
	ENDIF
ENDIF
;同時絶頂
@MESSAGE_ORGASM_TOGETHER_141, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｖ") && IS_ORGASM(ARG, "Ｐ")
	IF GET_ABL("奉仕精神", ARG) > 2
		RESULTS += @"%CALLNAME:(ARG:1)%は%CALLNAME:(ARG)%が達しそうになったのを見てとると"
		RESULTS += "_いまにも出してしまいそうなのを堪えて、一層激しく腰をうちつけた"
		RESULTS += @"_そして%CALLNAME:(ARG:1)%が絶頂に達すると同時に、精液を膣内へと注ぎ込んだ……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"体の力が抜けた%CALLNAME:ARG%は%CALLNAME:(ARG:1)%にしなだれかかり、_そのまま二人で抱き合って絶頂の余韻に浸った……"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は達しそうになると一層激しく腰をうちつけてきた"
		RESULTS += @"_そして、そのまま絶頂し、体を震わせる%CALLNAME:(ARG:1)%の膣内に精液を注ぎ込んだ……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"力が抜けた%CALLNAME:ARG%は%CALLNAME:(ARG:1)%に上に倒れかかって荒く息をついている……"
	ENDIF
ENDIF

@MESSAGE_ORGASM_P_141, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG, "Ｐ")
	IF GET_ABL("奉仕精神", ARG) > 2
		RESULTS += @"%CALLNAME:(ARG:1)%はいまにも出してしまいそうなのを堪えて腰を打ち付けていたが、"
		RESULTS += "_ついに我慢しきれずに%CALLNAME:ARG%の膣内に精液を吐き出してしまった…"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"体の力が抜け、しなだれかかってくる%CALLNAME:ARG%を%CALLNAME:(ARG:1)%は優しく抱きとめた……"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は達しそうになると一層激しく腰をうちつけてきた"
		RESULTS += @"_そして、そのまま絶頂し、%CALLNAME:(ARG:1)%の膣内に精液を注ぎ込んだ……"
	ENDIF
ENDIF

@MESSAGE_ORGASM_T_141, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｖ")
	IF GET_ABL("奉仕精神", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%が絶頂に達しそうなのを見て取ると腰使いを激しくした"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"%CALLNAME:(ARG:1)%は全身を震わせて絶頂に達した。"
		RESULTS += @"_%CALLNAME:ARG%は自分の下でぐったりと脱力している%CALLNAME:(ARG:1)%を愛おしそうに眺めている……"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は背中を大きく反らしながら、全身を震わせて絶頂に達した"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"%CALLNAME:ARG%がは自分の下でぐったりと脱力している%CALLNAME:(ARG:1)%を満足そうに見下ろしている……"
	ENDIF
ENDIF
@MESSAGE_NONE_ORGASM_141, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｃ + PALAM:ARG:快Ｃ / 10 + GET_ABL("Ｃ感覚", ARG) * 100
	CASE IS > 5000
		SELECTCASE 反感レベル(ARG)
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は強い快感に我を忘れて腰を動かしている……"
			CASEELSE
				IF GET_ABL("奉仕精神", ARG) > 2
					RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%が乱れる姿に夢中になって腰をふっている……"
				ELSE
					RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の膣がもたらす快楽に夢中になって腰をふっている……"
				ENDIF
		ENDSELECT
	CASE IS > 2000
		SELECTCASE 反感レベル(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は嬌声があがりそうになるのを押し殺して、_"
				RESULTS += @"顔を逸らして行為が終わるのを待っている…"
			CASEELSE
				IF GET_ABL("奉仕精神", ARG) > 2
					RESULTS += @"%CALLNAME:ARG%は甘い声をあげ、腰をくねらせる%CALLNAME:(ARG:1)%の様子を見ながら_"
					RESULTS += "より激しく乱れさせるられるよう腰を使っている……"
				ELSE
					RESULTS += @"%CALLNAME:ARG%は気持ちよさそうな表情で%CALLNAME:(ARG:1)%の顔を見つめながら、快感を堪能している…"
				ENDIF
		ENDSELECT
	CASEELSE
		SELECTCASE 反感レベル(ARG)
			CASE IS >= 2
				RESULTS += @"%CALLNAME:ARG%は気持ち悪そうに行為を続けている……"
			CASE 1
				RESULTS += @"%CALLNAME:ARG%は不可解な面持ちでおそるおそる腰を動かしている……"
			CASEELSE
				RESULTS += @"ぎこちない動きで%CALLNAME:(ARG:1)%の様子を伺いながら腰を動かしている……"
		ENDSELECT
ENDSELECT
