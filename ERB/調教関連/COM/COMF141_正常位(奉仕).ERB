		RESULTS += "_强忍着射精的冲动，腰动得更厉害了"
		RESULTS += @"_随后%CALLNAME:(ARG:1)%在迎来高潮的同时，将精液注入对方阴道内……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"精疲力竭的%CALLNAME:ARG%瘫软在%CALLNAME:(ARG:1)%身上，_两人就这样拥抱在一起，沉浸于高潮的余韵……"
	ELSE
		RESULTS += @"%CALLNAME:ARG%即将抵达时，被对方腰部更加激烈地冲撞"
		RESULTS += @"_然后就那样高潮，被颤动着的%CALLNAME:(ARG:1)%抵住阴道注入精液……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"精疲力竭的%CALLNAME:ARG%倒在%CALLNAME:(ARG:1)%身上，粗重地喘息着……"
	ENDIF
ENDIF

