;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_141, ARG, ARG:1, ARG:2
#LOCALSSIZE 2
RESULTS = 
;前回と今回の调教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("调教者", TFLAG:当前回合 - 1) == ARG && TCVAR:ARG:插入继续
	IF IS_PREVCOM("正常位(侍奉)")
		RESULTS += @"%CALLNAME:(ARG:1)%命令%CALLNAME:ARG%，保持这样继续抽送着"
	ELSE
		RESULTS +=  @"并没有抽出阴道，而是仰面躺下，命令%CALLNAME:ARG%继续耸动腰身"
	ENDIF
	IF GET_ABL("欲望", ARG:1) > 3 && 欲情等级(ARG:1) > 4
		IF GET_ABL("Ｃ感觉", ARG:1) < 3
			RESULTS += @"_%CALLNAME:ARG%陶醉地摆动着腰肢……"
		ELSE
			RESULTS += @"_%CALLNAME:ARG%听到命令，腰动得比刚才更厉害了……"
		ENDIF
	ELSE
		RESULTS += "……"
	ENDIF
ELSE
	LOCALS = 
	;处女
	IF GET_TALENT("处女", ARG:1)
		LOCALS += "未曾让男人进入的"
	;润滑LV4以上
	ELSEIF 润滑等级(ARG:1) > 3
		LOCALS += "湿漉漉的"
	ENDIF
	IF GET_TALENT("娇小", ARG:1)
		LOCALS += "可爱小穴"
	ELSE
		LOCALS += "秘隙"
	ENDIF
	SELECTCASE 欲情等级(ARG)
		CASE IS >= 5
			LOCALS:1 = 膨胀到极限的阴茎
		CASE IS > 2
			LOCALS:1 = 坚挺勃起的阴茎
		CASEELSE
			LOCALS:1 = %CALLNAME:ARG%的肉棒
	ENDSELECT
	IF GET_ABL("侍奉精神", ARG) > 1
		RESULTS += @"%CALLNAME:(ARG:1)%在%CALLNAME:ARG%面前大幅张开双腿_"
		RESULTS += @"用自己%LOCALS%接纳了%LOCALS:1%……"
	ELSE
		RESULTS += @"%CALLNAME:(ARG:1)%躺下张开双腿，命令%CALLNAME:ARG%贯穿%LOCALS%"
	ENDIF
ENDIF
;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_REACT_S_141, ARG, ARG:1, ARG:2
IF TCVAR:(ARG:1):丧失童贞
	IF GET_ABL("侍奉精神", ARG) > 1
		RESULTS += @"%CALLNAME:ARG%安慰着因痛楚而颤抖的%CALLNAME:(ARG:1)%，缓缓摆动腰肢……"
	ELSEIF GET_ABL("欲望", ARG) > 3
		RESULTS += @"%CALLNAME:ARG%困惑于%CALLNAME:(ARG:1)%痛苦的神情，却没有停下腰间的动作……"
	ELSE
		RESULTS += @"%CALLNAME:ARG%困惑于%CALLNAME:(ARG:1)%痛苦的神情，但在%CALLNAME:(ARG:1)%的支持下继续摆动着腰身……"
	ENDIF
ENDIF
IF TCVAR:ARG:初阴道射精
	IF CFLAG:ARG:独特 == 0
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%因初次被阴道射精而涌现出不可思议的幸福感，脸上不自觉地绽开了笑容……"
		ELSE
			RESULTS += @"%CALLNAME:ARG%无法理解初次被阴道射精而涌现的感情，脸上显露着迷茫……"
		ENDIF
	ELSE
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%因初次被阴道射精而十分感动，紧紧地抱住%CALLNAME:(ARG:1)%……"
		ELSE
			RESULTS += @"%CALLNAME:ARG%第一次被注入阴道，不安地望向%CALLNAME:(ARG:1)%的脸……"
		ENDIF
	ENDIF
ENDIF
;同時絶頂
@MESSAGE_ORGASM_TOGETHER_141, ARG, ARG:1, ARG:2
