CALL ADD_COM_ORDER, "TALENT", "清純", -2, ARG, ARG:1
SIF 欲情レベル(ARG) > 0
	CALL ADD_COM_ORDER, "EXTRA", "欲情", 欲情レベル(ARG) * 4, ARG, ARG:1
