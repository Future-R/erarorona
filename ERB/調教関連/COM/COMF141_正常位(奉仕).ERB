@MESSAGE_NONE_ORGASM_141, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｃ + PALAM:ARG:快Ｃ / 10 + GET_ABL("Ｃ感觉", ARG) * 100
	CASE IS > 5000
		SELECTCASE 反感等级(ARG)
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%因强烈的快感而忘我地扭动着腰肢……"
			CASEELSE
				IF GET_ABL("侍奉精神", ARG) > 2
					RESULTS += @"%CALLNAME:ARG%沉醉于%CALLNAME:(ARG:1)%激烈的动作，自己也摇动起腰肢……"
				ELSE
					RESULTS += @"%CALLNAME:ARG%沉醉于%CALLNAME:(ARG:1)%为阴道带来的快感，自己也摇动起腰肢……"
				ENDIF
		ENDSELECT
	CASE IS > 2000
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%忍耐着发出呻吟的冲动，_"
				RESULTS += @"将脸别开，等待着行为的结束……"
			CASEELSE
				IF GET_ABL("侍奉精神", ARG) > 2
					RESULTS += @"%CALLNAME:ARG%发出甘美的声息，扭动着腰肢，望向%CALLNAME:(ARG:1)%……"
					RESULTS += "为了追求更加激烈的快感，加快了腰间的动作……"
				ELSE
					RESULTS += @"%CALLNAME:ARG%表情愉快，一边看着%CALLNAME:(ARG:1)%的脸，一边享受着快感……"
				ENDIF
		ENDSELECT
	CASEELSE
		SELECTCASE 反感等级(ARG)
			CASE IS >= 2
				RESULTS += @"%CALLNAME:ARG%持续着令自己感到恶心的行为……"
			CASE 1
				RESULTS += @"%CALLNAME:ARG%露出无法理解对方的表情，战战兢兢地扭动起腰肢……"
			CASEELSE
				RESULTS += @"在观察%CALLNAME:(ARG:1)%情况的同时，笨拙地扭动着腰肢……"
		ENDSELECT
ENDSELECT
