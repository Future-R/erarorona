;-------------------------------------------------
;乳交
;-------------------------------------------------
@COM_NAME_14
RESULTS = 乳交

@COM_DOWNBASE_14
RETURN 80, 200

@COM_LEARN_14, ARG
#FUNCTION
RESULTS = 口活经验 1000/手活经验 1000/性交经验 500/Ｂ经验　 1000
RESULT = 1
SIF EXP:ARG:口活经验 < 1000
	RESULT = 0
SIF EXP:ARG:手活经验 < 1000
	RESULT = 0
SIF EXP:ARG:性交经验 < 500
	RESULT = 0
SIF EXP:ARG:Ｂ经验 < 1000
	RESULT = 0
RETURNF RESULT

@COM_ABLE_14, ARG, ARG:1, ARG:2
RESULTS = 调教者的胸可以使用/调教者的手可以使用/调教对象的阴茎可以使用
SIF !USE_BUST(ARG:1)
	RETURN 0
SIF !USE_HAND(ARG:1)
	RETURN 0
SIF !USE_PENIS(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_14
RESULTS = 对Ｃ快感(大)/受到Ｂ快感(中)

@COM_PROPERTY_14
RESULTS = 爱抚/其它性技

@COM_SOURCE_14, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN 500
	CASE "快Ｂ"
		RETURN 0, 200
	CASE "露出"
		RETURN 120
	CASE "逃脱"
		RETURN 150
	CASE "反感"
		RETURN 200
	CASEELSE
		RETURN 0
ENDSELECT
@COM_ACT_14, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_14, ARG, ARG:1, ARG:2
;贫乳
IF TALENT:(ARG:1):贫乳
	RESULTS = 用小小的胸部磨蹭着%CALLNAME:TARGET%的阴茎，将龟头抵在未成熟的酥胸上，与乳尖紧贴着相互给予刺激
;巨乳
ELSEIF TALENT:(ARG:1):巨乳
	RESULTS = 将%CALLNAME:TARGET%的阴茎包裹在丰满的胸部之中，随着两团乳肉的来回跳动，挺立的阴茎在绵密而散发着馨香的乳沟中冲刺着
ELSE
	RESULTS = %CALLNAME:TARGET%的阴茎被%CALLNAME:PLAYER%用胸部夹在其中，饱满挺拔的美乳从两侧挤压过来，上下搓动着摩擦起中间炽热的肉杆
ENDIF
RESULTS += "……"
@MESSAGE_ORGASM_T_14, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG, "Ｐ")
		RESULTS += @"%CALLNAME:TARGET%的阴茎在胸部间猛然颤抖起来，膨胀到极点的龟头猝不及防地将精液射在%CALLNAME:PLAYER%的脸上。"
		RESULTS += @"_随后更多的白浊液溢流而出，在%CALLNAME:PLAYER%雪白的胸前打上一片片粘稠的污渍……"
ENDIF
@COM_TOUCH_14
RESULTS = 阴茎/胸

@COM_STAIN_14

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_14, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT

