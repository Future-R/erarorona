@COM_ACT_16, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_16, ARG, ARG:1, ARG:2
RESULTS = %CALLNAME:(ARG:1)%は%CALLNAME:(ARG)%を押し倒し、%CALLNAME:(ARG)%の性器に自分の性器を擦りつけた。
IF GET_ABL("欲望", ARG) > 2
	RESULTS += @"_%CALLNAME:(ARG)%も、%CALLNAME:(ARG:1)%に抱きつき、腰を動かし、快楽を貪っている…"
ELSEIF GET_ABL("服从", ARG) > 2
	RESULTS += @"_%CALLNAME:(ARG)%は嬉しそうに%CALLNAME:(ARG:1)%の行為を受け入れている…"
ENDIF

