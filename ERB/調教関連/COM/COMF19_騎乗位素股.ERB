@COM_NAME_19
RESULTS = 骑乘位股间性交

@COM_DOWNBASE_19
RETURN 80, 80

@COM_IS_JUMP_19
RESULTS = 调教者没有阴茎/调教对象拥有阴茎
RETURN GET_NO("指令", "磨豆腐")

@COM_LEARN_19, ARG
#FUNCTION
RESULT = 2
RETURNF 1

@COM_ABLE_19, ARG, ARG:1, ARG:2
RESULTS = 调教者的腰可以使用/调教对象的阴茎可以使用/调教者已充分润滑
SIF !USE_WAIST(ARG:1)
	RETURN 0
SIF !USE_PENIS(ARG)
	RETURN 0
SIF 润滑等级(ARG:1) < 3
	RETURN 0
RETURN 1

@COM_EFFECT_19
RESULTS = 对Ｃ快感(小)/受到Ｃ快感(小)

@COM_PROPERTY_19
RESULTS = 性交

@COM_SOURCE_19, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｃ"
		RETURN 200, 200
	CASE "露出"
		RETURN 120
	CASE "逃脱"
		RETURN 300
	CASE "耻情"
		RETURN 100
	CASE "反感"
		RETURN 200
	CASEELSE
		RETURN 0
ENDSELECT
@COM_ACT_19, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_19, ARG, ARG:1, ARG:2
RESULTS '= @"%CALLNAME:(ARG:1)%"
IF 反感等级(ARG) > 2
	RESULTS += @"因生气而浑身颤抖，在俯视着%CALLNAME:(ARG)%的同时，将对方"
ELSEIF 欲情等级(ARG) >= 3
	RESULTS += @"脸上浮现出仿佛要融化般的表情，在俯视着%CALLNAME:(ARG)%的同时，将对方"
ELSEIF 反感等级(ARG)
	RESULTS += @"因羞耻而别过脸，然后在俯视着%CALLNAME:(ARG)%的同时，将对方"
ELSE
	RESULTS += @"将%CALLNAME:(ARG)%的"
ENDIF
RESULTS += "阴茎用大腿夹起，摩擦着自己的阴唇……"

@COM_TOUCH_19
RESULTS = 阴茎/阴道

@COM_STAIN_19

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_19, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT

