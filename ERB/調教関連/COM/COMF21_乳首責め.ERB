@COM_NAME_21
RESULTS = 玩弄乳头

@COM_DOWNBASE_21
RETURN 50, 80

@COM_LEARN_21, ARG
#FUNCTION
RESULTS = 手活经验 200/Ｂ经验　 200
RESULT = 1
SIF EXP:ARG:手活经验 < 200
	RESULT = 0
SIF EXP:ARG:Ｂ经验 < 200
	RESULT = 0
RETURNF RESULT

@COM_ABLE_21, ARG, ARG:1, ARG:2
RESULTS = 调教者的手可以使用/调教对象的胸可以使用
; SIF IS_MALE(ARG)
; 	RETURN 0
SIF !USE_HAND(ARG:1)
	RETURN 0
SIF !USE_BUST(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_21
RESULTS = 对Ｂ快感(中)

@COM_PROPERTY_21
RESULTS = 爱抚/手活

@COM_SOURCE_21, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｂ"
		RETURN 240
	CASE "露出"
		RETURN 40
	CASE "反感"
		RETURN 120
	CASEELSE
		RETURN 0
ENDSELECT
@COM_ACT_21, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_21, ARG, ARG:1, ARG:2
RESULTS '= @"%CALLNAME:ARG%"
IF GET_TALENT("贫乳", ARG)
	IF GET_TALENT("娇小", ARG)
		RESULTS += "只能感受到些许鼓起的"
	ELSE
		RESULTS += "小小的"
	ENDIF
ENDIF

IF GET_TALENT("巨乳", ARG)
	IF GET_TALENT("高挑", ARG)
		RESULTS += "一只手把握不住的"
	ELSE
		RESULTS += "会从手掌间满溢而出的"
	ENDIF
ENDIF
IF 欲情等级(ARG) > 3
	RESULTS += "胸部的顶端，已经完全变硬的突起被揉捏着……"
ELSE
	RESULTS += "胸部的顶端，仍然柔软的突起被揉捏着……"
ENDIF

@COM_TOUCH_21
RESULTS = 胸/手

@COM_STAIN_21, ARG, ARG:1

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_21, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT
