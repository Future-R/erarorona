@COM_NAME_21
RESULTS = 玩弄乳头

@COM_DOWNBASE_21
RETURN 50, 80

@COM_LEARN_21, ARG
#FUNCTION
RESULTS = 手活经验 200/Ｂ经验　 200
SIF EXP:ARG:手活经验 < 200
	RESULT = 0
SIF EXP:ARG:Ｂ经验 < 200
	RESULT = 0
RETURNF RESULT

@COM_ABLE_21, ARG, ARG:1, ARG:2
RESULTS = 調教者が手を使用可能/調教対象の胸を使用可能/調教対象が女
SIF IS_MALE(ARG)
	RETURN 0
SIF !USE_HAND(ARG:1)
	RETURN 0
SIF !USE_BUST(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_21
RESULTS = Ｂに快感(中)

@COM_PROPERTY_21
RESULTS = 爱抚/手活

@COM_SOURCE_21, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｂ"
		RETURN 240
	CASE "露出"
		RETURN 40
	CASE "反感"
		RETURN 120
	CASEELSE
		RETURN 0
ENDSELECT
@COM_ACT_21, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_21, ARG, ARG:1, ARG:2
RESULTS = %CALLNAME:ARG%の
IF GET_TALENT("贫乳", ARG)
	IF GET_TALENT("娇小", ARG)
		RESULTS += "僅かに膨らみが感じられる程度の"
	ELSE
		RESULTS += "小振りの"
	ENDIF
ENDIF

IF GET_TALENT("巨乳", ARG)
	IF GET_TALENT("高挑", ARG)
		RESULTS += "手に余るほど大きな"
	ELSE
		RESULTS += "手から溢れそうなほどの"
	ENDIF
ENDIF
IF 欲情等级(ARG) > 3
	RESULTS += "胸の先端の、すっかり硬くなった突起をつまみあげた……"
ELSE
	RESULTS += "胸の先端の、まだ柔らかい突起をつまみあげた……"
ENDIF

@COM_TOUCH_21
RESULTS = 胸/手

@COM_STAIN_21, ARG, ARG:1

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_21, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT
