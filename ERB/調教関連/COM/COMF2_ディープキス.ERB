@MESSAGE_COM_2, ARG, ARG:1, ARG:2
SELECTCASE 反感レベル(ARG)
	CASE IS >= 3
		RESULTS = 抵抗する%CALLNAME:ARG%の口を無理やりこじ開けて、口腔内を蹂躙した……
	CASE 2
		RESULTS = 嫌がる%CALLNAME:ARG%を抱き寄せ、その舌を貪るように味わった……
	CASE 1
		RESULTS = %CALLNAME:ARG%の口腔に舌をさしいれ、お互いに舌を絡ませあった……
	CASEELSE
		RESULTS = 口腔に差しいれられた舌に激しく舌を絡ませてくる%CALLNAME:ARG%とお互いを貪りあった……
