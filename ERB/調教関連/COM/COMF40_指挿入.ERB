;-------------------------------------------------
;插入手指
;-------------------------------------------------
@COM_NAME_40
RESULTS = 插入手指

@COM_DOWNBASE_40
RETURN 60, 30

@COM_LEARN_40, ARG
#FUNCTION
RESULTS = 手活经验 50/Ｖ经验　 10
RESULT = 1
SIF EXP:(ARG:1):手活经验 < 50
	RESULT = 0
SIF EXP:(ARG:1):Ｖ经验 < 10
	RESULT = 0
RETURNF RESULT

@COM_ABLE_40, ARG, ARG:1, ARG:2
RESULTS = 调教者的手可以使用/调教对象的阴道可以使用
SIF !USE_HAND(ARG:1)
	RETURN 0
SIF !USE_VAGINA(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_40
RESULTS = 对Ｖ快感(小)

@COM_PROPERTY_40
RESULTS = 爱抚/手活

@COM_SOURCE_40, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ｖ"
		RETURN 120
	CASE "露出"
		RETURN 20
	CASE "逃脱"
		RETURN 100
	CASE "Ｖ疼痛"
		RETURN 100
	CASE "反感"
		RETURN 200
	CASEELSE
		RETURN 0
ENDSELECT
@COM_INSERT_40, ARG, ARG:1, ARG:2
RESULTS = Ｖ
RESULTS:1 = %CALLNAME:(ARG:1)%的手指
RETURN ARG

@COM_ACT_40, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_40, ARG, ARG:1, ARG:2
#LOCALSSIZE 1
RESULTS = 
IF TCVAR:ARG:丧失童贞
	RESULTS += "未尝禁果的"
ELSEIF 润滑等级(ARG) >= 4
	RESULTS += "湿漉漉的"
ENDIF
IF GET_TALENT("娇小", ARG)
	RESULTS += "可爱小穴"
ELSE
	RESULTS += "秘隙"
ENDIF
RESULTS += @"被%CALLNAME:(ARG:1)%的手指缓缓插入了……"

@MESSAGE_ORGASM_T_40, ARG, ARG:1, ARG:2
RESULTS = %CALLNAME:ARG%用阴道紧紧箍住%CALLNAME:(ARG:1)%的手指，发出高亢的呻吟，迎来了高潮……

@MESSAGE_NONE_ORGASM_40, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ / 10 + GET_ABL("Ｖ感觉", ARG) * 100
	CASE IS > 3000
		IF HAVE_BODY("阴茎", ARG:1) && GET_ABL("性交成瘾", ARG) > 1
			RESULTS = %CALLNAME:ARG%在为阴道内窜动的快感而激烈扭动身躯的同时，将%CALLNAME:(ARG:1)%的手指紧紧缠住……
		ELSE
			RESULTS = 每当%CALLNAME:(ARG:1)%抠弄阴道壁，%CALLNAME:ARG%都会发出呻吟，扭动起身体……
		ENDIF
	CASE IS > 500
		IF HAVE_BODY("阴茎", ARG:1) && GET_ABL("性交成瘾", ARG) > 1
			RESULTS = %CALLNAME:ARG%一边在为阴道壁内摩擦的触感而艰难地喘息着_
			RESULTS = 一边在用渴求的目光望向%CALLNAME:(ARG:1)%……
		ELSE
			RESULTS = %CALLNAME:ARG%感受着阴道壁内摩擦的触感，艰难地喘息着……
		ENDIF
ENDSELECT

@COM_TOUCH_40
RESULTS = 阴道/手

@COM_STAIN_40

