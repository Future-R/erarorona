@COM_ACT_40, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_40, ARG, ARG:1, ARG:2
#LOCALSSIZE 1
RESULTS = 
IF TCVAR:ARG:失去处子之身
	RESULTS += "男を知らない"
ELSEIF 润滑等级(ARG) >= 4
	RESULTS += "濡れそぼった"
ENDIF
IF GET_TALENT("娇小", ARG)
	RESULTS += "幼いワレメ"
ELSE
	RESULTS += "秘裂"
ENDIF
RESULTS += "に指をゆっくりと挿入した……"

@MESSAGE_ORGASM_T_40, ARG, ARG:1, ARG:2
RESULTS = %CALLNAME:ARG%は膣で%CALLNAME:(ARG:1)%の指をぎゅっと締め付けながら嬌声をあげ、絶頂を迎えた……

@MESSAGE_NONE_ORGASM_40, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ / 10 + GET_ABL("Ｖ感觉", ARG) * 100
	CASE IS > 3000
		IF HAVE_BODY("阴茎", ARG:1) && GET_ABL("性交成瘾", ARG) > 1
			RESULTS = %CALLNAME:ARG%は膣内で蠢く快感に体を激しくくねらせながらも、%CALLNAME:(ARG:1)%のペニスをねだってきた……
		ELSE
			RESULTS = %CALLNAME:(ARG:1)%が膣壁をなぞってやるたびに、%CALLNAME:ARG%は嬌声をあげ体をくねらせている……
		ENDIF
	CASE IS > 500
		IF HAVE_BODY("阴茎", ARG:1) && GET_ABL("性交成瘾", ARG) > 1
			RESULTS = %CALLNAME:ARG%は膣壁を擦られる感覚に切なそうに吐息をつきながら_
			RESULTS = 物欲しげな目付きで%CALLNAME:(ARG:1)%を見つめている…
		ELSE
			RESULTS = %CALLNAME:ARG%は膣壁を擦られる感覚に切なそうに吐息をついている……
		ENDIF
ENDSELECT

