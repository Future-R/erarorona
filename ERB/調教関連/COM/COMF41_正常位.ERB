		RESULTS += @"_そして、そのまま%CALLNAME:(ARG:1)%に膣内に射精され、恍惚とした表情を浮かべ絶頂に達した…"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"%CALLNAME:(ARG:1)%を抱きしめたまま快感の余韻に浸っていた%CALLNAME:ARG%からペニスを引き抜くと"
	ELSE
		RESULTS += @"快感に身を悶えさせる%CALLNAME:ARG%にしっかりとペニスをつきこんで射精した"
		RESULTS += @"_%CALLNAME:ARG%は膣内に精液の感触を感じながら、体を震わせ、絶頂を迎えた…"
		RESULTS += @"_%TEXTTAG("w")%_"
