@MESSAGE_COM_41, ARG, ARG:1, ARG:2
RESULTS = 
;前回と今回の調教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("調教者", TFLAG:現ターン - 1) == ARG:1 && TCVAR:(ARG:1):挿入継続
	IF IS_PREVCOM("正常位")
		RESULTS += @"%CALLNAME:ARG%の膣内の感触を味わいながら、再び腰を動かし始めた"
	ELSE
		RESULTS +=  @"膣内から抜き去ることなく%CALLNAME:ARG%を仰向けに寝かせ、再び腰を動かし始めた"
	ENDIF
	RESULTS += "……"
ELSE
	RESULTS += @"%CALLNAME:ARG%の"
	;処女
	IF GET_TALENT("処女", ARG)
		RESULTS += "男を知らない"
	;潤滑LV4以上
	ELSEIF 潤滑レベル(ARG) > 3
		RESULTS += "濡れそぼった"
	ENDIF
	IF GET_TALENT("小柄", ARG)
		RESULTS += "幼いワレメを"
	ELSE
		RESULTS += "秘裂を"
	ENDIF
	IF GET_ABL("欲望", ARG) > 3 && 欲情レベル(ARG) > 4
		RESULTS += "貫いた"
		SIF GET_ABL("Ｖ感覚", ARG) > 2
			RESULTS += @"_%CALLNAME:ARG%は%CALLNAME:(ARG:1)%に足を絡め腰を押し付けてきた……"
	ELSE
		RESULTS += "貫いた……"
	ENDIF
ENDIF
