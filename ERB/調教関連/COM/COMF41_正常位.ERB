@MESSAGE_COM_41, ARG, ARG:1, ARG:2
RESULTS = 
;前回と今回の調教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("调教者", TFLAG:当前回合 - 1) == ARG:1 && TCVAR:(ARG:1):插入继续
	IF IS_PREVCOM("正常位")
		RESULTS += @"品味着%CALLNAME:ARG%阴道触感的同时，再次开始摆动起腰肢"
	ELSE
		RESULTS +=  @"膣内から抜き去ることなく%CALLNAME:ARG%を仰向けに寝かせ、再び腰を動かし始めた"
	ENDIF
	RESULTS += "……"
ELSE
	RESULTS += @"%CALLNAME:ARG%的"
	;处女
	IF GET_TALENT("处女", ARG)
		RESULTS += "未体会过男人滋味的"
	;润滑LV4以上
	ELSEIF 润滑等级(ARG) > 3
		RESULTS += "湿漉漉的"
	ENDIF
	IF GET_TALENT("娇小", ARG)
		RESULTS += "幼いワレメを"
	ELSE
		RESULTS += "秘裂を"
	ENDIF
	IF GET_ABL("欲望", ARG) > 3 && 欲情等级(ARG) > 4
		RESULTS += "貫いた"
		SIF GET_ABL("Ｖ感觉", ARG) > 2
			RESULTS += @"_%CALLNAME:ARG%は%CALLNAME:(ARG:1)%に足を絡め腰を押し付けてきた……"
	ELSE
		RESULTS += "貫いた……"
	ENDIF
ENDIF
