@MESSAGE_REACT_S_41, ARG, ARG:1, ARG:2
IF TCVAR:ARG:処女喪失
	SELECTCASE MAX(MARK:ARG:反発刻印, TCVAR:ARG:獲得反発刻印)
		CASE 0
			RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の手をしっかりと握り、体全体に走る激痛に耐えている…"
		CASE 1
			RESULTS += @"%CALLNAME:ARG%は苦痛に目を潤ませて、%CALLNAME:(ARG:1)%の顔を見つめている…"
		CASE 2
			RESULTS += @"%CALLNAME:ARG%は苦痛に顔を歪ませながらも、恨みがこもった目で%CALLNAME:(ARG:1)%の顔を見つめている…"
		CASE 3
			RESULTS += @"%CALLNAME:(ARG:1)%は激痛に叫び声をあげ、暴れようとする%CALLNAME:ARG%を組み伏せ、抽送を続けた…"
	ENDSELECT
ENDIF
IF TCVAR:ARG:初被膣内射精
	IF CFLAG:ARG:ユニーク == 0
		IF GET_ABL("奉仕精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めて膣内に精子をうけ、その暖かい感触に驚いたものの、_"
			RESULTS += @"%CALLNAME:(ARG:1)%の満足気な様子をみて落ち着いて微笑んでいる"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めて膣内に精子をうけ、その暖かい感触に目を白黒させている。"
		ENDIF
	ELSE
		IF GET_ABL("奉仕精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、感極まったという様子で%CALLNAME:(ARG:1)%に抱きついてきた…"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、不安そうな表情を浮かべて、%CALLNAME:(ARG:1)%をじっと見つめている…"
		ENDIF
	ENDIF
ENDIF
IF TCVAR:ARG:初Ｖ絶頂
	IF GET_ABL("従順", ARG) > 3
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%をきつく抱きしめながら全身を震わせて絶頂に達した_"
		RESULTS += @"そして、そのまま%CALLNAME:(ARG:1)%の腕の中で性交による絶頂から来る幸福感に浸っている…"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は全身を震わせて絶頂に達した"
		RESULTS += @"初めての感覚の余韻に戸惑いながら、%CALLNAME:(ARG:1)%をぼんやりと見つめている…"
	ENDIF
ENDIF
;同時絶頂
@MESSAGE_ORGASM_TOGETHER_41, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG, "Ｖ") && IS_ORGASM(ARG:1, "Ｐ")
	IF GET_ABL("精液中毒", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は達しそうになると%CALLNAME:(ARG:1)%の腰を足で挟んでしっかり固定してきた"
		RESULTS += @"_そして%CALLNAME:(ARG:1)%の精液を搾り取ると、そのまま自分も体を震わせて絶頂を迎えた…"
		RESULTS += @"_%TEXTTAG("w")%_"
