@MESSAGE_REACT_S_41, ARG, ARG:1, ARG:2
IF TCVAR:ARG:丧失童贞
	SELECTCASE MAX(MARK:ARG:抗拒烙印, TCVAR:ARG:获得抗拒烙印)
		CASE 0
			RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の手をしっかりと握り、体全体に走る激痛に耐えている…"
		CASE 1
			RESULTS += @"%CALLNAME:ARG%は苦痛に目を潤ませて、%CALLNAME:(ARG:1)%の顔を見つめている…"
		CASE 2
			RESULTS += @"%CALLNAME:ARG%は苦痛に顔を歪ませながらも、恨みがこもった目で%CALLNAME:(ARG:1)%の顔を見つめている…"
		CASE 3
			RESULTS += @"%CALLNAME:(ARG:1)%压制住因剧痛而叫出声来，变得激动的%CALLNAME:ARG%，继续在对方体内抽送着……"
	ENDSELECT
ENDIF
IF TCVAR:ARG:初被阴道射精
	IF CFLAG:ARG:独特 == 0
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%初次被精子注入阴道，被其灼热的触感吓了一跳，_"
