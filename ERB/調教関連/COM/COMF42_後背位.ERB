	RESULTS += @"将因快感而扭动身体的%CALLNAME:ARG%体内用阴茎紧紧抵住，射出了精液……"
	RESULTS += @"_%CALLNAME:ARG%感受到阴道内精液的触感，身体颤抖着迎来了高潮……"
	RESULTS += @"_%TEXTTAG("w")%_"
	RESULTS += @"从喘着粗气的%CALLNAME:ARG%体内抽出阴茎"
	RESULTS +=@"_对方的秘隙里流出了"
	SIF TCVAR:ARG:丧失童贞_本次
