			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%因抽送着的异物感_"
				RESULTS += @"将脸贴伏在床上，等待着行为的结束……"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%因抽送着的异物感而痛苦，看起来很难受……"
			CASEELSE
				RESULTS += @"未习惯性交的%CALLNAME:ARG%眼眶湿润_"
				RESULTS += @"但还是勇敢地接受了%CALLNAME:(ARG:1)%的行为……"
		ENDSELECT
