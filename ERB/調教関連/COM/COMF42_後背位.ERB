		RESULTS += @"_%CALLNAME:(ARG:1)%也将阴茎用力撞入，在最深处注入了精液……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"从表情陶醉、喘息着的%CALLNAME:ARG%体内抽出了阴茎"
