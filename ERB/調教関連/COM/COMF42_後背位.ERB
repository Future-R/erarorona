;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_42, ARG, ARG:1, ARG:2
RESULTS = 
;前回と今回の調教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("調教者", TFLAG:当前回合 - 1) == ARG:1 && TCVAR:(ARG:1):插入继续 && PREVCOM >= 0
	SELECTCASE GET_NAME("指令", PREVCOM)
		CASE "后背位"
			RESULTS += @"%CALLNAME:ARG%の膣内の感触を味わいながら、再び腰を動かし始めた"
		CASE "正常位"
			RESULTS += @"膣内から抜き去ることなく%CALLNAME:ARG%の後ろに回り、再び腰を動かし始めた"
		CASEELSE
			RESULTS += @"挿入したまま%CALLNAME:ARG%を寝かせて四つん這いにし、再び腰を動かし始めた……"
	ENDSELECT
ELSE
	IF GET_ABL("欲望", ARG) > 3 && 欲情等级(ARG) > 4 && GET_ABL("Ｖ感觉", ARG) >= 3
		RESULTS += @"四つん這いになり、誘うように尻を振る%CALLNAME:ARG%の"
	ELSE
		RESULTS += @"後ろから%CALLNAME:ARG%の"
	ENDIF
	;处女
	IF GET_TALENT("处女", ARG)
		RESULTS += "男を知らない"
	;润滑LV4以上
	ELSEIF 润滑等级(ARG) > 3
		RESULTS += "濡れそぼった"
	ENDIF
	IF GET_TALENT("娇小", ARG)
		RESULTS += "幼いワレメ"
	ELSE
		RESULTS += "秘裂"
	ENDIF
	RESULTS += "の最奥まで一気に突き入れた……"
ENDIF
;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_REACT_S_42, ARG, ARG:1, ARG:2
IF TCVAR:ARG:失去处子之身
	SELECTCASE MAX(MARK:ARG:抗拒烙印, TCVAR:ARG:获得抗拒烙印)
		CASE 0
			RESULTS += @"%CALLNAME:ARG%は歯を食いしばり、うめき声を漏らさないように破瓜の疼痛に必死に耐えている…"
		CASE 1
			RESULTS += @"%CALLNAME:ARG%は破瓜の疼痛に悲鳴をあげた…"
		CASE 2
			RESULTS += @"%CALLNAME:(ARG:1)%は逃げようとする%CALLNAME:ARG%を押さえつけ、抽送を続けた…"
		CASE 3
			RESULTS += @"%CALLNAME:(ARG:1)%は激痛に叫び声をあげ、暴れようとする%CALLNAME:ARG%を押さえつけ、抽送を続けた…"
	ENDSELECT
ENDIF
IF TCVAR:ARG:初被阴道射精
	IF CFLAG:ARG:独特 == 0
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めて膣内に精子をうけ、その暖かい感触に驚いたものの、_"
			RESULTS += @"振り返って%CALLNAME:(ARG:1)%の満足気な様子をみて落ち着いて微笑んでいる"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めて膣内に精子をうけ、その暖かい感触に目を白黒させている。"
		ENDIF
	ELSE
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、嬉しそうに顔を綻ばせている…"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、不安そうな表情を浮かべている…"
		ENDIF
	ENDIF
ENDIF
IF TCVAR:ARG:初Ｖ高潮
	IF GET_ABL("服从", ARG) > 3
		RESULTS += @"%CALLNAME:ARG%は全身を震わせて絶頂に達した_"
		RESULTS += @"そして、倒れ込んで絶頂から来る幸福感に浸っている…"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は全身を震わせて絶頂に達した"
		RESULTS += @"そして、初めての感覚の余韻に戸惑いながら、荒く息を吐いている…"
	ENDIF
ENDIF
;同時絶頂
@MESSAGE_ORGASM_TOGETHER_42, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG, "Ｖ") && IS_ORGASM(ARG:1, "Ｐ")
	RESULTS += @"快感に身を悶えさせる%CALLNAME:ARG%にしっかりとペニスをつきこんで射精した"
	RESULTS += @"_%CALLNAME:ARG%は膣内に精液の感触を感じながら、体を震わせ、絶頂を迎えた…"
	RESULTS += @"_%TEXTTAG("w")%_"
	RESULTS += @"荒く息をつく%CALLNAME:ARG%からペニスを引き抜くと"
	RESULTS +=@"_秘裂から"
	SIF TCVAR:ARG:处女丧失_本次
		RESULTS += "破瓜の血の混ざった"
	RESULTS += "精液があふれ出してきた……"
ENDIF

@MESSAGE_ORGASM_P_42, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｐ")
	IF GET_ABL("精液成瘾", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%が達しそうになるのを感じると精液を催促するように腰を押し付けてきた"
		RESULTS += @"_%CALLNAME:(ARG:1)%もしっかりとペニスを突き込み、最奥に精液を注いだ……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"うっとりとした表情で、息をつく%CALLNAME:ARG%からペニスを引き抜くと"
	ELSE
		RESULTS += @"%CALLNAME:ARG%にしっかりとペニスをつきこんで射精した"
		RESULTS += @"_%CALLNAME:ARG%は精液の感触に体を震わせている…"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"ペニスを引き抜くと"
	ENDIF
	RESULTS +=@"_秘裂から"
	SIF TCVAR:ARG:处女丧失_本次
		RESULTS += "破瓜の血の混ざった"
	RESULTS += "精液があふれ出してきた……"
ENDIF

@MESSAGE_ORGASM_T_42, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｐ")
	IF GET_ABL("服从", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は大きく体を震わせ、絶頂に達した…"
		RESULTS += @"_%TEXTTAG("w")%_"
		IF GET_ABL("Ｖ感觉", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は振り向いて%CALLNAME:(ARG:1)%の方を見つめながら絶頂の余韻に浸っている…"
		ELSE
			RESULTS += @"力が抜けた%CALLNAME:ARG%はベッドに体を投げ出して、絶頂の余韻に浸っている…"
		ENDIF
	ELSE
		RESULTS += @"%CALLNAME:ARG%は背中を大きく反らしながら、全身を震わせて絶頂に達した"
		RESULTS += @"_%TEXTTAG("w")%_"
		IF GET_ABL("Ｖ感觉", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%はぐったりと脱力している…"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は戸惑いながらベットに顔をおしつけている…"
		ENDIF
	ENDIF
ENDIF
@MESSAGE_NONE_ORGASM_42, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ / 10 + GET_ABL("Ｖ感觉", ARG) * 100
	CASE IS > 3000
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は怒りに体を震わせながらも、快感を堪えきれずに嬌声をあげている"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は声を出さないようにしようとしているが、快感を堪えきれずに嬌声をあげている"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は突かれるたびに、甘い声をあげ、腰をくねらせている…"
		ENDSELECT
	CASE IS > 500
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%はなんとか嬌声をあげないよう、必死に声を押し殺している……"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は甘い声をあげながら、%CALLNAME:(ARG:1)%にあわせて腰を動かしている…"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は自分でも腰を動かして、快感を堪能している…"
		ENDSELECT
	CASEELSE
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は抽送の異物感に_"
				RESULTS += @"ベッドに顔を伏せ、行為が終わるのを待っている…"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は抽送の異物感に苦痛を感じ、辛そうにしている…"
			CASEELSE
				RESULTS += @"性交に慣れてない%CALLNAME:ARG%は目を潤ませながらも_"
				RESULTS += @"健気に%CALLNAME:(ARG:1)%の行為を受け入れている…"
		ENDSELECT
ENDSELECT
