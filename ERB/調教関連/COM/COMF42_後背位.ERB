@MESSAGE_NONE_ORGASM_42, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ / 10 + GET_ABL("Ｖ感觉", ARG) * 100
	CASE IS > 3000
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%因生气而浑身颤抖，却又无法抵抗快感而发出呻吟……"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%拼命忍受着不发出声响，但还是按捺不住快感而呻吟"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%每次受到冲击，都会发出甘美的声息，扭动起腰肢……"
		ENDSELECT
	CASE IS > 500
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%为了不发出呻吟，拼命压抑着声音……"
			CASE IS > 0
