;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_42, ARG, ARG:1, ARG:2
RESULTS = 
;前回と今回の調教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("调教者", TFLAG:当前回合 - 1) == ARG:1 && TCVAR:(ARG:1):插入继续 && PREVCOM >= 0
	SELECTCASE GET_NAME("指令", PREVCOM)
		CASE "后背位"
			RESULTS += @"品味着%CALLNAME:ARG%阴道触感的同时，再次开始摆动起腰肢"
		CASE "正常位"
			RESULTS += @"并没有从阴道中抽出，而是改变方向，从%CALLNAME:ARG%身后继续耸动着腰身……"
		CASEELSE
			RESULTS += @"保持着插入的状态，让%CALLNAME:ARG%趴下、四肢撑地，再度开始耸动起腰身……"
	ENDSELECT
ELSE
	IF GET_ABL("欲望", ARG) > 3 && 欲情等级(ARG) > 4 && GET_ABL("Ｖ感觉", ARG) >= 3
		RESULTS += @"四肢着地，像是在诱惑一样摇晃起臀部的%CALLNAME:ARG%，那"
	ELSE
		RESULTS += @"从%CALLNAME:ARG%的身后，那"
	ENDIF
	;处女
	IF GET_TALENT("处女", ARG)
		RESULTS += "未体会过男人滋味的"
	;润滑LV4以上
	ELSEIF 润滑等级(ARG) > 3
		RESULTS += "湿漉漉的"
	ENDIF
	IF GET_TALENT("娇小", ARG)
		RESULTS += "可爱小穴"
	ELSE
		RESULTS += "秘隙"
	ENDIF
	RESULTS += "最深处被一口气撞入了……"
ENDIF
;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_REACT_S_42, ARG, ARG:1, ARG:2
IF TCVAR:ARG:丧失童贞
	SELECTCASE MAX(MARK:ARG:抗拒烙印, TCVAR:ARG:获得抗拒烙印)
		CASE 0
			RESULTS += @"%CALLNAME:ARG%紧咬牙关，拼命忍耐着失去处女的痛楚，不让哀鸣从自己的嘴中漏出……"
		CASE 1
			RESULTS += @"%CALLNAME:ARG%因失去处女的痛楚而发出悲鸣……"
		CASE 2
			RESULTS += @"%CALLNAME:(ARG:1)%按住想要逃离的%CALLNAME:ARG%，继续在对方的体内抽送着……"
		CASE 3
			RESULTS += @"%CALLNAME:(ARG:1)%按住因剧痛而叫出声来，变得激动的%CALLNAME:ARG%，继续在对方体内抽送着……"
	ENDSELECT
ENDIF
IF TCVAR:ARG:初被阴道射精
	IF CFLAG:ARG:独特 == 0
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%初次被精子注入阴道，被其灼热的触感吓了一跳，_"
			RESULTS += @"回过头来看见%CALLNAME:(ARG:1)%的满足神情，又露出安心的微笑"
		ELSE
			RESULTS += @"%CALLNAME:ARG%第一次被精子注入阴道，因其灼热的触感而翻起了白眼。"
		ENDIF
	ELSE
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%第一次被阴道内射精，绽露出愉快的表情……"
		ELSE
			RESULTS += @"%CALLNAME:ARG%第一次被阴道内射精，显露出不安的神色……"
		ENDIF
	ENDIF
ENDIF
IF TCVAR:ARG:初Ｖ高潮
	IF GET_ABL("服从", ARG) > 3
		RESULTS += @"%CALLNAME:ARG%全身颤抖着迎来了高潮_"
		RESULTS += @"随后，沉浸在巨大高潮带来的幸福感中……"
	ELSE
		RESULTS += @"%CALLNAME:ARG%全身颤抖着迎来了高潮"
		RESULTS += @"随后因初体验的余韵而陷入了迷茫，粗重地喘息着……"
	ENDIF
ENDIF
;同時絶頂
@MESSAGE_ORGASM_TOGETHER_42, ARG, ARG:1, ARG:2
