;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_43, ARG, ARG:1, ARG:2
RESULTS = 
;前回と今回の調教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("調教者", TFLAG:現ターン - 1) == ARG:1 && TCVAR:(ARG:1):挿入継続 && PREVCOM >= 0
	SELECTCASE GET_NAME("コマンド", PREVCOM)
		CASE "対面座位"
			RESULTS += @"%CALLNAME:ARG%を抱きしめたまま、再び腰を揺すり始めた……"
			RETURN 0
		CASE "正常位", "騎乗位"
			RESULTS += @"膣内からペニスを抜き去ることなく%CALLNAME:ARG%の身体を%\@GET_NAME("コマンド", PREVCOM) == "正常位" ? 抱き上げ、# ぎゅっと抱き寄せ、\@%"
		CASE "後背位", "背面座位"
			RESULTS += @"挿入したまま身体をこちらに向かせ%\@GET_NAME("コマンド", PREVCOM) == "後背位" ? て抱き上げと、# るとぎゅっと抱き寄せ、\@%"
		CASEELSE
	ENDSELECT
ELSE
	IF GET_ABL("欲望", ARG) > 3 && 欲情レベル(ARG) > 4 && GET_ABL("Ｖ感覚", ARG) >= 3
		RESULTS += @"%CALLNAME:(ARG:1)%に抱きついてくる%CALLNAME:ARG%の"
	ELSE
		RESULTS += @"%CALLNAME:ARG%の身体を抱き上げ、ゆっくりと降ろしながら"
	ENDIF
ENDIF
;処女
IF GET_TALENT("処女", ARG)
	RESULTS += "男を知らない"
;潤滑LV4以上
ELSEIF 潤滑レベル(ARG) > 3
	RESULTS += "濡れそぼった"
ENDIF
IF GET_TALENT("小柄", ARG)
	RESULTS += "幼いワレメ"
ELSE
	RESULTS += "秘裂"
ENDIF
RESULTS += "に挿入し、"
IF GET_TALENT("貧乳", ARG)
	RESULTS += "薄い胸を弄りながら"
ELSEIF GET_TALENT("巨乳", ARG)
	RESULTS += "豊満な胸を揉みしだきながら"
ELSE
	RESULTS += "胸を揉みながら"
ENDIF
RESULTS += "腰を揺り動かした……"
;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_REACT_S_43, ARG, ARG:1, ARG:2
IF TCVAR:ARG:処女喪失
	SELECTCASE MAX(MARK:ARG:反発刻印, TCVAR:ARG:獲得反発刻印)
		CASE 0
			RESULTS += @"%CALLNAME:ARG%は歯を食いしばり、うめき声を漏らさないように必死に耐えている…"
		CASE 1
			RESULTS += @"%CALLNAME:ARG%は破瓜の痛みに悲鳴をあげた…"
		CASE 2
			RESULTS += @"%CALLNAME:(ARG:1)%は逃げようとする%CALLNAME:ARG%を押さえつけ、腰を揺らし続けた…"
		CASE 3
			RESULTS += @"%CALLNAME:(ARG:1)%は激痛に叫び声をあげ、暴れようとする%CALLNAME:ARG%を押さえつけ、腰を揺らし続けた…"
	ENDSELECT
ENDIF
IF TCVAR:ARG:初被膣内射精
	IF CFLAG:ARG:ユニーク == 0
		RESULTS += @"%CALLNAME:ARG%は初めて膣内に精子をうけ、その暖かい感触に目を白黒させている。"
	ELSE
		IF GET_ABL("奉仕精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、嬉しそうに顔を綻ばせている…"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、不安そうな表情を浮かべている…"
		ENDIF
	ENDIF
ENDIF
IF TCVAR:ARG:初Ｖ絶頂
	IF GET_ABL("従順", ARG) > 3
		RESULTS += @"%CALLNAME:ARG%は全身を震わせて絶頂に達した_"
		RESULTS += @"そして、%CALLNAME:(ARG:1)%の腕の中で余韻に浸っている…"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は全身を震わせて絶頂に達した"
		RESULTS += @"初めての感覚の余韻に戸惑いながら、荒く息を吐いている…"
	ENDIF
ENDIF

;同時絶頂
@MESSAGE_ORGASM_TOGETHER_43, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG, "Ｖ") && IS_ORGASM(ARG:1, "Ｐ")
	RESULTS += @"快感に身を悶えさせる%CALLNAME:ARG%としっかりと抱き合って同時に絶頂を迎えた…"
	RESULTS += @"_%TEXTTAG("w")%_"
	RESULTS += @"荒く息をつく%CALLNAME:ARG%からペニスを引き抜くと"
	RESULTS +=@"_秘裂から"
	SIF TCVAR:ARG:処女喪失_今回
		RESULTS += "破瓜の血の混ざった"
	RESULTS += "精液があふれ出してきた……"
ENDIF

@MESSAGE_ORGASM_P_43, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｐ")
	IF GET_ABL("精液中毒", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%が達しそうになるのを感じると自らも腰を動かしてきた。"
		RESULTS += @"_%CALLNAME:(ARG:1)%はそんな%CALLNAME:ARG%をしっかりを抱きしめ、膣内に精液を注いだ……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"うっとりとした表情で、息をつく%CALLNAME:ARG%からペニスを引き抜くと"
	ELSE
		RESULTS += @"%CALLNAME:ARG%をしっかりと抱きしめて射精した"
		RESULTS += @"_%CALLNAME:ARG%は精液の感触に体を震わせている…"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"ペニスを引き抜くと"
	ENDIF
	RESULTS +=@"_秘裂から"
	SIF TCVAR:ARG:処女喪失_今回
		RESULTS += "破瓜の血の混ざった"
	RESULTS += "精液があふれ出してきた……"
ENDIF

@MESSAGE_ORGASM_T_43, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｐ")
	IF GET_ABL("従順", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%にしっかりと抱きつくと、大きく体を震わせ絶頂に達した…"
		RESULTS += @"_%TEXTTAG("w")%_"
		IF GET_ABL("Ｖ感覚", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%にしがみついたまま絶頂の余韻に浸っている…"
		ELSE
			RESULTS += @"力が抜けた%CALLNAME:ARG%は、%CALLNAME:(ARG:1)%に身をまかせて絶頂の余韻に浸っている…"
		ENDIF
	ELSE
		RESULTS += @"%CALLNAME:ARG%は背中を大きく反らしながら、全身を震わせて絶頂に達した"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の腕の中でぐったりと脱力している…"
	ENDIF
ENDIF
@MESSAGE_NONE_ORGASM_43, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ / 10 + GET_ABL("Ｖ感覚", ARG) * 100
	CASE IS > 3000
		SELECTCASE 反感レベル(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は怒りに体を震わせながらも、快感を堪えきれずに%CALLNAME:(ARG:1)%にしがみついている…"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は腰を揺らされるたびに、快感を堪えきれずに嬌声をあげている"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%にしっかりと抱きつきながら、強烈な快感に身を震わせている…"
		ENDSELECT
	CASE IS > 500
		SELECTCASE 反感レベル(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は、%CALLNAME:(ARG:1)%から顔を背け、必死に矯正を押し殺そうとしている……"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は甘い声をあげながら、%CALLNAME:(ARG:1)%にあわせて腰を動かしている…"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は甘い声をあげ、自らも腰を揺らして快楽を貪っている…"
		ENDSELECT
	CASEELSE
		SELECTCASE 反感レベル(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は憎悪に顔を赤くして%CALLNAME:(ARG:1)%を睨みつけている…"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は抽送の異物感に苦痛を感じ、辛そうにしている…"
			CASEELSE
				RESULTS += @"性交に慣れてない%CALLNAME:ARG%は異物感を%CALLNAME:(ARG:1)%にしがみつくことで耐えている…"
		ENDSELECT
ENDSELECT
