		RESULTS += @"%CALLNAME:ARG%第一次被精子注入阴道，因其灼热的触感而翻起了白眼。"
	ELSE
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%第一次被阴道内射精，发出了愉快的声音……"
		ELSE
			RESULTS += @"%CALLNAME:ARG%第一次被阴道内射精，不安地陷入了沉默……"
		ENDIF
	ENDIF
ENDIF
IF TCVAR:ARG:初Ｖ高潮
