@MESSAGE_NONE_ORGASM_44, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ / 10 + GET_ABL("Ｖ感覚", ARG) * 100
	CASE IS > 3000
		SELECTCASE 反感レベル(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は怒りに体を震わせながらも、快感を堪えきれずに喘いでいる…"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は腰を揺らされるたび、敏感に部分に触れられるたびに快感を堪えきれずに嬌声をあげている"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%はあちこちに加えられる快感に身体をくねらせ、嬌声をあげている…"
		ENDSELECT
	CASE IS > 500
		SELECTCASE 反感レベル(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は、%CALLNAME:(ARG:1)%から必死に矯正を押し殺そうとしている……"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の愛撫に身を任せている…"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は甘い声をあげ、%CALLNAME:(ARG:1)%の愛撫に身を任せている…"
		ENDSELECT
	CASEELSE
		SELECTCASE 反感レベル(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は無言で%CALLNAME:(ARG:1)%のするがままになっている…"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は抽送の異物感に苦しそうに呻いている…"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の愛撫に身を任せている…"
		ENDSELECT
ENDSELECT
