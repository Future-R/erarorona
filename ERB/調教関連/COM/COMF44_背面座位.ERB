			RESULTS += @"力が抜けた%CALLNAME:ARG%は、%CALLNAME:(ARG:1)%に腕の中で絶頂の余韻に浸っている…"
		ENDIF
	ELSE
		RESULTS += @"%CALLNAME:ARG%は背中を大きく反らしながら、全身を震わせて絶頂に達した"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の腕の中でぐったりと脱力している…"
