;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_44, ARG, ARG:1, ARG:2
RESULTS = 
;前回と今回の調教者が同じで、挿入が継続されている場合
IF GET_TRAINRECORD("調教者", TFLAG:当前回合 - 1) == ARG:1 && TCVAR:(ARG:1):插入继续 && PREVCOM >= 0
	SELECTCASE GET_NAME("指令", PREVCOM)
		CASE "背面座位"
			RESULTS += @"%CALLNAME:ARG%の身体を背面から弄りながら、再び腰を揺すり始めた……"
		CASE "後背位", "騎乗位"
			RESULTS += @"膣内からペニスを抜き去ることなく%CALLNAME:ARG%の身体を背中から抱き寄せ、身体を揺さぶり始めた……"
		CASE "正常位", "対面座位"
			RESULTS += @"挿入したまま身体を反対に向かせ%\@GET_NAME("指令", PREVCOM) == "正常位" ? て抱き上げと、# るとぎゅっと抱き寄せ、\@%、_後ろから身体を弄りながら、腰を揺さぶり始めた……"
	ENDSELECT
ELSE
	RESULTS += @"%CALLNAME:ARG%の身体を抱き上げ、"
	;处女
	IF GET_TALENT("处女", ARG)
		RESULTS += "男を知らない"
	;润滑LV4以上
	ELSEIF 润滑等级(ARG) > 3
		RESULTS += "濡れそぼった"
	ENDIF
	IF GET_TALENT("娇小", ARG)
		RESULTS += "幼いワレメ"
	ELSE
		RESULTS += "秘裂"
	ENDIF
	RESULTS += "を待ち構えていたモノでゆっくり貫き、背面から愛撫しながら腰を揺らした……"
ENDIF
;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_REACT_S_44, ARG, ARG:1, ARG:2
IF TCVAR:ARG:失去处子之身
	SELECTCASE MAX(MARK:ARG:抗拒烙印, TCVAR:ARG:获得抗拒烙印)
		CASE 0
			RESULTS += @"%CALLNAME:ARG%は歯を食いしばり、疼痛にうめき声を漏らさないように必死に耐えている…"
		CASE 1
			RESULTS += @"%CALLNAME:ARG%は破瓜の疼痛に悲鳴をあげた…"
		CASE 2
			RESULTS += @"%CALLNAME:(ARG:1)%は逃げようとする%CALLNAME:ARG%を押さえつけ、腰を揺らし続けた…"
		CASE 3
			RESULTS += @"%CALLNAME:(ARG:1)%は激痛に叫び声をあげ、暴れようとする%CALLNAME:ARG%を押さえつけ、腰を揺らし続けた…"
	ENDSELECT
ENDIF
IF TCVAR:ARG:初被阴道射精
	IF CFLAG:ARG:独特 == 0
		RESULTS += @"%CALLNAME:ARG%は初めて膣内に精子をうけ、その暖かい感触に目を白黒させている。"
	ELSE
		IF GET_ABL("侍奉精神", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、嬉しそうな声をだした…"
		ELSE
			RESULTS += @"%CALLNAME:ARG%は初めての膣内射精に、不安そうに沈黙している…"
		ENDIF
	ENDIF
ENDIF
IF TCVAR:ARG:初Ｖ高潮
	IF GET_ABL("服从", ARG) > 3
		RESULTS += @"%CALLNAME:ARG%は全身を震わせて絶頂に達した_"
		RESULTS += @"そして、%CALLNAME:(ARG:1)%の腕の中で余韻に浸っている…"
	ELSE
		RESULTS += @"%CALLNAME:ARG%は全身を震わせて絶頂に達した"
		RESULTS += @"初めての感覚の余韻に戸惑いながら、荒く息を吐いている…"
	ENDIF
ENDIF

;同時絶頂
@MESSAGE_ORGASM_TOGETHER_44, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG, "Ｖ") && IS_ORGASM(ARG:1, "Ｐ")
	RESULTS += @"全身を震わせて絶頂に達した%CALLNAME:ARG%をきつく抱きしめながら%CALLNAME:(ARG:1)%も絶頂を迎えた…"
	RESULTS += @"_%TEXTTAG("w")%_"
	RESULTS += @"%CALLNAME:(ARG:1)%に寄りかかりながら荒く息をつく%CALLNAME:ARG%からペニスを引き抜くと"
	RESULTS +=@"_秘裂から"
	SIF TCVAR:ARG:处女丧失_本次
		RESULTS += "破瓜の血の混ざった"
	RESULTS += "精液があふれ出してきた……"
ENDIF

@MESSAGE_ORGASM_P_44, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｐ")
	IF GET_ABL("精液成瘾", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%が達しそうになるのを感じると自らも腰を動かしてきた。"
		RESULTS += @"_%CALLNAME:(ARG:1)%はそんな%CALLNAME:ARG%をきつく抱きしめ、膣内に精液を注いだ……"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"うっとりとした表情で、息をつく%CALLNAME:ARG%からペニスを引き抜くと"
	ELSE
		RESULTS += @"%CALLNAME:ARG%をしっかりと抱きしめて射精した"
		RESULTS += @"_%CALLNAME:ARG%は精液の感触に体を震わせている…"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"ペニスを引き抜くと"
	ENDIF
	RESULTS +=@"_秘裂から"
	SIF TCVAR:ARG:处女丧失_本次
		RESULTS += "破瓜の血の混ざった"
	RESULTS += "精液があふれ出してきた……"
ENDIF

@MESSAGE_ORGASM_T_44, ARG, ARG:1, ARG:2
IF IS_ORGASM(ARG:1, "Ｐ")
	IF GET_ABL("服从", ARG) > 2
		RESULTS += @"%CALLNAME:ARG%は大きく体を震わせ絶頂に達した…"
		RESULTS += @"_%TEXTTAG("w")%_"
		IF GET_ABL("Ｖ感觉", ARG) > 2
			RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%に全身を預けて絶頂の余韻に浸っている…"
		ELSE
			RESULTS += @"力が抜けた%CALLNAME:ARG%は、%CALLNAME:(ARG:1)%に腕の中で絶頂の余韻に浸っている…"
		ENDIF
	ELSE
		RESULTS += @"%CALLNAME:ARG%は背中を大きく反らしながら、全身を震わせて絶頂に達した"
		RESULTS += @"_%TEXTTAG("w")%_"
		RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の腕の中でぐったりと脱力している…"
	ENDIF
ENDIF
@MESSAGE_NONE_ORGASM_44, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ / 10 + GET_ABL("Ｖ感觉", ARG) * 100
	CASE IS > 3000
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は怒りに体を震わせながらも、快感を堪えきれずに喘いでいる…"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は腰を揺らされるたび、敏感に部分に触れられるたびに快感を堪えきれずに嬌声をあげている"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%はあちこちに加えられる快感に身体をくねらせ、嬌声をあげている…"
		ENDSELECT
	CASE IS > 500
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は、%CALLNAME:(ARG:1)%から必死に矯正を押し殺そうとしている……"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の愛撫に身を任せている…"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は甘い声をあげ、%CALLNAME:(ARG:1)%の愛撫に身を任せている…"
		ENDSELECT
	CASEELSE
		SELECTCASE 反感等级(ARG)
			CASE IS > 2
				RESULTS += @"%CALLNAME:ARG%は無言で%CALLNAME:(ARG:1)%のするがままになっている…"
			CASE IS > 0
				RESULTS += @"%CALLNAME:ARG%は抽送の異物感に苦しそうに呻いている…"
			CASEELSE
				RESULTS += @"%CALLNAME:ARG%は%CALLNAME:(ARG:1)%の愛撫に身を任せている…"
		ENDSELECT
ENDSELECT
