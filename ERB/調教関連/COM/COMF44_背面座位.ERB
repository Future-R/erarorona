	SELECTCASE GET_NAME("指令", PREVCOM)
		CASE "背面座位"
			RESULTS += @"从身后玩弄%CALLNAME:ARG%身体的同时，再次开始摆动起腰肢……"
		CASE "后背位", "骑乘位"
			RESULTS += @"并没有从阴道中抽出阴茎，而是从背后将%CALLNAME:ARG%拥入怀中，继续耸动着身体……"
		CASE "正常位", "对面座位"
			RESULTS += @"保持着插入的状态让%CALLNAME:ARG%背对自己，将其%\@GET_NAME("指令", PREVCOM) == "正常位" ? 托举起来，# 拥入怀中，\@%，_随后，在玩弄对方身体的同时，开始摇动起腰身……"
	ENDSELECT
ELSE
	RESULTS += @"抱起%CALLNAME:ARG%的身体，等候着的阴茎将其"
	;处女
	IF GET_TALENT("处女", ARG)
		RESULTS += "未体会过男人滋味的"
	;润滑LV4以上
	ELSEIF 润滑等级(ARG) > 3
		RESULTS += "湿漉漉的"
	ENDIF
	IF GET_TALENT("娇小", ARG)
		RESULTS += "可爱小穴"
	ELSE
		RESULTS += "秘隙"
	ENDIF
	RESULTS += "缓缓贯穿，%CALLNAME:(ARG:1)%一边从身后爱抚着对方，一边摆动着腰肢……"
ENDIF
