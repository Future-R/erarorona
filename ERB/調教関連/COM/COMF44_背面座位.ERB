@MESSAGE_REACT_S_44, ARG, ARG:1, ARG:2
IF TCVAR:ARG:丧失童贞
	SELECTCASE MAX(MARK:ARG:抗拒烙印, TCVAR:ARG:获得抗拒烙印)
		CASE 0
			RESULTS += @"%CALLNAME:ARG%紧咬牙关，拼命忍耐着痛苦，不让哀鸣从自己的嘴中漏出……"
		CASE 1
			RESULTS += @"%CALLNAME:ARG%因失去处女的痛楚而发出悲鸣……"
		CASE 2
			RESULTS += @"%CALLNAME:(ARG:1)%按住想要逃离的%CALLNAME:ARG%，继续摆动着腰肢……"
		CASE 3
			RESULTS += @"%CALLNAME:(ARG:1)%按住因剧痛而叫出声来，变得激动的%CALLNAME:ARG%，继续摆动着腰肢……"
	ENDSELECT
ENDIF
IF TCVAR:ARG:初被阴道射精
