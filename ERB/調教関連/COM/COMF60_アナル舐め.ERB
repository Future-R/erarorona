;-------------------------------------------------
;舔肛
;快Ａは弱いが疼痛が発生せず、反感も弱い
;A関係の疼痛はPALAMの口上でも軽減されるので
;これで慣らしてからのがいいってことで
;-------------------------------------------------
@COM_NAME_60
RESULTS = 舔肛

@COM_DOWNBASE_60
RETURN 30, 60

@COM_LEARN_60, ARG
#FUNCTION
RESULTS = 口活经验 200 或Ａ经验　 400
RESULT = 1
SIF EXP:ARG:口活经验 < 200 && EXP:ARG:Ａ经验 < 400 
	RESULT = 0
RETURNF RESULT

@COM_ABLE_60, ARG, ARG:1, ARG:2
RESULTS = 调教者的口可以使用/调教对象的肛可以使用
SIF !USE_HAND(ARG:1)
	RETURN 0
SIF !USE_MOUTH(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_60
RESULTS = 对Ａ快感(小)

@COM_PROPERTY_60
RESULTS = 爱抚/口活

@COM_SOURCE_60, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ａ"
		RETURN 100
	CASE "逃脱"
		RETURN 100
	CASE "反感"
		RETURN 100
	CASEELSE
		RETURN 0
ENDSELECT

@COM_ACT_60, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_60, ARG, ARG:1, ARG:2
#LOCALSSIZE 1
RESULTS = 
SELECTCASE GET_ABL("Ａ感觉", ARG)
	CASE 0
		RESULTS += @"仔细地舔弄着%CALLNAME:ARG%紧闭的肛门……"
	CASE 1, 2
		RESULTS += @"在仔细舔弄%CALLNAME:ARG%肛门的同时，将舌头伸入其中爱抚……"
	CASEELSE
		RESULTS += @"舌尖刚一触碰，%CALLNAME:ARG%的肛门就舒展开来，随后被伸入的舌头来回搅动……"
ENDSELECT
RESULTS += ""

@MESSAGE_NONE_ORGASM_60, ARG, ARG:1, ARG:2
SELECTCASE CUP:ARG:快Ａ + PALAM:ARG:快Ａ / 10 + GET_ABL("Ａ感觉", ARG) * 100
	CASE IS > 2000
		IF RAND:2
			RESULTS = %CALLNAME:ARG%的肛门已经完全舒展，将%CALLNAME:(ARG:1)%舌头的爱抚全盘接受……
		ELSE
			RESULTS = 肠道被舌头伸入，%CALLNAME:ARG%的腰已经彻底瘫软，任由对方摆布……
		ENDIF
	CASE IS > 100
		IF RAND:2
			RESULTS = %CALLNAME:ARG%脸颊泛红、粗重地喘息，忍受着自后庭袭来的快感……
		ELSE
			RESULTS = 强烈的快感让%CALLNAME:ARG%不自觉抬腰想要逃离，却被对方按住，继续用舌头爱抚……
		ENDIF
	CASEELSE
		RESULTS = %CALLNAME:ARG%对%CALLNAME:(ARG:1)%的行为感到困惑……
ENDSELECT

@COM_TOUCH_60
RESULTS = 肛/口

@COM_STAIN_60

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_60, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT

