;-------------------------------------------------
;爱抚肛门
;-------------------------------------------------
@COM_NAME_61
RESULTS = 爱抚肛门

@COM_DOWNBASE_61
RETURN 90, 120

@COM_LEARN_61, ARG
#FUNCTION
RESULTS = 手活经验 250 或Ａ经验 10
RESULT = 1
SIF EXP:ARG:手活经验 < 250 && EXP:ARG:Ａ经验 < 10
	RESULT = 0
RETURNF RESULT


@COM_ABLE_61, ARG, ARG:1, ARG:2
RESULTS = 调教者的手可以使用/调教对象的肛可以使用
SIF !USE_HAND(ARG:1)
	RETURN 0
SIF !USE_ANUS(ARG)
	RETURN 0
RETURN 1

@COM_EFFECT_61
RESULTS = 对Ａ快感(中)

@COM_PROPERTY_61
RESULTS = 爱抚/手活

@COM_SOURCE_61, ARGS, ARG = -1, ARG:1
SELECTCASE ARGS
	CASE "快Ａ"
		RETURN 250
	CASE "逃脱"
		RETURN 100
	CASE "Ａ疼痛"
		RETURN 150
	CASE "反感"
		RETURN 200
	CASEELSE
		RETURN 0
ENDSELECT
@COM_INSERT_61, ARG, ARG:1, ARG:2
RESULTS = Ａ
RESULTS:1 = %CALLNAME:(ARG:1)%的手指
RETURN ARG

@COM_ACT_61, ARG, ARG:1, ARG:2

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
@MESSAGE_COM_61, ARG, ARG:1, ARG:2
#LOCALSSIZE 1
RESULTS = 
SELECTCASE GET_ABL("Ａ感觉", ARG)
	CASE 0
		RESULTS += "%CALLNAME:ARG%紧闭的狭窄处被手指缓缓插入……"
	CASE 1, 2
		RESULTS += "%CALLNAME:ARG%抗拒地用力缩紧的狭窄处被手指缓缓插入……"
	CASEELSE
		RESULTS += @"%CALLNAME:(ARG:1)%的手指被毫无阻碍地接纳，在对方后庭中激烈地搅动……"
ENDSELECT
RESULTS += ""

@MESSAGE_ORGASM_T_61, ARG, ARG:1, ARG:2
RESULTS = %CALLNAME:ARG%用后庭紧紧箍住%CALLNAME:(ARG:1)%的手指，身体大幅后仰，迎来了高潮……

@MESSAGE_NONE_ORGASM_61, ARG, ARG:1, ARG:2
IF CUP:ARG:苦痛 >= 300
	IF GET_ABL("受虐倾向", ARG) > 2
		IF CUP:ARG:快Ａ > 500
			RESULTS = %CALLNAME:ARG%陶醉于后庭被粗暴玩弄所带来的痛楚与快感……
		ELSE
			RESULTS = %CALLNAME:ARG%因后庭被粗暴玩弄，变得兴奋起来……
		ENDIF
	ELSE
		RESULTS = %CALLNAME:ARG%后庭被手指强行插入，发出痛苦的悲鸣……
	ENDIF
ELSE
	SELECTCASE CUP:ARG:快Ａ + PALAM:ARG:快Ａ / 10 + GET_ABL("Ａ感觉", ARG) * 100
		CASE IS > 3000
			IF RAND:2
				RESULTS = %CALLNAME:ARG%拼命忍受着后庭被挖搅带来的发狂冲动，显露出顺从的神色……
			ELSE
				RESULTS = 后庭内手指的每一次搅动，都会引发%CALLNAME:ARG%的娇喘，身体也随之跳动……
			ENDIF
		CASE IS > 500
			IF RAND:2
				RESULTS = %CALLNAME:ARG%脸颊泛红、粗重地喘息，忍受着自后庭袭来的快感……
			ELSE
				RESULTS = %CALLNAME:ARG%在强烈的快感下全身颤抖……
			ENDIF
		CASEELSE
			RESULTS = %CALLNAME:ARG%静静地忍受着异物感……
	ENDSELECT
ENDIF

@COM_TOUCH_61
RESULTS = 肛/手

@COM_STAIN_61

;EXPはRESULTがARG, RESULT:1がARG:1に加算される
@COM_EXP_61, ARGS, ARG = -1, ARG:1 = -1
SELECTCASE ARGS
	CASEELSE
		RETURN 0
ENDSELECT

