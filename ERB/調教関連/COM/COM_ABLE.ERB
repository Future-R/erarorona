;----------------------------------------------------------------------------------------------
;部位所有判定
;ARGの角色が各部位を所持しているかどうかを返す
;----------------------------------------------------------------------------------------------
@HAVE_BODY, ARGS, ARG = -1
#FUNCTION
SIF ARG == -1
	ARG = TARGET
SELECTCASE ARGS
	CASE "口", "手", "胸", "阴道内", "发", "肛"
		RETURNF 1
	CASE "阴蒂", "阴蒂"
		RETURNF !IS_MALE(ARG) && !GET_TALENT("扶她", ARG)
	CASE "阴茎"
		SIF IS_MALE(ARG)
			RETURNF 1
		SIF GET_TALENT("扶她", ARG)
			RETURNF 1
		SIF TRAIN_STATE_POWER_不可思议的根(ARG) != 0
			RETURNF 1
	CASE "阴道", "膣"
		RETURNF !IS_MALE(ARG)
	CASEELSE
		THROW = 部位[%ARGS%]未登记为关键词
ENDSELECT

;----------------------------------------------------------------------------------------------
;特殊コマンド判定
;----------------------------------------------------------------------------------------------
;キス判定基本
;ARGが行為者(ARGがARG:1にキスをする)
;-------------------------------------------------
@PLAY_KISS, ARG, ARG:1
#FUNCTION
;口が汚れているとダメ（调教者が无视污秽か愛液、母乳のよごれならＯＫ）
SIF DIRTY("口", ARG:1) && !GET_TALENT("无视污秽", ARG)
	RETURNF 0
SIF !USE_MOUTH(ARG:1) || !USE_MOUTH(ARG)
	RETURNF 0
RETURNF 1

@PLAY_KISS_TEXT, ARG, ARG:1
#FUNCTIONS
#LOCALSSIZE 2
LOCALS = \@ARG == PLAYER || ARG == ARG:1 ? 调教者 # 调教对象\@
LOCALS:1 = \@ARG:1 == PLAYER && ARG:1 != ARG:1 ? 调教者 # 调教对象\@
RETURNF LOCALS + "的口可以使用/" + LOCALS:1 + "的口可以使用/" + LOCALS:1 + "的口已清洁"

@PLAY_SEX, ARG, ARG:1
#FUNCTION
SIF !USE_VAGINA(ARG:1)
	RETURNF 0
SIF !USE_WAIST(ARG)
	RETURNF 0
SIF !HAVE_BODY("阴茎", ARG)
	RETURNF 0
RETURNF 1

@PLAY_SEX_TEXT, ARG, ARG:1
#FUNCTIONS
#LOCALSSIZE 2
LOCALS = \@ARG == PLAYER || ARG == ARG:1 ? 调教者 # 调教对象\@
LOCALS:1 = \@ARG:1 == PLAYER && ARG != ARG:1 ? 调教者 # 调教对象\@
RETURNF LOCALS + "的腰可以使用/" + LOCALS:1 + "的阴道可以使用/"
