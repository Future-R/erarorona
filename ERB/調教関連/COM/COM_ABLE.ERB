;	001		2012/05/30			kap						新規作成
;---------------------------------------------------------------------
;---------------------------------------------------------------------
;@COMABLE
;ARG	チェックするコマンド番号
;ARG:1  调教者
;ARG:2　実行調教対象
;ARG:3　アイテム番号(アイテムである場合)
;		コマンドが実行可能かどうかをチェックする。
;		なお、ここでの実行可能はコマンドとして選択可能かどうか
;		命令をきくかどうかのCOM_ORDERで実行できるかどうかは問わない
;---------------------------------------------------------------------
@COM_ABLE, ARG, ARG:1, ARG:2, ARG:3
RESULTS = 
CALLFORM COM_ABLE_{ARG}, ARG:1, ARG:2, ARG:3
RETURN RESULT


;----------------------------------------------------------------------------------------------
;部位別使用判定
;ARGの角色が各部位を使用可能かどうかを返す
;----------------------------------------------------------------------------------------------
;-------------------------------------------------
;口使用判定基本
;-------------------------------------------------
@USE_MOUTH, ARG
#FUNCTION
;ボールギャグ使用中は不可
SIF ITEM_MOUTH(ARG) > 0
	RETURNF 0
RETURNF 1

;-------------------------------------------------
;胸使用判定基本
;-------------------------------------------------
@USE_BUST, ARG
#FUNCTION
SIF ITEM_NIPLE(ARG) > 0
	RETURNF 0
RETURNF 1

;-------------------------------------------------
;手使用判定基本
;-------------------------------------------------
@USE_HAND, ARG
#FUNCTION
SIF TRAIN_STATE_POWER_拘束(ARG)
	RETURNF 0
SIF ITEM_HAND(ARG) > 0
	RETURNF 0
RETURNF 1

;-------------------------------------------------
;ペニス使用判定基本
;-------------------------------------------------
@USE_PENIS, ARG
#FUNCTION
;男性か扶她じゃないとダメ
SIF !HAVE_BODY("阴茎", ARG)
	RETURNF 0
;オナホール使用中はダメ
SIF ITEM_PENIS(ARG) > 0
	RETURNF 0
RETURNF 1

;-------------------------------------------------
;膣使用判定基本
;-------------------------------------------------
@USE_VAGINA, ARG
#FUNCTION
;男性だとダメ
SIF !HAVE_BODY("阴道", ARG)
	RETURNF 0
SIF ITEM_VAGINA(ARG) > 0
	RETURNF 0
RETURNF 1

;-------------------------------------------------
;肛門使用判定基本
;ARG:2 ずらし 1:ずらしも可 2:ずらしのみ可
;-------------------------------------------------
@USE_ANUS, ARG
#FUNCTION
SIF ITEM_ANUS(ARG) > 0
	RETURNF 0
RETURNF 1
;-------------------------------------------------
;クリ使用判定基本
;-------------------------------------------------
@USE_CLI, ARG
#FUNCTION
;クリが無いとダメ
SIF !HAVE_BODY("阴蒂" ,ARG)
	RETURNF 0
SIF ITEM_CLI(ARG) > 0
	RETURNF 0
RETURNF 1

;-------------------------------------------------
;腰の使用判定
;-------------------------------------------------
@USE_WAIST, ARG
#FUNCTION
SIF TRAIN_STATE_POWER_拘束(ARG)
	RETURNF 0
SIF !USE_PENIS(ARG) && !USE_VAGINA(ARG)
	RETURNF 0
RETURNF 1
