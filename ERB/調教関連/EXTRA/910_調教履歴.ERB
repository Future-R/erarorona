@EXTRA_NAME_910
RESULTS = 調教履歴

@EXTRA_ABLE_910
RETURN 1

@EXTRA_ACT_910
#DIM LINE
#DIM TURN
#DIM CHARA
TURN = TFLAG:現ターン - 1
LINE =LINECOUNT
CHARA = 1
$START
CALL SHOW_TRAIN_RESULT, TURN, TRAINCHARA(CHARA), , , 1
CALL EQUATE_LINE, LINE + MAXLINE()
CALL INPUT_SPLIT, "0/1/2/3/4/6/9"
;CLEARLINE LINECOUNT - LINE
SELECTCASE RESULT
	CASE 1
		TURN -= 5
	CASE 4
		TURN--
	CASE 6
		TURN++
	CASE 3
		TURN += 5
	CASE 0
		DO 
			CHARA++
			SIF CHARA == 3
				CHARA = 0
		LOOP TRAINCHARA(CHARA) < 0
	CASE 9
		RETURN 0
ENDSELECT
TURN = LIMIT(TURN, 0, TFLAG:現ターン - 1)
GOTO START
