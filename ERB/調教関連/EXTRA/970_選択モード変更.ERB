@EXTRA_NAME_970
RESULTS = 更换选择模式

@EXTRA_ABLE_970
RETURN 1

@EXTRA_ACT_970
#LOCALSIZE 2
#LOCALSSIZE 1
CALL SHOW_TRAIN_STATUS, TFLAG:当前回合
FOR LOCAL, 0, 4
	SELECTCASE LOCAL
		CASE 0
			LOCALS = [0] 双击模式/鼠标单击或输入指令编号以查看说明。/再次点击同一指令或按下Enter键即可执行指令。/若在指令编号前添加半角空格，则直接执行不显示说明。
		CASE 1
			LOCALS = [1] 单击模式/通过鼠标单击或输入指令编号直接执行指令。/若在指令编号前添加半角空格，则显示说明。
		CASE 2
			LOCALS = [2] 鼠标双击模式/禁用指令编号输入功能。/鼠标操作基本与双击模式相同，/但按住空格键时下次点击将立即执行指令。
		CASE 3
			LOCALS = [3] 鼠标单击模式/禁用指令编号输入功能。/鼠标操作基本与单击模式相同，/但按住空格键时下次点击将显示指令说明。
	ENDSELECT
	SIF LOCAL == GLOBAL:指令选择模式
		SETCOLOR COLOR("p-blue")
	PRINT ┌
	PRINTBUTTON AUTO_SPLIT(LOCALS, "/", 0), LOCAL
	PRINTFORML %"─"  * ((120 - STRLENS(AUTO_SPLIT(LOCALS, "/", 0))) / 2)%┐
	FOR LOCAL:1, 1 ,4
		PRINT │
		PRINTBUTTON @"%AUTO_SPLIT(LOCALS, "/", LOCAL:1), 120, LEFT%", LOCAL
		PRINTL │
	NEXT
	PRINTFORML └%"─" * 60%┘
	RESETCOLOR
NEXT
CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE() - 2
DRAWLINE
PRINTL [9] 返回
CALL INPUT_SPLIT, "0/1/2/3/9"
IF RESULT != 9
	CLEARLINE LINECOUNT - TFLAG:菜单显示线
	PRINTFORML 指令选择模式/已更换至%AUTO_SPLIT("双击模式/单击模式/鼠标双击模式/鼠标单击模式", RESULT)%。
	GLOBAL:指令选择模式 = RESULT
	SAVEGLOBAL
	CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE()
	WAITANYKEY
ENDIF
