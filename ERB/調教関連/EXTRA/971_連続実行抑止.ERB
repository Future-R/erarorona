@EXTRA_NAME_971
RESULTS = 连续实行抑制モード

@EXTRA_ABLE_971
RETURN 1

@EXTRA_ACT_971
#LOCALSIZE 2
#LOCALSSIZE 1
CALL SHOW_TRAIN_STATUS, TFLAG:当前回合
FOR LOCAL, 0, 2
	SELECTCASE LOCAL
		CASE 0
			LOCALS = [0] 抑止モードＯＦＦ/前回指令と同じ指令をENTERで決定したとき/そのまま即実行します
		CASE 1
			LOCALS = [1] 抑止モードＯＮ/前回指令同じ指令をENTERで決定することができません。/指令番号を入力して実行してください。
	ENDSELECT
	SIF LOCAL == GLOBAL:连续实行抑制
		SETCOLOR COLOR("p-blue")
	PRINT ┌
	PRINTBUTTON AUTO_SPLIT(LOCALS, "/", 0), LOCAL
	PRINTFORML %"─"  * ((108 - STRLENS(AUTO_SPLIT(LOCALS, "/", 0))) / 2)%┐
	FOR LOCAL:1, 1 ,4
		PRINT │
		PRINTBUTTON @"%AUTO_SPLIT(LOCALS, "/", LOCAL:1), 108, LEFT%", LOCAL
		PRINTL │
	NEXT
	PRINTFORML └%"─" * 54%┘
	RESETCOLOR
NEXT
CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE() - 2
DRAWLINE
PRINTL [9] 戻る
CALL INPUT_SPLIT, "0/1/9"
IF RESULT != 9
	CLEARLINE LINECOUNT - TFLAG:菜单显示线
	PRINTFORML 连续实行抑制モードを%AUTO_SPLIT("抑止モードＯＦＦ/抑止モードＯＮ", "/", RESULT)%に変更しました。
	GLOBAL:连续实行抑制 = RESULT
	SAVEGLOBAL
	CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE()
	WAITANYKEY
ENDIF
