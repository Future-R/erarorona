@EXTRA_NAME_972
RESULTS = PALAM动画设置

@EXTRA_ABLE_972
RETURN 1

@EXTRA_ACT_972
#LOCALSIZE 2
#LOCALSSIZE 1
CALL SHOW_TRAIN_STATUS, TFLAG:当前回合
PRINTFORML ┌PALAM动画帧数 %"─" * 47%┐
PRINTFORML │%"请设置获取参数时动画的帧数。", 108, LEFT%│
PRINTFORML │%"每帧需耗时0.1秒。", 108, LEFT%│
PRINTFORML │%"若指定为-1，动画将被省略。", 108, LEFT%│
PRINTFORML │%"若指定为0，则保持当前设置不变。", 108, LEFT%│
PRINTFORML │%@"当前的设置为{GLOBAL:PALAM动画帧数}帧。", 108, LEFT%│
PRINTFORML └%"─" * 54%┘
CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE() - 7
DRAWLINE
CALL INPUT_MANY, -1, 100
CLEARLINE LINECOUNT - TFLAG:菜单显示线
IF RESULT == 0
	PRINTFORML 帧数不变，设置结束。
ELSE
	IF RESULT == -1
		PRINTFORML 省略获得参数时的动画。
	ELSE
		PRINTFORML 获得参数时动画的帧数变更为{RESULT}了。
	ENDIF
	GLOBAL:PALAM动画帧数 = RESULT
ENDIF
SAVEGLOBAL
CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE()
WAITANYKEY
