@EXTRA_NAME_973
RESULTS = 跳过指令结算界面

@EXTRA_ABLE_973
RETURN 1

@EXTRA_ACT_973
#LOCALSIZE 2
#LOCALSSIZE 1
CALL SHOW_TRAIN_STATUS, TFLAG:当前回合
FOR LOCAL, 0, 2
	SELECTCASE LOCAL
		CASE 0
			LOCALS = [0] 跳过结算ＯＦＦ/执行指令后将会展示双方的状态变化
		CASE 1
			LOCALS = [1] 跳过结算ＯＮ/执行指令后不再展示双方的状态变化
	ENDSELECT
	SIF LOCAL == GLOBAL:跳过指令结算展示
		SETCOLOR COLOR("p-blue")
	PRINT ┌
	PRINTBUTTON AUTO_SPLIT(LOCALS, "/", 0), LOCAL
	PRINTFORML %"─"  * ((108 - STRLENS(AUTO_SPLIT(LOCALS, "/", 0))) / 2)%┐
	FOR LOCAL:1, 1 ,4
		PRINT │
		PRINTBUTTON @"%AUTO_SPLIT(LOCALS, "/", LOCAL:1), 108, LEFT%", LOCAL
		PRINTL │
	NEXT
	PRINTFORML └%"─" * 54%┘
	RESETCOLOR
NEXT
CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE() - 2
DRAWLINE
PRINTL [9] 返回
CALL INPUT_SPLIT, "0/1/9"
IF RESULT != 9
	CLEARLINE LINECOUNT - TFLAG:菜单显示线
	PRINTFORML 跳过指令结算已更换至/%AUTO_SPLIT("跳过结算ＯＦＦ/跳过结算ＯＮ", RESULT)%。
	GLOBAL:跳过指令结算展示 = RESULT
	SAVEGLOBAL
	CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE()
	WAITANYKEY
ENDIF
