;@MESSAGE_COM		メッセージ登録関数
;@MESSAGE_ORGASM	絶頂時のメッセージ関数
;@TRAIN_TEXT	調教テキストのメイン関数
;------------------------------------------------
;@MESSAGE_COM		メッセージ登録関数
;ARG				指令番号
;ARG:1				指令実行者
;ARG:2				指令実行対象
;------------------------------------------------
@MESSAGE_COM, ARG, ARG:1 = -1, ARG:2 = -1
#LOCALSIZE 1
#LOCALSSIZE 1
TRYCCALLFORM MESSAGE_COM_{ARG}, ARG:1, ARG:2, TFLAG:使用物品登录编号
	LOCALS = _%RESULTS%
	IF IS_TRAINITEM(ARG)
		;主效果と特性のメッセージ追加
		FOR LOCAL, 0, 4
			RESULTS = 
			TRYCALLFORM EFFECT_MESSAGE_{GET_ITEMDATA(TFLAG:使用物品登录编号, @"主效果{LOCAL}")}, TFLAG:使用物品登录编号, ARG:1, ARG:2
			SIF RESULTS != ""
				LOCALS += "_" + RESULTS
		NEXT

		FOR LOCAL, 0, 5
			RESULTS = 
			TRYCALLFORM PROPERTY_MESSAGE_{GET_ITEMDATA(TFLAG:使用物品登录编号, @"主效果{LOCAL}")}, TFLAG:使用物品登录编号, ARG:1, ARG:2
			SIF RESULTS != ""
				LOCALS += "_" + RESULTS
		NEXT
	ENDIF
	LOCALS = %SUBSTRING(LOCALS, 1)%
	SIF LOCALS != ""
		CALL TRAINTEXT, LOCALS, "SET"
CATCH
ENDCATCH

;------------------------------------------------
;@MESSAGE_REACT		調教行為後のメッセージ関数
;ARG				指令番号
;ARG:1				指令実行者
;ARG:2				指令実行対象
;------------------------------------------------
@MESSAGE_REACT
#LOCALSSIZE 1
RESULTS = 
;リアクション開始共通
TRYCCALLFORM MESSAGE_REACT_S_{SELECTCOM}, TARGET, PLAYER, TFLAG:使用物品登录编号
	SIF RESULTS != ""
		CALL TRAINTEXT, RESULTS, "SET"
CATCH
ENDCATCH

;両者絶頂
IF RESULTS == ""
	IF IS_ORGASM(TARGET) && IS_ORGASM(PLAYER)
		;指令個別の絶頂テキストがないかチェック
		TRYCCALLFORM MESSAGE_ORGASM_TOGETHER_{SELECTCOM}, TARGET, PLAYER, TFLAG:使用物品登录编号
			SIF RESULTS != ""
				CALL TRAINTEXT, RESULTS, "SET"
		CATCH
		ENDCATCH
	ENDIF
ENDIF
;片方のみを見る（両者があった場合は飛ばす）
IF RESULTS == ""
	IF IS_ORGASM(PLAYER)
		TRYCCALLFORM MESSAGE_ORGASM_P_{SELECTCOM}, TARGET, PLAYER, TFLAG:使用物品登录编号
			SIF RESULTS != ""
				CALL TRAINTEXT, RESULTS, "SET"
		CATCH
		ENDCATCH
	ENDIF
	IF IS_ORGASM(TARGET)
		TRYCCALLFORM MESSAGE_ORGASM_T_{SELECTCOM}, TARGET, PLAYER, TFLAG:使用物品登录编号
			SIF RESULTS != ""
				CALL TRAINTEXT, RESULTS, "SET"
		CATCH
		ENDCATCH
		IF RESULTS != ""
			LOCALS = 
			LOCALS +=CALLNAME:TARGET + "は"
			IF TCVAR:TARGET:喷乳 > 0
				LOCALS += "胸の先端から母乳を垂らし"
			ELSEIF SUMARRAY(NOWEX:TARGET:0, 0, 4) >= 5 && !HAVE_BODY("阴茎", TARGET)
				LOCALS += "陰唇から透明な潮を噴き出し"
			ELSEIF TCVAR:TARGET:射精 > 0
				LOCALS += "ペニスから精液を噴き出し"
			ELSE
				LOCALS += "背中を大きく反らし"
			ENDIF
			LOCALS += "ながら、全身を震わせて絶頂に達した"
			;絶頂後の描写
			IF SUMARRAY(NOWEX:TARGET:0, 0, 4) >= 3
				LOCALS += "_" + CALLNAME:TARGET
				IF SUMARRAY(NOWEX:TARGET:0, 0, 4) >= 5
					IF IS_INSERT(TARGET, "Ｖ", "阴茎")
						LOCALS += "の肉襞は粘つく液体を滴らせ、喘ぐように開閉を繰り返している……"
					ELSE
						LOCALS += "は断続的に絶頂を繰り返しながら、ぐったりと脱力している……"
					ENDIF
				ELSEIF SUMARRAY(NOWEX:TARGET:0, 0, 4) >= 3
					LOCALS += "は荒い息をつきながら絶頂の余韻にひたっている……"
				ENDIF
			ENDIF
			CALL TRAINTEXT, LOCALS, "SET"
		ENDIF
	ENDIF
ENDIF
;両方共絶頂していない場合
IF RESULTS == ""
	IF !IS_ORGASM(TARGET) && !IS_ORGASM(PLAYER)
		TRYCCALLFORM MESSAGE_NONE_ORGASM_{SELECTCOM}, TARGET, PLAYER, TFLAG:使用物品登录编号
			SIF RESULTS != ""
				CALL TRAINTEXT, RESULTS, "SET"
		CATCH
		ENDCATCH
	ENDIF
ENDIF
;リアクション終了共通
TRYCCALLFORM MESSAGE_REACT_E_{SELECTCOM}, TARGET, PLAYER, TFLAG:使用物品登录编号
	SIF RESULTS != ""
		CALL TRAINTEXT, RESULTS, "SET"
CATCH
ENDCATCH

;------------------------------------------------
;@TRAIN_TEXT	調教テキストのメイン関数
;ARGS			格納するテキスト
;ARGS:1			動作モード
;ARG			テキストを格納するターン数
;ARGS:2			行末処理オプション
;------------------------------------------------
@TRAINTEXT, ARGS, ARGS:1 = "SET", ARG = -1, ARGS:2 = "WAIT"
#LOCALSIZE 3
#DIMS TEXT, 200
#DIMS OPTION, 200
#DIMS COLOR, 200
#DIMS R_TEXT, 100
#DIM R_MAXPAGE, 100
#DIM IS_WAIT
#DIM SUM_LINE
#DIM MAX_LINE
#DIM PAGE
#DIM TURN
MAX_LINE =  TFLAG:显示开始线 + MAXLINE() - TFLAG:菜单显示线 - 2
TURN = ARG == -1 ? TFLAG:当前回合 # ARG
IF ARGS:1 == "SET"
	SIF R_TEXT:TURN == ""
		SUM_LINE = 0
	SPLIT ARGS, "_", LOCALS
	;跨いでしまう時の処置
	WHILE (RESULT + SUM_LINE) >= ((SUM_LINE / MAX_LINE + 1) * MAX_LINE)
		R_TEXT:TURN += TEXTTAG("L")
		SUM_LINE++
	WEND
	FOR LOCAL, 0, RESULT
		SIF SUM_LINE
			R_TEXT:TURN  +=  TEXTTAG("L")
		R_TEXT:TURN  += LOCALS:LOCAL
		SUM_LINE++
	NEXT
	;行末処理
	SELECTCASE ARGS:2
		CASE "WAIT"
			R_TEXT:TURN += TEXTTAG("L") + TEXTTAG("W")
			SUM_LINE++
		CASE "FORCEWAIT"
			R_TEXT:TURN += TEXTTAG("L") + TEXTTAG("FW")
			SUM_LINE++
	ENDSELECT
	R_MAXPAGE:TURN = SUM_LINE / MAX_LINE
ELSEIF ARGS:1 == "RESET"
	VARSET R_TEXT
ELSEIF ARGS:1 == "SHOW" || ARGS:1 == "SHOW_RECORD"
	$SHOW_START
	VARSET TEXT
	SPLIT R_TEXT:TURN, TEXTTAG("L"), TEXT
	SUM_LINE = RESULT
	CLEARLINE LINECOUNT - TFLAG:显示开始线
	IF ARGS:1 == "SHOW"
		CALL SHOW_TRAIN_STATUS, TURN
		PRINTFORML 　ＭＥＳＳＡＧＥ
		DRAWLINE
		FOR LOCAL, 0, SUM_LINE
			CLEARLINE LINECOUNT - TFLAG:菜单显示线 - (LOCAL % MAX_LINE) - 2
			SELECTCASE TEXT:LOCAL
				CASE TEXTTAG("W")
					IS_WAIT = MAX(1, IS_WAIT)
				CASE TEXTTAG("FW")
					IS_WAIT = 2
				CASEELSE
					HTML_PRINT TEXT:LOCAL
			ENDSELECT
			CALL EQUATE_LINE, TFLAG:显示开始线 + MAXLINE()
			SIF IS_WAIT == 1
				WAIT
			SIF IS_WAIT == 2
				FORCEWAIT
			IS_WAIT = 0
		NEXT
	ELSE
		LOCAL:1 = 0
		CALL SHOW_TRAIN_STATUS, TURN
		PRINTFORM 　ＭＥＳＳＡＧＥ　　　TURN:{TURN}　PAGE.{PAGE}/{R_MAXPAGE:TURN} 
		PRINTFORM %" ", 10%
		PRINTBUTTON "[1] << ", "1"
		PRINTBUTTON "[4]  < ", "4"
		PRINTFORM %" ", 3%
		PRINTBUTTON "[6]  > ", "6"
		PRINTBUTTON "[3] >> ", "3"
		PRINTFORM %" ", 10%
		PRINTBUTTON "[0] TURN:0", "0"
		PRINTFORM %" ", 3%
		PRINTBUTTON "[9] 戻る", "9"
		PRINTL 
		DRAWLINE
		FOR LOCAL, PAGE * MAX_LINE, (PAGE + 1) * MAX_LINE
			FOR LOCAL:1, 0, STRLENSU(TEXT:LOCAL)
				LOCALS = %SUBSTRINGU(TEXT:LOCAL, LOCAL:1,1)%
				SELECTCASE LOCALS
					CASE TEXTTAG("W")
					CASE TEXTTAG("FW")
					CASE TEXTTAG("COLOR")
						ENCODETOUNI %SUBSTRINGU(TEXT:LOCAL, LOCAL:1 + 1, 1)%
						LOCAL:2 = RESULT:1 * 16 * 16 * 16
						ENCODETOUNI %SUBSTRINGU(TEXT:LOCAL, LOCAL:1 + 2, 1)%
						LOCAL:2 += RESULT:1
						SETCOLOR LOCAL:2
						LOCAL:1 += 2
					CASEELSE
						PRINTBUTTON LOCALS, ""
				ENDSELECT
			NEXT
			PRINTBUTTON " " * MAX(122 - STRLENS(TEXT:LOCAL), 0), ""
			PRINTL 
			RESETCOLOR
		NEXT
		CALL INPUT_SPLIT, "/0/1/4/6//3/9"
		SELECTCASE RESULTS
			CASE "0"
				TURN = 0
				PAGE = 0
			CASE "1"
				IF TURN > 0
					TURN--
					PAGE = R_MAXPAGE:TURN
				ELSE
					PAGE = 0
				ENDIF
			CASE "4"
				IF PAGE > 0
					PAGE--
				ELSE
					IF TURN > 0
						TURN--
						PAGE = R_MAXPAGE:TURN
					ELSE
						PAGE = 0
					ENDIF
				ENDIF
			CASE "6", ""
				IF PAGE < R_MAXPAGE:TURN
					PAGE++
				ELSE
					IF TURN < TFLAG:当前回合 - 1
						TURN++
						PAGE = 0
					ELSE
						PAGE = R_MAXPAGE:TURN
					ENDIF
				ENDIF
			CASE "3"
				IF TURN < TFLAG:当前回合 - 1
					TURN++
					PAGE = 0
				ELSE
					PAGE = R_MAXPAGE:TURN
				ENDIF
			CASE "9"
				RETURN 0
		ENDSELECT
		GOTO SHOW_START
	ENDIF
ELSEIF ARGS:1 == "MAKE_RECORD"
	R_TEXT:TOINT(ARGS) = 
ELSE
	PRINTFORML @TRAINTEXTのARGS:1に<%ARGS:1%>は不適当です
	FORCEWAIT
ENDIF

