; ARG为实例化序号
@PREFAB_噗尼噗尼珠01, ARG
CALL SET_ITEMDATA, ARG, "ID", GET_NO("物品", "噗尼噗尼珠")
CALL SET_ITEMDATA, ARG, "品阶", 3
CALL SET_ITEMDATA, ARG, "品质", 42 + GET_MIXLV()
CALL SET_ITEMDATA, ARG, "价格", 2 * GET_MIXLV()
CALL SET_ITEMDATA, ARG, "等级", 2 + GET_MIXLV() / 3

CALL SET_ITEMDATA, ARG, @"特性0", GET_NO("特性", "高品质Lv2")
CALL SET_ITEMDATA, ARG, @"特性1", GET_NO("特性", "消耗额等级+2")

CALL SET_CATEGORY, ARG